/**
 * NOA Creation Form Handler
 * Updated for CY card selection, consignee search, and table-based containers
 */

let containerCount = 0;
let containerSizes = {};
let containerTypes = {};
let consignees = [];
let cyAllocations = [];
let selectedAllocation = null;
let selectedConsignee = null;
let cyAllocationsLastFetched = null; // Task 10.5: Track when data was last fetched
let cyAllocationsFromCache = false; // Task 10.5: Track if data is from cache

document.addEventListener('DOMContentLoaded', function() {
    loadCYAllocations();
    loadConsignees();
    loadContainerTypes();
    loadContainerSizes();
    initializeEventListeners();
});

function initializeEventListeners() {
    const form = document.getElementById('noaCreationForm');
    const addContainerBtn = document.getElementById('addContainerBtn');
    const consigneeSearch = document.getElementById('consigneeSearch');
    const clearConsigneeBtn = document.getElementById('clearConsigneeBtn');
    
    form.addEventListener('submit', handleFormSubmit);
    addContainerBtn.addEventListener('click', addContainer);
    consigneeSearch.addEventListener('input', handleConsigneeSearch);
    clearConsigneeBtn.addEventListener('click', clearConsigneeSelection);
    
    // Close search results when clicking outside
    document.addEventListener('click', function(e) {
        const searchResults = document.getElementById('consigneeSearchResults');
        if (!consigneeSearch.contains(e.target) && !searchResults.contains(e.target)) {
            searchResults.classList.add('hidden');
        }
    });
}

/**
 * Task 10.5: Load CY allocations with caching and error handling
 * Implements cached data display with staleness indicator when API fails
 */
function loadCYAllocations() {
    fetch('/api/cy-allocations/all')
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            cyAllocations = data.allocations || [];
            cyAllocationsLastFetched = new Date();
            cyAllocationsFromCache = false;
            
            // Task 10.5: Store in localStorage as cache
            try {
                localStorage.setItem('cyAllocationsCache', JSON.stringify({
                    data: cyAllocations,
                    timestamp: cyAllocationsLastFetched.toISOString()
                }));
            } catch (e) {
                console.warn('Failed to cache CY allocations:', e);
            }
            
            renderCYCards();
            hideStalenessIndicator();
        })
        .catch(error => {
            console.error('Error loading CY allocations:', error);
            
            // Task 10.5: Try to load from cache
            const cached = loadCYAllocationsFromCache();
            if (cached) {
                cyAllocations = cached.data;
                cyAllocationsLastFetched = new Date(cached.timestamp);
                cyAllocationsFromCache = true;
                renderCYCards();
                showStalenessIndicator();
            } else {
                // No cache available, show error
                document.getElementById('cyLocationsGrid').innerHTML = 
                    '<p class="text-sm text-red-600 col-span-full">Failed to load CY locations. Please refresh the page.</p>';
            }
        });
}

/**
 * Task 10.5: Load CY allocations from localStorage cache
 * @returns {Object|null} Cached data or null if not available
 */
function loadCYAllocationsFromCache() {
    try {
        const cached = localStorage.getItem('cyAllocationsCache');
        if (cached) {
            const parsed = JSON.parse(cached);
            // Only use cache if it's less than 1 hour old
            const cacheAge = Date.now() - new Date(parsed.timestamp).getTime();
            if (cacheAge < 3600000) { // 1 hour in milliseconds
                return parsed;
            }
        }
    } catch (e) {
        console.warn('Failed to load cached CY allocations:', e);
    }
    return null;
}

/**
 * Task 10.5: Show staleness indicator when using cached data
 */
function showStalenessIndicator() {
    let indicator = document.getElementById('cyDataStalenessIndicator');
    if (!indicator) {
        indicator = createStalenessIndicator();
        const grid = document.getElementById('cyLocationsGrid');
        grid.parentNode.insertBefore(indicator, grid);
    }
    
    const ageMinutes = Math.floor((Date.now() - cyAllocationsLastFetched.getTime()) / 60000);
    const ageText = ageMinutes < 60 
        ? `${ageMinutes} minute${ageMinutes !== 1 ? 's' : ''} ago`
        : `${Math.floor(ageMinutes / 60)} hour${Math.floor(ageMinutes / 60) !== 1 ? 's' : ''} ago`;
    
    indicator.querySelector('#stalenessAge').textContent = ageText;
    indicator.classList.remove('hidden');
}

/**
 * Task 10.5: Hide staleness indicator when fresh data is loaded
 */
function hideStalenessIndicator() {
    const indicator = document.getElementById('cyDataStalenessIndicator');
    if (indicator) {
        indicator.classList.add('hidden');
    }
}

/**
 * Task 10.5 & 10.6: Create staleness indicator with manual refresh option
 */
function createStalenessIndicator() {
    const indicator = document.createElement('div');
    indicator.id = 'cyDataStalenessIndicator';
    indicator.className = 'mb-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg flex items-center justify-between';
    indicator.innerHTML = `
        <div class="flex items-center">
            <svg class="w-5 h-5 text-yellow-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <div>
                <p class="text-sm font-medium text-yellow-800">Using cached data</p>
                <p class="text-xs text-yellow-700">Last updated <span id="stalenessAge"></span>. Real-time updates may not be available.</p>
            </div>
        </div>
        <button onclick="manualRefreshCYAllocations()" 
                class="ml-4 px-3 py-1 bg-yellow-600 text-white text-sm rounded hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-yellow-500">
            Refresh Now
        </button>
    `;
    return indicator;
}

/**
 * Task 10.6: Manual refresh option when real-time updates fail
 */
function manualRefreshCYAllocations() {
    const refreshBtn = document.querySelector('#cyDataStalenessIndicator button');
    if (refreshBtn) {
        refreshBtn.disabled = true;
        refreshBtn.textContent = 'Refreshing...';
    }
    
    loadCYAllocations();
    
    // Re-enable button after a delay
    setTimeout(() => {
        if (refreshBtn) {
            refreshBtn.disabled = false;
            refreshBtn.textContent = 'Refresh Now';
        }
    }, 2000);
}

function renderCYCards() {
    const grid = document.getElementById('cyLocationsGrid');
    
    if (cyAllocations.length === 0) {
        grid.innerHTML = '<p class="text-sm text-gray-500 col-span-full">No CY allocations available.</p>';
        return;
    }
    
    grid.innerHTML = cyAllocations.map(allocation => {
        // Check if both sizes are unconfigured
        const capacity20ft = allocation.capacity_20ft || 0;
        const capacity40ft = allocation.capacity_40ft || 0;
        const bothUnconfigured = (capacity20ft === 0 && capacity40ft === 0);
        
        // Calculate overall utilization for card styling
        let utilizationPercent;
        if (bothUnconfigured) {
            utilizationPercent = allocation.total_teu_capacity > 0
                ? (allocation.used_teu / allocation.total_teu_capacity) * 100
                : 0;
        } else {
            const utilization20ft = capacity20ft > 0
                ? ((allocation.allocated_20ft + allocation.pre_forecast_20ft) / capacity20ft) * 100
                : 0;
            const utilization40ft = capacity40ft > 0
                ? ((allocation.allocated_40ft + allocation.pre_forecast_40ft) / capacity40ft) * 100
                : 0;
            utilizationPercent = Math.max(utilization20ft, utilization40ft);
        }
        
        let borderColor = 'border-gray-300';
        let bgColor = 'bg-white';
        
        if (utilizationPercent >= 90) {
            borderColor = 'border-red-300';
            bgColor = 'bg-red-50';
        } else if (utilizationPercent >= 70) {
            borderColor = 'border-yellow-300';
            bgColor = 'bg-yellow-50';
        }
        
        // Render TEU-based display if both sizes unconfigured
        if (bothUnconfigured) {
            return renderTEUBasedCard(allocation, borderColor, bgColor);
        }
        
        // Calculate values for 20ft
        const allocated20 = allocation.allocated_20ft || 0;
        const preforecast20 = allocation.pre_forecast_20ft || 0;
        const available20 = capacity20ft - allocated20 - preforecast20;
        const utilization20 = capacity20ft > 0 ? ((allocated20 / capacity20ft) * 100).toFixed(1) : 0;
        
        // Calculate values for 40ft
        const allocated40 = allocation.allocated_40ft || 0;
        const preforecast40 = allocation.pre_forecast_40ft || 0;
        const available40 = capacity40ft - allocated40 - preforecast40;
        const utilization40 = capacity40ft > 0 ? ((allocated40 / capacity40ft) * 100).toFixed(1) : 0;
        
        // Determine if available
        const isAvailable = available20 > 0 || available40 > 0;
        
        // Otherwise render size-specific card matching the image exactly
        return `
        <div class="cy-card bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
             data-allocation-id="${allocation.id}"
             data-total-teu="${allocation.total_teu_capacity}"
             data-allocated-teu="${allocation.allocated_teu}"
             data-pre-forecast-teu="${allocation.pre_forecast_teu || 0}"
             data-used-teu="${allocation.used_teu}"
             data-available-teu="${allocation.available_teu}"
             data-capacity-20ft="${capacity20ft}"
             data-capacity-40ft="${capacity40ft}"
             data-allocated-20ft="${allocated20}"
             data-allocated-40ft="${allocated40}"
             data-pre-forecast-20ft="${preforecast20}"
             data-pre-forecast-40ft="${preforecast40}"
             data-available-20ft="${available20}"
             data-available-40ft="${available40}">
            
            <!-- Header -->
            <div class="flex items-start justify-between mb-3">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-green-100 rounded flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                    </div>
                    <div class="leading-tight">
                        <h4 class="font-semibold text-gray-900 text-sm">${allocation.terminal_name}</h4>
                        <p class="text-xs text-gray-500">20ft Containers</p>
                    </div>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded ${isAvailable ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'}">
                    ${isAvailable ? 'Available' : 'Full'}
                </span>
            </div>
            
            <!-- 20ft Container Section -->
            <div class="mb-3">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-xs font-semibold text-gray-900">20ft Containers</span>
                    <span class="text-xs text-gray-400">20ft</span>
                </div>
                
                <div class="space-y-1 text-xs">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                            </svg>
                            <span class="text-gray-600">Capacity</span>
                        </div>
                        <span class="font-semibold text-gray-900">${capacity20ft} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span class="text-gray-600">Allocated</span>
                        </div>
                        <span class="font-semibold ${allocated20 > 0 ? 'text-blue-600' : 'text-gray-900'}">${allocated20} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                            </svg>
                            <span class="text-gray-600">Pre-Forecast</span>
                        </div>
                        <span class="font-semibold ${preforecast20 > 0 ? 'text-purple-600' : 'text-gray-900'}">${preforecast20} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span class="text-gray-600">Available</span>
                        </div>
                        <span class="font-semibold ${available20 > 0 ? 'text-green-600' : 'text-gray-900'}">${available20} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                            </svg>
                            <span class="text-gray-600">Utilization</span>
                        </div>
                        <span class="font-semibold text-gray-900">${utilization20}%</span>
                    </div>
                </div>
                
                <!-- Progress Bar -->
                <div class="mt-1.5 w-full bg-gray-200 rounded-full h-1">
                    <div class="bg-green-600 h-1 rounded-full transition-all duration-300" style="width: ${utilization20}%"></div>
                </div>
            </div>
            
            <!-- 40ft Container Section -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-xs font-semibold text-gray-900">40ft Containers</span>
                    <span class="text-xs text-gray-400">40ft</span>
                </div>
                
                <div class="space-y-1 text-xs">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                            </svg>
                            <span class="text-gray-600">Capacity</span>
                        </div>
                        <span class="font-semibold text-gray-900">${capacity40ft} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span class="text-gray-600">Allocated</span>
                        </div>
                        <span class="font-semibold ${allocated40 > 0 ? 'text-blue-600' : 'text-gray-900'}">${allocated40} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                            </svg>
                            <span class="text-gray-600">Pre-Forecast</span>
                        </div>
                        <span class="font-semibold ${preforecast40 > 0 ? 'text-purple-600' : 'text-gray-900'}">${preforecast40} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span class="text-gray-600">Available</span>
                        </div>
                        <span class="font-semibold ${available40 > 0 ? 'text-green-600' : 'text-gray-900'}">${available40} containers</span>
                    </div>
                    
                    <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                            </svg>
                            <span class="text-gray-600">Utilization</span>
                        </div>
                        <span class="font-semibold text-gray-900">${utilization40}%</span>
                    </div>
                </div>
                
                <!-- Progress Bar -->
                <div class="mt-1.5 w-full bg-gray-200 rounded-full h-1">
                    <div class="bg-green-600 h-1 rounded-full transition-all duration-300" style="width: ${utilization40}%"></div>
                </div>
            </div>
        </div>
    `;
    }).join('');
}

/**
 * Task 10.3: Render TEU-based card when both container sizes are unconfigured
 * Provides backward compatibility fallback display
 * 
 * @param {Object} allocation - The CY allocation data
 * @param {string} borderColor - Border color class
 * @param {string} bgColor - Background color class
 * @returns {string} HTML for TEU-based card
 */
function renderTEUBasedCard(allocation, borderColor, bgColor) {
    const totalTeu = allocation.total_teu_capacity || 0;
    const allocatedTeu = allocation.allocated_teu || 0;
    const preForecastTeu = allocation.pre_forecast_teu || 0;
    const usedTeu = allocation.used_teu || 0;
    const availableTeu = allocation.available_teu || 0;
    const utilizationPercent = totalTeu > 0 ? (usedTeu / totalTeu) * 100 : 0;
    
    // Determine status color
    let barColor = 'bg-green-600';
    let statusColor = 'bg-green-100 text-green-800';
    let statusText = 'Available';
    
    if (utilizationPercent >= 90) {
        barColor = 'bg-red-600';
        statusColor = 'bg-red-100 text-red-800';
        statusText = 'At Capacity';
    } else if (utilizationPercent >= 70) {
        barColor = 'bg-yellow-500';
        statusColor = 'bg-yellow-100 text-yellow-800';
        statusText = 'Near Capacity';
    }
    
    return `
        <div class="cy-card border-2 ${borderColor} ${bgColor} rounded-lg p-4 cursor-default"
             data-allocation-id="${allocation.id}"
             data-total-teu="${totalTeu}"
             data-allocated-teu="${allocatedTeu}"
             data-pre-forecast-teu="${preForecastTeu}"
             data-used-teu="${usedTeu}"
             data-available-teu="${availableTeu}"
             data-capacity-20ft="0"
             data-capacity-40ft="0"
             data-teu-based="true">
            <div class="flex items-start justify-between mb-3">
                <h4 class="font-semibold text-gray-900">${allocation.terminal_name}</h4>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${statusColor}">
                    ${statusText}
                </span>
            </div>
            
            <!-- TEU-Based Display -->
            <div class="space-y-2 text-sm">
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Total Capacity:</span>
                    <span class="font-semibold text-gray-900">${totalTeu.toFixed(1)} TEU</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Allocated:</span>
                    <span class="font-semibold text-blue-600 cy-allocated-teu-display">${allocatedTeu.toFixed(1)} TEU</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Pre-Forecast:</span>
                    <span class="font-semibold text-purple-600 cy-pre-forecast-teu-display">${preForecastTeu.toFixed(1)} TEU</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Available:</span>
                    <span class="font-semibold text-green-600 cy-available-teu-display">${availableTeu.toFixed(1)} TEU</span>
                </div>
                <div class="mt-2">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-xs text-gray-500">Utilization</span>
                        <span class="text-xs font-semibold text-gray-700 cy-utilization-teu-percent">${utilizationPercent.toFixed(1)}%</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="cy-utilization-teu-bar h-2 rounded-full transition-all duration-300 ${barColor}" 
                             style="width: ${Math.min(utilizationPercent, 100)}%"></div>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-t border-gray-200">
                    <p class="text-xs text-gray-500 italic">
                        <svg class="inline-block w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Container size-specific capacity not configured. Displaying TEU-based capacity.
                    </p>
                </div>
            </div>
        </div>
    `;
}

/**
 * Task 5.2: Render size-specific capacity information section
 * @param {Object} allocation - The CY allocation data
 * @param {string} size - Container size ('20ft' or '40ft')
 * @returns {string} HTML for the size section
 */
function renderContainerSizeSection(allocation, size) {
    const capacity = allocation[`capacity_${size}`] || 0;
    const allocated = allocation[`allocated_${size}`] || 0;
    const preForecast = allocation[`pre_forecast_${size}`] || 0;
    const available = allocation[`available_${size}`] || 0;
    const utilizationPercent = allocation[`utilization_percentage_${size}`] || 0;
    
    // Task 5.4: Handle "Not configured" display
    if (capacity === 0 || capacity === null) {
        return `
            <div class="size-section-${size}" data-size="${size}">
                <div class="flex items-center justify-between mb-2">
                    <h5 class="text-sm font-semibold text-gray-700">${size} Containers</h5>
                </div>
                <div class="text-sm text-gray-500 italic">Not configured</div>
            </div>
        `;
    }
    
    // Task 5.6: Color coding for capacity values
    // Task 6.3: Color threshold logic for progress bar
    let barColor = 'bg-green-600';
    let statusColor = 'bg-green-100 text-green-800';
    let statusText = 'Available';
    
    if (utilizationPercent >= 90) {
        barColor = 'bg-red-600';
        statusColor = 'bg-red-100 text-red-800';
        statusText = 'At Capacity';
    } else if (utilizationPercent >= 70) {
        barColor = 'bg-yellow-500';
        statusColor = 'bg-yellow-100 text-yellow-800';
        statusText = 'Near Capacity';
    }
    
    return `
        <div class="size-section-${size}" data-size="${size}">
            <div class="flex items-center justify-between mb-2">
                <h5 class="text-sm font-semibold text-gray-700">${size} Containers</h5>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${statusColor}">
                    ${statusText}
                </span>
            </div>
            <div class="space-y-2 text-sm">
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Capacity:</span>
                    <span class="font-semibold text-gray-900">${capacity} containers</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Allocated:</span>
                    <span class="font-semibold text-blue-600 cy-allocated-${size}-display">${allocated} containers</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Pre-Forecast:</span>
                    <span class="font-semibold text-purple-600 cy-pre-forecast-${size}-display">${preForecast} containers</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600">Available:</span>
                    <span class="font-semibold text-green-600 cy-available-${size}-display">${available} containers</span>
                </div>
                <!-- Task 6.1/6.2: Utilization progress bar -->
                <div class="mt-2">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-xs text-gray-500">Utilization</span>
                        <span class="text-xs font-semibold text-gray-700 cy-utilization-${size}-percent">${utilizationPercent.toFixed(1)}%</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="cy-utilization-${size}-bar h-2 rounded-full transition-all duration-300 ${barColor}" 
                             style="width: ${Math.min(utilizationPercent, 100)}%"></div>
                    </div>
                </div>
            </div>
        </div>
    `;
}

function loadConsignees() {
    fetch('/api/consignees/all')
        .then(response => response.json())
        .then(data => {
            consignees = data.consignees || [];
        })
        .catch(error => console.error('Error loading consignees:', error));
}

function handleConsigneeSearch(e) {
    const query = e.target.value.toLowerCase().trim();
    const resultsDiv = document.getElementById('consigneeSearchResults');
    
    if (query.length < 2) {
        resultsDiv.classList.add('hidden');
        return;
    }
    
    const filtered = consignees.filter(c => 
        c.email.toLowerCase().includes(query) || 
        (c.fullName && c.fullName.toLowerCase().includes(query)) ||
        (c.businessName && c.businessName.toLowerCase().includes(query))
    );
    
    if (filtered.length === 0) {
        resultsDiv.innerHTML = '<div class="p-4 text-sm text-gray-500">No consignees found</div>';
        resultsDiv.classList.remove('hidden');
        return;
    }
    
    resultsDiv.innerHTML = filtered.map(c => `
        <div class="p-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0" 
             onclick="selectConsignee(${c.id})">
            <div class="font-medium text-gray-900">${c.businessName || c.fullName || c.email}</div>
            <div class="text-sm text-gray-600">${c.email}</div>
        </div>
    `).join('');
    
    resultsDiv.classList.remove('hidden');
}

function selectConsignee(consigneeId) {
    selectedConsignee = consignees.find(c => c.id === consigneeId);
    
    if (!selectedConsignee) return;
    
    // Update hidden input
    document.getElementById('consigneeId').value = consigneeId;
    
    // Clear search input
    document.getElementById('consigneeSearch').value = '';
    document.getElementById('consigneeSearchResults').classList.add('hidden');
    
    // Show selected consignee card
    document.getElementById('selectedConsigneeName').textContent = 
        selectedConsignee.businessName || selectedConsignee.fullName || 'Consignee';
    document.getElementById('selectedConsigneeEmail').textContent = selectedConsignee.email;
    document.getElementById('selectedConsigneeCard').classList.remove('hidden');
}

function clearConsigneeSelection() {
    selectedConsignee = null;
    document.getElementById('consigneeId').value = '';
    document.getElementById('consigneeSearch').value = '';
    document.getElementById('selectedConsigneeCard').classList.add('hidden');
}

function loadContainerTypes() {
    fetch('/api/container-types')
        .then(response => response.json())
        .then(data => {
            containerTypes = data.types.reduce((acc, type) => {
                acc[type.id] = type;
                return acc;
            }, {});
        })
        .catch(error => console.error('Error loading container types:', error));
}

function loadContainerSizes() {
    fetch('/api/container-sizes')
        .then(response => response.json())
        .then(data => {
            containerSizes = data.sizes.reduce((acc, size) => {
                acc[size.id] = size;
                return acc;
            }, {});
        })
        .catch(error => console.error('Error loading container sizes:', error));
}

function addContainer() {
    const tbody = document.getElementById('containersTableBody');
    const index = containerCount++;
    
    const row = document.createElement('tr');
    row.className = 'container-row';
    row.dataset.index = index;
    row.innerHTML = `
        <td class="px-4 py-3 text-sm text-gray-900">${index + 1}</td>
        <td class="px-4 py-3">
            <input type="text" 
                   name="containers[${index}][number]" 
                   required 
                   maxlength="20"
                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                   placeholder="e.g., ABCD1234567">
        </td>
        <td class="px-4 py-3">
            <select name="containers[${index}][sizeId]" 
                    required
                    class="container-size-select block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                    data-index="${index}"
                    onchange="updateContainerTEU(${index})">
                <option value="">Select size</option>
                ${Object.values(containerSizes).map(size => 
                    `<option value="${size.id}" data-teu="${size.teuValue}">${size.name}</option>`
                ).join('')}
            </select>
        </td>
        <td class="px-4 py-3">
            <select name="containers[${index}][typeId]" 
                    required
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                <option value="">Select type</option>
                ${Object.values(containerTypes).map(type => 
                    `<option value="${type.id}">${type.name}</option>`
                ).join('')}
            </select>
        </td>
        <td class="px-4 py-3 text-sm text-gray-900">
            <span class="teu-display" data-index="${index}">-</span>
        </td>
        <td class="px-4 py-3">
            <select name="containers[${index}][cyAllocationId]" 
                    required
                    class="cy-allocation-select block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                    data-index="${index}"
                    onchange="updateCYAllocationForContainer(${index})">
                <option value="">Select CY location</option>
                ${renderCYDropdownOptions(0)}
            </select>
        </td>
        <td class="px-4 py-3 text-center">
            <button type="button" 
                    class="text-red-600 hover:text-red-800"
                    onclick="removeContainer(${index})">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </button>
        </td>
    `;
    
    tbody.appendChild(row);
    updateCYAllocation();
}

function updateContainerTEU(index) {
    const select = document.querySelector(`[name="containers[${index}][sizeId]"]`);
    const selectedOption = select.options[select.selectedIndex];
    const teuDisplay = document.querySelector(`.teu-display[data-index="${index}"]`);
    
    if (selectedOption && selectedOption.dataset.teu) {
        const teuValue = parseFloat(selectedOption.dataset.teu);
        teuDisplay.textContent = teuValue + ' TEU';
        
        // Update CY dropdown options based on new TEU requirement
        refreshCYDropdownForContainer(index, teuValue);
    } else {
        teuDisplay.textContent = '-';
    }
    
    updateCYAllocation();
}

/**
 * Task 8.1-8.4: Render CY dropdown options filtered by size-specific capacity
 * Sorted by available capacity (highest first) for the selected size
 * Shows size-specific available capacity in option text
 */
function renderCYDropdownOptions(requiredTeu) {
    // Determine container size based on TEU value
    const sizeKey = requiredTeu === 1.0 ? '20ft' : requiredTeu === 2.0 ? '40ft' : null;
    
    // If size-specific filtering is applicable
    if (sizeKey) {
        // Task 8.2: Filter allocations where available capacity >= 1 for the selected size
        const availableAllocations = cyAllocations.filter(allocation => {
            const available = allocation[`available_${sizeKey}`] || 0;
            return available >= 1;
        });
        
        // Task 8.3: Sort by available capacity (highest first) for the selected size
        const sortedAllocations = [...availableAllocations].sort((a, b) => {
            const availableA = a[`available_${sizeKey}`] || 0;
            const availableB = b[`available_${sizeKey}`] || 0;
            return availableB - availableA;
        });
        
        // Task 8.4: Display available capacity for the specific container size
        return sortedAllocations.map(allocation => {
            const available = allocation[`available_${sizeKey}`] || 0;
            return `<option value="${allocation.id}" 
                            data-available="${available}"
                            data-size="${sizeKey}">
                        ${allocation.terminal_name} (${available} ${sizeKey} available)
                    </option>`;
        }).join('');
    }
    
    // Fallback to TEU-based filtering for other sizes
    const sortedAllocations = [...cyAllocations].sort((a, b) => 
        b.available_teu - a.available_teu
    );
    
    return sortedAllocations.map(allocation => {
        const hasCapacity = allocation.available_teu >= requiredTeu;
        
        return `<option value="${allocation.id}" 
                        ${!hasCapacity ? 'disabled' : ''}
                        data-available="${allocation.available_teu}"
                        data-total="${allocation.total_teu_capacity}">
                    ${allocation.terminal_name}
                </option>`;
    }).join('');
}

/**
 * Task 8.1, 8.5, 8.6: Refresh CY dropdown options for a specific container when TEU changes
 * Filters by size-specific available capacity and clears invalid selections
 */
function refreshCYDropdownForContainer(index, requiredTeu) {
    const cySelect = document.querySelector(`[name="containers[${index}][cyAllocationId]"]`);
    if (!cySelect) return;
    
    const currentValue = cySelect.value;
    const sizeKey = requiredTeu === 1.0 ? '20ft' : requiredTeu === 2.0 ? '40ft' : null;
    
    // Task 8.1: Re-render options with size-specific filtering
    cySelect.innerHTML = `<option value="">Select CY location</option>` + 
                         renderCYDropdownOptions(requiredTeu);
    
    // Task 8.6: Clear invalid CY selection when size change makes it unavailable
    if (currentValue) {
        const option = cySelect.querySelector(`option[value="${currentValue}"]`);
        if (option && !option.disabled) {
            cySelect.value = currentValue;
            // Remove any previous warning styling
            cySelect.classList.remove('border-red-500', 'border-2');
        } else {
            // Selection is no longer valid
            cySelect.value = '';
            // Task 8.8: Add red border visual feedback
            cySelect.classList.add('border-red-500', 'border-2');
            // Task 8.7: Show warning modal with alternative locations
            showCYCapacityWarning(index, requiredTeu, sizeKey);
        }
    }
}

/**
 * Task 8.7: Show capacity warning modal with alternative locations
 * Displays size-specific capacity information and up to 3 alternatives
 */
function showCYCapacityWarning(index, requiredTeu, sizeKey) {
    const row = document.querySelector(`.container-row[data-index="${index}"]`);
    if (!row) return;
    
    const cySelect = row.querySelector('.cy-allocation-select');
    
    // Task 8.8: Add red border visual feedback (already applied in caller)
    if (!cySelect.classList.contains('border-red-500')) {
        cySelect.classList.add('border-red-500', 'border-2');
    }
    
    // Find alternative locations with sufficient capacity for the specific size
    let alternatives = [];
    let warningMessage = '';
    
    if (sizeKey) {
        // Size-specific filtering (20ft or 40ft)
        alternatives = cyAllocations.filter(a => {
            const available = a[`available_${sizeKey}`] || 0;
            return available >= 1;
        });
        
        // Sort by available capacity (highest first)
        alternatives.sort((a, b) => {
            const availableA = a[`available_${sizeKey}`] || 0;
            const availableB = b[`available_${sizeKey}`] || 0;
            return availableB - availableA;
        });
        
        warningMessage = `Insufficient ${sizeKey} capacity at selected CY location.\n\nRequired: 1 container`;
        
        if (alternatives.length > 0) {
            const altNames = alternatives.slice(0, 3)
                .map(a => `${a.terminal_name} (${a[`available_${sizeKey}`]} ${sizeKey} available)`)
                .join('\n• ');
            warningMessage += `\n\nAlternative locations:\n• ${altNames}`;
        } else {
            warningMessage += `\n\nNo CY locations have sufficient ${sizeKey} capacity.\nPlease contact administrator or select a different container size.`;
        }
    } else {
        // Fallback to TEU-based filtering
        alternatives = cyAllocations.filter(a => a.available_teu >= requiredTeu);
        
        warningMessage = `Insufficient capacity at selected CY location.\n\nRequired: ${requiredTeu} TEU`;
        
        if (alternatives.length > 0) {
            const altNames = alternatives.slice(0, 3)
                .map(a => `${a.terminal_name} (${a.available_teu.toFixed(1)} TEU available)`)
                .join('\n• ');
            warningMessage += `\n\nAlternative locations:\n• ${altNames}`;
        } else {
            warningMessage += `\n\nNo CY locations have sufficient capacity.\nPlease contact administrator.`;
        }
    }
    
    alert(warningMessage);
}

/**
 * Handle CY allocation selection for a container
 * Task 8.8: Remove red border when valid selection is made
 */
function updateCYAllocationForContainer(index) {
    const cySelect = document.querySelector(`[name="containers[${index}][cyAllocationId]"]`);
    
    // Remove any previous warning styling (Task 8.8)
    cySelect.classList.remove('border-red-500', 'border-2');
    
    // Update overall utilization display
    updateCYAllocation();
}

function removeContainer(index) {
    const row = document.querySelector(`.container-row[data-index="${index}"]`);
    if (row) {
        row.remove();
        // Renumber remaining rows
        const rows = document.querySelectorAll('.container-row');
        rows.forEach((r, i) => {
            r.querySelector('td:first-child').textContent = i + 1;
        });
        updateCYAllocation();
    }
}

/**
 * Task 7.1: Calculate pending containers separately for 20ft and 40ft
 * Task 7.6: Handle CY allocation changes by updating both previous and new cards
 * Task 10.3: Handle TEU-based cards when both sizes are unconfigured
 */
function updateCYAllocation() {
    const containerRows = document.querySelectorAll('.container-row');
    
    // Task 7.1: Calculate pending containers per allocation and size
    const allocationPending = {}; // { allocationId: { '20ft': count, '40ft': count, teu: total } }
    
    containerRows.forEach(row => {
        const index = row.dataset.index;
        const sizeSelect = row.querySelector(`[name="containers[${index}][sizeId]"]`);
        const cySelect = row.querySelector(`[name="containers[${index}][cyAllocationId]"]`);
        
        if (!sizeSelect || !cySelect) return;
        
        const selectedSizeOption = sizeSelect.options[sizeSelect.selectedIndex];
        const allocationId = cySelect.value;
        
        if (selectedSizeOption && selectedSizeOption.dataset.teu && allocationId) {
            const teuValue = parseFloat(selectedSizeOption.dataset.teu);
            const sizeKey = teuValue === 1.0 ? '20ft' : '40ft';
            
            if (!allocationPending[allocationId]) {
                allocationPending[allocationId] = { '20ft': 0, '40ft': 0, teu: 0 };
            }
            
            allocationPending[allocationId][sizeKey]++;
            allocationPending[allocationId].teu += teuValue;
        }
    });
    
    // Update each CY card with size-specific or TEU-based pending counts
    cyAllocations.forEach(allocation => {
        const card = document.querySelector(`[data-allocation-id="${allocation.id}"]`);
        if (!card) return;
        
        const pending = allocationPending[allocation.id] || { '20ft': 0, '40ft': 0, teu: 0 };
        
        // Task 10.3: Check if this is a TEU-based card
        const isTEUBased = card.dataset.teuBased === 'true';
        
        if (isTEUBased) {
            // Update TEU-based card
            updateTEUBasedSection(card, allocation, pending.teu);
        } else {
            // Task 7.2: Update 20ft section
            updateSizeSection(card, allocation, '20ft', pending['20ft']);
            
            // Task 7.2: Update 40ft section
            updateSizeSection(card, allocation, '40ft', pending['40ft']);
            
            // Update overall card styling based on highest utilization
            const utilization20ft = calculateSizeUtilization(allocation, '20ft', pending['20ft']);
            const utilization40ft = calculateSizeUtilization(allocation, '40ft', pending['40ft']);
            const maxUtilization = Math.max(utilization20ft, utilization40ft);
            
            let borderColor = 'border-gray-300';
            let bgColor = 'bg-white';
            
            if (maxUtilization >= 90) {
                borderColor = 'border-red-300';
                bgColor = 'bg-red-50';
            } else if (maxUtilization >= 70) {
                borderColor = 'border-yellow-300';
                bgColor = 'bg-yellow-50';
            }
            
            card.className = `cy-card border-2 ${borderColor} ${bgColor} rounded-lg p-4 cursor-default transition-all duration-300`;
        }
    });
    
    // Calculate total TEU across all containers
    let totalTeu = 0;
    containerRows.forEach(row => {
        const index = row.dataset.index;
        const sizeSelect = row.querySelector(`[name="containers[${index}][sizeId]"]`);
        const selectedOption = sizeSelect?.options[sizeSelect.selectedIndex];
        
        if (selectedOption && selectedOption.dataset.teu) {
            totalTeu += parseFloat(selectedOption.dataset.teu);
        }
    });
    
    // Show allocation display if containers exist
    if (totalTeu > 0) {
        document.getElementById('cyAllocationDisplay').classList.remove('hidden');
        document.getElementById('totalTeuRequired').textContent = totalTeu.toFixed(1);
    } else {
        document.getElementById('cyAllocationDisplay').classList.add('hidden');
    }
}

/**
 * Task 10.3: Update TEU-based card section with pending counts
 * 
 * @param {HTMLElement} card - The CY card element
 * @param {Object} allocation - The allocation data
 * @param {number} pendingTeu - Pending TEU count
 */
function updateTEUBasedSection(card, allocation, pendingTeu) {
    const totalTeu = parseFloat(card.dataset.totalTeu) || 0;
    const allocatedTeu = parseFloat(card.dataset.allocatedTeu) || 0;
    const preForecastTeu = parseFloat(card.dataset.preForecastTeu) || 0;
    
    if (totalTeu === 0) return;
    
    // Calculate new values with pending TEU
    const newPreForecast = preForecastTeu + pendingTeu;
    const newUsed = allocatedTeu + newPreForecast;
    const newAvailable = Math.max(0, totalTeu - newUsed);
    const utilization = (newUsed / totalTeu) * 100;
    
    // Update pre-forecast display with orange pending count
    const preForecastDisplay = card.querySelector('.cy-pre-forecast-teu-display');
    if (preForecastDisplay) {
        if (pendingTeu > 0) {
            preForecastDisplay.innerHTML = `${preForecastTeu.toFixed(1)} <span class="text-orange-600 font-bold">+${pendingTeu.toFixed(1)}</span> TEU`;
        } else {
            preForecastDisplay.textContent = `${preForecastTeu.toFixed(1)} TEU`;
        }
    }
    
    // Update available capacity display
    const availableDisplay = card.querySelector('.cy-available-teu-display');
    if (availableDisplay) {
        availableDisplay.textContent = `${newAvailable.toFixed(1)} TEU`;
    }
    
    // Update utilization percentage
    const utilizationDisplay = card.querySelector('.cy-utilization-teu-percent');
    if (utilizationDisplay) {
        utilizationDisplay.textContent = `${utilization.toFixed(1)}%`;
    }
    
    // Update progress bar with color coding
    const utilizationBar = card.querySelector('.cy-utilization-teu-bar');
    if (utilizationBar) {
        let barColor = 'bg-green-600';
        if (utilization >= 90) {
            barColor = 'bg-red-600';
        } else if (utilization >= 70) {
            barColor = 'bg-yellow-500';
        }
        
        utilizationBar.className = `cy-utilization-teu-bar h-2 rounded-full transition-all duration-300 ${barColor}`;
        utilizationBar.style.width = `${Math.min(utilization, 100)}%`;
    }
    
    // Update overall card styling
    let borderColor = 'border-gray-300';
    let bgColor = 'bg-white';
    
    if (utilization >= 90) {
        borderColor = 'border-red-300';
        bgColor = 'bg-red-50';
    } else if (utilization >= 70) {
        borderColor = 'border-yellow-300';
        bgColor = 'bg-yellow-50';
    }
    
    card.className = `cy-card border-2 ${borderColor} ${bgColor} rounded-lg p-4 cursor-default transition-all duration-300`;
    
    // Update status badge
    const statusBadge = card.querySelector('.inline-flex.items-center');
    if (statusBadge) {
        let statusColor = 'bg-green-100 text-green-800';
        let statusText = 'Available';
        
        if (utilization >= 90) {
            statusColor = 'bg-red-100 text-red-800';
            statusText = 'At Capacity';
        } else if (utilization >= 70) {
            statusColor = 'bg-yellow-100 text-yellow-800';
            statusText = 'Near Capacity';
        }
        
        statusBadge.className = `inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${statusColor}`;
        statusBadge.textContent = statusText;
    }
}

/**
 * Task 7.2: Update a specific size section with pending counts
 * Task 7.3: Display pending counts in orange color
 * Task 7.4: Update available capacity display
 * Task 7.5: Update utilization percentage and progress bar
 * 
 * @param {HTMLElement} card - The CY card element
 * @param {Object} allocation - The allocation data
 * @param {string} size - Container size ('20ft' or '40ft')
 * @param {number} pendingCount - Number of pending containers for this size
 */
function updateSizeSection(card, allocation, size, pendingCount) {
    const capacity = allocation[`capacity_${size}`] || 0;
    const allocated = allocation[`allocated_${size}`] || 0;
    const preForecast = allocation[`pre_forecast_${size}`] || 0;
    
    // Skip if not configured
    if (capacity === 0 || capacity === null) return;
    
    // Calculate new values with pending containers
    const newPreForecast = preForecast + pendingCount;
    const newUsed = allocated + newPreForecast;
    const newAvailable = Math.max(0, capacity - newUsed);
    const utilization = (newUsed / capacity) * 100;
    
    // Task 7.3: Update pre-forecast display with orange pending count
    const preForecastDisplay = card.querySelector(`.cy-pre-forecast-${size}-display`);
    if (preForecastDisplay) {
        if (pendingCount > 0) {
            preForecastDisplay.innerHTML = `${preForecast} <span class="text-orange-600 font-bold">+${pendingCount}</span> containers`;
        } else {
            preForecastDisplay.textContent = `${preForecast} containers`;
        }
    }
    
    // Task 7.4: Update available capacity display
    const availableDisplay = card.querySelector(`.cy-available-${size}-display`);
    if (availableDisplay) {
        availableDisplay.textContent = `${newAvailable} containers`;
    }
    
    // Task 7.5: Update utilization percentage
    const utilizationDisplay = card.querySelector(`.cy-utilization-${size}-percent`);
    if (utilizationDisplay) {
        utilizationDisplay.textContent = `${utilization.toFixed(1)}%`;
    }
    
    // Task 7.5: Update progress bar with color coding
    const utilizationBar = card.querySelector(`.cy-utilization-${size}-bar`);
    if (utilizationBar) {
        let barColor = 'bg-green-600';
        if (utilization >= 90) {
            barColor = 'bg-red-600';
        } else if (utilization >= 70) {
            barColor = 'bg-yellow-500';
        }
        
        utilizationBar.className = `cy-utilization-${size}-bar h-2 rounded-full transition-all duration-300 ${barColor}`;
        utilizationBar.style.width = `${Math.min(utilization, 100)}%`;
    }
    
    // Update status badge for this size section
    const sizeSection = card.querySelector(`.size-section-${size}`);
    if (sizeSection) {
        const statusBadge = sizeSection.querySelector('.inline-flex.items-center');
        if (statusBadge) {
            let statusColor = 'bg-green-100 text-green-800';
            let statusText = 'Available';
            
            if (utilization >= 90) {
                statusColor = 'bg-red-100 text-red-800';
                statusText = 'At Capacity';
            } else if (utilization >= 70) {
                statusColor = 'bg-yellow-100 text-yellow-800';
                statusText = 'Near Capacity';
            }
            
            statusBadge.className = `inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${statusColor}`;
            statusBadge.textContent = statusText;
        }
    }
}

/**
 * Helper function to calculate utilization for a specific size
 * @param {Object} allocation - The allocation data
 * @param {string} size - Container size ('20ft' or '40ft')
 * @param {number} pendingCount - Number of pending containers
 * @returns {number} Utilization percentage
 */
function calculateSizeUtilization(allocation, size, pendingCount) {
    const capacity = allocation[`capacity_${size}`] || 0;
    if (capacity === 0) return 0;
    
    const allocated = allocation[`allocated_${size}`] || 0;
    const preForecast = allocation[`pre_forecast_${size}`] || 0;
    const used = allocated + preForecast + pendingCount;
    
    return (used / capacity) * 100;
}

function handleFormSubmit(e) {
    e.preventDefault();
    
    // Clear previous errors
    clearErrors();
    
    // Collect form data
    const formData = {
        blNumber: document.getElementById('blNumber').value,
        vesselNumber: document.getElementById('vesselNumber').value,
        eta: document.getElementById('eta').value,
        consigneeId: document.getElementById('consigneeId').value,
        containers: []
    };
    
    // Collect container data
    const containerRows = document.querySelectorAll('.container-row');
    containerRows.forEach(row => {
        const index = row.dataset.index;
        const container = {
            number: row.querySelector(`[name="containers[${index}][number]"]`).value,
            typeId: row.querySelector(`[name="containers[${index}][typeId]"]`).value,
            sizeId: row.querySelector(`[name="containers[${index}][sizeId]"]`).value,
            cyAllocationId: row.querySelector(`[name="containers[${index}][cyAllocationId]"]`).value
        };
        formData.containers.push(container);
    });
    
    // Validate
    if (!validateForm(formData)) {
        return;
    }
    
    // Submit
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating...';
    
    fetch('/noa/create', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('NOA created successfully!');
            window.location.href = '/manifest-workflow';
        } else {
            alert('Error: ' + (data.error || 'Failed to create NOA'));
            submitBtn.disabled = false;
            submitBtn.textContent = 'Create NOA';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while creating the NOA');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create NOA';
    });
}

function validateForm(formData) {
    let isValid = true;
    
    if (!formData.blNumber) {
        showError('blNumberError', 'BL number is required');
        isValid = false;
    }
    
    if (!formData.vesselNumber) {
        showError('vesselNumberError', 'Vessel number is required');
        isValid = false;
    }
    
    if (!formData.eta) {
        showError('etaError', 'ETA is required');
        isValid = false;
    }
    
    if (!formData.consigneeId) {
        showError('consigneeIdError', 'Consignee is required');
        isValid = false;
    }
    
    if (formData.containers.length === 0) {
        showError('containersError', 'At least one container is required');
        isValid = false;
    }
    
    // Validate each container has a CY allocation
    formData.containers.forEach((container, idx) => {
        if (!container.cyAllocationId) {
            showError('containersError', `Container ${idx + 1} requires a CY location`);
            isValid = false;
        }
    });
    
    // Validate capacity for each CY allocation
    const capacityValidation = validateCYCapacity(formData.containers);
    if (!capacityValidation.valid) {
        // Task 9.5: Show comprehensive error message in error modal
        showCapacityErrorModal(capacityValidation);
        
        // Task 9.6: Add visual feedback (red border) to affected CY cards
        capacityValidation.affectedAllocations.forEach(allocationId => {
            const card = document.querySelector(`[data-allocation-id="${allocationId}"]`);
            if (card) {
                card.classList.add('border-red-500', 'border-4');
                // Add a pulsing animation for better visibility
                card.style.animation = 'pulse-red 2s infinite';
            }
        });
        
        isValid = false;
    }
    
    return isValid;
}

/**
 * Task 9: Validate CY capacity for all containers with size-specific validation
 * Returns validation result with comprehensive error messages and alternatives
 */
function validateCYCapacity(containers) {
    const allocationUsage = {};
    
    // Task 9.1, 9.2: Calculate container counts per allocation and size
    containers.forEach(container => {
        const allocationId = container.cyAllocationId;
        const sizeId = container.sizeId;
        const size = containerSizes[sizeId];
        
        if (!size) return;
        
        if (!allocationUsage[allocationId]) {
            allocationUsage[allocationId] = { '20ft': 0, '40ft': 0 };
        }
        
        // Determine size based on TEU value
        const teuValue = parseFloat(size.teuValue);
        if (teuValue === 1.0) {
            allocationUsage[allocationId]['20ft']++;
        } else if (teuValue === 2.0) {
            allocationUsage[allocationId]['40ft']++;
        }
    });
    
    // Check each allocation's capacity per size
    const affectedAllocations = [];
    const errors = [];
    
    for (const [allocationId, usage] of Object.entries(allocationUsage)) {
        const allocation = cyAllocations.find(a => a.id == allocationId);
        if (!allocation) continue;
        
        // Task 9.1: Validate 20ft capacity
        if (usage['20ft'] > 0) {
            const required20ft = usage['20ft'];
            const available20ft = allocation.available_20ft || 0;
            
            if (required20ft > available20ft) {
                // Task 9.3: Include terminal name, required count, and available count
                const errorMessage = `Insufficient 20ft capacity at ${allocation.terminal_name}.\n` +
                                   `Required: ${required20ft} containers, Available: ${available20ft} containers`;
                
                // Task 9.4: Add alternative location suggestions (up to 3) sorted by available capacity
                const alternatives = findAlternativeLocations('20ft', required20ft, allocationId);
                
                errors.push({
                    message: errorMessage,
                    alternatives: alternatives,
                    size: '20ft',
                    allocationId: allocationId
                });
                
                affectedAllocations.push(allocationId);
            }
        }
        
        // Task 9.2: Validate 40ft capacity
        if (usage['40ft'] > 0) {
            const required40ft = usage['40ft'];
            const available40ft = allocation.available_40ft || 0;
            
            if (required40ft > available40ft) {
                // Task 9.3: Include terminal name, required count, and available count
                const errorMessage = `Insufficient 40ft capacity at ${allocation.terminal_name}.\n` +
                                   `Required: ${required40ft} containers, Available: ${available40ft} containers`;
                
                // Task 9.4: Add alternative location suggestions (up to 3) sorted by available capacity
                const alternatives = findAlternativeLocations('40ft', required40ft, allocationId);
                
                errors.push({
                    message: errorMessage,
                    alternatives: alternatives,
                    size: '40ft',
                    allocationId: allocationId
                });
                
                if (!affectedAllocations.includes(allocationId)) {
                    affectedAllocations.push(allocationId);
                }
            }
        }
    }
    
    if (errors.length > 0) {
        // Task 9.5: Format comprehensive error message
        const formattedMessage = formatCapacityErrorMessage(errors);
        
        return {
            valid: false,
            message: formattedMessage,
            affectedAllocations: affectedAllocations,
            errors: errors
        };
    }
    
    return { valid: true };
}

/**
 * Task 9.4: Find alternative CY locations with sufficient capacity
 * Returns up to 3 alternatives sorted by available capacity (highest first)
 * 
 * @param {string} size - Container size ('20ft' or '40ft')
 * @param {number} requiredCount - Number of containers needed
 * @param {string} excludeAllocationId - Allocation ID to exclude from alternatives
 * @returns {Array} Array of alternative location objects
 */
function findAlternativeLocations(size, requiredCount, excludeAllocationId) {
    // Filter allocations with sufficient capacity for the specific size
    const alternatives = cyAllocations
        .filter(a => {
            if (a.id == excludeAllocationId) return false;
            const available = a[`available_${size}`] || 0;
            return available >= requiredCount;
        })
        .map(a => ({
            id: a.id,
            name: a.terminal_name,
            available: a[`available_${size}`] || 0,
            size: size
        }))
        .sort((a, b) => b.available - a.available) // Sort by available capacity (highest first)
        .slice(0, 3); // Limit to 3 alternatives
    
    return alternatives;
}

/**
 * Task 9.5: Format comprehensive error message with alternatives
 * 
 * @param {Array} errors - Array of error objects
 * @returns {string} Formatted error message
 */
function formatCapacityErrorMessage(errors) {
    let message = '';
    
    errors.forEach((error, index) => {
        if (index > 0) message += '\n\n';
        
        message += error.message;
        
        // Add alternative suggestions if available
        if (error.alternatives && error.alternatives.length > 0) {
            message += '\n\nAlternative locations:';
            error.alternatives.forEach(alt => {
                message += `\n• ${alt.name} (${alt.available} ${alt.size} available)`;
            });
        } else {
            message += `\n\nNo alternative locations have sufficient ${error.size} capacity.`;
        }
    });
    
    return message;
}

function showError(elementId, message) {
    const errorElement = document.getElementById(elementId);
    errorElement.textContent = message;
    errorElement.classList.remove('hidden');
}

/**
 * Task 9.5: Show error modal component for capacity validation failures
 * Displays comprehensive error messages with size-specific information and alternatives
 * 
 * @param {Object} validationResult - Validation result from validateCYCapacity()
 */
function showCapacityErrorModal(validationResult) {
    // Create modal if it doesn't exist
    let modal = document.getElementById('capacityErrorModal');
    if (!modal) {
        modal = createCapacityErrorModal();
        document.body.appendChild(modal);
    }
    
    // Populate modal content
    const modalContent = modal.querySelector('#capacityErrorContent');
    modalContent.innerHTML = '';
    
    // Add header
    const header = document.createElement('div');
    header.className = 'mb-4';
    header.innerHTML = `
        <h3 class="text-lg font-semibold text-red-600 mb-2">
            <svg class="inline-block w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            Insufficient Capacity
        </h3>
        <p class="text-sm text-gray-600">The following CY locations do not have sufficient capacity for your containers:</p>
    `;
    modalContent.appendChild(header);
    
    // Add error details for each affected allocation
    validationResult.errors.forEach((error, index) => {
        const errorSection = document.createElement('div');
        errorSection.className = 'mb-4 p-4 bg-red-50 border border-red-200 rounded-lg';
        
        let errorHTML = `
            <div class="flex items-start mb-2">
                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-semibold bg-red-100 text-red-800 mr-2">
                    ${error.size}
                </span>
                <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900">${error.message.split('\n')[0]}</p>
                    <p class="text-sm text-gray-700 mt-1">${error.message.split('\n').slice(1).join(' ')}</p>
                </div>
            </div>
        `;
        
        // Add alternatives if available
        if (error.alternatives && error.alternatives.length > 0) {
            errorHTML += `
                <div class="mt-3 pt-3 border-t border-red-200">
                    <p class="text-xs font-semibold text-gray-700 mb-2">Alternative locations:</p>
                    <div class="space-y-1">
            `;
            
            error.alternatives.forEach(alt => {
                errorHTML += `
                    <div class="flex items-center justify-between text-sm bg-white p-2 rounded border border-gray-200">
                        <span class="font-medium text-gray-900">${alt.name}</span>
                        <span class="text-green-600 font-semibold">${alt.available} ${alt.size} available</span>
                    </div>
                `;
            });
            
            errorHTML += `
                    </div>
                </div>
            `;
        } else {
            errorHTML += `
                <div class="mt-3 pt-3 border-t border-red-200">
                    <p class="text-xs text-gray-600 italic">No alternative locations have sufficient ${error.size} capacity.</p>
                </div>
            `;
        }
        
        errorSection.innerHTML = errorHTML;
        modalContent.appendChild(errorSection);
    });
    
    // Show modal
    modal.classList.remove('hidden');
}

/**
 * Create the capacity error modal element
 * @returns {HTMLElement} Modal element
 */
function createCapacityErrorModal() {
    // Add CSS animation for pulsing red border if not already added
    if (!document.getElementById('capacityErrorStyles')) {
        const style = document.createElement('style');
        style.id = 'capacityErrorStyles';
        style.textContent = `
            @keyframes pulse-red {
                0%, 100% {
                    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
                }
                50% {
                    box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
                }
            }
        `;
        document.head.appendChild(style);
    }
    
    const modal = document.createElement('div');
    modal.id = 'capacityErrorModal';
    modal.className = 'hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50';
    modal.innerHTML = `
        <div class="relative top-20 mx-auto p-5 border w-11/12 md:w-3/4 lg:w-1/2 shadow-lg rounded-lg bg-white">
            <div class="flex justify-between items-start mb-4">
                <div class="flex-1" id="capacityErrorContent">
                    <!-- Content will be populated dynamically -->
                </div>
                <button onclick="closeCapacityErrorModal()" class="ml-4 text-gray-400 hover:text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="flex justify-end pt-4 border-t border-gray-200">
                <button onclick="closeCapacityErrorModal()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    Close
                </button>
            </div>
        </div>
    `;
    
    // Close modal when clicking outside
    modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            closeCapacityErrorModal();
        }
    });
    
    return modal;
}

/**
 * Close the capacity error modal
 */
function closeCapacityErrorModal() {
    const modal = document.getElementById('capacityErrorModal');
    if (modal) {
        modal.classList.add('hidden');
    }
    
    // Clear visual feedback from CY cards
    clearCYCardErrorHighlights();
}

/**
 * Task 9.6: Clear red border visual feedback from CY cards
 */
function clearCYCardErrorHighlights() {
    const cards = document.querySelectorAll('.cy-card');
    cards.forEach(card => {
        card.classList.remove('border-red-500', 'border-4');
        card.style.animation = '';
    });
}

function clearErrors() {
    const errorElements = document.querySelectorAll('[id$="Error"]');
    errorElements.forEach(element => {
        element.textContent = '';
        element.classList.add('hidden');
    });
    
    // Also clear CY card error highlights
    clearCYCardErrorHighlights();
}
