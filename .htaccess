# DocumentRoot is the Symfony project folder (not public/).
# All requests are routed to public/index.php — never rewrite to the public/ directory itself.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Fix broken /public/public/... bookmarked URLs
    RewriteRule ^public(/public)+(.*)$ %{ENV:BASE}/$2 [R=301,L,QSA]

    # Redirect old /public/* URLs to clean paths
    RewriteRule ^public/(.*)$ %{ENV:BASE}/$1 [R=301,L,QSA]
    RewriteRule ^public/?$ %{ENV:BASE}/ [R=301,L]

    # Serve static files from public/ (css, js, vendor, images, ...)
    RewriteCond %{DOCUMENT_ROOT}%{ENV:BASE}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}%{ENV:BASE}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Front controller (homepage + all routes)
    RewriteRule ^ public/index.php [L]
</IfModule>
