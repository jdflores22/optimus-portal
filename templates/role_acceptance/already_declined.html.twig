{% extends 'base.html.twig' %}

{% block title %}Already Declined - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="text-center">
            <div class="mx-auto h-16 w-16 bg-orange-100 rounded-full flex items-center justify-center mb-4">
                <svg class="h-8 w-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18.364 5.636M5.636 18.364l12.728-12.728"></path>
                </svg>
            </div>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">Already Declined</h2>
            <p class="text-gray-600">You have already declined this role invitation.</p>
        </div>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
            <div class="text-center space-y-6">
                <div class="bg-orange-50 border border-orange-200 rounded-lg p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-orange-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3 text-left">
                            <h3 class="text-sm font-medium text-orange-800">❌ Invitation Previously Declined</h3>
                            <div class="mt-2 text-sm text-orange-700">
                                <p>You have already declined the {{ pendingUser.role.value|title|replace({'_': ' '}) }} role invitation. The administrator has been notified of your decision.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 rounded-lg p-4">
                    <h4 class="text-sm font-medium text-gray-900 mb-3">Invitation Details</h4>
                    <dl class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Email:</dt>
                            <dd class="text-gray-900 font-medium">{{ pendingUser.email }}</dd>
                        </div>
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Role:</dt>
                            <dd class="text-gray-900 font-medium">{{ pendingUser.role.value|title|replace({'_': ' '}) }}</dd>
                        </div>
                        {% if pendingUser.shippingLine %}
                            <div class="flex justify-between text-sm">
                                <dt class="text-gray-500">Shipping Line:</dt>
                                <dd class="text-gray-900 font-medium">{{ pendingUser.shippingLine.name }}</dd>
                            </div>
                        {% endif %}
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Status:</dt>
                            <dd class="text-gray-900 font-medium">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                    ✗ Declined
                                </span>
                            </dd>
                        </div>
                    </dl>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-blue-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3 text-left">
                            <h3 class="text-sm font-medium text-blue-800">What This Means</h3>
                            <div class="mt-2 text-sm text-blue-700">
                                <ul class="list-disc list-inside space-y-1">
                                    <li>No account was created for you</li>
                                    <li>The administrator has been notified of your decision</li>
                                    <li>This invitation link is no longer valid</li>
                                    <li>You will not receive any further emails about this invitation</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-yellow-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3 text-left">
                            <h3 class="text-sm font-medium text-yellow-800">Changed Your Mind?</h3>
                            <div class="mt-2 text-sm text-yellow-700">
                                <p>If you would like to reconsider and accept the role, please contact the administrator who sent you this invitation. They can send you a new invitation if they choose to.</p>
                                <p class="mt-2 font-medium">
                                    Administrator: 
                                    <a href="mailto:{{ pendingUser.createdByAdmin.email }}" class="text-yellow-800 hover:text-yellow-900 underline">
                                        {{ pendingUser.createdByAdmin.email }}
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    <p class="text-xs text-gray-500 text-center">
                        You can close this window. Thank you for your response.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-8 text-center">
        <p class="text-sm text-gray-500">
            Need to discuss this decision? 
            <a href="mailto:{{ pendingUser.createdByAdmin.email }}" class="font-medium text-blue-600 hover:text-blue-500">
                Contact Administrator
            </a>
        </p>
    </div>
</div>
{% endblock %}