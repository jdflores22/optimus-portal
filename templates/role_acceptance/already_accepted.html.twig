{% extends 'base.html.twig' %}

{% block title %}Already Accepted - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="text-center">
            <div class="mx-auto h-16 w-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">Already Accepted!</h2>
            <p class="text-gray-600">You have already accepted this role invitation.</p>
        </div>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
            <div class="text-center space-y-6">
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-green-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3 text-left">
                            <h3 class="text-sm font-medium text-green-800">✅ Invitation Successfully Accepted</h3>
                            <div class="mt-2 text-sm text-green-700">
                                <p><strong>Good news!</strong> You have already accepted the {{ pendingUser.role.value|title|replace({'_': ' '}) }} role invitation. Your account has been created, is ready to use, and your email address is verified.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 rounded-lg p-4">
                    <h4 class="text-sm font-medium text-gray-900 mb-3">Account Information</h4>
                    <dl class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Email:</dt>
                            <dd class="text-gray-900 font-medium">{{ pendingUser.email }}</dd>
                        </div>
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Role:</dt>
                            <dd class="text-gray-900 font-medium">{{ pendingUser.role.value|title|replace({'_': ' '}) }}</dd>
                        </div>
                        {% if pendingUser.shippingLine %}
                            <div class="flex justify-between text-sm">
                                <dt class="text-gray-500">Shipping Line:</dt>
                                <dd class="text-gray-900 font-medium">{{ pendingUser.shippingLine.name }}</dd>
                            </div>
                        {% endif %}
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Status:</dt>
                            <dd class="text-gray-900 font-medium">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    ✓ Active & Verified
                                </span>
                            </dd>
                        </div>
                    </dl>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-blue-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3 text-left">
                            <h3 class="text-sm font-medium text-blue-800">Your Account is Ready</h3>
                            <div class="mt-2 text-sm text-blue-700">
                                <ul class="list-disc list-inside space-y-1">
                                    <li>Your account has been created and is active</li>
                                    <li>Your email address is verified (no additional verification needed)</li>
                                    <li>You should have received login credentials via email</li>
                                    <li>You can now access the OPTIMUS Portal</li>
                                    <li>Check your email for welcome instructions</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    <a href="{{ path('app_login') }}" 
                       class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                        </svg>
                        Go to Login Page
                    </a>
                    
                    <p class="text-xs text-gray-500 text-center">
                        You can close this window and use your login credentials to access the portal.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-8 text-center">
        <p class="text-sm text-gray-500">
            Need help logging in? 
            <a href="mailto:{{ pendingUser.createdByAdmin.email }}" class="font-medium text-blue-600 hover:text-blue-500">
                Contact Administrator
            </a>
        </p>
    </div>
</div>
{% endblock %}