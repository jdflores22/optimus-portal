{% extends 'base.html.twig' %}

{% block title %}Role Invitation - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-2xl">
        <div class="text-center mb-8">
            {% if shipping_line %}
                <div class="mx-auto h-20 w-20 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                    <svg class="h-10 w-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H3m2 0h3M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                </div>
                <h2 class="text-3xl font-bold text-gray-900 mb-2">{{ shipping_line.name }}</h2>
                <p class="text-lg text-gray-600 mb-4">Role Invitation</p>
            {% else %}
                <div class="mx-auto h-20 w-20 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                    <svg class="h-10 w-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <h2 class="text-3xl font-bold text-gray-900 mb-2">OPTIMUS Portal</h2>
                <p class="text-lg text-gray-600 mb-4">Role Invitation</p>
            {% endif %}
        </div>
    </div>

    <div class="sm:mx-auto sm:w-full sm:max-w-2xl">
        <div class="bg-white py-8 px-4 shadow-lg sm:rounded-lg sm:px-10">
            <!-- Flash Messages -->
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 rounded-md p-4 {% if type == 'error' %}bg-red-50 border border-red-200{% elseif type == 'success' %}bg-green-50 border border-green-200{% else %}bg-blue-50 border border-blue-200{% endif %}">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                {% if type == 'error' %}
                                    <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                {% elseif type == 'success' %}
                                    <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                    </svg>
                                {% else %}
                                    <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                    </svg>
                                {% endif %}
                            </div>
                            <div class="ml-3">
                                <p class="text-sm {% if type == 'error' %}text-red-800{% elseif type == 'success' %}text-green-800{% else %}text-blue-800{% endif %}">
                                    {{ message }}
                                </p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="space-y-8">
                <!-- Invitation Details -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <h3 class="text-lg font-medium text-blue-900 mb-4">You've been invited to join OPTIMUS Portal</h3>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-medium text-blue-800">Your Name:</span>
                            <span class="text-sm text-blue-900">{{ pendingUser.fullName }}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-medium text-blue-800">Email:</span>
                            <span class="text-sm text-blue-900">{{ pendingUser.email }}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-medium text-blue-800">Role:</span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                {{ pendingUser.role.value|title|replace({'_': ' '}) }}
                            </span>
                        </div>
                        {% if shipping_line %}
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-blue-800">Shipping Line:</span>
                                <span class="text-sm text-blue-900">{{ shipping_line.name }}</span>
                            </div>
                        {% endif %}
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-medium text-blue-800">Invited By:</span>
                            <span class="text-sm text-blue-900">{{ pendingUser.createdByAdmin.email }}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-medium text-blue-800">Expires:</span>
                            <span class="text-sm text-blue-900">{{ expires_at|date('M d, Y \\a\\t g:i A') }}</span>
                        </div>
                    </div>
                </div>

                <!-- Role Description -->
                <div class="bg-gray-50 rounded-lg p-6">
                    <h4 class="text-lg font-medium text-gray-900 mb-3">Role Responsibilities</h4>
                    <div class="text-sm text-gray-700">
                        {% set role_value = pendingUser.role.value %}
                        {% if role_value == 'SHIPPING_LINES_ADMIN' %}
                            <p>As a Shipping Lines Administrator, you will have access to:</p>
                            <ul class="mt-2 list-disc list-inside space-y-1">
                                <li>Manage shipping line operations and staff</li>
                                <li>Create and manage user accounts for your shipping line</li>
                                <li>Access administrative reports and analytics</li>
                                <li>Configure shipping line settings and preferences</li>
                            </ul>
                        {% elseif role_value == 'SL_STAFF' %}
                            <p>As Shipping Line Staff, you will have access to:</p>
                            <ul class="mt-2 list-disc list-inside space-y-1">
                                <li>Process shipment documentation</li>
                                <li>Manage cargo operations</li>
                                <li>Access shipping line specific features</li>
                                <li>Collaborate with team members</li>
                            </ul>
                        {% elseif role_value == 'EVALUATOR' %}
                            <p>As an Evaluator, you will have access to:</p>
                            <ul class="mt-2 list-disc list-inside space-y-1">
                                <li>Review and evaluate shipment documentation</li>
                                <li>Approve or reject submissions</li>
                                <li>Access evaluation tools and reports</li>
                                <li>Manage evaluation workflows</li>
                            </ul>
                        {% elseif role_value == 'ACCOUNTING' %}
                            <p>As an Accounting user, you will have access to:</p>
                            <ul class="mt-2 list-disc list-inside space-y-1">
                                <li>Financial reporting and analytics</li>
                                <li>Payment processing and tracking</li>
                                <li>Invoice management</li>
                                <li>Accounting-specific features</li>
                            </ul>
                        {% else %}
                            <p>You will have access to features and functionality specific to your assigned role in the OPTIMUS Portal system.</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <!-- Accept Form -->
                    <form method="POST" action="{{ path('role_acceptance_accept', {'token': token}) }}" class="flex-1" id="acceptForm">
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                        <button type="button" 
                                onclick="showAcceptModal()"
                                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Accept Role
                        </button>
                    </form>

                    <!-- Decline Form -->
                    <form method="POST" action="{{ path('role_acceptance_decline', {'token': token}) }}" class="flex-1" id="declineForm">
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                        <button type="button" 
                                onclick="showDeclineModal()"
                                class="w-full flex justify-center py-3 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            Decline Role
                        </button>
                    </form>
                </div>

                <!-- Contact Information -->
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-yellow-800">Need Help?</h3>
                            <div class="mt-2 text-sm text-yellow-700">
                                <p>If you have questions about this invitation or your role, please contact:</p>
                                <p class="mt-1 font-medium">
                                    <a href="mailto:{{ admin_contact }}" class="text-yellow-800 hover:text-yellow-900 underline">
                                        {{ admin_contact }}
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 text-center">
        <p class="text-sm text-gray-500">
            This invitation expires on {{ expires_at|date('M d, Y \\a\\t g:i A') }}
        </p>
        <p class="text-xs text-gray-400 mt-2">
            OPTIMUS Portal - Shipping Lines Management System
        </p>
    </div>
</div>

<!-- Accept Confirmation Modal -->
<div id="acceptModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999]">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3 text-center">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100">
                <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mt-4">Accept Role Invitation</h3>
            <div class="mt-2 px-7 py-3">
                <p class="text-sm text-gray-500">
                    Are you sure you want to accept this role? This will:
                </p>
                <ul class="mt-2 text-sm text-gray-600 text-left list-disc list-inside">
                    <li>Create your user account immediately</li>
                    <li>Send you login credentials via email</li>
                    <li>Grant you access to OPTIMUS Portal</li>
                    <li>Notify the administrator of your acceptance</li>
                </ul>
            </div>
            <div class="items-center px-4 py-3">
                <button onclick="confirmAccept()" 
                        class="px-4 py-2 bg-green-600 text-white text-base font-medium rounded-md w-24 mr-2 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-300">
                    Accept
                </button>
                <button onclick="hideAcceptModal()" 
                        class="px-4 py-2 bg-gray-300 text-gray-800 text-base font-medium rounded-md w-24 hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-300">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Decline Confirmation Modal -->
<div id="declineModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999]">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3 text-center">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mt-4">Decline Role Invitation</h3>
            <div class="mt-2 px-7 py-3">
                <p class="text-sm text-gray-500">
                    Are you sure you want to decline this role invitation? This will:
                </p>
                <ul class="mt-2 text-sm text-gray-600 text-left list-disc list-inside">
                    <li>Cancel this invitation permanently</li>
                    <li>Notify the administrator of your decision</li>
                    <li>Prevent you from accessing OPTIMUS Portal</li>
                    <li>Require a new invitation to join later</li>
                </ul>
            </div>
            <div class="items-center px-4 py-3">
                <button onclick="confirmDecline()" 
                        class="px-4 py-2 bg-red-600 text-white text-base font-medium rounded-md w-24 mr-2 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300">
                    Decline
                </button>
                <button onclick="hideDeclineModal()" 
                        class="px-4 py-2 bg-gray-300 text-gray-800 text-base font-medium rounded-md w-24 hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-300">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Modal functions
function showAcceptModal() {
    document.getElementById('acceptModal').classList.remove('hidden');
}

function hideAcceptModal() {
    document.getElementById('acceptModal').classList.add('hidden');
}

function showDeclineModal() {
    document.getElementById('declineModal').classList.remove('hidden');
}

function hideDeclineModal() {
    document.getElementById('declineModal').classList.add('hidden');
}

function confirmAccept() {
    document.getElementById('acceptForm').submit();
}

function confirmDecline() {
    document.getElementById('declineForm').submit();
}

// Close modals when clicking outside
document.getElementById('acceptModal').addEventListener('click', function(e) {
    if (e.target === this) {
        hideAcceptModal();
    }
});

document.getElementById('declineModal').addEventListener('click', function(e) {
    if (e.target === this) {
        hideDeclineModal();
    }
});

// Close modals with Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        hideAcceptModal();
        hideDeclineModal();
    }
});
</script>

{% endblock %}