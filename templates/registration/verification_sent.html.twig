{% extends 'base.html.twig' %}

{% block title %}Check Your Email - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        {% include 'components/_brand_mark.html.twig' with { size: 'md' } %}
        <div class="text-center">
            <div class="mx-auto h-16 w-16 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">Check Your Email</h2>
            <p class="text-gray-600">We've sent a verification link to your email address.</p>
        </div>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
            <!-- Flash Messages -->
            {% for message in app.flashes('success') %}
                <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg">
                    <div class="flex">
                        <svg class="w-5 h-5 text-green-400 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                        {{ message }}
                    </div>
                </div>
            {% endfor %}

            <div class="text-center space-y-6">
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <h3 class="text-lg font-medium text-blue-900 mb-3">📧 Verification Email Sent</h3>
                    <p class="text-sm text-blue-800 mb-4">
                        We've sent a verification email to:
                    </p>
                    <p class="text-base font-semibold text-blue-900 bg-white px-4 py-2 rounded border">
                        {{ email }}
                    </p>
                </div>

                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-yellow-800">Next Steps</h3>
                            <div class="mt-2 text-sm text-yellow-700">
                                <ol class="list-decimal list-inside space-y-1">
                                    <li>Check your email inbox (and spam folder)</li>
                                    <li>Click the verification link in the email</li>
                                    <li>Wait for account approval from our team</li>
                                    <li>You'll receive a notification when approved</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 rounded-lg p-4">
                    <h4 class="text-sm font-medium text-gray-900 mb-3">Registration Details</h4>
                    <dl class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Account Type:</dt>
                            <dd class="text-gray-900 font-medium">{{ userType|title }}</dd>
                        </div>
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Email:</dt>
                            <dd class="text-gray-900 font-medium">{{ email }}</dd>
                        </div>
                        <div class="flex justify-between text-sm">
                            <dt class="text-gray-500">Status:</dt>
                            <dd class="text-gray-900 font-medium">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                    Email Verification Pending
                                </span>
                            </dd>
                        </div>
                    </dl>
                </div>

                <div class="space-y-3">
                    <div class="text-sm text-gray-600">
                        <p class="mb-2">Didn't receive the email?</p>
                        <a href="{{ path('email_verification_resend') }}" 
                           class="font-medium text-blue-600 hover:text-blue-500">
                            Resend verification email
                        </a>
                    </div>
                    
                    <div class="pt-4 border-t border-gray-200">
                        <a href="{{ path('app_login') }}" 
                           class="text-sm font-medium text-gray-600 hover:text-gray-500">
                            ← Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-8 text-center">
        <p class="text-sm text-gray-500">
            Need help? 
            <a href="mailto:{{ support_email }}" class="font-medium text-blue-600 hover:text-blue-500">
                Contact Support
            </a>
        </p>
    </div>
</div>
{% endblock %}