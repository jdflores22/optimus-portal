{% extends 'base.html.twig' %}

{% block title %}Container Inventory - OPTIMUS{% endblock %}

{% block body %}
<div class="space-y-5">
    <!-- Breadcrumb -->
    <div class="breadcrumbs text-sm">
        <ul>
            <li>
                <a href="{% if app.user.role.value == 'SHIPPING_LINES_ADMIN' %}{{ path('app_shipping_admin_dashboard') }}{% elseif app.user.role.value == 'SL_STAFF' %}{{ path('app_sl_staff_dashboard') }}{% elseif app.user.role.value == 'ACCOUNTING' %}{{ path('app_accounting_dashboard_new') }}{% elseif app.user.role.value == 'TERMINAL_TEAM' %}{{ path('app_terminal_team_dashboard') }}{% endif %}" class="inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Dashboard
                </a>
            </li>
            <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right]"></span></li>
            <li aria-current="page">Container Inventory</li>
        </ul>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-base-content">Container Inventory</h1>
                <p class="text-sm text-base-content/60 mt-1">All containers across all depots - {{ shippingLineName }}</p>
            </div>
        </div>
        <div class="text-left sm:text-right">
            <p class="text-sm text-base-content/60">Total Containers</p>
            <p class="text-3xl font-bold text-base-content">{{ totalContainers }}</p>
        </div>
    </div>

    <!-- Summary Statistics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        <!-- Total Containers -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-primary hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-primary" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.total_20ft + stats.total_40ft }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">Total Containers</p>
                <p class="text-xs text-base-content/50 mt-1">All depots combined</p>
            </div>
        </div>

        <!-- Total TEUs -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-success hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-success/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-success" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V4a2 2 0 00-2-2H6zm1 2a1 1 0 000 2h6a1 1 0 100-2H7zm6 7a1 1 0 011 1v3a1 1 0 11-2 0v-3a1 1 0 011-1zm-3 3a1 1 0 100 2h.01a1 1 0 100-2H10zm-4 1a1 1 0 011-1h.01a1 1 0 110 2H7a1 1 0 01-1-1zm1-4a1 1 0 100 2h.01a1 1 0 100-2H7zm2 1a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1zm4-4a1 1 0 100 2h.01a1 1 0 100-2H13zM9 9a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1zM7 8a1 1 0 000 2h.01a1 1 0 000-2H7z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.total_20ft + (stats.total_40ft * 2) }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">Total TEUs</p>
                <p class="text-xs text-base-content/50 mt-1">Twenty-foot Equivalent Units</p>
            </div>
        </div>

        <!-- 20ft Containers -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-info hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-info/10 flex items-center justify-center">
                        <span class="text-lg font-bold text-info">20</span>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.total_20ft }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">20ft Containers</p>
                <p class="text-xs text-base-content/50 mt-1">Standard size</p>
            </div>
        </div>

        <!-- 40ft Containers -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-warning hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-warning/10 flex items-center justify-center">
                        <span class="text-lg font-bold text-warning">40</span>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.total_40ft }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">40ft Containers</p>
                <p class="text-xs text-base-content/50 mt-1">High capacity</p>
            </div>
        </div>

        <!-- Overall Capacity -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-error hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-error/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-error" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11 4a1 1 0 10-2 0v4a1 1 0 102 0V7zm-3 1a1 1 0 10-2 0v3a1 1 0 102 0V8zM8 9a1 1 0 00-2 0v2a1 1 0 102 0V9z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ capacityStats.terminal_capacity_teu + capacityStats.container_yard_capacity_teu }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">Overall Capacity</p>
                <p class="text-xs text-base-content/50 mt-1">Total TEU capacity</p>
                <div class="mt-3 pt-3 border-t border-base-300">
                    <p class="text-xs text-base-content/50">{{ capacityStats.terminal_capacity_20ft + capacityStats.container_yard_capacity_20ft }} x 20ft, {{ capacityStats.terminal_capacity_40ft + capacityStats.container_yard_capacity_40ft }} x 40ft</p>
                </div>
            </div>
        </div>

        <!-- Terminal Containers -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-secondary hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-secondary/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm3 1h6v4H7V5zm8 8v2h1a1 1 0 001-1v-1h-2zm-2-1a1 1 0 00-1 1v3a1 1 0 001 1h3a1 1 0 001-1v-3a1 1 0 00-1-1h-3z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ identityStats.terminal_count }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">Terminal</p>
                <p class="text-xs text-base-content/50 mt-1">At terminal facilities</p>
                <div class="mt-3 pt-3 border-t border-base-300">
                    <p class="text-xs text-base-content/60">Capacity: {{ capacityStats.terminal_capacity_teu }} TEU</p>
                    <p class="text-xs text-base-content/50">{{ capacityStats.terminal_capacity_20ft }} x 20ft, {{ capacityStats.terminal_capacity_40ft }} x 40ft</p>
                </div>
            </div>
        </div>

        <!-- Container Yard Containers -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-accent hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-accent/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-accent" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ identityStats.container_yard_count }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">Container Yard</p>
                <p class="text-xs text-base-content/50 mt-1">At container yards</p>
                <div class="mt-3 pt-3 border-t border-base-300">
                    <p class="text-xs text-base-content/60">Capacity: {{ capacityStats.container_yard_capacity_teu }} TEU</p>
                    <p class="text-xs text-base-content/50">{{ capacityStats.container_yard_capacity_20ft }} x 20ft, {{ capacityStats.container_yard_capacity_40ft }} x 40ft</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-4">
            <form method="get" class="flex flex-col md:flex-row md:items-center gap-4">
                <div class="flex-1">
                    <input type="text" name="search" value="{{ filters.search }}" 
                           placeholder="Search by container number..." 
                           class="input input-bordered w-full">
                </div>
                <div class="flex gap-2 flex-wrap">
                    <select name="depot" class="select select-bordered">
                        <option value="">All Depots</option>
                        {% for depot in depots %}
                            <option value="{{ depot }}" {% if filters.depot == depot %}selected{% endif %}>{{ depot }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-primary">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        Search
                    </button>
                    <a href="{{ path('app_container_inventory') }}" class="btn btn-ghost">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Container Table -->
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
            <div class="px-6 py-4 border-b border-base-300">
                <h3 class="text-lg font-semibold text-base-content">Container List</h3>
                <p class="text-sm text-base-content/60">Showing {{ containers|length }} of {{ totalContainers }} containers</p>
            </div>
            
            {% if containers|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="table table-zebra">
                        <thead>
                            <tr>
                                <th>Container Number</th>
                                <th>Size/Type</th>
                                <th>Depot/Location</th>
                                <th>Gate In Date</th>
                                <th>Dwell Time</th>
                                <th>Status</th>
                                <th>Condition</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for container in containers %}
                                <tr>
                                    <td class="font-medium">
                                        <a href="{{ path('app_container_detail', {'containerNumber': container.containerNumber}) }}" 
                                           class="text-primary hover:text-primary/80 no-underline">
                                            {{ container.containerNumber }}
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft badge-lg {% if container.sizeType starts with '20' %}badge-info{% elseif container.sizeType starts with '40' %}badge-warning{% else %}badge-error{% endif %}">
                                            {{ container.sizeType }}
                                        </span>
                                    </td>
                                    <td class="text-sm">{{ container.location }}</td>
                                    <td class="text-sm">{{ container.gateInDate|date('M j, Y') }}</td>
                                    <td>
                                        <div class="flex flex-col gap-1">
                                            <span class="badge badge-soft badge-sm
                                                {% if container.dwellTime <= 7 %}badge-success
                                                {% elseif container.dwellTime <= 14 %}badge-info
                                                {% elseif container.dwellTime <= 21 %}badge-warning
                                                {% else %}badge-error{% endif %}">
                                                {{ container.dwellTime }} days
                                            </span>
                                            {% if container.totalPausedDays > 0 %}
                                                <span class="badge badge-soft badge-ghost badge-sm gap-1">
                                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                    </svg>
                                                    {{ container.totalPausedDays }}d paused
                                                </span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft badge-sm
                                            {% if container.status == 'Available' %}badge-success
                                            {% elseif container.status == 'Pre-Forecast' %}badge-warning
                                            {% else %}badge-ghost{% endif %}">
                                            {{ container.status }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft badge-sm
                                            {% if container.condition == 'Good' %}badge-success
                                            {% elseif container.condition == 'Fair' %}badge-warning
                                            {% else %}badge-error{% endif %}">
                                            {{ container.condition }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_container_detail', {'containerNumber': container.containerNumber}) }}" 
                                           class="btn btn-soft btn-primary btn-xs rounded-full">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                {% if totalPages > 1 %}
                    <div class="flex justify-center items-center gap-2 p-4 border-t border-base-300">
                        <div class="join">
                            {% if currentPage > 1 %}
                                <a href="{{ path('app_container_inventory', {'page': currentPage - 1, 'depot': filters.depot, 'search': filters.search}) }}" class="join-item btn btn-sm">«</a>
                            {% endif %}
                            
                            {% for i in 1..totalPages %}
                                {% if i == currentPage %}
                                    <button class="join-item btn btn-sm btn-active">{{ i }}</button>
                                {% elseif i == 1 or i == totalPages or (i >= currentPage - 2 and i <= currentPage + 2) %}
                                    <a href="{{ path('app_container_inventory', {'page': i, 'depot': filters.depot, 'search': filters.search}) }}" class="join-item btn btn-sm">{{ i }}</a>
                                {% elseif i == currentPage - 3 or i == currentPage + 3 %}
                                    <button class="join-item btn btn-sm btn-disabled">...</button>
                                {% endif %}
                            {% endfor %}
                            
                            {% if currentPage < totalPages %}
                                <a href="{{ path('app_container_inventory', {'page': currentPage + 1, 'depot': filters.depot, 'search': filters.search}) }}" class="join-item btn btn-sm">»</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="p-12 text-center">
                    <svg class="mx-auto h-16 w-16 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                    </svg>
                    <h3 class="mt-4 text-lg font-medium text-base-content">No containers found</h3>
                    <p class="mt-2 text-sm text-base-content/50">Try adjusting your filters or search criteria.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
