{#
    FlyonUI-style horizontal stepper (Tailwind-safe sizing).

    steps: [{ label: 'Application' }, { label: 'Review' }, ...]
    current: 1-based index of the active step
#}
<ul class="relative flex w-full items-start gap-2" aria-label="Application progress">
    {% for step in steps %}
        {% set stepNumber = loop.index %}
        {% set isCurrent = stepNumber == current %}
        {% set isComplete = stepNumber < current %}
        <li class="group flex min-w-0 flex-1 flex-col">
            <div class="flex w-full items-center">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-semibold leading-none {{ isCurrent ? 'bg-primary text-primary-content shadow-sm' : (isComplete ? 'bg-success/15 text-success' : 'bg-base-200 text-base-content/70') }}"
                      aria-current="{{ isCurrent ? 'step' : 'false' }}">
                    {% if isComplete %}
                        <span class="icon-[tabler--check] size-4"></span>
                    {% else %}
                        {{ stepNumber }}
                    {% endif %}
                </span>
                {% if not loop.last %}
                    <div class="mx-2 h-0.5 min-w-[1rem] flex-1 rounded-full {{ isComplete ? 'bg-success/40' : 'bg-base-content/15' }}"></div>
                {% endif %}
            </div>
            <div class="mt-2 pe-2">
                <span class="block text-sm leading-tight {{ isCurrent ? 'font-semibold text-base-content' : 'text-base-content/60' }}">
                    {{ step.label }}
                </span>
            </div>
        </li>
    {% endfor %}
</ul>
