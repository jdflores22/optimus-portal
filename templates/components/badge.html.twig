{# Badge Component Macro #}
{% macro status_badge(status, size = 'md') %}
    {% set size_class = size == 'sm' ? 'badge-sm' : (size == 'lg' ? 'badge-lg' : '') %}
    {% set status_class = '' %}
    
    {% if status|lower == 'draft' %}
        {% set status_class = 'badge-draft' %}
    {% elseif status|lower == 'pending' %}
        {% set status_class = 'badge-pending' %}
    {% elseif status|lower == 'approved' %}
        {% set status_class = 'badge-approved' %}
    {% elseif status|lower == 'denied' %}
        {% set status_class = 'badge-denied' %}
    {% elseif status|lower == 'rejected' %}
        {% set status_class = 'badge-rejected' %}
    {% elseif status|lower == 'compliance_required' or status|lower == 'compliance required' %}
        {% set status_class = 'badge-compliance' %}
    {% else %}
        {% set status_class = 'badge-draft' %}
    {% endif %}
    
    <span class="badge {{ status_class }} {{ size_class }}">
        {{ status|title|replace({'_': ' '}) }}
    </span>
{% endmacro %}

{% macro custom_badge(text, type = 'primary', size = 'md') %}
    {% set size_class = size == 'sm' ? 'badge-sm' : (size == 'lg' ? 'badge-lg' : '') %}
    {% set type_class = '' %}
    
    {% if type == 'primary' %}
        {% set type_class = 'bg-meta-blue-100 text-meta-blue-700' %}
    {% elseif type == 'secondary' %}
        {% set type_class = 'bg-meta-gray-200 text-meta-gray-700' %}
    {% elseif type == 'success' %}
        {% set type_class = 'bg-green-100 text-green-700' %}
    {% elseif type == 'danger' %}
        {% set type_class = 'bg-red-100 text-red-700' %}
    {% elseif type == 'warning' %}
        {% set type_class = 'bg-yellow-100 text-yellow-700' %}
    {% elseif type == 'info' %}
        {% set type_class = 'bg-blue-100 text-blue-700' %}
    {% endif %}
    
    <span class="badge {{ type_class }} {{ size_class }}">
        {{ text }}
    </span>
{% endmacro %}