{# Alert Component Macros #}
{% macro alert(message, type = 'info', dismissible = false, icon = null) %}
    {% set type_class = '' %}
    {% set default_icon = '' %}
    
    {% if type == 'success' %}
        {% set type_class = 'alert-success' %}
        {% set default_icon = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>' %}
    {% elseif type == 'error' or type == 'danger' %}
        {% set type_class = 'alert-error' %}
        {% set default_icon = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>' %}
    {% elseif type == 'warning' %}
        {% set type_class = 'alert-warning' %}
        {% set default_icon = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>' %}
    {% else %}
        {% set type_class = 'alert-info' %}
        {% set default_icon = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>' %}
    {% endif %}
    
    <div class="{{ type_class }} {{ dismissible ? 'relative' : '' }}" role="alert">
        <div class="flex">
            {% if icon or default_icon %}
                <div class="flex-shrink-0 mr-3">
                    {{ icon ? icon|raw : default_icon|raw }}
                </div>
            {% endif %}
            <div class="flex-1">
                {{ message|raw }}
            </div>
            {% if dismissible %}
                <div class="flex-shrink-0 ml-3">
                    <button type="button" class="inline-flex text-current hover:opacity-75" onclick="this.parentElement.parentElement.parentElement.remove()">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro flash_messages(flash_bag = null) %}
    {% if flash_bag %}
        {% for type, messages in flash_bag %}
            {% for message in messages %}
                {{ _self.alert(message, type, true) }}
            {% endfor %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro validation_errors(errors) %}
    {% if errors|length > 0 %}
        <div class="alert-error mb-4">
            <div class="flex">
                <div class="flex-shrink-0 mr-3">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="font-medium mb-2">Please correct the following errors:</h3>
                    <ul class="list-disc list-inside space-y-1">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    {% endif %}
{% endmacro %}