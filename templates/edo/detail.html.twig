{% extends 'base.html.twig' %}

{% block title %}eDO Details - {{ edo.edoNumber }}{% endblock %}

{% block page_title %}eDO Details{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back Button -->
    <div class="mb-4">
        <a href="{{ path('edo_list') }}" class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to eDO List
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
            <!-- eDO Information Card -->
            <div class="bg-white shadow-sm rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xl font-semibold text-gray-900">{{ edo.edoNumber }}</h2>
                        <span class="px-3 py-1 rounded-full text-sm font-medium
                            {% if edo.status.value == 'active' %}bg-green-100 text-green-800
                            {% elseif edo.status.value == 'expired' %}bg-red-100 text-red-800
                            {% elseif edo.status.value == 'locked' %}bg-yellow-100 text-yellow-800
                            {% elseif edo.status.value == 'released' %}bg-blue-100 text-blue-800
                            {% else %}bg-gray-100 text-gray-800{% endif %}">
                            {{ edo.status.value|upper }}
                        </span>
                    </div>
                </div>

                <div class="px-6 py-6">
                    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-6">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">eDO Number</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.edoNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Status</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.status.value|title }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Generated Date</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.generatedAt|date('Y-m-d H:i:s') }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Expiration Date</dt>
                            <dd class="mt-1 text-sm text-gray-900">
                                {% if edo.expiresAt %}
                                    {{ edo.expiresAt|date('Y-m-d H:i:s') }}
                                {% else %}
                                    N/A
                                {% endif %}
                            </dd>
                        </div>
                        {% if edo.expiredDays %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Expired Days</dt>
                            <dd class="mt-1 text-sm font-semibold text-red-600">{{ edo.expiredDays }} days</dd>
                        </div>
                        {% endif %}
                        {% if edo.releasedAt %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Released Date</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.releasedAt|date('Y-m-d H:i:s') }}</dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>
            </div>

            <!-- Container Details Card -->
            <div class="bg-white shadow-sm rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Container Details</h3>
                </div>
                <div class="px-6 py-6">
                    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-6">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Container Number</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.container.containerNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Container Type</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.container.containerType.name }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Container Size</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.container.containerSize.name }} ({{ edo.container.containerSize.teuValue }} TEU)</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Container Status</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.container.status.value|title }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Manifest Details Card -->
            <div class="bg-white shadow-sm rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Manifest Details</h3>
                </div>
                <div class="px-6 py-6">
                    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-6">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Manifest Number</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.manifest.manifestNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">BL Number</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.manifest.blNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Vessel Number</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.manifest.noa.vesselNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">ETA</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ edo.manifest.noa.eta|date('Y-m-d H:i:s') }}</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Actions Card -->
            <div class="bg-white shadow-sm rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Actions</h3>
                </div>
                <div class="px-6 py-4 space-y-3">
                    {% if edo.status.value == 'expired' %}
                    <a href="{{ path('edo_regeneration_request', {id: edo.id}) }}"
                       class="block w-full px-4 py-2 text-center border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                        Request Re-generation
                    </a>
                    {% endif %}
                    
                    <a href="{{ path('edo_download_pdf', {id: edo.id}) }}"
                       class="block w-full px-4 py-2 text-center border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        Download PDF
                    </a>
                    
                    <a href="{{ path('audit_trail_manifest', {id: edo.manifest.id}) }}"
                       class="block w-full px-4 py-2 text-center border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        View Audit Trail
                    </a>
                </div>
            </div>

            <!-- History Card -->
            <div class="bg-white shadow-sm rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">eDO History</h3>
                </div>
                <div class="px-6 py-4">
                    <div class="flow-root">
                        <ul class="-mb-8">
                            {% for historyEdo in edo.container.edoHistory %}
                            <li>
                                <div class="relative pb-8">
                                    {% if not loop.last %}
                                    <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
                                    {% endif %}
                                    <div class="relative flex space-x-3">
                                        <div>
                                            <span class="h-8 w-8 rounded-full flex items-center justify-center ring-8 ring-white
                                                {% if historyEdo.id == edo.id %}bg-blue-500
                                                {% elseif historyEdo.status.value == 'released' %}bg-green-500
                                                {% else %}bg-gray-400{% endif %}">
                                                <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                                </svg>
                                            </span>
                                        </div>
                                        <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                                            <div>
                                                <p class="text-sm text-gray-900">{{ historyEdo.edoNumber }}</p>
                                                <p class="text-xs text-gray-500">{{ historyEdo.status.value|title }}</p>
                                            </div>
                                            <div class="text-right text-sm whitespace-nowrap text-gray-500">
                                                {{ historyEdo.generatedAt|date('M d, Y') }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
