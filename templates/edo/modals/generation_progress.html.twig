{# eDO Generation Progress Modal #}
<div id="edoGenerationProgressModal" class="fixed inset-0 z-50 overflow-y-auto hidden" aria-labelledby="progress-modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay (non-dismissible during generation) -->
        <div class="fixed inset-0 transition-opacity bg-gray-900 bg-opacity-75" aria-hidden="true"></div>

        <!-- Modal panel -->
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg id="progressIcon" class="h-8 w-8 text-white animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 id="progress-modal-title" class="text-xl font-bold text-white">Generating eDOs</h3>
                            <p id="progressSubtitle" class="text-sm text-blue-100 mt-0.5">
                                <span id="documentTypeDisplay"></span>
                                <span id="documentNumberDisplay"></span>
                            </p>
                        </div>
                    </div>
                    <div id="statusBadge" class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-500 text-white">
                        In Progress
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="px-6 py-5">
                <!-- Progress Section (Visible during generation) -->
                <div id="progressSection">
                    <!-- Progress Counter -->
                    <div class="mb-4">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-gray-700">Progress</span>
                            <span id="progressText" class="text-sm font-bold text-blue-600">0 of 0 completed</span>
                        </div>
                        
                        <!-- Progress Bar -->
                        <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
                            <div id="progressBar" class="bg-gradient-to-r from-blue-500 to-blue-600 h-3 rounded-full transition-all duration-300 ease-out" style="width: 0%"></div>
                        </div>
                        
                        <!-- Percentage Display -->
                        <div class="flex items-center justify-between mt-2">
                            <span id="progressPercentage" class="text-xs text-gray-500">0%</span>
                            <span id="progressStats" class="text-xs text-gray-500">
                                <span class="text-green-600 font-medium" id="successCount">0 successful</span>
                                <span class="mx-1">•</span>
                                <span class="text-red-600 font-medium" id="failureCount">0 failed</span>
                            </span>
                        </div>
                    </div>

                    <!-- Current Container Display -->
                    <div class="mb-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-blue-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-xs text-blue-700 font-medium">Currently Processing:</p>
                                <p id="currentContainer" class="text-sm font-bold text-blue-900">Initializing...</p>
                            </div>
                        </div>
                    </div>

                    <!-- Cancel Button (Only visible during generation) -->
                    <div id="cancelSection" class="mb-4">
                        <button 
                            type="button" 
                            id="cancelGenerationBtn"
                            class="w-full inline-flex justify-center items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors"
                        >
                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            Cancel Generation
                        </button>
                    </div>
                </div>

                <!-- Completion Summary Section (Hidden by default) -->
                <div id="completionSection" class="hidden">
                    <!-- Success Summary -->
                    <div id="successSummary" class="hidden mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div class="ml-3 flex-1">
                                <h4 class="text-sm font-semibold text-green-900">Generation Complete!</h4>
                                <p class="text-sm text-green-700 mt-1">
                                    Successfully generated <span id="totalSuccessCount" class="font-bold">0</span> eDO(s)
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Partial Success Summary -->
                    <div id="partialSuccessSummary" class="hidden mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                            </div>
                            <div class="ml-3 flex-1">
                                <h4 class="text-sm font-semibold text-yellow-900">Generation Completed with Errors</h4>
                                <p class="text-sm text-yellow-700 mt-1">
                                    <span id="partialSuccessCount" class="font-bold">0</span> eDO(s) generated successfully,
                                    <span id="partialFailureCount" class="font-bold">0</span> failed
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Cancellation Summary -->
                    <div id="cancellationSummary" class="hidden mb-6 bg-gray-50 border border-gray-200 rounded-lg p-4">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div class="ml-3 flex-1">
                                <h4 class="text-sm font-semibold text-gray-900">Generation Cancelled</h4>
                                <p class="text-sm text-gray-700 mt-1">
                                    <span id="cancelledCompletedCount" class="font-bold">0</span> eDO(s) were generated before cancellation
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Failed Containers List -->
                    <div id="failedContainersSection" class="hidden mb-6">
                        <h4 class="text-sm font-semibold text-gray-900 mb-3">Failed Containers:</h4>
                        <div class="bg-red-50 border border-red-200 rounded-lg max-h-48 overflow-y-auto">
                            <ul id="failedContainersList" class="divide-y divide-red-100">
                                <!-- Failed containers will be inserted here -->
                            </ul>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex space-x-3">
                        <button 
                            type="button" 
                            id="viewEDOsBtn"
                            class="flex-1 inline-flex justify-center items-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
                        >
                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            View Generated eDOs
                        </button>
                        <button 
                            type="button" 
                            id="closeModalBtn"
                            class="flex-1 inline-flex justify-center items-center px-4 py-3 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
                        >
                            Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('edoGenerationProgressModal');
    const progressSection = document.getElementById('progressSection');
    const completionSection = document.getElementById('completionSection');
    const cancelSection = document.getElementById('cancelSection');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const viewEDOsBtn = document.getElementById('viewEDOsBtn');
    
    // Prevent modal close during generation
    modal.addEventListener('click', function(e) {
        // Only allow closing if completion section is visible
        if (e.target === modal && !completionSection.classList.contains('hidden')) {
            modal.classList.add('hidden');
        }
    });
    
    // Prevent escape key from closing modal during generation
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            // Only allow closing if completion section is visible
            if (!completionSection.classList.contains('hidden')) {
                modal.classList.add('hidden');
            }
        }
    });
    
    // Close button handler
    if (closeModalBtn) {
        closeModalBtn.addEventListener('click', function() {
            modal.classList.add('hidden');
            // Refresh the page to show updated document status
            window.location.reload();
        });
    }
    
    // View eDOs button handler (will be set by the controller)
    if (viewEDOsBtn) {
        viewEDOsBtn.addEventListener('click', function() {
            // This will be handled by the JavaScript controller
            // to navigate to the eDO list filtered by session
        });
    }
});

// Helper function to update progress display
function updateProgressDisplay(progressData) {
    const progressBar = document.getElementById('progressBar');
    const progressText = document.getElementById('progressText');
    const progressPercentage = document.getElementById('progressPercentage');
    const currentContainer = document.getElementById('currentContainer');
    const successCount = document.getElementById('successCount');
    const failureCount = document.getElementById('failureCount');
    const statusBadge = document.getElementById('statusBadge');
    const progressIcon = document.getElementById('progressIcon');
    const documentTypeDisplay = document.getElementById('documentTypeDisplay');
    const documentNumberDisplay = document.getElementById('documentNumberDisplay');
    
    // Update progress bar
    const percentage = progressData.percentage || 0;
    progressBar.style.width = percentage + '%';
    progressPercentage.textContent = percentage + '%';
    
    // Update progress text
    progressText.textContent = `${progressData.completed} of ${progressData.total} completed`;
    
    // Update current container
    if (progressData.current_container) {
        currentContainer.textContent = progressData.current_container;
    }
    
    // Update success/failure counts
    const successfulCount = progressData.completed - (progressData.failed || 0);
    successCount.textContent = `${successfulCount} successful`;
    failureCount.textContent = `${progressData.failed || 0} failed`;
    
    // Update document type and number display
    if (progressData.document_type && progressData.document_number) {
        const docTypeLabel = progressData.document_type.toUpperCase();
        documentTypeDisplay.textContent = `${docTypeLabel}: `;
        documentNumberDisplay.textContent = progressData.document_number;
    }
    
    // Update status badge
    if (progressData.status === 'completed') {
        statusBadge.textContent = 'Completed';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-green-500 text-white';
        progressIcon.classList.remove('animate-spin');
    } else if (progressData.status === 'cancelled') {
        statusBadge.textContent = 'Cancelled';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-gray-500 text-white';
        progressIcon.classList.remove('animate-spin');
    } else if (progressData.status === 'failed') {
        statusBadge.textContent = 'Failed';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-red-500 text-white';
        progressIcon.classList.remove('animate-spin');
    }
}

// Helper function to show completion summary
function showCompletionSummary(completionData) {
    const progressSection = document.getElementById('progressSection');
    const completionSection = document.getElementById('completionSection');
    const successSummary = document.getElementById('successSummary');
    const partialSuccessSummary = document.getElementById('partialSuccessSummary');
    const cancellationSummary = document.getElementById('cancellationSummary');
    const failedContainersSection = document.getElementById('failedContainersSection');
    const failedContainersList = document.getElementById('failedContainersList');
    
    // Hide progress section, show completion section
    progressSection.classList.add('hidden');
    completionSection.classList.remove('hidden');
    
    // Determine which summary to show
    if (completionData.status === 'cancelled') {
        cancellationSummary.classList.remove('hidden');
        document.getElementById('cancelledCompletedCount').textContent = completionData.completed;
    } else if (completionData.failed === 0) {
        successSummary.classList.remove('hidden');
        document.getElementById('totalSuccessCount').textContent = completionData.completed;
    } else {
        partialSuccessSummary.classList.remove('hidden');
        document.getElementById('partialSuccessCount').textContent = completionData.completed - completionData.failed;
        document.getElementById('partialFailureCount').textContent = completionData.failed;
    }
    
    // Show failed containers if any
    if (completionData.failures && completionData.failures.length > 0) {
        failedContainersSection.classList.remove('hidden');
        failedContainersList.innerHTML = '';
        
        completionData.failures.forEach(function(failure) {
            const li = document.createElement('li');
            li.className = 'px-4 py-3';
            li.innerHTML = `
                <div class="flex items-start">
                    <svg class="h-5 w-5 text-red-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <div class="flex-1">
                        <p class="text-sm font-medium text-red-900">${failure.container}</p>
                        <p class="text-xs text-red-700 mt-1">${failure.error}</p>
                    </div>
                </div>
            `;
            failedContainersList.appendChild(li);
        });
    }
}
</script>
