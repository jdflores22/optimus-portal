{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<!-- Hero Section -->
<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-indigo-50">
    <!-- Navigation Bar -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold text-blue-600">OPTIMUS</h1>
                    <span class="ml-3 text-sm text-gray-500">Shipping Lines Portal</span>
                </div>
                <div class="flex space-x-4">
                    <a href="{{ path('app_login') }}" class="btn-secondary">Sign In</a>
                    <a href="{{ path('consignee_register') }}" class="btn-primary">Get Started</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center">
            <h2 class="text-5xl font-extrabold text-gray-900 sm:text-6xl">
                Streamline Your
                <span class="text-blue-600">Shipping Operations</span>
            </h2>
            <p class="mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
                Complete digital platform for managing manifests, electronic delivery orders, 
                container tracking, and broker-consignee relationships.
            </p>
            <div class="mt-10 flex justify-center space-x-4">
                <a href="{{ path('consignee_register') }}" class="btn-primary text-lg px-8 py-3">
                    Start Free Trial
                </a>
                <a href="{{ path('app_features') }}" class="btn-secondary text-lg px-8 py-3">
                    View All Features
                </a>
            </div>
        </div>

        <!-- Stats Section -->
        <div class="mt-20 grid grid-cols-1 gap-8 sm:grid-cols-3">
            <div class="bg-white rounded-lg shadow-md p-6 text-center">
                <div class="text-4xl font-bold text-blue-600">100%</div>
                <div class="mt-2 text-gray-600">Digital Workflow</div>
            </div>
            <div class="bg-white rounded-lg shadow-md p-6 text-center">
                <div class="text-4xl font-bold text-green-600">24/7</div>
                <div class="mt-2 text-gray-600">System Availability</div>
            </div>
            <div class="bg-white rounded-lg shadow-md p-6 text-center">
                <div class="text-4xl font-bold text-purple-600">Real-time</div>
                <div class="mt-2 text-gray-600">Tracking & Updates</div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div id="features" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900">Powerful Features</h2>
            <p class="mt-4 text-xl text-gray-600">Everything you need to manage your shipping operations</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Feature 1: eDO Management -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-6 hover:shadow-lg transition">
                <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Electronic Delivery Orders</h3>
                <p class="text-gray-600">Container-level eDO management with automated expiration tracking and payment workflows.</p>
            </div>

            <!-- Feature 2: Manifest Management -->
            <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-lg p-6 hover:shadow-lg transition">
                <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Manifest Processing</h3>
                <p class="text-gray-600">Streamlined manifest creation with NOA integration and automated billing workflows.</p>
            </div>

            <!-- Feature 3: Broker Management -->
            <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg p-6 hover:shadow-lg transition">
                <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Broker-Consignee Relations</h3>
                <p class="text-gray-600">Manage broker relationships with referral codes, workspace switching, and transfer requests.</p>
            </div>

            <!-- Feature 4: Payment Processing -->
            <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-lg p-6 hover:shadow-lg transition">
                <div class="w-12 h-12 bg-yellow-600 rounded-lg flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Payment Management</h3>
                <p class="text-gray-600">Automated billing for expired eDOs with receipt validation and payment confirmation workflows.</p>
            </div>

            <!-- Feature 5: Container Tracking -->
            <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-lg p-6 hover:shadow-lg transition">
                <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Container Management</h3>
                <p class="text-gray-600">Track containers with TEU calculations, CY allocation, and comprehensive audit trails.</p>
            </div>

            <!-- Feature 6: User Management -->
            <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-lg p-6 hover:shadow-lg transition">
                <div class="w-12 h-12 bg-indigo-600 rounded-lg flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Role-Based Access Control</h3>
                <p class="text-gray-600">Secure multi-role system with suspension management, appeals, and activity logging.</p>
            </div>
        </div>
    </div>
</div>

<!-- User Roles Section -->
<div class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900">Built for Every Role</h2>
            <p class="mt-4 text-xl text-gray-600">Tailored dashboards and workflows for each user type</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition">
                <div class="w-16 h-16 bg-gray-600 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-white text-2xl font-bold">A</span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">System Admin</h3>
                <p class="mt-2 text-sm text-gray-600">Full system control and configuration</p>
            </div>

            <div class="bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition">
                <div class="w-16 h-16 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-white text-2xl font-bold">S</span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Shipping Line Staff</h3>
                <p class="mt-2 text-sm text-gray-600">Manage manifests and NOAs</p>
            </div>

            <div class="bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition">
                <div class="w-16 h-16 bg-orange-500 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-white text-2xl font-bold">B</span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Broker</h3>
                <p class="mt-2 text-sm text-gray-600">Process documents and payments</p>
            </div>

            <div class="bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition">
                <div class="w-16 h-16 bg-teal-500 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-white text-2xl font-bold">C</span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Consignee</h3>
                <p class="mt-2 text-sm text-gray-600">Track shipments and manage brokers</p>
            </div>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="py-20 bg-blue-600">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <h2 class="text-4xl font-bold text-white mb-6">
            Ready to Transform Your Shipping Operations?
        </h2>
        <p class="text-xl text-blue-100 mb-8">
            Join shipping lines worldwide using OPTIMUS to streamline their operations
        </p>
        <div class="flex justify-center space-x-4">
            <a href="{{ path('consignee_register') }}" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
                Get Started Now
            </a>
            <a href="{{ path('app_login') }}" class="bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-800 transition border-2 border-white">
                Sign In
            </a>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="bg-gray-900 text-gray-400 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <h3 class="text-white text-lg font-semibold mb-4">OPTIMUS</h3>
                <p class="text-sm">Modern shipping lines portal built with Symfony 8.0</p>
            </div>
            <div>
                <h3 class="text-white text-lg font-semibold mb-4">Technology</h3>
                <ul class="space-y-2 text-sm">
                    <li>✓ Symfony 8.0</li>
                    <li>✓ Doctrine ORM</li>
                    <li>✓ Tailwind CSS</li>
                    <li>✓ Real-time Notifications</li>
                </ul>
            </div>
            <div>
                <h3 class="text-white text-lg font-semibold mb-4">Support</h3>
                <p class="text-sm">24/7 system availability with comprehensive audit trails and activity logging</p>
            </div>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-800 text-center text-sm">
            <p>&copy; {{ "now"|date("Y") }} OPTIMUS Shipping Lines Portal. All rights reserved.</p>
        </div>
    </div>
</footer>
{% endblock %}
