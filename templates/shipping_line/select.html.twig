{% extends 'base.html.twig' %}

{% block title %}Select Shipping Line - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="py-6">
                <h1 class="text-3xl font-bold text-gray-900">Select Shipping Line</h1>
                <p class="mt-2 text-gray-600">Choose a shipping line to access your manifests and services</p>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {% if currentShippingLine %}
            <div class="mb-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-sm text-blue-800">
                        Currently viewing: <strong>{{ currentShippingLine.brandName }}</strong>
                    </span>
                </div>
            </div>
        {% endif %}

        <!-- Shipping Line Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for item in shippingLines %}
                {% set shippingLine = item.entity %}
                {% set canAccess = item.canAccess %}
                {% set status = item.status %}
                
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
                    <!-- Card Header with Logo -->
                    <div class="p-6 border-b border-gray-200">
                        <div class="flex items-center justify-between mb-4">
                            {% set logoUrl = shippingLine.logoPath ? asset('uploads/shipping-lines/' ~ shippingLine.logoPath) : (shippingLine.portalConfig.logoUrl ?? null) %}
                            {% if logoUrl %}
                                <img src="{{ logoUrl }}" 
                                     alt="{{ shippingLine.brandName }} logo" 
                                     class="h-16 w-auto object-contain">
                            {% else %}
                                <div class="h-16 w-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                                    <span class="text-2xl font-bold text-white">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                                </div>
                            {% endif %}
                            
                            <!-- Status Badge -->
                            {% if status == 'APPROVED' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                    </svg>
                                    Approved
                                </span>
                            {% elseif status == 'PENDING' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                                    </svg>
                                    Pending
                                </span>
                            {% elseif status == 'REJECTED' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                    Rejected
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                    Not Applied
                                </span>
                            {% endif %}
                        </div>
                        
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">{{ shippingLine.brandName }}</h3>
                        
                        {% set brandColor = shippingLine.brandColor ?? (shippingLine.portalConfig.primaryColor ?? null) %}
                        {% if brandColor %}
                            <div class="flex items-center text-sm text-gray-500">
                                <div class="w-4 h-4 rounded-full mr-2" style="background-color: {{ brandColor }}"></div>
                                <span>Brand Color</span>
                            </div>
                        {% endif %}
                    </div>
                    
                    <!-- Card Body -->
                    <div class="p-6">
                        {% if status == 'APPROVED' %}
                            <p class="text-sm text-gray-600 mb-4">
                                You have approved accreditation for this shipping line. Click below to access your manifests and services.
                            </p>
                            
                            {% if currentShippingLine and currentShippingLine.id == shippingLine.id %}
                                <button disabled 
                                        class="w-full px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
                                    Currently Selected
                                </button>
                            {% else %}
                                <form method="POST" action="{{ path('app_shipping_line_switch', {id: shippingLine.id}) }}">
                                    <button type="submit" 
                                            class="w-full px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                        Switch to {{ shippingLine.brandName }}
                                    </button>
                                </form>
                            {% endif %}
                        {% elseif status == 'PENDING' %}
                            <p class="text-sm text-gray-600 mb-4">
                                Your accreditation application is pending review. You'll be notified once it's approved.
                            </p>
                            <button disabled 
                                    class="w-full px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
                                Awaiting Approval
                            </button>
                        {% elseif status == 'REJECTED' %}
                            <p class="text-sm text-gray-600 mb-4">
                                Your accreditation application was rejected. Please contact support or reapply.
                            </p>
                            <a href="{{ path('accreditation_index') }}" 
                               class="block w-full text-center px-4 py-2 border border-blue-600 text-sm font-medium rounded-md text-blue-600 bg-white hover:bg-blue-50">
                                View Accreditations
                            </a>
                        {% else %}
                            <p class="text-sm text-gray-600 mb-4">
                                You haven't applied for accreditation with this shipping line yet. Apply now to access their services.
                            </p>
                            <a href="{{ path('accreditation_index') }}" 
                               class="block w-full text-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
                                View Accreditations
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Empty State -->
        {% if shippingLines|length == 0 %}
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No shipping lines available</h3>
                <p class="mt-1 text-sm text-gray-500">Please contact support if you need access to shipping line services.</p>
            </div>
        {% endif %}

        <!-- Help Section -->
        <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-blue-800">Need help?</h3>
                    <div class="mt-2 text-sm text-blue-700">
                        <p>
                            To access a shipping line's services, you need to have an approved accreditation. 
                            If you don't see a shipping line you need, please contact support.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
