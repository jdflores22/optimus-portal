                            <span class="flex items-center justify-center size-5 rounded-full bg-warning/20 text-warning text-sm font-semibold">{{ pendingEdoPaymentsCount }}</span>
                        {% endif %}
                    </a>
                </li>
                <div class="divider text-base-content/50 py-4 after:border-0">eDO Renewals</div>
                <li>
                    <a href="{{ path('accounting_renewal_requests_pending') }}" class="{{ currentRoute starts with 'accounting_renewal_requests' ? 'active' : '' }}">
