                        {% if detentionPaymentsCount is defined and detentionPaymentsCount > 0 %}
                            <span class="flex items-center justify-center size-5 rounded-full bg-warning/20 text-warning text-sm font-semibold">{{ detentionPaymentsCount }}</span>
