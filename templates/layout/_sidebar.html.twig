                <li><a href="{{ path('app_admin_approved_accreditations') }}" class="{{ currentRoute starts with 'app_admin_approved_accreditations' ? 'active' : '' }}"><span class="icon-[tabler--circle-check] size-5"></span>Accreditations</a></li>
                <li><a href="{{ path('app_admin_users') }}" class="{{ currentRoute starts with 'app_admin_users' ? 'active' : '' }}"><span class="icon-[tabler--users] size-5"></span>User Management</a></li>
                <li>
                    <a href="{{ path('admin_appeals_list') }}" class="{{ currentRoute starts with 'admin_appeals' ? 'active' : '' }}">
                        <span class="icon-[tabler--file-text] size-5"></span>Suspension Appeals
                        {% if pendingAppealsCount is defined and pendingAppealsCount > 0 %}
                            <span class="badge badge-soft badge-warning badge-sm ml-auto">{{ pendingAppealsCount }}</span>
                        {% endif %}
                    </a>
                </li>
                <li>
                    <a href="{{ path('admin_broker_transfer_requests') }}" class="{{ currentRoute starts with 'admin_broker_transfer' ? 'active' : '' }}">
                        <span class="icon-[tabler--arrows-exchange] size-5"></span>Transfer Requests
