                    {% elseif app.user.role.value == 'ACCOUNTING' %}
                        <!-- Accounting Menu -->
                        <a href="{{ path('payment_list') }}" onclick="toggleMobileSidebar()"
                           class="group flex items-center px-2 py-2 text-sm font-medium rounded-md {{ currentRoute starts with 'payment' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}">
                            <svg class="mr-3 flex-shrink-0 h-6 w-6 {{ currentRoute starts with 'payment' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                            </svg>
                            Payments
                        </a>
                        
                        <a href="{{ path('accounting_payment_dashboard') }}" onclick="toggleMobileSidebar()"
                           class="group flex items-center px-2 py-2 text-sm font-medium rounded-md {{ currentRoute starts with 'accounting_payment' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}">
                            <svg class="mr-3 flex-shrink-0 h-6 w-6 {{ currentRoute starts with 'accounting_payment' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Final Payment Validation
                        </a>
                    {% elseif app.user.role.value == 'TERMINAL_TEAM' %}
                        <!-- Terminal Team Menu -->
                        <a href="{{ path('app_terminal_team_pre_advice_requests', {status: 'pending'}) }}" onclick="toggleMobileSidebar()"
                           class="group flex items-center px-2 py-2 text-sm font-medium rounded-md {{ currentRoute starts with 'app_terminal_team_pre_advice' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}">
                            <svg class="mr-3 flex-shrink-0 h-6 w-6 {{ currentRoute starts with 'app_terminal_team_pre_advice' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                            </svg>
                            FREE-ADVICE
                            {% if pending_pre_advice_count > 0 %}
                                <span class="ml-auto inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    {{ pending_pre_advice_count > 99 ? '99+' : pending_pre_advice_count }}
                                </span>
                            {% endif %}
                        </a>
                        
                        <a href="{{ path('app_terminal_team_dwell_time_monitoring') }}" onclick="toggleMobileSidebar()"
                           class="group flex items-center px-2 py-2 text-sm font-medium rounded-md {{ currentRoute == 'app_terminal_team_dwell_time_monitoring' ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}">
                            <svg class="mr-3 flex-shrink-0 h-6 w-6 {{ currentRoute == 'app_terminal_team_dwell_time_monitoring' ? 'text-blue-500' : 'text-gray-400 group-hover:text-gray-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Dwell Time Monitoring
                        </a>
                    {% endif %}
                </nav>
            </div>
        </div>
    </div>
</div>

<script>
function toggleMobileSidebar() {
    const sidebar = document.getElementById('mobile-sidebar');
    if (sidebar.style.display === 'none') {
        sidebar.style.display = 'flex';
    } else {
        sidebar.style.display = 'none';
    }
}
</script>