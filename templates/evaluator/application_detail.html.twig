{% extends 'base.html.twig' %}

{% block title %}Application Review - OPTIMUS{% endblock %}

{% block body %}
<div class="w-full px-4 py-6 bg-base-200 min-h-screen">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs text-sm mb-4">
        <ul>
            <li><a href="{{ path('app_evaluator_dashboard') }}"><span class="icon-[tabler--home] size-4"></span>Dashboard</a></li>
            <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right]"></span></li>
            <li><a href="{{ path('app_evaluator_applications') }}"><span class="icon-[tabler--file-text] size-4"></span>Applications</a></li>
            <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right]"></span></li>
            <li aria-current="page">Application #{{ submission.id }}</li>
        </ul>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success mb-4">
            <span class="icon-[tabler--circle-check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error mb-4">
            <span class="icon-[tabler--circle-x] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <!-- Application Header -->
    <div class="card mb-6">
        <div class="card-body">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="card-title text-2xl">Application #{{ submission.id }}</h1>
                    <p class="text-sm opacity-60 mt-1">
                        Submitted on {{ submission.submittedAt|date('F d, Y \\a\\t g:i A') }}
                    </p>
                </div>
                {% if submission.status.value == 'PENDING' %}
                    <span class="badge badge-warning badge-lg">{{ submission.status.value }}</span>
                {% elseif submission.status.value == 'APPROVED' %}
                    <span class="badge badge-success badge-lg">{{ submission.status.value }}</span>
                {% elseif submission.status.value == 'DENIED' or submission.status.value == 'REJECTED' %}
                    <span class="badge badge-error badge-lg">{{ submission.status.value }}</span>
                {% else %}
                    <span class="badge badge-neutral badge-lg">{{ submission.status.value }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Applicant Information -->
    <div class="card mb-6">
        <div class="card-body">
            <h2 class="card-title mb-4">Applicant Information</h2>
            
            <!-- Skeleton Loader -->
            <div id="applicant-skeleton" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for i in 1..6 %}
                <div>
                    <div class="skeleton skeleton-animated h-4 w-32 mb-2"></div>
                    <div class="skeleton skeleton-animated h-5 w-full"></div>
                </div>
                {% endfor %}
            </div>
            
            <!-- Actual Content -->
            <div id="applicant-content" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div>
                    <label class="label"><span class="label-text font-medium">Email Address</span></label>
                    <p class="text-sm">{{ submission.applicant.email }}</p>
                </div>
                <div>
                    <label class="label"><span class="label-text font-medium">User Role</span></label>
                    <span class="badge badge-primary badge-soft">{{ submission.applicant.role.value }}</span>
                </div>
                {% if submission.applicant.role.value == 'BROKER' %}
                    <div>
                        <label class="label"><span class="label-text font-medium">Full Name</span></label>
                        <p class="text-sm">{{ submission.applicant.fullName }}</p>
                    </div>
                {% elseif submission.applicant.role.value == 'CONSIGNEE' %}
                    <div>
                        <label class="label"><span class="label-text font-medium">Business Name</span></label>
                        <p class="text-sm">{{ submission.applicant.businessName }}</p>
                    </div>
                {% endif %}
                {% if submission.applicant.role.value == 'CONSIGNEE' and submission.applicant.linkedBroker %}
                    <div>
                        <label class="label"><span class="label-text font-medium">Linked Broker</span></label>
                        <p class="text-sm">{{ submission.applicant.linkedBroker.fullName }}</p>
                    </div>
                {% endif %}
                <div>
                    <label class="label"><span class="label-text font-medium">Account Status</span></label>
                    {% if submission.applicant.status.value == 'APPROVED' %}
                        <span class="badge badge-success badge-soft">{{ submission.applicant.status.value }}</span>
                    {% elseif submission.applicant.status.value == 'PENDING' %}
                        <span class="badge badge-warning badge-soft">{{ submission.applicant.status.value }}</span>
                    {% else %}
                        <span class="badge badge-error badge-soft">{{ submission.applicant.status.value }}</span>
                    {% endif %}
                </div>
                <div>
                    <label class="label"><span class="label-text font-medium">Account Created</span></label>
                    <p class="text-sm">{{ submission.applicant.createdAt|date('M d, Y') }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Skeleton Loader -->
        <div id="content-skeleton" class="lg:col-span-3">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Left Column Skeleton -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Application Details Skeleton -->
                    <div class="card">
                        <div class="card-body">
                            <div class="skeleton skeleton-animated h-6 w-48 mb-4"></div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                {% for i in 1..6 %}
                                <div>
                                    <div class="skeleton skeleton-animated h-4 w-32 mb-2"></div>
                                    <div class="skeleton skeleton-animated h-10 w-full"></div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Documents Skeleton -->
                    <div class="card">
                        <div class="card-body">
                            <div class="skeleton skeleton-animated h-6 w-48 mb-4"></div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                {% for i in 1..4 %}
                                <div class="card bg-base-100 border border-base-300">
                                    <div class="card-body p-4">
                                        <div class="flex items-start gap-3">
                                            <div class="skeleton skeleton-animated w-10 h-10 rounded-full shrink-0"></div>
                                            <div class="flex-1 space-y-2">
                                                <div class="skeleton skeleton-animated h-4 w-full"></div>
                                                <div class="skeleton skeleton-animated h-3 w-24"></div>
                                                <div class="flex gap-2">
                                                    <div class="skeleton skeleton-animated h-6 w-16"></div>
                                                    <div class="skeleton skeleton-animated h-6 w-20"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Right Column Skeleton -->
                <div class="lg:col-span-1">
                    <div class="card">
                        <div class="card-body">
                            <div class="skeleton skeleton-animated h-6 w-48 mb-4"></div>
                            <div class="space-y-4">
                                <div>
                                    <div class="skeleton skeleton-animated h-4 w-24 mb-2"></div>
                                    <div class="skeleton skeleton-animated h-10 w-full"></div>
                                </div>
                                <div>
                                    <div class="skeleton skeleton-animated h-4 w-32 mb-2"></div>
                                    <div class="skeleton skeleton-animated h-24 w-full"></div>
                                </div>
                                <div class="skeleton skeleton-animated h-10 w-full"></div>
                                <div class="skeleton skeleton-animated h-10 w-full"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actual Content (hidden initially) -->
        <div id="content-actual" class="hidden lg:col-span-3">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column (2/3 width) -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Application Details -->
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title mb-4">Application Details</h2>
                    {% if submission.submittedData and submission.formConfig %}
                        {% set formFields = submission.formConfig.fields.fields %}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            {% for key, value in submission.submittedData %}
                                {% if key != '_files' and key != '_csrf_token' %}
                                    {% set fieldLabel = key|replace({'_': ' '})|title %}
                                    {% set fieldType = 'text' %}
                                    
                                    {# Find the proper label and type from form configuration #}
                                    {% for field in formFields %}
                                        {% if field.id == key %}
                                            {% set fieldLabel = field.label %}
                                            {% set fieldType = field.type %}
                                        {% endif %}
                                    {% endfor %}
                                    
                                    <div>
                                        <label class="label"><span class="label-text font-medium">{{ fieldLabel }}</span></label>
                                        
                                        {% if fieldType == 'checkbox' %}
                                            {% set fieldConfig = null %}
                                            {% for field in formFields %}
                                                {% if field.id == key %}
                                                    {% set fieldConfig = field %}
                                                {% endif %}
                                            {% endfor %}
                                            
                                            {% if fieldConfig and fieldConfig.validation is defined and fieldConfig.validation.options is defined %}
                                                {% if value is iterable and value is not same as(value|join('')) %}
                                                    <div class="flex flex-wrap gap-2">
                                                        {% for optionValue, optionLabel in fieldConfig.validation.options %}
                                                            {% if optionValue in value %}
                                                                <span class="badge badge-primary badge-soft">{{ optionLabel }}</span>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </div>
                                                {% else %}
                                                    <span class="text-sm opacity-50 italic">No options selected</span>
                                                {% endif %}
                                            {% else %}
                                                {% if value == '1' or value == 1 or value == true %}
                                                    <span class="badge badge-success badge-soft">
                                                        <span class="icon-[tabler--check] size-4"></span>
                                                        Accepted
                                                    </span>
                                                {% else %}
                                                    <span class="badge badge-error badge-soft">
                                                        <span class="icon-[tabler--x] size-4"></span>
                                                        Not Accepted
                                                    </span>
                                                {% endif %}
                                            {% endif %}
                                        {% elseif fieldType == 'checkbox_group' %}
                                            {% if value is iterable and value is not same as(value|join('')) %}
                                                <div class="flex flex-wrap gap-2">
                                                    {% for item in value %}
                                                        <span class="badge badge-primary badge-soft">{{ item }}</span>
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                <span class="text-sm opacity-50 italic">No options selected</span>
                                            {% endif %}
                                        {% elseif fieldType == 'select' and value is iterable and value is not same as(value|join('')) %}
                                            <div class="flex flex-wrap gap-2">
                                                {% for item in value %}
                                                    <span class="badge badge-secondary badge-soft">{{ item }}</span>
                                                {% endfor %}
                                            </div>
                                        {% elseif value is iterable and value is not same as(value|join('')) %}
                                            <div class="flex flex-wrap gap-2">
                                                {% for item in value %}
                                                    <span class="badge badge-neutral badge-soft">{{ item }}</span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="bg-base-200 rounded-lg p-3">
                                                <p class="text-sm">{{ value }}</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-sm opacity-60">No form data available</p>
                    {% endif %}
                </div>
            </div>

            <!-- Supporting Documents -->
            {% if submission.submittedData._files is defined and submission.submittedData._files|length > 0 %}
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title mb-4">Supporting Documents</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {% for fieldName, fileId in submission.submittedData._files %}
                            <div class="card bg-base-100 border border-base-300 hover:shadow-lg transition-shadow">
                                <div class="card-body p-4">
                                    <div class="flex items-start gap-3">
                                        <div class="avatar avatar-placeholder">
                                            <div class="bg-primary text-primary-content w-10 rounded-full">
                                                <span class="icon-[tabler--file] size-5"></span>
                                            </div>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-medium text-sm mb-1">
                                                {% set documentName = '' %}
                                                {% if fieldName == 'broker_license_document' %}
                                                    {% set documentName = 'Broker License Document' %}
                                                {% elseif fieldName == 'company_registration' %}
                                                    {% set documentName = 'Company Registration Certificate' %}
                                                {% elseif fieldName == 'representative_id' %}
                                                    {% set documentName = 'Representative ID Document' %}
                                                {% elseif fieldName == 'financial_guarantee' %}
                                                    {% set documentName = 'Financial Guarantee Document' %}
                                                {% elseif fieldName == 'professional_indemnity' %}
                                                    {% set documentName = 'Professional Indemnity Insurance' %}
                                                {% elseif fieldName == 'business_license' %}
                                                    {% set documentName = 'Business License Document' %}
                                                {% elseif fieldName == 'insurance_certificate' %}
                                                    {% set documentName = 'Insurance Certificate' %}
                                                {% else %}
                                                    {% set documentName = fieldName|title %}
                                                {% endif %}
                                                {{ documentName }}
                                            </p>
                                            <p class="text-xs opacity-60 mb-3">ID: {{ fileId }}</p>
                                            <div class="flex gap-2">
                                                <button type="button" data-file-id="{{ fileId }}" data-document-name="{{ documentName }}" 
                                                        class="view-document-btn btn btn-primary btn-xs">
                                                    <span class="icon-[tabler--eye] size-3"></span>
                                                    View
                                                </button>
                                                <a href="{{ path('accreditation_file_download', {fileId: fileId}) }}" 
                                                   class="btn btn-neutral btn-xs">
                                                    <span class="icon-[tabler--download] size-3"></span>
                                                    Download
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Right Column (1/3 width) - Evaluation Form or Status -->
        <div class="lg:col-span-1">
            {% if submission.status.value == 'PENDING' %}
                <!-- Evaluation Form -->
                <div class="card sticky top-6">
                    <div class="card-body">
                        <h2 class="card-title mb-4">Evaluate Application</h2>
                        <form method="POST" action="{{ path('app_evaluator_evaluate', {id: submission.id}) }}" id="evaluationForm">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('evaluate_application') }}">
                            
                            <div class="mb-4">
                                <label for="status" class="label">
                                    <span class="label-text">Decision <span class="text-error">*</span></span>
                                </label>
                                <select id="status" name="status" required class="select select-bordered w-full">
                                    <option value="">Select a decision...</option>
                                    <option value="APPROVED">Approve - Forward to Admin</option>
                                    <option value="DENIED">Deny - Reject application</option>
                                    <option value="REJECTED">Reject - Invalid submission</option>
                                    <option value="COMPLIANCE_REQUIRED">Compliance Required - Request additional info</option>
                                </select>
                            </div>

                            <div class="mb-6">
                                <label for="reason" class="label">
                                    <span class="label-text">Reason / Comments</span>
                                </label>
                                <textarea id="reason" name="reason" rows="4" class="textarea textarea-bordered w-full"
                                          placeholder="Provide reason for denial or additional comments..."></textarea>
                                <label class="label">
                                    <span class="label-text-alt">Required for denials and rejections</span>
                                </label>
                            </div>

                            <div class="space-y-2">
                                <button type="submit" id="submitBtn" class="btn btn-primary w-full">
                                    <span id="submitText">Submit Evaluation</span>
                                    <span id="loadingText" class="hidden">Processing...</span>
                                </button>
                                <a href="{{ path('app_evaluator_dashboard') }}" class="btn btn-neutral w-full">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            {% else %}
                <!-- Evaluation Status -->
                <div class="card sticky top-6">
                    <div class="card-body">
                        <h2 class="card-title mb-4">Evaluation Status</h2>
                        <div class="alert {% if submission.status.value == 'APPROVED' %}alert-success{% elseif submission.status.value == 'DENIED' or submission.status.value == 'REJECTED' %}alert-error{% else %}alert-warning{% endif %}">
                            {% if submission.status.value == 'APPROVED' %}
                                <span class="icon-[tabler--circle-check] size-6"></span>
                                <div>
                                    <p class="font-medium">Application Approved</p>
                                    <p class="text-sm">Forwarded to admin for final approval</p>
                                </div>
                            {% elseif submission.status.value == 'DENIED' %}
                                <span class="icon-[tabler--circle-x] size-6"></span>
                                <div>
                                    <p class="font-medium">Application Denied</p>
                                    <p class="text-sm">Application has been rejected</p>
                                </div>
                            {% elseif submission.status.value == 'REJECTED' %}
                                <span class="icon-[tabler--alert-triangle] size-6"></span>
                                <div>
                                    <p class="font-medium">Application Rejected</p>
                                    <p class="text-sm">Invalid submission</p>
                                </div>
                            {% elseif submission.status.value == 'COMPLIANCE_REQUIRED' %}
                                <span class="icon-[tabler--alert-circle] size-6"></span>
                                <div>
                                    <p class="font-medium">Compliance Required</p>
                                    <p class="text-sm">Additional information requested</p>
                                </div>
                            {% endif %}
                        </div>
                        
                        {% if submission.evaluatedAt %}
                            <div class="mt-4 pt-4 border-t border-base-300">
                                <div class="flex items-center gap-3">
                                    <div class="avatar avatar-placeholder">
                                        <div class="bg-secondary text-secondary-content w-10 rounded-full">
                                            <span class="text-sm font-bold">{{ submission.evaluator.email|slice(0, 2)|upper }}</span>
                                        </div>
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-medium text-sm">Evaluated by {{ submission.evaluator.email }}</p>
                                        <p class="text-xs opacity-60">{{ submission.evaluatedAt|date('F d, Y \\a\\t g:i A') }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        
                        {% if submission.denialReason %}
                            <div class="mt-4 p-3 bg-base-200 rounded-lg">
                                <p class="font-medium text-sm mb-1">Evaluation Comments:</p>
                                <p class="text-sm">{{ submission.denialReason }}</p>
                            </div>
                        {% endif %}
                        
                        <div class="mt-6">
                            <a href="{{ path('app_evaluator_dashboard') }}" class="btn btn-neutral w-full">
                                <span class="icon-[tabler--arrow-left] size-4"></span>
                                Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
            </div>
        </div>
    </div>

    <!-- Document Modal -->
    <div id="documentModal" class="overlay modal overlay-open:opacity-100 overlay-open:duration-300 modal-middle hidden" role="dialog" tabindex="-1">
        <div class="modal-dialog max-w-5xl">
            <div class="modal-content">
                <!-- Header -->
                <div class="modal-header">
                    <h3 class="modal-title text-xl font-bold" id="modalTitle">Document Viewer</h3>
                    <button type="button" class="btn btn-text btn-circle btn-sm absolute end-3 top-3" aria-label="Close" id="closeModalBtn">
                        <span class="icon-[tabler--x] size-4"></span>
                    </button>
                </div>
                
                <!-- Body -->
                <div class="modal-body">
                    <div id="documentContent" class="flex items-center justify-center min-h-[500px] bg-base-200 rounded-lg">
                        <div class="text-center">
                            <span class="loading loading-spinner loading-lg text-primary"></span>
                            <p class="mt-4 text-base-content/70">Loading document...</p>
                        </div>
                    </div>
                </div>
                
                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" id="closeModalBtn2">Close</button>
                    <a id="downloadLink" href="#" target="_blank" class="btn btn-primary">
                        <span class="icon-[tabler--download] size-4"></span>
                        Download
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
    // Document modal functions
    function viewDocument(fileId, documentName) {
        console.log('viewDocument called:', fileId, documentName);
        const modal = document.getElementById('documentModal');
        const modalTitle = document.getElementById('modalTitle');
        const documentContent = document.getElementById('documentContent');
        const downloadLink = document.getElementById('downloadLink');
        
        if (!modal) {
            console.error('Modal element not found');
            return;
        }
        
        console.log('Setting modal content...');
        modalTitle.textContent = documentName;
        downloadLink.href = `/accreditation/file/${fileId}`;
        
        // Reset content to loading state
        documentContent.innerHTML = `
            <div class="text-center">
                <span class="loading loading-spinner loading-lg text-primary"></span>
                <p class="mt-4 text-base-content/70">Loading document...</p>
            </div>
        `;
        
        // Show modal using FlyonUI overlay system
        modal.classList.remove('hidden');
        modal.classList.add('overlay-open');
        document.body.style.overflow = 'hidden';
        console.log('Modal opened - classes:', modal.className);
        
        // Load document
        fetch(`/accreditation/file/${fileId}`)
            .then(response => {
                if (!response.ok) throw new Error('Document not found');
                return response.blob();
            })
            .then(blob => {
                const url = URL.createObjectURL(blob);
                const contentType = blob.type;
                
                console.log('Document loaded:', contentType);
                
                if (contentType.startsWith('image/')) {
                    createImageElement(url, documentName);
                } else if (contentType === 'application/pdf' || contentType.includes('pdf') || documentName.toLowerCase().endsWith('.pdf')) {
                    createPdfElement(url);
                } else if (documentName.toLowerCase().match(/\.(jpg|jpeg|png|gif|bmp|webp)$/i)) {
                    createImageElement(url, documentName);
                } else {
                    showUnsupportedFormat();
                }
            })
            .catch(error => {
                console.error('Error loading document:', error);
                showDocumentError(error.message);
            });
    }
    
    function closeModal() {
        const modal = document.getElementById('documentModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('overlay-open');
            document.body.style.overflow = '';
            console.log('Modal closed');
        }
    }
    
    function showDocumentError(message) {
        const documentContent = document.getElementById('documentContent');
        documentContent.innerHTML = `
            <div class="text-center py-8">
                <span class="icon-[tabler--alert-circle] size-16 text-error"></span>
                <p class="text-error mt-4">Error loading document</p>
                <p class="text-sm opacity-60 mt-2">${message}</p>
            </div>
        `;
    }
    
    function showUnsupportedFormat() {
        const documentContent = document.getElementById('documentContent');
        documentContent.innerHTML = `
            <div class="text-center py-8">
                <span class="icon-[tabler--file] size-16 opacity-40"></span>
                <p class="mt-4">Preview not available for this file type</p>
                <p class="text-sm opacity-60 mt-2">Click download to view the document</p>
            </div>
        `;
    }
    
    function createImageElement(url, documentName) {
        const documentContent = document.getElementById('documentContent');
        documentContent.innerHTML = '';
        
        const container = document.createElement('div');
        container.className = 'w-full h-full flex items-center justify-center p-4';
        
        const img = document.createElement('img');
        img.src = url;
        img.alt = documentName;
        img.className = 'max-w-full max-h-[600px] object-contain rounded-lg shadow-lg';
        
        img.onload = function() {
            container.appendChild(img);
            documentContent.appendChild(container);
        };
        
        img.onerror = function() {
            showDocumentError('Failed to load image');
        };
    }
    
    function createPdfElement(url) {
        const documentContent = document.getElementById('documentContent');
        documentContent.innerHTML = '';
        
        const iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.className = 'w-full rounded-lg border-0';
        iframe.style.height = '600px';
        iframe.style.minHeight = '600px';
        
        documentContent.appendChild(iframe);
        
        iframe.onerror = function() {
            showDocumentError('Failed to load PDF');
        };
    }
    
    // Show skeleton on page load, hide when content is ready
    document.addEventListener('DOMContentLoaded', function() {
        const skeleton = document.getElementById('content-skeleton');
        const content = document.getElementById('content-actual');
        const applicantSkeleton = document.getElementById('applicant-skeleton');
        const applicantContent = document.getElementById('applicant-content');
        
        // Hide skeleton and show content after a brief delay
        setTimeout(function() {
            if (skeleton) skeleton.classList.add('hidden');
            if (content) content.classList.remove('hidden');
            if (applicantSkeleton) applicantSkeleton.classList.add('hidden');
            if (applicantContent) applicantContent.classList.remove('hidden');
        }, 300);
        
        console.log('DOM loaded, initializing event listeners...');
        
        const viewButtons = document.querySelectorAll('.view-document-btn');
        console.log('Found view buttons:', viewButtons.length);
        
        viewButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const fileId = this.getAttribute('data-file-id');
                const documentName = this.getAttribute('data-document-name');
                console.log('View button clicked:', fileId, documentName);
                viewDocument(fileId, documentName);
            });
        });
        
        // Handle modal close buttons
        const closeBtn1 = document.getElementById('closeModalBtn');
        const closeBtn2 = document.getElementById('closeModalBtn2');
        
        if (closeBtn1) {
            closeBtn1.addEventListener('click', closeModal);
        }
        if (closeBtn2) {
            closeBtn2.addEventListener('click', closeModal);
        }
        
        // Close modal when clicking outside (on the overlay)
        const modal = document.getElementById('documentModal');
        if (modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    closeModal();
                }
            });
        }
        
        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('documentModal');
                if (modal && !modal.classList.contains('hidden')) {
                    closeModal();
                }
            }
        });
        
        const evaluationForm = document.getElementById('evaluationForm');
        if (evaluationForm) {
            evaluationForm.addEventListener('submit', function(e) {
                const status = document.getElementById('status').value;
                const reason = document.getElementById('reason').value.trim();
                const submitBtn = document.getElementById('submitBtn');
                const submitText = document.getElementById('submitText');
                const loadingText = document.getElementById('loadingText');
                
                if ((status === 'DENIED' || status === 'REJECTED') && !reason) {
                    e.preventDefault();
                    alert('Please provide a reason for denial or rejection.');
                    return false;
                }
                
                submitBtn.disabled = true;
                submitText.classList.add('hidden');
                loadingText.classList.remove('hidden');
                
                setTimeout(function() {
                    submitBtn.disabled = false;
                    submitText.classList.remove('hidden');
                    loadingText.classList.add('hidden');
                }, 10000);
            });
        }
    });
    </script>
</div>
{% endblock %}
