{% extends 'base.html.twig' %}

{% block title %}Application Review - OPTIMUS{% endblock %}
{% block page_title %}Application Review{% endblock %}

{% block body %}
<div class="space-y-5 sm:space-y-6 max-w-6xl mx-auto">

    {# Header #}
    <div class="bg-base-100 shadow-sm rounded-xl">
        <div class="p-4 sm:p-6">
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-2">
                        <ul>
                            <li><a href="{{ path('app_evaluator_dashboard') }}">Dashboard</a></li>
                            <li><a href="{{ path('app_evaluator_applications') }}">Applications</a></li>
                            <li>Application #{{ submission.id }}</li>
                        </ul>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="size-12 rounded-xl bg-warning/10 flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--file-description] size-6 text-warning"></span>
                        </div>
                        <div class="min-w-0">
                            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Application #{{ submission.id }}</h1>
                            <p class="text-sm text-base-content/60 mt-1">
                                Submitted {{ submission.submittedAt|date('F d, Y \\a\\t g:i A') }}
                                {% if submission.shippingLine %}
                                    · {{ submission.shippingLine.brandName }}
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                    {% set statusBadge = 'badge-ghost' %}
                    {% if submission.status.value == 'APPROVED' %}
                        {% set statusBadge = 'badge-success' %}
                    {% elseif submission.status.value in ['DENIED', 'REJECTED'] %}
                        {% set statusBadge = 'badge-error' %}
                    {% elseif submission.status.value == 'PENDING' %}
                        {% set statusBadge = 'badge-warning' %}
                    {% elseif submission.status.value == 'COMPLIANCE_REQUIRED' %}
                        {% set statusBadge = 'badge-info' %}
                    {% endif %}
                    <span class="badge {{ statusBadge }} badge-lg">{{ submission.status.value|replace({'_': ' '})|title }}</span>
                    <a href="{{ path('app_evaluator_dashboard') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm">
            <span class="icon-[tabler--circle-check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error shadow-sm">
            <span class="icon-[tabler--alert-circle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-5 sm:gap-6">
        <div class="xl:col-span-2 space-y-5 sm:space-y-6">

            {# Applicant information #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="font-semibold text-lg text-base-content flex items-center gap-2 mb-4">
                        <span class="icon-[tabler--user] size-5 text-base-content/70"></span>
                        Applicant Information
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs font-medium text-base-content/60 mb-1">Email Address</p>
                            <p class="text-sm">{{ submission.applicant.email }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-base-content/60 mb-1">User Role</p>
                            <span class="badge badge-primary badge-soft">{{ submission.applicant.role.value|replace({'_': ' '})|title }}</span>
                        </div>
                        {% if submission.applicant.role.value == 'BROKER' %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Full Name</p>
                                <p class="text-sm">{{ submission.applicant.fullName }}</p>
                            </div>
                        {% elseif submission.applicant.role.value == 'CONSIGNEE' %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Business Name</p>
                                <p class="text-sm">{{ submission.applicant.businessName }}</p>
                            </div>
                        {% endif %}
                        {% if submission.applicant.role.value == 'CONSIGNEE' and submission.applicant.linkedBroker %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Linked Broker</p>
                                <p class="text-sm">{{ submission.applicant.linkedBroker.fullName }}</p>
                            </div>
                        {% endif %}
                        {% if submission.shippingLine %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Shipping Line</p>
                                <p class="text-sm">{{ submission.shippingLine.brandName }}</p>
                            </div>
                        {% endif %}
                        <div>
                            <p class="text-xs font-medium text-base-content/60 mb-1">Account Status</p>
                            {% set acctBadge = submission.applicant.status.value == 'APPROVED' ? 'badge-success' : (submission.applicant.status.value == 'PENDING' ? 'badge-warning' : 'badge-error') %}
                            <span class="badge {{ acctBadge }} badge-soft">{{ submission.applicant.status.value|title }}</span>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-base-content/60 mb-1">Account Created</p>
                            <p class="text-sm">{{ submission.applicant.createdAt|date('M d, Y') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# Application details #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="font-semibold text-lg text-base-content flex items-center gap-2 mb-4">
                        <span class="icon-[tabler--clipboard-list] size-5 text-base-content/70"></span>
                        Application Details
                    </h2>
                    {% if submission.submittedData and submission.formConfig %}
                        {% set formFields = submission.formConfig.fields.fields|default([]) %}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {% for key, value in submission.submittedData %}
                                {% if key != '_files' and key != '_csrf_token' %}
                                    {% set fieldLabel = key|replace({'_': ' '})|title %}
                                    {% set fieldType = 'text' %}
                                    {% for field in formFields %}
                                        {% if field.id == key %}
                                            {% set fieldLabel = field.label %}
                                            {% set fieldType = field.type %}
                                        {% endif %}
                                    {% endfor %}
                                    <div>
                                        <p class="text-xs font-medium text-base-content/60 mb-1">{{ fieldLabel }}</p>
                                        {% if fieldType == 'checkbox' %}
                                            {% if value == '1' or value == 1 or value == true %}
                                                <span class="badge badge-success badge-soft gap-1">
                                                    <span class="icon-[tabler--check] size-3.5"></span>
                                                    Accepted
                                                </span>
                                            {% else %}
                                                <span class="badge badge-error badge-soft gap-1">
                                                    <span class="icon-[tabler--x] size-3.5"></span>
                                                    Not Accepted
                                                </span>
                                            {% endif %}
                                        {% elseif value is iterable and value is not same as(value|join('')) %}
                                            <div class="flex flex-wrap gap-1.5">
                                                {% for item in value %}
                                                    <span class="badge badge-ghost badge-sm">{{ item }}</span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="bg-base-200/50 rounded-lg p-3">
                                                <p class="text-sm">{{ value }}</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-sm text-base-content/50">No form data available</p>
                    {% endif %}
                </div>
            </div>

            {# Supporting documents #}
            {% if submission.submittedData._files is defined and submission.submittedData._files|length > 0 %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-6">
                        <h2 class="font-semibold text-lg text-base-content flex items-center gap-2 mb-4">
                            <span class="icon-[tabler--files] size-5 text-base-content/70"></span>
                            Supporting Documents
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {% for fieldName, fileId in submission.submittedData._files %}
                                {% set documentName = fieldName|replace({'_': ' '})|title %}
                                {% if fieldName == 'broker_license_document' %}
                                    {% set documentName = 'Broker License Document' %}
                                {% elseif fieldName == 'company_registration' %}
                                    {% set documentName = 'Company Registration Certificate' %}
                                {% elseif fieldName == 'representative_id' %}
                                    {% set documentName = 'Representative ID Document' %}
                                {% elseif fieldName == 'financial_guarantee' %}
                                    {% set documentName = 'Financial Guarantee Document' %}
                                {% elseif fieldName == 'professional_indemnity' %}
                                    {% set documentName = 'Professional Indemnity Insurance' %}
                                {% elseif fieldName == 'business_license' %}
                                    {% set documentName = 'Business License Document' %}
                                {% elseif fieldName == 'insurance_certificate' %}
                                    {% set documentName = 'Insurance Certificate' %}
                                {% endif %}

                                <div class="rounded-xl bg-base-200/50 p-4 hover:bg-base-200 transition-colors">
                                    <div class="flex items-start gap-3">
                                        <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                                            <span class="icon-[tabler--file-text] size-5 text-primary"></span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-base-content">{{ documentName }}</p>
                                            <p class="text-xs text-base-content/50 mt-1 truncate">Ref: {{ fileId }}</p>
                                            <div class="flex flex-wrap gap-2 mt-3">
                                                <button type="button"
                                                        class="view-document-btn btn btn-primary btn-xs gap-1"
                                                        data-file-id="{{ fileId }}"
                                                        data-document-name="{{ documentName }}">
                                                    <span class="icon-[tabler--eye] size-3.5"></span>
                                                    View
                                                </button>
                                                <a href="{{ path('accreditation_file_download', {fileId: fileId}) }}"
                                                   class="btn btn-ghost btn-xs gap-1"
                                                   target="_blank"
                                                   rel="noopener">
                                                    <span class="icon-[tabler--download] size-3.5"></span>
                                                    Download
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# Evaluation sidebar #}
        <div class="xl:col-span-1">
            {% if submission.status.value == 'PENDING' %}
                <div class="card bg-base-100 shadow-sm xl:sticky xl:top-24">
                    <div class="card-body p-4 sm:p-6">
                        <h2 class="font-semibold text-lg text-base-content flex items-center gap-2 mb-4">
                            <span class="icon-[tabler--gavel] size-5 text-warning"></span>
                            Evaluate Application
                        </h2>
                        <form method="POST" action="{{ path('app_evaluator_evaluate', {id: submission.id}) }}" id="evaluationForm" class="space-y-4">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('evaluate_application') }}">

                            <div class="form-control">
                                <label for="status" class="label py-1">
                                    <span class="label-text font-medium">Decision <span class="text-error">*</span></span>
                                </label>
                                <select id="status" name="status" required class="select w-full bg-base-200/50 border-0 focus:outline-none focus:ring-2 focus:ring-primary/30 rounded-lg">
                                    <option value="">Select a decision...</option>
                                    <option value="APPROVED">Approve — Forward to Admin</option>
                                    <option value="DENIED">Deny — Reject application</option>
                                    <option value="REJECTED">Reject — Invalid submission</option>
                                    <option value="COMPLIANCE_REQUIRED">Compliance Required — Request info</option>
                                </select>
                            </div>

                            <div class="form-control">
                                <label for="reason" class="label py-1">
                                    <span class="label-text font-medium">Reason / Comments</span>
                                </label>
                                <textarea id="reason" name="reason" rows="4" class="textarea w-full bg-base-200/50 border-0 focus:outline-none focus:ring-2 focus:ring-primary/30 rounded-lg"
                                          placeholder="Required for denials and rejections..."></textarea>
                                <label class="label py-1">
                                    <span class="label-text-alt text-base-content/50">Required for denials and rejections</span>
                                </label>
                            </div>

                            <div class="space-y-2 pt-2">
                                <button type="submit" id="submitBtn" class="btn btn-primary w-full gap-2">
                                    <span id="submitText">Submit Evaluation</span>
                                    <span id="loadingText" class="hidden loading loading-spinner loading-sm"></span>
                                </button>
                                <a href="{{ path('app_evaluator_dashboard') }}" class="btn btn-ghost w-full">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            {% else %}
                <div class="card bg-base-100 shadow-sm xl:sticky xl:top-24">
                    <div class="card-body p-4 sm:p-6 space-y-4">
                        <h2 class="font-semibold text-lg text-base-content flex items-center gap-2">
                            <span class="icon-[tabler--info-circle] size-5"></span>
                            Evaluation Status
                        </h2>

                        <div class="alert {% if submission.status.value == 'APPROVED' %}alert-success{% elseif submission.status.value in ['DENIED', 'REJECTED'] %}alert-error{% else %}alert-warning{% endif %}">
                            {% if submission.status.value == 'APPROVED' %}
                                <span class="icon-[tabler--circle-check] size-5"></span>
                                <div>
                                    <p class="font-medium">Application Approved</p>
                                    <p class="text-sm opacity-80">Forwarded to admin for final approval</p>
                                </div>
                            {% elseif submission.status.value == 'DENIED' %}
                                <span class="icon-[tabler--circle-x] size-5"></span>
                                <div>
                                    <p class="font-medium">Application Denied</p>
                                    <p class="text-sm opacity-80">Application has been rejected</p>
                                </div>
                            {% elseif submission.status.value == 'REJECTED' %}
                                <span class="icon-[tabler--alert-triangle] size-5"></span>
                                <div>
                                    <p class="font-medium">Application Rejected</p>
                                    <p class="text-sm opacity-80">Invalid submission</p>
                                </div>
                            {% elseif submission.status.value == 'COMPLIANCE_REQUIRED' %}
                                <span class="icon-[tabler--alert-circle] size-5"></span>
                                <div>
                                    <p class="font-medium">Compliance Required</p>
                                    <p class="text-sm opacity-80">Additional information requested</p>
                                </div>
                            {% endif %}
                        </div>

                        {% if submission.evaluator and submission.evaluatedAt %}
                            <div class="flex items-center gap-3 pt-2">
                                <div class="avatar avatar-placeholder">
                                    <div class="bg-secondary text-secondary-content size-10 rounded-full">
                                        <span class="text-xs font-bold">{{ submission.evaluator.email|slice(0, 2)|upper }}</span>
                                    </div>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-sm font-medium truncate">{{ submission.evaluator.email }}</p>
                                    <p class="text-xs text-base-content/60">{{ submission.evaluatedAt|date('M j, Y g:i A') }}</p>
                                </div>
                            </div>
                        {% endif %}

                        {% if submission.denialReason %}
                            <div class="bg-base-200/50 rounded-lg p-3">
                                <p class="text-xs font-medium text-base-content/60 mb-1">Comments</p>
                                <p class="text-sm">{{ submission.denialReason }}</p>
                            </div>
                        {% endif %}

                        <a href="{{ path('app_evaluator_dashboard') }}" class="btn btn-ghost btn-sm w-full gap-2">
                            <span class="icon-[tabler--arrow-left] size-4"></span>
                            Back to Dashboard
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<div id="evaluatorDocumentModal"
     class="hidden fixed inset-0 z-[999999] items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="evaluatorDocumentModalTitle">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-eval-doc-dismiss></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-5xl max-h-[90vh] flex flex-col z-10" onclick="event.stopPropagation()">
        <div class="flex items-center justify-between px-5 py-4 shrink-0">
            <h3 id="evaluatorDocumentModalTitle" class="font-semibold text-base text-base-content flex items-center gap-2">
                <span class="icon-[tabler--file-text] size-5"></span>
                Document Viewer
            </h3>
            <button type="button" data-eval-doc-dismiss class="btn btn-ghost btn-sm btn-circle" aria-label="Close">
                <span class="icon-[tabler--x] size-4"></span>
            </button>
        </div>
        <div class="flex-1 p-5 overflow-auto min-h-0">
            <div id="evaluatorDocumentContent" class="flex items-center justify-center min-h-[400px] bg-base-200/50 rounded-xl">
                <div class="text-center">
                    <span class="loading loading-spinner loading-lg text-primary"></span>
                    <p class="mt-3 text-sm text-base-content/60">Loading document...</p>
                </div>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 px-5 py-4 shrink-0">
            <a id="evaluatorDocumentDownloadLink" href="#" target="_blank" rel="noopener" class="btn btn-primary btn-sm gap-2">
                <span class="icon-[tabler--download] size-4"></span>
                Download
            </a>
            <button type="button" data-eval-doc-dismiss class="btn btn-ghost btn-sm">Close</button>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    const modal = document.getElementById('evaluatorDocumentModal');
    const modalTitle = document.getElementById('evaluatorDocumentModalTitle');
    const documentContent = document.getElementById('evaluatorDocumentContent');
    const downloadLink = document.getElementById('evaluatorDocumentDownloadLink');
    const fileUrlTemplate = '{{ path('accreditation_file_download', {fileId: '__FILE_ID__'}) }}';

    function getFileUrl(fileId) {
        return fileUrlTemplate.replace('__FILE_ID__', encodeURIComponent(fileId));
    }

    function openModal() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';

        const iframe = documentContent.querySelector('iframe');
        const img = documentContent.querySelector('img');
        if (iframe && iframe.src.startsWith('blob:')) URL.revokeObjectURL(iframe.src);
        if (img && img.src.startsWith('blob:')) URL.revokeObjectURL(img.src);

        documentContent.innerHTML = `
            <div class="text-center">
                <span class="loading loading-spinner loading-lg text-primary"></span>
                <p class="mt-3 text-sm text-base-content/60">Loading document...</p>
            </div>`;
    }

    function showDocumentError(message, fileUrl, documentName) {
        documentContent.innerHTML = `
            <div class="text-center py-8 px-4">
                <span class="icon-[tabler--alert-circle] size-12 text-error block mx-auto mb-3"></span>
                <p class="font-medium text-error">Unable to load document</p>
                <p class="text-sm text-base-content/60 mt-2">${message}</p>
                <a href="${fileUrl}" target="_blank" rel="noopener" class="btn btn-primary btn-sm gap-2 mt-4">
                    <span class="icon-[tabler--download] size-4"></span>
                    Download ${documentName}
                </a>
            </div>`;
    }

    function showUnsupportedFormat(fileUrl, documentName) {
        documentContent.innerHTML = `
            <div class="text-center py-8 px-4">
                <span class="icon-[tabler--file-off] size-12 text-base-content/30 block mx-auto mb-3"></span>
                <p class="font-medium">Preview not available</p>
                <p class="text-sm text-base-content/60 mt-2">This file type cannot be previewed in the browser.</p>
                <a href="${fileUrl}" target="_blank" rel="noopener" class="btn btn-primary btn-sm gap-2 mt-4">
                    <span class="icon-[tabler--download] size-4"></span>
                    Download ${documentName}
                </a>
            </div>`;
    }

    function renderImage(url, documentName) {
        documentContent.innerHTML = `
            <div class="w-full flex items-center justify-center p-4">
                <img src="${url}" alt="${documentName}" class="max-w-full max-h-[70vh] object-contain rounded-lg shadow-lg">
            </div>`;
    }

    function renderPdf(url) {
        documentContent.innerHTML = `
            <iframe src="${url}" class="w-full rounded-lg border-0" style="height:70vh;min-height:400px" title="Document preview"></iframe>`;
    }

    function viewDocument(fileId, documentName) {
        const fileUrl = getFileUrl(fileId);
        modalTitle.innerHTML = `<span class="icon-[tabler--file-text] size-5"></span> ${documentName}`;
        downloadLink.href = fileUrl;
        openModal();

        documentContent.innerHTML = `
            <div class="text-center">
                <span class="loading loading-spinner loading-lg text-primary"></span>
                <p class="mt-3 text-sm text-base-content/60">Loading document...</p>
            </div>`;

        fetch(fileUrl, { credentials: 'same-origin' })
            .then(function (response) {
                if (!response.ok) throw new Error('Document not found or access denied');
                return response.blob();
            })
            .then(function (blob) {
                const url = URL.createObjectURL(blob);
                const contentType = blob.type || '';
                const lowerName = documentName.toLowerCase();

                if (contentType.startsWith('image/') || lowerName.match(/\.(jpg|jpeg|png|gif|bmp|webp)$/)) {
                    renderImage(url, documentName);
                } else if (contentType.includes('pdf') || lowerName.endsWith('.pdf')) {
                    renderPdf(url);
                } else {
                    URL.revokeObjectURL(url);
                    showUnsupportedFormat(fileUrl, documentName);
                }
            })
            .catch(function (error) {
                showDocumentError(error.message, fileUrl, documentName);
            });
    }

    document.querySelectorAll('[data-eval-doc-dismiss]').forEach(function (el) {
        el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });

    document.querySelectorAll('.view-document-btn').forEach(function (button) {
        button.addEventListener('click', function () {
            viewDocument(this.getAttribute('data-file-id'), this.getAttribute('data-document-name'));
        });
    });

    const evaluationForm = document.getElementById('evaluationForm');
    if (evaluationForm) {
        evaluationForm.addEventListener('submit', function (e) {
            const status = document.getElementById('status').value;
            const reason = document.getElementById('reason').value.trim();
            const submitBtn = document.getElementById('submitBtn');
            const submitText = document.getElementById('submitText');
            const loadingText = document.getElementById('loadingText');

            if ((status === 'DENIED' || status === 'REJECTED') && !reason) {
                e.preventDefault();
                alert('Please provide a reason for denial or rejection.');
                return false;
            }

            submitBtn.disabled = true;
            submitText.classList.add('hidden');
            loadingText.classList.remove('hidden');

            setTimeout(function () {
                submitBtn.disabled = false;
                submitText.classList.remove('hidden');
                loadingText.classList.add('hidden');
            }, 10000);
        });
    }
})();
</script>
{% endblock %}
