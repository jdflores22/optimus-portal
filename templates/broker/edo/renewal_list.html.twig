{% extends 'base.html.twig' %}

{% block title %}eDO Renewal Requests - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Header Section -->
    <div class="bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                    <h1 class="text-2xl font-bold text-base-content">eDO Renewal Requests</h1>
                    <p class="text-sm text-base-content/60 mt-1">Track and manage your eDO renewal requests</p>
                </div>
                
                <!-- Active Workspace Badge -->
                {% if app.session.get('active_workspace_consignee_id') %}
                    <div class="flex items-center gap-2 bg-primary/10 rounded-xl px-4 py-3">
                        <span class="icon-[tabler--briefcase] size-5 text-primary"></span>
                        <div class="flex flex-col">
                            <span class="text-xs text-primary/70 font-medium">Active Workspace</span>
                            <span class="text-sm font-bold text-primary truncate max-w-[200px]">{{ app.session.get('active_workspace_consignee_name', 'Workspace') }}</span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-8 py-6">
        <!-- Filters -->
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-body p-4">
                <form method="GET" action="{{ path('broker_edo_renewal_list') }}" class="flex flex-col sm:flex-row gap-3">
                    <!-- Status Filter -->
                    <div class="flex-1">
                        <label for="statusFilter" class="block text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-2">Filter by Status</label>
                        <select name="status" id="statusFilter" class="select select-bordered w-full rounded-lg" onchange="this.form.submit()">
                            <option value="">All Statuses</option>
                            <option value="pending_review" {{ filters.status == 'pending_review' ? 'selected' : '' }}>Pending Review</option>
                            <option value="awaiting_payment" {{ filters.status == 'awaiting_payment' ? 'selected' : '' }}>Awaiting Payment</option>
                            <option value="payment_verified" {{ filters.status == 'payment_verified' ? 'selected' : '' }}>Payment Verified</option>
                            <option value="ready_for_generation" {{ filters.status == 'ready_for_generation' ? 'selected' : '' }}>Ready for Generation</option>
                            <option value="completed" {{ filters.status == 'completed' ? 'selected' : '' }}>Completed</option>
                            <option value="cancelled" {{ filters.status == 'cancelled' ? 'selected' : '' }}>Cancelled</option>
                        </select>
                    </div>

                    <!-- Sort Order -->
                    <div class="flex-1">
                        <label for="sortFilter" class="block text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-2">Sort By</label>
                        <select name="sort" id="sortFilter" class="select select-bordered w-full rounded-lg" onchange="this.form.submit()">
                            <option value="newest" {{ filters.sort == 'newest' ? 'selected' : '' }}>Newest First</option>
                            <option value="oldest" {{ filters.sort == 'oldest' ? 'selected' : '' }}>Oldest First</option>
                        </select>
                    </div>
                </form>
            </div>
        </div>

        <!-- Renewal Requests List -->
        <div class="card bg-base-100 shadow-sm">
            {% if renewalRequests|length > 0 %}
                <!-- Desktop Table -->
                <div class="hidden lg:block overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Expired eDO</th>
                                <th>Container</th>
                                <th>Status</th>
                                <th>Detention Charges</th>
                                <th>Requested Date</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for request in renewalRequests %}
                                {% set statusClass = {
                                    'pending_review': 'badge-warning',
                                    'awaiting_payment': 'badge-error',
                                    'payment_verified': 'badge-info',
                                    'ready_for_generation': 'badge-success',
                                    'completed': 'badge-success',
                                    'cancelled': 'badge-ghost'
                                } %}
                                
                                <tr class="hover" onclick="window.location.href='{{ path('broker_edo_renewal_status', {id: request.id}) }}'" style="cursor: pointer;">
                                    <td>
                                        <span class="font-semibold">#{{ request.id }}</span>
                                    </td>
                                    <td>
                                        <span class="text-primary font-medium">{{ request.expiredEdo.edoNumber }}</span>
                                    </td>
                                    <td>{{ request.expiredEdo.container.containerNumber }}</td>
                                    <td>
                                        <span class="badge {{ statusClass[request.status.value] ?? 'badge-ghost' }} text-xs rounded-lg">
                                            {{ request.status.value|replace({'_': ' '})|title }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if request.detentionChargeAmount > 0 %}
                                            <span class="font-semibold text-error">{{ request.detentionChargeAmount|format_money('PHP') }}</span>
                                        {% else %}
                                            <span class="text-base-content/60">No charges</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ request.requestedAt|date('M j, Y, g:i A') }}</td>
                                    <td class="text-right" onclick="event.stopPropagation()">
                                        {% if request.status.value == 'completed' and request.newEdo %}
                                            <a href="{{ path('broker_edo_detail_page', {id: request.newEdo.id}) }}" class="btn btn-success btn-sm rounded-lg gap-2">
                                                <span class="icon-[tabler--eye] size-4"></span>
                                                View eDO
                                            </a>
                                        {% elseif request.status.value == 'awaiting_payment' and request.detentionBilling %}
                                            <a href="{{ path('broker_edo_renewal_status', {id: request.id}) }}" class="btn btn-error btn-sm rounded-lg gap-2">
                                                <span class="icon-[tabler--credit-card] size-4"></span>
                                                Pay Now
                                            </a>
                                        {% else %}
                                            <a href="{{ path('broker_edo_renewal_status', {id: request.id}) }}" class="btn btn-ghost btn-sm rounded-lg gap-2">
                                                <span class="icon-[tabler--eye] size-4"></span>
                                                View Status
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Cards -->
                <div class="lg:hidden divide-y divide-base-300">
                    {% for request in renewalRequests %}
                        {% set statusClass = {
                            'pending_review': 'badge-warning',
                            'awaiting_payment': 'badge-error',
                            'payment_verified': 'badge-info',
                            'ready_for_generation': 'badge-success',
                            'completed': 'badge-success',
                            'cancelled': 'badge-ghost'
                        } %}
                        
                        <div class="p-4 hover:bg-base-200">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex-1">
                                        <div class="font-bold">Request #{{ request.id }}</div>
                                        <div class="text-sm text-primary font-medium mt-1">{{ request.expiredEdo.edoNumber }}</div>
                                        <div class="text-sm opacity-60">Container: {{ request.expiredEdo.container.containerNumber }}</div>
                                    </div>
                                    <span class="badge {{ statusClass[request.status.value] ?? 'badge-ghost' }} text-xs rounded-lg">
                                        {{ request.status.value|replace({'_': ' '})|title }}
                                    </span>
                                </div>
                                
                                <div class="flex flex-wrap items-center gap-2">
                                    {% if request.detentionChargeAmount > 0 %}
                                        <span class="text-sm font-semibold text-error">{{ request.detentionChargeAmount|format_money('PHP') }}</span>
                                    {% else %}
                                        <span class="text-sm text-base-content/60">No charges</span>
                                    {% endif %}
                                </div>
                                
                                <div class="text-sm opacity-60">
                                    Requested: {{ request.requestedAt|date('M j, Y, g:i A') }}
                                </div>
                                
                                <div class="flex gap-2">
                                    {% if request.status.value == 'completed' and request.newEdo %}
                                        <a href="{{ path('broker_edo_detail_page', {id: request.newEdo.id}) }}" class="btn btn-success btn-sm flex-1">
                                            <span class="icon-[tabler--eye] size-4"></span>
                                            View eDO
                                        </a>
                                    {% elseif request.status.value == 'awaiting_payment' and request.detentionBilling %}
                                        <a href="{{ path('broker_edo_renewal_status', {id: request.id}) }}" class="btn btn-error btn-sm flex-1">
                                            <span class="icon-[tabler--credit-card] size-4"></span>
                                            Pay Now
                                        </a>
                                    {% else %}
                                        <a href="{{ path('broker_edo_renewal_status', {id: request.id}) }}" class="btn btn-ghost btn-sm flex-1">
                                            <span class="icon-[tabler--eye] size-4"></span>
                                            View Status
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                {% if totalPages > 1 %}
                    <div class="px-6 py-4 bg-base-200/50 border-t border-base-300">
                        <div class="flex items-center justify-between">
                            <div class="flex-1 flex justify-between sm:hidden">
                                {% if currentPage > 1 %}
                                    <a href="{{ path('broker_edo_renewal_list', filters|merge({page: currentPage - 1})) }}" class="btn btn-ghost btn-sm rounded-lg">
                                        Previous
                                    </a>
                                {% endif %}
                                {% if currentPage < totalPages %}
                                    <a href="{{ path('broker_edo_renewal_list', filters|merge({page: currentPage + 1})) }}" class="btn btn-ghost btn-sm rounded-lg">
                                        Next
                                    </a>
                                {% endif %}
                            </div>
                            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                                <div>
                                    <p class="text-sm opacity-60">
                                        Page {{ currentPage }} of {{ totalPages }} ({{ total }} total)
                                    </p>
                                </div>
                                <div>
                                    <div class="join">
                                        {% if currentPage > 1 %}
                                            <a href="{{ path('broker_edo_renewal_list', filters|merge({page: currentPage - 1})) }}" class="btn btn-ghost btn-sm join-item rounded-lg">
                                                <span class="icon-[tabler--chevron-left] size-4"></span>
                                            </a>
                                        {% endif %}
                                        
                                        {% for i in 1..totalPages %}
                                            {% if i == 1 or i == totalPages or (i >= currentPage - 1 and i <= currentPage + 1) %}
                                                <a href="{{ path('broker_edo_renewal_list', filters|merge({page: i})) }}" 
                                                   class="btn btn-sm join-item rounded-lg {{ i == currentPage ? 'btn-primary' : 'btn-ghost' }}">
                                                    {{ i }}
                                                </a>
                                            {% elseif i == currentPage - 2 or i == currentPage + 2 %}
                                                <span class="btn btn-ghost btn-sm join-item rounded-lg cursor-default">...</span>
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% if currentPage < totalPages %}
                                            <a href="{{ path('broker_edo_renewal_list', filters|merge({page: currentPage + 1})) }}" class="btn btn-ghost btn-sm join-item rounded-lg">
                                                <span class="icon-[tabler--chevron-right] size-4"></span>
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <!-- Empty State -->
                <div class="p-12 text-center">
                    <div class="size-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="icon-[tabler--file-off] size-8 opacity-40"></span>
                    </div>
                    <h3 class="text-base font-semibold">No renewal requests found</h3>
                    <p class="mt-2 text-sm opacity-60">
                        {% if filters.status %}
                            No renewal requests match your current filter.
                        {% else %}
                            You haven't submitted any eDO renewal requests yet.
                        {% endif %}
                    </p>
                    {% if filters.status %}
                        <a href="{{ path('broker_edo_renewal_list') }}" class="btn btn-ghost btn-sm mt-4">
                            Clear Filter
                        </a>
                    {% else %}
                        <a href="{{ path('broker_edo_list_page') }}" class="btn btn-primary btn-sm mt-4">
                            <span class="icon-[tabler--file-text] size-4"></span>
                            View My eDOs
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
