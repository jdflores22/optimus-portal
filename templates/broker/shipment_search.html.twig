{% extends 'base.html.twig' %}

{% block title %}Search Shipments - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="py-6">
                <h1 class="text-3xl font-bold text-gray-900">Search Shipments</h1>
                <p class="mt-2 text-gray-600">Search for shipments you are authorized to access</p>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-green-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="font-medium text-green-800">{{ message }}</span>
                </div>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-red-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <span class="font-medium text-red-800">{{ message }}</span>
                </div>
            </div>
        {% endfor %}

        <!-- Search Filters -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Search Filters</h2>
            </div>
            <div class="p-6">
                <form method="GET" action="{{ path('broker_shipment_search') }}" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div>
                        <label for="blNumber" class="block text-sm font-medium text-gray-700 mb-2">B/L Number</label>
                        <input type="text" 
                               id="blNumber" 
                               name="blNumber" 
                               value="{{ filters.blNumber ?? '' }}" 
                               placeholder="Search by B/L number"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label for="arrivalDateFrom" class="block text-sm font-medium text-gray-700 mb-2">Arrival Date From</label>
                        <input type="date" 
                               id="arrivalDateFrom" 
                               name="arrivalDateFrom" 
                               value="{{ filters.arrivalDateFrom ?? '' }}"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label for="arrivalDateTo" class="block text-sm font-medium text-gray-700 mb-2">Arrival Date To</label>
                        <input type="date" 
                               id="arrivalDateTo" 
                               name="arrivalDateTo" 
                               value="{{ filters.arrivalDateTo ?? '' }}"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label for="consigneeId" class="block text-sm font-medium text-gray-700 mb-2">Consignee</label>
                        <select id="consigneeId" 
                                name="consigneeId"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                            <option value="">All Consignees</option>
                            {% for consignee in linkedConsignees %}
                                <option value="{{ consignee.id }}" {{ filters.consigneeId == consignee.id ? 'selected' : '' }}>
                                    {{ consignee.businessName }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="md:col-span-2 lg:col-span-3 flex justify-end space-x-3 pt-4">
                        <a href="{{ path('broker_shipment_search') }}" 
                           class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Clear
                        </a>
                        <button type="submit" 
                                class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Search Results -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">
                    Search Results 
                    {% if shipments is not empty %}
                        <span class="text-gray-500 font-normal">({{ shipments|length }} found)</span>
                    {% endif %}
                </h2>
            </div>

            {% if shipments is empty %}
                <div class="text-center py-12">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No shipments found</h3>
                    <p class="text-sm text-gray-500">Try adjusting your search filters</p>
                </div>
            {% else %}
                <!-- Table with Horizontal Scroll -->
                <div class="desktop-table" style="overflow-x: auto; white-space: nowrap;">
                    <table class="min-w-full divide-y divide-gray-200" style="min-width: 800px;">
                        <style>
                            @media (max-width: 767px) {
                                .desktop-table { display: none !important; }
                            }
                        </style>
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    B/L No
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Container Number
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Notice of Arrival
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Actual Arrival
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Payment Status
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for shipment in shipments %}
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                                                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="text-sm font-medium text-gray-900">{{ shipment.blNo ?: 'N/A' }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {{ shipment.containerNumber ?: 'N/A' }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% if shipment.noticeOfArrivalDate %}
                                            <div class="flex items-center">
                                                <svg class="w-4 h-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a2 2 0 012-2h4a2 2 0 012 2v4m-6 0V6a2 2 0 012-2h4a2 2 0 012 2v1m-6 0h8m-8 0H6a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V9a2 2 0 00-2-2h-2"></path>
                                                </svg>
                                                {{ shipment.noticeOfArrivalDate|date('M j, Y') }}
                                            </div>
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {% if shipment.actualArrivalDate %}
                                            <div class="flex items-center">
                                                <svg class="w-4 h-4 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                                {{ shipment.actualArrivalDate|date('M j, Y') }}
                                            </div>
                                        {% else %}
                                            <div class="flex items-center">
                                                <svg class="w-4 h-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                                Pending
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        {% set latestPayment = shipment.payment %}
                                        {% if latestPayment %}
                                            {% set paymentStatusClass = 'bg-gray-100 text-gray-800' %}
                                            {% set paymentIcon = 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' %}
                                            {% if latestPayment.status.value == 'VERIFIED' %}
                                                {% set paymentStatusClass = 'bg-green-100 text-green-800' %}
                                                {% set paymentIcon = 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' %}
                                            {% elseif latestPayment.status.value == 'REJECTED' %}
                                                {% set paymentStatusClass = 'bg-red-100 text-red-800' %}
                                                {% set paymentIcon = 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z' %}
                                            {% elseif latestPayment.status.value == 'PENDING' %}
                                                {% set paymentStatusClass = 'bg-blue-100 text-blue-800' %}
                                                {% set paymentIcon = 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' %}
                                            {% endif %}
                                            <div class="flex items-center">
                                                <svg class="w-3 h-3 mr-1.5 {{ paymentStatusClass|replace({'bg-': 'text-', '100': '600'}) }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ paymentIcon }}"></path>
                                                </svg>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ paymentStatusClass }}">
                                                    {{ latestPayment.status.value|title }}
                                                </span>
                                            </div>
                                        {% else %}
                                            <div class="flex items-center">
                                                <svg class="w-3 h-3 mr-1.5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                                </svg>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                    No Payment
                                                </span>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <a href="{{ path('broker_shipment_detail', {'id': shipment.id}) }}" 
                                           class="inline-flex items-center px-2.5 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                            </svg>
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="md:hidden space-y-4 p-6">
                    {% for shipment in shipments %}
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-medium text-gray-900">{{ shipment.blNo ?: 'N/A' }}</h3>
                                        <p class="text-sm text-gray-500">{{ shipment.containerNumber ?: 'No container' }}</p>
                                    </div>
                                </div>
                                {% set latestPayment = shipment.payment %}
                                {% if latestPayment %}
                                    {% set paymentStatusClass = 'bg-gray-100 text-gray-800' %}
                                    {% if latestPayment.status.value == 'VERIFIED' %}
                                        {% set paymentStatusClass = 'bg-green-100 text-green-800' %}
                                    {% elseif latestPayment.status.value == 'REJECTED' %}
                                        {% set paymentStatusClass = 'bg-red-100 text-red-800' %}
                                    {% elseif latestPayment.status.value == 'PENDING' %}
                                        {% set paymentStatusClass = 'bg-blue-100 text-blue-800' %}
                                    {% endif %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ paymentStatusClass }}">
                                        {{ latestPayment.status.value|title }}
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        No Payment
                                    </span>
                                {% endif %}
                            </div>
                            
                            <div class="grid grid-cols-2 gap-4 text-sm mb-4">
                                <div>
                                    <span class="font-medium text-gray-600">Notice of Arrival:</span>
                                    <p class="text-gray-900 mt-1">
                                        {% if shipment.noticeOfArrivalDate %}
                                            {{ shipment.noticeOfArrivalDate|date('M j, Y') }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </p>
                                </div>
                                <div>
                                    <span class="font-medium text-gray-600">Actual Arrival:</span>
                                    <p class="text-gray-900 mt-1">
                                        {% if shipment.actualArrivalDate %}
                                            <span class="text-green-600">{{ shipment.actualArrivalDate|date('M j, Y') }}</span>
                                        {% else %}
                                            <span class="text-gray-500">Pending</span>
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                            
                            <div class="flex justify-end">
                                <a href="{{ path('broker_shipment_detail', {'id': shipment.id}) }}" 
                                   class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                    View Details
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
