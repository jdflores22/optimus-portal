{% extends 'base.html.twig' %}

{% block title %}Shipment Details - {{ shipment.manifestNumber }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Top Navigation -->
    <nav class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <span class="text-2xl font-bold text-blue-600">OPTIMUS</span>
                    <span class="ml-4 text-gray-600">Broker Portal</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Professional Header -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('broker_shipment_search') }}" class="text-blue-600 hover:text-blue-800 flex items-center text-sm">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                            Back to Search
                        </a>
                        <div class="h-4 w-px bg-gray-300"></div>
                        <h1 class="text-2xl font-semibold text-gray-900">Shipment Details</h1>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            Broker Access
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="mb-6 bg-green-50 border-l-4 border-green-400 p-4 rounded-r-md">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-green-700">{{ message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-6 bg-red-50 border-l-4 border-red-400 p-4 rounded-r-md">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-700">{{ message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Key Identifiers Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- B/L Number - Highlighted -->
                    {% if shipment.blNo %}
                        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                            <div class="px-6 py-4 border-b border-gray-200 bg-blue-50">
                                <h3 class="text-lg font-medium text-blue-900">Bill of Lading (B/L)</h3>
                            </div>
                            <div class="px-6 py-6">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">B/L Number</p>
                                        <p class="text-xl font-bold text-gray-900">{{ shipment.blNo }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Container Number - Highlighted as Important -->
                    {% if shipment.containerNumber %}
                        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                            <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
                                <h3 class="text-lg font-medium text-green-900">Container Number</h3>
                            </div>
                            <div class="px-6 py-6">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">Container Number</p>
                                        <p class="text-xl font-bold text-gray-900 font-mono">{{ shipment.containerNumber }}</p>
                                        <div class="flex items-center mt-1 space-x-4">
                                            {% if shipment.containerType %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                                    {{ shipment.containerType }}
                                                </span>
                                            {% endif %}
                                            {% if shipment.containerSize %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                                    {{ shipment.containerSize }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <!-- Shipment Information -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Shipment Information</h3>
                    </div>
                    <div class="px-6 py-6">
                        <!-- Consignee Information -->
                        {% if shipment.consignee %}
                            <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m0 0h2M7 7h10M7 11h4m6 0h4"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">Consignee</p>
                                        <p class="text-base font-semibold text-gray-900">{{ shipment.consignee.businessName }}</p>
                                        <p class="text-sm text-gray-600">{{ shipment.consignee.email }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Authorized Broker Information -->
                        {% if shipment.authorizedBrokers is not empty %}
                            {% set authorizedBroker = shipment.authorizedBrokers|first %}
                            <div class="mb-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="flex-1">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <p class="text-sm font-medium text-gray-500">Authorized Broker</p>
                                                <p class="text-base font-semibold text-gray-900">{{ authorizedBroker.fullName }}</p>
                                                <p class="text-sm text-gray-600">{{ authorizedBroker.email }}</p>
                                            </div>
                                            <div class="text-right">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                    </svg>
                                                    Authorized
                                                </span>
                                                {% if authorizedBroker.id == app.user.id %}
                                                    <p class="text-xs text-blue-600 mt-1 font-medium">You are handling this shipment</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Details Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Manifest Number</dt>
                                <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.manifestNumber }}</dd>
                            </div>

                            {% if shipment.deliveryOrderNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Delivery Order No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.deliveryOrderNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.vessel %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Vessel</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.vessel }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.voyage %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Voyage</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.voyage }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.lloydsNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">LLOYDS No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.lloydsNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.custStatus %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customs Status</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.custStatus }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.custRef %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customs Reference</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.custRef }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.vesselCustomNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Vessel Custom No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.vesselCustomNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.agentCustomRegNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Agent Custom Reg No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.agentCustomRegNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.custId %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customer ID</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.custId }}</dd>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Container Information -->
                {% if shipment.containerNumber or shipment.containerType or shipment.containerSize %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-medium text-gray-900">Container Details</h3>
                            </div>
                        </div>
                        <div class="px-6 py-6">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                {% if shipment.containerNumber %}
                                    <div class="md:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Container Number</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900 font-mono bg-green-50 px-3 py-2 rounded border border-green-200">{{ shipment.containerNumber }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.containerType %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Container Type</dt>
                                        <dd class="mt-1">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                                {{ shipment.containerType }}
                                            </span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if shipment.containerSize %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Container Size</dt>
                                        <dd class="mt-1">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                                {{ shipment.containerSize }}
                                            </span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if shipment.emptyReturnAddress %}
                                    <div class="md:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Empty Return Address</dt>
                                        <dd class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded border">
                                            <pre class="whitespace-pre-wrap font-sans">{{ shipment.emptyReturnAddress }}</pre>
                                        </dd>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Commodity Information -->
                {% if shipment.commodity or shipment.commodityPcs or shipment.commodityQty or shipment.netWtKgm or shipment.measCbm %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-medium text-gray-900">Commodity Information</h3>
                            </div>
                        </div>
                        <div class="px-6 py-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {% if shipment.commodity %}
                                    <div class="md:col-span-2 lg:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Commodity</dt>
                                        <dd class="mt-1 text-base font-semibold text-gray-900 bg-purple-50 px-3 py-2 rounded border border-purple-200">{{ shipment.commodity }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.commodityPcs %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Pieces (PCS)</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">{{ shipment.commodityPcs }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.commodityQty %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Quantity (QTY)</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">{{ shipment.commodityQty }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.netWtKgm %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Net Weight</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">
                                            {{ shipment.netWtKgm }} <span class="text-sm font-normal text-gray-500">KGM</span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if shipment.measCbm %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Measurement</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">
                                            {{ shipment.measCbm }} <span class="text-sm font-normal text-gray-500">CBM</span>
                                        </dd>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Dates & Timeline -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Timeline</h3>
                    </div>
                    <div class="px-6 py-6">
                        <div class="space-y-4">
                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-900">Notice of Arrival</p>
                                    <p class="text-sm text-gray-600">{{ shipment.noticeOfArrivalDate|date('F j, Y \a\t g:i A') }}</p>
                                </div>
                            </div>

                            {% if shipment.actualArrivalDate %}
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Actual Arrival</p>
                                        <p class="text-sm text-gray-600">{{ shipment.actualArrivalDate|date('F j, Y \a\t g:i A') }}</p>
                                    </div>
                                </div>
                            {% endif %}

                            {% if shipment.generalDeclarationDt %}
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">General Declaration</p>
                                        <p class="text-sm text-gray-600">{{ shipment.generalDeclarationDt|date('F j, Y') }}</p>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Billing Information -->
                {% if shipment.billingInformation %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <h3 class="text-lg font-medium text-gray-900">Billing Information</h3>
                        </div>
                        <div class="px-6 py-6">
                            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                <pre class="text-sm text-gray-700 whitespace-pre-wrap font-sans">{{ shipment.billingInformation }}</pre>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Payment Status -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Payment Status</h3>
                    </div>
                    <div class="px-6 py-6">
                        {% set latestPayment = shipment.payment %}
                        {% if latestPayment %}
                            <div class="space-y-3">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                            {% if latestPayment.status.value == 'VERIFIED' %}
                                                bg-green-100 text-green-800
                                            {% elseif latestPayment.status.value == 'PENDING' %}
                                                bg-yellow-100 text-yellow-800
                                            {% else %}
                                                bg-red-100 text-red-800
                                            {% endif %}">
                                            {{ latestPayment.status.value|title }}
                                        </span>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-500">Submitted by</p>
                                    <p class="text-sm text-gray-900">{{ latestPayment.broker.fullName }}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-500">Submitted on</p>
                                    <p class="text-sm text-gray-900">{{ latestPayment.createdAt|date('F j, Y g:i A') }}</p>
                                </div>

                                {% if latestPayment.status.value == 'VERIFIED' %}
                                    <div class="p-4 bg-green-50 border border-green-200 rounded-lg">
                                        <p class="text-sm text-green-800">
                                            <strong>Payment Verified!</strong><br>
                                            Your payment has been verified by accounting staff.
                                        </p>
                                    </div>
                                {% elseif latestPayment.status.value == 'PENDING' %}
                                    <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
                                        <p class="text-sm text-blue-800">
                                            Your payment proof is being reviewed by accounting staff.
                                        </p>
                                    </div>
                                {% elseif latestPayment.status.value == 'REJECTED' %}
                                    <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
                                        <p class="text-sm text-red-800">
                                            Your payment proof was rejected. Please submit a new proof.
                                        </p>
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="text-center py-6">
                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                </svg>
                                <p class="mt-2 text-sm text-gray-500">No payment submitted</p>
                                
                                <!-- Payment Submission Form -->
                                <div class="mt-6 space-y-4">
                                    <p class="text-sm text-gray-600">
                                        Submit proof of payment to proceed with this shipment.
                                    </p>

                                    <form method="POST" 
                                          action="{{ path('broker_submit_payment', {id: shipment.id}) }}" 
                                          enctype="multipart/form-data"
                                          class="space-y-4"
                                          id="paymentForm">
                                        <div>
                                            <label for="proofOfPayment" class="block text-sm font-medium text-gray-700 mb-2">
                                                Upload Proof of Payment <span class="text-red-500">*</span>
                                            </label>
                                            <input type="file" 
                                                   id="proofOfPayment" 
                                                   name="proofOfPayment" 
                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                   required
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                            <p class="mt-1 text-xs text-gray-500">
                                                Accepted formats: PDF, JPG, PNG (Max 10MB)
                                            </p>
                                        </div>

                                        <button type="submit" 
                                                id="submitPaymentBtn"
                                                class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
                                            <span id="submitText">Submit Payment Proof</span>
                                            <span id="submitLoading" class="hidden">
                                                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                </svg>
                                                Uploading...
                                            </span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- EDO Card (only show for verified payments) -->
                {% if shipment.payment and shipment.payment.status.value == 'VERIFIED' and shipment.payment.edo %}
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
                        <div class="flex items-center">
                            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">Electronic Delivery Order</h3>
                                <p class="text-sm text-gray-600">EDO #{{ shipment.payment.edo.edoNumber }}</p>
                            </div>
                        </div>
                    </div>
                    <div class="px-6 py-6">
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-4 bg-green-50 rounded-lg border border-green-200">
                                <div class="flex items-center">
                                    <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3">
                                        <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-green-900">EDO Generated</p>
                                        <p class="text-xs text-green-700">{{ shipment.payment.edo.generatedAt|date('F j, Y g:i A') }}</p>
                                    </div>
                                </div>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Ready for Download
                                </span>
                            </div>
                            
                            <div class="grid grid-cols-1 gap-3">
                                <button type="button" 
                                        data-shipment-id="{{ shipment.id }}"
                                        class="view-edo-btn w-full flex items-center justify-center px-4 py-3 border border-green-300 text-sm font-medium rounded-lg text-green-700 bg-green-50 hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                    View EDO PDF
                                </button>
                                
                                <a href="{{ path('broker_download_edo', {id: shipment.id}) }}" 
                                   class="w-full flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors shadow-sm">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                    Download EDO PDF
                                </a>
                            </div>
                            
                            <div class="mt-4 p-3 bg-blue-50 rounded-lg border border-blue-200">
                                <div class="flex items-start">
                                    <svg class="w-5 h-5 text-blue-400 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                    </svg>
                                    <div>
                                        <p class="text-sm font-medium text-blue-900">EDO Information</p>
                                        <p class="text-xs text-blue-800 mt-1">
                                            This Electronic Delivery Order has been automatically generated and sent to the broker and consignee via email. 
                                            The EDO serves as authorization for cargo release.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                <!-- System Information -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">System Information</h3>
                    </div>
                    <div class="px-6 py-6 space-y-3">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Created by</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ shipment.createdBy.email }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Created on</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ shipment.createdAt|date('F j, Y \a\t g:i A') }}</dd>
                        </div>
                    </div>
                </div>

                <!-- Quick Info -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h3 class="text-sm font-semibold text-blue-900 mb-2">Need Help?</h3>
                    <p class="text-xs text-blue-800">
                        If you have questions about this shipment or payment process, please contact the shipping lines staff.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Document Modal -->
<div id="documentModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50 flex items-center justify-center p-4">
    <div class="relative bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] flex flex-col">
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900" id="modalTitle">Electronic Delivery Order (EDO)</h3>
            <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        
        <!-- Modal Body -->
        <div class="flex-1 p-6 overflow-auto">
            <div id="documentContent" class="flex items-center justify-center min-h-[400px]">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-600 mx-auto"></div>
                    <p class="mt-2 text-gray-600">Loading EDO document...</p>
                </div>
            </div>
        </div>
        
        <!-- Modal Footer -->
        <div class="flex items-center justify-end p-6 border-t border-gray-200 space-x-3">
            <a id="downloadLink" href="#" target="_blank" 
               class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium">
                Download EDO PDF
            </a>
            <button type="button" id="closeModalFooterBtn" 
                    class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors font-medium">
                Close
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const paymentForm = document.getElementById('paymentForm');
    const submitBtn = document.getElementById('submitPaymentBtn');
    const submitText = document.getElementById('submitText');
    const submitLoading = document.getElementById('submitLoading');
    const fileInput = document.getElementById('proofOfPayment');
    
    if (paymentForm && submitBtn) {
        // Add file validation feedback
        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                // Check file size (10MB limit)
                if (file.size > 10 * 1024 * 1024) {
                    alert('File size exceeds 10MB limit. Please choose a smaller file.');
                    this.value = '';
                    return;
                }
                
                // Visual feedback for file selection
                const label = document.querySelector('label[for="proofOfPayment"]');
                label.style.color = '#10b981'; // green
                label.title = 'File selected: ' + file.name;
            }
        });
        
        // Handle form submission
        paymentForm.addEventListener('submit', function(e) {
            // Check if file is selected
            if (!fileInput.files.length) {
                e.preventDefault();
                alert('Please select a file to upload.');
                return false;
            }
            
            // Show loading state
            submitBtn.disabled = true;
            submitText.classList.add('hidden');
            submitLoading.classList.remove('hidden');
            
            // Optional: Add progress indication for large files
            const file = fileInput.files[0];
            if (file.size > 5 * 1024 * 1024) { // 5MB+
                // Show additional message for large files
                setTimeout(function() {
                    if (submitLoading && !submitLoading.classList.contains('hidden')) {
                        submitLoading.innerHTML = `
                            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Processing large file...
                        `;
                    }
                }, 3000);
            }
        });
        
        // Reset loading state if form submission fails (e.g., validation error)
        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                // Page was loaded from cache, reset button state
                submitBtn.disabled = false;
                submitText.classList.remove('hidden');
                submitLoading.classList.add('hidden');
            }
        });
    }

    // View EDO buttons
    document.querySelectorAll('.view-edo-btn').forEach(button => {
        button.addEventListener('click', function() {
            const shipmentId = this.getAttribute('data-shipment-id');
            viewEDODocument(shipmentId);
        });
    });
    
    // Close modal buttons
    document.getElementById('closeModalBtn').addEventListener('click', closeModal);
    document.getElementById('closeModalFooterBtn').addEventListener('click', closeModal);
    
    // Close modal when clicking outside
    document.getElementById('documentModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeModal();
        }
    });
    
    // Close modal with Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('documentModal');
            if (!modal.classList.contains('hidden')) {
                closeModal();
            }
        }
    });
});

// Function to view EDO documents for broker shipments
function viewEDODocument(shipmentId) {
    const modal = document.getElementById('documentModal');
    const modalTitle = document.getElementById('modalTitle');
    const documentContent = document.getElementById('documentContent');
    const downloadLink = document.getElementById('downloadLink');
    
    // Set modal title
    modalTitle.textContent = 'Electronic Delivery Order (EDO)';
    
    // Set download link
    downloadLink.href = `/broker/shipments/${shipmentId}/edo/download`;
    
    // Show modal
    modal.classList.remove('hidden');
    
    // Reset content to loading state
    documentContent.innerHTML = `
        <div class="text-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-600 mx-auto"></div>
            <p class="mt-2 text-gray-600">Loading EDO document...</p>
        </div>
    `;
    
    // Load EDO document content by trying to fetch it
    fetch(`/broker/shipments/${shipmentId}/edo/download`)
        .then(response => {
            if (!response.ok) {
                throw new Error('EDO document not found');
            }
            return response.blob();
        })
        .then(blob => {
            const url = URL.createObjectURL(blob);
            
            console.log('EDO Document loaded:', {
                shipmentId: shipmentId,
                contentType: blob.type,
                blobSize: blob.size
            });
            
            // EDO files are PDFs
            createPdfElement(url);
        })
        .catch(error => {
            console.error('EDO document loading error:', error);
            showEDODocumentError(error.message);
        });
}

function createPdfElement(url) {
    const documentContent = document.getElementById('documentContent');
    const container = document.createElement('div');
    container.className = 'w-full h-full';
    
    const iframe = document.createElement('iframe');
    iframe.src = url;
    iframe.className = 'w-full border rounded-lg';
    iframe.style.height = '500px';
    iframe.style.minHeight = '500px';
    
    // Clear loading state immediately and show iframe
    documentContent.innerHTML = '';
    container.appendChild(iframe);
    documentContent.appendChild(container);
    
    // Add a timeout fallback in case onload doesn't fire
    setTimeout(() => {
        console.log('PDF iframe should be loaded by now');
    }, 2000);
    
    iframe.onerror = function() {
        console.error('PDF iframe failed to load');
        showEDODocumentError('Failed to load PDF');
    };
}

function showEDODocumentError(message) {
    const documentContent = document.getElementById('documentContent');
    documentContent.innerHTML = `
        <div class="text-center py-8">
            <svg class="w-16 h-16 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-red-600 mb-2">Error loading EDO document</p>
            <p class="text-sm text-gray-500">${message}</p>
            <p class="text-sm text-gray-500 mt-2">Please try downloading the EDO document instead.</p>
        </div>
    `;
}

function closeModal() {
    const modal = document.getElementById('documentModal');
    modal.classList.add('hidden');
    
    // Clean up any object URLs
    const iframe = modal.querySelector('iframe');
    const img = modal.querySelector('img');
    if (iframe && iframe.src.startsWith('blob:')) {
        URL.revokeObjectURL(iframe.src);
    }
    if (img && img.src.startsWith('blob:')) {
        URL.revokeObjectURL(img.src);
    }
}
</script>
{% endblock %}
