{% extends 'base.html.twig' %}

{% block title %}Apply Referral Code - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <div class="px-4 sm:px-6 lg:px-8 py-6">
        <div class="max-w-2xl mx-auto space-y-6">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-base-content">Apply Referral Code</h1>
                    <p class="text-sm text-base-content/60 mt-1">Link with a consignee using their referral code</p>
                </div>
                <a href="{{ path('broker_workspace_selector') }}"
                   class="btn btn-ghost gap-2">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to Workspaces
                </a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    <span class="icon-[tabler--check] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning">
                    <span class="icon-[tabler--alert-triangle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <div class="alert alert-info">
                <span class="icon-[tabler--info-circle] size-5"></span>
                <div class="text-sm">
                    <p class="font-semibold mb-1">How it works</p>
                    <ul class="list-disc list-inside space-y-1 opacity-90">
                        <li>Get a referral code from a consignee you want to work with</li>
                        <li>Enter the code below to create a relationship</li>
                        <li>Once linked, you'll be able to access their manifests</li>
                        <li>The consignee can assign you to handle their shipments</li>
                    </ul>
                </div>
            </div>

            <!-- Apply Code Form -->
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6">
                    <div class="form-control">
                        <label for="referral_code" class="label">
                            <span class="label-text font-medium">Referral Code <span class="text-error">*</span></span>
                        </label>
                        <input type="text"
                               id="referral_code"
                               name="referral_code"
                               required
                               autocomplete="off"
                               class="input input-bordered input-lg w-full font-mono uppercase"
                               placeholder="Enter referral code"
                               oninput="this.value = this.value.toUpperCase()">
                        <label class="label">
                            <span class="label-text-alt">The referral code is provided by the consignee you want to work with</span>
                        </label>
                        <div id="codeValidation" class="hidden mt-1">
                            <p class="text-sm text-error">Please enter a valid referral code</p>
                        </div>
                    </div>

                    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 mt-6">
                        <a href="{{ path('broker_workspace_selector') }}"
                           class="btn btn-ghost">
                            Cancel
                        </a>
                        <button type="button"
                                onclick="showConfirmationModal()"
                                id="applyBtn"
                                class="btn btn-primary gap-2">
                            <span class="icon-[tabler--link] size-5"></span>
                            <span id="applyBtnText">Apply Code</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-5">
                    <h3 class="text-sm font-semibold text-base-content mb-2">Need help?</h3>
                    <p class="text-sm text-base-content/70">
                        If you don't have a referral code, contact the consignee you want to work with and ask them to generate one for you.
                        They can create referral codes from their dashboard.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="POST" action="{{ path('broker_apply_referral_code') }}" id="applyCodeForm" class="hidden">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('apply_referral_code') }}">
    <input type="hidden" name="referral_code" id="hiddenReferralCode">
</form>
{% endblock %}

{% block page_modals %}
<div id="confirmationModal"
     class="hidden fixed inset-0 z-[10005] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirmationModalTitle">
    <div id="confirmationModalBackdrop" class="absolute inset-0 bg-black/60" onclick="closeConfirmationModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div class="size-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="icon-[tabler--link] size-7 text-primary"></span>
            </div>
            <h3 id="confirmationModalTitle" class="text-lg font-bold mb-2">Confirm Referral Code</h3>
            <p class="text-sm text-base-content/70 mb-4">
                Are you sure you want to apply this referral code?
            </p>
            <div class="bg-base-200 rounded-lg p-3 mb-4 text-left">
                <p class="text-xs text-base-content/60 mb-1">Referral Code</p>
                <p id="modalCodeDisplay" class="text-lg font-mono font-bold"></p>
            </div>
            <p class="text-xs text-base-content/60 mb-6">
                This will create a relationship with the consignee and allow you to access their manifests.
            </p>
            <div class="flex gap-3">
                <button type="button"
                        onclick="closeConfirmationModal()"
                        class="btn btn-ghost flex-1">
                    Cancel
                </button>
                <button type="button"
                        onclick="confirmApply()"
                        id="confirmBtn"
                        class="btn btn-primary flex-1 gap-2">
                    <span id="confirmBtnText">Confirm</span>
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
function showConfirmationModal() {
    const codeInput = document.getElementById('referral_code');
    const validation = document.getElementById('codeValidation');
    const code = codeInput.value.trim();

    if (code.length < 5) {
        validation.classList.remove('hidden');
        codeInput.classList.add('input-error');
        return;
    }

    document.getElementById('modalCodeDisplay').textContent = code;
    const modal = document.getElementById('confirmationModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeConfirmationModal() {
    const modal = document.getElementById('confirmationModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
}

function confirmApply() {
    const codeInput = document.getElementById('referral_code');
    const confirmBtn = document.getElementById('confirmBtn');
    const confirmBtnText = document.getElementById('confirmBtnText');

    confirmBtn.disabled = true;
    confirmBtnText.textContent = 'Applying...';

    document.getElementById('hiddenReferralCode').value = codeInput.value.trim();
    document.getElementById('applyCodeForm').submit();
}

document.getElementById('referral_code')?.addEventListener('input', function () {
    document.getElementById('codeValidation')?.classList.add('hidden');
    this.classList.remove('input-error');
});

document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
        closeConfirmationModal();
    }
});
</script>
{% endblock %}
