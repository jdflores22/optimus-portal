<script>
// Edit NOA Modal Functions
function openEditNoaModal() {
    document.getElementById('editNoaModal').classList.remove('hidden');
}

function closeEditNoaModal() {
    document.getElementById('editNoaModal').classList.add('hidden');
    document.getElementById('editNoaSpinner').classList.add('hidden');
    document.getElementById('editNoaSaveButton').disabled = false;
    document.getElementById('editNoaCancelButton').disabled = false;
    document.getElementById('editNoaError').classList.add('hidden');
}

async function submitNoaEdit(event) {
    event.preventDefault();
    
    const noaId = {{ noa.id }};
    const formData = {
        blNumber: document.getElementById('editBlNumber').value,
        vesselNumber: document.getElementById('editVesselNumber').value,
        eta: document.getElementById('editEta').value,
        portLocation: document.getElementById('editPortLocation').value
    };
    
    // Show spinner and disable buttons
    document.getElementById('editNoaSpinner').classList.remove('hidden');
    document.getElementById('editNoaSaveButton').disabled = true;
    document.getElementById('editNoaCancelButton').disabled = true;
    document.getElementById('editNoaError').classList.add('hidden');
    
    try {
        const response = await fetch(`/manifest-workflow/noa/${noaId}/edit`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
        });
        
        const result = await response.json();
        
        if (response.ok && result.success) {
            showSuccessMessage(result.message || 'NOA updated successfully');
            closeEditNoaModal();
            
            // Reload page to show updated data
            setTimeout(() => {
                window.location.reload();
            }, 1500);
        } else {
            showEditNoaError(result.message || 'Error updating NOA');
            // Hide spinner and re-enable buttons
            document.getElementById('editNoaSpinner').classList.add('hidden');
            document.getElementById('editNoaSaveButton').disabled = false;
            document.getElementById('editNoaCancelButton').disabled = false;
        }
    } catch (error) {
        showEditNoaError('Error updating NOA: ' + error.message);
        // Hide spinner and re-enable buttons
        document.getElementById('editNoaSpinner').classList.add('hidden');
        document.getElementById('editNoaSaveButton').disabled = false;
        document.getElementById('editNoaCancelButton').disabled = false;
    }
}

function showEditNoaError(message) {
    const errorDiv = document.getElementById('editNoaError');
    errorDiv.querySelector('span:last-child').textContent = message;
    errorDiv.classList.remove('hidden');
}

function openEDOGenerationModal() {
    // Set default expiration date (30 days from now)
    const expirationInput = document.getElementById('edoExpirationDate');
    const defaultDate = new Date();
    defaultDate.setDate(defaultDate.getDate() + 30);
    expirationInput.value = defaultDate.toISOString().split('T')[0];
    
    // Update selection count in modal
    if (window.edoContainerSelection) {
        window.edoContainerSelection.updateSelectionCount();
    } else {
        console.error('EDO Container Selection module not loaded');
        // Manually update count as fallback
        const checkedBoxes = document.querySelectorAll('.container-checkbox:checked');
        const countElement = document.getElementById('selectedContainerCount');
        if (countElement) {
            countElement.textContent = checkedBoxes.length;
        }
        const generateButton = document.getElementById('edoGenerateButton');
        if (generateButton) {
            generateButton.disabled = checkedBoxes.length === 0;
        }
    }
    
    // Show modal
    document.getElementById('edoGenerationModal').classList.remove('hidden');
}

function closeEDOGenerationModal() {
    document.getElementById('edoGenerationModal').classList.add('hidden');
    document.getElementById('edoGenerationSpinner').classList.add('hidden');
    document.getElementById('edoGenerateButton').disabled = false;
    document.getElementById('edoCancelButton').disabled = false;
}

async function generateEDOs() {
    const expirationDate = document.getElementById('edoExpirationDate').value;
    
    if (!expirationDate) {
        alert('Please select an expiration date');
        return;
    }
    
    const manifestId = {{ manifest ? manifest.id : 'null' }};
    
    if (!manifestId) {
        alert('No manifest found');
        return;
    }
    
    // Get selected container IDs
    let selectedContainerIds = [];
    if (window.edoContainerSelection) {
        selectedContainerIds = window.edoContainerSelection.getSelectedContainerIds();
    } else {
        // Fallback: manually get checked checkboxes
        console.warn('EDO Container Selection module not loaded, using fallback');
        const checkedBoxes = document.querySelectorAll('.container-checkbox:checked');
        selectedContainerIds = Array.from(checkedBoxes).map(cb => parseInt(cb.value));
    }
    
    if (selectedContainerIds.length === 0) {
        alert('Please select at least one container');
        return;
    }
    
    console.log('Generating eDOs for containers:', selectedContainerIds);
    
    // Show spinner and disable buttons
    document.getElementById('edoGenerationSpinner').classList.remove('hidden');
    document.getElementById('edoGenerateButton').disabled = true;
    document.getElementById('edoCancelButton').disabled = true;
    
    try {
        const response = await fetch(`/sl-staff/edo-generation/generate/${manifestId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                expirationDate: expirationDate,
                containerIds: selectedContainerIds  // Send selected container IDs
            })
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert(result.message);
            closeEDOGenerationModal();
            // Reload page to show updated eDO status
            window.location.reload();
        } else {
            alert('Error: ' + result.message);
            // Hide spinner and re-enable buttons
            document.getElementById('edoGenerationSpinner').classList.add('hidden');
            document.getElementById('edoGenerateButton').disabled = false;
            document.getElementById('edoCancelButton').disabled = false;
        }
    } catch (error) {
        alert('Error generating eDOs: ' + error.message);
        // Hide spinner and re-enable buttons
        document.getElementById('edoGenerationSpinner').classList.add('hidden');
        document.getElementById('edoGenerateButton').disabled = false;
        document.getElementById('edoCancelButton').disabled = false;
    }
}

// CY Reassignment Modal Functions
let currentContainerId = null;
let currentContainerNumber = null;
let currentAllocationId = null;
let currentContainerTeu = null;
let currentShippingLineId = null; // Add shipping line ID variable

function openCYReassignmentModal(containerId, containerNumber, allocationId, teuValue, shippingLineId, containerSize, containerType) {
    currentContainerId = containerId;
    currentContainerNumber = containerNumber;
    currentAllocationId = allocationId;
    currentContainerTeu = teuValue;
    currentShippingLineId = shippingLineId; // Store shipping line ID
    document.getElementById('reassignContainerNumber').textContent = containerNumber;
    document.getElementById('reassignContainerSize').textContent = containerSize;
    document.getElementById('reassignContainerType').textContent = containerType;
    loadAvailableCYAllocations();
    document.getElementById('cyReassignmentModal').classList.remove('hidden');
}

function closeCYReassignmentModal() {
    document.getElementById('cyReassignmentModal').classList.add('hidden');
    document.getElementById('cyReassignmentSpinner').classList.add('hidden');
    document.getElementById('cyReassignButton').disabled = false;
    document.getElementById('cyCancelButton').disabled = false;
    document.getElementById('cyAllocationSelect').value = '';
    document.getElementById('cyReassignmentError').classList.add('hidden');
}

async function loadAvailableCYAllocations() {
    const shippingLineId = currentShippingLineId; // Use the container's shipping line
    
    if (!shippingLineId) {
        showCYReassignmentError('No shipping line found');
        return;
    }
    
    try {
        const response = await fetch(`/api/cy-allocations?shipping_line_id=${shippingLineId}`);
        const data = await response.json();
        
        const select = document.getElementById('cyAllocationSelect');
        select.innerHTML = '<option value="">Select CY Location...</option>';
        
        // Determine if container is 20ft or 40ft based on TEU value
        const is20ft = currentContainerTeu === 1.0;
        const is40ft = currentContainerTeu >= 2.0;
        
        // Sort by available capacity for the specific size
        data.allocations.sort((a, b) => {
            const availA = is20ft ? a.available_20ft : a.available_40ft;
            const availB = is20ft ? b.available_20ft : b.available_40ft;
            return availB - availA;
        });
        
        data.allocations.forEach(allocation => {
            const option = document.createElement('option');
            option.value = allocation.id;
            
            // Show size-specific capacity
            let capacityText;
            let hasCapacity;
            
            if (is20ft) {
                capacityText = `${allocation.used_20ft}/${allocation.capacity_20ft} (20ft)`;
                hasCapacity = allocation.available_20ft > 0;
            } else {
                capacityText = `${allocation.used_40ft}/${allocation.capacity_40ft} (40ft+)`;
                hasCapacity = allocation.available_40ft > 0;
            }
            
            option.textContent = `${allocation.terminal.name} - ${capacityText}`;
            
            // Disable if insufficient capacity for this size
            if (!hasCapacity) {
                option.disabled = true;
                option.textContent += ' - Insufficient Capacity';
            }
            
            // Pre-select current allocation
            if (allocation.id === currentAllocationId) {
                option.selected = true;
            }
            
            select.appendChild(option);
        });
    } catch (error) {
        showCYReassignmentError('Error loading CY allocations: ' + error.message);
    }
}

async function reassignContainerCY() {
    const newAllocationId = document.getElementById('cyAllocationSelect').value;
    
    if (!newAllocationId) {
        showCYReassignmentError('Please select a CY location');
        return;
    }
    
    if (parseInt(newAllocationId) === currentAllocationId) {
        showCYReassignmentError('Please select a different CY location');
        return;
    }
    
    // Show spinner and disable buttons
    document.getElementById('cyReassignmentSpinner').classList.remove('hidden');
    document.getElementById('cyReassignButton').disabled = true;
    document.getElementById('cyCancelButton').disabled = true;
    document.getElementById('cyReassignmentError').classList.add('hidden');
    
    try {
        const response = await fetch(`/api/containers/${currentContainerId}/reallocate`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                new_allocation_id: parseInt(newAllocationId)
            })
        });
        
        const result = await response.json();
        
        if (response.ok && result.success) {
            // Show success message
            showSuccessMessage(`Container ${currentContainerNumber} successfully reassigned to new CY location`);
            closeCYReassignmentModal();
            
            // Reload page to show updated allocation
            setTimeout(() => {
                window.location.reload();
            }, 1500);
        } else {
            showCYReassignmentError(result.message || 'Error reassigning container');
            // Hide spinner and re-enable buttons
            document.getElementById('cyReassignmentSpinner').classList.add('hidden');
            document.getElementById('cyReassignButton').disabled = false;
            document.getElementById('cyCancelButton').disabled = false;
        }
    } catch (error) {
        showCYReassignmentError('Error reassigning container: ' + error.message);
        // Hide spinner and re-enable buttons
        document.getElementById('cyReassignmentSpinner').classList.add('hidden');
        document.getElementById('cyReassignButton').disabled = false;
        document.getElementById('cyCancelButton').disabled = false;
    }
}

function showCYReassignmentError(message) {
    const errorDiv = document.getElementById('cyReassignmentError');
    errorDiv.querySelector('span:last-child').textContent = message;
    errorDiv.classList.remove('hidden');
}

function showSuccessMessage(message) {
    // Create a toast notification
    const toast = document.createElement('div');
    toast.className = 'toast toast-top toast-end';
    toast.innerHTML = `
        <div class="alert alert-success">
            <span class="icon-[tabler--circle-check] size-5"></span>
            <span>${message}</span>
        </div>
    `;
    document.body.appendChild(toast);
    
    // Remove after 3 seconds
    setTimeout(() => {
        toast.remove();
    }, 3000);
}
</script>

