{% extends 'base.html.twig' %}

{% block title %}Manifest {{ manifest.manifestNumber }} - OPTIMUS{% endblock %}
{% block page_title %}{{ manifest.manifestNumber }}{% endblock %}

{% set noa = manifest.noa %}
{% set state = manifest.workflowState %}
{% set workflowComplete = manifest_workflow_is_complete(manifest) %}
{% set currentStep = manifest_workflow_current_step(manifest) %}

{% block body %}
<div class="max-w-7xl mx-auto w-full space-y-5 sm:space-y-6">

    {# Hero header — matches accounting dashboard pattern #}
    <div class="rounded-3xl border border-primary/20 bg-gradient-to-br from-primary/15 via-base-100 to-base-100 shadow-sm p-5 sm:p-7">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
            <div class="space-y-3 min-w-0">
                <div class="breadcrumbs text-xs">
                    <ul>
                        <li><a href="{{ path('app_broker_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right] size-3.5"></span></li>
                        <li><a href="{{ path('broker_manifest_list') }}">My Manifests</a></li>
                        <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right] size-3.5"></span></li>
                        <li aria-current="page">{{ manifest.manifestNumber }}</li>
                    </ul>
                </div>

                <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
                    <span class="icon-[tabler--file-text] size-3.5"></span>
                    Manifest Workflow
                </span>

                <div>
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-base-content leading-tight font-mono">
                            {{ manifest.manifestNumber }}
                        </h1>
                        {% if state.value == 'edo_released' %}
                            <span class="badge badge-success badge-lg gap-2">
                                <span class="icon-[tabler--circle-check] size-4"></span>
                                {{ state.getDisplayName() }}
                            </span>
                        {% elseif state.value in ['billing_generated', 'payment_submitted'] %}
                            <span class="badge badge-warning badge-lg">{{ state.getDisplayName() }}</span>
                        {% elseif state.value in ['bl_generated', 'bl_uploaded', 'edo_generated'] %}
                            <span class="badge badge-info badge-lg">{{ state.getDisplayName() }}</span>
                        {% elseif state.value == 'noa_generated' %}
                            <span class="badge badge-primary badge-lg">{{ state.getDisplayName() }}</span>
                        {% else %}
                            <span class="badge badge-ghost badge-lg">{{ state.getDisplayName() }}</span>
                        {% endif %}
                    </div>
                    <p class="mt-2 text-sm sm:text-base text-base-content/70 max-w-2xl">
                        {% if manifest.vesselName %}Vessel {{ manifest.vesselName }}{% if manifest.voyageNumber %} · Voyage {{ manifest.voyageNumber }}{% endif %}{% if manifest.consignee %} · {{ manifest.consignee.businessName }}{% endif %}
                        {% elseif manifest.consignee %}{{ manifest.consignee.businessName }}
                        {% else %}Manage workflow actions, documents, and payments for this manifest.{% endif %}
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    {% if workflowComplete %}
                        <span class="badge badge-success badge-soft badge-lg gap-2">
                            <span class="icon-[tabler--circle-check] size-4"></span>
                            Workflow complete
                        </span>
                    {% else %}
                        <span class="badge badge-primary badge-soft badge-lg gap-2">
                            <span class="icon-[tabler--list-numbers] size-4"></span>
                            Step {{ currentStep }} of {{ manifest_workflow_total_steps() }}
                        </span>
                    {% endif %}
                    {% if manifest.arrivalDate %}
                        <span class="badge badge-ghost badge-lg gap-2">
                            <span class="icon-[tabler--calendar] size-4"></span>
                            ETA {{ manifest.arrivalDate|date('M j, Y') }}
                        </span>
                    {% endif %}
                    {% if noa %}
                        <span class="badge badge-ghost badge-lg gap-2 font-mono">
                            <span class="icon-[tabler--file-certificate] size-4"></span>
                            {{ noa.noaNumber }}
                        </span>
                    {% endif %}
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 xl:justify-end shrink-0">
                <a href="{{ path('broker_manifest_documents', {id: manifest.id}) }}"
                   class="btn btn-outline btn-primary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--folder] size-4"></span>
                    All Documents
                </a>
                <a href="{{ path('broker_payment_history', {id: manifest.id}) }}"
                   class="btn btn-outline btn-primary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--history] size-4"></span>
                    Payments
                </a>
                <a href="{{ path('broker_manifest_list') }}"
                   class="btn btn-ghost btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back
                </a>
                <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}"
                   class="btn btn-ghost btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--refresh] size-4"></span>
                    Refresh
                </a>
            </div>
        </div>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm">
            <span class="icon-[tabler--circle-check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error shadow-sm">
            <span class="icon-[tabler--circle-x] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning shadow-sm">
            <span class="icon-[tabler--alert-triangle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="card card-border bg-base-100 shadow-sm">
        <nav class="tabs tabs-bordered card-header px-2 sm:px-4" aria-label="Manifest Tabs" role="tablist" aria-orientation="horizontal">
                <button type="button" 
                        class="tab active-tab:tab-active active w-full sm:w-auto" 
                        id="tab-details" 
                        data-tab="#content-details" 
                        aria-controls="content-details" 
                        role="tab" 
                        aria-selected="true">
                    <span class="icon-[tabler--file-text] size-4 mr-1.5"></span>
                    Details
                </button>
                <button type="button" 
                        class="tab active-tab:tab-active w-full sm:w-auto" 
                        id="tab-history" 
                        data-tab="#content-history" 
                        aria-controls="content-history" 
                        role="tab" 
                        aria-selected="false">
                    <span class="icon-[tabler--history] size-4 mr-1.5"></span>
                    Audit Trail
                </button>
            </nav>

        <div class="card-body p-4 sm:p-6">
            <!-- Tab Content -->
            <div>
                <!-- Details Tab -->
                <div id="content-details" role="tabpanel" aria-labelledby="tab-details">
                    <!-- 2 Column Grid Layout -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 items-start">
                        <!-- Left Column (2/3 width) - Main Content -->
                        <div class="lg:col-span-2 space-y-4 sm:space-y-6">
            
            <!-- Manifest Information -->
            <div class="card card-border bg-base-100 shadow-sm w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Manifest Information</h3>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Manifest Number</dt>
                            <dd class="mt-1 text-sm text-base-content font-mono">{{ manifest.manifestNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Created Date</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ manifest.createdAt|date('M j, Y g:i A') }}</dd>
                        </div>
                        {% if manifest.vesselName %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Vessel Name</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.vesselName }}</dd>
                            </div>
                        {% endif %}
                        {% if manifest.voyageNumber %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Voyage Number</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.voyageNumber }}</dd>
                            </div>
                        {% endif %}
                        {% if manifest.arrivalDate %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Arrival Date</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.arrivalDate|date('M j, Y g:i A') }}</dd>
                            </div>
                        {% endif %}
                        {% if manifest.blNumber %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">BL Number</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.blNumber }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </div>

            <!-- NOA Information -->
            {% if manifest.noa %}
            <div class="card card-border bg-base-100 shadow-sm w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">NOA Information</h3>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">NOA Number</dt>
                            <dd class="mt-1 text-sm text-base-content font-mono">{{ manifest.noa.noaNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Created Date</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ manifest.noa.createdAt|date('M j, Y g:i A') }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">BL Number</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ manifest.noa.blNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Vessel Number</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ manifest.noa.vesselNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">ETA</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ manifest.noa.eta|date('M j, Y g:i A') }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Port Location</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ manifest.noa.dischargeLocation }}</dd>
                        </div>
                    </dl>
                </div>
            </div>
            {% endif %}

            <!-- Consignee Information -->
            <div class="card card-border bg-base-100 shadow-sm w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Parties</h3>
                    <dl class="space-y-3 sm:space-y-4">
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Consignee</dt>
                            <dd class="mt-1">
                                {% if manifest.consignee %}
                                    <div class="text-sm text-base-content">{{ manifest.consignee.businessName }}</div>
                                {% else %}
                                    <span class="text-sm text-base-content/40">Not declared</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Broker</dt>
                            <dd class="mt-1">
                                {% if manifest.broker %}
                                    <div class="text-sm text-base-content">{{ manifest.broker.fullName }}</div>
                                {% else %}
                                    <span class="text-sm text-base-content/40">None</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Containers & eDO Payment Status -->
            <div class="card card-border bg-base-100 shadow-sm w-full">
                <div class="card-body p-4 sm:p-6">

                    {# Calculate eDO generation progress #}
                    {% set totalContainers = manifest.noa ? manifest.noa.containers|length : 0 %}
                    {% set containersWithEdo = 0 %}
                    {% set paidEdos = 0 %}
                    {% if manifest.noa %}
                        {% for container in manifest.noa.containers %}
                        {% set paymentStatus = containerPaymentStatus[container.id] ?? null %}
                        {% if paymentStatus and paymentStatus.has_edo %}
                            {% set containersWithEdo = containersWithEdo + 1 %}
                            {% if paymentStatus.payment_status == 'verified' %}
                                {% set paidEdos = paidEdos + 1 %}
                            {% endif %}
                        {% endif %}
                        {% endfor %}
                    {% endif %}
                    {% set allEdosGenerated = containersWithEdo == totalContainers and totalContainers > 0 %}
                    {% set allEdosPaid = paidEdos == containersWithEdo and containersWithEdo > 0 %}
                    {% set edoProgress = totalContainers > 0 ? (containersWithEdo / totalContainers * 100)|round : 0 %}

                    {# Header #}
                    <div class="flex items-center justify-between mb-5">
                        <div class="flex items-center gap-3">
                            <span class="icon-[tabler--container] size-5 text-primary"></span>
                            <h3 class="card-title text-base sm:text-lg text-base-content">Containers & eDO Payment Status</h3>
                        </div>
                        <div class="flex items-center gap-3">
                            {# Payment Progress Badge #}
                            {% if allEdosPaid %}
                                <div class="badge badge-success gap-1.5 font-semibold">
                                    <span class="icon-[tabler--circle-check] size-4"></span>
                                    All Paid
                                </div>
                            {% elseif paidEdos > 0 %}
                                <div class="badge badge-warning gap-1.5 font-semibold">
                                    <span class="icon-[tabler--clock] size-4"></span>
                                    {{ paidEdos }}/{{ containersWithEdo }} Paid
                                </div>
                            {% endif %}
                            
                            {# eDO Generation Progress Badge #}
                            {% if allEdosGenerated %}
                                <div class="badge badge-success gap-1.5 font-semibold">
                                    <span class="icon-[tabler--circle-check] size-4"></span>
                                    All eDOs Generated
                                </div>
                            {% else %}
                                <div class="badge badge-primary badge-outline font-semibold">
                                    {{ containersWithEdo }}/{{ totalContainers }} eDOs
                                </div>
                            {% endif %}
                            
                            <div class="badge badge-ghost font-semibold">
                                {{ totalContainers }} container{{ totalContainers != 1 ? 's' : '' }}
                            </div>
                        </div>
                    </div>

                    {# Progress Bar - Only show if not all eDOs generated #}
                    {% if not allEdosGenerated and totalContainers > 0 %}
                        <div class="mb-4">
                            <div class="flex items-center justify-between text-xs text-base-content/60 mb-1">
                                <span>eDO Generation Progress</span>
                                <span class="font-semibold">{{ edoProgress }}%</span>
                            </div>
                            <div class="w-full bg-base-300 rounded-full h-2">
                                <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{ edoProgress }}%"></div>
                            </div>
                        </div>
                    {% endif %}

                    {% if manifest.noa and manifest.noa.containers|length > 0 %}
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {% for container in manifest.noa.containers %}
                        {% set paymentStatus = containerPaymentStatus[container.id] ?? null %}

                        {# Determine accent color by payment status #}
                        {% if paymentStatus and paymentStatus.has_edo %}
                            {% if paymentStatus.payment_status == 'verified' %}
                                {% set accentColor = 'border-success' %}
                            {% elseif paymentStatus.payment_status == 'pending_validation' %}
                                {% set accentColor = 'border-warning' %}
                            {% elseif paymentStatus.payment_status == 'rejected' %}
                                {% set accentColor = 'border-error' %}
                            {% else %}
                                {% set accentColor = 'border-info' %}
                            {% endif %}
                        {% else %}
                            {% set accentColor = 'border-base-300' %}
                        {% endif %}

                        <div class="rounded-xl border border-base-300 border-l-4 {{ accentColor }} bg-base-50 hover:bg-base-200/50 transition-colors">
                            <div class="p-4">
                                {# Top row: container number + status badge #}
                                <div class="mb-3">
                                    <div class="flex items-center justify-between gap-2 mb-2">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="icon-[tabler--container] size-4 text-base-content/50 flex-shrink-0"></span>
                                            <span class="font-mono font-semibold text-sm text-base-content truncate">{{ container.containerNumber }}</span>
                                        </div>
                                        {# Payment status badge #}
                                        {% if paymentStatus and paymentStatus.has_edo %}
                                            {% if paymentStatus.payment_status == 'verified' %}
                                                <span class="badge badge-success badge-sm gap-1">
                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                    PAID
                                                </span>
                                            {% elseif paymentStatus.payment_status == 'pending_validation' %}
                                                <span class="badge badge-warning badge-sm gap-1">
                                                    <span class="icon-[tabler--clock] size-3"></span>
                                                    Pending
                                                </span>
                                            {% elseif paymentStatus.payment_status == 'rejected' %}
                                                <span class="badge badge-error badge-sm gap-1">
                                                    <span class="icon-[tabler--x] size-3"></span>
                                                    Rejected
                                                </span>
                                            {% else %}
                                                <span class="badge badge-ghost badge-sm gap-1">
                                                    <span class="icon-[tabler--alert-circle] size-3"></span>
                                                    Unpaid
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge badge-ghost badge-sm gap-1">
                                                <span class="icon-[tabler--file-off] size-3"></span>
                                                No eDO
                                            </span>
                                        {% endif %}
                                    </div>

                                    {# eDO Number if available #}
                                    {% if paymentStatus and paymentStatus.has_edo %}
                                        <div class="text-xs text-base-content/60">
                                            eDO: <span class="font-mono text-base-content">{{ paymentStatus.edo_number }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                {# Container Info - Simplified #}
                                <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs mb-3">
                                    <div>
                                        <span class="text-base-content/50 uppercase tracking-wide text-[10px]">Size/Type</span>
                                        <div class="text-base-content font-medium">
                                            {{ container.containerSize ? container.containerSize.name : '—' }} / 
                                            {{ container.containerType ? container.containerType.name : '—' }}
                                        </div>
                                    </div>
                                    <div>
                                        <span class="text-base-content/50 uppercase tracking-wide text-[10px]">CY Location</span>
                                        <div class="text-base-content font-medium">
                                            {{ container.cyAllocation ? container.cyAllocation.containerYard.name : '—' }}
                                        </div>
                                    </div>
                                </div>

                                {# Action Buttons - Prominent for brokers #}
                                {% if paymentStatus and paymentStatus.has_edo %}
                                    <div class="flex flex-wrap gap-2 pt-3 border-t border-base-300/60">
                                        {% if paymentStatus.payment_status == 'verified' %}
                                            {# Paid - Show download button #}
                                            <a href="{{ path('broker_edo_download', {id: paymentStatus.edo_id}) }}"
                                               class="btn btn-sm btn-success gap-2 flex-1">
                                                <span class="icon-[tabler--download] size-4"></span>
                                                Download eDO
                                            </a>
                                            {% if paymentStatus.official_receipt_path and paymentStatus.edo_id %}
                                                <a href="{{ path('broker_edo_official_receipt', {edoId: paymentStatus.edo_id}) }}"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline btn-success gap-2">
                                                    <span class="icon-[tabler--file-text] size-4"></span>
                                                    Receipt
                                                </a>
                                            {% endif %}
                                        {% elseif paymentStatus.payment_status == 'pending_validation' %}
                                            {# Pending - Show status #}
                                            <div class="alert alert-warning py-2 px-3 text-xs flex-1">
                                                <span class="icon-[tabler--clock] size-4"></span>
                                                <span>Payment under review by accounting</span>
                                            </div>
                                        {% elseif paymentStatus.payment_status == 'rejected' %}
                                            {# Rejected - Show resubmit button #}
                                            <a href="{{ path('broker_manifest_edo_payment_specific', {id: manifest.id, edoNumber: paymentStatus.edo_number}) }}" 
                                               class="btn btn-sm btn-error gap-2 flex-1">
                                                <span class="icon-[tabler--upload] size-4"></span>
                                                Resubmit Payment
                                            </a>
                                        {% else %}
                                            {# Unpaid - Show pay now button #}
                                            <a href="{{ path('broker_manifest_edo_payment_specific', {id: manifest.id, edoNumber: paymentStatus.edo_number}) }}" 
                                               class="btn btn-sm btn-primary gap-2 flex-1">
                                                <span class="icon-[tabler--credit-card] size-4"></span>
                                                Pay Now
                                            </a>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    {# No eDO yet #}
                                    <div class="pt-3 border-t border-base-300/60">
                                        <div class="alert alert-info py-2 px-3 text-xs">
                                            <span class="icon-[tabler--info-circle] size-4"></span>
                                            <span>eDO not yet generated by shipping line</span>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        {% endfor %}
                        </div>

                        {# Info note - Dynamic based on completion status #}
                        {% if allEdosPaid %}
                            <div class="flex items-start gap-3 mt-4 p-3 rounded-lg bg-success/10 border border-success/20 text-xs text-success">
                                <span class="icon-[tabler--circle-check] size-4 flex-shrink-0 mt-0.5"></span>
                                <div>
                                    <span class="font-semibold">All Payments Verified!</span> —
                                    All {{ containersWithEdo }} eDO{{ containersWithEdo != 1 ? 's have' : ' has' }} been paid and verified. You can now download your eDOs.
                                </div>
                            </div>
                        {% elseif containersWithEdo > 0 %}
                            <div class="flex items-start gap-3 mt-4 p-3 rounded-lg bg-info/10 border border-info/20 text-xs text-info">
                                <span class="icon-[tabler--info-circle] size-4 flex-shrink-0 mt-0.5"></span>
                                <div>
                                    <span class="font-semibold">eDO Payment Required</span> —
                                    {{ containersWithEdo }} eDO{{ containersWithEdo != 1 ? 's are' : ' is' }} available. 
                                    {% if paidEdos > 0 %}
                                        {{ paidEdos }} paid, {{ containersWithEdo - paidEdos }} pending payment.
                                    {% else %}
                                        Click "Pay Now" to submit payment for each eDO.
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <div class="flex items-start gap-3 mt-4 p-3 rounded-lg bg-base-200/50 border border-base-300 text-xs text-base-content/60">
                                <span class="icon-[tabler--clock] size-4 flex-shrink-0 mt-0.5"></span>
                                <div>
                                    <span class="font-semibold">Waiting for eDO Generation</span> —
                                    Shipping line will generate eDOs after final payment verification. You'll be notified when eDOs are ready.
                                </div>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="flex flex-col items-center justify-center py-10 text-base-content/40 gap-2">
                            <span class="icon-[tabler--container-off] size-10"></span>
                            <p class="text-sm">No containers found</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Available Documents -->
            <div class="card card-border bg-base-100 shadow-sm w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Available Documents</h3>
                    <div class="space-y-2 sm:space-y-3">
                        {% set latestFinalPayment = null %}
                        {% set verifiedFinalPayment = null %}
                        {% for payment in manifest.payments %}
                            {% if payment.paymentType.value == 'final_payment' %}
                                {% set latestFinalPayment = payment %}
                                {% if payment.status.value == 'verified' %}
                                    {% set verifiedFinalPayment = payment %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}

                        {# Notice of Arrival (NOA) PDF #}
                        {% if (noa and noa.pdfPath) or (manifest.noaDocument and manifest.noaDocument.pdfPath) %}
                            <div class="flex items-center justify-between p-3 bg-primary/10 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 bg-primary rounded-lg flex items-center justify-center mr-2 sm:mr-3">
                                        <span class="icon-[tabler--file-text] size-5 sm:size-6 text-primary-content"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Notice of Arrival (NOA)</div>
                                            <span class="icon-[tabler--circle-check] size-4 text-success ml-1 flex-shrink-0"></span>
                                        </div>
                                        <div class="text-xs text-base-content/60 truncate">{{ noa ? noa.noaNumber : manifest.noaDocument.noaNumber }}</div>
                                    </div>
                                </div>
                                <a href="{{ path('broker_manifest_noa_download', {id: manifest.id}) }}"
                                   target="_blank"
                                   class="btn btn-primary btn-sm btn-soft gap-1 shrink-0 ml-2">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Manifest/BL Document #}
                        {% if noa and (noa.manifestPdfPath or manifest.manifestFilePath) %}
                            <div class="flex items-center justify-between p-3 bg-info/10 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 bg-info rounded-lg flex items-center justify-center mr-2 sm:mr-3">
                                        <span class="icon-[tabler--file-text] size-5 sm:size-6 text-info-content"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Manifest/BL Document</div>
                                            <span class="icon-[tabler--circle-check] size-4 text-success ml-1 flex-shrink-0"></span>
                                        </div>
                                        <div class="text-xs text-base-content/60 truncate">{{ manifest.manifestNumber }}</div>
                                    </div>
                                </div>
                                <a href="{{ path('broker_manifest_bl_download', {id: manifest.id}) }}"
                                   target="_blank"
                                   class="btn btn-info btn-sm btn-soft gap-1 shrink-0 ml-2">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Bill of Lading - Show if BL exists #}
                        {% if manifest and manifest.blNumber and manifest.blFilePath %}
                            <div class="flex items-center justify-between p-3 bg-base-200 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <span class="icon-[tabler--file-description] size-6 sm:size-8 text-info mr-2 sm:mr-3 flex-shrink-0"></span>
                                    <div class="min-w-0">
                                        <div class="text-xs sm:text-sm font-medium text-base-content truncate">Bill of Lading</div>
                                        <div class="text-xs text-base-content/60 truncate">{{ manifest.blNumber }}</div>
                                    </div>
                                </div>
                                <a href="{{ path('broker_manifest_bl_file_download', {id: manifest.id}) }}"
                                   class="btn btn-info btn-sm btn-soft gap-1 shrink-0 ml-2">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Billing Document - Show if billing exists #}
                        {% if manifest and manifest.billing %}
                            <div class="flex items-center justify-between p-3 bg-base-200 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <span class="icon-[tabler--receipt] size-6 sm:size-8 text-warning mr-2 sm:mr-3 flex-shrink-0"></span>
                                    <div class="min-w-0">
                                        <div class="text-xs sm:text-sm font-medium text-base-content truncate">Billing Document</div>
                                        <div class="text-xs text-base-content/60 truncate">Total: {{ manifest.billing|format_billing }}</div>
                                    </div>
                                </div>
                                <a href="{{ path('broker_manifest_billing_download', {id: manifest.id}) }}"
                                   class="btn btn-warning btn-sm btn-soft gap-1 shrink-0 ml-2">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Payment Receipt — broker-submitted final payment #}
                        {% if latestFinalPayment and latestFinalPayment.receiptFilePath %}
                            <div class="flex items-center justify-between p-3 bg-success/10 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 bg-success rounded-lg flex items-center justify-center mr-2 sm:mr-3">
                                        <span class="icon-[tabler--receipt] size-5 sm:size-6 text-success-content"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Payment Receipt</div>
                                            {% if latestFinalPayment.status.value == 'verified' %}
                                                <span class="badge badge-success badge-xs">Verified</span>
                                            {% elseif latestFinalPayment.status.value == 'rejected' %}
                                                <span class="badge badge-error badge-xs">Rejected</span>
                                            {% else %}
                                                <span class="badge badge-warning badge-xs">Pending</span>
                                            {% endif %}
                                        </div>
                                        <div class="text-xs text-base-content/60 truncate">
                                            v{{ latestFinalPayment.version }} · {{ latestFinalPayment|format_payment }}
                                        </div>
                                    </div>
                                </div>
                                <a href="{{ path('broker_payment_receipt', {id: latestFinalPayment.id}) }}?inline=false"
                                   class="btn btn-success btn-sm btn-soft gap-1 shrink-0 ml-2">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Official Receipt — issued after verification #}
                        {% if verifiedFinalPayment and verifiedFinalPayment.officialReceiptPath %}
                            <div class="flex items-center justify-between p-3 bg-base-200 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <span class="icon-[tabler--file-certificate] size-6 sm:size-8 text-success mr-2 sm:mr-3 flex-shrink-0"></span>
                                    <div class="min-w-0">
                                        <div class="text-xs sm:text-sm font-medium text-base-content truncate">Official Receipt</div>
                                        <div class="text-xs text-base-content/60 truncate">Payment verified — OR issued</div>
                                    </div>
                                </div>
                                <a href="{{ path('broker_payment_receipt', {id: verifiedFinalPayment.id, type: 'official'}) }}?inline=false"
                                   class="btn btn-success btn-sm btn-soft gap-1 shrink-0 ml-2">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {% if not ((noa and noa.pdfPath) or (manifest.noaDocument and manifest.noaDocument.pdfPath)) and not (noa and (noa.manifestPdfPath or manifest.manifestFilePath)) and not (manifest.blNumber and manifest.blFilePath) and not manifest.billing and not (latestFinalPayment and latestFinalPayment.receiptFilePath) and not (verifiedFinalPayment and verifiedFinalPayment.officialReceiptPath) %}
                            <p class="text-sm text-base-content/60">No documents available yet</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Payment History -->
            {% if manifest %}
            <div class="card card-border bg-base-100 shadow-sm w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Payment History</h3>
                    {% set hasFinalPayment = false %}
                    {% for payment in manifest.payments %}
                        {% if payment.paymentType.value == 'final_payment' %}
                            {% set hasFinalPayment = true %}
                        {% endif %}
                    {% endfor %}
                    
                    {% if hasFinalPayment %}
                        <div class="space-y-3">
                            {# Final Payment #}
                            {% for payment in manifest.payments %}
                                {% if payment.paymentType.value == 'final_payment' %}
                                    <div class="card bg-base-200 shadow-sm">
                                        <div class="card-body p-4">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-sm font-medium text-base-content">Final Payment</span>
                                                {% if payment.status.value == 'verified' %}
                                                    <span class="badge badge-success">Verified</span>
                                                {% elseif payment.status.value == 'rejected' %}
                                                    <span class="badge badge-error">Rejected</span>
                                                {% else %}
                                                    <span class="badge badge-warning">Pending</span>
                                                {% endif %}
                                            </div>
                                            <div class="text-sm text-base-content/80">
                                                Amount: {{ payment|format_payment }}
                                            </div>
                                            <div class="text-xs text-base-content/60 mt-1">
                                                Submitted: {{ payment.createdAt|date('M j, Y g:i A') }}
                                            </div>
                                            {% if payment.status.value == 'rejected' and payment.rejectionReason %}
                                                <div class="alert alert-error mt-2">
                                                    <span class="icon-[tabler--alert-circle] size-4"></span>
                                                    <span class="text-xs">Reason: {{ payment.rejectionReason }}</span>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                            
                            {# eDO Access Payment - Check container payment status #}
                            {% set hasEdoPayment = false %}
                            {% set edoPaymentData = null %}
                            {% for containerId, paymentStatus in containerPaymentStatus %}
                                {% if paymentStatus.has_payment %}
                                    {% set hasEdoPayment = true %}
                                    {% set edoPaymentData = paymentStatus %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if hasEdoPayment and edoPaymentData %}
                                <div class="card bg-base-200 shadow-sm">
                                    <div class="card-body p-4">
                                        <div class="flex items-center justify-between mb-2">
                                            <span class="text-sm font-medium text-base-content">eDO Access Payment</span>
                                            {% if edoPaymentData.payment_status == 'verified' %}
                                                <span class="badge badge-success">Paid</span>
                                            {% elseif edoPaymentData.payment_status == 'rejected' %}
                                                <span class="badge badge-error">Rejected</span>
                                            {% else %}
                                                <span class="badge badge-warning">Pending Validation</span>
                                            {% endif %}
                                        </div>
                                        <div class="text-sm text-base-content/80">
                                            Amount: {{ edoPaymentData.payment_amount|format_money('PHP') }}
                                        </div>
                                        <div class="text-xs text-base-content/60 mt-1">
                                            Submitted: {{ edoPaymentData.payment_verified_at ? edoPaymentData.payment_verified_at|date('M j, Y g:i A') : 'N/A' }}
                                        </div>
                                        {% if edoPaymentData.payment_status == 'verified' and edoPaymentData.payment_verified_at %}
                                            <div class="text-xs text-base-content/60 mt-1">
                                                Validated: {{ edoPaymentData.payment_verified_at|date('M j, Y g:i A') }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="text-sm text-base-content/60">No payments submitted yet</p>
                    {% endif %}
                </div>
            </div>
            {% endif %}
                        </div>
                        <!-- End Left Column -->

                        <!-- Right Column (1/3 width) - Quick Actions -->
                        <div class="lg:col-span-1">
                            <div class="card card-border bg-base-100 shadow-sm sticky top-24 w-full">
                                <div class="card-body p-4 sm:p-6">
                                    <h3 class="card-title text-base sm:text-lg mb-3 sm:mb-4 text-base-content">Quick Actions</h3>
                                    <div class="space-y-2 sm:space-y-3 w-full">
                                        {% if manifest %}
                                            {# Check for rejected final payment and get latest payment version #}
                                            {% set finalPaymentRejected = false %}
                                            {% set latestFinalPayment = null %}
                                            {% for payment in manifest.payments %}
                                                {% if payment.paymentType.value == 'final_payment' %}
                                                    {% if latestFinalPayment is null or payment.version > latestFinalPayment.version %}
                                                        {% set latestFinalPayment = payment %}
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                            
                                            {# Set finalPaymentRejected based on LATEST payment status #}
                                            {% if latestFinalPayment and latestFinalPayment.status.value == 'rejected' %}
                                                {% set finalPaymentRejected = true %}
                                            {% endif %}
                                            
                                            {# Payment Version Badge - Show if payment exists #}
                                            {% if latestFinalPayment %}
                                                <div class="alert {% if latestFinalPayment.status.value == 'verified' %}alert-success{% elseif latestFinalPayment.status.value == 'rejected' %}alert-error{% else %}alert-warning{% endif %} py-2 px-3">
                                                    <div class="flex items-center justify-between w-full">
                                                        <div class="flex items-center gap-2">
                                                            <span class="icon-[tabler--receipt] size-4"></span>
                                                            <span class="text-sm font-medium">Final Payment</span>
                                                        </div>
                                                        {% include 'components/payment_version_badge.html.twig' with {
                                                            version: latestFinalPayment.version,
                                                            status: latestFinalPayment.status.value,
                                                            submittedAt: latestFinalPayment.createdAt,
                                                            size: 'sm'
                                                        } %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                            
                                            {# Resubmit Payment Button - Show when payment is rejected AND not verified #}
                                            {% if finalPaymentRejected and latestFinalPayment and latestFinalPayment.status.value != 'verified' %}
                                                <a href="{{ path('broker_manifest_final_payment', {id: manifest.id}) }}" 
                                                   class="btn btn-error w-full text-sm sm:text-base gap-2">
                                                    <span class="icon-[tabler--upload] size-4"></span>
                                                    Resubmit Payment
                                                </a>
                                            {% endif %}
                                            
                                            {# Submit Payment Button - Show when billing is generated #}
                                            {% if manifest.workflowState.value == 'billing_generated' and not finalPaymentRejected %}
                                                <a href="{{ path('broker_manifest_final_payment', {id: manifest.id}) }}" 
                                                   class="btn btn-primary w-full text-sm sm:text-base gap-2">
                                                    <span class="icon-[tabler--credit-card] size-4"></span>
                                                    Submit Payment
                                                </a>
                                            {% endif %}
                                            
                                            {% if manifest.workflowState.value == 'noa_generated' %}
                                                <a href="{{ path('manifest_workflow_generate_manifest_form', {id: manifest.noa.id}) }}" 
                                                   class="btn btn-success w-full text-sm sm:text-base">
                                                    Generate Manifest/BL
                                                </a>
                                            {% endif %}
                                            
                                            {# BL Upload Button - Show when NOA generated or BL generated (but not uploaded yet) #}
                                            {% if manifest.workflowState.value in ['noa_generated', 'bl_generated'] and not manifest.blFilePath %}
                                                <a href="{{ path('broker_manifest_upload_bl', {id: manifest.id}) }}" 
                                                   class="btn btn-primary w-full text-sm sm:text-base gap-2">
                                                    <span class="icon-[tabler--file-upload] size-4"></span>
                                                    Upload BL Document
                                                </a>
                                            {% endif %}
                                            
                                            {# eDO Generation Button - Show when payment is verified #}
                                            {% set finalPaymentVerified = false %}
                                            {% for payment in manifest.payments %}
                                                {% if payment.paymentType.value == 'final_payment' and payment.status.value == 'verified' %}
                                                    {% set finalPaymentVerified = true %}
                                                {% endif %}
                                            {% endfor %}
                                            
                                            {% if finalPaymentVerified and manifest.workflowState.value in ['payment_verified', 'edo_generated', 'edo_released'] %}
                                                <button type="button" 
                                                        onclick="openEDOGenerationModal()"
                                                        class="btn btn-info w-full text-sm sm:text-base">
                                                    <span class="icon-[tabler--file-certificate] size-4 mr-2"></span>
                                                    Generate eDOs
                                                </button>
                                            {% endif %}
                                        {% else %}
                                            <a href="{{ path('manifest_workflow_generate_manifest_form', {id: manifest.noa.id}) }}" 
                                               class="btn btn-success w-full text-sm sm:text-base">
                                                Generate Manifest/BL
                                            </a>
                                        {% endif %}
                                        
                                        {# View Payment History Link - Show if payment exists #}
                                        {% if latestFinalPayment %}
                                            <a href="{{ path('broker_payment_history', {id: manifest.id}) }}" 
                                               class="btn btn-outline btn-primary w-full text-sm sm:text-base gap-2">
                                                <span class="icon-[tabler--history] size-4"></span>
                                                View Payment History
                                            </a>
                                        {% endif %}
                                        
                                        <a href="{{ path('broker_manifest_list') }}" 
                                           class="btn btn-outline w-full text-sm sm:text-base">
                                            <span class="icon-[tabler--arrow-left] size-4 mr-2"></span>
                                            Back to Manifests
                                        </a>
                                    </div>

                                    <!-- Workflow Timeline -->
                                    <div class="mt-6 pt-6 border-t border-base-content/10">
                                        <div class="flex items-center justify-between mb-4">
                                            <h4 class="text-sm font-medium text-base-content">Workflow Timeline</h4>
                                            {% if manifest_workflow_is_complete(manifest) %}
                                                <span class="badge badge-success badge-sm gap-1">
                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                    Complete
                                                </span>
                                            {% else %}
                                                {% set currentStep = manifest_workflow_current_step(manifest) %}
                                                <span class="text-xs text-base-content/40">{{ currentStep }}/{{ manifest_workflow_total_steps() }}</span>
                                            {% endif %}
                                        </div>
                                        
                                        {% set currentStep = manifest_workflow_current_step(manifest) %}
                                        
                                        <ul class="timeline timeline-vertical timeline-compact">
                                            <!-- Step 1: NOA Created -->
                                            <li>
                                                <hr class="{% if currentStep >= 1 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 1 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 1 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">NOA Created</div>
                                                    <div class="text-xs text-base-content/60">{{ noa.createdAt|date('M j, Y') }}</div>
                                                </div>
                                                <hr class="{% if currentStep > 1 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 2: BL Generated -->
                                            <li>
                                                <hr class="{% if currentStep > 1 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 2 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 2 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">BL Generated</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 2 and manifest %}{{ manifest.createdAt|date('M j, Y') }}{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 2 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 3: BL Uploaded -->
                                            <li>
                                                <hr class="{% if currentStep > 2 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 3 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 3 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">BL Uploaded</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 3 and manifest and manifest.blNumber %}{{ manifest.updatedAt|date('M j, Y') }}{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 3 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 4: Billing Generated -->
                                            <li>
                                                <hr class="{% if currentStep > 3 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 4 %}bg-warning/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 4 %}badge-warning{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">Billing Generated</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 4 and manifest and manifest.billing %}{{ manifest.billing.createdAt|date('M j, Y') }}{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 4 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 5: Submit Payment -->
                                            <li>
                                                <hr class="{% if currentStep > 4 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    {% set paymentRejected = false %}
                                                    {% if manifest %}
                                                        {% for p in manifest.payments %}
                                                            {% if p.paymentType.value == 'final_payment' and p.status.value == 'rejected' %}
                                                                {% set paymentRejected = true %}
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% endif %}
                                                    <span class="{% if currentStep >= 5 %}bg-secondary/20{% elseif paymentRejected %}bg-error/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 5 %}badge-secondary{% elseif paymentRejected %}badge-error{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">Submit Payment</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if manifest and manifest.workflowState.value == 'payment_submitted' %}
                                                            Submitted · awaiting validation
                                                        {% elseif currentStep >= 6 %}
                                                            Submitted
                                                        {% elseif paymentRejected %}
                                                            <span class="text-error">Rejected — resubmit required</span>
                                                        {% else %}
                                                            Pending
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 5 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 6: Validate Payment -->
                                            <li>
                                                <hr class="{% if currentStep > 5 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 6 %}bg-accent/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 6 %}badge-accent{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">Validate Payment</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 6 and manifest %}
                                                            {% set verifiedPayment = null %}
                                                            {% for p in manifest.payments %}
                                                                {% if p.paymentType.value == 'final_payment' and p.status.value == 'verified' %}
                                                                    {% set verifiedPayment = p %}
                                                                {% endif %}
                                                            {% endfor %}
                                                            {% if verifiedPayment and verifiedPayment.validatedAt %}{{ verifiedPayment.validatedAt|date('M j, Y') }}{% else %}Verified{% endif %}
                                                        {% else %}
                                                            Pending
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 6 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 7: eDO Generated -->
                                            <li>
                                                <hr class="{% if currentStep > 6 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 7 %}bg-info/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 7 %}badge-info{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">eDO Generated</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 7 and manifest and manifest.edos is not empty and manifest.edos|first.createdAt is defined %}
                                                            {{ manifest.edos|first.createdAt|date('M j, Y') }}
                                                        {% elseif currentStep >= 7 %}
                                                            Completed
                                                        {% else %}
                                                            Pending
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 7 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 8: eDO Released -->
                                            <li>
                                                <hr class="{% if currentStep > 7 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 8 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 8 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">eDO Released</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 8 and manifest and manifest.completedAt %}{{ manifest.completedAt|date('M j, Y') }}{% elseif currentStep >= 8 %}Completed{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr />
                                            </li>
                                        </ul>

                                        {% if manifest_workflow_is_complete(manifest) %}
                                            <div class="mt-4 flex items-center gap-2 p-3 rounded-lg bg-success/10 border border-success/20">
                                                <span class="icon-[tabler--rosette-discount-check] size-5 text-success flex-shrink-0"></span>
                                                <div>
                                                    <div class="text-xs font-semibold text-success">Workflow Complete</div>
                                                    <div class="text-xs text-base-content/50">All steps have been successfully completed.</div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <!-- Summary Stats -->
                                    <div class="mt-6 pt-6 border-t border-base-content/10">
                                        <h4 class="text-sm font-medium text-base-content mb-3">Summary</h4>
                                        <dl class="space-y-2">
                                            <div class="flex justify-between">
                                                <dt class="text-sm text-base-content/60">Total Containers</dt>
                                                <dd class="text-sm font-medium text-base-content">
                                                    {% if manifest.noa and manifest.noa.containers %}
                                                        {{ manifest.noa.containers|length }}
                                                    {% else %}
                                                        0
                                                    {% endif %}
                                                </dd>
                                            </div>
                                            <div class="flex justify-between">
                                                <dt class="text-sm text-base-content/60">Total TEU</dt>
                                                <dd class="text-sm font-medium text-base-content">
                                                    {% set totalTeu = 0 %}
                                                    {% if manifest.noa and manifest.noa.containers %}
                                                        {% for container in manifest.noa.containers %}
                                                            {% set totalTeu = totalTeu + container.containerSize.teuValue %}
                                                        {% endfor %}
                                                    {% endif %}
                                                    {{ totalTeu }}
                                                </dd>
                                            </div>
                                        </dl>
                                    </div>

                                    <!-- Status Info -->
                                    <div class="mt-6 pt-6 border-t border-base-content/10">
                                        <div class="alert alert-info">
                                            <span class="icon-[tabler--info-circle] size-5"></span>
                                            <div>
                                                <h3 class="text-sm font-medium text-base-content">NOA Created</h3>
                                                <p class="mt-1 text-xs">This NOA has been successfully created. Next step: Generate Manifest/BL.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- End Right Column -->
                    </div>
                    <!-- End 2 Column Grid -->
                    </div>
                    <!-- End Details Tab -->

                <!-- History/Audit Trail Tab -->
                <div id="content-history" class="hidden" role="tabpanel" aria-labelledby="tab-history">
                    <div class="space-y-5 sm:space-y-6">
                        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
                            <div>
                                <h2 class="text-base sm:text-lg font-semibold flex items-center gap-2">
                                    <span class="icon-[tabler--history] size-5 text-primary"></span>
                                    Audit trail
                                </h2>
                                <p class="text-sm text-base-content/60 mt-1">Chronological record of actions on this manifest and related entities.</p>
                            </div>
                            {% if auditLogs|length > 0 %}
                                <span class="badge badge-primary badge-soft badge-lg gap-2 self-start sm:self-auto">
                                    <span class="icon-[tabler--list-details] size-4"></span>
                                    {{ auditLogs|length }} event{{ auditLogs|length != 1 ? 's' : '' }}
                                </span>
                            {% endif %}
                        </div>

                        {% if auditLogs|length > 0 %}
                            <div class="space-y-6">
                                {% set currentDate = null %}
                                {% for log in auditLogs %}
                                    {% set logDate = log.timestamp|date('l, F j, Y') %}
                                    {% set action = log.action|upper %}

                                    {% if action in ['PAYMENT_VERIFIED', 'PAYMENT_APPROVED', 'EDO_RELEASED', 'CONTAINER_RELEASED'] %}
                                        {% set auditIcon = 'icon-[tabler--circle-check]' %}
                                        {% set auditIconClass = 'bg-success/15 text-success border-success/25' %}
                                        {% set auditBadgeClass = 'badge-success' %}
                                    {% elseif action in ['PAYMENT_REJECTED', 'NOA_DELETED'] %}
                                        {% set auditIcon = 'icon-[tabler--circle-x]' %}
                                        {% set auditIconClass = 'bg-error/15 text-error border-error/25' %}
                                        {% set auditBadgeClass = 'badge-error' %}
                                    {% elseif action in ['PAYMENT_SUBMITTED', 'PAYMENT_CREATED'] %}
                                        {% set auditIcon = 'icon-[tabler--cash]' %}
                                        {% set auditIconClass = 'bg-warning/15 text-warning border-warning/25' %}
                                        {% set auditBadgeClass = 'badge-warning' %}
                                    {% elseif action in ['EDO_GENERATED', 'EDO_CREATED', 'MANIFEST_CREATED', 'MANIFEST_GENERATED', 'NOA_CREATED'] %}
                                        {% set auditIcon = 'icon-[tabler--file-plus]' %}
                                        {% set auditIconClass = 'bg-info/15 text-info border-info/25' %}
                                        {% set auditBadgeClass = 'badge-info' %}
                                    {% elseif action in ['EDO_ACCESSED', 'EDO_DOWNLOADED'] %}
                                        {% set auditIcon = 'icon-[tabler--download]' %}
                                        {% set auditIconClass = 'bg-primary/15 text-primary border-primary/25' %}
                                        {% set auditBadgeClass = 'badge-primary' %}
                                    {% elseif action in ['CONTAINER_ALLOCATED', 'CONTAINER_ASSIGNED', 'CONTAINER_UPDATED'] %}
                                        {% set auditIcon = 'icon-[tabler--container]' %}
                                        {% set auditIconClass = 'bg-info/15 text-info border-info/25' %}
                                        {% set auditBadgeClass = 'badge-info' %}
                                    {% elseif action in ['NOA_UPDATED', 'MANIFEST_UPDATED'] %}
                                        {% set auditIcon = 'icon-[tabler--edit]' %}
                                        {% set auditIconClass = 'bg-base-200 text-base-content/70 border-base-300/60' %}
                                        {% set auditBadgeClass = 'badge-ghost' %}
                                    {% elseif action == 'BROKER_ASSIGNED' or log.action == 'broker_assigned' %}
                                        {% set auditIcon = 'icon-[tabler--user-check]' %}
                                        {% set auditIconClass = 'bg-primary/15 text-primary border-primary/25' %}
                                        {% set auditBadgeClass = 'badge-primary' %}
                                    {% else %}
                                        {% set auditIcon = 'icon-[tabler--activity]' %}
                                        {% set auditIconClass = 'bg-base-200 text-base-content/70 border-base-300/60' %}
                                        {% set auditBadgeClass = 'badge-ghost' %}
                                    {% endif %}

                                    {% if logDate != currentDate %}
                                        <div class="flex items-center gap-3 pt-1">
                                            <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50 whitespace-nowrap">{{ logDate }}</span>
                                            <div class="flex-1 border-t border-base-300/60"></div>
                                        </div>
                                        {% set currentDate = logDate %}
                                    {% endif %}

                                    {% set actorName = log.user.fullName|default(log.user.email) %}
                                    {% set actorInitials = actorName|slice(0, 2)|upper %}

                                    <div class="relative pl-8 sm:pl-10">
                                        {% if not loop.last %}
                                            <span class="absolute left-[11px] sm:left-[15px] top-8 bottom-0 w-px bg-base-300/70" aria-hidden="true"></span>
                                        {% endif %}
                                        <span class="absolute left-0 top-1 size-6 sm:size-7 rounded-full border flex items-center justify-center z-10 {{ auditIconClass }}">
                                            <span class="{{ auditIcon }} size-3.5 sm:size-4"></span>
                                        </span>

                                        <div class="rounded-xl border border-base-300/60 bg-base-100 shadow-sm p-4 sm:p-5">
                                            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-3">
                                                <div class="min-w-0">
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <h3 class="font-semibold text-sm sm:text-base text-base-content">
                                                            {{ log.action|replace({'_': ' '})|title }}
                                                        </h3>
                                                        <span class="badge badge-ghost badge-sm font-mono">{{ log.entityType }}</span>
                                                    </div>
                                                    <p class="text-xs text-base-content/50 mt-1">
                                                        {{ log.timestamp|date('g:i A') }}
                                                        {% if log.ipAddress %} · {{ log.ipAddress }}{% endif %}
                                                    </p>
                                                </div>
                                                <span class="badge {{ auditBadgeClass }} badge-soft badge-sm shrink-0 self-start">
                                                    {{ log.timestamp|date('M j') }}
                                                </span>
                                            </div>

                                            {% if log.changes.changes is defined and log.changes.changes|length > 0 %}
                                                <div class="rounded-lg border border-base-300/50 bg-base-200/40 p-3 mb-3 space-y-1">
                                                    {% for change in log.changes.changes %}
                                                        <p class="text-sm text-base-content/80 leading-relaxed">{{ change }}</p>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}

                                            {% if log.action == 'broker_assigned' and log.changes.broker_email is defined %}
                                                <div class="rounded-lg border border-primary/20 bg-primary/5 p-3 mb-3">
                                                    <p class="text-xs font-semibold text-primary uppercase tracking-wide mb-1">Broker assigned</p>
                                                    <p class="text-sm font-medium">{{ log.changes.broker_email }}</p>
                                                    {% if log.changes.reason is defined and log.changes.reason %}
                                                        <p class="text-xs text-base-content/60 mt-2">
                                                            <span class="font-medium">Reason:</span> {{ log.changes.reason }}
                                                        </p>
                                                    {% endif %}
                                                </div>
                                            {% endif %}

                                            <div class="flex items-center gap-3 pt-3 border-t border-base-300/50">
                                                <div class="avatar avatar-placeholder shrink-0">
                                                    <div class="bg-primary/15 text-primary rounded-full size-9">
                                                        <span class="text-xs font-bold">{{ actorInitials }}</span>
                                                    </div>
                                                </div>
                                                <div class="min-w-0">
                                                    <p class="text-sm font-medium truncate" title="{{ actorName }}">{{ actorName }}</p>
                                                    <p class="text-xs text-base-content/50 truncate" title="{{ log.user.email }}">{{ log.user.email }}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="flex flex-col items-center justify-center text-center py-14 sm:py-16 rounded-xl border border-dashed border-base-300/60 bg-base-200/30">
                                <span class="icon-[tabler--history-off] size-12 text-base-content/25"></span>
                                <p class="font-semibold text-base-content mt-4">No audit events yet</p>
                                <p class="text-sm text-base-content/60 mt-1 max-w-sm">Workflow actions, payments, and document changes will appear here as they happen.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <!-- End History Tab -->
            <!-- End Tab Content -->
        </div>
    </div>

</div>

