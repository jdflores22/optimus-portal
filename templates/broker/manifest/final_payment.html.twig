{% extends 'base.html.twig' %}

{% block title %}Final Payment - {{ manifest.manifestNumber }} - OPTIMUS{% endblock %}

{% block body %}
<div class="w-full bg-base-200 min-h-screen">
<div class="w-full px-4 sm:px-6 lg:px-8 py-8">
    {# Header #}
    <div class="mb-6">
        <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}" 
           class="inline-flex items-center text-sm text-base-content/60 hover:text-base-content mb-4">
            <span class="icon-[tabler--arrow-left] size-4 mr-2"></span>
            Back to Manifest Details
        </a>
        <h1 class="text-3xl font-bold text-base-content">
            {% if rejectedPayment %}Payment Resubmission{% else %}Final Payment Submission{% endif %}
        </h1>
        <p class="mt-2 text-base-content/60">{{ manifest.manifestNumber }}</p>
    </div>

    {# Rejection Alert - Compact #}
    {% if rejectedPayment %}
        <div class="alert alert-error mb-4">
            <span class="icon-[tabler--circle-x] size-5"></span>
            <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                    <h3 class="font-bold">Payment Rejected</h3>
                    {# Version Badge #}
                    {% include 'components/payment_version_badge.html.twig' with {
                        version: rejectedPayment.version,
                        status: rejectedPayment.status.value,
                        submittedAt: rejectedPayment.createdAt,
                        size: 'sm'
                    } %}
                </div>
                <p class="text-xs mt-1"><strong>Reason:</strong> {{ rejectedPayment.rejectionReason }}</p>
                {% if rejectedPayment.version > 1 %}
                    <p class="text-xs mt-2">
                        <span class="icon-[tabler--alert-triangle] size-3 inline-block"></span>
                        This is attempt #{{ rejectedPayment.version }}. 
                        <a href="{{ path('broker_payment_history', {id: manifest.id}) }}" class="link link-hover underline font-semibold">
                            View all submissions
                        </a>
                    </p>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# Compact 2-Column Layout #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {# Left Column - Payment Form (1/3) #}
        <div class="lg:col-span-1">
            {# Payment Submission Form #}
            <div class="card bg-base-100 shadow-lg">
                <div class="card-body p-4">
                    <h3 class="text-base font-bold mb-3">Submit Payment</h3>

                    <form id="paymentForm" class="space-y-3">
                        {# Amount Field - Compact #}
                        <div class="form-control">
                            <label class="label py-1">
                                <span class="label-text text-xs font-medium">Amount</span>
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="text-base-content/60 text-sm">{{ (0|format_money(billing.originalCurrency))|slice(0, -4) }}</span>
                                </div>
                                <input type="number" 
                                       id="amount" 
                                       name="amount" 
                                       value="{{ billing.originalCurrency == 'USD' ? billing.totalAmountUsd : billing.totalAmount }}" 
                                       step="0.01" 
                                       min="0.01"
                                       required
                                       readonly
                                       disabled
                                       class="input input-sm input-bordered pl-7 w-full bg-base-200 cursor-not-allowed">
                            </div>
                            
                            {# Currency Indicator Badge #}
                            {% if billing.originalCurrency == 'USD' %}
                                <div class="mt-2 p-2 bg-warning/20 border border-warning/40 rounded-lg">
                                    <div class="flex items-center gap-2">
                                        <span class="badge badge-warning badge-lg font-bold">Amount in USD</span>
                                    </div>
                                    <p class="text-xs text-base-content/70 mt-1">
                                        <span class="icon-[tabler--alert-triangle] size-3 inline-block"></span>
                                        You must pay this amount in <strong>US Dollars</strong>. Do not convert to another currency.
                                    </p>
                                </div>
                            {% else %}
                                <div class="mt-2 p-2 bg-info/20 border border-info/40 rounded-lg">
                                    <div class="flex items-center gap-2">
                                        <span class="badge badge-info badge-lg font-bold">Amount in PHP</span>
                                    </div>
                                    <p class="text-xs text-base-content/70 mt-1">
                                        <span class="icon-[tabler--info-circle] size-3 inline-block"></span>
                                        You must pay this amount in <strong>Philippine Pesos</strong>.
                                    </p>
                                </div>
                            {% endif %}
                        </div>

                        {# Receipt Upload - Compact #}
                        <div class="form-control">
                            <label class="label py-1">
                                <span class="label-text text-xs font-medium">Receipt</span>
                            </label>
                            
                            <input id="receipt" name="receipt" type="file" accept=".pdf,.jpg,.jpeg,.png" required class="hidden">
                            
                            <div id="uploadArea" class="mt-1 flex justify-center px-4 py-4 border-2 border-dashed border-base-300 rounded-lg hover:border-primary transition-colors cursor-pointer">
                                <div class="space-y-1 text-center">
                                    <span class="icon-[tabler--upload] size-8 text-base-content/40 mx-auto block"></span>
                                    <div class="text-xs text-base-content/60">
                                        <span class="font-medium text-primary">Upload file</span>
                                    </div>
                                    <p class="text-[10px] text-base-content/50">PDF, JPG, PNG (5MB max)</p>
                                </div>
                            </div>

                            <div id="fileSelectedArea" class="hidden mt-1 border border-success bg-success/10 rounded-lg p-2">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center flex-1 min-w-0">
                                        <span class="icon-[tabler--file] size-6 text-success flex-shrink-0"></span>
                                        <div class="ml-2 flex-1 min-w-0">
                                            <p class="text-xs font-medium text-base-content truncate" id="selectedFileName"></p>
                                            <p class="text-[10px] text-base-content/60" id="selectedFileSize"></p>
                                        </div>
                                    </div>
                                    <button type="button" 
                                            id="changeFileBtn"
                                            class="btn btn-xs btn-ghost ml-2 flex-shrink-0">
                                        Change
                                    </button>
                                </div>
                            </div>
                        </div>

                        {# Error/Success Messages - Compact #}
                        <div id="errorMessage" class="alert alert-error py-2 hidden">
                            <span class="icon-[tabler--alert-circle] size-4"></span>
                            <span class="text-xs" id="errorText"></span>
                        </div>

                        <div id="successMessage" class="alert alert-success py-2 hidden">
                            <span class="icon-[tabler--circle-check] size-4"></span>
                            <span class="text-xs">Payment submitted! Redirecting...</span>
                        </div>

                        {# Submit Button - Compact #}
                        <div class="flex flex-col gap-2 pt-2">
                            <button type="submit" 
                                    id="submitBtn"
                                    class="btn btn-primary btn-sm btn-block">
                                <span id="submitIcon" class="{% if rejectedPayment %}icon-[tabler--upload]{% else %}icon-[tabler--send]{% endif %} size-4"></span>
                                <span id="loadingSpinner" class="loading loading-spinner loading-sm hidden"></span>
                                <span id="btnText">{% if rejectedPayment %}Resubmit{% else %}Submit{% endif %}</span>
                            </button>
                            {% if rejectedPayment %}
                            <a href="{{ path('broker_payment_history', {id: manifest.id}) }}" 
                               class="btn btn-ghost btn-xs btn-block">
                                <span class="icon-[tabler--history] size-3"></span>
                                View My Submissions
                            </a>
                            {% endif %}
                            <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}" 
                               class="btn btn-ghost btn-xs btn-block">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            {# Billing Summary - Compact #}
            <div class="card bg-base-100 shadow-lg mt-4">
                <div class="card-body p-4">
                    <h3 class="text-base font-bold mb-3">Billing Summary</h3>
                    
                    <div class="space-y-1.5">
                        {# Freight #}
                        <div class="flex justify-between py-1.5 border-b border-base-300">
                            <span class="text-xs text-base-content/60">Freight</span>
                            <div class="text-right">
                                {% if billing.originalCurrency == 'USD' and billing.freightChargesUsd %}
                                    <div class="text-xs font-medium">
                                        <div>{{ billing|format_billing_charge(billing.freightCharges, billing.freightChargesUsd) }}</div>
                                        {% if billing.exchangeRate %}
                                            <div class="text-[10px] text-base-content/60">{{ (billing.freightChargesUsd * billing.exchangeRate)|format_money('PHP') }}</div>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-xs font-medium">{{ billing|format_billing_charge(billing.freightCharges, billing.freightChargesUsd) }}</span>
                                {% endif %}
                            </div>
                        </div>

                        {# THC #}
                        <div class="flex justify-between py-1.5 border-b border-base-300">
                            <span class="text-xs text-base-content/60">THC</span>
                            <div class="text-right">
                                {% if billing.originalCurrency == 'USD' and billing.thcChargesUsd %}
                                    <div class="text-xs font-medium">
                                        <div>{{ billing|format_billing_charge(billing.thcCharges, billing.thcChargesUsd) }}</div>
                                        {% if billing.exchangeRate %}
                                            <div class="text-[10px] text-base-content/60">{{ (billing.thcChargesUsd * billing.exchangeRate)|format_money('PHP') }}</div>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-xs font-medium">{{ billing|format_billing_charge(billing.thcCharges, billing.thcChargesUsd) }}</span>
                                {% endif %}
                            </div>
                        </div>

                        {# Additional Charges #}
                        {% if billing.additionalCharges %}
                            {% for charge in billing.additionalCharges %}
                                <div class="flex justify-between py-1.5 border-b border-base-300">
                                    <span class="text-xs text-base-content/60">{{ charge.description }}</span>
                                    <div class="text-right">
                                        {% if billing.originalCurrency == 'USD' and charge.amountUsd %}
                                            <div class="text-xs font-medium">
                                                <div>{{ charge.amountUsd|format_money('USD') }}</div>
                                                {% if billing.exchangeRate %}
                                                    <div class="text-[10px] text-base-content/60">{{ (charge.amountUsd * billing.exchangeRate)|format_money('PHP') }}</div>
                                                {% endif %}
                                            </div>
                                        {% else %}
                                            <span class="text-xs font-medium">{{ charge.amount|format_money(billing.originalCurrency) }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}

                        {# Total #}
                        <div class="flex justify-between py-2 bg-primary/10 px-3 rounded-lg mt-2">
                            <span class="text-sm font-semibold">Total</span>
                            <div class="text-right">
                                {% if billing.originalCurrency == 'USD' and billing.totalAmountUsd %}
                                    <div class="text-base font-bold text-primary">{{ billing|format_billing }}</div>
                                    {% if billing.exchangeRate %}
                                        <div class="text-xs font-semibold text-base-content/70">{{ (billing.totalAmountUsd * billing.exchangeRate)|format_money('PHP') }}</div>
                                    {% endif %}
                                {% else %}
                                    <span class="text-base font-bold text-primary">{{ billing|format_billing }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Right Column - Billing Document (2/3) #}
        <div class="lg:col-span-2">
            <div class="card bg-base-100 shadow-lg sticky top-4">
                <div class="card-body p-3">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-base font-bold">Billing Document</h3>
                        {% if billing.pdfPath %}
                            <a href="{{ path('api_billing_download', {billingId: billing.id, inline: 'false'}) }}" 
                               target="_blank"
                               class="btn btn-xs btn-ghost gap-1">
                                <span class="icon-[tabler--external-link] size-3"></span>
                                Open
                            </a>
                        {% endif %}
                    </div>
                    
                    {% if billing.pdfPath %}
                        <div class="border border-base-300 rounded-lg overflow-hidden bg-base-200" style="height: 600px;">
                            <iframe src="{{ path('api_billing_download', {billingId: billing.id, inline: 'true'}) }}" 
                                    class="w-full h-full border-0"></iframe>
                        </div>
                    {% else %}
                        <div class="flex flex-col items-center justify-center text-center bg-base-200 rounded-lg border border-dashed border-base-300" style="height: 600px;">
                            <span class="icon-[tabler--file-off] size-12 text-base-content/20 mb-2"></span>
                            <p class="text-xs text-base-content/60">Document not available</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('paymentForm');
    const receiptInput = document.getElementById('receipt');
    const uploadArea = document.getElementById('uploadArea');
    const fileSelectedArea = document.getElementById('fileSelectedArea');
    const selectedFileName = document.getElementById('selectedFileName');
    const selectedFileSize = document.getElementById('selectedFileSize');
    const changeFileBtn = document.getElementById('changeFileBtn');
    const submitBtn = document.getElementById('submitBtn');
    const submitIcon = document.getElementById('submitIcon');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const btnText = document.getElementById('btnText');
    const errorMessage = document.getElementById('errorMessage');
    const errorText = document.getElementById('errorText');
    const successMessage = document.getElementById('successMessage');

    // Format file size
    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
    }

    // Show file selected UI
    function showFileSelected(file) {
        selectedFileName.textContent = file.name;
        selectedFileSize.textContent = formatFileSize(file.size);
        uploadArea.classList.add('hidden');
        fileSelectedArea.classList.remove('hidden');
    }

    // Show upload area UI
    function showUploadArea() {
        uploadArea.classList.remove('hidden');
        fileSelectedArea.classList.add('hidden');
        receiptInput.value = ''; // Clear the file input
    }

    // File input change handler
    receiptInput.addEventListener('change', function(e) {
        if (e.target.files.length > 0) {
            const file = e.target.files[0];
            
            // Get file extension
            const fileName = file.name.toLowerCase();
            const fileExtension = fileName.substring(fileName.lastIndexOf('.'));
            const allowedExtensions = ['.pdf', '.jpg', '.jpeg', '.png'];
            
            // Validate file extension
            if (!allowedExtensions.includes(fileExtension)) {
                errorText.textContent = 'Invalid file type. Only PDF, JPG, and PNG files are allowed.';
                errorMessage.classList.remove('hidden');
                receiptInput.value = '';
                showUploadArea();
                return;
            }
            
            // Validate file size (5MB max)
            if (file.size > 5 * 1024 * 1024) {
                errorText.textContent = 'File size must be less than 5MB';
                errorMessage.classList.remove('hidden');
                receiptInput.value = '';
                showUploadArea();
                return;
            }
            
            showFileSelected(file);
            errorMessage.classList.add('hidden');
        }
    });

    // Change file button handler
    changeFileBtn.addEventListener('click', function() {
        showUploadArea();
    });

    // Click on upload area to trigger file input
    uploadArea.addEventListener('click', function(e) {
        e.preventDefault();
        receiptInput.click();
    });

    // Drag and drop handlers
    uploadArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        uploadArea.classList.add('border-primary', 'bg-primary/10');
    });

    uploadArea.addEventListener('dragleave', function(e) {
        e.preventDefault();
        uploadArea.classList.remove('border-primary', 'bg-primary/10');
    });

    uploadArea.addEventListener('drop', function(e) {
        e.preventDefault();
        uploadArea.classList.remove('border-primary', 'bg-primary/10');
        
        if (e.dataTransfer.files.length > 0) {
            receiptInput.files = e.dataTransfer.files;
            const event = new Event('change', { bubbles: true });
            receiptInput.dispatchEvent(event);
        }
    });

    // Form submission
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        errorMessage.classList.add('hidden');
        successMessage.classList.add('hidden');
        
        // Show loading state
        submitBtn.disabled = true;
        submitIcon.classList.add('hidden');
        loadingSpinner.classList.remove('hidden');
        btnText.textContent = 'Submitting...';

        const formData = new FormData();
        formData.append('amount', document.getElementById('amount').value);
        formData.append('receipt', receiptInput.files[0]);

        try {
            // Check if this is a resubmission
            const isResubmission = {{ rejectedPayment ? 'true' : 'false' }};
            const rejectedPaymentId = {{ rejectedPayment ? rejectedPayment.id : 'null' }};
            
            let url, method;
            if (isResubmission && rejectedPaymentId) {
                // Use resubmit endpoint
                url = `/api/payments/${rejectedPaymentId}/resubmit`;
                method = 'POST';
            } else {
                // Use regular submit endpoint
                url = '/api/manifests/{{ manifest.id }}/payments/final';
                method = 'POST';
            }

            const response = await fetch(url, {
                method: method,
                body: formData
            });

            const data = await response.json();

            if (response.ok) {
                successMessage.classList.remove('hidden');
                
                // Change button to success state
                loadingSpinner.classList.add('hidden');
                submitIcon.classList.remove('hidden');
                submitIcon.className = 'icon-[tabler--circle-check] size-4';
                btnText.textContent = 'Success!';
                submitBtn.classList.remove('btn-primary');
                submitBtn.classList.add('btn-success');
                
                // Redirect after showing success message
                setTimeout(() => {
                    window.location.href = '{{ path('broker_manifest_detail', {id: manifest.id}) }}';
                }, 1500);
            } else {
                // Handle both error formats: {error: "message"} and {error: true, message: "message"}
                let errorMsg = 'Failed to submit payment. Please try again.';
                if (typeof data.error === 'string') {
                    errorMsg = data.error;
                } else if (data.message) {
                    errorMsg = data.message;
                }
                errorText.textContent = errorMsg;
                errorMessage.classList.remove('hidden');
                
                // Reset button state
                submitBtn.disabled = false;
                submitBtn.classList.remove('btn-success');
                submitBtn.classList.add('btn-primary');
                submitIcon.classList.remove('hidden');
                submitIcon.className = '{% if rejectedPayment %}icon-[tabler--upload]{% else %}icon-[tabler--send]{% endif %} size-4';
                loadingSpinner.classList.add('hidden');
                btnText.textContent = '{% if rejectedPayment %}Resubmit{% else %}Submit{% endif %}';
            }
        } catch (error) {
            console.error('Payment submission error:', error);
            errorText.textContent = 'An error occurred while submitting payment. Please try again.';
            errorMessage.classList.remove('hidden');
            
            // Reset button state
            submitBtn.disabled = false;
            submitBtn.classList.remove('btn-success');
            submitBtn.classList.add('btn-primary');
            submitIcon.classList.remove('hidden');
            submitIcon.className = '{% if rejectedPayment %}icon-[tabler--upload]{% else %}icon-[tabler--send]{% endif %} size-4';
            loadingSpinner.classList.add('hidden');
            btnText.textContent = '{% if rejectedPayment %}Resubmit{% else %}Submit{% endif %}';
        }
    });
});
</script>
{% endblock %}
