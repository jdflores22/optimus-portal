{% extends 'base.html.twig' %}

{% block title %}Documents - {{ manifest.manifestNumber }} - OPTIMUS{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <a href="{{ path(manifest_detail_route|default('broker_manifest_detail'), {id: manifest.id}) }}" 
           class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 mb-4">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Manifest Details
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Documents</h1>
        <p class="mt-2 text-gray-600">{{ manifest.manifestNumber }}</p>
    </div>

    <!-- Documents Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Manifest Document -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center mb-4">
                <div class="flex-shrink-0">
                    <svg class="w-10 h-10 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Manifest</h3>
                    <p class="text-sm text-gray-500">{{ manifest.manifestNumber }}</p>
                </div>
            </div>
            <div class="space-y-2">
                <p class="text-sm text-gray-600">Created: {{ manifest.createdAt|date('M j, Y g:i A') }}</p>
                {% if manifest.vesselName %}
                    <p class="text-sm text-gray-600">Vessel: {{ manifest.vesselName }}</p>
                {% endif %}
            </div>
            <div class="mt-4">
                <a href="/api/manifests/{{ manifest.id }}/download" 
                   target="_blank"
                   class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Download
                </a>
            </div>
        </div>

        <!-- NOA Document -->
        {% if manifest.noaDocument %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Notice of Arrival</h3>
                        <p class="text-sm text-gray-500">{{ manifest.noaDocument.noaNumber }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">Generated: {{ manifest.noaDocument.createdAt|date('M j, Y g:i A') }}</p>
                    {% if manifest.arrivalDate %}
                        <p class="text-sm text-gray-600">Arrival: {{ manifest.arrivalDate|date('M j, Y g:i A') }}</p>
                    {% endif %}
                </div>
                <div class="mt-4">
                    <a href="/api/noa/{{ manifest.noaDocument.noaNumber }}/download" 
                       target="_blank"
                       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Download
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Notice of Arrival</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet generated</p>
                </div>
            </div>
        {% endif %}

        <!-- Bill of Lading Document -->
        {% if manifest.blNumber and manifest.blFilePath %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Bill of Lading</h3>
                        <p class="text-sm text-gray-500">{{ manifest.blNumber }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">BL Number: {{ manifest.blNumber }}</p>
                    {% if manifest.vesselName %}
                        <p class="text-sm text-gray-600">Vessel: {{ manifest.vesselName }}</p>
                    {% endif %}
                </div>
                <div class="mt-4">
                    <a href="/api/bl/{{ manifest.blNumber }}/download" 
                       target="_blank"
                       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Download
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Bill of Lading</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet uploaded</p>
                </div>
            </div>
        {% endif %}

        <!-- Billing Document -->
        {% if manifest.billing %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Billing Document</h3>
                        <p class="text-sm text-gray-500">Billing #{{ manifest.billing.id }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">Generated: {{ manifest.billing.createdAt|date('M j, Y g:i A') }}</p>
                    <p class="text-sm text-gray-600">Total Amount: <span class="font-medium text-green-600">{{ manifest.billing|format_billing }}</span></p>
                </div>
                <div class="mt-4">
                    <a href="/api/billing/{{ manifest.billing.id }}/download" 
                       target="_blank"
                       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Download
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Billing Document</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet generated</p>
                </div>
            </div>
        {% endif %}

        <!-- eDO Document -->
        {% if manifest.edo %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Electronic Delivery Order</h3>
                        <p class="text-sm text-gray-500">{{ manifest.edo.edoNumber }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">Generated: {{ manifest.edo.generatedAt|date('M j, Y g:i A') }}</p>
                    {% if manifest.blNumber %}
                        <p class="text-sm text-gray-600">BL Number: {{ manifest.blNumber }}</p>
                    {% endif %}
                </div>
                <div class="mt-4">
                    {% if manifest.edo.status.value == 'released' %}
                        <a href="/api/edos/{{ manifest.edo.edoNumber }}/download" 
                           target="_blank"
                           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-purple-600 hover:bg-purple-700">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            Download
                        </a>
                    {% elseif manifest.edo.status.value == 'pending_release' %}
                        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
                            <div class="flex">
                                <svg class="h-5 w-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <div class="ml-3">
                                    <p class="text-sm text-yellow-700">eDO pending administrative release. You will be notified when it's available for download.</p>
                                </div>
                            </div>
                        </div>
                    {% elseif manifest.edo.status.value == 'rejected' %}
                        <div class="bg-red-50 border border-red-200 rounded-lg p-3">
                            <div class="flex">
                                <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                                <div class="ml-3">
                                    <p class="text-sm text-red-700">eDO rejected. Please contact support for assistance.</p>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Electronic Delivery Order</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet generated</p>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Document Info -->
    <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex">
            <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="ml-3">
                <p class="text-sm text-blue-700">
                    All documents are generated in PDF format and include digital signatures for verification. Download timestamps are logged for audit purposes.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
