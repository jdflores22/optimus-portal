{% extends 'base.html.twig' %}

{% block title %}Documents - {{ manifest.manifestNumber }} - OPTIMUS{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <a href="{{ path(manifest_detail_route|default('broker_manifest_detail'), {id: manifest.id}) }}" 
           class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 mb-4">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Manifest Details
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Documents</h1>
        <p class="mt-2 text-gray-600">{{ manifest.manifestNumber }}</p>
    </div>

    <!-- Documents Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Manifest/BL Document -->
        {% if manifest.noa and (manifest.noa.manifestPdfPath or manifest.manifestFilePath) %}
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center mb-4">
                <div class="flex-shrink-0">
                    <svg class="w-10 h-10 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Manifest/BL Document</h3>
                    <p class="text-sm text-gray-500">{{ manifest.manifestNumber }}</p>
                </div>
            </div>
            <div class="space-y-2">
                <p class="text-sm text-gray-600">Created: {{ manifest.createdAt|date('M j, Y g:i A') }}</p>
                {% if manifest.vesselName %}
                    <p class="text-sm text-gray-600">Vessel: {{ manifest.vesselName }}</p>
                {% endif %}
            </div>
            <div class="mt-4">
                <a href="{{ path('broker_manifest_bl_download', {id: manifest.id}) }}"
                   target="_blank"
                   class="btn btn-info btn-sm btn-soft gap-2">
                    <span class="icon-[tabler--download] size-4"></span>
                    Download
                </a>
            </div>
        </div>
        {% endif %}

        <!-- NOA Document -->
        {% if (manifest.noa and manifest.noa.pdfPath) or (manifest.noaDocument and manifest.noaDocument.pdfPath) %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Notice of Arrival</h3>
                        <p class="text-sm text-gray-500">{{ manifest.noa ? manifest.noa.noaNumber : manifest.noaDocument.noaNumber }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">Generated: {{ manifest.noa ? manifest.noa.createdAt|date('M j, Y g:i A') : manifest.noaDocument.createdAt|date('M j, Y g:i A') }}</p>
                    {% if manifest.arrivalDate %}
                        <p class="text-sm text-gray-600">Arrival: {{ manifest.arrivalDate|date('M j, Y g:i A') }}</p>
                    {% endif %}
                </div>
                <div class="mt-4">
                    <a href="{{ path('broker_manifest_noa_download', {id: manifest.id}) }}"
                       target="_blank"
                       class="btn btn-primary btn-sm btn-soft gap-2">
                        <span class="icon-[tabler--download] size-4"></span>
                        Download
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Notice of Arrival</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet generated</p>
                </div>
            </div>
        {% endif %}

        <!-- Bill of Lading Document -->
        {% if manifest.blNumber and manifest.blFilePath %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Bill of Lading</h3>
                        <p class="text-sm text-gray-500">{{ manifest.blNumber }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">BL Number: {{ manifest.blNumber }}</p>
                    {% if manifest.vesselName %}
                        <p class="text-sm text-gray-600">Vessel: {{ manifest.vesselName }}</p>
                    {% endif %}
                </div>
                <div class="mt-4">
                    <a href="{{ path('broker_manifest_bl_file_download', {id: manifest.id}) }}"
                       class="btn btn-info btn-sm btn-soft gap-2">
                        <span class="icon-[tabler--download] size-4"></span>
                        Download
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Bill of Lading</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet uploaded</p>
                </div>
            </div>
        {% endif %}

        <!-- Billing Document -->
        {% if manifest.billing %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Billing Document</h3>
                        <p class="text-sm text-gray-500">Billing #{{ manifest.billing.id }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">Generated: {{ manifest.billing.createdAt|date('M j, Y g:i A') }}</p>
                    <p class="text-sm text-gray-600">Total Amount: <span class="font-medium text-green-600">{{ manifest.billing|format_billing }}</span></p>
                </div>
                <div class="mt-4">
                    <a href="{{ path('broker_manifest_billing_download', {id: manifest.id}) }}"
                       class="btn btn-warning btn-sm btn-soft gap-2">
                        <span class="icon-[tabler--download] size-4"></span>
                        Download
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Billing Document</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet generated</p>
                </div>
            </div>
        {% endif %}

        {% if latestFinalPayment is defined %}
        <!-- Payment Receipt -->
        {% if latestFinalPayment and latestFinalPayment.receiptFilePath %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <span class="icon-[tabler--receipt] size-10 text-emerald-500"></span>
                    </div>
                    <div class="ml-4 min-w-0">
                        <h3 class="text-lg font-medium text-gray-900">Payment Receipt</h3>
                        <p class="text-sm text-gray-500">Version {{ latestFinalPayment.version }} · {{ latestFinalPayment|format_payment }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">Submitted: {{ latestFinalPayment.createdAt|date('M j, Y g:i A') }}</p>
                    <p class="text-sm text-gray-600">
                        Status:
                        {% if latestFinalPayment.status.value == 'verified' %}
                            <span class="badge badge-success badge-sm">Verified</span>
                        {% elseif latestFinalPayment.status.value == 'rejected' %}
                            <span class="badge badge-error badge-sm">Rejected</span>
                        {% else %}
                            <span class="badge badge-warning badge-sm">Pending review</span>
                        {% endif %}
                    </p>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                    <a href="{{ path('broker_payment_receipt', {id: latestFinalPayment.id}) }}?inline=false"
                       class="btn btn-success btn-sm btn-soft gap-2">
                        <span class="icon-[tabler--download] size-4"></span>
                        Download
                    </a>
                    {% if finalPayments|length > 1 %}
                        <a href="{{ path('broker_payment_history', {id: manifest.id}) }}"
                           class="btn btn-ghost btn-sm gap-2">
                            <span class="icon-[tabler--history] size-4"></span>
                            All versions
                        </a>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <span class="icon-[tabler--receipt-off] size-10 text-gray-400 mx-auto block"></span>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Payment Receipt</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet submitted</p>
                </div>
            </div>
        {% endif %}

        <!-- Official Receipt -->
        {% if verifiedFinalPayment and verifiedFinalPayment.officialReceiptPath %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <span class="icon-[tabler--file-certificate] size-10 text-green-600"></span>
                    </div>
                    <div class="ml-4 min-w-0">
                        <h3 class="text-lg font-medium text-gray-900">Official Receipt</h3>
                        <p class="text-sm text-gray-500">Issued after payment verification</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">
                        Verified: {{ verifiedFinalPayment.validatedAt|date('M j, Y g:i A') }}
                    </p>
                    {% if verifiedFinalPayment.validatedBy %}
                        <p class="text-sm text-gray-600">By: {{ verifiedFinalPayment.validatedBy.fullName }}</p>
                    {% endif %}
                </div>
                <div class="mt-4">
                    <a href="{{ path('broker_payment_receipt', {id: verifiedFinalPayment.id, type: 'official'}) }}?inline=false"
                       class="btn btn-success btn-sm btn-soft gap-2">
                        <span class="icon-[tabler--download] size-4"></span>
                        Download
                    </a>
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <span class="icon-[tabler--file-certificate] size-10 text-gray-400 mx-auto block"></span>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Official Receipt</h3>
                    <p class="mt-1 text-sm text-gray-500">
                        {% if latestFinalPayment and latestFinalPayment.status.value == 'pending_validation' %}
                            Available after accounting approves your payment
                        {% else %}
                            Not yet issued
                        {% endif %}
                    </p>
                </div>
            </div>
        {% endif %}

        {% endif %}

        <!-- eDO Document -->
        {% if manifest.edo %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-10 h-10 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Electronic Delivery Order</h3>
                        <p class="text-sm text-gray-500">{{ manifest.edo.edoNumber }}</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <p class="text-sm text-gray-600">Generated: {{ manifest.edo.generatedAt|date('M j, Y g:i A') }}</p>
                    {% if manifest.blNumber %}
                        <p class="text-sm text-gray-600">BL Number: {{ manifest.blNumber }}</p>
                    {% endif %}
                </div>
                <div class="mt-4">
                    {% if manifest.edo.status.value == 'released' %}
                        <a href="{{ path('broker_edo_download', {id: manifest.edo.id}) }}"
                           class="btn btn-success btn-sm btn-soft gap-2">
                            <span class="icon-[tabler--download] size-4"></span>
                            Download
                        </a>
                    {% elseif manifest.edo.status.value == 'pending_release' %}
                        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
                            <div class="flex">
                                <svg class="h-5 w-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <div class="ml-3">
                                    <p class="text-sm text-yellow-700">eDO pending administrative release. You will be notified when it's available for download.</p>
                                </div>
                            </div>
                        </div>
                    {% elseif manifest.edo.status.value == 'rejected' %}
                        <div class="bg-red-50 border border-red-200 rounded-lg p-3">
                            <div class="flex">
                                <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                                <div class="ml-3">
                                    <p class="text-sm text-red-700">eDO rejected. Please contact support for assistance.</p>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Electronic Delivery Order</h3>
                    <p class="mt-1 text-sm text-gray-500">Not yet generated</p>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Document Info -->
    <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex">
            <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="ml-3">
                <p class="text-sm text-blue-700">
                    All documents are generated in PDF format and include digital signatures for verification. Download timestamps are logged for audit purposes.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
