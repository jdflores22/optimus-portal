{% extends 'base.html.twig' %}

{% block title %}My Manifests - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Header Section -->
    <div class="bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                    <h1 class="text-2xl font-bold text-base-content">My Manifests</h1>
                    <p class="text-sm text-base-content/60 mt-1">View and manage manifests</p>
                </div>
                
                <!-- Active Workspace Badge -->
                {% if app.session.get('active_workspace_consignee_id') %}
                    <div class="flex items-center gap-2 bg-primary/10 rounded-xl px-4 py-3">
                        <span class="icon-[tabler--briefcase] size-5 text-primary"></span>
                        <div class="flex flex-col">
                            <span class="text-xs text-primary/70 font-medium">Active Workspace</span>
                            <span class="text-sm font-bold text-primary truncate max-w-[200px]">{{ app.session.get('active_workspace_consignee_name', 'Workspace') }}</span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-8 py-6">
        {# Rejected Payments Alert #}
        {% if rejectedPaymentsCount > 0 %}
            <div class="alert alert-error mb-6 shadow-lg">
                <span class="icon-[tabler--alert-triangle] size-6"></span>
                <div class="flex-1">
                    <h3 class="font-bold">Action Required: Rejected Payments</h3>
                    <p class="text-sm">You have {{ rejectedPaymentsCount }} rejected payment{{ rejectedPaymentsCount > 1 ? 's' : '' }} that need to be resubmitted.</p>
                </div>
                <a href="{{ path('broker_payments_rejected') }}" class="btn btn-sm btn-ghost">
                    <span class="icon-[tabler--arrow-right] size-4"></span>
                    View & Resubmit
                </a>
            </div>
        {% endif %}
        
        <!-- Tabs -->
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="tabs tabs-boxed bg-base-200 p-2">
                <a href="{{ path('broker_manifest_list', {tab: 'active'}) }}" 
                   class="tab {% if currentTab == 'active' %}tab-active{% endif %} gap-2">
                    Active
                    {% if activeCount > 0 %}
                        <span class="badge badge-sm">{{ activeCount }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('broker_manifest_list', {tab: 'completed'}) }}" 
                   class="tab {% if currentTab == 'completed' %}tab-active{% endif %} gap-2">
                    Completed
                    {% if completedCount > 0 %}
                        <span class="badge badge-sm">{{ completedCount }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('broker_manifest_list', {tab: 'all'}) }}" 
                   class="tab {% if currentTab == 'all' %}tab-active{% endif %} gap-2">
                    All
                    <span class="badge badge-sm">{{ total }}</span>
                </a>
            </div>

            <!-- Filters -->
            <div class="card-body p-4 bg-base-200">
                <form method="GET" action="{{ path('broker_manifest_list') }}" class="space-y-3">
                    <input type="hidden" name="tab" value="{{ currentTab }}">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Status Filter -->
                        <div class="form-control">
                            <label for="status" class="label">
                                <span class="label-text">Status</span>
                            </label>
                            <select name="status" id="status" class="select select-bordered w-full">
                                <option value="">All Statuses</option>
                                {% for state in workflowStates %}
                                    <option value="{{ state.value }}" {{ filters.status == state.value ? 'selected' : '' }}>
                                        {{ state.getDisplayName() }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <!-- Date From -->
                        <div class="form-control">
                            <label for="date_from" class="label">
                                <span class="label-text">Date From</span>
                            </label>
                            <input type="date" name="date_from" id="date_from" value="{{ filters.date_from }}" 
                                   class="input input-bordered w-full">
                        </div>

                        <!-- Date To -->
                        <div class="form-control">
                            <label for="date_to" class="label">
                                <span class="label-text">Date To</span>
                            </label>
                            <input type="date" name="date_to" id="date_to" value="{{ filters.date_to }}" 
                                   class="input input-bordered w-full">
                        </div>
                    </div>

                    <!-- Filter Buttons -->
                    <div class="flex gap-2">
                        <a href="{{ path('broker_manifest_list', {tab: currentTab}) }}" class="btn btn-ghost">
                            Clear
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Apply Filters
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Manifest List -->
        <div class="card bg-base-100 shadow-sm">
            {% if manifests|length > 0 %}
                <div class="card-body p-4 border-b border-base-300">
                    <h3 class="text-sm font-semibold text-base-content">{{ total }} Manifest{{ total != 1 ? 's' : '' }}</h3>
                </div>

                <!-- Mobile: Card Layout -->
                <div class="divide-y divide-base-300 lg:hidden">
                    {% for item in manifests %}
                        {% set manifest = item.manifest %}
                        {% set statusValue = manifest.workflowState.value %}
                        
                        <div class="p-4 hover:bg-base-200 transition-colors">
                            <div class="flex flex-col gap-3">
                                <!-- Top: Manifest Number & Action Button -->
                                <div class="flex items-start justify-between gap-2">
                                    <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}" 
                                       class="text-sm font-bold text-base-content hover:text-primary">
                                        {{ manifest.manifestNumber }}
                                    </a>
                                    
                                    <div class="flex-shrink-0">
                                        <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}" 
                                           class="btn btn-ghost btn-sm gap-2">
                                            <span class="icon-[tabler--eye] size-4"></span>
                                            View
                                        </a>
                                    </div>
                                </div>
                                
                                <!-- Status Badges -->
                                <div class="flex flex-wrap items-center gap-2">
                                    <!-- Containers/eDO Badge -->
                                    {% if item.all_edos_paid %}
                                        <span class="badge badge-success badge-sm gap-1">
                                            <span class="icon-[tabler--circle-check] size-3"></span>
                                            {{ item.containers_with_edo }}/{{ item.total_containers }} eDOs ✓ Paid
                                        </span>
                                    {% elseif item.all_edos_generated %}
                                        <span class="badge badge-success badge-sm gap-1">
                                            <span class="icon-[tabler--circle-check] size-3"></span>
                                            {{ item.containers_with_edo }}/{{ item.total_containers }} eDOs
                                        </span>
                                        {% if item.edos_paid > 0 %}
                                            <span class="badge badge-info badge-sm">
                                                {{ item.edos_paid }} paid
                                            </span>
                                        {% endif %}
                                    {% elseif item.containers_with_edo > 0 %}
                                        <span class="badge badge-warning badge-sm">
                                            {{ item.containers_with_edo }}/{{ item.total_containers }} eDOs
                                        </span>
                                        {% if item.edos_paid > 0 %}
                                            <span class="badge badge-info badge-sm">
                                                {{ item.edos_paid }} paid
                                            </span>
                                        {% endif %}
                                    {% else %}
                                        <span class="badge badge-info badge-sm">
                                            {{ item.total_containers }} containers
                                        </span>
                                    {% endif %}
                                    
                                    <!-- Workflow Status Badge -->
                                    {% if statusValue == 'manifest_uploaded' %}
                                        <span class="badge badge-ghost badge-lg">Uploaded</span>
                                    {% elseif statusValue == 'noa_generated' %}
                                        <span class="badge badge-secondary badge-lg">NOA Generated</span>
                                    {% elseif statusValue == 'bl_generated' %}
                                        <span class="badge badge-info badge-lg">BL Generated</span>
                                    {% elseif statusValue == 'bl_uploaded' %}
                                        <span class="badge badge-info badge-lg">BL Uploaded</span>
                                    {% elseif statusValue == 'billing_generated' %}
                                        <span class="badge badge-warning badge-lg">Billing Generated</span>
                                    {% elseif statusValue == 'payment_submitted' %}
                                        <span class="badge badge-info badge-lg">Payment Submitted</span>
                                    {% elseif statusValue == 'edo_generated' %}
                                        <span class="badge badge-success badge-lg">eDO Generated</span>
                                    {% elseif statusValue == 'edo_released' %}
                                        <span class="badge badge-success badge-lg">eDO Released</span>
                                    {% else %}
                                        <span class="badge badge-ghost badge-lg">{{ manifest.workflowState.getDisplayName() }}</span>
                                    {% endif %}
                                    
                                    <!-- Payment Status Badge -->
                                    {% if item.containers_with_edo > 0 %}
                                        {% if item.all_edos_paid %}
                                            <span class="badge badge-success badge-lg gap-2">
                                                <span class="icon-[tabler--check] size-3"></span>
                                                All Paid
                                            </span>
                                        {% elseif item.edos_paid > 0 %}
                                            <span class="badge badge-info badge-lg gap-2">
                                                <span class="icon-[tabler--file-check] size-3"></span>
                                                {{ item.edos_paid }}/{{ item.containers_with_edo }} Paid
                                            </span>
                                        {% else %}
                                            <span class="badge badge-warning badge-lg gap-2">
                                                <span class="icon-[tabler--clock] size-3"></span>
                                                Pending
                                            </span>
                                        {% endif %}
                                    {% else %}
                                        <span class="badge badge-ghost badge-lg">N/A</span>
                                    {% endif %}
                                </div>
                                
                                <!-- Details -->
                                <div class="grid grid-cols-1 gap-2 text-xs text-base-content/60">
                                    {% if manifest.consignee %}
                                        <div class="flex items-center gap-2">
                                            <span class="icon-[tabler--briefcase] size-4"></span>
                                            <span class="font-medium text-base-content truncate">{{ manifest.consignee.businessName }}</span>
                                        </div>
                                    {% endif %}
                                    
                                    {% if manifest.vesselName %}
                                        <div class="flex items-center gap-2">
                                            <span class="icon-[tabler--ship] size-4"></span>
                                            <span class="truncate">{{ manifest.vesselName }}</span>
                                        </div>
                                    {% endif %}
                                    
                                    <div class="flex items-center gap-2">
                                        <span class="icon-[tabler--calendar] size-4"></span>
                                        <span>{{ manifest.createdAt|date('M j, Y') }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Desktop: Table Layout -->
                <div class="hidden lg:block overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Manifest #</th>
                                <th>Consignee</th>
                                <th>Vessel</th>
                                <th>Containers/eDOs</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Date</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in manifests %}
                                {% set manifest = item.manifest %}
                                {% set statusValue = manifest.workflowState.value %}
                                
                                <tr class="hover">
                                    <td>
                                        <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}" 
                                           class="font-semibold text-base-content hover:text-primary">
                                            {{ manifest.manifestNumber }}
                                        </a>
                                    </td>
                                    <td>
                                        {% if manifest.consignee %}
                                            <span class="text-sm text-base-content">{{ manifest.consignee.businessName }}</span>
                                        {% else %}
                                            <span class="text-sm text-base-content/40">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if manifest.vesselName %}
                                            <span class="text-sm text-base-content">{{ manifest.vesselName }}</span>
                                        {% else %}
                                            <span class="text-sm text-base-content/40">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if item.all_edos_paid %}
                                            <div class="flex items-center gap-1.5">
                                                <span class="badge badge-success badge-sm gap-1">
                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                    {{ item.containers_with_edo }}/{{ item.total_containers }}
                                                </span>
                                                <span class="text-xs text-success font-medium">All Paid</span>
                                            </div>
                                        {% elseif item.all_edos_generated %}
                                            <div class="flex items-center gap-1.5">
                                                <span class="badge badge-success badge-sm gap-1">
                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                    {{ item.containers_with_edo }}/{{ item.total_containers }}
                                                </span>
                                                {% if item.edos_paid > 0 %}
                                                    <span class="badge badge-info badge-xs">{{ item.edos_paid }} paid</span>
                                                {% endif %}
                                            </div>
                                        {% elseif item.containers_with_edo > 0 %}
                                            <div class="flex flex-col gap-1">
                                                <div class="flex items-center gap-1.5">
                                                    <span class="badge badge-warning badge-sm">
                                                        {{ item.containers_with_edo }}/{{ item.total_containers }} eDOs
                                                    </span>
                                                    {% if item.edos_paid > 0 %}
                                                        <span class="badge badge-info badge-xs">{{ item.edos_paid }} paid</span>
                                                    {% endif %}
                                                </div>
                                                <div class="w-16 bg-base-300 rounded-full h-1">
                                                    <div class="bg-warning h-1 rounded-full" style="width: {{ item.edo_progress }}%"></div>
                                                </div>
                                            </div>
                                        {% else %}
                                            <span class="badge badge-info badge-sm">{{ item.total_containers }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if statusValue == 'manifest_uploaded' %}
                                            <span class="badge badge-ghost badge-lg">Uploaded</span>
                                        {% elseif statusValue == 'noa_generated' %}
                                            <span class="badge badge-secondary badge-lg">NOA Generated</span>
                                        {% elseif statusValue == 'bl_generated' %}
                                            <span class="badge badge-info badge-lg">BL Generated</span>
                                        {% elseif statusValue == 'bl_uploaded' %}
                                            <span class="badge badge-info badge-lg">BL Uploaded</span>
                                        {% elseif statusValue == 'billing_generated' %}
                                            <span class="badge badge-warning badge-lg">Billing Generated</span>
                                        {% elseif statusValue == 'payment_submitted' %}
                                            <span class="badge badge-info badge-lg">Payment Submitted</span>
                                        {% elseif statusValue == 'edo_generated' %}
                                            <span class="badge badge-success badge-lg">eDO Generated</span>
                                        {% elseif statusValue == 'edo_released' %}
                                            <span class="badge badge-success badge-lg">eDO Released</span>
                                        {% else %}
                                            <span class="badge badge-ghost badge-lg">{{ manifest.workflowState.getDisplayName() }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if item.containers_with_edo > 0 %}
                                            {% if item.all_edos_paid %}
                                                <span class="badge badge-success badge-lg gap-2">
                                                    <span class="icon-[tabler--check] size-3"></span>
                                                    All Paid
                                                </span>
                                            {% elseif item.edos_paid > 0 %}
                                                <span class="badge badge-info badge-lg gap-2">
                                                    <span class="icon-[tabler--file-check] size-3"></span>
                                                    {{ item.edos_paid }}/{{ item.containers_with_edo }} Paid
                                                </span>
                                            {% else %}
                                                <span class="badge badge-warning badge-lg gap-2">
                                                    <span class="icon-[tabler--clock] size-3"></span>
                                                    Pending
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge badge-ghost badge-lg">N/A</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="text-sm text-base-content/60">{{ manifest.createdAt|date('M j, Y') }}</span>
                                    </td>
                                    <td class="text-right">
                                        <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}" 
                                           class="btn btn-ghost btn-sm gap-2">
                                            <span class="icon-[tabler--eye] size-4"></span>
                                            View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                {% if totalPages > 1 %}
                    <div class="card-body p-4 border-t border-base-300 flex flex-col sm:flex-row items-center justify-between gap-3">
                        <div class="text-sm text-base-content/60">
                            Page {{ currentPage }} of {{ totalPages }}
                        </div>
                        <div class="join">
                            {% if currentPage > 1 %}
                                <a href="{{ path('broker_manifest_list', filters|merge({page: currentPage - 1, tab: currentTab})) }}" 
                                   class="join-item btn btn-sm gap-2">
                                    <span class="icon-[tabler--chevron-left] size-4"></span>
                                    Previous
                                </a>
                            {% endif %}
                            {% if currentPage < totalPages %}
                                <a href="{{ path('broker_manifest_list', filters|merge({page: currentPage + 1, tab: currentTab})) }}" 
                                   class="join-item btn btn-sm gap-2">
                                    Next
                                    <span class="icon-[tabler--chevron-right] size-4"></span>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="card-body items-center text-center py-16">
                    <div class="size-20 bg-base-200 rounded-full flex items-center justify-center mb-6">
                        <span class="icon-[tabler--file-off] size-10 text-base-content/40"></span>
                    </div>
                    <h3 class="text-lg font-bold text-base-content mb-2">No manifests found</h3>
                    <p class="text-sm text-base-content/60 mb-6">No manifests match your current filters.</p>
                    {% if filters.status or filters.date_from or filters.date_to %}
                        <a href="{{ path('broker_manifest_list', {tab: currentTab}) }}" class="btn btn-ghost">
                            Clear Filters
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
