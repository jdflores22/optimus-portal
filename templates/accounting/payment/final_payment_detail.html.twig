{% extends 'base.html.twig' %}

{% block title %}Payment Validation - {{ payment.manifest.manifestNumber }}{% endblock %}

{% block body %}
<div class="w-full bg-base-200 min-h-screen">
<div class="w-full px-4 sm:px-6 lg:px-8 py-6">
    {# Breadcrumb #}
    <div class="breadcrumbs text-sm mb-4">
        <ul>
            <li><a href="{{ path('accounting_payment_dashboard') }}"><span class="icon-[tabler--home] size-4"></span> Dashboard</a></li>
            <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right]"></span></li>
            <li><a href="{{ path('accounting_payment_final_list') }}">Final Payments</a></li>
            <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right]"></span></li>
            <li aria-current="page">Payment #{{ payment.id }}</li>
        </ul>
    </div>

    {# Status Banner #}
    <div class="mb-6">
        {% if payment.status.value == 'pending_validation' %}
            <div class="alert alert-warning shadow-lg">
                <span class="icon-[tabler--clock] size-6"></span>
                <div class="flex-1">
                    <h3 class="font-bold text-lg">Pending Validation</h3>
                    <p class="text-sm">This payment is awaiting your review and approval.</p>
                </div>
            </div>
        {% elseif payment.status.value == 'verified' %}
            <div class="alert alert-success shadow-lg">
                <span class="icon-[tabler--circle-check] size-6"></span>
                <div class="flex-1">
                    <h3 class="font-bold text-lg">Payment Verified</h3>
                    <p class="text-sm">Verified by {{ payment.validatedBy.fullName }} on {{ payment.validatedAt|date('F d, Y H:i') }}</p>
                </div>
            </div>
        {% elseif payment.status.value == 'rejected' %}
            <div class="alert alert-error shadow-lg">
                <span class="icon-[tabler--circle-x] size-6"></span>
                <div class="flex-1">
                    <h3 class="font-bold text-lg">Payment Rejected</h3>
                    <p class="text-sm">{{ payment.rejectionReason }}</p>
                    <p class="text-xs mt-1">Rejected by {{ payment.validatedBy.fullName }} on {{ payment.validatedAt|date('F d, Y H:i') }}</p>
                </div>
            </div>
            <div class="alert alert-info mt-4">
                <span class="icon-[tabler--info-circle] size-5"></span>
                <div>
                    <p class="text-sm font-medium">Broker needs to resubmit payment with corrected proof of payment.</p>
                </div>
            </div>
        {% endif %}
    </div>

    {# Main Content - 3 Column Layout #}
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-6">
        
        {# LEFT COLUMN - Payment & Manifest Info #}
        <div class="space-y-6">
            {# Payment Summary Card #}
            <div class="card bg-base-100 shadow-lg">
                <div class="card-header bg-gradient-to-r from-primary to-primary/80 text-primary-content">
                    <h3 class="card-title text-lg">
                        <span class="icon-[tabler--receipt] size-5"></span>
                        Payment Summary
                    </h3>
                </div>
                <div class="card-body space-y-4">
                    <div>
                        <div class="text-xs text-base-content/60 mb-1">Payment ID</div>
                        <div class="text-lg font-bold">#{{ payment.id }}</div>
                    </div>
                    <div class="divider my-2"></div>
                    <div>
                        <div class="text-xs text-base-content/60 mb-1">Manifest Number</div>
                        <a href="{{ path('manifest_workflow_detail', {id: payment.manifest.id}) }}" 
                           class="text-base font-semibold text-primary hover:text-primary/80">
                            {{ payment.manifest.manifestNumber }}
                        </a>
                    </div>
                    <div>
                        <div class="text-xs text-base-content/60 mb-1">Consignee</div>
                        <div class="text-sm font-medium">
                            {% if payment.manifest.consignee %}
                                {{ payment.manifest.consignee.businessName }}
                            {% else %}
                                <span class="text-base-content/40">Not declared</span>
                            {% endif %}
                        </div>
                    </div>
                    <div>
                        <div class="text-xs text-base-content/60 mb-1">Broker</div>
                        <div class="text-sm font-medium">
                            {% if payment.manifest.broker %}
                                {{ payment.manifest.broker.fullName }}
                            {% else %}
                                <span class="text-base-content/40">None</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="divider my-2"></div>
                    <div>
                        <div class="text-xs text-base-content/60 mb-1">Submitted By</div>
                        <div class="text-sm font-medium">{{ payment.submittedBy.fullName }}</div>
                        <div class="text-xs text-base-content/60">{{ payment.submittedBy.email }}</div>
                    </div>
                    <div>
                        <div class="text-xs text-base-content/60 mb-1">Submitted At</div>
                        <div class="text-sm font-medium">{{ payment.createdAt|date('F d, Y') }}</div>
                        <div class="text-xs text-base-content/60">{{ payment.createdAt|date('H:i:s') }}</div>
                    </div>
                </div>
            </div>

            {# Amount Comparison Card #}
            <div class="card bg-base-100 shadow-lg {% if discrepancy > 0.01 %}border-2 border-error{% endif %}">
                <div class="card-header {% if discrepancy > 0.01 %}bg-error/10{% else %}bg-success/10{% endif %}">
                    <h3 class="card-title text-base">
                        <span class="icon-[tabler--calculator] size-5"></span>
                        Amount Verification
                    </h3>
                </div>
                <div class="card-body space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-base-content/60">Billing Amount</span>
                        <div class="text-right">
                            {% if billing.originalCurrency == 'USD' %}
                                <div class="flex items-center gap-2">
                                    <span class="text-xl font-bold">${{ billing.totalAmountUsd|number_format(2) }}</span>
                                    <span class="badge badge-warning badge-sm font-bold">USD</span>
                                </div>
                                {% if billing.exchangeRate %}
                                    <div class="text-xs text-base-content/60">(₱{{ billing.totalAmount|number_format(2) }} PHP at rate {{ billing.exchangeRate }})</div>
                                {% endif %}
                            {% else %}
                                <div class="flex items-center gap-2">
                                    <span class="text-xl font-bold">₱{{ billing.totalAmount|number_format(2) }}</span>
                                    <span class="badge badge-info badge-sm font-bold">PHP</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-base-content/60">Payment Amount</span>
                        <div class="text-right">
                            <div class="flex items-center gap-2">
                                <span class="text-xl font-bold">{% if payment.currency == 'USD' %}${% else %}₱{% endif %}{{ payment.amount|number_format(2) }}</span>
                                <span class="badge {% if payment.currency == 'USD' %}badge-warning{% else %}badge-info{% endif %} badge-sm font-bold">{{ payment.currency }}</span>
                            </div>
                        </div>
                    </div>
                    
                    {# Currency Mismatch Warning #}
                    {% if billing.originalCurrency and payment.currency and billing.originalCurrency != payment.currency %}
                        <div class="alert alert-error py-2 text-xs">
                            <span class="icon-[tabler--alert-triangle] size-4"></span>
                            <span><strong>CURRENCY MISMATCH:</strong> Billing is in {{ billing.originalCurrency }} but payment was submitted in {{ payment.currency }}. Verify with broker.</span>
                        </div>
                    {% endif %}
                    
                    <div class="divider my-2"></div>
                    <div class="text-center p-4 rounded-lg {% if discrepancy > 0.01 %}bg-error/10{% else %}bg-success/10{% endif %}">
                        {% if discrepancy > 0.01 %}
                            <div class="text-error mb-2">
                                <span class="icon-[tabler--alert-triangle] size-8 inline-block"></span>
                            </div>
                            <div class="text-sm font-bold text-error mb-1">MISMATCH DETECTED</div>
                            <div class="text-2xl font-bold text-error">₱{{ discrepancy|number_format(2) }}</div>
                            <div class="text-xs text-error/80 mt-2">Justification required if approving</div>
                        {% else %}
                            <div class="text-success mb-2">
                                <span class="icon-[tabler--circle-check] size-8 inline-block"></span>
                            </div>
                            <div class="text-sm font-bold text-success mb-1">AMOUNTS MATCH</div>
                            <div class="text-xs text-success/80">Perfect match</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Billing Breakdown Card #}
            <div class="card bg-base-100 shadow-lg">
                <div class="card-header bg-base-200">
                    <h3 class="card-title text-base">
                        <span class="icon-[tabler--file-invoice] size-5"></span>
                        Billing Breakdown
                    </h3>
                </div>
                <div class="card-body space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-base-content/60">Freight Charges</span>
                        <span class="font-medium">₱{{ billing.freightCharges|number_format(2) }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-base-content/60">THC Charges</span>
                        <span class="font-medium">₱{{ billing.thcCharges|number_format(2) }}</span>
                    </div>
                    {% if billing.additionalCharges %}
                        {% for charge in billing.additionalCharges %}
                            <div class="flex justify-between">
                                <span class="text-base-content/60">{{ charge.description }}</span>
                                <span class="font-medium">₱{{ charge.amount|number_format(2) }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                    <div class="divider my-2"></div>
                    <div class="flex justify-between text-base font-bold">
                        <span>Total</span>
                        <span class="text-primary">₱{{ billing.totalAmount|number_format(2) }}</span>
                    </div>
                    <div class="pt-3 mt-3 border-t text-xs text-base-content/60">
                        <div>Generated by: {{ billing.generatedBy.fullName }}</div>
                        <div>Date: {{ billing.createdAt|date('M d, Y H:i') }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# MIDDLE COLUMN - Billing Document #}
        <div>
            <div class="card bg-base-100 shadow-lg h-full">
                <div class="card-header bg-primary text-primary-content flex justify-between items-center">
                    <h3 class="card-title">
                        <span class="icon-[tabler--file-text] size-5"></span>
                        Billing Document
                    </h3>
                    {% if billing %}
                        <a href="/api/billing/{{ billing.id }}/download?inline=false" target="_blank" 
                           class="btn btn-sm btn-ghost hover:bg-primary-content/20">
                            <span class="icon-[tabler--download] size-4"></span>
                            Download
                        </a>
                    {% endif %}
                </div>
                <div class="p-0">
                    {% if billing %}
                        <div class="bg-base-200" style="height: 800px;">
                            <iframe src="/api/billing/{{ billing.id }}/download?inline=true" 
                                    class="w-full h-full border-0"></iframe>
                        </div>
                    {% else %}
                        <div class="flex flex-col items-center justify-center p-12 text-center bg-base-200" style="height: 800px;">
                            <span class="icon-[tabler--file-off] size-20 text-base-content/20 mb-4"></span>
                            <p class="text-base-content/60 font-medium mb-2">No billing found</p>
                            <p class="text-sm text-base-content/40">Billing information is not available</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# RIGHT COLUMN - Payment Receipt #}
        <div>
            <div class="card bg-base-100 shadow-lg h-full">
                <div class="card-header bg-success text-success-content flex justify-between items-center">
                    <h3 class="card-title">
                        <span class="icon-[tabler--receipt-2] size-5"></span>
                        Payment Receipt
                    </h3>
                    <a href="{{ path('accounting_payment_receipt', {id: payment.id}) }}?inline=false" target="_blank" 
                       class="btn btn-sm btn-ghost hover:bg-success-content/20">
                        <span class="icon-[tabler--download] size-4"></span>
                        Download
                    </a>
                </div>
                <div class="p-0">
                    {% if payment.receiptFilePath %}
                        <div class="bg-base-200" style="height: 800px;">
                            <iframe src="{{ path('accounting_payment_receipt', {id: payment.id}) }}?inline=true" 
                                    class="w-full h-full border-0"></iframe>
                        </div>
                    {% else %}
                        <div class="flex flex-col items-center justify-center p-12 text-center" style="height: 800px;">
                            <span class="icon-[tabler--file-off] size-20 text-base-content/20 mb-4"></span>
                            <p class="text-base-content/60">No receipt uploaded</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Official Receipt (if generated) #}
    {% if payment.officialReceiptPath %}
        <div class="card bg-base-100 shadow-lg mb-6">
            <div class="card-header bg-accent text-accent-content flex justify-between items-center">
                <div>
                    <h3 class="card-title">
                        <span class="icon-[tabler--file-certificate] size-5"></span>
                        Official Receipt
                    </h3>
                    <p class="text-sm opacity-80 mt-1">Generated by {{ payment.shippingLine.name }}</p>
                </div>
                <a href="{{ path('accounting_payment_receipt', {id: payment.id}) }}?type=official&inline=false" target="_blank" 
                   class="btn btn-sm btn-ghost hover:bg-accent-content/20">
                    <span class="icon-[tabler--download] size-4"></span>
                    Download
                </a>
            </div>
            <div class="p-0">
                <div class="bg-base-200" style="height: 600px;">
                    <iframe src="{{ path('accounting_payment_receipt', {id: payment.id}) }}?type=official&inline=true" 
                            class="w-full h-full border-0"></iframe>
                </div>
            </div>
        </div>
    {% endif %}

    {# Action Buttons - Sticky at Bottom within content area #}
    {% if payment.status.value == 'pending_validation' %}
        <div class="sticky bottom-0 bg-base-100 border-t border-base-300 shadow-2xl z-40 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
            <div class="py-4">
                <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                    {% if discrepancy > 0.01 %}
                        <div class="alert alert-warning py-2 px-4 flex-1 max-w-md">
                            <span class="icon-[tabler--alert-triangle] size-5"></span>
                            <span class="text-sm">Amount mismatch - justification required</span>
                        </div>
                    {% endif %}
                    <div class="flex gap-3">
                        <button type="button" onclick="openRejectionModal()" 
                                class="btn btn-error btn-lg gap-2 min-w-[180px]">
                            <span class="icon-[tabler--circle-x] size-5"></span>
                            Reject Payment
                        </button>
                        <button type="button" onclick="openApprovalModal()" 
                                class="btn btn-success btn-lg gap-2 min-w-[180px]">
                            <span class="icon-[tabler--circle-check] size-5"></span>
                            Approve Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {# Spacer for sticky buttons #}
        <div class="h-4"></div>
    {% endif %}

    {# Validation History #}
    {% if validationHistory is not empty %}
        <div class="card bg-base-100 shadow-lg">
            <div class="card-header">
                <div>
                    <h3 class="card-title">
                        <span class="icon-[tabler--history] size-5"></span>
                        Validation History
                    </h3>
                    <p class="text-sm text-base-content/60 mt-1">Previous payment attempts for this manifest</p>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Submitted By</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Validated By</th>
                            <th>Date</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for historyPayment in validationHistory %}
                            <tr>
                                <td class="font-medium">#{{ historyPayment.id }}</td>
                                <td>{{ historyPayment.submittedBy.fullName }}</td>
                                <td>₱{{ historyPayment.amount|number_format(2) }}</td>
                                <td>
                                    {% if historyPayment.status.value == 'verified' %}
                                        <span class="badge badge-success badge-sm">Verified</span>
                                    {% elseif historyPayment.status.value == 'rejected' %}
                                        <span class="badge badge-error badge-sm">Rejected</span>
                                    {% endif %}
                                </td>
                                <td>{{ historyPayment.validatedBy.fullName }}</td>
                                <td>{{ historyPayment.validatedAt|date('M d, Y H:i') }}</td>
                                <td>
                                    {% if historyPayment.rejectionReason %}
                                        <div class="max-w-xs truncate" title="{{ historyPayment.rejectionReason }}">
                                            {{ historyPayment.rejectionReason }}
                                        </div>
                                    {% else %}
                                        <span class="text-base-content/40">-</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
</div>

{# Approval Modal #}
<div id="approvalModal" class="hidden fixed inset-0 z-[9999] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeApprovalModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-lg z-10">
        <div class="flex items-center justify-between px-5 py-4 border-b border-base-300">
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center size-10 rounded-full bg-success/10">
                    <span class="icon-[tabler--check] size-5 text-success"></span>
                </div>
                <h3 class="font-semibold text-base text-base-content">Approve Payment</h3>
            </div>
            <button type="button" onclick="closeApprovalModal()" class="btn btn-ghost btn-sm btn-circle">
                <span class="icon-[tabler--x] size-4"></span>
            </button>
        </div>
        <div class="px-5 py-4">
            <p class="text-sm text-base-content/60 mb-3">This action will:</p>
            <ul class="text-sm text-base-content/80 space-y-2 mb-4 list-disc list-inside">
                <li>Mark payment as verified</li>
                <li>Generate official receipt</li>
                <li>Transfer to SL_STAFF for eDO generation</li>
                <li>Notify broker, consignee, and SL_STAFF</li>
            </ul>
            {% if discrepancy > 0.01 %}
                <div class="alert alert-warning mb-4">
                    <span class="icon-[tabler--alert-triangle] size-5"></span>
                    <div>
                        <p class="font-medium">Amount Mismatch</p>
                        <p class="text-xs">Justification required</p>
                    </div>
                </div>
            {% endif %}
            <label for="approvalReason" class="label">
                <span class="label-text">
                    Justification / Notes
                    {% if discrepancy > 0.01 %}<span class="text-error">*</span>{% else %}<span class="text-base-content/40">(Optional)</span>{% endif %}
                </span>
            </label>
            <textarea id="approvalReason" rows="3" class="textarea textarea-bordered w-full" placeholder="Enter justification or notes..."></textarea>
        </div>
        <div class="flex justify-end gap-2 px-5 py-4 border-t border-base-300">
            <button type="button" onclick="closeApprovalModal()" class="btn btn-ghost">Cancel</button>
            <button type="button" id="approvalSubmitBtn" onclick="confirmApproval()" class="btn btn-success gap-1">
                <span class="icon-[tabler--circle-check] size-4"></span>
                Confirm Approval
            </button>
        </div>
    </div>
</div>

{# Rejection Modal #}
<div id="rejectionModal" class="hidden fixed inset-0 z-[9999] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeRejectionModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-lg z-10">
        <div class="flex items-center justify-between px-5 py-4 border-b border-base-300">
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center size-10 rounded-full bg-error/10">
                    <span class="icon-[tabler--x] size-5 text-error"></span>
                </div>
                <h3 class="font-semibold text-base text-base-content">Reject Payment</h3>
            </div>
            <button type="button" onclick="closeRejectionModal()" class="btn btn-ghost btn-sm btn-circle">
                <span class="icon-[tabler--x] size-4"></span>
            </button>
        </div>
        <div class="px-5 py-4">
            <p class="text-sm text-base-content/60 mb-3">This action will:</p>
            <ul class="text-sm text-base-content/80 space-y-2 mb-4 list-disc list-inside">
                <li>Mark payment as rejected</li>
                <li>Revert manifest to billing_generated state</li>
                <li>Notify broker and consignee</li>
                <li>Require broker to resubmit payment</li>
            </ul>
            <label for="rejectionReason" class="label">
                <span class="label-text">Reason for Rejection <span class="text-error">*</span></span>
            </label>
            <textarea id="rejectionReason" rows="4" required class="textarea textarea-bordered w-full" placeholder="Provide detailed reason..."></textarea>
            <label class="label">
                <span class="label-text-alt text-base-content/60">This will be sent to broker and consignee</span>
            </label>
        </div>
        <div class="flex justify-end gap-2 px-5 py-4 border-t border-base-300">
            <button type="button" onclick="closeRejectionModal()" class="btn btn-ghost">Cancel</button>
            <button type="button" id="rejectionSubmitBtn" onclick="confirmRejection()" class="btn btn-error gap-1">
                <span class="icon-[tabler--circle-x] size-4"></span>
                Confirm Rejection
            </button>
        </div>
    </div>
</div>

{# Success Modal #}
<div id="successModal" class="hidden fixed inset-0 z-[10000] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-lg z-10">
        <div class="px-6 pt-8 pb-6 text-center">
            <div class="flex items-center justify-center mb-4">
                <div class="flex items-center justify-center size-20 rounded-full bg-success/20 animate-bounce-once">
                    <span class="icon-[tabler--check] size-12 text-success"></span>
                </div>
            </div>
            <h3 class="text-2xl font-bold text-base-content mb-4">Success!</h3>
            <p class="text-base text-base-content/80 mb-4" id="successMessage"></p>
            <div id="successDetails" class="mt-4 space-y-2 text-sm text-base-content/70"></div>
        </div>
        <div class="px-6 py-4 border-t border-base-300">
            <button type="button" onclick="closeSuccessModal()" class="btn btn-success w-full gap-1">
                <span class="icon-[tabler--check] size-4"></span>
                OK
            </button>
        </div>
    </div>
</div>

{# Error Modal #}
<div id="errorModal" class="hidden fixed inset-0 z-[10000] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-lg z-10">
        <div class="px-6 pt-8 pb-6 text-center">
            <div class="flex items-center justify-center mb-4">
                <div class="flex items-center justify-center size-20 rounded-full bg-error/20 animate-shake">
                    <span class="icon-[tabler--x] size-12 text-error"></span>
                </div>
            </div>
            <h3 class="text-2xl font-bold text-base-content mb-4">Error</h3>
            <p class="text-base text-base-content/80" id="errorMessage"></p>
        </div>
        <div class="px-6 py-4 border-t border-base-300">
            <button type="button" onclick="closeErrorModal()" class="btn btn-error w-full gap-1">
                <span class="icon-[tabler--x] size-4"></span>
                Close
            </button>
        </div>
    </div>
</div>

<style>
@keyframes bounce-once {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}
@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
}
.animate-bounce-once { animation: bounce-once 0.6s ease-in-out; }
.animate-shake { animation: shake 0.5s ease-in-out; }
</style>

<script>
function openApprovalModal() { document.getElementById('approvalModal').classList.remove('hidden'); }
function closeApprovalModal() { document.getElementById('approvalModal').classList.add('hidden'); document.getElementById('approvalReason').value = ''; }
function openRejectionModal() { document.getElementById('rejectionModal').classList.remove('hidden'); }
function closeRejectionModal() { document.getElementById('rejectionModal').classList.add('hidden'); document.getElementById('rejectionReason').value = ''; }

function showSuccessModal(message, details = []) {
    document.getElementById('successMessage').textContent = message;
    const detailsContainer = document.getElementById('successDetails');
    detailsContainer.innerHTML = '';
    if (details.length > 0) {
        details.forEach(detail => {
            const div = document.createElement('div');
            div.className = 'flex items-center justify-center text-success';
            div.innerHTML = `<span class="icon-[tabler--circle-check] size-5 mr-2 flex-shrink-0"></span><span>${detail}</span>`;
            detailsContainer.appendChild(div);
        });
    }
    document.getElementById('successModal').classList.remove('hidden');
}

function closeSuccessModal() {
    document.getElementById('successModal').classList.add('hidden');
    window.location.reload();
}

function showErrorModal(message) {
    document.getElementById('errorMessage').textContent = message;
    document.getElementById('errorModal').classList.remove('hidden');
}

function closeErrorModal() {
    document.getElementById('errorModal').classList.add('hidden');
}

function confirmApproval() {
    const reason = document.getElementById('approvalReason').value.trim();
    const hasDiscrepancy = {{ discrepancy > 0.01 ? 'true' : 'false' }};
    if (hasDiscrepancy && !reason) {
        alert('Please provide justification for the amount override.');
        return;
    }
    const submitBtn = document.getElementById('approvalSubmitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span>Processing...';
    fetch(`/api/payments/{{ payment.id }}/validate-final`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved: true, reason: reason || null })
    })
    .then(response => response.json())
    .then(data => {
        if (data.error) {
            let errorMsg = 'Failed to approve payment. Please try again.';
            if (typeof data.error === 'string') errorMsg = data.error;
            else if (data.message) errorMsg = data.message;
            closeApprovalModal();
            showErrorModal(errorMsg);
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span class="icon-[tabler--circle-check] size-4"></span>Confirm Approval';
        } else if (data.success) {
            closeApprovalModal();
            const details = [];
            if (data.officialReceiptGenerated) details.push('Official Receipt has been generated');
            if (data.nextStep) details.push(data.nextStep);
            showSuccessModal(data.message || 'Payment approved successfully!', details);
        } else {
            closeApprovalModal();
            showSuccessModal('Payment approved successfully! Official receipt has been issued. Manifest transferred to SL_STAFF for eDO generation.');
        }
    })
    .catch(error => {
        closeApprovalModal();
        showErrorModal('An error occurred. Please try again.');
        console.error('Error:', error);
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="icon-[tabler--circle-check] size-4"></span>Confirm Approval';
    });
}

function confirmRejection() {
    const reason = document.getElementById('rejectionReason').value.trim();
    if (!reason) {
        alert('Please provide a reason for rejection.');
        return;
    }
    const submitBtn = document.getElementById('rejectionSubmitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span>Processing...';
    fetch(`/api/payments/{{ payment.id }}/validate-final`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved: false, reason: reason })
    })
    .then(response => response.json())
    .then(data => {
        if (data.error) {
            let errorMsg = 'Failed to reject payment. Please try again.';
            if (typeof data.error === 'string') errorMsg = data.error;
            else if (data.message) errorMsg = data.message;
            closeRejectionModal();
            showErrorModal(errorMsg);
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span class="icon-[tabler--circle-x] size-4"></span>Confirm Rejection';
        } else if (data.success) {
            closeRejectionModal();
            showSuccessModal(data.message || 'Payment rejected successfully!');
        } else {
            closeRejectionModal();
            showSuccessModal('Payment rejected successfully!');
        }
    })
    .catch(error => {
        closeRejectionModal();
        showErrorModal('An error occurred. Please try again.');
        console.error('Error:', error);
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="icon-[tabler--circle-x] size-4"></span>Confirm Rejection';
    });
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const approvalModal = document.getElementById('approvalModal');
        const rejectionModal = document.getElementById('rejectionModal');
        if (!approvalModal.classList.contains('hidden')) closeApprovalModal();
        if (!rejectionModal.classList.contains('hidden')) closeRejectionModal();
    }
});
</script>
{% endblock %}
