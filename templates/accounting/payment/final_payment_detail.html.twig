{% extends 'base.html.twig' %}

{% block title %}Review Payment — {{ payment.manifest.manifestNumber }}{% endblock %}
{% block page_title %}Review Payment{% endblock %}

{% set amountsMatch = discrepancy <= 0.01 %}
{% set currencyMismatch = billing.originalCurrency and payment.currency and billing.originalCurrency != payment.currency %}
{% set billingDownloadUrl = path('api_billing_download', {billingId: billing.id}) %}

{% block body %}
<div class="space-y-5 sm:space-y-6 max-w-7xl mx-auto">

    {# Header #}
    <div class="bg-base-100 shadow-sm rounded-xl">
        <div class="p-4 sm:p-6">
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-2">
                        <ul>
                            <li><a href="{{ path('app_accounting_dashboard_new') }}">Accounting</a></li>
                            <li><a href="{{ path('accounting_payment_final_list') }}">Final Payments</a></li>
                            <li><a href="{{ path('accounting_payment_final_list') }}">Final Payments</a></li>
                            <li>#{{ payment.id }}</li>
                        </ul>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="size-12 rounded-xl {% if payment.status.value == 'pending_validation' %}bg-warning/10 text-warning{% elseif payment.status.value == 'verified' %}bg-success/10 text-success{% else %}bg-error/10 text-error{% endif %} flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--receipt-2] size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">
                                {{ payment.manifest.manifestNumber }}
                            </h1>
                            <p class="text-sm text-base-content/60 mt-1">
                                Payment #{{ payment.id }} · Submitted {{ payment.createdAt|date('M j, Y \\a\\t g:i A') }}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                    {% if payment.status.value == 'pending_validation' %}
                        <span class="badge badge-warning badge-lg">Needs your review</span>
                    {% elseif payment.status.value == 'verified' %}
                        <span class="badge badge-success badge-lg">Approved</span>
                    {% else %}
                        <span class="badge badge-error badge-lg">Rejected</span>
                    {% endif %}
                    <a href="{{ path('audit_trail_manifest', {id: payment.manifest.id}) }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--history] size-4"></span>
                        Audit trail
                    </a>
                    <a href="{{ path('accounting_payment_final_list') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to list
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Status message #}
    {% if payment.status.value == 'pending_validation' %}
        <div class="alert alert-warning shadow-sm">
            <span class="icon-[tabler--info-circle] size-5"></span>
            <div>
                <p class="font-medium">Review this payment</p>
                <p class="text-sm opacity-90">Check that the broker’s receipt matches the billing amount, then approve or reject.</p>
            </div>
        </div>
    {% elseif payment.status.value == 'verified' %}
        <div class="alert alert-success shadow-sm">
            <span class="icon-[tabler--circle-check] size-5"></span>
            <div>
                <p class="font-medium">This payment was approved</p>
                <p class="text-sm opacity-90">
                    By {{ payment.validatedBy.fullName }} on {{ payment.validatedAt|date('M j, Y \\a\\t g:i A') }}
                </p>
            </div>
        </div>
    {% else %}
        <div class="alert alert-error shadow-sm">
            <span class="icon-[tabler--circle-x] size-5"></span>
            <div>
                <p class="font-medium">This payment was rejected</p>
                <p class="text-sm opacity-90">{{ payment.rejectionReason ?: 'No reason recorded.' }}</p>
                {% if payment.validatedBy %}
                    <p class="text-xs mt-1 opacity-80">By {{ payment.validatedBy.fullName }} · {{ payment.validatedAt|date('M j, Y g:i A') }}</p>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 xl:grid-cols-5 gap-5 sm:gap-6">

        {# Left — summary & actions #}
        <div class="xl:col-span-2 space-y-5 sm:space-y-6">

            {# Amount check — plain language #}
            <div class="card shadow-sm {% if amountsMatch %}bg-success/5{% else %}bg-warning/5{% endif %}">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="font-semibold text-base-content flex items-center gap-2 mb-4">
                        <span class="icon-[tabler--scale] size-5"></span>
                        Does the amount match?
                    </h2>

                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="rounded-xl bg-base-100/80 p-4">
                            <p class="text-xs text-base-content/60 mb-1">Bill amount</p>
                            {% if billing.originalCurrency == 'USD' %}
                                <p class="text-xl font-bold">{{ billing|format_billing }}</p>
                                <p class="text-xs text-base-content/50 mt-1">≈ {{ billing.totalAmount|format_money('PHP') }}</p>
                            {% else %}
                                <p class="text-xl font-bold">{{ billing|format_billing }}</p>
                            {% endif %}
                        </div>
                        <div class="rounded-xl bg-base-100/80 p-4">
                            <p class="text-xs text-base-content/60 mb-1">Broker paid</p>
                            <p class="text-xl font-bold">{{ payment|format_payment }}</p>
                            <p class="text-xs text-base-content/50 mt-1">{{ payment.currency }}</p>
                        </div>
                    </div>

                    {% if currencyMismatch %}
                        <div class="rounded-xl bg-error/10 p-3 text-sm text-error mb-3 flex gap-2">
                            <span class="icon-[tabler--alert-triangle] size-4 shrink-0 mt-0.5"></span>
                            <span>Billing is in {{ billing.originalCurrency }} but payment was sent in {{ payment.currency }}. Double-check before approving.</span>
                        </div>
                    {% endif %}

                    {% if amountsMatch %}
                        <div class="flex items-center gap-3 rounded-xl bg-success/10 p-4 text-success">
                            <span class="icon-[tabler--circle-check] size-8 shrink-0"></span>
                            <div>
                                <p class="font-semibold">Yes — amounts match</p>
                                <p class="text-sm opacity-90">You can approve if the receipt looks correct.</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="flex items-center gap-3 rounded-xl bg-warning/10 p-4 text-warning">
                            <span class="icon-[tabler--alert-triangle] size-8 shrink-0"></span>
                            <div>
                                <p class="font-semibold">No — difference of {{ discrepancy|format_money(payment.currency) }}</p>
                                <p class="text-sm opacity-90">If you still approve, you must add a short note explaining why.</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Shipment info #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-6 space-y-4">
                    <h2 class="font-semibold text-base-content flex items-center gap-2">
                        <span class="icon-[tabler--ship] size-5 text-base-content/70"></span>
                        Shipment details
                    </h2>
                    <dl class="space-y-3 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-base-content/60">Manifest</dt>
                            <dd class="font-medium text-right">
                                <a href="{{ path('manifest_workflow_detail', {id: payment.manifest.id}) }}" class="link link-primary">
                                    {{ payment.manifest.manifestNumber }}
                                </a>
                            </dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-base-content/60">Consignee</dt>
                            <dd class="font-medium text-right">{{ payment.manifest.consignee ? payment.manifest.consignee.businessName : 'Not set' }}</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-base-content/60">Broker</dt>
                            <dd class="font-medium text-right">{{ payment.manifest.broker ? payment.manifest.broker.fullName : 'Not set' }}</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-base-content/60">Submitted by</dt>
                            <dd class="text-right">
                                <span class="font-medium">{{ payment.submittedBy.fullName }}</span>
                                <p class="text-xs text-base-content/50">{{ payment.submittedBy.email }}</p>
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Billing breakdown — compact #}
            <details class="card bg-base-100 shadow-sm group">
                <summary class="card-body p-4 sm:p-6 cursor-pointer list-none flex items-center justify-between gap-2">
                    <span class="font-semibold flex items-center gap-2">
                        <span class="icon-[tabler--list-details] size-5 text-base-content/70"></span>
                        Billing breakdown
                    </span>
                    <span class="icon-[tabler--chevron-down] size-4 text-base-content/40 group-open:rotate-180 transition-transform"></span>
                </summary>
                <div class="px-4 sm:px-6 pb-4 sm:pb-6 pt-0 space-y-2 text-sm border-t border-base-200/80">
                    <div class="flex justify-between pt-4">
                        <span class="text-base-content/60">Freight</span>
                        <span>{{ billing|format_billing_charge(billing.freightCharges, billing.freightChargesUsd) }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-base-content/60">THC</span>
                        <span>{{ billing|format_billing_charge(billing.thcCharges, billing.thcChargesUsd) }}</span>
                    </div>
                    {% if billing.additionalCharges %}
                        {% for charge in billing.additionalCharges %}
                            <div class="flex justify-between">
                                <span class="text-base-content/60">{{ charge.description }}</span>
                                <span>{{ charge.amount|format_money(billing.originalCurrency) }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                    <div class="flex justify-between font-semibold pt-2 mt-2 border-t border-base-200/80">
                        <span>Total</span>
                        <span class="text-primary">{{ billing|format_billing }}</span>
                    </div>
                    <p class="text-xs text-base-content/50 pt-2">
                        Issued {{ billing.createdAt|date('M j, Y') }} by {{ billing.generatedBy.fullName }}
                    </p>
                </div>
            </details>

            {# Actions #}
            {% if payment.status.value == 'pending_validation' %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-6">
                        <h2 class="font-semibold text-base-content mb-1">Your decision</h2>
                        <p class="text-sm text-base-content/60 mb-4">After reviewing the documents on the right.</p>
                        <div class="flex flex-col sm:flex-row gap-3">
                            <button type="button" onclick="openApprovalModal()" class="btn btn-success flex-1 gap-2">
                                <span class="icon-[tabler--circle-check] size-5"></span>
                                Approve payment
                            </button>
                            <button type="button" onclick="openRejectionModal()" class="btn btn-ghost text-error hover:bg-error/10 flex-1 gap-2">
                                <span class="icon-[tabler--circle-x] size-5"></span>
                                Reject payment
                            </button>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# Right — documents #}
        <div class="xl:col-span-3">
            <div class="card bg-base-100 shadow-sm h-full">
                <div class="px-4 sm:px-6 py-4 bg-base-200/50 rounded-t-xl">
                    <h2 class="font-semibold text-base-content mb-3">Documents to review</h2>
                    <div class="flex flex-wrap gap-2" role="tablist">
                        <button type="button" class="doc-tab btn btn-sm btn-primary" data-doc="billing" aria-selected="true">
                            <span class="icon-[tabler--file-invoice] size-4"></span>
                            Billing
                        </button>
                        <button type="button" class="doc-tab btn btn-sm btn-ghost" data-doc="receipt">
                            <span class="icon-[tabler--receipt] size-4"></span>
                            Payment proof
                        </button>
                        {% if payment.officialReceiptPath %}
                            <button type="button" class="doc-tab btn btn-sm btn-ghost" data-doc="official">
                                <span class="icon-[tabler--file-certificate] size-4"></span>
                                Official receipt
                            </button>
                        {% endif %}
                        <a id="doc-download" href="{{ billingDownloadUrl }}?inline=false" target="_blank" rel="noopener"
                           class="btn btn-sm btn-ghost ml-auto gap-1">
                            <span class="icon-[tabler--download] size-4"></span>
                            Download
                        </a>
                    </div>
                </div>
                <div class="p-0">
                    <div id="panel-billing" class="doc-panel">
                        <div class="bg-base-200/50 min-h-[420px] lg:min-h-[calc(100vh-16rem)]">
                            <iframe src="{{ billingDownloadUrl }}?inline=true" class="w-full h-[420px] lg:h-[calc(100vh-16rem)] border-0" title="Billing document"></iframe>
                        </div>
                    </div>
                    <div id="panel-receipt" class="doc-panel hidden">
                        {% if payment.receiptFilePath %}
                            <div class="bg-base-200/50 min-h-[420px] lg:min-h-[calc(100vh-16rem)]">
                                <iframe src="{{ path('accounting_payment_receipt', {id: payment.id}) }}?inline=true" class="w-full h-[420px] lg:h-[calc(100vh-16rem)] border-0" title="Payment receipt"></iframe>
                            </div>
                        {% else %}
                            <div class="flex flex-col items-center justify-center py-20 px-4 text-center">
                                <span class="icon-[tabler--photo-off] size-12 text-base-content/30"></span>
                                <p class="mt-3 font-medium">No payment proof uploaded</p>
                            </div>
                        {% endif %}
                    </div>
                    {% if payment.officialReceiptPath %}
                        <div id="panel-official" class="doc-panel hidden">
                            <div class="bg-base-200/50 min-h-[420px] lg:min-h-[calc(100vh-16rem)]">
                                <iframe src="{{ path('accounting_payment_receipt', {id: payment.id}) }}?type=official&inline=true" class="w-full h-[420px] lg:h-[calc(100vh-16rem)] border-0" title="Official receipt"></iframe>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Previous attempts #}
    {% if validationHistory is not empty %}
        <div class="card bg-base-100 shadow-sm">
            <div class="px-4 sm:px-6 py-4 bg-base-200/50 rounded-t-xl">
                <h2 class="font-semibold text-base-content">Previous attempts</h2>
                <p class="text-sm text-base-content/60 mt-0.5">Earlier payments for this manifest</p>
            </div>
            <div class="divide-y divide-base-200/80">
                {% for historyPayment in validationHistory %}
                    <div class="px-4 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                        <div>
                            <p class="font-medium text-sm">Payment #{{ historyPayment.id }}</p>
                            <p class="text-xs text-base-content/50">{{ historyPayment.submittedBy.fullName }} · {{ historyPayment|format_payment }}</p>
                        </div>
                        <div class="flex items-center gap-3 text-sm">
                            {% if historyPayment.status.value == 'verified' %}
                                <span class="badge badge-success badge-sm">Approved</span>
                            {% else %}
                                <span class="badge badge-error badge-sm">Rejected</span>
                            {% endif %}
                            <span class="text-base-content/50 text-xs">{{ historyPayment.validatedAt|date('M j, Y') }}</span>
                            {% if historyPayment.rejectionReason %}
                                <span class="text-xs text-base-content/60 truncate max-w-[12rem]" title="{{ historyPayment.rejectionReason }}">{{ historyPayment.rejectionReason }}</span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>

{# Approve modal #}
<dialog id="approvalModal" class="modal">
    <div class="modal-box max-w-lg">
        <h3 class="font-bold text-lg flex items-center gap-2">
            <span class="icon-[tabler--circle-check] size-5 text-success"></span>
            Approve this payment?
        </h3>
        <p class="py-3 text-sm text-base-content/70">
            The broker and consignee will be notified. The shipment moves forward for eDO processing.
        </p>
        {% if not amountsMatch %}
            <div class="rounded-xl bg-warning/10 p-3 text-sm text-warning mb-3">
                Amounts do not match — please explain why you are approving anyway.
            </div>
        {% endif %}
        <label class="label pb-1" for="approvalReason">
            <span class="label-text">Note{% if not amountsMatch %} <span class="text-error">(required)</span>{% else %} (optional){% endif %}</span>
        </label>
        <textarea id="approvalReason" rows="3" class="textarea w-full bg-base-200/50 focus:outline-none focus:ring-2 focus:ring-success/30" placeholder="e.g. Verified with bank confirmation"></textarea>
        <div class="modal-action">
            <button type="button" class="btn btn-ghost" onclick="closeApprovalModal()">Cancel</button>
            <button type="button" id="approvalSubmitBtn" onclick="confirmApproval()" class="btn btn-success gap-1">
                <span class="icon-[tabler--check] size-4"></span>
                Yes, approve
            </button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="button" onclick="closeApprovalModal()">close</button></form>
</dialog>

{# Reject modal #}
<dialog id="rejectionModal" class="modal">
    <div class="modal-box max-w-lg">
        <h3 class="font-bold text-lg flex items-center gap-2">
            <span class="icon-[tabler--circle-x] size-5 text-error"></span>
            Reject this payment?
        </h3>
        <p class="py-3 text-sm text-base-content/70">
            The broker will need to upload a new payment proof. Tell them what was wrong.
        </p>
        <label class="label pb-1" for="rejectionReason">
            <span class="label-text">Reason <span class="text-error">(required)</span></span>
        </label>
        <textarea id="rejectionReason" rows="4" class="textarea w-full bg-base-200/50 focus:outline-none focus:ring-2 focus:ring-error/30" placeholder="e.g. Receipt amount does not match billing"></textarea>
        <div class="modal-action">
            <button type="button" class="btn btn-ghost" onclick="closeRejectionModal()">Cancel</button>
            <button type="button" id="rejectionSubmitBtn" onclick="confirmRejection()" class="btn btn-error gap-1">
                <span class="icon-[tabler--x] size-4"></span>
                Yes, reject
            </button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="button" onclick="closeRejectionModal()">close</button></form>
</dialog>

{# Success modal #}
<dialog id="successModal" class="modal">
    <div class="modal-box max-w-md text-center">
        <div class="inline-flex items-center justify-center size-16 rounded-full bg-success/10 text-success mb-4">
            <span class="icon-[tabler--circle-check] size-10"></span>
        </div>
        <h3 class="font-bold text-xl">Done</h3>
        <p class="text-sm text-base-content/70 mt-2" id="successMessage"></p>
        <div id="successDetails" class="mt-3 space-y-1 text-sm text-base-content/60"></div>
        <div class="modal-action justify-center mt-4">
            <button type="button" onclick="closeSuccessModal()" class="btn btn-success">OK</button>
        </div>
    </div>
</dialog>

{# Error modal #}
<dialog id="errorModal" class="modal">
    <div class="modal-box max-w-md text-center">
        <div class="inline-flex items-center justify-center size-16 rounded-full bg-error/10 text-error mb-4">
            <span class="icon-[tabler--alert-circle] size-10"></span>
        </div>
        <h3 class="font-bold text-xl">Something went wrong</h3>
        <p class="text-sm text-base-content/70 mt-2" id="errorMessage"></p>
        <div class="modal-action justify-center mt-4">
            <button type="button" onclick="closeErrorModal()" class="btn btn-ghost">Close</button>
        </div>
    </div>
</dialog>

<script>
(function() {
    const downloadLink = document.getElementById('doc-download');
    const urls = {
        billing: '{{ billingDownloadUrl }}?inline=false',
        receipt: '{{ path('accounting_payment_receipt', {id: payment.id}) }}?inline=false',
        {% if payment.officialReceiptPath %}
        official: '{{ path('accounting_payment_receipt', {id: payment.id}) }}?type=official&inline=false',
        {% endif %}
    };

    document.querySelectorAll('.doc-tab').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const doc = btn.dataset.doc;
            document.querySelectorAll('.doc-tab').forEach(function(b) {
                b.classList.remove('btn-primary');
                b.classList.add('btn-ghost');
                b.setAttribute('aria-selected', 'false');
            });
            btn.classList.add('btn-primary');
            btn.classList.remove('btn-ghost');
            btn.setAttribute('aria-selected', 'true');
            document.querySelectorAll('.doc-panel').forEach(function(p) { p.classList.add('hidden'); });
            const panel = document.getElementById('panel-' + doc);
            if (panel) panel.classList.remove('hidden');
            if (downloadLink && urls[doc]) downloadLink.href = urls[doc];
        });
    });
})();

function openApprovalModal() { document.getElementById('approvalModal').showModal(); }
function closeApprovalModal() { document.getElementById('approvalModal').close(); document.getElementById('approvalReason').value = ''; }
function openRejectionModal() { document.getElementById('rejectionModal').showModal(); }
function closeRejectionModal() { document.getElementById('rejectionModal').close(); document.getElementById('rejectionReason').value = ''; }

function showSuccessModal(message, details = []) {
    document.getElementById('successMessage').textContent = message;
    const detailsContainer = document.getElementById('successDetails');
    detailsContainer.innerHTML = '';
    details.forEach(function(detail) {
        const div = document.createElement('p');
        div.textContent = detail;
        detailsContainer.appendChild(div);
    });
    document.getElementById('successModal').showModal();
}

function closeSuccessModal() {
    document.getElementById('successModal').close();
    window.location.reload();
}

function showErrorModal(message) {
    document.getElementById('errorMessage').textContent = message;
    document.getElementById('errorModal').showModal();
}

function closeErrorModal() {
    document.getElementById('errorModal').close();
}

function confirmApproval() {
    const reason = document.getElementById('approvalReason').value.trim();
    const hasDiscrepancy = {{ amountsMatch ? 'false' : 'true' }};
    if (hasDiscrepancy && !reason) {
        alert('Please add a short note explaining the amount difference.');
        return;
    }
    const submitBtn = document.getElementById('approvalSubmitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Working…';
    fetch('/api/payments/{{ payment.id }}/validate-final', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved: true, reason: reason || null })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.error) {
            closeApprovalModal();
            showErrorModal(typeof data.error === 'string' ? data.error : (data.message || 'Could not approve. Try again.'));
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span class="icon-[tabler--check] size-4"></span> Yes, approve';
        } else {
            closeApprovalModal();
            const details = [];
            if (data.officialReceiptGenerated) details.push('Official receipt created.');
            if (data.nextStep) details.push(data.nextStep);
            showSuccessModal(data.message || 'Payment approved.', details);
        }
    })
    .catch(function() {
        closeApprovalModal();
        showErrorModal('Could not approve. Try again.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="icon-[tabler--check] size-4"></span> Yes, approve';
    });
}

function confirmRejection() {
    const reason = document.getElementById('rejectionReason').value.trim();
    if (!reason) {
        alert('Please tell the broker why this payment is being rejected.');
        return;
    }
    const submitBtn = document.getElementById('rejectionSubmitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Working…';
    fetch('/api/payments/{{ payment.id }}/validate-final', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved: false, reason: reason })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.error) {
            closeRejectionModal();
            showErrorModal(typeof data.error === 'string' ? data.error : (data.message || 'Could not reject. Try again.'));
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span class="icon-[tabler--x] size-4"></span> Yes, reject';
        } else {
            closeRejectionModal();
            showSuccessModal(data.message || 'Payment rejected. The broker can submit again.');
        }
    })
    .catch(function() {
        closeRejectionModal();
        showErrorModal('Could not reject. Try again.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="icon-[tabler--x] size-4"></span> Yes, reject';
    });
}
</script>
{% endblock %}
