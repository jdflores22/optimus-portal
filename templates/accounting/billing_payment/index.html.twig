{% extends 'base.html.twig' %}

{% block title %}Billing Payments - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Header -->
    <div class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="py-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">Billing Payments</h1>
                        <p class="mt-2 text-sm text-gray-600">Shipping line billing payment validations</p>
                    </div>
                    <a href="{{ path('app_accounting_dashboard_new') }}" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Filter -->
        <div class="mb-6 bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <form method="GET" class="flex items-center gap-4">
                <label for="status" class="text-sm font-medium text-gray-700">Status:</label>
                <select id="status" name="status" onchange="this.form.submit()" class="px-4 py-2 text-sm border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                    <option value="">All</option>
                    {% for status in paymentStatuses %}
                        <option value="{{ status.value }}" {% if statusFilter == status.value %}selected{% endif %}>
                            {{ status.value|replace({'_': ' '})|title }}
                        </option>
                    {% endfor %}
                </select>
            </form>
        </div>

        <!-- Payments Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            {% if payments|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Manifest #</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Broker</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Shipping Line</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for payment in payments %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">{{ payment.manifest.manifestNumber }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">{{ payment.manifest.broker.fullName }}</div>
                                <div class="text-xs text-gray-500">{{ payment.manifest.broker.email }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">{{ payment.shippingLine.brandName }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">₱{{ payment.amount|number_format(2) }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-500">{{ payment.createdAt|date('M d, Y H:i') }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if payment.status.value == 'pending_validation' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">Pending</span>
                                {% elseif payment.status.value == 'verified' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Verified</span>
                                {% elseif payment.status.value == 'rejected' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Rejected</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="{{ path('accounting_billing_payment_receipt', {id: payment.id}) }}?inline=true" target="_blank" class="text-blue-600 hover:text-blue-900 mr-3">View Receipt</a>
                                {% if payment.status.value == 'pending_validation' %}
                                    <button onclick="openValidationModal({{ payment.id }}, '{{ payment.manifest.manifestNumber }}', '{{ path('accounting_billing_payment_receipt', {id: payment.id}) }}')" class="text-green-600 hover:text-green-900">Validate</button>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            {% if totalPages > 1 %}
            <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
                <div class="flex items-center justify-between">
                    <div class="text-sm text-gray-700">
                        Showing page {{ currentPage }} of {{ totalPages }} ({{ total }} total)
                    </div>
                    <div class="flex gap-2">
                        {% if currentPage > 1 %}
                            <a href="?page={{ currentPage - 1 }}{% if statusFilter %}&status={{ statusFilter }}{% endif %}" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Previous</a>
                        {% endif %}
                        {% if currentPage < totalPages %}
                            <a href="?page={{ currentPage + 1 }}{% if statusFilter %}&status={{ statusFilter }}{% endif %}" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Next</a>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}
            {% else %}
            <div class="text-center py-16">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4">
                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <h3 class="text-base font-medium text-gray-900">No billing payments found</h3>
                <p class="mt-2 text-sm text-gray-500">No payments match the selected filter.</p>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Validation Modal -->
<div id="validationModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-10 mx-auto p-6 border w-full max-w-4xl shadow-lg rounded-lg bg-white">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Validate Payment</h3>
            <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        
        <p class="text-sm text-gray-600 mb-4">Manifest: <span id="modalManifestNumber" class="font-medium"></span></p>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Receipt Preview -->
            <div class="border border-gray-300 rounded-lg p-4 bg-gray-50">
                <h4 class="text-sm font-medium text-gray-700 mb-3">Payment Receipt</h4>
                <div id="receiptPreview" class="bg-white rounded border border-gray-200 overflow-hidden" style="height: 500px;">
                    <iframe id="receiptFrame" class="w-full h-full" style="border: none;"></iframe>
                </div>
                <div class="mt-2 text-center">
                    <a id="receiptDownloadLink" href="#" target="_blank" class="text-sm text-blue-600 hover:text-blue-800">
                        <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Download Receipt
                    </a>
                </div>
            </div>
            
            <!-- Validation Form -->
            <div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Action</label>
                    <select id="validationAction" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        <option value="approve">Approve Payment</option>
                        <option value="reject">Reject Payment</option>
                    </select>
                </div>
                
                <div id="rejectionReasonDiv" class="mb-4 hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Rejection Reason <span class="text-red-500">*</span></label>
                    <textarea id="rejectionReason" rows="4" placeholder="Provide a clear reason for rejection..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
                    <p class="mt-1 text-xs text-gray-500">This reason will be sent to the broker.</p>
                </div>
                
                <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg mb-4">
                    <div class="flex">
                        <svg class="h-5 w-5 text-yellow-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        <div>
                            <p class="text-sm text-yellow-700">
                                Please verify the payment receipt matches the billing amount before approving.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="flex gap-3">
                    <button onclick="submitValidation()" class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Submit Validation
                    </button>
                    <button onclick="closeModal()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentPaymentId = null;

document.getElementById('validationAction').addEventListener('change', function() {
    document.getElementById('rejectionReasonDiv').classList.toggle('hidden', this.value !== 'reject');
});

function openValidationModal(id, manifestNumber, receiptUrl) {
    currentPaymentId = id;
    document.getElementById('modalManifestNumber').textContent = manifestNumber;
    
    // Set receipt preview
    const receiptFrame = document.getElementById('receiptFrame');
    receiptFrame.src = receiptUrl + '?inline=true';
    
    // Set download link
    const downloadLink = document.getElementById('receiptDownloadLink');
    downloadLink.href = receiptUrl + '?inline=false';
    
    document.getElementById('validationModal').classList.remove('hidden');
}

function closeModal() {
    document.getElementById('validationModal').classList.add('hidden');
    document.getElementById('receiptFrame').src = '';
    document.getElementById('rejectionReason').value = '';
    document.getElementById('validationAction').value = 'approve';
    document.getElementById('rejectionReasonDiv').classList.add('hidden');
    currentPaymentId = null;
}

function submitValidation() {
    const action = document.getElementById('validationAction').value;
    const reason = document.getElementById('rejectionReason').value;
    
    if (action === 'reject' && !reason.trim()) {
        alert('Please provide a rejection reason');
        return;
    }
    
    // Disable button to prevent double submission
    const submitBtn = event.target;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Processing...';
    
    fetch(`/accounting/billing-payments/${currentPaymentId}/validate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            approved: action === 'approve',
            reason: reason
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert('Error: ' + data.message);
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Validation';
        }
    })
    .catch(error => {
        alert('An error occurred');
        console.error(error);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Validation';
    });
}
</script>
{% endblock %}
