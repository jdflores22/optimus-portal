{% extends 'base.html.twig' %}

{% block title %}Verify Detention Payment - Accounting{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Header Section -->
    <div class="bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center gap-3">
                <a href="{{ path('accounting_billing_detention_pending') }}" class="btn btn-ghost btn-sm btn-circle">
                    <span class="icon-[tabler--arrow-left] size-5"></span>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-base-content">Verify Detention Payment</h1>
                    <p class="text-sm text-base-content/60 mt-1">Review and verify payment receipt for detention charges</p>
                </div>
            </div>
        </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-8 py-6">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning mb-4">
                <span class="icon-[tabler--alert-triangle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- 2-Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column: Details (2/3 width) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Billing Information Card -->
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title text-lg flex items-center gap-2">
                            <span class="icon-[tabler--file-invoice] size-5"></span>
                            Billing Information
                        </h2>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Billing ID</label>
                                <p class="text-sm font-semibold">#{{ billing.id }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Billing Type</label>
                                <span class="badge badge-warning">{{ billing.billingType|upper }}</span>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Created Date</label>
                                <p class="text-sm">{{ billing.createdAt|date('M j, Y') }}</p>
                                <p class="text-xs opacity-60">{{ billing.createdAt|date('g:i A') }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Generated By</label>
                                <p class="text-sm">{{ billing.generatedBy.email }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Currency</label>
                                <p class="text-sm font-semibold">{{ billing.originalCurrency }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detention Charge Breakdown Card -->
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title text-lg flex items-center gap-2">
                            <span class="icon-[tabler--calculator] size-5"></span>
                            Detention Charge Breakdown
                        </h2>
                        
                        <div class="bg-base-200 rounded-lg p-4 mt-4 space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-sm opacity-70">Detention Days</span>
                                <span class="text-sm font-semibold">{{ billing.detentionDays }} days</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm opacity-70">Detention Rate</span>
                                <span class="text-sm font-semibold">{{ billing.originalCurrency }} {{ billing.detentionRate|number_format(2) }}/day</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm opacity-70">Freight Charges</span>
                                <span class="text-sm font-semibold">{{ billing.originalCurrency }} {{ billing.freightCharges|number_format(2) }}</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm opacity-70">THC Charges</span>
                                <span class="text-sm font-semibold">{{ billing.originalCurrency }} {{ billing.thcCharges|number_format(2) }}</span>
                            </div>
                            {% if billing.additionalCharges %}
                                {% for charge in billing.additionalCharges %}
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm opacity-70">{{ charge.description }}</span>
                                        <span class="text-sm font-semibold">{{ billing.originalCurrency }} {{ charge.amount|number_format(2) }}</span>
                                    </div>
                                {% endfor %}
                            {% endif %}
                            <div class="divider my-2"></div>
                            <div class="flex justify-between items-center">
                                <span class="text-base font-bold">Total Amount</span>
                                <span class="text-2xl font-bold text-error">{{ billing.originalCurrency }} {{ billing.totalAmount|number_format(2) }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Renewal Request Details Card -->
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title text-lg flex items-center gap-2">
                            <span class="icon-[tabler--refresh] size-5"></span>
                            Renewal Request Details
                        </h2>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Request ID</label>
                                <p class="text-sm font-semibold">#{{ renewalRequest.id }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Expired eDO</label>
                                <p class="text-sm font-semibold text-primary">{{ expiredEdo.edoNumber }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Requested By</label>
                                <p class="text-sm">{{ renewalRequest.requestedBy.email }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Requested At</label>
                                <p class="text-sm">{{ renewalRequest.requestedAt|date('M j, Y') }}</p>
                                <p class="text-xs opacity-60">{{ renewalRequest.requestedAt|date('g:i A') }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Return Date</label>
                                <p class="text-sm">{{ renewalRequest.emptyContainerReturnDate|date('M j, Y') }}</p>
                                <p class="text-xs opacity-60">{{ renewalRequest.emptyContainerReturnDate|date('g:i A') }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Overdue Days</label>
                                <p class="text-sm font-semibold text-error">{{ renewalRequest.overdueDays }} days</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Status</label>
                                {% set status = renewalRequest.status.value %}
                                {% if status == 'payment_submitted' %}
                                    <span class="badge badge-info">Payment Submitted</span>
                                {% elseif status == 'awaiting_payment' %}
                                    <span class="badge badge-warning">Awaiting Payment</span>
                                {% else %}
                                    <span class="badge badge-ghost">{{ status|replace({'_': ' '})|title }}</span>
                                {% endif %}
                            </div>
                        </div>

                        {% if renewalRequest.additionalNotes %}
                            <div class="mt-6">
                                <label class="block text-xs font-semibold opacity-50 uppercase tracking-wider mb-2">Additional Notes</label>
                                <div class="p-4 bg-base-200 rounded-lg text-sm">{{ renewalRequest.additionalNotes }}</div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Right Column: Payment Receipt & Verification (1/3 width) -->
            <div class="lg:col-span-1">
                <div class="card bg-base-100 shadow-sm sticky top-6">
                    <div class="card-body">
                        <h2 class="card-title text-lg flex items-center gap-2">
                            <span class="icon-[tabler--file-text] size-5"></span>
                            Payment Receipt
                            {# Current Version Badge (6.3.3) #}
                            {% if billing.version %}
                                {% include 'components/payment_version_badge.html.twig' with {
                                    version: billing.version,
                                    status: renewalRequest.paymentVerified ? 'verified' : 'pending',
                                    submittedAt: billing.paymentSubmittedAt,
                                    size: 'sm'
                                } %}
                            {% endif %}
                        </h2>

                        <!-- Receipt Preview -->
                        <div class="mt-4">
                            {% if billing.receiptFilePath %}
                                <div class="bg-base-200 rounded-lg p-4 mb-4">
                                    <div class="flex items-center gap-3 mb-3">
                                        <div class="flex items-center justify-center size-12 rounded-full bg-success/10">
                                            <span class="icon-[tabler--file-check] size-6 text-success"></span>
                                        </div>
                                        <div class="flex-1">
                                            <p class="text-sm font-semibold">Receipt Uploaded</p>
                                            <p class="text-xs opacity-60">{{ billing.paymentSubmittedAt|date('M j, Y g:i A') }}</p>
                                        </div>
                                    </div>
                                    <p class="text-xs opacity-70 mb-3">Submitted by: {{ billing.paymentSubmittedBy.email }}</p>
                                    
                                    {# Link to Previous Version (6.3.4) #}
                                    {% if billing.previousBilling %}
                                        <div class="alert alert-info py-2 px-3 mb-3">
                                            <span class="icon-[tabler--info-circle] size-4"></span>
                                            <div class="text-xs">
                                                <span class="font-semibold">Previous Version:</span>
                                                <a href="{{ path('accounting_billing_verify_payment', {id: billing.previousBilling.id}) }}" 
                                                   class="link link-primary">
                                                    View v{{ billing.previousBilling.version }}
                                                </a>
                                            </div>
                                        </div>
                                    {% endif %}
                                    
                                    <a href="{{ path('accounting_billing_view_receipt', {'id': billing.id}) }}?inline=true" 
                                       target="_blank"
                                       class="btn btn-outline btn-primary btn-block rounded-lg gap-2">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        View Receipt
                                    </a>
                                </div>
                            {% else %}
                                <div class="alert alert-warning">
                                    <span class="icon-[tabler--alert-triangle] size-5"></span>
                                    <span class="text-sm">No receipt uploaded yet</span>
                                </div>
                            {% endif %}
                            
                            {# View History Button (6.3.1) #}
                            {% if billing.version > 1 or billing.edoRenewalRequest %}
                                <button type="button" 
                                        class="btn btn-outline btn-block rounded-lg gap-2 mt-3"
                                        onclick="document.getElementById('payment_history_modal').showModal()">
                                    <span class="icon-[tabler--history] size-4"></span>
                                    View Payment History
                                </button>
                            {% endif %}
                        </div>

                        <div class="divider"></div>

                        <!-- Payment Verification Section -->
                        {% if renewalRequest.paymentVerified %}
                            <div class="alert alert-success">
                                <span class="icon-[tabler--circle-check] size-5"></span>
                                <div>
                                    <h3 class="font-semibold">Payment Verified</h3>
                                    <div class="text-xs opacity-90 mt-1">
                                        Verified by {{ renewalRequest.paymentVerifiedBy.email }}
                                    </div>
                                    <div class="text-xs opacity-90">
                                        {{ renewalRequest.paymentVerifiedAt|date('M j, Y g:i A') }}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="space-y-4">
                                <div class="alert alert-info">
                                    <span class="icon-[tabler--info-circle] size-5"></span>
                                    <div class="text-sm">
                                        Verify that the detention payment has been received before proceeding.
                                    </div>
                                </div>

                                <form method="post" action="{{ path('accounting_billing_verify_payment_post', {'id': billing.id}) }}" id="verifyForm">
                                    <input type="hidden" name="_token" value="{{ csrf_token('verify-payment-' ~ billing.id) }}">
                                    
                                    <div class="form-control">
                                        <label class="label cursor-pointer justify-start gap-3">
                                            <input type="checkbox" id="confirmPayment" class="checkbox checkbox-primary" required>
                                            <span class="label-text text-sm">
                                                I confirm that the payment of <strong class="text-error">{{ billing.originalCurrency }} {{ billing.totalAmount|number_format(2) }}</strong> has been received and verified.
                                            </span>
                                        </label>
                                    </div>
                                    
                                    <button type="submit" class="btn btn-success btn-block rounded-lg gap-2 mt-4" id="verifyButton" disabled>
                                        <span class="icon-[tabler--check] size-5"></span>
                                        Verify Payment
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Payment History Modal (6.3.2) #}
<dialog id="payment_history_modal" class="modal">
    <div class="modal-box max-w-4xl">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        <h3 class="font-bold text-lg mb-4">Payment History</h3>
        
        <div id="payment_history_content">
            {# Payment History Timeline Component Integration (6.3.2) #}
            {% if billingHistory is defined and billingHistory is not empty %}
                {% include 'components/billing_history_timeline.html.twig' with {
                    billings: billingHistory,
                    statistics: billingStatistics,
                    showActions: true,
                    compact: false
                } %}
            {% else %}
                <div class="flex flex-col items-center justify-center py-12">
                    <span class="loading loading-spinner loading-lg text-primary"></span>
                    <p class="text-sm text-base-content/60 mt-4">Loading payment history...</p>
                </div>
            {% endif %}
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>

<script>
    // Enable verify button only when checkbox is checked
    const confirmCheckbox = document.getElementById('confirmPayment');
    const verifyButton = document.getElementById('verifyButton');
    const verifyForm = document.getElementById('verifyForm');
    
    if (confirmCheckbox && verifyButton) {
        confirmCheckbox.addEventListener('change', function() {
            verifyButton.disabled = !this.checked;
        });
    }

    // Handle form submission with AJAX
    if (verifyForm) {
        verifyForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Disable button and show loading state
            verifyButton.disabled = true;
            const originalContent = verifyButton.innerHTML;
            verifyButton.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Verifying Payment...';
            
            try {
                const formData = new FormData(verifyForm);
                const response = await fetch(verifyForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();

                if (data.success) {
                    // Show success toast
                    if (window.notyf) {
                        window.notyf.success(data.message || 'Payment verified successfully!');
                    }
                    
                    // Redirect after short delay
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '{{ path('accounting_billing_detention_pending') }}';
                    }, 1500);
                } else {
                    // Show error toast
                    if (window.notyf) {
                        window.notyf.error(data.message || 'Failed to verify payment. Please try again.');
                    }
                    
                    // Restore button
                    verifyButton.disabled = false;
                    verifyButton.innerHTML = originalContent;
                }
            } catch (error) {
                console.error('Error:', error);
                
                // Show error toast
                if (window.notyf) {
                    window.notyf.error('An error occurred. Please try again.');
                }
                
                // Restore button
                verifyButton.disabled = false;
                verifyButton.innerHTML = originalContent;
            }
        });
    }
    
    // Load payment history when modal is opened
    const paymentHistoryModal = document.getElementById('payment_history_modal');
    if (paymentHistoryModal) {
        paymentHistoryModal.addEventListener('show', async function() {
            // Check if history is already loaded
            const historyContent = document.getElementById('payment_history_content');
            if (historyContent && historyContent.querySelector('.billing-history-timeline')) {
                return; // Already loaded
            }
            
            // Load payment history via AJAX
            try {
                const response = await fetch('{{ path('api_billing_history_renewal_request', {id: renewalRequest.id}) }}');
                const data = await response.json();
                
                if (data.success && data.billings) {
                    // Render the timeline with the fetched data
                    // For now, we'll just reload the page to show the history
                    // In a more sophisticated implementation, you could dynamically update the DOM
                }
            } catch (error) {
                console.error('Failed to load payment history:', error);
            }
        });
    }
</script>
{% endblock %}
