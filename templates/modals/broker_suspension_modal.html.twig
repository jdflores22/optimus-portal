{% if app.user and app.user.role.value == 'BROKER' and app.user.status.value == 'DENIED' %}
<!-- Broker Suspension Modal (Non-dismissible) -->
<div id="brokerSuspensionModal" class="fixed inset-0 z-[10000] overflow-y-auto" style="display: block;">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 transition-opacity bg-gray-900 bg-opacity-75"></div>

        <!-- Modal panel -->
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
            <!-- Header -->
            <div class="bg-red-600 px-6 py-4">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1-1.964-1-2.732 0L3.732 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-xl font-bold text-white">Account Suspended</h3>
                        <p class="text-sm text-red-100 mt-0.5">Your account has been temporarily suspended</p>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div id="suspensionContent" class="px-6 py-5">
                <!-- Suspension Details -->
                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-900 mb-3">Suspension Reason:</h4>
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                        <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ app.user.deactivationReason ?? 'No reason provided' }}</p>
                    </div>
                </div>

                <!-- Suspension Attachments -->
                {% if app.user.suspensionAttachments and app.user.suspensionAttachments|length > 0 %}
                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-900 mb-3">Supporting Documents:</h4>
                    <div class="space-y-2">
                        {% for attachment in app.user.suspensionAttachments %}
                        <a href="{{ attachment }}" target="_blank" download 
                           class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                </svg>
                                <span class="text-sm text-gray-700">{{ attachment|split('/')|last }}</span>
                            </div>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                            </svg>
                        </a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Appeal Form -->
                <div id="appealForm">
                    <h4 class="text-sm font-semibold text-gray-900 mb-3">Submit an Appeal:</h4>
                    <form id="suspensionAppealForm" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label for="appeal_letter" class="block text-sm font-medium text-gray-700 mb-2">
                                Appeal Letter <span class="text-red-500">*</span>
                            </label>
                            <textarea id="appeal_letter" name="appeal_letter" rows="6" required
                                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                      placeholder="Explain why you believe your account should be reactivated..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="appeal_attachments" class="block text-sm font-medium text-gray-700 mb-2">
                                Supporting Documents (Optional)
                            </label>
                            <input type="file" id="appeal_attachments" name="appeal_attachments[]" multiple
                                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <p class="text-xs text-gray-500 mt-1">You can upload multiple files (PDF, DOC, DOCX, JPG, PNG)</p>
                        </div>

                        <div class="flex space-x-3">
                            <button type="submit" id="submitAppealBtn"
                                    class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                <span id="submitAppealText">Submit Appeal</span>
                                <svg id="submitAppealSpinner" class="hidden animate-spin ml-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </button>
                            <a href="{{ path('app_logout') }}"
                               class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                                Logout
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Waiting for Review Message (Hidden by default) -->
                <div id="waitingMessage" class="hidden">
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 text-center">
                        <svg class="mx-auto h-12 w-12 text-blue-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h4 class="text-lg font-semibold text-blue-900 mb-2">Appeal Submitted</h4>
                        <p class="text-sm text-blue-700 mb-4">Your appeal has been submitted successfully. Please wait for the System Administrator to review your request.</p>
                        <p class="text-xs text-blue-600">You will be notified via email once your appeal has been reviewed.</p>
                    </div>
                    <div class="mt-4">
                        <a href="{{ path('app_logout') }}"
                           class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Prevent escape key from closing modal
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && document.getElementById('brokerSuspensionModal')) {
            e.preventDefault();
            e.stopPropagation();
        }
    });

    // Check if user already has a pending appeal
    fetch('{{ path('broker_appeal_status') }}')
        .then(response => response.json())
        .then(data => {
            if (data.hasAppeal && data.status === 'pending') {
                // Show waiting message, hide form
                document.getElementById('appealForm').classList.add('hidden');
                document.getElementById('waitingMessage').classList.remove('hidden');
            }
        })
        .catch(error => console.error('Error checking appeal status:', error));

    // Handle appeal form submission
    const form = document.getElementById('suspensionAppealForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submitAppealBtn');
            const submitText = document.getElementById('submitAppealText');
            const submitSpinner = document.getElementById('submitAppealSpinner');

            // Disable button and show spinner
            submitBtn.disabled = true;
            submitText.textContent = 'Submitting...';
            submitSpinner.classList.remove('hidden');

            const formData = new FormData(form);

            fetch('{{ path('broker_submit_appeal') }}', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Hide form, show waiting message
                    document.getElementById('appealForm').classList.add('hidden');
                    document.getElementById('waitingMessage').classList.remove('hidden');
                } else {
                    alert('Error: ' + data.message);
                    submitBtn.disabled = false;
                    submitText.textContent = 'Submit Appeal';
                    submitSpinner.classList.add('hidden');
                }
            })
            .catch(error => {
                alert('An error occurred. Please try again.');
                submitBtn.disabled = false;
                submitText.textContent = 'Submit Appeal';
                submitSpinner.classList.add('hidden');
            });
        });
    }
});
</script>
{% endif %}
