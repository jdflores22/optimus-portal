{% extends 'base.html.twig' %}

{% block title %}Create Bill of Lading (BL){% endblock %}

{% block page_title %}Create Bill of Lading{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white shadow-sm rounded-lg">
        <!-- Header -->
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">New Bill of Lading (BL) Creation</h2>
            <p class="mt-1 text-sm text-gray-600">Create a BL by selecting an NOA and uploading the Bill of Lading document</p>
        </div>

        <!-- Form -->
        <form id="manifestCreationForm" class="px-6 py-6 space-y-6" enctype="multipart/form-data">
            <!-- NOA Selection -->
            <div>
                <label for="noaId" class="block text-sm font-medium text-gray-700">Select NOA (Required) *</label>
                <select id="noaId" name="noaId" required
                        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    <option value="">Select an existing NOA</option>
                    {# NOAs will be loaded dynamically #}
                </select>
                <p class="mt-1 text-sm text-gray-500">⚠️ You must create a NOA first before creating a BL</p>
                <p class="mt-1 text-sm text-red-600 hidden" id="noaIdError"></p>
            </div>

            <!-- NOA Details Display -->
            <div id="noaDetailsDisplay" class="hidden bg-gray-50 border border-gray-200 rounded-lg p-4">
                <h3 class="text-sm font-medium text-gray-900 mb-3">Selected NOA Details</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="font-medium text-gray-700">NOA Number:</span>
                        <span class="text-gray-900" id="displayNoaNumber">-</span>
                    </div>
                    <div>
                        <span class="font-medium text-gray-700">BL Number:</span>
                        <span class="text-gray-900" id="displayBlNumber">-</span>
                    </div>
                    <div>
                        <span class="font-medium text-gray-700">Vessel Number:</span>
                        <span class="text-gray-900" id="displayVesselNumber">-</span>
                    </div>
                    <div>
                        <span class="font-medium text-gray-700">ETA:</span>
                        <span class="text-gray-900" id="displayEta">-</span>
                    </div>
                    <div>
                        <span class="font-medium text-gray-700">CY Location:</span>
                        <span class="text-gray-900" id="displayCyLocation">-</span>
                    </div>
                    <div>
                        <span class="font-medium text-gray-700">Container Count:</span>
                        <span class="text-gray-900" id="displayContainerCount">-</span>
                    </div>
                </div>
            </div>

            <!-- BL File Upload -->
            <div>
                <label for="blFile" class="block text-sm font-medium text-gray-700">Bill of Lading (BL) File *</label>
                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md hover:border-blue-400 transition-colors">
                    <div class="space-y-1 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <div class="flex text-sm text-gray-600">
                            <label for="blFile" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                                <span>Upload a file</span>
                                <input id="blFile" name="blFile" type="file" class="sr-only" accept=".pdf,.jpg,.jpeg,.png" required>
                            </label>
                            <p class="pl-1">or drag and drop</p>
                        </div>
                        <p class="text-xs text-gray-500">PDF, JPG, PNG up to 10MB</p>
                    </div>
                </div>
                <p class="mt-2 text-sm text-gray-600" id="fileNameDisplay"></p>
                <p class="mt-1 text-sm text-red-600 hidden" id="blFileError"></p>
            </div>

            <!-- BL Number Validation -->
            <div>
                <label for="blNumberValidation" class="block text-sm font-medium text-gray-700">BL Number (for validation) *</label>
                <input type="text" id="blNumberValidation" name="blNumberValidation" required maxlength="50"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                       placeholder="Enter BL number to validate against NOA">
                <p class="mt-1 text-sm text-gray-500">This must match the BL number from the selected NOA</p>
                <p class="mt-1 text-sm text-red-600 hidden" id="blNumberValidationError"></p>
            </div>

            <!-- Confirmation Message -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-blue-800">Important - Workflow Order</h3>
                        <div class="mt-2 text-sm text-blue-700">
                            <p class="mb-2">The correct workflow is:</p>
                            <ol class="list-decimal list-inside space-y-1">
                                <li><strong>First:</strong> NOA (Notice of Arrival) must be created by Terminal Team</li>
                                <li><strong>Second:</strong> BL (Bill of Lading) is created by Broker (this step)</li>
                                <li><strong>Third:</strong> System automatically generates eDO for each container</li>
                            </ol>
                            <p class="mt-2">Upon successful BL creation, a separate eDO will be generated for each container in the selected NOA.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-end space-x-3 pt-6 border-t border-gray-200">
                <a href="{{ path('broker_manifest_list') }}"
                   class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Cancel
                </a>
                <button type="submit" id="submitBtn"
                        class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Create BL
                </button>
            </div>
        </form>
    </div>
</div>

<script src="{{ asset('js/manifest-creation.js') }}"></script>
{% endblock %}
