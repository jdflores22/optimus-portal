{% extends 'base.html.twig' %}

{% block title %}Payment Verification - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Top Navigation -->
    <nav class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <span class="text-2xl font-bold text-blue-600">OPTIMUS</span>
                    <span class="ml-4 text-gray-600">Accounting Portal</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Professional Header -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-center">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:space-x-4 space-y-2 sm:space-y-0">
                        <a href="{{ path('payment_list') }}" class="text-blue-600 hover:text-blue-800 flex items-center text-sm w-fit">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                            Back to Payments
                        </a>
                        <div class="hidden sm:block h-4 w-px bg-gray-300"></div>
                        <div>
                            <h1 class="text-xl sm:text-2xl font-semibold text-gray-900">Payment Verification</h1>
                            <span class="text-sm text-gray-500">Payment #{{ payment.id }}</span>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center justify-end gap-3">
                        {% if payment.status.value == 'PENDING' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                <div class="w-2 h-2 bg-yellow-400 rounded-full mr-2 animate-pulse"></div>
                                Pending Review
                            </span>
                        {% elseif payment.status.value == 'VERIFIED' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                </svg>
                                Verified
                            </span>
                        {% elseif payment.status.value == 'REJECTED' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                </svg>
                                Rejected
                            </span>
                        {% endif %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            {% if app.user.role.value == 'ACCOUNTING' %}
                                Accounting Access
                            {% else %}
                                System Admin Access
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="mb-6 bg-green-50 border-l-4 border-green-400 p-4 rounded-r-md">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-green-700">{{ message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-6 bg-red-50 border-l-4 border-red-400 p-4 rounded-r-md">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-700">{{ message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Payment Proof Document Section -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-6">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
                            <!-- Left Column: Title and Info -->
                            <div>
                                <h2 class="text-xl font-semibold text-gray-900">Payment Proof Document</h2>
                                <p class="text-sm text-gray-600">Submitted by {{ payment.broker.fullName }} on {{ payment.createdAt|date('M j, Y') }}</p>
                            </div>
                            
                            <!-- Right Column: Buttons and Badge -->
                            <div class="flex flex-wrap items-center justify-end gap-3">
                                {% if payment.proofFilePath %}
                                    <button type="button" 
                                            data-file-path="{{ payment.proofFilePath }}" 
                                            data-document-name="Payment Proof Document"
                                            class="view-document-btn inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                        View
                                    </button>
                                    <a href="{{ path('payment_file_download', {fileId: payment.proofFilePath}) }}" 
                                       class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                        </svg>
                                        Download
                                    </a>
                                {% else %}
                                    <div class="inline-flex items-center px-3 py-2 bg-red-100 text-red-800 font-medium rounded-lg">
                                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                        </svg>
                                        Document Missing
                                    </div>
                                {% endif %}
                                
                                <!-- Status Badge -->
                                {% if payment.status.value == 'PENDING' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                                        Pending
                                    </span>
                                {% elseif payment.status.value == 'VERIFIED' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                        Verified
                                    </span>
                                {% elseif payment.status.value == 'REJECTED' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                        Rejected
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Key Identifiers Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- B/L Number - Highlighted -->
                    {% if payment.shipment.blNo %}
                        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                            <div class="px-6 py-4 border-b border-gray-200 bg-blue-50">
                                <h3 class="text-lg font-medium text-blue-900">Bill of Lading (B/L)</h3>
                            </div>
                            <div class="px-6 py-6">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">B/L Number</p>
                                        <p class="text-xl font-bold text-gray-900">{{ payment.shipment.blNo }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Container Number - Highlighted as Important -->
                    {% if payment.shipment.containerNumber %}
                        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                            <div class="px-6 py-4 border-b border-gray-200 bg-green-100">
                                <h3 class="text-lg font-medium text-green-900">Container Number</h3>
                            </div>
                            <div class="px-6 py-6">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">Container Number</p>
                                        <p class="text-xl font-bold text-gray-900 font-mono">{{ payment.shipment.containerNumber }}</p>
                                        <div class="flex items-center mt-1 space-x-4">
                                            {% if payment.shipment.containerType %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                                    {{ payment.shipment.containerType }}
                                                </span>
                                            {% endif %}
                                            {% if payment.shipment.containerSize %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                                    {{ payment.shipment.containerSize }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
                <!-- Shipment Information -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Shipment Information</h3>
                    </div>
                    <div class="px-6 py-6">
                        <!-- Consignee Information -->
                        {% if payment.shipment.consignee %}
                            <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m0 0h2M7 7h10M7 11h4m6 0h4"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">Consignee</p>
                                        <p class="text-base font-semibold text-gray-900">{{ payment.shipment.consignee.businessName }}</p>
                                        <p class="text-sm text-gray-600">{{ payment.shipment.consignee.email }}</p>
                                        <div class="mt-1">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium 
                                                {% if payment.shipment.consignee.status.value == 'APPROVED' %}bg-green-100 text-green-800
                                                {% elseif payment.shipment.consignee.status.value == 'PENDING' %}bg-yellow-100 text-yellow-800
                                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                                {{ payment.shipment.consignee.status.value|title }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Broker Information -->
                        <div class="mb-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                            <div class="flex items-start space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-sm font-medium text-gray-500">Payment Submitted by Broker</p>
                                            <p class="text-base font-semibold text-gray-900">{{ payment.broker.fullName }}</p>
                                            <p class="text-sm text-gray-600">{{ payment.broker.email }}</p>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-xs text-gray-500">Submitted on</p>
                                            <p class="text-sm font-medium text-gray-900">{{ payment.createdAt|date('M j, Y g:i A') }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Details Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Manifest Number</dt>
                                <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.manifestNumber }}</dd>
                            </div>

                            {% if payment.shipment.deliveryOrderNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Delivery Order No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.deliveryOrderNo }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.vessel %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Vessel</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.vessel }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.voyage %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Voyage</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.voyage }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.lloydsNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">LLOYDS No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.lloydsNo }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.custStatus %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customs Status</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.custStatus }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.custRef %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customs Reference</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.custRef }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.vesselCustomNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Vessel Custom No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.vesselCustomNo }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.agentCustomRegNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Agent Custom Reg No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.agentCustomRegNo }}</dd>
                                </div>
                            {% endif %}

                            {% if payment.shipment.custId %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customer ID</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ payment.shipment.custId }}</dd>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Container Information -->
                {% if payment.shipment.containerNumber or payment.shipment.containerType or payment.shipment.containerSize %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-medium text-gray-900">Container Details</h3>
                            </div>
                        </div>
                        <div class="px-6 py-6">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                {% if payment.shipment.containerNumber %}
                                    <div class="md:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Container Number</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900 font-mono bg-green-50 px-3 py-2 rounded border border-green-200">{{ payment.shipment.containerNumber }}</dd>
                                    </div>
                                {% endif %}

                                {% if payment.shipment.containerType %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Container Type</dt>
                                        <dd class="mt-1">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                                {{ payment.shipment.containerType }}
                                            </span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if payment.shipment.containerSize %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Container Size</dt>
                                        <dd class="mt-1">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                                {{ payment.shipment.containerSize }}
                                            </span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if payment.shipment.emptyReturnAddress %}
                                    <div class="md:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Empty Return Address</dt>
                                        <dd class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded border">
                                            <pre class="whitespace-pre-wrap font-sans">{{ payment.shipment.emptyReturnAddress }}</pre>
                                        </dd>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Commodity Information -->
                {% if payment.shipment.commodity or payment.shipment.commodityPcs or payment.shipment.commodityQty or payment.shipment.netWtKgm or payment.shipment.measCbm %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-medium text-gray-900">Commodity Information</h3>
                            </div>
                        </div>
                        <div class="px-6 py-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {% if payment.shipment.commodity %}
                                    <div class="md:col-span-2 lg:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Commodity</dt>
                                        <dd class="mt-1 text-base font-semibold text-gray-900 bg-purple-50 px-3 py-2 rounded border border-purple-200">{{ payment.shipment.commodity }}</dd>
                                    </div>
                                {% endif %}

                                {% if payment.shipment.commodityPcs %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Pieces (PCS)</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">{{ payment.shipment.commodityPcs }}</dd>
                                    </div>
                                {% endif %}

                                {% if payment.shipment.commodityQty %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Quantity (QTY)</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">{{ payment.shipment.commodityQty }}</dd>
                                    </div>
                                {% endif %}

                                {% if payment.shipment.netWtKgm %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Net Weight</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">
                                            {{ payment.shipment.netWtKgm }} <span class="text-sm font-normal text-gray-500">KGM</span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if payment.shipment.measCbm %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Measurement</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">
                                            {{ payment.shipment.measCbm }} <span class="text-sm font-normal text-gray-500">CBM</span>
                                        </dd>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Dates & Timeline -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Timeline</h3>
                    </div>
                    <div class="px-6 py-6">
                        <div class="space-y-4">
                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-900">Notice of Arrival</p>
                                    <p class="text-sm text-gray-600">{{ payment.shipment.noticeOfArrivalDate|date('F j, Y \a\t g:i A') }}</p>
                                </div>
                            </div>

                            {% if payment.shipment.actualArrivalDate %}
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Actual Arrival</p>
                                        <p class="text-sm text-gray-600">{{ payment.shipment.actualArrivalDate|date('F j, Y \a\t g:i A') }}</p>
                                    </div>
                                </div>
                            {% endif %}

                            {% if payment.shipment.generalDeclarationDt %}
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">General Declaration</p>
                                        <p class="text-sm text-gray-600">{{ payment.shipment.generalDeclarationDt|date('F j, Y') }}</p>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center">
                                        <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-900">Payment Submitted</p>
                                    <p class="text-sm text-gray-600">{{ payment.createdAt|date('F j, Y \a\t g:i A') }}</p>
                                </div>
                            </div>

                            {% if payment.verifiedAt %}
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-{% if payment.status.value == 'VERIFIED' %}green{% else %}red{% endif %}-100 rounded-full flex items-center justify-center">
                                            {% if payment.status.value == 'VERIFIED' %}
                                                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                                </svg>
                                            {% else %}
                                                <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                                </svg>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Payment {{ payment.status.value|title }}</p>
                                        <p class="text-sm text-gray-600">{{ payment.verifiedAt|date('F j, Y \a\t g:i A') }} by {{ payment.verifiedBy.email }}</p>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Billing Information -->
                {% if payment.shipment.billingInformation %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <h3 class="text-lg font-medium text-gray-900">Billing Information</h3>
                        </div>
                        <div class="px-6 py-6">
                            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                <pre class="text-sm text-gray-700 whitespace-pre-wrap font-sans">{{ payment.shipment.billingInformation }}</pre>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
            <!-- Right Column - Clean Status Cards -->
            <div class="space-y-6">
                <!-- Payment Status Card -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-6">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
                            <!-- Left Column: Title and Info -->
                            <div>
                                <h2 class="text-xl font-semibold text-gray-900">Payment Status</h2>
                                <p class="text-sm text-gray-600">Submitted by {{ payment.broker.fullName }} on {{ payment.createdAt|date('M j, Y') }}</p>
                            </div>

                            <!-- Right Column: Buttons and Badge -->
                            <div class="flex flex-wrap items-center justify-end gap-3">
                                {% if payment.status.value == 'PENDING' and app.user.role.value == 'ACCOUNTING' %}
                                    <button type="button" 
                                            onclick="confirmVerification()"
                                            class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                        </svg>
                                        Verify Payment
                                    </button>
                                    <button type="button" 
                                            onclick="confirmRejection()"
                                            class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                        </svg>
                                        Reject Payment
                                    </button>
                                {% endif %}
                                
                                <!-- Status Badge -->
                                {% if payment.status.value == 'PENDING' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                                        Pending
                                    </span>
                                {% elseif payment.status.value == 'VERIFIED' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                        Verified
                                    </span>
                                {% elseif payment.status.value == 'REJECTED' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                        Rejected
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Status Message (Full Width Below) -->
                        {% if payment.status.value == 'VERIFIED' or payment.status.value == 'PENDING' or payment.status.value == 'REJECTED' %}
                            <div class="mt-6">
                                {% if payment.status.value == 'VERIFIED' %}
                                    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                                        <h3 class="text-base font-semibold text-green-900 mb-2">Payment Verified!</h3>
                                        <p class="text-sm text-green-700">Your payment has been verified by accounting staff.</p>
                                    </div>
                                {% elseif payment.status.value == 'PENDING' %}
                                    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                                        <h3 class="text-base font-semibold text-yellow-900 mb-2">Payment Under Review</h3>
                                        <p class="text-sm text-yellow-700">Your payment is currently being reviewed by accounting staff.</p>
                                    </div>
                                {% elseif payment.status.value == 'REJECTED' %}
                                    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                                        <h3 class="text-base font-semibold text-red-900 mb-2">Payment Rejected</h3>
                                        <p class="text-sm text-red-700">Your payment has been rejected. Please resubmit with correct documentation.</p>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <!-- Hidden form for verification actions -->
                        {% if payment.status.value == 'PENDING' and app.user.role.value == 'ACCOUNTING' %}
                            <form method="post" id="verificationForm" class="hidden">
                                <!-- Form will be submitted via JavaScript -->
                            </form>
                        {% endif %}
                    </div>
                </div>

                <!-- Electronic Delivery Order Card (only show for verified payments) -->
                {% if payment.status.value == 'VERIFIED' and payment.edo %}
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
                        <div class="flex items-center">
                            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">Electronic Delivery Order</h2>
                                <p class="text-sm text-gray-600">EDO #{{ payment.edo.edoNumber }}</p>
                            </div>
                        </div>
                    </div>
                    <div class="px-6 py-6">
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-4 bg-green-50 rounded-lg border border-green-200">
                                <div class="flex items-center">
                                    <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3">
                                        <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-green-900">EDO Generated</p>
                                        <p class="text-xs text-green-700">{{ payment.verifiedAt|date('F j, Y g:i A') }}</p>
                                    </div>
                                </div>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Ready for Download
                                </span>
                            </div>
                            
                            <div class="grid grid-cols-1 gap-3">
                            <button type="button" 
                                    data-payment-id="{{ payment.id }}"
                                    class="view-edo-btn w-full flex items-center justify-center px-4 py-3 border border-green-300 text-sm font-medium rounded-lg text-green-700 bg-green-50 hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                View EDO PDF
                            </button>
                            
                            <a href="{{ path('payment_edo_download', {paymentId: payment.id}) }}" 
                               class="w-full flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors shadow-sm">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                Download EDO PDF
                            </a>
                        </div>
                        
                        <div class="mt-4 p-3 bg-blue-50 rounded-lg border border-blue-200">
                            <div class="flex items-start">
                                <svg class="w-5 h-5 text-blue-400 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                </svg>
                                <div>
                                    <p class="text-sm font-medium text-blue-900">EDO Information</p>
                                    <p class="text-xs text-blue-800 mt-1">
                                        This Electronic Delivery Order has been automatically generated and sent to the broker and consignee via email. 
                                        The EDO serves as authorization for cargo release.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<!-- Document Modal -->
<div id="documentModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm overflow-y-auto h-full w-full hidden z-50 flex items-center justify-center p-4">
    <div class="relative bg-white rounded-2xl shadow-2xl max-w-5xl w-full max-h-[95vh] flex flex-col border border-gray-200">
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-200 bg-white rounded-t-2xl">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-slate-800" id="modalTitle">Document Viewer</h3>
                    <p class="text-gray-500 text-sm" id="modalSubtitle">Loading document...</p>
                </div>
            </div>
            <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg p-2 transition-all duration-200">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        
        <!-- Modal Body -->
        <div class="flex-1 p-6 overflow-auto bg-gray-50">
            <div id="documentContent" class="flex items-center justify-center min-h-[500px] bg-white rounded-xl border border-gray-200 shadow-sm">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-16 w-16 border-4 border-blue-200 border-t-blue-600 mx-auto mb-4"></div>
                    <p class="text-gray-600 font-medium">Loading document...</p>
                    <p class="text-sm text-gray-500 mt-1">Please wait while we prepare your document</p>
                </div>
            </div>
        </div>
        
        <!-- Modal Footer -->
        <div class="flex items-center justify-between p-6 border-t border-gray-200 bg-white rounded-b-2xl">
            <div class="flex items-center text-sm text-gray-700 font-medium">
                <svg class="w-4 h-4 mr-2 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Digitally secured document
            </div>
            <div class="flex items-center space-x-3">
                <a id="downloadLink" href="#" target="_blank" 
                   class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 shadow-sm">
                    <svg class="w-4 h-4 mr-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Download
                </a>
                <button type="button" id="closeModalFooterBtn" 
                        class="px-6 py-3 bg-gray-200 text-gray-800 font-semibold rounded-xl hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-gray-300 transition-all duration-200">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmationModal" class="fixed inset-0 z-50 hidden" aria-labelledby="confirmation-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity" aria-hidden="true"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="relative bg-white rounded-xl shadow-2xl max-w-md w-full transform transition-all">
            <div class="px-6 py-6">
                <div class="flex items-start space-x-4">
                    <div id="confirmationIcon" class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center">
                        <!-- Icon will be set by JavaScript -->
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-lg font-semibold text-gray-900 mb-2" id="confirmationTitle">
                            <!-- Title will be set by JavaScript -->
                        </h3>
                        <p class="text-sm text-gray-600" id="confirmationMessage">
                            <!-- Message will be set by JavaScript -->
                        </p>
                    </div>
                </div>
            </div>
            <div class="flex items-center justify-end space-x-3 px-6 py-4 border-t border-gray-200 bg-gray-50 rounded-b-xl">
                <button type="button" onclick="closeConfirmationModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 transition-colors">
                    Cancel
                </button>
                <button type="button" id="confirmationSubmit" class="px-4 py-2 text-sm font-medium text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors">
                    <!-- Button text and color will be set by JavaScript -->
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Document modal functions
function viewDocument(filePath, documentName) {
    const modal = document.getElementById('documentModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalSubtitle = document.getElementById('modalSubtitle');
    const documentContent = document.getElementById('documentContent');
    const downloadLink = document.getElementById('downloadLink');
    
    modalTitle.textContent = documentName;
    modalSubtitle.textContent = 'Official payment verification document';
    downloadLink.href = `/payment/file/${filePath}`;
    
    modal.classList.remove('hidden');
    
    documentContent.innerHTML = `
        <div class="text-center">
            <div class="animate-spin rounded-full h-16 w-16 border-4 border-blue-200 border-t-blue-600 mx-auto mb-4"></div>
            <p class="text-gray-600 font-medium">Loading document...</p>
            <p class="text-sm text-gray-500 mt-1">Please wait while we prepare your document</p>
        </div>
    `;
    
    fetch(`/payment/file/${filePath}/view`)
        .then(response => {
            if (!response.ok) throw new Error('Document not found');
            return response.blob();
        })
        .then(blob => {
            const url = URL.createObjectURL(blob);
            const contentType = blob.type;
            
            if (contentType.startsWith('image/') || documentName.toLowerCase().match(/\.(jpg|jpeg|png|gif|bmp|webp)$/i)) {
                createImageElement(url, documentName);
            } else if (contentType === 'application/pdf' || documentName.toLowerCase().endsWith('.pdf')) {
                createPdfElement(url);
            } else {
                showUnsupportedFormat();
            }
        })
        .catch(error => showDocumentError(error.message));
}

function viewEDODocument(paymentId) {
    const modal = document.getElementById('documentModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalSubtitle = document.getElementById('modalSubtitle');
    const documentContent = document.getElementById('documentContent');
    const downloadLink = document.getElementById('downloadLink');
    
    modalTitle.textContent = 'Electronic Delivery Order (EDO)';
    modalSubtitle.textContent = 'Official cargo release document';
    downloadLink.href = `/payment/edo/${paymentId}/download`;
    
    modal.classList.remove('hidden');
    
    documentContent.innerHTML = `
        <div class="text-center">
            <div class="animate-spin rounded-full h-16 w-16 border-4 border-green-200 border-t-green-600 mx-auto mb-4"></div>
            <p class="text-gray-600 font-medium">Loading EDO document...</p>
            <p class="text-sm text-gray-500 mt-1">Please wait while we prepare your document</p>
        </div>
    `;
    
    fetch(`/payment/edo/${paymentId}/view`)
        .then(response => {
            if (!response.ok) throw new Error('EDO document not found');
            return response.blob();
        })
        .then(blob => {
            const url = URL.createObjectURL(blob);
            createPdfElement(url);
        })
        .catch(error => showDocumentError(error.message));
}

function createImageElement(url, documentName) {
    const documentContent = document.getElementById('documentContent');
    const img = document.createElement('img');
    img.src = url;
    img.alt = documentName;
    img.className = 'max-w-full max-h-[500px] object-contain rounded-lg shadow-lg mx-auto';
    
    img.onload = function() {
        documentContent.innerHTML = '';
        documentContent.appendChild(img);
    };
    img.onerror = function() {
        showDocumentError('Failed to load image');
    };
}

function createPdfElement(url) {
    const documentContent = document.getElementById('documentContent');
    const iframe = document.createElement('iframe');
    iframe.src = url;
    iframe.className = 'w-full border rounded-lg';
    iframe.style.height = '500px';
    
    documentContent.innerHTML = '';
    documentContent.appendChild(iframe);
    
    iframe.onerror = function() {
        showDocumentError('Failed to load PDF');
    };
}

function showDocumentError(message) {
    const documentContent = document.getElementById('documentContent');
    documentContent.innerHTML = `
        <div class="text-center py-8">
            <svg class="w-16 h-16 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-red-600 mb-2">Error loading document</p>
            <p class="text-sm text-gray-500">${message}</p>
        </div>
    `;
}

function showUnsupportedFormat() {
    const documentContent = document.getElementById('documentContent');
    documentContent.innerHTML = `
        <div class="text-center py-8">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <p class="text-gray-600 mb-4">Preview not available for this file type</p>
            <p class="text-sm text-gray-500">Click download to view the document</p>
        </div>
    `;
}

function closeModal() {
    const modal = document.getElementById('documentModal');
    modal.classList.add('hidden');
    
    const iframe = modal.querySelector('iframe');
    const img = modal.querySelector('img');
    if (iframe && iframe.src.startsWith('blob:')) {
        URL.revokeObjectURL(iframe.src);
    }
    if (img && img.src.startsWith('blob:')) {
        URL.revokeObjectURL(img.src);
    }
}

function confirmVerification() {
    showConfirmationModal(
        'Verify Payment',
        'Are you sure you want to verify this payment? This action will generate an Electronic Delivery Order (EDO) and cannot be undone.',
        'verify',
        'bg-green-600 hover:bg-green-700 focus:ring-green-500',
        'Verify Payment'
    );
}

function confirmRejection() {
    showConfirmationModal(
        'Reject Payment',
        'Are you sure you want to reject this payment? The broker will need to resubmit their payment proof.',
        'reject',
        'bg-red-600 hover:bg-red-700 focus:ring-red-500',
        'Reject Payment'
    );
}

function showConfirmationModal(title, message, action, buttonClass, buttonText) {
    const modal = document.getElementById('confirmationModal');
    const titleEl = document.getElementById('confirmationTitle');
    const messageEl = document.getElementById('confirmationMessage');
    const submitBtn = document.getElementById('confirmationSubmit');
    const iconEl = document.getElementById('confirmationIcon');
    
    titleEl.textContent = title;
    messageEl.textContent = message;
    submitBtn.textContent = buttonText;
    submitBtn.className = `px-4 py-2 text-sm font-medium text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors ${buttonClass}`;
    
    if (action === 'verify') {
        iconEl.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center bg-green-100';
        iconEl.innerHTML = `<svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
    } else {
        iconEl.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center bg-red-100';
        iconEl.innerHTML = `<svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>`;
    }
    
    submitBtn.onclick = function() { submitVerificationForm(action); };
    modal.classList.remove('hidden');
}

function closeConfirmationModal() {
    document.getElementById('confirmationModal').classList.add('hidden');
}

function submitVerificationForm(action) {
    const submitBtn = document.getElementById('confirmationSubmit');
    submitBtn.disabled = true;
    submitBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-3 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        ${action === 'verify' ? 'Verifying...' : 'Rejecting...'}
    `;
    
    const form = document.getElementById('verificationForm');
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'action';
    input.value = action;
    form.appendChild(input);
    form.submit();
}

// Initialize event listeners
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.view-document-btn').forEach(button => {
        button.addEventListener('click', function() {
            const filePath = this.getAttribute('data-file-path');
            const documentName = this.getAttribute('data-document-name');
            viewDocument(filePath, documentName);
        });
    });
    
    document.querySelectorAll('.view-edo-btn').forEach(button => {
        button.addEventListener('click', function() {
            const paymentId = this.getAttribute('data-payment-id');
            viewEDODocument(paymentId);
        });
    });
    
    document.getElementById('closeModalBtn').addEventListener('click', closeModal);
    document.getElementById('closeModalFooterBtn').addEventListener('click', closeModal);
    
    document.getElementById('documentModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('documentModal');
            if (!modal.classList.contains('hidden')) closeModal();
        }
    });
});
</script>

{% endblock %}