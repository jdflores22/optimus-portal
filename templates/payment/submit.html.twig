{% extends 'base.html.twig' %}

{% block title %}Submit Payment Proof{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Submit Payment Proof</h1>

            <div class="mb-6 p-4 bg-blue-50 rounded-lg">
                <h2 class="text-lg font-semibold text-blue-900 mb-2">Shipment Details</h2>
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="font-medium text-gray-700">Manifest Number:</span>
                        <span class="text-gray-900">{{ shipment.manifestNumber }}</span>
                    </div>
                    <div>
                        <span class="font-medium text-gray-700">Notice of Arrival:</span>
                        <span class="text-gray-900">{{ shipment.noticeOfArrivalDate|date('Y-m-d') }}</span>
                    </div>
                    {% if shipment.actualArrivalDate %}
                    <div>
                        <span class="font-medium text-gray-700">Actual Arrival:</span>
                        <span class="text-gray-900">{{ shipment.actualArrivalDate|date('Y-m-d') }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% if existingPayment %}
                <div class="mb-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <h3 class="text-lg font-semibold text-yellow-800 mb-2">Existing Payment Submission</h3>
                    <p class="text-yellow-700 mb-2">
                        Status: 
                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                            {% if existingPayment.status.value == 'PENDING' %}bg-blue-100 text-blue-800
                            {% elseif existingPayment.status.value == 'VERIFIED' %}bg-green-100 text-green-800
                            {% elseif existingPayment.status.value == 'REJECTED' %}bg-red-100 text-red-800
                            {% endif %}">
                            {{ existingPayment.status.value }}
                        </span>
                    </p>
                    {% if existingPayment.status.value == 'VERIFIED' %}
                        <p class="text-green-700">Your payment has been verified and EDO has been generated.</p>
                    {% elseif existingPayment.status.value == 'REJECTED' %}
                        <p class="text-red-700">Your payment was rejected. Please submit a new payment proof.</p>
                    {% else %}
                        <p class="text-yellow-700">Your payment proof is under review.</p>
                    {% endif %}
                </div>
            {% endif %}

            {% if not existingPayment or existingPayment.status.value == 'REJECTED' %}
                <form method="post" enctype="multipart/form-data" class="space-y-6">
                    <div>
                        <label for="payment_proof" class="block text-sm font-medium text-gray-700 mb-2">
                            Payment Proof Document *
                        </label>
                        <input type="file" 
                               id="payment_proof" 
                               name="payment_proof" 
                               accept=".pdf,.jpg,.jpeg,.png,.docx"
                               required
                               class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                        <p class="mt-1 text-sm text-gray-500">
                            Upload your payment receipt or proof of payment. Accepted formats: PDF, JPG, PNG, DOCX (max 10MB)
                        </p>
                    </div>

                    <div class="flex justify-end space-x-4">
                        <a href="{{ path('broker_shipment_detail', {id: shipment.id}) }}" 
                           class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                            Cancel
                        </a>
                        <button type="submit" 
                                class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700">
                            Submit Payment Proof
                        </button>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}