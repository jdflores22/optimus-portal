<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #3B82F6;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            background-color: #f9f9f9;
            padding: 30px;
            border: 1px solid #ddd;
            border-top: none;
        }
        .info-box {
            background-color: white;
            padding: 15px;
            margin: 20px 0;
            border-left: 4px solid #3B82F6;
        }
        .button {
            display: inline-block;
            padding: 12px 24px;
            background-color: #3B82F6;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 20px;
        }
        .footer {
            text-align: center;
            margin-top: 20px;
            color: #666;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Bill of Lading Uploaded</h1>
        </div>
        <div class="content">
            <p>Hello,</p>
            
            <p><strong>{{ uploader.name }}</strong> has uploaded a Bill of Lading for manifest <strong>{{ manifest.manifestNumber }}</strong>.</p>
            
            <div class="info-box">
                <p><strong>Manifest Number:</strong> {{ manifest.manifestNumber }}</p>
                <p><strong>BL Number:</strong> {{ manifest.blNumber }}</p>
                <p><strong>Uploaded By:</strong> {{ uploader.name }} ({{ uploader.email }})</p>
            </div>
            
            <p>You can now proceed to generate the billing document for this manifest.</p>
            
            <a href="{{ url('manifest_workflow_detail', {id: manifest.id}) }}" class="button">View Manifest</a>
            
            <p style="margin-top: 30px; color: #666; font-size: 14px;">
                This is an automated notification from the Optimus Shipping Portal.
            </p>
        </div>
        <div class="footer">
            <p>&copy; {{ "now"|date("Y") }} Optimus Shipping Portal. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
