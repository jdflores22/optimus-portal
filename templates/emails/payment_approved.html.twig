<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Approved</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #10b981;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            background-color: #f9f9f9;
            padding: 30px;
            border: 1px solid #ddd;
            border-top: none;
        }
        .success-icon {
            font-size: 48px;
            text-align: center;
            margin-bottom: 20px;
        }
        .details {
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            margin: 20px 0;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-weight: bold;
            color: #666;
        }
        .detail-value {
            color: #333;
        }
        .button {
            display: inline-block;
            padding: 12px 30px;
            background-color: #10b981;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 20px;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            color: #666;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>✓ Payment Approved</h1>
    </div>
    
    <div class="content">
        <div class="success-icon">✓</div>
        
        <p>Dear {{ user.fullName }},</p>
        
        <p>Great news! Your {{ paymentType|lower }} payment has been approved by the accounting department.</p>
        
        <div class="details">
            <div class="detail-row">
                <span class="detail-label">Manifest Number:</span>
                <span class="detail-value">{{ manifest.manifestNumber }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Payment Type:</span>
                <span class="detail-value">{{ paymentType }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Payment Amount:</span>
                <span class="detail-value">{{ payment|format_payment }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Payment ID:</span>
                <span class="detail-value">#{{ payment.id }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Approved At:</span>
                <span class="detail-value">{{ payment.validatedAt|date('F d, Y H:i:s') }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Approved By:</span>
                <span class="detail-value">{{ payment.validatedBy.fullName }}</span>
            </div>
        </div>
        
        {% if payment.paymentType.value == 'final_payment' %}
        <p><strong>Next Steps:</strong></p>
        <p>An Electronic Delivery Order (eDO) has been automatically generated for this manifest. You can now proceed with cargo release.</p>
        {% endif %}
        
        <p style="text-align: center;">
            <a href="{{ url('manifest_workflow_detail', {id: manifest.id}) }}" class="button">View Manifest Details</a>
        </p>
        
        <p>If you have any questions, please contact the shipping line's accounting department.</p>
        
        <p>Best regards,<br>
        OPTIMUS System</p>
    </div>
    
    <div class="footer">
        <p>This is an automated email from OPTIMUS - Shipping Lines Portal</p>
        <p>Please do not reply to this email</p>
    </div>
</body>
</html>
