{% extends 'base.html.twig' %}
{% from 'components/alert.html.twig' import alert, validation_errors %}

{% block title %}Submit SAS Application - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Header Section -->
    <div class="bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center gap-3 mb-3">
                <a href="{{ path('accreditation_index') }}" class="btn btn-ghost btn-sm btn-circle">
                    <span class="icon-[tabler--arrow-left] size-5"></span>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-base-content">SAS Application</h1>
                    <p class="text-sm text-base-content/60 mt-1">Complete the form below to submit your Secured Accreditation System application</p>
                </div>
            </div>
            
            <!-- Breadcrumb -->
            <div class="breadcrumbs text-sm">
                <ul>
                    <li><a href="{{ path('accreditation_index') }}">SAS</a></li>
                    {% if shippingLine is defined and shippingLine %}
                        <li>{{ shippingLine.brandName }}</li>
                    {% endif %}
                    <li>Apply</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <!-- Shipping Line Header -->
        {% if shippingLine is defined and shippingLine %}
            <div class="card bg-base-100 shadow-sm mb-6">
                <div class="card-body p-6">
                    <div class="flex items-center gap-4">
                        {% set logoUrl = shippingLine.logoPath ? asset('uploads/shipping-lines/' ~ shippingLine.logoPath) : (shippingLine.portalConfig.logoUrl ?? null) %}
                        {% if logoUrl %}
                            <img src="{{ logoUrl }}" 
                                 alt="{{ shippingLine.brandName }} logo" 
                                 class="h-12 w-auto object-contain">
                        {% else %}
                            <div class="avatar placeholder">
                                <div class="bg-primary text-primary-content rounded-lg w-12">
                                    <span class="text-xl font-bold">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                                </div>
                            </div>
                        {% endif %}
                        <div>
                            <h2 class="text-xl font-semibold">{{ shippingLine.brandName }}</h2>
                            <p class="text-sm opacity-60">SAS Application</p>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Form Card -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-6">
                <form method="post" action="{{ path('accreditation_submit', {shippingLineId: shippingLine.id}) }}" enctype="multipart/form-data">
                    <!-- Display validation errors -->
                    {{ validation_errors(errors|default([])) }}

                    <!-- Dynamic Form Fields -->
                    {% if formConfig %}
                        <div class="space-y-6">
                            {% for field in formConfig.fields.fields|sort((a, b) => (a.order ?? 0) <=> (b.order ?? 0)) %}
                                <div class="form-control">
                                    <label class="label">
                                        <span class="label-text font-semibold">
                                            {{ field.label }}
                                            {% if field.required %}
                                                <span class="text-error">*</span>
                                            {% endif %}
                                        </span>
                                    </label>
                                    
                                    {% if field.type == 'text' %}
                                        <input type="text" 
                                               name="{{ field.id }}" 
                                               class="input input-bordered w-full rounded-lg" 
                                               value="{{ submittedData[field.id] is defined ? submittedData[field.id] : '' }}" 
                                               {{ field.required ? 'required' : '' }}>
                                    
                                    {% elseif field.type == 'number' %}
                                        <input type="number" 
                                               name="{{ field.id }}" 
                                               class="input input-bordered w-full rounded-lg" 
                                               value="{{ submittedData[field.id] is defined ? submittedData[field.id] : '' }}" 
                                               {{ field.validation.min is defined ? 'min="' ~ field.validation.min ~ '"' : '' }}
                                               {{ field.validation.max is defined ? 'max="' ~ field.validation.max ~ '"' : '' }}
                                               {{ field.required ? 'required' : '' }}>
                                    
                                    {% elseif field.type == 'file' %}
                                        <input type="file" 
                                               name="{{ field.id }}" 
                                               class="file-input file-input-bordered w-full rounded-lg" 
                                               {{ field.validation.allowedTypes is defined ? 'accept=".' ~ field.validation.allowedTypes|join(',.') ~ '"' : '' }}
                                               {{ field.required ? 'required' : '' }}>
                                    
                                    {% elseif field.type == 'dropdown' %}
                                        <select name="{{ field.id }}" 
                                                class="select select-bordered w-full rounded-lg" 
                                                {{ field.required ? 'required' : '' }}>
                                            <option value="">Select an option</option>
                                            {% if field.validation.options is defined %}
                                                {% for option_value, option_label in field.validation.options %}
                                                    <option value="{{ option_value }}" 
                                                            {{ (submittedData[field.id] is defined and submittedData[field.id] == option_value) ? 'selected' : '' }}>
                                                        {{ option_label }}
                                                    </option>
                                                {% endfor %}
                                            {% endif %}
                                        </select>
                                    
                                    {% elseif field.type == 'checkbox' %}
                                        {% if field.validation.options is defined %}
                                            <!-- Multiple checkboxes -->
                                            <div class="space-y-3">
                                                {% for option_value, option_label in field.validation.options %}
                                                    {% set checkbox_name = field.id ~ '[]' %}
                                                    {% set is_checked = submittedData[field.id] is defined and submittedData[field.id] is iterable and option_value in submittedData[field.id] %}
                                                    <label class="flex items-center gap-3 cursor-pointer">
                                                        <input type="checkbox" 
                                                               name="{{ checkbox_name }}" 
                                                               value="{{ option_value }}" 
                                                               class="checkbox checkbox-primary rounded-lg" 
                                                               {{ is_checked ? 'checked' : '' }}>
                                                        <span class="label-text">{{ option_label }}</span>
                                                    </label>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <!-- Single checkbox -->
                                            <label class="flex items-center gap-3 cursor-pointer">
                                                <input type="checkbox" 
                                                       name="{{ field.id }}" 
                                                       value="1" 
                                                       class="checkbox checkbox-primary rounded-lg" 
                                                       {{ (submittedData[field.id] is defined and submittedData[field.id]) ? 'checked' : '' }}
                                                       {{ field.required ? 'required' : '' }}>
                                                <span class="label-text">{{ field.label }}</span>
                                            </label>
                                        {% endif %}
                                    
                                    {% else %}
                                        <!-- Fallback to text input -->
                                        <input type="text" 
                                               name="{{ field.id }}" 
                                               class="input input-bordered w-full rounded-lg" 
                                               value="{{ submittedData[field.id] is defined ? submittedData[field.id] : '' }}" 
                                               {{ field.required ? 'required' : '' }}>
                                    {% endif %}
                                    
                                    {% if errors[field.id] is defined %}
                                        <label class="label">
                                            <span class="label-text-alt text-error">{{ errors[field.id] }}</span>
                                        </label>
                                    {% endif %}
                                    
                                    {% if field.validation.message is defined %}
                                        <label class="label">
                                            <span class="label-text-alt opacity-60">{{ field.validation.message }}</span>
                                        </label>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-12">
                            <div class="size-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                <span class="icon-[tabler--file-off] size-8 opacity-40"></span>
                            </div>
                            <h3 class="text-base font-semibold">No form configuration available</h3>
                            <p class="mt-2 text-sm opacity-60">Please contact an administrator to set up the accreditation form.</p>
                        </div>
                    {% endif %}

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('accreditation_submit') }}">

                    <!-- Submit Button -->
                    <div class="mt-8 flex flex-col-reverse sm:flex-row items-center justify-between gap-3">
                        <a href="{{ path('accreditation_index') }}" class="btn btn-ghost rounded-lg w-full sm:w-auto">
                            Cancel
                        </a>
                        <button type="submit" id="submitBtn" class="btn btn-primary rounded-lg gap-2 w-full sm:w-auto">
                            <span id="submitLoading" class="loading loading-spinner loading-sm hidden"></span>
                            <span id="submitText">Submit Application</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Help Text -->
        <div class="alert alert-info mt-6">
            <span class="icon-[tabler--info-circle] size-5"></span>
            <div>
                <strong>Note:</strong> Once submitted, your application will be reviewed by our evaluation team. You will be notified via email about the status of your application.
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const submitBtn = document.getElementById('submitBtn');
    const submitText = document.getElementById('submitText');
    const submitLoading = document.getElementById('submitLoading');
    
    // Add file input change listeners
    const fileInputs = document.querySelectorAll('input[type="file"]');
    fileInputs.forEach(function(input) {
        input.addEventListener('change', function() {
            // Add visual feedback
            const label = this.closest('.form-control').querySelector('.label-text');
            if (this.files.length > 0) {
                label.classList.add('text-success');
                label.title = 'File selected: ' + this.files[0].name;
            } else {
                label.classList.remove('text-success');
                label.title = '';
            }
        });
    });
    
    if (form && submitBtn) {
        form.addEventListener('submit', function(e) {
            // Check if all required files are selected
            let missingFiles = [];
            fileInputs.forEach(function(input) {
                if (input.hasAttribute('required') && input.files.length === 0) {
                    missingFiles.push(input.name);
                }
            });
            
            if (missingFiles.length > 0) {
                e.preventDefault();
                alert('Please select files for: ' + missingFiles.join(', '));
                return false;
            }
            
            submitBtn.disabled = true;
            submitText.textContent = 'Submitting...';
            submitLoading.classList.remove('hidden');
        });
    }
});
</script>
{% endblock %}
