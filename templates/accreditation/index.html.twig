{% extends 'base.html.twig' %}

{% block title %}SAS - Secured Accreditation System - OPTIMUS{% endblock %}

{% block body %}
<!-- Toast Notification Container -->
<div class="toast toast-top toast-end z-50">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert {% if type == 'success' %}alert-success{% elseif type == 'error' %}alert-error{% elseif type == 'warning' %}alert-warning{% else %}alert-info{% endif %}">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<div class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center gap-3 mb-2">
                <h1 class="text-3xl font-bold text-base-content">SAS - Secured Accreditation System</h1>
                <span class="badge badge-primary badge-lg">Multi-Tenant</span>
            </div>
            <p class="text-base-content/60 mt-2">Apply for secured accreditation with shipping lines to access their services</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="px-4 sm:px-6 lg:px-8 py-8">
        <!-- Broker Linkage Warning for Consignees -->
        {% if app.user.role.value == 'CONSIGNEE' and not hasActiveBroker|default(false) %}
            <div class="alert alert-warning mb-6">
                <span class="icon-[tabler--alert-triangle] size-5"></span>
                <div class="flex-1">
                    <p class="font-semibold">Broker Linkage Required</p>
                    <p class="text-sm">You must link an approved broker before submitting SAS applications.</p>
                </div>
                <a href="{{ path('accreditation_broker_select') }}" class="btn btn-sm btn-warning gap-2">
                    <span class="icon-[tabler--link] size-4"></span>
                    Select a Broker
                </a>
            </div>
        {% endif %}

        <!-- Shipping Line Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for item in shippingLines %}
                {% set shippingLine = item.entity %}
                {% set submission = item.submission %}
                {% set status = item.status %}
                
                <div class="card bg-base-100 shadow-sm hover:shadow-lg transition-shadow">
                    <!-- Card Header with Logo -->
                    <div class="card-body p-6">
                        <div class="flex items-center justify-between mb-4">
                            {% set logoUrl = shippingLine.logoPath ? asset('uploads/shipping-lines/' ~ shippingLine.logoPath) : (shippingLine.portalConfig.logoUrl ?? null) %}
                            {% if logoUrl %}
                                <img src="{{ logoUrl }}" 
                                     alt="{{ shippingLine.brandName }} logo" 
                                     class="h-16 w-auto object-contain">
                            {% else %}
                                <div class="size-16 bg-gradient-to-br from-primary to-primary-focus rounded-xl flex items-center justify-center">
                                    <span class="text-2xl font-bold text-primary-content">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                                </div>
                            {% endif %}
                            
                            <!-- Status Badge -->
                            {% if status == 'APPROVED' %}
                                <span class="badge badge-success badge-lg gap-2">
                                    <span class="icon-[tabler--circle-check] size-4"></span>
                                    Approved
                                </span>
                            {% elseif status == 'PENDING' %}
                                <span class="badge badge-warning badge-lg gap-2">
                                    <span class="icon-[tabler--clock] size-4"></span>
                                    Pending
                                </span>
                            {% elseif status == 'REJECTED' or status == 'DENIED' %}
                                <span class="badge badge-error badge-lg gap-2">
                                    <span class="icon-[tabler--x] size-4"></span>
                                    Rejected
                                </span>
                            {% else %}
                                <span class="badge badge-ghost badge-lg">Not Applied</span>
                            {% endif %}
                        </div>
                        
                        <h3 class="text-xl font-semibold text-base-content mb-2">{{ shippingLine.brandName }}</h3>
                        
                        {% set brandColor = shippingLine.brandColor ?? (shippingLine.portalConfig.primaryColor ?? null) %}
                        {% if brandColor %}
                            <div class="flex items-center text-sm text-base-content/60 mb-4">
                                <div class="size-4 rounded-full mr-2" style="background-color: {{ brandColor }}"></div>
                                <span>Brand Color</span>
                            </div>
                        {% endif %}
                        
                        <div class="divider my-4"></div>
                        
                        {% if status == 'APPROVED' %}
                            <p class="text-sm text-base-content/70 mb-4">
                                Your SAS accreditation is approved. You can access all services for this shipping line.
                            </p>
                            {% if submission %}
                                <div class="text-xs text-base-content/50 mb-4">
                                    Approved on {{ submission.evaluatedAt|date('M j, Y') }}
                                </div>
                            {% endif %}
                            <a href="{{ path('accreditation_detail', {id: submission.id}) }}" 
                               class="btn btn-ghost w-full gap-2">
                                <span class="icon-[tabler--eye] size-4"></span>
                                View Details
                            </a>
                        {% elseif status == 'PENDING' %}
                            <p class="text-sm text-base-content/70 mb-4">
                                Your SAS application is under review. You'll be notified once it's evaluated.
                            </p>
                            {% if submission %}
                                <div class="text-xs text-base-content/50 mb-4">
                                    Submitted on {{ submission.submittedAt|date('M j, Y') }}
                                </div>
                            {% endif %}
                            <a href="{{ path('accreditation_detail', {id: submission.id}) }}" 
                               class="btn btn-ghost w-full gap-2">
                                <span class="icon-[tabler--file-text] size-4"></span>
                                View Application
                            </a>
                        {% elseif status == 'REJECTED' or status == 'DENIED' %}
                            <p class="text-sm text-base-content/70 mb-4">
                                Your SAS application was rejected. Please review the feedback and reapply.
                            </p>
                            {% if submission and submission.denialReason %}
                                <div class="alert alert-error mb-4">
                                    <span class="text-xs">{{ submission.denialReason }}</span>
                                </div>
                            {% endif %}
                            <a href="{{ path('accreditation_submit', {shippingLineId: shippingLine.id}) }}" 
                               class="btn btn-warning w-full gap-2">
                                <span class="icon-[tabler--refresh] size-4"></span>
                                Reapply for SAS
                            </a>
                        {% else %}
                            <p class="text-sm text-base-content/70 mb-4">
                                Apply for SAS accreditation to access services and manage shipments with this shipping line.
                            </p>
                            {% if app.user.role.value == 'CONSIGNEE' and hasActiveBroker|default(false) %}
                                <a href="{{ path('accreditation_submit', {shippingLineId: shippingLine.id}) }}" 
                                   class="btn btn-primary w-full gap-2">
                                    <span class="icon-[tabler--send] size-4"></span>
                                    Apply for SAS
                                </a>
                            {% elseif app.user.role.value == 'CONSIGNEE' %}
                                <button disabled class="btn btn-disabled w-full">
                                    Link Broker First
                                </button>
                            {% else %}
                                <a href="{{ path('accreditation_submit', {shippingLineId: shippingLine.id}) }}" 
                                   class="btn btn-primary w-full gap-2">
                                    <span class="icon-[tabler--send] size-4"></span>
                                    Apply for SAS
                                </a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Empty State -->
        {% if shippingLines|length == 0 %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body items-center text-center py-16">
                    <div class="size-20 bg-base-200 rounded-full flex items-center justify-center mb-6">
                        <span class="icon-[tabler--package-off] size-10 text-base-content/40"></span>
                    </div>
                    <h3 class="text-xl font-bold text-base-content mb-2">No shipping lines available</h3>
                    <p class="text-base-content/60">Please contact support if you need access to shipping line services.</p>
                </div>
            </div>
        {% endif %}

        <!-- Help Section -->
        <div class="card bg-info/10 shadow-sm mt-8">
            <div class="card-body p-6">
                <div class="flex items-start gap-3">
                    <span class="icon-[tabler--info-circle] size-6 text-info flex-shrink-0"></span>
                    <div>
                        <h3 class="font-bold text-info mb-2">About SAS (Secured Accreditation System)</h3>
                        <p class="text-sm text-info/80">
                            Each shipping line requires separate SAS accreditation. You can apply for multiple shipping lines independently. 
                            Once approved, you'll have full secured access to that shipping line's services and features.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Auto-dismiss flash messages after 5 seconds
    document.addEventListener('DOMContentLoaded', function() {
        const alerts = document.querySelectorAll('.toast .alert');
        alerts.forEach(alert => {
            setTimeout(() => {
                alert.style.opacity = '0';
                alert.style.transition = 'opacity 0.3s ease';
                setTimeout(() => alert.remove(), 300);
            }, 5000);
        });
    });
</script>

{% endblock %}
