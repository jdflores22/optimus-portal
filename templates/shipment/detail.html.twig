{% extends 'base.html.twig' %}

{% block title %}Shipment Details - {{ shipment.manifestNumber }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Top Navigation -->
    <nav class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    {% include 'components/optimus_logo.html.twig' with { size: 'sm', align: 'start' } %}
                    {% if not isShippingLinesAdmin %}
                        <span class="ml-4 text-gray-600">SL-Staff Portal</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Professional Header -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        {% if isConsignee %}
                            <a href="{{ path('app_consignee_dashboard') }}" class="text-blue-600 hover:text-blue-800 flex items-center text-sm">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                </svg>
                                Back to Dashboard
                            </a>
                        {% else %}
                            <a href="{{ path('shipment_list') }}" class="text-blue-600 hover:text-blue-800 flex items-center text-sm">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                </svg>
                                Back to Shipments
                            </a>
                        {% endif %}
                        <div class="h-4 w-px bg-gray-300"></div>
                        <h1 class="text-2xl font-semibold text-gray-900">Shipment Details</h1>
                        {% if isVerified %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Payment Verified - Finalized
                            </span>
                        {% endif %}
                        {% if isConsignee %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                View Only
                            </span>
                        {% endif %}
                    </div>
                    {% if isConsignee %}
                        <div class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-md">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Read-Only Access
                        </div>
                    {% elseif isVerified %}
                        <div class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-500 text-sm font-medium rounded-md cursor-not-allowed">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                            Editing Locked
                        </div>
                    {% elseif isSlStaff %}
                        <a href="{{ path('shipment_edit', {id: shipment.id}) }}" 
                           class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            Edit Shipment
                        </a>
                    {% else %}
                        <div class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-md">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18.364 5.636M5.636 18.364l12.728-12.728"></path>
                            </svg>
                            Edit Restricted
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="mb-6 bg-green-50 border-l-4 border-green-400 p-4 rounded-r-md">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-green-700">{{ message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-6 bg-red-50 border-l-4 border-red-400 p-4 rounded-r-md">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-700">{{ message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Key Identifiers Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- B/L Number - Highlighted -->
                    {% if shipment.blNo %}
                        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                            <div class="px-6 py-4 border-b border-gray-200 bg-blue-50">
                                <h3 class="text-lg font-medium text-blue-900">Bill of Lading (B/L)</h3>
                            </div>
                            <div class="px-6 py-6">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">B/L Number</p>
                                        <p class="text-xl font-bold text-gray-900">{{ shipment.blNo }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Container Number - Highlighted as Important -->
                    {% if shipment.containerNumber %}
                        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                            <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
                                <h3 class="text-lg font-medium text-green-900">Container Number</h3>
                            </div>
                            <div class="px-6 py-6">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">Container Number</p>
                                        <p class="text-xl font-bold text-gray-900 font-mono">{{ shipment.containerNumber }}</p>
                                        <div class="flex items-center mt-1 space-x-4">
                                            {% if shipment.containerType %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                                    {{ shipment.containerType }}
                                                </span>
                                            {% endif %}
                                            {% if shipment.containerSize %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                                    {{ shipment.containerSize }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <!-- Shipment Information -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Shipment Information</h3>
                    </div>
                    <div class="px-6 py-6">
                        <!-- Consignee Information -->
                        {% if shipment.consignee %}
                            <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                                <div class="flex items-start justify-between">
                                    <div class="flex items-start space-x-3">
                                        <div class="flex-shrink-0">
                                            <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
                                                <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m0 0h2M7 7h10M7 11h4m6 0h4"></path>
                                                </svg>
                                            </div>
                                        </div>
                                        <div>
                                            <p class="text-sm font-medium text-gray-500">Consignee</p>
                                            <p class="text-base font-semibold text-gray-900">{{ shipment.consignee.businessName }}</p>
                                            <p class="text-sm text-gray-600">{{ shipment.consignee.email }}</p>
                                        </div>
                                    </div>
                                    {% if linkedBroker %}
                                        <div class="text-right">
                                            <p class="text-xs text-gray-500">Linked Broker</p>
                                            <p class="text-sm font-medium text-blue-600">{{ linkedBroker.fullName }}</p>
                                            {% if linkedBroker in shipment.authorizedBrokers %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                                    Auto-Authorized
                                                </span>
                                            {% elseif shipment.authorizedBrokers is not empty %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                                                    Another Broker Authorized
                                                </span>
                                            {% else %}
                                                <div class="space-y-1">
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                                                        Not Authorized
                                                    </span>
                                                    <form method="POST" action="{{ path('shipment_auto_authorize_broker', {id: shipment.id}) }}" class="inline">
                                                        <button type="submit" class="text-xs text-blue-600 hover:text-blue-800 underline">
                                                            Auto-Authorize Now
                                                        </button>
                                                    </form>
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}

                        <!-- Details Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Manifest Number</dt>
                                <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.manifestNumber }}</dd>
                            </div>

                            {% if shipment.deliveryOrderNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Delivery Order No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.deliveryOrderNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.vessel %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Vessel</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.vessel }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.voyage %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Voyage</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.voyage }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.lloydsNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">LLOYDS No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.lloydsNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.custStatus %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customs Status</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.custStatus }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.custRef %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customs Reference</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.custRef }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.vesselCustomNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Vessel Custom No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.vesselCustomNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.agentCustomRegNo %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Agent Custom Reg No</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.agentCustomRegNo }}</dd>
                                </div>
                            {% endif %}

                            {% if shipment.custId %}
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Customer ID</dt>
                                    <dd class="mt-1 text-sm text-gray-900 font-medium">{{ shipment.custId }}</dd>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Dates & Timeline -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Timeline</h3>
                    </div>
                    <div class="px-6 py-6">
                        <div class="space-y-4">
                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-900">Notice of Arrival</p>
                                    <p class="text-sm text-gray-600">{{ shipment.noticeOfArrivalDate|date('F j, Y \a\t g:i A') }}</p>
                                </div>
                            </div>

                            {% if shipment.actualArrivalDate %}
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Actual Arrival</p>
                                        <p class="text-sm text-gray-600">{{ shipment.actualArrivalDate|date('F j, Y \a\t g:i A') }}</p>
                                    </div>
                                </div>
                            {% endif %}

                            {% if shipment.generalDeclarationDt %}
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">General Declaration</p>
                                        <p class="text-sm text-gray-600">{{ shipment.generalDeclarationDt|date('F j, Y') }}</p>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Billing Information -->
                {% if shipment.billingInformation %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <h3 class="text-lg font-medium text-gray-900">Billing Information</h3>
                        </div>
                        <div class="px-6 py-6">
                            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                <pre class="text-sm text-gray-700 whitespace-pre-wrap font-sans">{{ shipment.billingInformation }}</pre>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Container Information -->
                {% if shipment.containerNumber or shipment.containerType or shipment.containerSize %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <h3 class="text-lg font-medium text-gray-900">Container Details</h3>
                        </div>
                        <div class="px-6 py-6">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                {% if shipment.containerNumber %}
                                    <div class="md:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Container Number</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900 font-mono bg-gray-50 px-3 py-2 rounded border">{{ shipment.containerNumber }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.containerType %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Container Type</dt>
                                        <dd class="mt-1">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                                {{ shipment.containerType }}
                                            </span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if shipment.containerSize %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Container Size</dt>
                                        <dd class="mt-1">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                                {{ shipment.containerSize }}
                                            </span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if shipment.emptyReturnAddress %}
                                    <div class="md:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Empty Return Address</dt>
                                        <dd class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded border">
                                            <pre class="whitespace-pre-wrap font-sans">{{ shipment.emptyReturnAddress }}</pre>
                                        </dd>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Commodity Information -->
                {% if shipment.commodity or shipment.commodityPcs or shipment.commodityQty or shipment.netWtKgm or shipment.measCbm %}
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-medium text-gray-900">Commodity Information</h3>
                            </div>
                        </div>
                        <div class="px-6 py-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {% if shipment.commodity %}
                                    <div class="md:col-span-2 lg:col-span-3">
                                        <dt class="text-sm font-medium text-gray-500">Commodity</dt>
                                        <dd class="mt-1 text-base font-semibold text-gray-900 bg-purple-50 px-3 py-2 rounded border border-purple-200">{{ shipment.commodity }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.commodityPcs %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Pieces (PCS)</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">{{ shipment.commodityPcs }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.commodityQty %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Quantity (QTY)</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">{{ shipment.commodityQty }}</dd>
                                    </div>
                                {% endif %}

                                {% if shipment.netWtKgm %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Net Weight</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">
                                            {{ shipment.netWtKgm }} <span class="text-sm font-normal text-gray-500">KGM</span>
                                        </dd>
                                    </div>
                                {% endif %}

                                {% if shipment.measCbm %}
                                    <div>
                                        <dt class="text-sm font-medium text-gray-500">Measurement</dt>
                                        <dd class="mt-1 text-lg font-bold text-gray-900">
                                            {{ shipment.measCbm }} <span class="text-sm font-normal text-gray-500">CBM</span>
                                        </dd>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}


            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                {% if not isConsignee %}
                    <!-- Authorized Brokers -->
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <h3 class="text-lg font-medium text-gray-900">Authorized Brokers</h3>
                        </div>
                        <div class="px-6 py-6">
                            {% if shipment.authorizedBrokers is empty %}
                                <div class="text-center py-6">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                    </svg>
                                    <p class="mt-2 text-sm text-gray-500">No brokers authorized</p>
                                    {% if linkedBroker and linkedBroker.status.value == 'APPROVED' and shipment.authorizedBrokers is empty and not isVerified %}
                                        <div class="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                                            <p class="text-sm text-blue-800 mb-2">
                                                <strong>{{ linkedBroker.fullName }}</strong> is linked to this consignee
                                            </p>
                                            <form method="POST" action="{{ path('shipment_auto_authorize_broker', {id: shipment.id}) }}" class="inline">
                                                <button type="submit" class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
                                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                                                    </svg>
                                                    Auto-Authorize Linked Broker
                                                </button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="space-y-3 mb-6">
                                    {% for broker in shipment.authorizedBrokers %}
                                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200">
                                            <div class="flex items-center space-x-3">
                                                <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
                                                    <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <div class="flex items-center space-x-2">
                                                        <p class="text-sm font-medium text-gray-900">{{ broker.fullName }}</p>
                                                        {% if linkedBroker and broker.id == linkedBroker.id %}
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                                                                </svg>
                                                                Linked
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                    <p class="text-xs text-gray-500">{{ broker.email }}</p>
                                                </div>
                                            </div>
                                            {% if not isVerified %}
                                                <form method="POST" action="{{ path('shipment_revoke_broker', {id: shipment.id, brokerId: broker.id}) }}" class="inline">
                                                    <button type="submit" 
                                                            onclick="return confirm('Are you sure you want to revoke access for this broker?')"
                                                            class="text-red-600 hover:text-red-800 text-xs font-medium">
                                                        Revoke
                                                    </button>
                                                </form>
                                            {% else %}
                                                <span class="text-xs text-gray-400">Locked</span>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <!-- Add Broker Form - Only show if no brokers are authorized yet and not verified -->
                            {% if shipment.authorizedBrokers is empty and not isVerified %}
                                {% set availableBrokers = [] %}
                                {% for broker in allBrokers %}
                                    {% if broker not in shipment.authorizedBrokers %}
                                        {% set availableBrokers = availableBrokers|merge([broker]) %}
                                    {% endif %}
                                {% endfor %}

                                {% if availableBrokers|length > 0 %}
                                    <div class="border-t border-gray-200 pt-4">
                                        <form method="POST" action="{{ path('shipment_authorize_broker', {id: shipment.id}) }}" class="space-y-3">
                                            <div>
                                                <label for="brokerId" class="block text-sm font-medium text-gray-700">Add Additional Broker</label>
                                                <select id="brokerId" name="brokerId" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                                                    <option value="">Select a broker...</option>
                                                    {% for broker in availableBrokers %}
                                                        <option value="{{ broker.id }}">{{ broker.fullName }}</option>
                                                    {% endfor %}
                                                </select>
                                            </div>
                                            <button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                                Authorize Broker
                                            </button>
                                        </form>
                                    </div>
                                {% else %}
                                    <div class="border-t border-gray-200 pt-4">
                                        <p class="text-sm text-gray-500 text-center">No available brokers to authorize</p>
                                    </div>
                                {% endif %}
                            {% elseif not isVerified %}
                                <div class="border-t border-gray-200 pt-4">
                                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                                        <div class="flex">
                                            <div class="flex-shrink-0">
                                                <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                            <div class="ml-3">
                                                <h3 class="text-sm font-medium text-blue-800">
                                                    One Broker Policy
                                                </h3>
                                                <div class="mt-2 text-sm text-blue-700">
                                                    <p>Only one broker can be authorized per shipment. To change the authorized broker, revoke the current one first.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if isVerified %}
                                <div class="border-t border-gray-200 pt-4">
                                    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                                        <div class="flex">
                                            <div class="flex-shrink-0">
                                                <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                            <div class="ml-3">
                                                <h3 class="text-sm font-medium text-green-800">
                                                    Payment Verified - Finalized
                                                </h3>
                                                <div class="mt-2 text-sm text-green-700">
                                                    <p>This shipment has verified payment and cannot be modified. Broker authorizations are locked.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <!-- Payment Status -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Payment Status</h3>
                    </div>
                    <div class="px-6 py-6">
                        {% set latestPayment = shipment.payment %}
                        {% if latestPayment %}
                            <div class="space-y-3">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                            {% if latestPayment.status.value == 'VERIFIED' %}
                                                bg-green-100 text-green-800
                                            {% elseif latestPayment.status.value == 'PENDING' %}
                                                bg-yellow-100 text-yellow-800
                                            {% else %}
                                                bg-red-100 text-red-800
                                            {% endif %}">
                                            {{ latestPayment.status.value|title }}
                                        </span>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-500">Submitted by</p>
                                    <p class="text-sm text-gray-900">{{ latestPayment.broker.fullName }}</p>
                                </div>
                            </div>
                        {% else %}
                            <div class="text-center py-6">
                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                </svg>
                                <p class="mt-2 text-sm text-gray-500">No payment submitted</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- System Information -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">System Information</h3>
                    </div>
                    <div class="px-6 py-6 space-y-3">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Created by</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ shipment.createdBy.email }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Created on</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ shipment.createdAt|date('F j, Y \a\t g:i A') }}</dd>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}