{% extends 'base.html.twig' %}

{% block title %}Edit Form — {{ form.name }} - OPTIMUS{% endblock %}

{% block body %}
{% set fieldTemplates = {
    'text': { icon: 'icon-[tabler--forms]', name: 'Text Input' },
    'number': { icon: 'icon-[tabler--hash]', name: 'Number' },
    'date': { icon: 'icon-[tabler--calendar]', name: 'Date' },
    'file': { icon: 'icon-[tabler--upload]', name: 'File Upload' },
    'dropdown': { icon: 'icon-[tabler--selector]', name: 'Dropdown' },
    'checkbox': { icon: 'icon-[tabler--checkbox]', name: 'Checkbox' },
    'radio': { icon: 'icon-[tabler--circle-dot]', name: 'Radio Button' }
} %}

<div class="min-h-screen bg-base-200">
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('form_builder_list') }}">Form Builder</a></li>
                            <li>{{ form.name }}</li>
                        </ul>
                    </div>
                    <h1 class="text-2xl font-bold text-base-content truncate">{{ form.name }}</h1>
                    <div class="flex flex-wrap items-center gap-2 mt-2">
                        <span class="badge badge-primary badge-sm">{{ form.type.value }}</span>
                        <span class="text-sm text-base-content/60">Version {{ form.version }}</span>
                        {% include 'form_builder/_status_badge.html.twig' %}
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" id="toggle-preview" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--eye] size-4"></span>
                        Live Preview
                    </button>
                    <a href="{{ path('form_builder_preview', {id: form.id}) }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--external-link] size-4"></span>
                        Full Preview
                    </a>
                    {% include 'form_builder/_status_actions.html.twig' with { form: form, btnSize: 'sm', showLabels: true } %}
                    <a href="{{ path('form_builder_list') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
            <!-- Column 1: Field Templates -->
            <div class="xl:col-span-1">
                <div class="card bg-base-100 shadow-sm xl:sticky xl:top-24">
                    <div class="card-body p-5">
                        <h3 class="font-semibold text-base-content mb-4">1. Field Templates</h3>
                        <div class="space-y-2">
                            {% for fieldType, template in fieldTemplates %}
                                <button type="button"
                                        class="field-template w-full text-left rounded-xl bg-base-200/50 hover:bg-primary/10 px-4 py-3 transition-colors group"
                                        data-field-type="{{ fieldType }}"
                                        data-field-name="{{ template.name }}">
                                    <div class="flex items-center gap-3">
                                        <span class="{{ template.icon }} size-5 text-base-content/50 group-hover:text-primary"></span>
                                        <span class="text-sm font-medium text-base-content">{{ template.name }}</span>
                                    </div>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Column 2: Form Structure -->
            <div class="xl:col-span-1">
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body p-0">
                        <div class="flex items-center justify-between px-5 py-4 border-b border-base-300">
                            <h3 class="font-semibold text-base-content">2. Form Structure</h3>
                            <div class="flex items-center gap-3">
                                <span id="field-count-label" class="text-sm text-base-content/60">{{ form.fields.fields|length }} fields</span>
                                <button type="button" id="save-form" class="btn btn-primary btn-sm gap-2">
                                    <span id="save-spinner" class="loading loading-spinner loading-xs hidden"></span>
                                    <span id="save-text">Save</span>
                                </button>
                            </div>
                        </div>

                        <div class="p-5">
                            <div id="sortable-fields" class="space-y-3 min-h-[400px]">
                                {% if form.fields.fields|length > 0 %}
                                    {% for field in form.fields.fields %}
                                        <div class="field-item rounded-xl bg-base-200/50 p-4 hover:bg-base-200 transition cursor-move"
                                             data-field-id="{{ field.id }}"
                                             data-field-order="{{ field.order }}">
                                            <div class="flex items-center justify-between gap-3">
                                                <div class="flex items-center gap-3 min-w-0">
                                                    <span class="drag-handle cursor-move text-base-content/40 hover:text-base-content shrink-0">
                                                        <span class="icon-[tabler--grip-vertical] size-5"></span>
                                                    </span>
                                                    <div class="min-w-0">
                                                        <div class="flex flex-wrap items-center gap-2 mb-1">
                                                            <span class="font-medium text-base-content truncate">{{ field.label }}</span>
                                                            {% if field.required %}
                                                                <span class="badge badge-error badge-xs">Required</span>
                                                            {% endif %}
                                                            <span class="badge badge-primary badge-xs">{{ field.type|capitalize }}</span>
                                                        </div>
                                                        <p class="field-position text-xs text-base-content/60">Position: {{ field.order }}</p>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-1 shrink-0">
                                                    <button type="button"
                                                            class="edit-field-btn btn btn-text btn-circle btn-sm"
                                                            data-field-id="{{ field.id }}"
                                                            title="Edit field">
                                                        <span class="icon-[tabler--edit] size-4"></span>
                                                    </button>
                                                    <button type="button"
                                                            class="delete-field-btn btn btn-text btn-circle btn-sm text-error"
                                                            data-field-id="{{ field.id }}"
                                                            title="Delete field">
                                                        <span class="icon-[tabler--trash] size-4"></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="empty-fields-state text-center py-12">
                                        <div class="size-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <span class="icon-[tabler--clipboard-list] size-8 text-base-content/40"></span>
                                        </div>
                                        <h3 class="text-sm font-medium text-base-content">No fields yet</h3>
                                        <p class="mt-1 text-sm text-base-content/60">Add a field from the templates on the left.</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Column 3: Preview + Properties -->
            <div class="xl:col-span-1 space-y-6">
                <div id="preview-panel" class="card bg-base-100 shadow-sm hidden">
                    <div class="card-body p-0">
                        <div class="px-5 py-4 border-b border-base-300">
                            <h3 class="font-semibold text-base-content">Live Preview</h3>
                        </div>
                        <div class="p-5">
                            <div id="form-preview" class="space-y-4"></div>
                        </div>
                    </div>
                </div>

                <div id="field-editor-panel" class="card bg-base-100 shadow-sm xl:sticky xl:top-24">
                    <div class="card-body p-0">
                        <div class="px-5 py-4 border-b border-base-300">
                            <h3 class="font-semibold text-base-content">3. Field Properties</h3>
                        </div>
                        <div class="p-5">
                            <div id="field-editor-content">
                                <div class="text-center py-10 text-base-content/60">
                                    <span class="icon-[tabler--adjustments] size-10 text-base-content/30 mx-auto mb-3"></span>
                                    <p class="text-sm">Select a field to edit its properties</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<div id="delete-field-modal"
     class="hidden fixed inset-0 z-[10005] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteFieldModalTitle">
    <div class="absolute inset-0 bg-black/60" onclick="closeDeleteFieldModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div class="size-14 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="icon-[tabler--alert-triangle] size-7 text-error"></span>
            </div>
            <h3 id="deleteFieldModalTitle" class="text-lg font-bold mb-2">Delete Field</h3>
            <p class="text-sm text-base-content/70 mb-4">
                Are you sure you want to delete "<span id="delete-field-name" class="font-semibold text-base-content"></span>"?
            </p>
            <p class="text-xs text-base-content/50 mb-6">
                This action cannot be undone and will permanently remove this field from your form.
            </p>
            <div class="flex gap-3">
                <button type="button" id="cancel-delete-field" class="btn btn-ghost flex-1">Cancel</button>
                <button type="button" id="confirm-delete-field" class="btn btn-error flex-1">Delete Field</button>
            </div>
        </div>
    </div>
</div>

    {% include 'form_builder/_status_modals.html.twig' %}
{% endblock %}

{% block page_scripts %}
<script>
    let fieldOrder = {{ form.fields.fields|length + 1 }};
    let currentFields = {{ form.fields.fields|json_encode|raw }};
    let isEditing = false;
    let editingFieldId = null;

    function openModal(id) {
        const modal = document.getElementById(id);
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    function initializeDragAndDrop() {
        const sortableContainer = document.getElementById('sortable-fields');
        let draggedElement = null;

        function addDragListeners() {
            document.querySelectorAll('.field-item').forEach(function (item) {
                item.draggable = true;

                item.addEventListener('dragstart', function () {
                    draggedElement = this;
                    this.style.opacity = '0.5';
                });

                item.addEventListener('dragend', function () {
                    this.style.opacity = '';
                    draggedElement = null;
                });

                item.addEventListener('dragover', function (e) {
                    e.preventDefault();
                });

                item.addEventListener('drop', function (e) {
                    e.preventDefault();
                    if (draggedElement && draggedElement !== this) {
                        const allItems = Array.from(sortableContainer.children);
                        const draggedIndex = allItems.indexOf(draggedElement);
                        const targetIndex = allItems.indexOf(this);

                        if (draggedIndex < targetIndex) {
                            this.parentNode.insertBefore(draggedElement, this.nextSibling);
                        } else {
                            this.parentNode.insertBefore(draggedElement, this);
                        }

                        updateFieldOrder();
                    }
                });
            });
        }

        addDragListeners();

        const observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (mutation) {
                if (mutation.type === 'childList') {
                    addDragListeners();
                }
            });
        });

        observer.observe(sortableContainer, { childList: true });
    }

    document.addEventListener('DOMContentLoaded', function () {
        initializeDragAndDrop();

        document.getElementById('cancel-delete-field').addEventListener('click', closeDeleteFieldModal);
        document.getElementById('confirm-delete-field').addEventListener('click', confirmDeleteField);
        document.getElementById('save-form').addEventListener('click', saveFormStructure);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeDeleteFieldModal();
            }
        });
    });

    document.getElementById('toggle-preview').addEventListener('click', function () {
        const panel = document.getElementById('preview-panel');
        panel.classList.toggle('hidden');
        if (!panel.classList.contains('hidden')) {
            updatePreview();
        }
    });

    document.querySelectorAll('.field-template').forEach(function (button) {
        button.addEventListener('click', function () {
            showFieldProperties(false, this.dataset.fieldType, this.dataset.fieldName);
        });
    });

    document.addEventListener('click', function (e) {
        if (e.target.closest('.edit-field-btn')) {
            const fieldId = e.target.closest('.edit-field-btn').dataset.fieldId;
            const field = currentFields.find(function (f) { return f.id === fieldId; });
            if (field) {
                showFieldProperties(true, field.type, field.label, field);
            }
        }

        if (e.target.closest('.delete-field-btn')) {
            const fieldId = e.target.closest('.delete-field-btn').dataset.fieldId;
            deleteField(fieldId);
        }
    });

    function showFieldProperties(editing, fieldType, fieldName, fieldData) {
        if (editing === undefined) editing = false;
        isEditing = editing;
        editingFieldId = fieldData ? fieldData.id : null;

        const propertiesContent = document.getElementById('field-editor-content');
        const formHTML = `
            <form id="field-properties-form" class="space-y-4">
                <h4 class="text-sm font-semibold text-base-content">
                    ${editing ? 'Edit Field Properties' : 'New Field Properties'}
                </h4>

                <input type="hidden" id="field-id" value="${fieldData ? fieldData.id : ''}">

                <div class="form-control">
                    <label class="label py-1" for="field-label">
                        <span class="label-text font-medium">Field Label <span class="text-error">*</span></span>
                    </label>
                    <input type="text"
                           id="field-label"
                           required
                           value="${fieldData ? fieldData.label : fieldName}"
                           class="input input-bordered w-full"
                           placeholder="e.g., Business Name">
                </div>

                <div class="form-control">
                    <label class="label py-1" for="field-type">
                        <span class="label-text font-medium">Field Type <span class="text-error">*</span></span>
                    </label>
                    <select id="field-type" required class="select select-bordered w-full">
                        <option value="">-- Select --</option>
                        {% for fieldType in fieldTypes %}
                            <option value="{{ fieldType }}">{{ fieldType|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>

                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox"
                           id="field-required"
                           class="checkbox checkbox-primary"
                           ${fieldData && fieldData.required ? 'checked' : ''}>
                    <span class="text-sm">Required field</span>
                </label>

                <div id="field-type-options" class="space-y-3"></div>

                <div class="divider my-2"></div>

                <div class="flex gap-2">
                    <button type="button" id="save-field-properties" class="btn btn-primary btn-sm flex-1 gap-2">
                        <span id="field-save-spinner" class="loading loading-spinner loading-xs hidden"></span>
                        <span id="field-save-text">${editing ? 'Update Field' : 'Add Field'}</span>
                    </button>
                    <button type="button" id="cancel-field-properties" class="btn btn-ghost btn-sm">Cancel</button>
                </div>
            </form>
        `;

        propertiesContent.innerHTML = formHTML;
        document.getElementById('field-type').value = fieldType;
        document.getElementById('save-field-properties').addEventListener('click', saveFieldFromProperties);
        document.getElementById('cancel-field-properties').addEventListener('click', clearFieldProperties);
        document.getElementById('field-type').addEventListener('change', updateFieldTypeOptions);
        updateFieldTypeOptions();
    }

    function clearFieldProperties() {
        document.getElementById('field-editor-content').innerHTML = `
            <div class="text-center py-10 text-base-content/60">
                <span class="icon-[tabler--adjustments] size-10 text-base-content/30 mx-auto mb-3"></span>
                <p class="text-sm">Select a field to edit its properties</p>
            </div>
        `;
        isEditing = false;
        editingFieldId = null;
    }

    function updateFieldTypeOptions() {
        const fieldType = document.getElementById('field-type').value;
        const optionsContainer = document.getElementById('field-type-options');
        let optionsHTML = '';

        switch (fieldType) {
            case 'dropdown':
            case 'radio':
                optionsHTML = `
                    <div>
                        <label class="label py-1">
                            <span class="label-text font-medium">Options <span class="text-error">*</span></span>
                        </label>
                        <div id="field-options-list" class="space-y-2">
                            <div class="flex items-center gap-2">
                                <input type="text" placeholder="Option 1" class="input input-bordered input-sm flex-1">
                                <button type="button" class="btn btn-text btn-circle btn-sm text-error remove-option">
                                    <span class="icon-[tabler--trash] size-4"></span>
                                </button>
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="text" placeholder="Option 2" class="input input-bordered input-sm flex-1">
                                <button type="button" class="btn btn-text btn-circle btn-sm text-error remove-option">
                                    <span class="icon-[tabler--trash] size-4"></span>
                                </button>
                            </div>
                        </div>
                        <button type="button" id="add-option" class="btn btn-ghost btn-xs mt-2 gap-1">
                            <span class="icon-[tabler--plus] size-3"></span>
                            Add Option
                        </button>
                    </div>
                `;
                break;
            case 'text':
                optionsHTML = `
                    <div class="form-control">
                        <label class="label py-1" for="field-placeholder">
                            <span class="label-text">Placeholder Text</span>
                        </label>
                        <input type="text" id="field-placeholder" class="input input-bordered w-full" placeholder="Enter placeholder text">
                    </div>
                    <div class="form-control">
                        <label class="label py-1" for="field-maxlength">
                            <span class="label-text">Maximum Length</span>
                        </label>
                        <input type="number" id="field-maxlength" class="input input-bordered w-full" placeholder="e.g., 255">
                    </div>
                `;
                break;
            case 'number':
                optionsHTML = `
                    <div class="form-control">
                        <label class="label py-1" for="field-min">
                            <span class="label-text">Minimum Value</span>
                        </label>
                        <input type="number" id="field-min" class="input input-bordered w-full" placeholder="e.g., 0">
                    </div>
                    <div class="form-control">
                        <label class="label py-1" for="field-max">
                            <span class="label-text">Maximum Value</span>
                        </label>
                        <input type="number" id="field-max" class="input input-bordered w-full" placeholder="e.g., 100">
                    </div>
                `;
                break;
            case 'file':
                optionsHTML = `
                    <div class="form-control">
                        <label class="label py-1" for="field-accept">
                            <span class="label-text">Accepted File Types</span>
                        </label>
                        <input type="text" id="field-accept" class="input input-bordered w-full" placeholder="e.g., .pdf,.doc,.docx">
                    </div>
                    <div class="form-control">
                        <label class="label py-1" for="field-maxsize">
                            <span class="label-text">Maximum File Size (MB)</span>
                        </label>
                        <input type="number" id="field-maxsize" class="input input-bordered w-full" placeholder="e.g., 10">
                    </div>
                `;
                break;
        }

        optionsContainer.innerHTML = optionsHTML;

        const addOptionBtn = document.getElementById('add-option');
        if (addOptionBtn) {
            addOptionBtn.addEventListener('click', addNewOption);
        }

        document.querySelectorAll('.remove-option').forEach(function (btn) {
            btn.addEventListener('click', function () {
                this.parentElement.remove();
            });
        });
    }

    function addNewOption() {
        const optionsList = document.getElementById('field-options-list');
        const optionCount = optionsList.children.length + 1;

        const newOptionHTML = `
            <div class="flex items-center gap-2">
                <input type="text" placeholder="Option ${optionCount}" class="input input-bordered input-sm flex-1">
                <button type="button" class="btn btn-text btn-circle btn-sm text-error remove-option">
                    <span class="icon-[tabler--trash] size-4"></span>
                </button>
            </div>
        `;

        optionsList.insertAdjacentHTML('beforeend', newOptionHTML);
        optionsList.lastElementChild.querySelector('.remove-option').addEventListener('click', function () {
            this.parentElement.remove();
        });
    }

    function saveFieldFromProperties() {
        const label = document.getElementById('field-label').value;
        const type = document.getElementById('field-type').value;
        const required = document.getElementById('field-required').checked;

        if (!label || !type) {
            alert('Please fill in all required fields');
            return;
        }

        const saveButton = document.getElementById('save-field-properties');
        const saveSpinner = document.getElementById('field-save-spinner');
        const saveText = document.getElementById('field-save-text');

        saveSpinner.classList.remove('hidden');
        saveText.textContent = isEditing ? 'Updating...' : 'Adding...';
        saveButton.disabled = true;

        const fieldData = {
            id: isEditing ? editingFieldId : 'field_' + Date.now(),
            label: label,
            type: type,
            required: required,
            order: isEditing ? currentFields.find(function (f) { return f.id === editingFieldId; }).order : getNextFieldOrder(),
            validation: {}
        };

        switch (type) {
            case 'text':
                const placeholder = document.getElementById('field-placeholder')?.value;
                const maxlength = document.getElementById('field-maxlength')?.value;
                if (placeholder) fieldData.placeholder = placeholder;
                if (maxlength) fieldData.validation.maxlength = parseInt(maxlength);
                break;
            case 'number':
                const min = document.getElementById('field-min')?.value;
                const max = document.getElementById('field-max')?.value;
                if (min) fieldData.validation.min = parseInt(min);
                if (max) fieldData.validation.max = parseInt(max);
                break;
            case 'file':
                const accept = document.getElementById('field-accept')?.value;
                const maxsize = document.getElementById('field-maxsize')?.value;
                if (accept) fieldData.validation.accept = accept;
                if (maxsize) fieldData.validation.maxsize = parseInt(maxsize);
                break;
            case 'dropdown':
            case 'radio':
                const optionInputs = document.querySelectorAll('#field-options-list input');
                const options = Array.from(optionInputs).map(function (input) { return input.value.trim(); }).filter(function (value) { return value !== ''; });
                if (options.length > 0) {
                    fieldData.options = options;
                }
                break;
        }

        if (isEditing) {
            const fieldIndex = currentFields.findIndex(function (f) { return f.id === editingFieldId; });
            if (fieldIndex !== -1) {
                currentFields[fieldIndex] = fieldData;
            }
        } else {
            currentFields.push(fieldData);
            fieldOrder++;
        }

        fetch('{{ path('form_builder_update_fields', {id: form.id}) }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fields: currentFields })
        })
        .then(function (response) { return response.json(); })
        .then(function (result) {
            if (result.success) {
                saveSpinner.classList.add('hidden');
                saveText.textContent = isEditing ? 'Updated!' : 'Added!';
                saveButton.classList.remove('btn-primary');
                saveButton.classList.add('btn-success');
                setTimeout(function () {
                    clearFieldProperties();
                    refreshFieldDisplay();
                }, 1000);
            } else {
                resetFieldSaveButton();
                alert('Error: ' + result.message);
            }
        })
        .catch(function (error) {
            resetFieldSaveButton();
            alert('Error saving field: ' + error.message);
        });
    }

    function resetFieldSaveButton() {
        const saveButton = document.getElementById('save-field-properties');
        const saveSpinner = document.getElementById('field-save-spinner');
        const saveText = document.getElementById('field-save-text');

        if (saveButton && saveSpinner && saveText) {
            saveSpinner.classList.add('hidden');
            saveText.textContent = isEditing ? 'Update Field' : 'Add Field';
            saveButton.disabled = false;
            saveButton.classList.remove('btn-success');
            saveButton.classList.add('btn-primary');
        }
    }

    let fieldToDelete = null;

    function deleteField(fieldId) {
        const field = currentFields.find(function (f) { return f.id === fieldId; });
        if (!field) {
            alert('Field not found');
            return;
        }

        fieldToDelete = fieldId;
        document.getElementById('delete-field-name').textContent = field.label;
        openModal('delete-field-modal');
    }

    function confirmDeleteField() {
        if (!fieldToDelete) return;

        const confirmBtn = document.getElementById('confirm-delete-field');
        const originalText = confirmBtn.textContent;
        confirmBtn.textContent = 'Deleting...';
        confirmBtn.disabled = true;

        const fieldElement = document.querySelector('[data-field-id="' + fieldToDelete + '"]');
        const originalFields = currentFields.slice();
        const originalFieldElement = fieldElement ? fieldElement.cloneNode(true) : null;
        const fieldIndex = fieldElement ? Array.from(fieldElement.parentNode.children).indexOf(fieldElement) : -1;

        if (fieldElement) {
            fieldElement.style.opacity = '0.5';
            fieldElement.style.transform = 'translateX(-100%)';
            fieldElement.style.transition = 'all 0.3s ease';
            setTimeout(function () {
                if (fieldElement.parentNode) {
                    fieldElement.remove();
                }
            }, 300);
        }

        currentFields = currentFields.filter(function (f) { return f.id !== fieldToDelete; });
        updateFieldCountLabel();
        closeDeleteFieldModal();
        showNotification('Deleting field...', 'info');

        fetch('{{ path('form_builder_delete_field', {id: form.id, fieldId: '__FIELD_ID__'}) }}'.replace('__FIELD_ID__', fieldToDelete), {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            if (!response.ok) {
                return response.text().then(function (text) {
                    throw new Error('HTTP error! status: ' + response.status);
                });
            }
            const contentType = response.headers.get('content-type');
            if (!contentType || !contentType.includes('application/json')) {
                return response.text().then(function (text) {
                    throw new Error('Server returned non-JSON response');
                });
            }
            return response.json();
        })
        .then(function (result) {
            if (result.success) {
                showNotification('Field deleted successfully', 'success');
                currentFields.forEach(function (field, index) {
                    field.order = index + 1;
                });
                document.querySelectorAll('.field-item .field-position').forEach(function (el, index) {
                    el.textContent = 'Position: ' + (index + 1);
                });
            } else {
                throw new Error(result.message || 'Unknown error occurred');
            }
        })
        .catch(function (error) {
            currentFields = originalFields;
            updateFieldCountLabel();

            if (originalFieldElement && fieldIndex >= 0) {
                const sortableFields = document.getElementById('sortable-fields');
                const children = Array.from(sortableFields.children);
                if (fieldIndex < children.length) {
                    sortableFields.insertBefore(originalFieldElement, children[fieldIndex]);
                } else {
                    sortableFields.appendChild(originalFieldElement);
                }
                initializeDragAndDrop();
            }

            showNotification('Error deleting field: ' + error.message, 'error');
        })
        .finally(function () {
            confirmBtn.textContent = originalText;
            confirmBtn.disabled = false;
        });
    }

    function closeDeleteFieldModal() {
        closeModal('delete-field-modal');
        fieldToDelete = null;
    }

    function showNotification(message, type) {
        const container = document.getElementById('formBuilderToastContainer');
        if (!container) return;

        const typeClass = type === 'success' ? 'alert-success' : (type === 'error' ? 'alert-error' : 'alert-info');
        const icon = type === 'success' ? 'icon-[tabler--check]' : (type === 'error' ? 'icon-[tabler--alert-circle]' : 'icon-[tabler--info-circle]');
        const toast = document.createElement('div');
        toast.className = 'alert ' + typeClass + ' shadow-lg pointer-events-auto';
        toast.innerHTML = '<span class="' + icon + ' size-5"></span><span>' + message + '</span>';
        container.appendChild(toast);

        setTimeout(function () {
            toast.remove();
        }, 3000);
    }

    function saveFormStructure() {
        const saveButton = document.getElementById('save-form');
        const saveSpinner = document.getElementById('save-spinner');
        const saveText = document.getElementById('save-text');

        saveSpinner.classList.remove('hidden');
        saveText.textContent = 'Saving...';
        saveButton.disabled = true;

        fetch('{{ path('form_builder_update_fields', {id: form.id}) }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fields: currentFields })
        })
        .then(function (response) { return response.json(); })
        .then(function (result) {
            if (result.success) {
                saveSpinner.classList.add('hidden');
                saveText.textContent = 'Saved!';
                saveButton.classList.remove('btn-primary');
                saveButton.classList.add('btn-success');
                setTimeout(function () {
                    resetSaveButton();
                }, 2000);
            } else {
                resetSaveButton();
                alert('Error saving form: ' + result.message);
            }
        })
        .catch(function (error) {
            resetSaveButton();
            alert('Error saving form: ' + error.message);
        });
    }

    function resetSaveButton() {
        const saveButton = document.getElementById('save-form');
        const saveSpinner = document.getElementById('save-spinner');
        const saveText = document.getElementById('save-text');

        saveSpinner.classList.add('hidden');
        saveText.textContent = 'Save';
        saveButton.disabled = false;
        saveButton.classList.remove('btn-success');
        saveButton.classList.add('btn-primary');
    }

    function updateFieldCountLabel() {
        const label = document.getElementById('field-count-label');
        if (label) {
            label.textContent = currentFields.length + ' fields';
        }
    }

    function refreshFieldDisplay() {
        const sortableFields = document.getElementById('sortable-fields');
        currentFields.sort(function (a, b) { return a.order - b.order; });
        sortableFields.innerHTML = '';

        if (currentFields.length > 0) {
            currentFields.forEach(function (field) {
                const typeLabel = field.type.charAt(0).toUpperCase() + field.type.slice(1);
                const fieldHTML = `
                    <div class="field-item rounded-xl bg-base-200/50 p-4 hover:bg-base-200 transition cursor-move"
                         data-field-id="${field.id}"
                         data-field-order="${field.order}">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="drag-handle cursor-move text-base-content/40 hover:text-base-content shrink-0">
                                    <span class="icon-[tabler--grip-vertical] size-5"></span>
                                </span>
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2 mb-1">
                                        <span class="font-medium text-base-content truncate">${field.label}</span>
                                        ${field.required ? '<span class="badge badge-error badge-xs">Required</span>' : ''}
                                        <span class="badge badge-primary badge-xs">${typeLabel}</span>
                                    </div>
                                    <p class="field-position text-xs text-base-content/60">Position: ${field.order}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1 shrink-0">
                                <button type="button" class="edit-field-btn btn btn-text btn-circle btn-sm" data-field-id="${field.id}" title="Edit field">
                                    <span class="icon-[tabler--edit] size-4"></span>
                                </button>
                                <button type="button" class="delete-field-btn btn btn-text btn-circle btn-sm text-error" data-field-id="${field.id}" title="Delete field">
                                    <span class="icon-[tabler--trash] size-4"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                sortableFields.insertAdjacentHTML('beforeend', fieldHTML);
            });
        } else {
            sortableFields.innerHTML = `
                <div class="empty-fields-state text-center py-12">
                    <div class="size-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="icon-[tabler--clipboard-list] size-8 text-base-content/40"></span>
                    </div>
                    <h3 class="text-sm font-medium text-base-content">No fields yet</h3>
                    <p class="mt-1 text-sm text-base-content/60">Add a field from the templates on the left.</p>
                </div>
            `;
        }

        updateFieldCountLabel();
        initializeDragAndDrop();
    }

    function getNextFieldOrder() {
        if (currentFields.length === 0) {
            return 1;
        }
        return Math.max.apply(null, currentFields.map(function (f) { return f.order || 0; })) + 1;
    }

    function updateFieldOrder() {
        const fieldItems = document.querySelectorAll('.field-item');
        fieldItems.forEach(function (item, index) {
            const fieldId = item.dataset.fieldId;
            const field = currentFields.find(function (f) { return f.id === fieldId; });
            if (field) {
                field.order = index + 1;
                item.dataset.fieldOrder = index + 1;
                const positionEl = item.querySelector('.field-position');
                if (positionEl) {
                    positionEl.textContent = 'Position: ' + (index + 1);
                }
            }
        });
        currentFields.sort(function (a, b) { return a.order - b.order; });
        saveFieldOrder();
    }

    function saveFieldOrder() {
        fetch('{{ path('form_builder_update_fields', {id: form.id}) }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fields: currentFields })
        })
        .then(function (response) { return response.json(); })
        .then(function (result) {
            if (!result.success) {
                console.error('Error saving field order:', result.message);
            }
        })
        .catch(function (error) {
            console.error('Error saving field order:', error.message);
        });
    }

    function updatePreview() {
        const previewContainer = document.getElementById('form-preview');
        let previewHTML = '';

        currentFields.sort(function (a, b) { return a.order - b.order; }).forEach(function (field) {
            previewHTML += generateFieldPreview(field);
        });

        previewContainer.innerHTML = previewHTML || '<p class="text-sm text-base-content/60 text-center">No fields to preview</p>';
    }

    function generateFieldPreview(field) {
        const requiredMark = field.required ? '<span class="text-error">*</span>' : '';

        switch (field.type) {
            case 'text':
                return `
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text">${field.label} ${requiredMark}</span></label>
                        <input type="text" class="input input-bordered w-full" disabled>
                    </div>
                `;
            case 'number':
                return `
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text">${field.label} ${requiredMark}</span></label>
                        <input type="number" class="input input-bordered w-full" disabled>
                    </div>
                `;
            case 'date':
                return `
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text">${field.label} ${requiredMark}</span></label>
                        <input type="date" class="input input-bordered w-full" disabled>
                    </div>
                `;
            case 'file':
                return `
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text">${field.label} ${requiredMark}</span></label>
                        <input type="file" class="file-input file-input-bordered w-full" disabled>
                    </div>
                `;
            case 'dropdown':
                return `
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text">${field.label} ${requiredMark}</span></label>
                        <select class="select select-bordered w-full" disabled><option>-- Select --</option></select>
                    </div>
                `;
            case 'checkbox':
                return `
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" class="checkbox checkbox-primary" disabled>
                        <span class="text-sm">${field.label} ${requiredMark}</span>
                    </label>
                `;
            case 'radio':
                return `
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text">${field.label} ${requiredMark}</span></label>
                        <div class="space-y-2">
                            <label class="flex items-center gap-3">
                                <input type="radio" name="${field.id}" class="radio radio-primary" disabled>
                                <span class="text-sm">Option 1</span>
                            </label>
                            <label class="flex items-center gap-3">
                                <input type="radio" name="${field.id}" class="radio radio-primary" disabled>
                                <span class="text-sm">Option 2</span>
                            </label>
                        </div>
                    </div>
                `;
            default:
                return '';
        }
    }
</script>
    {% include 'form_builder/_status_scripts.html.twig' %}
{% endblock %}
