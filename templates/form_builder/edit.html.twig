    function saveFieldFromProperties() {
        const label = document.getElementById('field-label').value;
        const type = document.getElementById('field-type').value;
        const required = document.getElementById('field-required').checked;
        
        if (!label || !type) {
            alert('Please fill in all required fields');
            return;
        }

        // Show spinner and disable button
        const saveButton = document.getElementById('save-field-properties');
        const saveSpinner = document.getElementById('field-save-spinner');
        const saveText = document.getElementById('field-save-text');
        
        saveSpinner.classList.remove('hidden');
        saveText.textContent = isEditing ? 'Updating...' : 'Adding...';
        saveButton.disabled = true;
        saveButton.classList.add('opacity-75', 'cursor-not-allowed');

        const fieldData = {
            id: isEditing ? editingFieldId : 'field_' + Date.now(),
            label: label,
            type: type,
            required: required,
            order: isEditing ? currentFields.find(f => f.id === editingFieldId).order : getNextFieldOrder(),
            validation: {}
        };
        
        // Add field-specific options
        switch (type) {
            case 'text':
                const placeholder = document.getElementById('field-placeholder')?.value;
                const maxlength = document.getElementById('field-maxlength')?.value;
                if (placeholder) fieldData.placeholder = placeholder;
                if (maxlength) fieldData.validation.maxlength = parseInt(maxlength);
                break;
            case 'number':
                const min = document.getElementById('field-min')?.value;
                const max = document.getElementById('field-max')?.value;
                if (min) fieldData.validation.min = parseInt(min);
                if (max) fieldData.validation.max = parseInt(max);
                break;
            case 'file':
                const accept = document.getElementById('field-accept')?.value;
                const maxsize = document.getElementById('field-maxsize')?.value;
                if (accept) fieldData.validation.accept = accept;
                if (maxsize) fieldData.validation.maxsize = parseInt(maxsize);
                break;
            case 'dropdown':
            case 'radio':
                const optionInputs = document.querySelectorAll('#field-options-list input');
                const options = Array.from(optionInputs)
                    .map(input => input.value.trim())
                    .filter(value => value !== '');
                if (options.length > 0) {
                    fieldData.options = options;
                }
                break;
        }
        
        if (isEditing) {
            // Update existing field
            const fieldIndex = currentFields.findIndex(f => f.id === editingFieldId);
            if (fieldIndex !== -1) {
                currentFields[fieldIndex] = fieldData;
            }
        } else {
            // Add new field
            currentFields.push(fieldData);
            fieldOrder++;
        }

        fetch('{{ path('form_builder_update_fields', {id: form.id}) }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ fields: currentFields })
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                // Show success state briefly
                saveSpinner.classList.add('hidden');
                saveText.textContent = isEditing ? 'Updated!' : 'Added!';
                saveButton.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                saveButton.classList.add('bg-green-600');
                
                // Clear properties and refresh display after brief success display
                setTimeout(() => {
                    clearFieldProperties();
                    refreshFieldDisplay();
                }, 1000);
            } else {
                resetFieldSaveButton();
                alert('Error: ' + result.message);
            }
        })
        .catch(error => {
            resetFieldSaveButton();
            alert('Error saving field: ' + error.message);
        });
    }

    function resetFieldSaveButton() {
        const saveButton = document.getElementById('save-field-properties');
        const saveSpinner = document.getElementById('field-save-spinner');
        const saveText = document.getElementById('field-save-text');
        
        if (saveButton && saveSpinner && saveText) {
            saveSpinner.classList.add('hidden');
            saveText.textContent = isEditing ? 'Update Field' : 'Add Field';
            saveButton.disabled = false;
            saveButton.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-green-600');
            saveButton.classList.add('bg-blue-600', 'hover:bg-blue-700');
        }
    }

    let fieldToDelete = null;

    function deleteField(fieldId) {
        const field = currentFields.find(f => f.id === fieldId);
        if (!field) {
            alert('Field not found');
            return;
        }
        
        fieldToDelete = fieldId;
        document.getElementById('delete-field-name').textContent = field.label;
        document.getElementById('delete-field-modal').classList.remove('hidden');
    }

    function confirmDeleteField() {
        if (!fieldToDelete) return;
        
        // Show loading state on confirm button
        const confirmBtn = document.getElementById('confirm-delete-field');
        const originalText = confirmBtn.textContent;
        confirmBtn.textContent = 'Deleting...';
        confirmBtn.disabled = true;
        
        // Immediately remove field from UI for instant feedback
        const fieldToRemove = currentFields.find(f => f.id === fieldToDelete);
        const fieldElement = document.querySelector(`[data-field-id="${fieldToDelete}"]`);
        
        // Store original state for potential rollback
        const originalFields = [...currentFields];
        const originalFieldElement = fieldElement ? fieldElement.cloneNode(true) : null;
        const fieldIndex = fieldElement ? Array.from(fieldElement.parentNode.children).indexOf(fieldElement) : -1;
        
        // Remove from UI immediately
        if (fieldElement) {
            fieldElement.style.opacity = '0.5';
            fieldElement.style.transform = 'translateX(-100%)';
            fieldElement.style.transition = 'all 0.3s ease';
            
            setTimeout(() => {
                if (fieldElement.parentNode) {
                    fieldElement.remove();
                }
            }, 300);
        }
        
        // Remove from currentFields array
        currentFields = currentFields.filter(f => f.id !== fieldToDelete);
        
        // Update field count immediately
        const fieldCountSpan = document.querySelector('.text-sm.text-gray-500');
        if (fieldCountSpan && fieldCountSpan.textContent.includes('fields')) {
            fieldCountSpan.textContent = `${currentFields.length} fields`;
        }
        
        // Close modal immediately
        closeDeleteModal();
        
        // Show immediate feedback
        showNotification('Deleting field...', 'info');
        
        // Now make the server request
        fetch('{{ path('form_builder_delete_field', {id: form.id, fieldId: '__FIELD_ID__'}) }}'.replace('__FIELD_ID__', fieldToDelete), {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            console.log('Response status:', response.status);
            console.log('Response headers:', response.headers);
            
            // Check if response is ok
            if (!response.ok) {
                return response.text().then(text => {
                    console.log('Error response body:', text);
                    throw new Error(`HTTP error! status: ${response.status}, body: ${text.substring(0, 200)}...`);
                });
            }
            
            const contentType = response.headers.get('content-type');
            if (!contentType || !contentType.includes('application/json')) {
                return response.text().then(text => {
                    console.log('Non-JSON response body:', text);
                    throw new Error('Server returned non-JSON response: ' + text.substring(0, 200) + '...');
                });
            }
            
            return response.json();
        })
        .then(result => {
            if (result.success) {
                // Server confirmed deletion - show success message
                showNotification('Field deleted successfully', 'success');
                
                // Reorder remaining fields to fix any gaps in order
                currentFields.forEach((field, index) => {
                    field.order = index + 1;
                });
                
                // Update position numbers in remaining fields
                document.querySelectorAll('.field-item').forEach((item, index) => {
                    const positionText = item.querySelector('p.text-sm.text-gray-500');
                    if (positionText) {
                        positionText.textContent = `Position: ${index + 1}`;
                    }
                });
                
            } else {
                throw new Error(result.message || 'Unknown error occurred');
            }
        })
        .catch(error => {
            console.error('Delete error:', error);
            
            // Rollback the UI changes on error
            currentFields = originalFields;
            
            // Restore field count
            if (fieldCountSpan && fieldCountSpan.textContent.includes('fields')) {
                fieldCountSpan.textContent = `${originalFields.length} fields`;
            }
            
            // Restore the field element if we have it
            if (originalFieldElement && fieldIndex >= 0) {
                const sortableFields = document.getElementById('sortable-fields');
                const children = Array.from(sortableFields.children);
                
                if (fieldIndex < children.length) {
                    sortableFields.insertBefore(originalFieldElement, children[fieldIndex]);
                } else {
                    sortableFields.appendChild(originalFieldElement);
                }
                
                // Re-initialize drag and drop for restored element
                initializeDragAndDrop();
            }
            
            showNotification('Error deleting field: ' + error.message, 'error');
        })
        .finally(() => {
            // Reset button state
            confirmBtn.textContent = originalText;
            confirmBtn.disabled = false;
        });
    }

    function closeDeleteModal() {
        document.getElementById('delete-field-modal').classList.add('hidden');
        fieldToDelete = null;
    }

    function showNotification(message, type = 'info') {
        // Create a temporary notification
        const notification = document.createElement('div');
        notification.className = `fixed top-4 right-4 px-4 py-3 rounded-lg shadow-lg z-50 ${
            type === 'success' ? 'bg-green-50 border border-green-200 text-green-800' :
            type === 'error' ? 'bg-red-50 border border-red-200 text-red-800' :
            'bg-blue-50 border border-blue-200 text-blue-800'
        }`;
        notification.textContent = message;
        
        document.body.appendChild(notification);
        
        // Remove after 3 seconds
        setTimeout(() => {
            if (notification.parentNode) {
                notification.parentNode.removeChild(notification);
            }
        }, 3000);
    }

