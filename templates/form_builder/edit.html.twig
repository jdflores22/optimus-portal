    function getNextFieldOrder() {
        if (currentFields.length === 0) {
            return 1;
        }
        
        // Find the highest order number and add 1
        const maxOrder = Math.max(...currentFields.map(f => f.order || 0));
        return maxOrder + 1;
    }

    function updateFieldOrder() {
        const fieldItems = document.querySelectorAll('.field-item');
        
        // Update the order based on current visual position
        fieldItems.forEach((item, index) => {
            const fieldId = item.dataset.fieldId;
            const field = currentFields.find(f => f.id === fieldId);
            if (field) {
                field.order = index + 1;
                // Also update the data attribute for consistency
                item.dataset.fieldOrder = index + 1;
            }
        });
        
        // Sort the currentFields array to match the visual order
        currentFields.sort((a, b) => a.order - b.order);
        
        // Auto-save field order
        saveFieldOrder();
    }

    function saveFieldOrder() {
        fetch('{{ path('form_builder_update_fields', {id: form.id}) }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ fields: currentFields })
        })
        .then(response => response.json())
        .then(result => {
            if (!result.success) {
                console.error('Error saving field order:', result.message);
            }
        })
        .catch(error => {
            console.error('Error saving field order:', error.message);
        });
    }

    function updatePreview() {
        const previewContainer = document.getElementById('form-preview');
        let previewHTML = '';
        
        currentFields.sort((a, b) => a.order - b.order).forEach(field => {
            previewHTML += generateFieldPreview(field);
        });
        
        previewContainer.innerHTML = previewHTML || '<p class="text-gray-500 text-center">No fields to preview</p>';
    }

    function generateFieldPreview(field) {
        const requiredMark = field.required ? '<span class="text-red-500">*</span>' : '';
        
        switch (field.type) {
            case 'text':
                return `
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            ${field.label} ${requiredMark}
                        </label>
                        <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                    </div>
                `;
            case 'number':
                return `
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            ${field.label} ${requiredMark}
                        </label>
                        <input type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                    </div>
                `;
            case 'date':
                return `
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            ${field.label} ${requiredMark}
                        </label>
                        <input type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                    </div>
                `;
            case 'file':
                return `
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            ${field.label} ${requiredMark}
                        </label>
                        <input type="file" class="w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                    </div>
                `;
            case 'dropdown':
                return `
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            ${field.label} ${requiredMark}
                        </label>
                        <select class="w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                            <option>-- Select --</option>
                        </select>
                    </div>
                `;
            case 'checkbox':
                return `
                    <div class="mb-4">
                        <label class="flex items-center">
                            <input type="checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded" disabled>
                            <span class="ml-2 text-sm text-gray-700">${field.label} ${requiredMark}</span>
                        </label>
                    </div>
                `;
            case 'radio':
                return `
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            ${field.label} ${requiredMark}
                        </label>
                        <div class="space-y-2">
                            <label class="flex items-center">
                                <input type="radio" name="${field.id}" class="h-4 w-4 text-blue-600 border-gray-300" disabled>
                                <span class="ml-2 text-sm text-gray-700">Option 1</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="${field.id}" class="h-4 w-4 text-blue-600 border-gray-300" disabled>
                                <span class="ml-2 text-sm text-gray-700">Option 2</span>
                            </label>
                        </div>
                    </div>
                `;
            default:
                return '';
        }
    }
</script>
{% endblock %}
