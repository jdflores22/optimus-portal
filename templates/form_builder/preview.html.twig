{% extends 'base.html.twig' %}

{% block title %}Preview Form — {{ form.name }} - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('form_builder_list') }}">Form Builder</a></li>
                            <li><a href="{{ path('form_builder_edit', {id: form.id}) }}">{{ form.name }}</a></li>
                            <li>Preview</li>
                        </ul>
                    </div>
                    <h1 class="text-2xl font-bold text-base-content truncate">{{ form.name }}</h1>
                    <div class="flex flex-wrap items-center gap-2 mt-2">
                        <span class="badge badge-primary badge-sm">{{ form.type.value }}</span>
                        <span class="text-sm text-base-content/60">Version {{ form.version }}</span>
                        <span class="badge badge-ghost badge-sm">{{ form.fields.fields|length }} fields</span>
                    </div>
                </div>
                <a href="{{ path('form_builder_edit', {id: form.id}) }}" class="btn btn-ghost gap-2 w-full sm:w-auto">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to Editor
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
        <div class="max-w-3xl mx-auto space-y-6">
            <div class="alert alert-info">
                <span class="icon-[tabler--info-circle] size-5"></span>
                <span class="text-sm">This is a read-only preview. The submit button below is disabled for demonstration.</span>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6 sm:p-8">
                    <h2 class="text-lg font-semibold text-base-content mb-6 flex items-center gap-2">
                        <span class="icon-[tabler--eye] size-5 text-primary"></span>
                        Form Preview
                    </h2>

                    {% if form.fields.fields|length > 0 %}
                        <div class="dynamic-form-preview space-y-4">
                            {{ renderedForm|raw }}
                        </div>

                        <div class="divider"></div>

                        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
                            <a href="{{ path('form_builder_edit', {id: form.id}) }}" class="btn btn-ghost w-full sm:w-auto">
                                Back to Editor
                            </a>
                            <button type="button" class="btn btn-primary gap-2 w-full sm:w-auto" disabled>
                                <span class="icon-[tabler--send] size-4"></span>
                                Submit (Preview Only)
                            </button>
                        </div>
                    {% else %}
                        <div class="text-center py-16">
                            <div class="size-20 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-6">
                                <span class="icon-[tabler--forms] size-10 text-base-content/40"></span>
                            </div>
                            <h3 class="text-lg font-bold text-base-content mb-2">No fields yet</h3>
                            <p class="text-sm text-base-content/60 mb-6">Add fields in the editor to preview this form.</p>
                            <a href="{{ path('form_builder_edit', {id: form.id}) }}" class="btn btn-primary gap-2">
                                <span class="icon-[tabler--edit] size-4"></span>
                                Open Editor
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="{{ asset('js/form-geolocation.js') }}"></script>
<script src="{{ asset('js/form-field-restrictions.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (window.FormFieldRestrictions) {
        window.FormFieldRestrictions.init(document.querySelector('.dynamic-form-preview') || document);
    }
});
</script>
{% endblock %}
