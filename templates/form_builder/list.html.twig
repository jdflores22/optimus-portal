// API Functions
function activateFormNow(formId) {
    console.log('Activating form:', formId);
    
    fetch(`/admin/form-builder/${formId}/activate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            closeActivateModal();
            showNotification('Form activated successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            closeActivateModal();
            showNotification('Error: ' + (result.message || 'Unknown error'), 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        closeActivateModal();
        showNotification('Error activating form: ' + error.message, 'error');
    });
}

function deactivateFormNow(formId) {
    console.log('Deactivating form:', formId);
    
    fetch(`/admin/form-builder/${formId}/deactivate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            closeDeactivateModal();
            showNotification('Form deactivated successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            closeDeactivateModal();
            showNotification('Error: ' + (result.message || 'Unknown error'), 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        closeDeactivateModal();
        showNotification('Error deactivating form: ' + error.message, 'error');
    });
}

function deleteFormNow(formId) {
    console.log('Deleting form:', formId);
    
    fetch(`/admin/form-builder/${formId}/delete`, {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            closeDeleteModal();
            showNotification('Form deleted successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            closeDeleteModal();
            showNotification('Error: ' + (result.message || 'Unknown error'), 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        closeDeleteModal();
        showNotification('Error deleting form: ' + error.message, 'error');
    });
}

// Notification function
function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 px-4 py-3 rounded-lg shadow-lg z-50 ${
        type === 'success' ? 'bg-green-50 border border-green-200 text-green-800' :
        type === 'error' ? 'bg-red-50 border border-red-200 text-red-800' :
        'bg-blue-50 border border-blue-200 text-blue-800'
    }`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
        }
    }, 3000);
}
