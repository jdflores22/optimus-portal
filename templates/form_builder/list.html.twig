                    <span id="deleteText">Delete Form</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let currentFormId = null;
let currentFormName = null;

document.addEventListener('DOMContentLoaded', function() {
    // Activate buttons
    document.querySelectorAll('.activate-form-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const formId = this.getAttribute('data-form-id');
            const formName = this.getAttribute('data-form-name');
            openActivateModal(formId, formName);
        });
    });
    
    // Deactivate buttons
    document.querySelectorAll('.deactivate-form-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const formId = this.getAttribute('data-form-id');
            const formName = this.getAttribute('data-form-name');
            openDeactivateModal(formId, formName);
        });
    });
    
    // Delete buttons
    document.querySelectorAll('.delete-form-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const formId = this.getAttribute('data-form-id');
            const formName = this.getAttribute('data-form-name');
            openDeleteModal(formId, formName);
        });
    });
    
    // Confirm buttons
    document.getElementById('confirmActivateBtn').addEventListener('click', confirmActivate);
    document.getElementById('confirmDeactivateBtn').addEventListener('click', confirmDeactivate);
    document.getElementById('confirmDeleteBtn').addEventListener('click', confirmDelete);
    
    // Close on backdrop click
    document.getElementById('activateModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeActivateModal();
    });
    document.getElementById('deactivateModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeactivateModal();
    });
    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });
    
    // Confirm button handlers
    document.getElementById('confirmActivateBtn').addEventListener('click', confirmActivate);
    document.getElementById('confirmDeactivateBtn').addEventListener('click', confirmDeactivate);
    document.getElementById('confirmDeleteBtn').addEventListener('click', confirmDelete);
    
    // ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeActivateModal();
            closeDeactivateModal();
            closeDeleteModal();
        }
    });
});

// Activate Modal
function openActivateModal(formId, formName) {
    currentFormId = formId;
    currentFormName = formName;
    document.getElementById('activateFormName').textContent = formName;
    const modal = document.getElementById('activateModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeActivateModal() {
    const modal = document.getElementById('activateModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    resetActivateButton();
    currentFormId = null;
    currentFormName = null;
}

function resetActivateButton() {
    document.getElementById('activateSpinner').classList.add('hidden');
    document.getElementById('activateText').textContent = 'Activate Form';
    document.getElementById('confirmActivateBtn').disabled = false;
}

function confirmActivate() {
    if (!currentFormId) return;
    
    const btn = document.getElementById('confirmActivateBtn');
    const spinner = document.getElementById('activateSpinner');
    const text = document.getElementById('activateText');
    
    spinner.classList.remove('hidden');
    text.textContent = 'Activating...';
    btn.disabled = true;
    
    fetch(`/admin/form-builder/${currentFormId}/activate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            closeActivateModal();
            showNotification('Form activated successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            closeActivateModal();
            showNotification('Error: ' + (result.message || 'Unknown error'), 'error');
        }
    })
    .catch(error => {
        closeActivateModal();
        showNotification('Error activating form', 'error');
    });
}

