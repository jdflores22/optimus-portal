{% extends 'base.html.twig' %}

{% block title %}Form Builder - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="bg-base-100 border-b border-base-300">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8">
            <div class="py-4 sm:py-6">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
                    <div>
                        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Form Configurations</h1>
                        <p class="mt-1 text-xs sm:text-sm text-base-content/70">Manage accreditation forms and configurations</p>
                    </div>
                    <a href="{{ path('form_builder_create') }}" 
                       class="btn btn-primary btn-sm sm:btn-md w-full sm:w-auto">
                        <span class="icon-[tabler--plus] size-4 sm:size-5"></span>
                        Create New Form
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Forms List -->
        <div class="card bg-base-100 shadow-sm">
            {% if forms|length > 0 %}
                <!-- Desktop Table View -->
                <div class="hidden lg:block overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Version</th>
                                <th>Status</th>
                                <th>Fields</th>
                                <th>Created</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for form in forms %}
                                <tr class="hover">
                                    <td class="font-medium">{{ form.name }}</td>
                                    <td>
                                        <span class="badge badge-primary badge-sm">
                                            {{ form.type.value }}
                                        </span>
                                    </td>
                                    <td class="text-sm text-base-content/70">v{{ form.version }}</td>
                                    <td>
                                        {% if form.status.value == 'ACTIVE' %}
                                            <span class="badge badge-success badge-sm">Active</span>
                                        {% elseif form.status.value == 'INACTIVE' %}
                                            <span class="badge badge-warning badge-sm">Inactive</span>
                                        {% elseif form.status.value == 'PUBLISHED' %}
                                            <span class="badge badge-info badge-sm">Published</span>
                                        {% else %}
                                            <span class="badge badge-ghost badge-sm">Draft</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-sm text-base-content/70">
                                        {{ form.fields.fields|length }} fields
                                    </td>
                                    <td class="text-sm text-base-content/70">
                                        {{ form.createdAt|date('Y-m-d') }}
                                    </td>
                                    <td>
                                        <div class="flex items-center justify-end gap-1">
                                            <!-- Edit -->
                                            <a href="{{ path('form_builder_edit', {id: form.id}) }}" 
                                               class="btn btn-xs btn-primary" title="Edit">
                                                <span class="icon-[tabler--edit] size-3"></span>
                                            </a>
                                            
                                            <!-- Preview -->
                                            <a href="{{ path('form_builder_preview', {id: form.id}) }}" 
                                               class="btn btn-xs btn-ghost" title="Preview">
                                                <span class="icon-[tabler--eye] size-3"></span>
                                            </a>
                                            
                                            <!-- Status Actions -->
                                            {% if form.status.value == 'DRAFT' %}
                                                <a href="{{ path('form_builder_publish_confirm', {id: form.id}) }}" 
                                                   class="btn btn-xs btn-success" title="Publish">
                                                    <span class="icon-[tabler--cloud-upload] size-3"></span>
                                                </a>
                                            {% elseif form.status.value == 'PUBLISHED' or form.status.value == 'INACTIVE' %}
                                                <button type="button" 
                                                        class="activate-form-btn btn btn-xs btn-info"
                                                        data-form-id="{{ form.id }}"
                                                        data-form-name="{{ form.name }}"
                                                        title="Activate">
                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                </button>
                                            {% elseif form.status.value == 'ACTIVE' %}
                                                <button type="button" 
                                                        class="deactivate-form-btn btn btn-xs btn-warning"
                                                        data-form-id="{{ form.id }}"
                                                        data-form-name="{{ form.name }}"
                                                        title="Deactivate">
                                                    <span class="icon-[tabler--x] size-3"></span>
                                                </button>
                                            {% endif %}
                                            
                                            <!-- New Version -->
                                            {% if form.status.value in ['PUBLISHED', 'ACTIVE', 'INACTIVE'] %}
                                                <form method="POST" action="{{ path('form_builder_new_version', {id: form.id}) }}" class="inline">
                                                    <button type="submit" 
                                                            class="btn btn-xs btn-secondary" title="New Version">
                                                        <span class="icon-[tabler--plus] size-3"></span>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            
                                            <!-- Delete -->
                                            <button type="button" 
                                                    class="delete-form-btn btn btn-xs btn-error"
                                                    data-form-id="{{ form.id }}"
                                                    data-form-name="{{ form.name }}"
                                                    title="Delete">
                                                <span class="icon-[tabler--trash] size-3"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="lg:hidden p-3 space-y-3">
                    {% for form in forms %}
                        <div class="card bg-base-200 shadow-sm">
                            <div class="card-body p-4">
                                <div class="flex items-start justify-between mb-3">
                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-medium text-sm truncate">{{ form.name }}</h3>
                                        <div class="flex items-center gap-2 mt-1 flex-wrap">
                                            <span class="badge badge-primary badge-xs">{{ form.type.value }}</span>
                                            <span class="text-xs text-base-content/70">v{{ form.version }}</span>
                                            {% if form.status.value == 'ACTIVE' %}
                                                <span class="badge badge-success badge-xs">Active</span>
                                            {% elseif form.status.value == 'INACTIVE' %}
                                                <span class="badge badge-warning badge-xs">Inactive</span>
                                            {% elseif form.status.value == 'PUBLISHED' %}
                                                <span class="badge badge-info badge-xs">Published</span>
                                            {% else %}
                                                <span class="badge badge-ghost badge-xs">Draft</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="flex items-center justify-between text-xs text-base-content/70 mb-3">
                                    <span>{{ form.fields.fields|length }} fields</span>
                                    <span>{{ form.createdAt|date('Y-m-d') }}</span>
                                </div>
                                
                                <div class="grid grid-cols-3 gap-1">
                                    <a href="{{ path('form_builder_edit', {id: form.id}) }}" 
                                       class="btn btn-xs btn-primary">
                                        <span class="icon-[tabler--edit] size-3"></span>
                                        Edit
                                    </a>
                                    <a href="{{ path('form_builder_preview', {id: form.id}) }}" 
                                       class="btn btn-xs btn-ghost">
                                        <span class="icon-[tabler--eye] size-3"></span>
                                        View
                                    </a>
                                    
                                    {% if form.status.value == 'DRAFT' %}
                                        <a href="{{ path('form_builder_publish_confirm', {id: form.id}) }}" 
                                           class="btn btn-xs btn-success">
                                            <span class="icon-[tabler--cloud-upload] size-3"></span>
                                            Publish
                                        </a>
                                    {% elseif form.status.value in ['PUBLISHED', 'INACTIVE'] %}
                                        <button type="button" 
                                                class="activate-form-btn btn btn-xs btn-info"
                                                data-form-id="{{ form.id }}"
                                                data-form-name="{{ form.name }}">
                                            <span class="icon-[tabler--circle-check] size-3"></span>
                                            Activate
                                        </button>
                                    {% elseif form.status.value == 'ACTIVE' %}
                                        <button type="button" 
                                                class="deactivate-form-btn btn btn-xs btn-warning"
                                                data-form-id="{{ form.id }}"
                                                data-form-name="{{ form.name }}">
                                            <span class="icon-[tabler--x] size-3"></span>
                                            Deactivate
                                        </button>
                                    {% endif %}
                                    
                                    <button type="button" 
                                            class="delete-form-btn btn btn-xs btn-error col-span-3"
                                            data-form-id="{{ form.id }}"
                                            data-form-name="{{ form.name }}">
                                        <span class="icon-[tabler--trash] size-3"></span>
                                        Delete Form
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-12 p-6">
                    <span class="icon-[tabler--forms] size-12 text-base-content/40 mx-auto"></span>
                    <h3 class="mt-4 text-base font-medium">No form configurations found</h3>
                    <p class="mt-2 text-sm text-base-content/70">Create your first form to get started</p>
                    <div class="mt-6">
                        <a href="{{ path('form_builder_create') }}" class="btn btn-primary">
                            <span class="icon-[tabler--plus] size-5"></span>
                            Create Form
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>


<!-- Activate Form Modal -->
<div id="activateModal" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden items-center justify-center" style="z-index: 9999;">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <div class="p-6">
            <div class="flex items-center justify-center w-12 h-12 mx-auto bg-blue-100 rounded-full mb-4">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 text-center mb-2">Activate Form</h3>
            <p class="text-sm text-gray-600 text-center mb-4">
                Are you sure you want to activate the form "<span id="activateFormName" class="font-medium text-gray-900"></span>"?
            </p>
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 mb-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-xs text-yellow-800">
                            This will deactivate any other active form of the same type and make this form the primary one.
                        </p>
                    </div>
                </div>
            </div>
            <div class="flex space-x-3">
                <button type="button" 
                        id="cancel-activate-form"
                        class="flex-1 px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </button>
                <button type="button" 
                        id="confirmActivateBtn"
                        class="flex-1 px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 flex items-center justify-center">
                    <svg id="activateSpinner" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span id="activateText">Activate Form</span>
                </button>
            </div>
        </div>
    </div>
</div>

