{% extends 'base.html.twig' %}

{% block title %}Create Form - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('form_builder_list') }}">Form Builder</a></li>
                            <li>Create</li>
                        </ul>
                    </div>
                    <h1 class="text-2xl font-bold text-base-content">Create New Form</h1>
                    <p class="text-sm text-base-content/60 mt-1">Set up a new accreditation form configuration</p>
                </div>
                <a href="{{ path('form_builder_list') }}" class="btn btn-ghost gap-2 w-full sm:w-auto">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
        <div class="max-w-2xl mx-auto">
            {% for message in app.flashes('error') %}
                <div class="alert alert-error mb-6">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6 sm:p-8">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="size-12 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--forms] size-6 text-primary"></span>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-base-content">Form Details</h2>
                            <p class="text-sm text-base-content/60">Name your form and choose who it applies to</p>
                        </div>
                    </div>

                    <form method="POST" action="{{ path('form_builder_store') }}" class="space-y-5">
                        <div class="form-control">
                            <label class="label py-1" for="name">
                                <span class="label-text font-medium">Form Name <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   id="name"
                                   name="name"
                                   required
                                   class="input input-bordered w-full"
                                   placeholder="e.g., Consignee Accreditation Form">
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="type">
                                <span class="label-text font-medium">Form Type <span class="text-error">*</span></span>
                            </label>
                            <select id="type"
                                    name="type"
                                    required
                                    class="select select-bordered w-full">
                                <option value="">-- Select Form Type --</option>
                                {% for formType in formTypes %}
                                    <option value="{{ formType.value }}">{{ formType.value }}</option>
                                {% endfor %}
                            </select>
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">
                                    Select whether this form is for Consignee or Broker registration
                                </span>
                            </label>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('form_builder_create') }}">

                        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
                            <a href="{{ path('form_builder_list') }}" class="btn btn-ghost w-full sm:w-auto">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary gap-2 w-full sm:w-auto">
                                <span class="icon-[tabler--plus] size-4"></span>
                                Create Form
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
