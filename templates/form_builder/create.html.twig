{% extends 'base.html.twig' %}

{% block title %}Create Form - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Top Navigation Bar -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <span class="text-2xl font-bold text-meta-blue">OPTIMUS</span>
                    <span class="ml-4 text-gray-600">Form Builder</span>
                </div>
                <div class="flex items-center">
                    <a href="{{ path('form_builder_list') }}" class="text-gray-600 hover:text-gray-800">
                        ← Back to List
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">Create New Form</h1>

        <!-- Flash Messages -->
        {% for message in app.flashes('error') %}
            <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <!-- Create Form -->
        <div class="bg-white rounded-lg shadow p-6">
            <form method="POST" action="{{ path('form_builder_store') }}">
                <div class="mb-6">
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                        Form Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" 
                           id="name" 
                           name="name" 
                           required
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                           placeholder="e.g., Consignee Accreditation Form">
                </div>

                <div class="mb-6">
                    <label for="type" class="block text-sm font-medium text-gray-700 mb-2">
                        Form Type <span class="text-red-500">*</span>
                    </label>
                    <select id="type" 
                            name="type" 
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">-- Select Form Type --</option>
                        {% for formType in formTypes %}
                            <option value="{{ formType.value }}">{{ formType.value }}</option>
                        {% endfor %}
                    </select>
                    <p class="mt-2 text-sm text-gray-500">
                        Select whether this form is for Consignee or Broker registration
                    </p>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('form_builder_create') }}">

                <div class="flex justify-end space-x-3">
                    <a href="{{ path('form_builder_list') }}" 
                       class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
                        Cancel
                    </a>
                    <button type="submit" 
                            class="bg-meta-blue text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition">
                        Create Form
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
