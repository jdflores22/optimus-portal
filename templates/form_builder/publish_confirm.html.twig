{% extends 'base.html.twig' %}

{% block title %}Publish Form — {{ form.name }} - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('form_builder_list') }}">Form Builder</a></li>
                            <li><a href="{{ path('form_builder_edit', {id: form.id}) }}">{{ form.name }}</a></li>
                            <li>Publish</li>
                        </ul>
                    </div>
                    <h1 class="text-2xl font-bold text-base-content">Publish Form</h1>
                    <p class="text-sm text-base-content/60 mt-1">Review details before making this form available</p>
                </div>
                <a href="{{ path('form_builder_edit', {id: form.id}) }}" class="btn btn-ghost gap-2 w-full sm:w-auto">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to Editor
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
        <div class="max-w-2xl mx-auto">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success mb-6">
                    <span class="icon-[tabler--check] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error mb-6">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6 sm:p-8">
                    <div class="text-center mb-6">
                        <div class="size-14 bg-warning/10 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="icon-[tabler--cloud-upload] size-7 text-warning"></span>
                        </div>
                        <h2 class="text-xl font-bold text-base-content mb-2">Publish Form Configuration</h2>
                        <p class="text-sm text-base-content/60">Are you sure you want to publish this form?</p>
                    </div>

                    <div class="bg-base-200/60 rounded-xl p-5 mb-6 space-y-3">
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-sm text-base-content/60">Form Name</span>
                            <span class="text-sm font-semibold text-base-content text-end">{{ form.name }}</span>
                        </div>
                        <div class="divider my-0"></div>
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-sm text-base-content/60">Type</span>
                            <span class="badge badge-primary badge-sm">{{ form.type.value }}</span>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-sm text-base-content/60">Version</span>
                            <span class="text-sm font-medium text-base-content">v{{ form.version }}</span>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-sm text-base-content/60">Status</span>
                            <span class="badge badge-ghost badge-sm">Draft</span>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-sm text-base-content/60">Number of Fields</span>
                            <span class="text-sm font-medium text-base-content">{{ form.fields.fields|length }}</span>
                        </div>
                    </div>

                    <div class="alert alert-info mb-6">
                        <span class="icon-[tabler--info-circle] size-5"></span>
                        <span class="text-sm">
                            Once published, this form will become available for users to submit.
                            To make changes after publishing, you'll need to create a new version.
                        </span>
                    </div>

                    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
                        <a href="{{ path('form_builder_edit', {id: form.id}) }}" class="btn btn-ghost w-full sm:w-auto">
                            Cancel
                        </a>
                        <form method="POST" action="{{ path('form_builder_publish', {id: form.id}) }}" class="w-full sm:w-auto">
                            <button type="submit" class="btn btn-success gap-2 w-full sm:w-auto">
                                <span class="icon-[tabler--cloud-upload] size-4"></span>
                                Publish Form
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
