{% extends 'base.html.twig' %}

{% block title %}Publish Form - {{ form.name }} - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Top Navigation Bar -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <span class="text-2xl font-bold text-meta-blue">OPTIMUS</span>
                    <span class="ml-4 text-gray-600">Form Builder</span>
                </div>
                <div class="flex items-center">
                    <a href="{{ path('form_builder_list') }}" class="text-gray-600 hover:text-gray-800">
                        ← Back to List
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-white rounded-lg shadow p-8">
            <div class="text-center mb-6">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100 mb-4">
                    <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Publish Form Configuration</h2>
                <p class="text-gray-600">Are you sure you want to publish this form?</p>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <dl class="space-y-2">
                    <div class="flex justify-between">
                        <dt class="text-sm font-medium text-gray-500">Form Name:</dt>
                        <dd class="text-sm text-gray-900">{{ form.name }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm font-medium text-gray-500">Type:</dt>
                        <dd class="text-sm text-gray-900">{{ form.type.value }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm font-medium text-gray-500">Version:</dt>
                        <dd class="text-sm text-gray-900">{{ form.version }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm font-medium text-gray-500">Number of Fields:</dt>
                        <dd class="text-sm text-gray-900">{{ form.fields.fields|length }}</dd>
                    </div>
                </dl>
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                <p class="text-sm text-blue-800">
                    <strong>Note:</strong> Once published, this form will become available for users to submit. 
                    To make changes after publishing, you'll need to create a new version.
                </p>
            </div>

            <div class="flex justify-end space-x-3">
                <a href="{{ path('form_builder_edit', {id: form.id}) }}" 
                   class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
                    Cancel
                </a>
                <form method="POST" action="{{ path('form_builder_publish', {id: form.id}) }}" class="inline">
                    <button type="submit" 
                            class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition">
                        Publish Form
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
