{% extends 'layout/admin_base.html.twig' %}

{% block title %}Container Size Management - OPTIMUS{% endblock %}

{% block content %}
<div class="space-y-6">
<!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8">
            <div class="py-4 sm:py-6">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
                    <div>
                        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Container Size Management</h1>
                        <p class="mt-1 text-xs sm:text-sm text-base-content/70">Manage container size classifications</p>
                    </div>
                    <a href="{{ path('admin_container_sizes_new') }}"
                       class="btn btn-primary btn-sm sm:btn-md w-full sm:w-auto gap-2">
                        <span class="icon-[tabler--plus] size-4 sm:size-5"></span>
                        Add Container Size
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Statistics -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 mb-6">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-primary/10 text-primary rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--resize] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Total Sizes</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ containerSizes|length }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-success/10 text-success rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-check] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Active</p>
                            <p class="text-2xl sm:text-3xl font-bold text-success">{{ containerSizes|filter(s => s.isActive)|length }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-error/10 text-error rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-x] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Inactive</p>
                            <p class="text-2xl sm:text-3xl font-bold text-error">{{ containerSizes|filter(s => not s.isActive)|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search and Filter -->
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-body p-4 sm:p-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-control">
                        <label class="label py-1" for="searchInput">
                            <span class="label-text font-medium">Search</span>
                        </label>
                        <label class="input input-bordered flex items-center gap-2">
                            <span class="icon-[tabler--search] size-4 text-base-content/50"></span>
                            <input type="text"
                                   id="searchInput"
                                   class="grow"
                                   placeholder="Search by name or code...">
                        </label>
                    </div>
                    <div class="form-control">
                        <label class="label py-1" for="statusFilter">
                            <span class="label-text font-medium">Status</span>
                        </label>
                        <select id="statusFilter" class="select select-bordered w-full">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Container Sizes Table -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                <h3 class="card-title text-base sm:text-lg">All Container Sizes</h3>
                <span class="badge badge-ghost">{{ containerSizes|length }} total</span>
            </div>

            {% if containerSizes|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="containerSizesTableBody">
                            {% for containerSize in containerSizes %}
                                <tr id="container-size-row-{{ containerSize.id }}"
                                    class="hover"
                                    data-name="{{ containerSize.name|lower }}"
                                    data-code="{{ containerSize.code|lower }}"
                                    data-status="{{ containerSize.isActive ? 'active' : 'inactive' }}">
                                    <td class="font-medium whitespace-nowrap">{{ containerSize.name }}</td>
                                    <td>
                                        <span class="badge badge-primary badge-sm font-mono">{{ containerSize.code }}</span>
                                    </td>
                                    <td class="text-sm text-base-content/80 max-w-xs truncate">
                                        {{ containerSize.description ?: '—' }}
                                    </td>
                                    <td>
                                        <span class="badge badge-sm {{ containerSize.isActive ? 'badge-success' : 'badge-error' }}"
                                              id="status-badge-{{ containerSize.id }}">
                                            {{ containerSize.isActive ? 'Active' : 'Inactive' }}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="flex items-center justify-end gap-1">
                                            <a href="{{ path('admin_container_sizes_edit', {id: containerSize.id}) }}"
                                               class="btn btn-xs btn-primary"
                                               title="Edit">
                                                <span class="icon-[tabler--edit] size-3"></span>
                                            </a>
                                            <button type="button"
                                                    onclick="toggleContainerSizeStatus({{ containerSize.id }})"
                                                    class="btn btn-xs btn-warning"
                                                    title="{{ containerSize.isActive ? 'Deactivate' : 'Activate' }}"
                                                    id="toggle-btn-{{ containerSize.id }}">
                                                <span class="icon-[tabler--{{ containerSize.isActive ? 'ban' : 'circle-check' }}] size-3"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="card-body text-center py-12">
                    <span class="icon-[tabler--resize] size-12 text-base-content/30 mx-auto"></span>
                    <h3 class="mt-4 text-base font-medium">No container sizes found</h3>
                    <p class="mt-2 text-sm text-base-content/60">Get started by adding your first container size.</p>
                    <div class="mt-6">
                        <a href="{{ path('admin_container_sizes_new') }}" class="btn btn-primary gap-2">
                            <span class="icon-[tabler--plus] size-4"></span>
                            Add Container Size
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
{% endblock %}

{% block page_modals %}
<!-- Confirmation Modal (body-level so backdrop covers sidebar + top nav) -->
<div id="confirmModal"
     class="hidden fixed inset-0 z-[10002] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirmTitle">
    <div class="absolute inset-0 bg-black/60" onclick="closeConfirmModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div class="size-14 bg-warning/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="icon-[tabler--alert-triangle] size-7 text-warning"></span>
            </div>
            <h3 id="confirmTitle" class="text-lg font-bold mb-2">Confirm Action</h3>
            <p id="confirmMessage" class="text-sm text-base-content/70 mb-6">Are you sure you want to proceed?</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeConfirmModal()" class="btn btn-ghost flex-1">Cancel</button>
                <button type="button" id="confirmButton" onclick="confirmAction()" class="btn btn-warning flex-1">Confirm</button>
            </div>
        </div>
    </div>
</div>

<div id="containerSizeToastContainer" class="fixed top-20 right-4 z-[10003] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>
{% endblock %}

{% block page_scripts %}
<script>
let pendingAction = null;
let pendingContainerSizeId = null;

document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');

    if (!searchInput) return;

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
});

function applyFilters() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value;

    const rows = document.querySelectorAll('#containerSizesTableBody tr[data-name]');
    let visibleCount = 0;

    rows.forEach(function (row) {
        const name = row.getAttribute('data-name');
        const code = row.getAttribute('data-code');
        const status = row.getAttribute('data-status');

        const matchesSearch = !searchTerm || name.includes(searchTerm) || code.includes(searchTerm);
        const matchesStatus = !statusFilter || status === statusFilter;

        if (matchesSearch && matchesStatus) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    let noResultsRow = document.getElementById('no-results-row');
    if (visibleCount === 0 && rows.length > 0) {
        if (!noResultsRow) {
            const tbody = document.getElementById('containerSizesTableBody');
            tbody.insertAdjacentHTML('beforeend',
                '<tr id="no-results-row"><td colspan="5" class="text-center py-8 text-sm text-base-content/60">No container sizes match your search criteria.</td></tr>'
            );
        }
    } else if (noResultsRow && visibleCount > 0) {
        noResultsRow.remove();
    }
}

function openConfirmModal(title, message, action, containerSizeId) {
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMessage').textContent = message;

    pendingAction = action;
    pendingContainerSizeId = containerSizeId;

    const modal = document.getElementById('confirmModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    pendingAction = null;
    pendingContainerSizeId = null;
}

function confirmAction() {
    if (pendingAction === 'toggle') {
        executeToggleStatus(pendingContainerSizeId);
    }
    closeConfirmModal();
}

function toggleContainerSizeStatus(containerSizeId) {
    const badge = document.getElementById('status-badge-' + containerSizeId);
    const isActive = badge.textContent.trim() === 'Active';

    openConfirmModal(
        isActive ? 'Deactivate Container Size' : 'Activate Container Size',
        isActive
            ? 'Are you sure you want to deactivate this container size? It will no longer be available for selection in shipment forms.'
            : 'Are you sure you want to activate this container size?',
        'toggle',
        containerSizeId
    );
}

function executeToggleStatus(containerSizeId) {
    fetch('/admin/container-sizes/' + containerSizeId + '/toggle-status', { method: 'POST' })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                showNotification(data.message, 'success');

                const badge = document.getElementById('status-badge-' + containerSizeId);
                const toggleBtn = document.getElementById('toggle-btn-' + containerSizeId);
                const row = document.getElementById('container-size-row-' + containerSizeId);

                if (data.isActive) {
                    badge.className = 'badge badge-sm badge-success';
                    badge.textContent = 'Active';
                    toggleBtn.title = 'Deactivate';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--ban] size-3"></span>';
                    row.setAttribute('data-status', 'active');
                } else {
                    badge.className = 'badge badge-sm badge-error';
                    badge.textContent = 'Inactive';
                    toggleBtn.title = 'Activate';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--circle-check] size-3"></span>';
                    row.setAttribute('data-status', 'inactive');
                }
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(function () {
            showNotification('Failed to update container size status', 'error');
        });
}

function showNotification(message, type) {
    const container = document.getElementById('containerSizeToastContainer');
    if (!container) return;

    const typeClass = type === 'success' ? 'alert-success' : 'alert-error';
    const icon = type === 'success' ? 'icon-[tabler--check]' : 'icon-[tabler--alert-circle]';
    const toast = document.createElement('div');
    toast.className = 'alert ' + typeClass + ' shadow-lg pointer-events-auto';
    toast.innerHTML = '<span class="' + icon + ' size-5"></span><span>' + message + '</span>';
    container.appendChild(toast);

    window.setTimeout(function () {
        toast.remove();
    }, 4000);
}
</script>
{% endblock %}
