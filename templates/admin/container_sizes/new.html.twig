{% extends 'layout/admin_base.html.twig' %}

{% block title %}Create New Container Size - OPTIMUS{% endblock %}

{% block content %}
<div class="space-y-6">
<!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('admin_container_sizes_index') }}">Container Sizes</a></li>
                            <li>Create</li>
                        </ul>
                    </div>
                    <h1 class="text-xl sm:text-2xl font-bold text-base-content">Create New Container Size</h1>
                    <p class="text-sm text-base-content/60 mt-1">Add a new container size classification to the system</p>
                </div>
                <a href="{{ path('admin_container_sizes_index') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        <div class="max-w-2xl mx-auto">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success mb-6">
                    <span class="icon-[tabler--check] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error mb-6">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6 sm:p-8">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="size-12 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--resize] size-6 text-primary"></span>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-base-content">Container Size Details</h2>
                            <p class="text-sm text-base-content/60">Define the name, code, and description</p>
                        </div>
                    </div>

                    <form id="containerSizeForm" method="POST" action="{{ path('admin_container_sizes_store') }}" class="space-y-5">
                        <div class="form-control">
                            <label class="label py-1" for="containerSizeName">
                                <span class="label-text font-medium">Name <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   id="containerSizeName"
                                   name="name"
                                   required
                                   class="input input-bordered w-full"
                                   placeholder="e.g., 20 Feet">
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Display name for this container size</span>
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="containerSizeCode">
                                <span class="label-text font-medium">Code <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   id="containerSizeCode"
                                   name="code"
                                   required
                                   class="input input-bordered w-full font-mono"
                                   placeholder="e.g., 20FT">
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Unique identifier (e.g., 20FT, 40FT, 40HC)</span>
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="containerSizeDescription">
                                <span class="label-text font-medium">Description</span>
                            </label>
                            <textarea id="containerSizeDescription"
                                      name="description"
                                      rows="3"
                                      class="textarea textarea-bordered w-full"
                                      placeholder="e.g., Standard 20-foot container (1 TEU)"></textarea>
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Optional detailed description</span>
                            </label>
                        </div>

                        <div class="alert alert-info">
                            <span class="icon-[tabler--info-circle] size-5"></span>
                            <div class="text-sm">
                                <p class="font-medium">New Container Size Status</p>
                                <p class="mt-1 opacity-90">The container size will be created as <span class="badge badge-success badge-xs">Active</span> by default and will be immediately available in shipment forms.</p>
                            </div>
                        </div>

                        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
                            <a href="{{ path('admin_container_sizes_index') }}" class="btn btn-ghost w-full sm:w-auto">
                                Cancel
                            </a>
                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-primary gap-2 w-full sm:w-auto">
                                <span id="btnSpinner" class="loading loading-spinner loading-sm hidden"></span>
                                <span id="btnText">Create Container Size</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('containerSizeForm').addEventListener('submit', function () {
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    submitBtn.disabled = true;
    btnText.textContent = 'Creating...';
    btnSpinner.classList.remove('hidden');
});
</script>
{% endblock %}
