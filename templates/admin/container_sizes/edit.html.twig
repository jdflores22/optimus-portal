{% extends 'base.html.twig' %}

{% block title %}Edit Container Size - OPTIMUS{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center mb-2">
            <a href="{{ path('admin_container_sizes_index') }}" class="text-blue-600 hover:text-blue-800 mr-2">
                <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-2xl font-bold text-gray-900">Edit Container Size</h1>
        </div>
        <p class="text-sm text-gray-600">Update container size information</p>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-100 text-green-800">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-100 text-red-800">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Edit Form -->
    <div class="bg-white shadow-md rounded-lg p-6 max-w-2xl">
        <form id="containerSizeForm" method="POST" action="{{ path('admin_container_sizes_update', {id: containerSize.id}) }}">
            <div class="space-y-6">
                <!-- Name -->
                <div>
                    <label for="containerSizeName" class="block text-sm font-medium text-gray-700 mb-2">
                        Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" 
                           id="containerSizeName" 
                           name="name" 
                           value="{{ containerSize.name }}"
                           required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., 20 Feet">
                    <p class="mt-1 text-sm text-gray-500">Enter the display name for this container size</p>
                </div>

                <!-- Code -->
                <div>
                    <label for="containerSizeCode" class="block text-sm font-medium text-gray-700 mb-2">
                        Code <span class="text-red-500">*</span>
                    </label>
                    <input type="text" 
                           id="containerSizeCode" 
                           name="code" 
                           value="{{ containerSize.code }}"
                           required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., 20FT">
                    <p class="mt-1 text-sm text-gray-500">Enter a unique code identifier (e.g., 20FT, 40FT, 40HC)</p>
                </div>

                <!-- Description -->
                <div>
                    <label for="containerSizeDescription" class="block text-sm font-medium text-gray-700 mb-2">
                        Description
                    </label>
                    <textarea id="containerSizeDescription" 
                              name="description" 
                              rows="3"
                              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                              placeholder="e.g., Standard 20-foot container (1 TEU)">{{ containerSize.description }}</textarea>
                    <p class="mt-1 text-sm text-gray-500">Optional detailed description of this container size</p>
                </div>

                <!-- Container Size Status Toggle -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-700">Container Size Status</p>
                            <p class="text-xs text-gray-500 mt-1">Activate or deactivate this container size</p>
                        </div>
                        <div class="flex items-center space-x-3">
                            <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full {{ containerSize.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}" id="statusBadge">
                                {{ containerSize.isActive ? 'Active' : 'Inactive' }}
                            </span>
                            <button type="button" 
                                    onclick="toggleContainerSizeStatus()"
                                    id="toggleStatusBtn"
                                    class="px-4 py-2 {{ containerSize.isActive ? 'bg-yellow-600 hover:bg-yellow-700' : 'bg-green-600 hover:bg-green-700' }} text-white text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors">
                                {{ containerSize.isActive ? 'Deactivate' : 'Activate' }}
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Timestamps -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-gray-500">Created</p>
                            <p class="text-gray-900 font-medium">{{ containerSize.createdAt|date('M d, Y H:i') }}</p>
                        </div>
                        <div>
                            <p class="text-gray-500">Last Updated</p>
                            <p class="text-gray-900 font-medium">{{ containerSize.updatedAt|date('M d, Y H:i') }}</p>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
                    <a href="{{ path('admin_container_sizes_index') }}" 
                       class="px-6 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition-colors">
                        Cancel
                    </a>
                    <button type="submit" 
                            id="submitBtn"
                            class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors inline-flex items-center">
                        <span id="btnText">Update Container Size</span>
                        <svg id="btnSpinner" class="hidden animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999]" style="display: none;">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="relative p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0" id="confirmIcon">
                        <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                    </div>
                    <h3 class="ml-3 text-lg font-medium leading-6 text-gray-900" id="confirmTitle">Confirm Action</h3>
                </div>
                <p class="text-sm text-gray-500 mb-6" id="confirmMessage">Are you sure you want to proceed?</p>
                <div class="flex justify-end space-x-3">
                    <button type="button" 
                            onclick="closeConfirmModal()" 
                            class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400">
                        Cancel
                    </button>
                    <button type="button" 
                            id="confirmButton"
                            onclick="confirmAction()" 
                            class="px-4 py-2 text-white rounded-md focus:outline-none focus:ring-2">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let pendingAction = null;

document.getElementById('containerSizeForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Show confirmation modal for update
    document.getElementById('confirmTitle').textContent = 'Update Container Size';
    document.getElementById('confirmMessage').textContent = 'Are you sure you want to save these changes to the container size?';
    
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');
    
    icon.innerHTML = `
        <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
    `;
    confirmBtn.className = 'px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
    
    pendingAction = 'update';
    const modal = document.getElementById('confirmModal');
    modal.style.display = 'block';
    modal.classList.remove('hidden');
});

function toggleContainerSizeStatus() {
    const statusBadge = document.getElementById('statusBadge');
    const isActive = statusBadge.textContent.trim() === 'Active';
    
    const title = isActive ? 'Deactivate Container Size' : 'Activate Container Size';
    const message = isActive 
        ? 'Are you sure you want to deactivate this container size? It will no longer be available for selection in shipment forms.' 
        : 'Are you sure you want to activate this container size?';
    
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');
    
    icon.innerHTML = `
        <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
    `;
    confirmBtn.className = 'px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500';
    
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMessage').textContent = message;
    
    pendingAction = 'toggle';
    const modal = document.getElementById('confirmModal');
    modal.style.display = 'block';
    modal.classList.remove('hidden');
}

function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.style.display = 'none';
    modal.classList.add('hidden');
    pendingAction = null;
}

function confirmAction() {
    if (pendingAction === 'update') {
        submitForm();
    } else if (pendingAction === 'toggle') {
        executeToggleStatus();
    }
    closeConfirmModal();
}

function submitForm() {
    const form = document.getElementById('containerSizeForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    
    // Disable button and show spinner
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
    btnText.textContent = 'Updating...';
    btnSpinner.classList.remove('hidden');
    
    // Submit the form
    form.submit();
}

function executeToggleStatus() {
    const containerSizeId = {{ containerSize.id }};
    const statusBadge = document.getElementById('statusBadge');
    const toggleBtn = document.getElementById('toggleStatusBtn');
    
    // Disable button during request
    toggleBtn.disabled = true;
    toggleBtn.classList.add('opacity-75', 'cursor-not-allowed');
    
    fetch(`/admin/container-sizes/${containerSizeId}/toggle-status`, {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update badge and button
            if (data.isActive) {
                statusBadge.className = 'px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 text-green-800';
                statusBadge.textContent = 'Active';
                toggleBtn.className = 'px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors';
                toggleBtn.textContent = 'Deactivate';
            } else {
                statusBadge.className = 'px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-red-100 text-red-800';
                statusBadge.textContent = 'Inactive';
                toggleBtn.className = 'px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors';
                toggleBtn.textContent = 'Activate';
            }
            
            // Show success message
            showMessage(data.message, 'success');
        } else {
            showMessage(data.message, 'error');
        }
        
        // Re-enable button
        toggleBtn.disabled = false;
        toggleBtn.classList.remove('opacity-75', 'cursor-not-allowed');
    })
    .catch(error => {
        showMessage('Failed to update container size status', 'error');
        toggleBtn.disabled = false;
        toggleBtn.classList.remove('opacity-75', 'cursor-not-allowed');
    });
}

function showMessage(message, type) {
    // Create message element if it doesn't exist
    let messageContainer = document.getElementById('messageContainer');
    if (!messageContainer) {
        messageContainer = document.createElement('div');
        messageContainer.id = 'messageContainer';
        messageContainer.className = 'fixed top-20 right-4 z-[9999]';
        messageContainer.innerHTML = `
            <div class="bg-white shadow-lg rounded-lg p-4 max-w-md min-w-[300px]">
                <div class="flex items-center">
                    <div class="flex-shrink-0" id="messageIcon"></div>
                    <div class="ml-3 flex-1">
                        <p class="text-sm font-medium text-gray-900" id="messageText"></p>
                    </div>
                    <button onclick="closeMessage()" class="ml-4 flex-shrink-0 text-gray-400 hover:text-gray-500">
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                        </svg>
                    </button>
                </div>
            </div>
        `;
        document.body.appendChild(messageContainer);
    }
    
    const icon = document.getElementById('messageIcon');
    const text = document.getElementById('messageText');
    
    if (type === 'success') {
        icon.innerHTML = `
            <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        `;
    } else {
        icon.innerHTML = `
            <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        `;
    }
    
    text.textContent = message;
    messageContainer.classList.remove('hidden');
    
    setTimeout(() => {
        messageContainer.classList.add('hidden');
    }, 4000);
}

function closeMessage() {
    const container = document.getElementById('messageContainer');
    if (container) {
        container.classList.add('hidden');
    }
}

// Close modal when clicking outside
document.getElementById('confirmModal').addEventListener('click', function(event) {
    if (event.target === this) {
        closeConfirmModal();
    }
});
</script>
{% endblock %}
