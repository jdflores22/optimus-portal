{% extends 'layout/admin_base.html.twig' %}

{% block title %}Edit Container Size — {{ containerSize.name }} - OPTIMUS{% endblock %}

{% block content %}
<div class="space-y-6">
<!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('admin_container_sizes_index') }}">Container Sizes</a></li>
                            <li>{{ containerSize.name }}</li>
                            <li>Edit</li>
                        </ul>
                    </div>
                    <h1 class="text-xl sm:text-2xl font-bold text-base-content truncate">Edit Container Size</h1>
                    <p class="text-sm text-base-content/60 mt-1">Update container size information and settings</p>
                </div>
                <a href="{{ path('admin_container_sizes_index') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        <div class="max-w-2xl mx-auto">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success mb-6">
                    <span class="icon-[tabler--check] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error mb-6">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6 sm:p-8">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="size-12 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--resize] size-6 text-primary"></span>
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-lg font-semibold text-base-content truncate">{{ containerSize.name }}</h2>
                            <div class="flex flex-wrap items-center gap-2 mt-1">
                                <span class="badge badge-primary badge-sm font-mono">{{ containerSize.code }}</span>
                                <span class="badge badge-sm {{ containerSize.isActive ? 'badge-success' : 'badge-error' }}" id="statusBadge">
                                    {{ containerSize.isActive ? 'Active' : 'Inactive' }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <form id="containerSizeForm" method="POST" action="{{ path('admin_container_sizes_update', {id: containerSize.id}) }}" class="space-y-5">
                        <div class="form-control">
                            <label class="label py-1" for="containerSizeName">
                                <span class="label-text font-medium">Name <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   id="containerSizeName"
                                   name="name"
                                   value="{{ containerSize.name }}"
                                   required
                                   class="input input-bordered w-full"
                                   placeholder="e.g., 20 Feet">
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Display name for this container size</span>
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="containerSizeCode">
                                <span class="label-text font-medium">Code <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   id="containerSizeCode"
                                   name="code"
                                   value="{{ containerSize.code }}"
                                   required
                                   class="input input-bordered w-full font-mono"
                                   placeholder="e.g., 20FT">
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Unique identifier (e.g., 20FT, 40FT, 40HC)</span>
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="containerSizeDescription">
                                <span class="label-text font-medium">Description</span>
                            </label>
                            <textarea id="containerSizeDescription"
                                      name="description"
                                      rows="3"
                                      class="textarea textarea-bordered w-full"
                                      placeholder="e.g., Standard 20-foot container (1 TEU)">{{ containerSize.description }}</textarea>
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Optional detailed description</span>
                            </label>
                        </div>

                        <!-- Status Toggle -->
                        <div class="bg-base-200/60 rounded-xl p-4 sm:p-5">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                                <div>
                                    <p class="text-sm font-medium text-base-content">Container Size Status</p>
                                    <p class="text-xs text-base-content/60 mt-1">Activate or deactivate this container size</p>
                                </div>
                                <button type="button"
                                        onclick="toggleContainerSizeStatus()"
                                        id="toggleStatusBtn"
                                        class="btn btn-sm {{ containerSize.isActive ? 'btn-warning' : 'btn-success' }} gap-2 w-full sm:w-auto">
                                    <span class="icon-[tabler--{{ containerSize.isActive ? 'ban' : 'circle-check' }}] size-4"></span>
                                    {{ containerSize.isActive ? 'Deactivate' : 'Activate' }}
                                </button>
                            </div>
                        </div>

                        <!-- Timestamps -->
                        <div class="bg-base-200/60 rounded-xl p-4 sm:p-5">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                                <div>
                                    <p class="text-base-content/60 flex items-center gap-1">
                                        <span class="icon-[tabler--calendar-plus] size-4"></span>
                                        Created
                                    </p>
                                    <p class="text-base-content font-medium mt-1">{{ containerSize.createdAt|date('M d, Y H:i') }}</p>
                                </div>
                                <div>
                                    <p class="text-base-content/60 flex items-center gap-1">
                                        <span class="icon-[tabler--calendar-event] size-4"></span>
                                        Last Updated
                                    </p>
                                    <p class="text-base-content font-medium mt-1">{{ containerSize.updatedAt|date('M d, Y H:i') }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
                            <a href="{{ path('admin_container_sizes_index') }}" class="btn btn-ghost w-full sm:w-auto">
                                Cancel
                            </a>
                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-primary gap-2 w-full sm:w-auto">
                                <span id="btnSpinner" class="loading loading-spinner loading-sm hidden"></span>
                                <span id="btnText">Update Container Size</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
{% endblock %}

{% block page_modals %}
<div id="confirmModal"
     class="hidden fixed inset-0 z-[10002] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirmTitle">
    <div class="absolute inset-0 bg-black/60" onclick="closeConfirmModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div id="confirmIconWrap" class="size-14 rounded-full flex items-center justify-center mx-auto mb-4">
                <span id="confirmIcon" class="size-7"></span>
            </div>
            <h3 id="confirmTitle" class="text-lg font-bold mb-2">Confirm Action</h3>
            <p id="confirmMessage" class="text-sm text-base-content/70 mb-6">Are you sure you want to proceed?</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeConfirmModal()" class="btn btn-ghost flex-1">Cancel</button>
                <button type="button" id="confirmButton" onclick="confirmAction()" class="btn flex-1">Confirm</button>
            </div>
        </div>
    </div>
</div>

<div id="containerSizeToastContainer" class="fixed top-20 right-4 z-[10003] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>
{% endblock %}

{% block page_scripts %}
<script>
let pendingAction = null;

document.getElementById('containerSizeForm').addEventListener('submit', function (e) {
    e.preventDefault();

    document.getElementById('confirmTitle').textContent = 'Update Container Size';
    document.getElementById('confirmMessage').textContent = 'Are you sure you want to save these changes to the container size?';

    setConfirmModalStyle('primary', 'icon-[tabler--device-floppy]', 'btn-primary', 'Save Changes');

    pendingAction = 'update';
    openConfirmModal();
});

function toggleContainerSizeStatus() {
    const statusBadge = document.getElementById('statusBadge');
    const isActive = statusBadge.textContent.trim() === 'Active';

    document.getElementById('confirmTitle').textContent = isActive ? 'Deactivate Container Size' : 'Activate Container Size';
    document.getElementById('confirmMessage').textContent = isActive
        ? 'Are you sure you want to deactivate this container size? It will no longer be available for selection in shipment forms.'
        : 'Are you sure you want to activate this container size?';

    setConfirmModalStyle('warning', 'icon-[tabler--alert-triangle]', 'btn-warning', isActive ? 'Deactivate' : 'Activate');

    pendingAction = 'toggle';
    openConfirmModal();
}

function setConfirmModalStyle(iconBg, iconClass, btnClass, btnText) {
    const iconWrap = document.getElementById('confirmIconWrap');
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');

    if (iconBg === 'primary') {
        iconWrap.className = 'size-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4';
        icon.className = iconClass + ' size-7 text-primary';
    } else {
        iconWrap.className = 'size-14 bg-warning/10 rounded-full flex items-center justify-center mx-auto mb-4';
        icon.className = iconClass + ' size-7 text-warning';
    }

    confirmBtn.className = 'btn ' + btnClass + ' flex-1';
    confirmBtn.textContent = btnText;
}

function openConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    pendingAction = null;
}

function confirmAction() {
    if (pendingAction === 'update') {
        submitForm();
    } else if (pendingAction === 'toggle') {
        executeToggleStatus();
    }
    closeConfirmModal();
}

function submitForm() {
    const form = document.getElementById('containerSizeForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    submitBtn.disabled = true;
    btnText.textContent = 'Updating...';
    btnSpinner.classList.remove('hidden');

    form.submit();
}

function executeToggleStatus() {
    const containerSizeId = {{ containerSize.id }};
    const statusBadge = document.getElementById('statusBadge');
    const toggleBtn = document.getElementById('toggleStatusBtn');

    toggleBtn.disabled = true;

    fetch('/admin/container-sizes/' + containerSizeId + '/toggle-status', { method: 'POST' })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                if (data.isActive) {
                    statusBadge.className = 'badge badge-sm badge-success';
                    statusBadge.textContent = 'Active';
                    toggleBtn.className = 'btn btn-sm btn-warning gap-2 w-full sm:w-auto';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--ban] size-4"></span> Deactivate';
                } else {
                    statusBadge.className = 'badge badge-sm badge-error';
                    statusBadge.textContent = 'Inactive';
                    toggleBtn.className = 'btn btn-sm btn-success gap-2 w-full sm:w-auto';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--circle-check] size-4"></span> Activate';
                }

                showNotification(data.message, 'success');
            } else {
                showNotification(data.message, 'error');
            }

            toggleBtn.disabled = false;
        })
        .catch(function () {
            showNotification('Failed to update container size status', 'error');
            toggleBtn.disabled = false;
        });
}

function showNotification(message, type) {
    const container = document.getElementById('containerSizeToastContainer');
    if (!container) return;

    const typeClass = type === 'success' ? 'alert-success' : 'alert-error';
    const icon = type === 'success' ? 'icon-[tabler--check]' : 'icon-[tabler--alert-circle]';
    const toast = document.createElement('div');
    toast.className = 'alert ' + typeClass + ' shadow-lg pointer-events-auto';
    toast.innerHTML = '<span class="' + icon + ' size-5"></span><span>' + message + '</span>';
    container.appendChild(toast);

    window.setTimeout(function () {
        toast.remove();
    }, 4000);
}
</script>
{% endblock %}
