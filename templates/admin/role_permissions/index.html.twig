{% extends 'layout/admin_base.html.twig' %}

{% block title %}Role Permissions - {{ shipping_line.brandName }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-user-shield"></i>
                        Role Permissions - {{ shipping_line.brandName }}
                    </h3>
                    <div class="card-tools">
                        <a href="{{ path('admin_shipping_line_configuration_index', {id: shipping_line.id}) }}" 
                           class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Configuration
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        {% for role in configurable_roles %}
                            {% set roleConfig = null %}
                            {% for config in role_permissions %}
                                {% if config.role == role %}
                                    {% set roleConfig = config %}
                                {% endif %}
                            {% endfor %}
                            
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">{{ role.value|replace({'_': ' '})|title }}</h5>
                                        {% if roleConfig %}
                                            <span class="badge badge-success">Configured</span>
                                        {% else %}
                                            <span class="badge badge-secondary">Default</span>
                                        {% endif %}
                                    </div>
                                    <div class="card-body">
                                        {% if roleConfig %}
                                            <p class="text-muted">
                                                <strong>Permissions:</strong> {{ roleConfig.permissions|length }}
                                                {% if roleConfig.inheritFromParent %}
                                                    <br><small class="text-info">+ Inherited permissions</small>
                                                {% endif %}
                                            </p>
                                            <p class="text-muted">
                                                <strong>Last Updated:</strong><br>
                                                {{ roleConfig.updatedAt|date('Y-m-d H:i') }}
                                            </p>
                                            {% if roleConfig.restrictions %}
                                                <p class="text-warning">
                                                    <i class="fas fa-exclamation-triangle"></i>
                                                    Has restrictions
                                                </p>
                                            {% endif %}
                                        {% else %}
                                            {% set defaultPermissions = [] %}
                                            {% for permission in available_permissions %}
                                                {% if permission starts with 'user.' and role.value == 'SHIPPING_LINES_ADMIN' %}
                                                    {% set defaultPermissions = defaultPermissions|merge([permission]) %}
                                                {% endif %}
                                            {% endfor %}
                                            <p class="text-muted">
                                                Using default permissions
                                            </p>
                                        {% endif %}
                                    </div>
                                    <div class="card-footer">
                                        <div class="btn-group w-100">
                                            <a href="{{ path('admin_role_permissions_configure', {id: shipping_line.id, role: role.value}) }}" 
                                               class="btn btn-primary btn-sm">
                                                <i class="fas fa-cog"></i> Configure
                                            </a>
                                            {% if roleConfig %}
                                                <button type="button" class="btn btn-warning btn-sm" 
                                                        onclick="resetRolePermissions('{{ role.value }}')">
                                                    <i class="fas fa-undo"></i> Reset
                                                </button>
                                                <button type="button" class="btn btn-danger btn-sm" 
                                                        onclick="deleteRolePermissions('{{ role.value }}')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Available Permissions</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        {% set permissionGroups = {} %}
                                        {% for permission in available_permissions %}
                                            {% set category = permission|split('.')|first %}
                                            {% if permissionGroups[category] is not defined %}
                                                {% set permissionGroups = permissionGroups|merge({(category): []}) %}
                                            {% endif %}
                                            {% set permissionGroups = permissionGroups|merge({(category): permissionGroups[category]|merge([permission])}) %}
                                        {% endfor %}

                                        {% for category, permissions in permissionGroups %}
                                            <div class="col-md-3 mb-3">
                                                <h6 class="text-uppercase text-muted">{{ category|title }}</h6>
                                                <ul class="list-unstyled">
                                                    {% for permission in permissions %}
                                                        <li>
                                                            <small class="text-muted">{{ permission }}</small>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function resetRolePermissions(role) {
    if (confirm('Are you sure you want to reset permissions for ' + role + ' to defaults?')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/role-permissions/${shipping_line.id}/reset/${role}`;
        
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = '{{ csrf_token('reset_permissions') }}';
        form.appendChild(tokenInput);
        
        document.body.appendChild(form);
        form.submit();
    }
}

function deleteRolePermissions(role) {
    if (confirm('Are you sure you want to delete custom permissions for ' + role + '? This will revert to default permissions.')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/role-permissions/${shipping_line.id}/delete/${role}`;
        
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = '{{ csrf_token('delete_permissions') }}';
        form.appendChild(tokenInput);
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}