{% extends 'base.html.twig' %}

{% block title %}Activity Log Reports{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="md:flex md:items-center md:justify-between mb-6">
            <div class="flex-1 min-w-0">
                <nav class="flex" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-4">
                        <li>
                            <div>
                                <a href="{{ path('admin_activity_logs_list') }}" class="text-gray-400 hover:text-gray-500">
                                    <svg class="flex-shrink-0 h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                                    </svg>
                    <a href="{{ path('admin_activity_logs_list') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Logs
                    </a>    </div>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                </svg>
                                <span class="ml-4 text-sm font-medium text-gray-500">Reports</span>
                            </div>
                        </li>
                    </ol>
                </nav>
                <h2 class="mt-2 text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    Activity Log Reports
                    {% if shippingLineScope %}
                        - {{ shippingLineScope.brandName }}
                    {% elseif currentUser.role.value == 'SYSTEM_ADMIN' %}
                        - System Wide
                    {% endif %}
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Generate comprehensive reports on system activity and user behavior
                </p>
            </div>
        </div>

        <!-- Report Types Grid -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-2">
            <!-- Summary Report -->
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <h3 class="text-lg font-medium text-gray-900">Activity Summary Report</h3>
                            <p class="mt-1 text-sm text-gray-500">
                                Overview of all system activities with counts and trends by activity type, user role, and time period.
                            </p>
                        </div>
                    </div>
                    <div class="mt-6">
                        <button onclick="generateReport('summary')" 
                                class="w-full inline-flex justifyique Users</h5>
                                        <h2>{{ reportData.uniqueUsers|number_format }}</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Activity Breakdown</h5>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="activityChart" width="400" height="200"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Activity Types</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Activity Type</th>
                                                        <th>Count</th>
                                                        <th>Percentage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for activity in reportData.activityBreakdown %}
                                                        <tr>
                                                            <td>{{ activity.activityType|replace({'_': ' '})|title }}</td>
                                                            <td>{{ activity.count|number_format }}</td>
                                                            <td>{{ ((activity.count / reportData.totalActivities) * 100)|number_format(2) }}%</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    {% elseif reportType == 'security' %}
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card bg-danger text-white">
                                    <div class="card-body">
                                        <h5 class="card-title">Security Events</h5>
                                        <h2>{{ reportData.totalSecurityEvents|number_format }}</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Security Event Types</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Event Type</th>
                                                        <th>Count</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for event in reportData.securityCounts %}
                                                        <tr>
                                                            <td>{{ event.activityType|replace({'_': ' '})|title }}</td>
                                                            <td>{{ event.count|number_format }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Recent Security Events</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Date/Time</th>
                                                        <th>Event Type</th>
                                                        <th>User</th>
                                                        <th>IP Address</th>
                                                        <th>Details</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for event in reportData.securityEvents|slice(0, 20) %}
                                                        <tr>
                                                            <td>{{ event.createdAt|date('Y-m-d H:i:s') }}</td>
                                                            <td>
                                                                <span class="badge bg-danger">{{ event.activityType|replace({'_': ' '})|title }}</span>
                                                            </td>
                                                            <td>{{ event.user.email }}</td>
                                                            <td><code>{{ event.ipAddress }}</code></td>
                                                            <td>{{ event.activityDescription }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    {% elseif reportType == 'user_activity' %}
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>User Activity Summary</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>User</th>
                                                        <th>Role</th>
                                                        <th>Activity Count</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for user in reportData.userActivities %}
                                                        <tr>
                                                            <td>{{ user.email }}</td>
                                                            <td><span class="badge bg-secondary">{{ user.role }}</span></td>
                                                            <td>{{ user.activityCount|number_format }}</td>
                                                            <td>
                                                                <a href="{{ path('admin_activity_logs_list', {userId: user.id}) }}" 
                                                                   class="btn btn-sm btn-outline-primary">
                                                                    View Activities
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    {% elseif reportType == 'business_operations' %}
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card bg-success text-white">
                                    <div class="card-body">
                                        <h5 class="card-title">Business Events</h5>
                                        <h2>{{ reportData.totalBusinessEvents|number_format }}</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Business Operation Types</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Operation Type</th>
                                                        <th>Count</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for operation in reportData.businessCounts %}
                                                        <tr>
                                                            <td>{{ operation.activityType|replace({'_': ' '})|title }}</td>
                                                            <td>{{ operation.count|number_format }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Recent Business Operations</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Date/Time</th>
                                                        <th>Operation</th>
                                                        <th>User</th>
                                                        <th>Entity</th>
                                                        <th>Details</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for operation in reportData.businessEvents|slice(0, 20) %}
                                                        <tr>
                                                            <td>{{ operation.createdAt|date('Y-m-d H:i:s') }}</td>
                                                            <td>
                                                                <span class="badge bg-success">{{ operation.activityType|replace({'_': ' '})|title }}</span>
                                                            </td>
                                                            <td>{{ operation.user.email }}</td>
                                                            <td>
                                                                {% if operation.entityType %}
                                                                    {{ operation.entityType }}
                                                                    {% if operation.entityId %}#{{ operation.entityId }}{% endif %}
                                                                {% else %}
                                                                    -
                                                                {% endif %}
                                                            </td>
                                                            <td>{{ operation.activityDescription }}</td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('admin_activity_logs_list') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Logs
                        </a>
                        
                        <div class="btn-group">
                            <a href="{{ path('admin_activity_logs_export', {format: 'csv', from: dateRange.from, to: dateRange.to}) }}" 
                               class="btn btn-success">
                                <i class="fas fa-download"></i> Export CSV
                            </a>
                            <a href="{{ path('admin_activity_logs_export', {format: 'json', from: dateRange.from, to: dateRange.to}) }}" 
                               class="btn btn-info">
                                <i class="fas fa-download"></i> Export JSON
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% if reportType == 'summary' and reportData.activityBreakdown %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('activityChart').getContext('2d');
    const data = {
        labels: [
            {% for activity in reportData.activityBreakdown %}
                '{{ activity.activityType|replace({'_': ' '})|title }}'{% if not loop.last %},{% endif %}
            {% endfor %}
        ],
        datasets: [{
            data: [
                {% for activity in reportData.activityBreakdown %}
                    {{ activity.count }}{% if not loop.last %},{% endif %}
                {% endfor %}
            ],
            backgroundColor: [
                '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
                '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FF6384'
            ]
        }]
    };
    
    new Chart(ctx, {
        type: 'doughnut',
        data: data,
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
});
</script>
{% endif %}
{% endblock %}