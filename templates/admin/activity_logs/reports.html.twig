{% extends 'layout/admin_base.html.twig' %}

{% block title %}Activity Log Reports - OPTIMUS{% endblock %}
{% set reportTypes = {
    'summary': {
        'label': 'Activity Summary',
        'icon': 'chart-bar',
        'activeClass': 'border-primary bg-primary/5 ring-1 ring-primary/30',
        'iconClass': 'bg-primary/10 text-primary',
        'headerClass': 'text-primary',
        'description': 'Overview of all activities with counts by type and unique users.'
    },
    'security': {
        'label': 'Security Report',
        'icon': 'shield-lock',
        'activeClass': 'border-error bg-error/5 ring-1 ring-error/30',
        'iconClass': 'bg-error/10 text-error',
        'headerClass': 'text-error',
        'description': 'Login events, access denials, and other security-related activity.'
    },
    'user_activity': {
        'label': 'User Activity',
        'icon': 'users',
        'activeClass': 'border-info bg-info/5 ring-1 ring-info/30',
        'iconClass': 'bg-info/10 text-info',
        'headerClass': 'text-info',
        'description': 'Activity volume grouped by user and role.'
    },
    'business_operations': {
        'label': 'Business Operations',
        'icon': 'briefcase',
        'activeClass': 'border-success bg-success/5 ring-1 ring-success/30',
        'iconClass': 'bg-success/10 text-success',
        'headerClass': 'text-success',
        'description': 'Payments, documents, status changes, and operational events.'
    }
} %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li><a href="{{ path('admin_activity_logs_list') }}">Activity Logs</a></li>
                                <li>Reports</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--report-analytics] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">
                                    Activity Log Reports
                                    {% if shippingLineScope %}
                                        <span class="text-base-content/60 font-semibold text-lg sm:text-xl">— {{ shippingLineScope.brandName }}</span>
                                    {% elseif isSystemAdmin %}
                                        <span class="text-base-content/60 font-semibold text-lg sm:text-xl">— System Wide</span>
                                    {% endif %}
                                </h1>
                                <p class="text-sm text-base-content/60 mt-1">Generate reports on system activity and user behavior</p>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('admin_activity_logs_list') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to Logs
                    </a>
                </div>
            </div>
        </div>

        {# Date range & report type #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-6 space-y-5">
                <div class="flex items-center gap-2">
                    <span class="icon-[tabler--calendar] size-5 text-base-content/70"></span>
                    <h2 class="font-semibold text-base text-base-content">Report Configuration</h2>
                </div>

                <form method="GET" action="{{ path('admin_activity_logs_reports') }}" id="activityReportForm" class="space-y-4">
                    <input type="hidden" name="type" id="activityReportType" value="{{ reportType }}">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="form-control">
                            <label class="label py-1" for="from_date"><span class="label-text font-medium">From Date</span></label>
                            <input type="date" name="from" id="from_date" value="{{ dateRange.from }}" class="input input-bordered w-full">
                        </div>
                        <div class="form-control">
                            <label class="label py-1" for="to_date"><span class="label-text font-medium">To Date</span></label>
                            <input type="date" name="to" id="to_date" value="{{ dateRange.to }}" class="input input-bordered w-full">
                        </div>
                        <div class="form-control sm:col-span-2 lg:col-span-2 flex flex-col justify-end">
                            <div class="flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-primary btn-sm gap-2">
                                    <span class="icon-[tabler--refresh] size-4"></span>
                                    Generate Report
                                </button>
                                <a href="{{ path('admin_activity_logs_export', {format: 'csv', from: dateRange.from, to: dateRange.to}) }}" class="btn btn-outline btn-sm gap-2">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Export CSV
                                </a>
                                <a href="{{ path('admin_activity_logs_export', {format: 'json', from: dateRange.from, to: dateRange.to}) }}" class="btn btn-ghost btn-sm gap-2">
                                    <span class="icon-[tabler--file-code] size-4"></span>
                                    Export JSON
                                </a>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {% for typeKey, typeMeta in reportTypes %}
                        <button type="button"
                                onclick="selectReportType('{{ typeKey }}')"
                                class="card border text-left transition-all {{ reportType == typeKey ? typeMeta.activeClass : 'border-base-300 bg-base-200/50 hover:border-base-content/20' }}">
                            <div class="card-body p-4 flex-row items-start gap-3">
                                <div class="size-10 rounded-xl {{ typeMeta.iconClass }} flex items-center justify-center shrink-0">
                                    <span class="icon-[tabler--{{ typeMeta.icon }}] size-5"></span>
                                </div>
                                <div class="min-w-0">
                                    <h3 class="font-semibold text-sm text-base-content">{{ typeMeta.label }}</h3>
                                    <p class="text-xs text-base-content/60 mt-1">{{ typeMeta.description }}</p>
                                </div>
                            </div>
                        </button>
                    {% endfor %}
                </div>

                <p class="text-xs text-base-content/50">
                    Showing data from <span class="font-medium text-base-content">{{ dateRange.from }}</span>
                    to <span class="font-medium text-base-content">{{ dateRange.to }}</span>
                    · Report: <span class="font-medium text-base-content">{{ reportTypes[reportType].label }}</span>
                </p>
            </div>
        </div>

        {# Report results #}
        <div class="card bg-base-100 shadow-sm overflow-hidden">
            <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="icon-[tabler--{{ reportTypes[reportType].icon }}] size-5 {{ reportTypes[reportType].headerClass }}"></span>
                    <h2 class="card-title text-base sm:text-lg">{{ reportTypes[reportType].label }}</h2>
                </div>
            </div>

            <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-5 sm:space-y-6">

                {% if reportType == 'summary' %}
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="card bg-primary/5 border border-primary/20">
                            <div class="card-body p-4">
                                <p class="text-xs text-base-content/70">Total Activities</p>
                                <p class="text-3xl font-bold text-primary mt-1">{{ reportData.totalActivities|number_format }}</p>
                            </div>
                        </div>
                        <div class="card bg-info/5 border border-info/20">
                            <div class="card-body p-4">
                                <p class="text-xs text-base-content/70">Unique Users</p>
                                <p class="text-3xl font-bold text-info mt-1">{{ reportData.uniqueUsers|number_format }}</p>
                            </div>
                        </div>
                    </div>

                    {% if reportData.activityBreakdown|length > 0 %}
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                            <div class="card bg-base-200 border border-base-300">
                                <div class="card-body p-4">
                                    <h3 class="text-sm font-semibold text-base-content mb-3">Activity Breakdown</h3>
                                    <div class="relative h-64">
                                        <canvas id="activityReportChart"></canvas>
                                    </div>
                                </div>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Activity Type</th>
                                            <th class="text-right">Count</th>
                                            <th class="text-right">Share</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for activity in reportData.activityBreakdown %}
                                            <tr>
                                                <td>{{ activity.activityType|replace({'_': ' '})|title }}</td>
                                                <td class="text-right font-medium">{{ activity.count|number_format }}</td>
                                                <td class="text-right text-base-content/60">
                                                    {% if reportData.totalActivities > 0 %}
                                                        {{ ((activity.count / reportData.totalActivities) * 100)|number_format(1) }}%
                                                    {% else %}
                                                        0%
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-10 text-base-content/50 text-sm">No activity data for this date range.</div>
                    {% endif %}

                {% elseif reportType == 'security' %}
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                        <div class="card bg-error/5 border border-error/20">
                            <div class="card-body p-4">
                                <p class="text-xs text-base-content/70">Security Events</p>
                                <p class="text-3xl font-bold text-error mt-1">{{ reportData.totalSecurityEvents|number_format }}</p>
                            </div>
                        </div>
                        <div class="lg:col-span-2 overflow-x-auto">
                            {% if reportData.securityCounts|length > 0 %}
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Event Type</th>
                                            <th class="text-right">Count</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for event in reportData.securityCounts %}
                                            <tr>
                                                <td>{{ event.activityType|replace({'_': ' '})|title }}</td>
                                                <td class="text-right font-medium">{{ event.count|number_format }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% else %}
                                <p class="text-sm text-base-content/50 py-4">No security events in this period.</p>
                            {% endif %}
                        </div>
                    </div>

                    {% if reportData.securityEvents|length > 0 %}
                        <div class="overflow-x-auto">
                            <h3 class="text-sm font-semibold text-base-content mb-3">Recent Security Events</h3>
                            <table class="table table-sm table-fixed">
                                <thead>
                                    <tr>
                                        <th class="w-[9rem]">Date/Time</th>
                                        <th class="w-[9rem]">Event</th>
                                        <th class="w-[11rem]">User</th>
                                        <th class="w-[5rem]">IP</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for event in reportData.securityEvents|slice(0, 20) %}
                                        <tr class="align-top hover">
                                            <td class="whitespace-nowrap text-xs">
                                                <div>{{ event.createdAt|date('M j, Y') }}</div>
                                                <div class="text-base-content/50">{{ event.createdAt|date('H:i:s') }}</div>
                                            </td>
                                            <td class="align-top overflow-hidden">
                                                <span class="badge badge-error badge-soft badge-sm block w-full max-w-full whitespace-normal break-words">{{ event.activityType|replace({'_': ' '})|title }}</span>
                                            </td>
                                            <td class="align-top text-sm truncate" title="{{ event.user.email }}">{{ event.user.email }}</td>
                                            <td class="text-xs font-mono whitespace-nowrap align-top">{{ event.ipAddress }}</td>
                                            <td class="align-top text-sm break-words min-w-0">{{ event.activityDescription }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                {% elseif reportType == 'user_activity' %}
                    {% if reportData.userActivities|length > 0 %}
                        <div class="overflow-x-auto">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Role</th>
                                        <th class="text-right">Activities</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in reportData.userActivities %}
                                        <tr class="hover">
                                            <td class="text-sm font-medium break-all">{{ user.email }}</td>
                                            <td>
                                                <span class="badge badge-ghost badge-soft badge-sm">
                                                    {% if user.role.value is defined %}
                                                        {{ user.role.value|replace({'_': ' '})|title }}
                                                    {% else %}
                                                        {{ user.role|replace({'_': ' '})|title }}
                                                    {% endif %}
                                                </span>
                                            </td>
                                            <td class="text-right font-medium">{{ user.activityCount|number_format }}</td>
                                            <td class="text-right">
                                                <a href="{{ path('admin_activity_logs_list', {user_id: user.id}) }}" class="btn btn-ghost btn-xs gap-1">
                                                    <span class="icon-[tabler--list] size-3.5"></span>
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-10 text-base-content/50 text-sm">No user activity data for this date range.</div>
                    {% endif %}

                {% elseif reportType == 'business_operations' %}
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                        <div class="card bg-success/5 border border-success/20">
                            <div class="card-body p-4">
                                <p class="text-xs text-base-content/70">Business Events</p>
                                <p class="text-3xl font-bold text-success mt-1">{{ reportData.totalBusinessEvents|number_format }}</p>
                            </div>
                        </div>
                        <div class="lg:col-span-2 overflow-x-auto">
                            {% if reportData.businessCounts|length > 0 %}
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Operation Type</th>
                                            <th class="text-right">Count</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for operation in reportData.businessCounts %}
                                            <tr>
                                                <td>{{ operation.activityType|replace({'_': ' '})|title }}</td>
                                                <td class="text-right font-medium">{{ operation.count|number_format }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% else %}
                                <p class="text-sm text-base-content/50 py-4">No business operations in this period.</p>
                            {% endif %}
                        </div>
                    </div>

                    {% if reportData.businessEvents|length > 0 %}
                        <div class="overflow-x-auto">
                            <h3 class="text-sm font-semibold text-base-content mb-3">Recent Business Operations</h3>
                            <table class="table table-sm table-fixed">
                                <thead>
                                    <tr>
                                        <th class="w-[9rem]">Date/Time</th>
                                        <th class="w-[9rem]">Operation</th>
                                        <th class="w-[11rem]">User</th>
                                        <th class="w-[9rem]">Entity</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for operation in reportData.businessEvents|slice(0, 20) %}
                                        <tr class="align-top hover">
                                            <td class="whitespace-nowrap text-xs">
                                                <div>{{ operation.createdAt|date('M j, Y') }}</div>
                                                <div class="text-base-content/50">{{ operation.createdAt|date('H:i:s') }}</div>
                                            </td>
                                            <td class="align-top overflow-hidden">
                                                <span class="badge badge-success badge-soft badge-sm block w-full max-w-full whitespace-normal break-words">{{ operation.activityType|replace({'_': ' '})|title }}</span>
                                            </td>
                                            <td class="align-top text-sm truncate" title="{{ operation.user.email }}">{{ operation.user.email }}</td>
                                            <td class="align-top text-sm overflow-hidden">
                                                {% if operation.entityType %}
                                                    <div class="truncate">{{ operation.entityType|replace({'_': ' '})|title }}</div>
                                                    {% if operation.entityId %}<div class="text-xs text-base-content/50">#{{ operation.entityId }}</div>{% endif %}
                                                {% else %}
                                                    <span class="text-base-content/40">—</span>
                                                {% endif %}
                                            </td>
                                            <td class="align-top text-sm break-words min-w-0">{{ operation.activityDescription }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                {% endif %}

            </div>
        </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
function selectReportType(type) {
    document.getElementById('activityReportType').value = type;
    document.getElementById('activityReportForm').submit();
}
</script>

{% if reportType == 'summary' and reportData.activityBreakdown|length > 0 %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    const canvas = document.getElementById('activityReportChart');
    if (!canvas || typeof Chart === 'undefined') return;

    const labels = [
        {% for activity in reportData.activityBreakdown %}
            {{ activity.activityType|replace({'_': ' '})|title|json_encode|raw }}{% if not loop.last %},{% endif %}
        {% endfor %}
    ];
    const values = [
        {% for activity in reportData.activityBreakdown %}
            {{ activity.count }}{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const colors = ['#6366f1', '#22c55e', '#f59e0b', '#ef4444', '#06b6d4', '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#64748b'];

    new Chart(canvas, {
        type: 'doughnut',
        data: {
            labels: labels,
            datasets: [{
                data: values,
                backgroundColor: labels.map((_, i) => colors[i % colors.length]),
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { boxWidth: 12, padding: 12 }
                }
            }
        }
    });
})();
</script>
{% endif %}
{% endblock %}
