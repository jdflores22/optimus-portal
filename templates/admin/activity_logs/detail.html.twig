{% extends 'base.html.twig' %}

{% block title %}Activity Log Details{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="md:flex md:items-center md:justify-between mb-6">
            <div class="flex-1 min-w-0">
                <nav class="flex mb-4" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-4">
                        <li>
                            <div>
                                <a href="{{ path('admin_activity_logs_list') }}" class="text-gray-400 hover:text-gray-500">
                                    <svg class="flex-shrink-0 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                    </svg>
                                    <span class="sr-only">Activity Logs</span>
                                </a>
                            </div>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                </svg>
                                <span class="ml-4 text-sm font-medium text-gray-500">Activity Log #{{ activityLog.id }}</span>
                            </div>
                        </li>
                    </ol>
                </nav>
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    Activity Log Details
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    {{ activityLog.activityDescription }}
                </p>
            </div>
            <div class="mt-4 flex md:mt-0 md:ml-4 space-x-3">
                <a href="{{ path('admin_activity_logs_list') }}" 
                   class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Back to List
                </a>
                {% if activityLog.user %}
                    <a href="{{ path('admin_activity_logs_list', {user_id: activityLog.user.id}) }}" 
                       class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        View User Activities
                    </a>
                {% endif %}
            </div>
        </div>

        <!-- Activity Type Badge -->
        <div class="mb-6">
            {% if activityLog.isSecurityActivity %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                    <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                    </svg>
                    Security Activity
                </span>
            {% elseif activityLog.isBusinessActivity %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                    <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2h8z"/>
                    </svg>
                    Business Activity
                </span>
            {% else %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                    <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    System Activity
                </span>
            {% endif %}
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <!-- Basic Information Card -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Basic Information</h3>
                    <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Activity ID</dt>
                            <dd class="mt-1 text-sm text-gray-900">#{{ activityLog.id }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Date & Time</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ activityLog.createdAt|date('M d, Y \\a\\t g:i A') }}</dd>
                        </div>
                        <div class="sm:col-span-2">
                            <dt class="text-sm font-medium text-gray-500">Activity Type</dt>
                            <dd class="mt-1">
                                <code class="px-2 py-1 text-xs font-mono bg-gray-100 rounded">{{ activityLog.activityType }}</code>
                            </dd>
                        </div>
                        <div class="sm:col-span-2">
                            <dt class="text-sm font-medium text-gray-500">Description</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ activityLog.activityDescription }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- User Information Card -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">User Information</h3>
                    <dl class="grid grid-cols-1 gap-x-4 gap-y-6">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">User Email</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ activityLog.user.email }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">User Role</dt>
                            <dd class="mt-1">
                                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                                    {{ activityLog.user.role.value|replace({'_': ' '})|title }}
                                </span>
                            </dd>
                        </div>
                        {% if currentUser.role.value == 'SYSTEM_ADMIN' or activityLog.shippingLine %}
                            <div>
                                <dt class="text-sm font-medium text-gray-500">Shipping Line</dt>
                                <dd class="mt-1 text-sm text-gray-900">
                                    {% if activityLog.shippingLine %}
                                        {{ activityLog.shippingLine.brandName }}
                                    {% else %}
                                        <span class="text-gray-400 italic">System Wide</span>
                                    {% endif %}
                                </dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </div>

            <!-- Entity Information Card -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Entity Information</h3>
                    <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Entity Type</dt>
                            <dd class="mt-1 text-sm text-gray-900">
                                {% if activityLog.entityType %}
                                    {{ activityLog.entityType|replace({'_': ' '})|title }}
                                {% else %}
                                    <span class="text-gray-400">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Entity ID</dt>
                            <dd class="mt-1 text-sm text-gray-900">
                                {% if activityLog.entityId %}
                                    #{{ activityLog.entityId }}
                                {% else %}
                                    <span class="text-gray-400">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Technical Information Card -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Technical Information</h3>
                    <dl class="grid grid-cols-1 gap-x-4 gap-y-6">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">IP Address</dt>
                            <dd class="mt-1">
                                <code class="px-2 py-1 text-xs font-mono bg-gray-100 rounded">{{ activityLog.ipAddress }}</code>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Session ID</dt>
                            <dd class="mt-1">
                                {% if activityLog.sessionId %}
                                    <code class="px-2 py-1 text-xs font-mono bg-gray-100 rounded break-all">{{ activityLog.sessionId }}</code>
                                {% else %}
                                    <span class="text-gray-400">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">User Agent</dt>
                            <dd class="mt-1 text-xs text-gray-600 break-all">
                                {% if activityLog.userAgent %}
                                    {{ activityLog.userAgent }}
                                {% else %}
                                    <span class="text-gray-400">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Data Changes Section -->
        {% if activityLog.oldValues or activityLog.newValues %}
            <div class="mt-6 bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Data Changes</h3>
                    
                    {% if activityLog.oldValues %}
                        <div class="mb-6">
                            <h4 class="text-md font-medium text-gray-900 mb-2">Previous Values</h4>
                            <div class="bg-red-50 border border-red-200 rounded-md p-4">
                                <pre class="text-sm text-red-800 whitespace-pre-wrap"><code>{{ activityLog.oldValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                            </div>
                        </div>
                    {% endif %}
                    
                    {% if activityLog.newValues %}
                        <div class="mb-6">
                            <h4 class="text-md font-medium text-gray-900 mb-2">New Values</h4>
                            <div class="bg-green-50 border border-green-200 rounded-md p-4">
                                <pre class="text-sm text-green-800 whitespace-pre-wrap"><code>{{ activityLog.newValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <!-- Additional Context Section -->
        {% if activityLog.additionalContext %}
            <div class="mt-6 bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Additional Context</h3>
                    <div class="bg-gray-50 border border-gray-200 rounded-md p-4">
                        <pre class="text-sm text-gray-800 whitespace-pre-wrap"><code>{{ activityLog.additionalContext|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Security Alert -->
        {% if activityLog.isSecurityActivity %}
            <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-md p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-yellow-800">Security Activity Alert</h3>
                        <div class="mt-2 text-sm text-yellow-700">
                            <p>This activity log represents a security-related event. Please review carefully and take appropriate action if necessary.</p>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Quick Actions -->
        {% if activityLog.entityType and activityLog.entityId %}
            <div class="mt-6 bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Related Actions</h3>
                    <div class="flex flex-wrap gap-3">
                        <a href="{{ path('admin_activity_logs_list', {entity_type: activityLog.entityType, entity_id: activityLog.entityId}) }}" 
                           class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            View {{ activityLog.entityType|replace({'_': ' '})|title }} Activities
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}