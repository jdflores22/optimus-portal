{% extends 'layout/admin_base.html.twig' %}

{% block title %}Activity Log #{{ activityLog.id }} - OPTIMUS{% endblock %}
{% set isSystemAdmin = currentUser.role.value == 'SYSTEM_ADMIN' %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li><a href="{{ path('admin_activity_logs_list') }}">Activity Logs</a></li>
                                <li>#{{ activityLog.id }}</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
<div class="space-y-5 sm:space-y-6 max-w-6xl mx-auto">

        {# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-start gap-4">
                            <div class="size-12 rounded-xl bg-info/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--activity] size-6 text-info"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Activity Log #{{ activityLog.id }}</h1>
                                <p class="text-sm text-base-content/60 mt-1 break-words">{{ activityLog.activityDescription }}</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 w-full lg:w-auto">
                        <a href="{{ path('admin_activity_logs_list') }}" class="btn btn-ghost btn-sm gap-2">
                            <span class="icon-[tabler--arrow-left] size-4"></span>
                            Back to List
                        </a>
                        {% if activityLog.user %}
                            <a href="{{ path('admin_activity_logs_list', {user_id: activityLog.user.id}) }}" class="btn btn-outline btn-sm gap-2">
                                <span class="icon-[tabler--user] size-4"></span>
                                User Activities
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Activity type badge #}
        <div class="flex flex-wrap items-center gap-3">
            {% if activityLog.isSecurityActivity %}
                <span class="badge badge-error badge-lg badge-soft gap-1.5">
                    <span class="icon-[tabler--shield-lock] size-4"></span>
                    Security Activity
                </span>
            {% elseif activityLog.isBusinessActivity %}
                <span class="badge badge-success badge-lg badge-soft gap-1.5">
                    <span class="icon-[tabler--briefcase] size-4"></span>
                    Business Activity
                </span>
            {% else %}
                <span class="badge badge-info badge-lg badge-soft gap-1.5">
                    <span class="icon-[tabler--device-desktop] size-4"></span>
                    System Activity
                </span>
            {% endif %}
            <span class="text-sm text-base-content/60 inline-flex items-center gap-1.5">
                <span class="icon-[tabler--calendar] size-4"></span>
                {{ activityLog.createdAt|date('M j, Y g:i A') }}
            </span>
        </div>

        {# Security alert #}
        {% if activityLog.isSecurityActivity %}
            <div class="alert alert-warning">
                <span class="icon-[tabler--alert-triangle] size-5 shrink-0"></span>
                <div>
                    <h3 class="font-semibold">Security Activity Alert</h3>
                    <p class="text-sm opacity-90">This activity log represents a security-related event. Review carefully and take appropriate action if necessary.</p>
                </div>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">

            {# Basic information #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--info-circle] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Basic Information</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Activity ID</dt>
                            <dd class="mt-1 text-sm font-medium text-base-content">#{{ activityLog.id }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Date & Time</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ activityLog.createdAt|date('M j, Y g:i A') }}</dd>
                        </div>
                        <div class="sm:col-span-2">
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Activity Type</dt>
                            <dd class="mt-1">
                                <code class="text-xs font-mono bg-base-200 px-2 py-1 rounded-lg break-all">{{ activityLog.activityType }}</code>
                            </dd>
                        </div>
                        <div class="sm:col-span-2">
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Description</dt>
                            <dd class="mt-1 text-sm text-base-content break-words">{{ activityLog.activityDescription }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# User information #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--user] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">User Information</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <dl class="space-y-4">
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">User Email</dt>
                            <dd class="mt-1 text-sm text-base-content break-all">{{ activityLog.user.email }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">User Role</dt>
                            <dd class="mt-1">
                                <span class="badge badge-ghost badge-soft badge-sm">{{ activityLog.user.role.value|replace({'_': ' '})|title }}</span>
                            </dd>
                        </div>
                        {% if isSystemAdmin or activityLog.shippingLine %}
                            <div>
                                <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Shipping Line</dt>
                                <dd class="mt-1 text-sm text-base-content">
                                    {% if activityLog.shippingLine %}
                                        {{ activityLog.shippingLine.brandName }}
                                    {% else %}
                                        <span class="text-base-content/40 italic">System Wide</span>
                                    {% endif %}
                                </dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </div>

            {# Entity information #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--box] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Entity Information</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Entity Type</dt>
                            <dd class="mt-1 text-sm text-base-content">
                                {% if activityLog.entityType %}
                                    {{ activityLog.entityType|replace({'_': ' '})|title }}
                                {% else %}
                                    <span class="text-base-content/40">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Entity ID</dt>
                            <dd class="mt-1 text-sm text-base-content">
                                {% if activityLog.entityId %}
                                    #{{ activityLog.entityId }}
                                {% else %}
                                    <span class="text-base-content/40">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Technical information #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--server] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Technical Information</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <dl class="space-y-4">
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">IP Address</dt>
                            <dd class="mt-1">
                                <code class="text-xs font-mono bg-base-200 px-2 py-1 rounded-lg">{{ activityLog.ipAddress }}</code>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">Session ID</dt>
                            <dd class="mt-1">
                                {% if activityLog.sessionId %}
                                    <code class="text-xs font-mono bg-base-200 px-2 py-1 rounded-lg break-all block">{{ activityLog.sessionId }}</code>
                                {% else %}
                                    <span class="text-base-content/40">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-base-content/60 uppercase tracking-wide">User Agent</dt>
                            <dd class="mt-1 text-xs text-base-content/70 break-all leading-relaxed">
                                {% if activityLog.userAgent %}
                                    {{ activityLog.userAgent }}
                                {% else %}
                                    <span class="text-base-content/40">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>

        {# Data changes #}
        {% if activityLog.oldValues or activityLog.newValues %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--git-compare] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Data Changes</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-5">
                    {% if activityLog.oldValues %}
                        <div>
                            <h3 class="text-sm font-semibold text-base-content mb-2 inline-flex items-center gap-1.5">
                                <span class="icon-[tabler--arrow-back] size-4 text-error"></span>
                                Previous Values
                            </h3>
                            <div class="bg-error/10 border border-error/20 rounded-xl p-4 overflow-x-auto">
                                <pre class="text-xs font-mono text-error break-all whitespace-pre-wrap"><code>{{ activityLog.oldValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                            </div>
                        </div>
                    {% endif %}
                    {% if activityLog.newValues %}
                        <div>
                            <h3 class="text-sm font-semibold text-base-content mb-2 inline-flex items-center gap-1.5">
                                <span class="icon-[tabler--arrow-forward] size-4 text-success"></span>
                                New Values
                            </h3>
                            <div class="bg-success/10 border border-success/20 rounded-xl p-4 overflow-x-auto">
                                <pre class="text-xs font-mono text-success break-all whitespace-pre-wrap"><code>{{ activityLog.newValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {# Additional context #}
        {% if activityLog.additionalContext %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--code] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Additional Context</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <div class="bg-base-200 border border-base-300 rounded-xl p-4 overflow-x-auto">
                        <pre class="text-xs font-mono text-base-content break-all whitespace-pre-wrap"><code>{{ activityLog.additionalContext|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Related actions #}
        {% if activityLog.entityType and activityLog.entityId %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--link] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Related Actions</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <a href="{{ path('admin_activity_logs_list', {entity_type: activityLog.entityType, entity_id: activityLog.entityId}) }}"
                       class="btn btn-outline btn-sm gap-2">
                        <span class="icon-[tabler--list-details] size-4"></span>
                        View {{ activityLog.entityType|replace({'_': ' '})|title }} Activities
                    </a>
                </div>
            </div>
        {% endif %}
{% endblock %}
