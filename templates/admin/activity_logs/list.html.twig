{% extends 'layout/admin_base.html.twig' %}

{% block title %}Activity Logs - OPTIMUS{% endblock %}
{% set isSystemAdmin = currentUser.role.value == 'SYSTEM_ADMIN' %}
{% set hasActiveFilters = filters.from_date|default('') or filters.to_date|default('') or filters.activity_type|default('') or filters.entity_type|default('') or filters.user_id|default('') or filters.search|default('') %}
{% set businessCount = activityLogs|filter(log => log.isBusinessActivity)|length %}
{% set securityCount = activityLogs|filter(log => log.isSecurityActivity)|length %}
{% set todayCount = activityLogs|filter(log => log.createdAt|date('Y-m-d') == 'now'|date('Y-m-d'))|length %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li>Activity Logs</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-info/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--activity] size-6 text-info"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">
                                    Activity Logs
                                    {% if targetUser %}
                                        <span class="text-base-content/60 font-semibold text-lg sm:text-xl">
                                            — {% if targetUser.fullName is defined %}{{ targetUser.fullName }}{% elseif targetUser.firstName is defined %}{{ targetUser.firstName }} {{ targetUser.lastName }}{% else %}{{ targetUser.email }}{% endif %}
                                        </span>
                                    {% elseif shippingLineScope %}
                                        <span class="text-base-content/60 font-semibold text-lg sm:text-xl">— {{ shippingLineScope.brandName }}</span>
                                    {% elseif isSystemAdmin %}
                                        <span class="text-base-content/60 font-semibold text-lg sm:text-xl">— System Wide</span>
                                    {% endif %}
                                </h1>
                                <p class="text-sm text-base-content/60 mt-1">
                                    {% if targetUser %}
                                        Viewing activity logs for {% if targetUser.fullName is defined %}{{ targetUser.fullName }}{% elseif targetUser.firstName is defined %}{{ targetUser.firstName }} {{ targetUser.lastName }}{% else %}{{ targetUser.email }}{% endif %}
                                    {% else %}
                                        View and search system activity logs with filtering and export capabilities
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 w-full lg:w-auto">
                        {% if targetUser %}
                            <a href="{{ path('admin_user_hierarchy_detail', {id: targetUser.id}) }}" class="btn btn-ghost btn-sm gap-2">
                                <span class="icon-[tabler--arrow-left] size-4"></span>
                                Back to User
                            </a>
                        {% endif %}
                        <a href="{{ path('admin_activity_logs_reports') }}" class="btn btn-outline btn-sm gap-2">
                            <span class="icon-[tabler--chart-bar] size-4"></span>
                            Reports
                        </a>
                        <a href="{{ path('admin_activity_logs_export', {format: 'csv'}) }}" class="btn btn-primary btn-sm gap-2">
                            <span class="icon-[tabler--download] size-4"></span>
                            Export CSV
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Stats #}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--list-details] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Total Activities</p>
                            <p class="text-2xl font-bold text-base-content">{{ pagination.total|number_format }}</p>
                            <p class="text-xs text-primary/80">All matching filters</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-success/10 text-success rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--briefcase] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Business</p>
                            <p class="text-2xl font-bold text-base-content">{{ businessCount }}</p>
                            <p class="text-xs text-success/80">On this page</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-error/10 text-error rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--shield-lock] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Security</p>
                            <p class="text-2xl font-bold text-base-content">{{ securityCount }}</p>
                            <p class="text-xs text-error/80">On this page</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-accent/10 text-accent rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--clock] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Today</p>
                            <p class="text-2xl font-bold text-base-content">{{ todayCount }}</p>
                            <p class="text-xs text-accent/80">On this page</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Filters & Search #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-5">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--filter] size-5 text-base-content/70"></span>
                        <h3 class="font-semibold text-base text-base-content">Filters & Search</h3>
                        {% if hasActiveFilters %}
                            <span class="badge badge-primary badge-sm">Active</span>
                        {% endif %}
                    </div>
                    <button type="button" id="activityLogFilterToggle" class="btn btn-ghost btn-sm gap-1">
                        <span id="activityLogFilterToggleText">{{ hasActiveFilters ? 'Hide Filters' : 'Show Filters' }}</span>
                        <span id="activityLogFilterToggleIcon" class="icon-[tabler--chevron-down] size-4 transition-transform {{ hasActiveFilters ? 'rotate-180' : '' }}"></span>
                    </button>
                </div>

                <div id="activityLogFilterPanel" class="{{ hasActiveFilters ? '' : 'hidden' }} space-y-4">
                    <form method="GET" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            <div class="form-control">
                                <label class="label py-1" for="from_date"><span class="label-text font-medium">From Date</span></label>
                                <input type="date" name="from_date" id="from_date" value="{{ filters.from_date }}" class="input input-bordered w-full">
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="to_date"><span class="label-text font-medium">To Date</span></label>
                                <input type="date" name="to_date" id="to_date" value="{{ filters.to_date }}" class="input input-bordered w-full">
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="activity_type"><span class="label-text font-medium">Activity Type</span></label>
                                <select name="activity_type" id="activity_type" class="select select-bordered w-full">
                                    <option value="">All Types</option>
                                    {% for type in activityTypes %}
                                        <option value="{{ type }}" {% if filters.activity_type == type %}selected{% endif %}>{{ type|replace({'_': ' '})|title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="entity_type"><span class="label-text font-medium">Entity Type</span></label>
                                <select name="entity_type" id="entity_type" class="select select-bordered w-full">
                                    <option value="">All Entities</option>
                                    {% for type in entityTypes %}
                                        <option value="{{ type }}" {% if filters.entity_type == type %}selected{% endif %}>{{ type|replace({'_': ' '})|title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="user_id"><span class="label-text font-medium">User</span></label>
                                <select name="user_id" id="user_id" class="select select-bordered w-full">
                                    <option value="">All Users</option>
                                    {% for user in availableUsers %}
                                        <option value="{{ user.id }}" {% if filters.user_id == user.id %}selected{% endif %}>{{ user.fullName }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="search"><span class="label-text font-medium">Search</span></label>
                                <label class="input input-bordered flex items-center gap-2 w-full">
                                    <span class="icon-[tabler--search] size-4 text-base-content/50"></span>
                                    <input type="text" name="search" id="search" value="{{ filters.search }}" placeholder="Descriptions, users, entities…" class="grow min-w-0">
                                </label>
                            </div>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-4 border-t border-base-300">
                            <div class="flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-primary btn-sm gap-2">
                                    <span class="icon-[tabler--search] size-4"></span>
                                    Apply Filters
                                </button>
                                <a href="{{ path('admin_activity_logs_list') }}" class="btn btn-ghost btn-sm gap-2">
                                    <span class="icon-[tabler--refresh] size-4"></span>
                                    Clear All
                                </a>
                            </div>
                            <span class="text-sm text-base-content/50">{{ pagination.total|number_format }} total results</span>
                        </div>
                    </form>
                </div>

                <div id="activityLogSearchNotice" class="hidden alert alert-info alert-soft mt-4 py-2">
                    <span class="icon-[tabler--info-circle] size-5"></span>
                    <span id="activityLogSearchNoticeText"></span>
                </div>
            </div>
        </div>

        {# Results #}
        <div class="card bg-base-100 shadow-sm overflow-hidden">
            <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 pt-4 sm:pt-5">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="icon-[tabler--timeline] size-5 text-base-content/70"></span>
                    <h3 class="card-title text-base sm:text-lg">Activity Log Entries</h3>
                    <span class="badge badge-primary badge-soft">{{ activityLogs|length }} on page</span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <div class="flex items-center gap-2">
                        <label for="activityLogLimit" class="text-sm text-base-content/70">Show</label>
                        <select id="activityLogLimit" class="select select-bordered select-sm">
                            {% for limitOption in [10, 20, 50, 100] %}
                                <option value="{{ limitOption }}" {{ pagination.limit == limitOption ? 'selected' : '' }}>{{ limitOption }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="button" id="activityLogLiveSearchBtn" class="btn btn-outline btn-sm gap-1">
                        <span class="icon-[tabler--search] size-4"></span>
                        Live Search
                    </button>
                </div>
            </div>

            {% if activityLogs is empty %}
                <div class="flex flex-col items-center justify-center py-16 text-center px-4">
                    <span class="icon-[tabler--file-off] size-12 text-base-content/30"></span>
                    <h3 class="mt-4 text-base font-medium text-base-content">No activity logs found</h3>
                    <p class="mt-2 text-sm text-base-content/60 max-w-md">No activity logs match the current filter criteria. Try adjusting your search parameters.</p>
                    <a href="{{ path('admin_activity_logs_list') }}" class="btn btn-primary btn-sm gap-2 mt-6">
                        <span class="icon-[tabler--refresh] size-4"></span>
                        Clear Filters
                    </a>
                </div>
            {% else %}
                {# Desktop table #}
                <div class="hidden xl:block overflow-x-auto">
                    <table class="table table-sm table-fixed">
                        <thead>
                            <tr>
                                <th class="w-[8.5rem]">Date/Time</th>
                                <th class="w-[14rem]">Activity</th>
                                <th class="w-[11rem]">User</th>
                                {% if isSystemAdmin %}
                                    <th class="w-[9rem]">Shipping Line</th>
                                {% endif %}
                                <th class="w-[10rem]">Entity</th>
                                <th class="w-[5.5rem]">IP</th>
                                <th class="w-[6.5rem]">Type</th>
                                <th class="w-[5rem]"></th>
                            </tr>
                        </thead>
                        <tbody id="activityLogsTable">
                            {% for log in activityLogs %}
                                <tr class="hover align-top">
                                    <td class="whitespace-nowrap text-sm align-top">
                                        <div>{{ log.createdAt|date('M j, Y') }}</div>
                                        <div class="text-xs text-base-content/50">{{ log.createdAt|date('H:i:s') }}</div>
                                    </td>
                                    <td class="align-top overflow-hidden">
                                        <div class="text-sm font-medium break-words">{{ log.activityDescription }}</div>
                                        <div class="text-xs text-base-content/50 mt-0.5">{{ log.activityType|replace({'_': ' '})|title }}</div>
                                    </td>
                                    <td class="align-top overflow-hidden">
                                        <div class="text-sm font-medium truncate" title="{{ log.user.email }}">{{ log.user.email }}</div>
                                        <span class="badge badge-ghost badge-soft badge-xs mt-1">{{ log.user.role.value|replace({'_': ' '})|title }}</span>
                                    </td>
                                    {% if isSystemAdmin %}
                                        <td class="align-top overflow-hidden text-sm">
                                            {% if log.shippingLine %}
                                                <span class="truncate block" title="{{ log.shippingLine.brandName }}">{{ log.shippingLine.brandName }}</span>
                                            {% else %}
                                                <span class="text-base-content/40 italic">System</span>
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                    <td class="align-top overflow-hidden text-sm">
                                        {% if log.entityType %}
                                            <div class="truncate" title="{{ log.entityType }}">{{ log.entityType|replace({'_': ' '})|title }}</div>
                                            {% if log.entityId %}
                                                <div class="text-xs text-base-content/50">#{{ log.entityId }}</div>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-base-content/40">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-xs font-mono text-base-content/60 whitespace-nowrap align-top">{{ log.ipAddress }}</td>
                                    <td class="align-top">
                                        {% if log.isSecurityActivity %}
                                            <span class="badge badge-error badge-soft badge-sm whitespace-normal">Security</span>
                                        {% elseif log.isBusinessActivity %}
                                            <span class="badge badge-success badge-soft badge-sm whitespace-normal">Business</span>
                                        {% else %}
                                            <span class="badge badge-info badge-soft badge-sm whitespace-normal">System</span>
                                        {% endif %}
                                    </td>
                                    <td class="align-top text-right">
                                        <a href="{{ path('admin_activity_logs_detail', {id: log.id}) }}" class="btn btn-ghost btn-xs gap-1">
                                            <span class="icon-[tabler--eye] size-3.5"></span>
                                            View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Mobile / tablet cards #}
                <div class="xl:hidden p-4 space-y-3" id="activityLogsCards">
                    {% for log in activityLogs %}
                        <div class="card bg-base-200 border border-base-300">
                            <div class="card-body p-4 space-y-3">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <p class="text-sm font-medium text-base-content break-words">{{ log.activityDescription }}</p>
                                        <p class="text-xs text-base-content/50 mt-1">{{ log.createdAt|date('M j, Y H:i:s') }}</p>
                                    </div>
                                    {% if log.isSecurityActivity %}
                                        <span class="badge badge-error badge-soft badge-sm shrink-0">Security</span>
                                    {% elseif log.isBusinessActivity %}
                                        <span class="badge badge-success badge-soft badge-sm shrink-0">Business</span>
                                    {% else %}
                                        <span class="badge badge-info badge-soft badge-sm shrink-0">System</span>
                                    {% endif %}
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
                                    <div>
                                        <span class="text-base-content/60">User:</span>
                                        <span class="font-medium">{{ log.user.email }}</span>
                                    </div>
                                    {% if isSystemAdmin %}
                                        <div>
                                            <span class="text-base-content/60">Line:</span>
                                            <span class="font-medium">{{ log.shippingLine ? log.shippingLine.brandName : 'System' }}</span>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <span class="text-base-content/60">Entity:</span>
                                        {% if log.entityType %}
                                            <span class="font-medium">{{ log.entityType|replace({'_': ' '})|title }}{% if log.entityId %} #{{ log.entityId }}{% endif %}</span>
                                        {% else %}
                                            <span class="text-base-content/40">—</span>
                                        {% endif %}
                                    </div>
                                    <div>
                                        <span class="text-base-content/60">IP:</span>
                                        <span class="font-mono text-xs">{{ log.ipAddress }}</span>
                                    </div>
                                </div>
                                <div class="flex justify-end">
                                    <a href="{{ path('admin_activity_logs_detail', {id: log.id}) }}" class="btn btn-primary btn-sm btn-soft gap-1">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Pagination #}
                {% if pagination.pages > 1 %}
                    <div class="px-4 sm:px-6 py-4 border-t border-base-300">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <p class="text-sm text-base-content/60">
                                Showing
                                <span class="font-medium text-base-content">{{ ((pagination.page - 1) * pagination.limit) + 1 }}</span>
                                to
                                <span class="font-medium text-base-content">{{ min(pagination.page * pagination.limit, pagination.total) }}</span>
                                of
                                <span class="font-medium text-base-content">{{ pagination.total|number_format }}</span>
                                results
                            </p>
                            <div class="join">
                                {% if pagination.page > 1 %}
                                    <a href="{{ path('admin_activity_logs_list', filters|merge({page: pagination.page - 1})) }}" class="join-item btn btn-sm btn-outline">
                                        <span class="icon-[tabler--chevron-left] size-4"></span>
                                    </a>
                                {% else %}
                                    <span class="join-item btn btn-sm btn-outline btn-disabled">
                                        <span class="icon-[tabler--chevron-left] size-4"></span>
                                    </span>
                                {% endif %}

                                {% for page in 1..pagination.pages %}
                                    {% if page == pagination.page %}
                                        <span class="join-item btn btn-sm btn-primary">{{ page }}</span>
                                    {% elseif page <= 3 or page >= pagination.pages - 2 or (page >= pagination.page - 1 and page <= pagination.page + 1) %}
                                        <a href="{{ path('admin_activity_logs_list', filters|merge({page: page})) }}" class="join-item btn btn-sm btn-outline">{{ page }}</a>
                                    {% elseif page == 4 or page == pagination.pages - 3 %}
                                        <span class="join-item btn btn-sm btn-disabled">…</span>
                                    {% endif %}
                                {% endfor %}

                                {% if pagination.page < pagination.pages %}
                                    <a href="{{ path('admin_activity_logs_list', filters|merge({page: pagination.page + 1})) }}" class="join-item btn btn-sm btn-outline">
                                        <span class="icon-[tabler--chevron-right] size-4"></span>
                                    </a>
                                {% else %}
                                    <span class="join-item btn btn-sm btn-outline btn-disabled">
                                        <span class="icon-[tabler--chevron-right] size-4"></span>
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
        </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    const isSystemAdmin = {{ isSystemAdmin ? 'true' : 'false' }};
    const detailUrlBase = '{{ path('admin_activity_logs_detail', {id: 0}) }}'.replace(/0$/, '');
    const searchUrl = '{{ path('admin_activity_logs_search') }}';
    const colspan = isSystemAdmin ? 8 : 7;

    function toggleFilters() {
        const panel = document.getElementById('activityLogFilterPanel');
        const toggleText = document.getElementById('activityLogFilterToggleText');
        const toggleIcon = document.getElementById('activityLogFilterToggleIcon');
        const isHidden = panel.classList.contains('hidden');
        panel.classList.toggle('hidden');
        toggleText.textContent = isHidden ? 'Hide Filters' : 'Show Filters';
        toggleIcon.classList.toggle('rotate-180', isHidden);
    }

    document.getElementById('activityLogFilterToggle')?.addEventListener('click', toggleFilters);

    document.getElementById('activityLogLimit')?.addEventListener('change', function () {
        const url = new URL(window.location);
        url.searchParams.set('limit', this.value);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    });

    function typeBadge(log) {
        if (log.is_security_activity) {
            return '<span class="badge badge-error badge-soft badge-sm whitespace-normal">Security</span>';
        }
        if (log.is_business_activity) {
            return '<span class="badge badge-success badge-soft badge-sm whitespace-normal">Business</span>';
        }
        return '<span class="badge badge-info badge-soft badge-sm whitespace-normal">System</span>';
    }

    function formatActivityType(type) {
        return type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
    }

    function formatEntity(log) {
        if (!log.entity_type) {
            return '<span class="text-base-content/40">—</span>';
        }
        const label = formatActivityType(log.entity_type);
        const id = log.entity_id ? `<div class="text-xs text-base-content/50">#${log.entity_id}</div>` : '';
        return `<div class="truncate" title="${label}">${label}</div>${id}`;
    }

    function updateTable(logs) {
        const tbody = document.getElementById('activityLogsTable');
        if (!tbody) return;

        tbody.innerHTML = '';

        if (logs.length === 0) {
            tbody.innerHTML = `<tr><td colspan="${colspan}" class="text-center py-8 text-base-content/50">No results found</td></tr>`;
            return;
        }

        logs.forEach(log => {
            const created = new Date(log.created_at);
            const dateStr = created.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
            const timeStr = created.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' });

            let shippingLineCell = '';
            if (isSystemAdmin) {
                const line = log.shipping_line
                    ? `<span class="truncate block" title="${log.shipping_line.brand_name}">${log.shipping_line.brand_name}</span>`
                    : '<span class="text-base-content/40 italic">System</span>';
                shippingLineCell = `<td class="align-top overflow-hidden text-sm">${line}</td>`;
            }

            const row = document.createElement('tr');
            row.className = 'hover align-top';
            row.innerHTML = `
                <td class="whitespace-nowrap text-sm align-top">
                    <div>${dateStr}</div>
                    <div class="text-xs text-base-content/50">${timeStr}</div>
                </td>
                <td class="align-top overflow-hidden">
                    <div class="text-sm font-medium break-words">${log.activity_description}</div>
                    <div class="text-xs text-base-content/50 mt-0.5">${formatActivityType(log.activity_type)}</div>
                </td>
                <td class="align-top overflow-hidden">
                    <div class="text-sm font-medium truncate" title="${log.user.email}">${log.user.email}</div>
                    <span class="badge badge-ghost badge-soft badge-xs mt-1">${formatActivityType(log.user.role)}</span>
                </td>
                ${shippingLineCell}
                <td class="align-top overflow-hidden text-sm">${formatEntity(log)}</td>
                <td class="text-xs font-mono text-base-content/60 whitespace-nowrap align-top">${log.ip_address || '—'}</td>
                <td class="align-top">${typeBadge(log)}</td>
                <td class="align-top text-right">
                    <a href="${detailUrlBase}${log.id}" class="btn btn-ghost btn-xs gap-1">
                        <span class="icon-[tabler--eye] size-3.5"></span>
                        View
                    </a>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    function showSearchNotice(term, totalFound) {
        const notice = document.getElementById('activityLogSearchNotice');
        const noticeText = document.getElementById('activityLogSearchNoticeText');
        if (!notice || !noticeText) return;
        noticeText.textContent = `Live search for "${term}" found ${totalFound} result${totalFound === 1 ? '' : 's'}.`;
        notice.classList.remove('hidden');
    }

    function performSearch() {
        const searchInput = document.getElementById('search');
        const term = searchInput?.value.trim() ?? '';
        if (term.length < 2) {
            alert('Search term must be at least 2 characters.');
            return;
        }

        const formData = new FormData();
        formData.append('search_term', term);

        const activityType = document.getElementById('activity_type')?.value;
        const entityType = document.getElementById('entity_type')?.value;
        const userId = document.getElementById('user_id')?.value;

        if (activityType) formData.append('activity_type', activityType);
        if (entityType) formData.append('entity_type', entityType);
        if (userId) formData.append('user_id', userId);

        fetch(searchUrl, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateTable(data.data.results);
                    showSearchNotice(data.data.searchTerm, data.data.totalFound);
                } else {
                    alert('Search failed: ' + (data.error || 'Unknown error'));
                }
            })
            .catch(() => alert('Search failed'));
    }

    document.getElementById('activityLogLiveSearchBtn')?.addEventListener('click', performSearch);
    document.getElementById('search')?.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            performSearch();
        }
    });
})();
</script>
{% endblock %}
