{% extends 'layout/admin_base.html.twig' %}

{% block title %}Pending Invitations - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('admin_user_hierarchy_list') }}">User Hierarchy</a></li>
                                <li>Pending Invitations</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--inbox] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Pending Invitations</h1>
                                <p class="text-sm text-base-content/60 mt-1">Manage pending role invitations and track invitation status</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <a href="{{ path('admin_user_hierarchy_list') }}" class="btn btn-ghost btn-sm gap-2">
                            <span class="icon-[tabler--users] size-4"></span>
                            User Management
                        </a>
                        <a href="{{ path('admin_user_hierarchy_create') }}" class="btn btn-primary btn-sm gap-2">
                            <span class="icon-[tabler--plus] size-4"></span>
                            Create User
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# Filters #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-4">
                    <span class="icon-[tabler--filter] size-5 text-base-content/70"></span>
                    <h3 class="font-semibold text-base text-base-content">Filters</h3>
                </div>
                <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div class="form-control">
                        <label class="label py-1" for="status">
                            <span class="label-text font-medium">Status</span>
                        </label>
                        <select id="status" name="status" class="select select-bordered w-full">
                            <option value="">All Statuses</option>
                            <option value="pending" {% if filters.status == 'pending' %}selected{% endif %}>Pending</option>
                            <option value="expired" {% if filters.status == 'expired' %}selected{% endif %}>Expired</option>
                            <option value="accepted" {% if filters.status == 'accepted' %}selected{% endif %}>Accepted</option>
                            <option value="declined" {% if filters.status == 'declined' %}selected{% endif %}>Declined</option>
                            <option value="temporarily_disabled" {% if filters.status == 'temporarily_disabled' %}selected{% endif %}>Temporarily Disabled</option>
                        </select>
                    </div>
                    <div class="form-control">
                        <label class="label py-1" for="search">
                            <span class="label-text font-medium">Search</span>
                        </label>
                        <label class="input input-bordered flex items-center gap-2">
                            <span class="icon-[tabler--search] size-4 text-base-content/50"></span>
                            <input type="text"
                                   id="search"
                                   name="search"
                                   value="{{ filters.search }}"
                                   class="grow"
                                   placeholder="Email, name...">
                        </label>
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-1 gap-2">
                            <span class="icon-[tabler--search] size-4"></span>
                            Filter
                        </button>
                        <a href="{{ path('admin_user_hierarchy_pending_invitations') }}" class="btn btn-ghost btn-sm">Clear</a>
                    </div>
                </form>
            </div>
        </div>

        {# Invitations table #}
        <div class="card bg-base-100 shadow-sm">
            {% if pendingUsers is empty %}
                <div class="card-body flex flex-col items-center justify-center py-16 text-center">
                    <span class="icon-[tabler--inbox] size-12 text-base-content/30"></span>
                    <h3 class="mt-4 text-base font-medium text-base-content">No pending invitations</h3>
                    <p class="mt-2 text-sm text-base-content/60">No pending invitations found matching your criteria.</p>
                    <a href="{{ path('admin_user_hierarchy_create') }}" class="btn btn-primary btn-sm gap-2 mt-6">
                        <span class="icon-[tabler--plus] size-4"></span>
                        Create User
                    </a>
                </div>
            {% else %}
                <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                    <div>
                        <h3 class="card-title text-base sm:text-lg">Invitations</h3>
                        <p class="text-sm text-base-content/60 mt-1">{{ pagination.total }} total invitations</p>
                    </div>
                    <span class="badge badge-ghost">{{ pendingUsers|length }} shown</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Invited User</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Expires</th>
                                <th>Created By</th>
                                <th>Shipping Line</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for pendingUser in pendingUsers %}
                                <tr class="hover">
                                    <td>
                                        <div class="flex items-center gap-3">
                                            <div class="size-10 rounded-full {{ avatar_colors(pendingUser) }} flex items-center justify-center shrink-0">
                                                <span class="text-sm font-semibold">
                                                    {{ (pendingUser.firstName ~ ' ' ~ pendingUser.lastName)|slice(0, 2)|upper }}
                                                </span>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="font-medium text-base-content truncate">{{ pendingUser.fullName }}</div>
                                                <div class="text-sm text-base-content/50 truncate">{{ pendingUser.email }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% if pendingUser.role.value == 'SHIPPING_LINES_ADMIN' %}
                                            <span class="badge badge-secondary badge-sm">{{ pendingUser.role.value|replace({'_': ' '})|title }}</span>
                                        {% elseif pendingUser.role.value == 'SL_STAFF' %}
                                            <span class="badge badge-primary badge-sm">{{ pendingUser.role.value|replace({'_': ' '})|title }}</span>
                                        {% elseif pendingUser.role.value == 'EVALUATOR' %}
                                            <span class="badge badge-info badge-sm">{{ pendingUser.role.value|replace({'_': ' '})|title }}</span>
                                        {% elseif pendingUser.role.value == 'ACCOUNTING' %}
                                            <span class="badge badge-warning badge-sm">{{ pendingUser.role.value|replace({'_': ' '})|title }}</span>
                                        {% elseif pendingUser.role.value == 'TERMINAL_TEAM' %}
                                            <span class="badge badge-accent badge-sm">{{ pendingUser.role.value|replace({'_': ' '})|title }}</span>
                                        {% else %}
                                            <span class="badge badge-ghost badge-sm">{{ pendingUser.role.value|replace({'_': ' '})|title }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if pendingUser.status == 'pending' %}
                                            {% if pendingUser.isExpired %}
                                                <span class="badge badge-error badge-sm">Expired</span>
                                            {% else %}
                                                <span class="badge badge-warning badge-sm">Pending</span>
                                            {% endif %}
                                        {% elseif pendingUser.status == 'expired' %}
                                            <span class="badge badge-error badge-sm">Expired</span>
                                        {% elseif pendingUser.status == 'declined' %}
                                            <span class="badge badge-ghost badge-sm">Declined</span>
                                        {% elseif pendingUser.status == 'accepted' %}
                                            <span class="badge badge-success badge-sm">Accepted</span>
                                        {% elseif pendingUser.status == 'temporarily_disabled' %}
                                            <span class="badge badge-neutral badge-sm">Temporarily Disabled</span>
                                        {% else %}
                                            <span class="badge badge-info badge-sm">{{ pendingUser.status|title }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-sm whitespace-nowrap">
                                        <div class="font-medium {% if pendingUser.isExpired %}text-error{% else %}text-base-content{% endif %}">
                                            {{ pendingUser.tokenExpiresAt|date('M d, Y') }}
                                        </div>
                                        <div class="text-xs text-base-content/50">{{ pendingUser.tokenExpiresAt|date('H:i') }}</div>
                                    </td>
                                    <td class="text-sm">
                                        <div class="font-medium text-base-content">{{ pendingUser.createdByAdmin.fullName }}</div>
                                        <div class="text-base-content/50 truncate max-w-[10rem]">{{ pendingUser.createdByAdmin.email }}</div>
                                    </td>
                                    <td class="text-sm">
                                        {% if pendingUser.shippingLine %}
                                            <div class="flex items-center gap-2">
                                                <span class="size-2 rounded-full bg-primary shrink-0"></span>
                                                <span class="font-medium text-primary">{{ pendingUser.shippingLine.brandName }}</span>
                                            </div>
                                        {% else %}
                                            <div class="flex items-center gap-2 text-base-content/40">
                                                <span class="size-2 rounded-full bg-base-content/30 shrink-0"></span>
                                                No shipping line
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            {% if pendingUser.status != 'accepted' %}
                                                <button type="button"
                                                        class="btn btn-xs btn-primary invitation-action-btn"
                                                        data-action="resend"
                                                        data-id="{{ pendingUser.id }}"
                                                        data-email="{{ pendingUser.email|e('html_attr') }}"
                                                        title="Resend invitation">
                                                    <span class="icon-[tabler--refresh] size-3"></span>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-xs btn-error invitation-action-btn"
                                                        data-action="cancel"
                                                        data-id="{{ pendingUser.id }}"
                                                        data-email="{{ pendingUser.email|e('html_attr') }}"
                                                        title="Cancel invitation">
                                                    <span class="icon-[tabler--trash] size-3"></span>
                                                </button>
                                            {% else %}
                                                <span class="text-xs text-base-content/40">—</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        {# Pagination #}
        {% if pagination.pages > 1 %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <p class="text-sm text-base-content/60">
                        Showing
                        <span class="font-medium text-base-content">{{ ((pagination.page - 1) * pagination.limit) + 1 }}</span>–<span class="font-medium text-base-content">{{ pagination.page * pagination.limit > pagination.total ? pagination.total : pagination.page * pagination.limit }}</span>
                        of <span class="font-medium text-base-content">{{ pagination.total }}</span>
                    </p>
                    <div class="flex flex-wrap items-center gap-1">
                        {% if pagination.page > 1 %}
                            <a href="{{ path('admin_user_hierarchy_pending_invitations', filters|merge({page: pagination.page - 1})) }}"
                               class="btn btn-sm btn-ghost gap-1">
                                <span class="icon-[tabler--chevron-left] size-4"></span>
                                Prev
                            </a>
                        {% endif %}
                        {% for page in 1..pagination.pages %}
                            {% if page == pagination.page %}
                                <span class="btn btn-sm btn-primary">{{ page }}</span>
                            {% elseif page <= 2 or page >= pagination.pages - 1 or (page >= pagination.page - 1 and page <= pagination.page + 1) %}
                                <a href="{{ path('admin_user_hierarchy_pending_invitations', filters|merge({page: page})) }}"
                                   class="btn btn-sm btn-ghost">{{ page }}</a>
                            {% elseif page == 3 or page == pagination.pages - 2 %}
                                <span class="btn btn-sm btn-ghost btn-disabled">…</span>
                            {% endif %}
                        {% endfor %}
                        {% if pagination.page < pagination.pages %}
                            <a href="{{ path('admin_user_hierarchy_pending_invitations', filters|merge({page: pagination.page + 1})) }}"
                               class="btn btn-sm btn-ghost gap-1">
                                Next
                                <span class="icon-[tabler--chevron-right] size-4"></span>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
</div>
{% endblock %}

{% block page_modals %}
<div id="invitationToastContainer" class="fixed top-20 right-4 z-[10003] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>

<div id="invitationConfirmModal"
     class="hidden fixed inset-0 z-[10002] items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="invitationModalTitle">
    <div class="absolute inset-0 bg-black/60" data-invitation-modal-dismiss></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6" onclick="event.stopPropagation()">
        <div class="text-center">
            <div id="invitationModalIconWrap" class="size-14 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span id="invitationModalIcon" class="icon-[tabler--alert-triangle] size-7 text-error"></span>
            </div>
            <h3 id="invitationModalTitle" class="text-lg font-bold mb-2">Confirm Action</h3>
            <p id="invitationModalMessage" class="text-sm text-base-content/70 mb-6">Are you sure?</p>
            <div class="flex gap-3">
                <button type="button" data-invitation-modal-dismiss class="btn btn-ghost flex-1">Cancel</button>
                <button type="button" id="invitationConfirmButton" class="btn btn-error flex-1">Confirm</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    let pendingInvitationAction = null;
    let pendingInvitationId = null;

    const modal = document.getElementById('invitationConfirmModal');
    const confirmButton = document.getElementById('invitationConfirmButton');
    const modalTitle = document.getElementById('invitationModalTitle');
    const modalMessage = document.getElementById('invitationModalMessage');
    const modalIconWrap = document.getElementById('invitationModalIconWrap');
    const modalIcon = document.getElementById('invitationModalIcon');

    function showToast(message, type, duration) {
        type = type || 'info';
        duration = duration === undefined ? 4000 : duration;

        const container = document.getElementById('invitationToastContainer');
        if (!container) return;

        const map = {
            success: ['alert-success', 'icon-[tabler--circle-check]'],
            error: ['alert-error', 'icon-[tabler--alert-circle]'],
            warning: ['alert-warning', 'icon-[tabler--alert-triangle]'],
            info: ['alert-info', 'icon-[tabler--info-circle]']
        };
        const pair = map[type] || map.info;

        const el = document.createElement('div');
        el.className = 'alert ' + pair[0] + ' shadow-lg pointer-events-auto text-sm';
        el.innerHTML = '<span class="' + pair[1] + ' size-5"></span><span>' + message + '</span>' +
            '<button type="button" class="btn btn-ghost btn-xs btn-circle ml-auto"><span class="icon-[tabler--x] size-3"></span></button>';
        el.querySelector('button').addEventListener('click', function () { el.remove(); });
        container.appendChild(el);

        if (duration > 0) {
            window.setTimeout(function () { el.remove(); }, duration);
        }
    }

    function openInvitationModal(title, message, action, id, options) {
        options = options || {};
        pendingInvitationAction = action;
        pendingInvitationId = id;

        modalTitle.textContent = title;
        modalMessage.textContent = message;
        confirmButton.textContent = options.confirmText || 'Confirm';
        confirmButton.className = 'btn flex-1 ' + (options.confirmClass || 'btn-error');

        if (options.variant === 'primary') {
            modalIconWrap.className = 'size-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4';
            modalIcon.className = 'icon-[tabler--refresh] size-7 text-primary';
        } else {
            modalIconWrap.className = 'size-14 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-4';
            modalIcon.className = 'icon-[tabler--alert-triangle] size-7 text-error';
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeInvitationModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        pendingInvitationAction = null;
        pendingInvitationId = null;
    }

    function invitationUrl(action, id) {
        return '/admin/user-hierarchy/pending-invitations/' + id + '/' + action;
    }

    function executeInvitationAction() {
        if (!pendingInvitationAction || !pendingInvitationId) return;

        const action = pendingInvitationAction;
        const id = pendingInvitationId;
        closeInvitationModal();

        showToast(action === 'resend' ? 'Resending invitation...' : 'Cancelling invitation...', 'info', 0);

        fetch(invitationUrl(action, id), {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.success) {
                    showToast(data.message, 'success');
                    window.setTimeout(function () { location.reload(); }, 1500);
                } else {
                    showToast('Failed: ' + (data.error || 'Unknown error'), 'error');
                }
            })
            .catch(function () {
                showToast('Request failed. Please try again.', 'error');
            });
    }

    document.querySelectorAll('[data-invitation-modal-dismiss]').forEach(function (el) {
        el.addEventListener('click', closeInvitationModal);
    });

    if (confirmButton) {
        confirmButton.addEventListener('click', executeInvitationAction);
    }

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.invitation-action-btn');
        if (!btn) return;

        const action = btn.dataset.action;
        const id = btn.dataset.id;
        const email = btn.dataset.email || 'this user';

        if (action === 'resend') {
            openInvitationModal(
                'Resend Invitation',
                'Are you sure you want to resend the invitation to ' + email + '?',
                'resend',
                id,
                { variant: 'primary', confirmClass: 'btn-primary', confirmText: 'Resend' }
            );
        } else if (action === 'cancel') {
            openInvitationModal(
                'Cancel Invitation',
                'Are you sure you want to cancel the invitation for ' + email + '? This action cannot be undone.',
                'cancel',
                id,
                { variant: 'danger', confirmClass: 'btn-error', confirmText: 'Cancel Invitation' }
            );
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeInvitationModal();
        }
    });
})();
</script>
{% endblock %}
