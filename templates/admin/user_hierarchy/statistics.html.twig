{% extends 'layout/admin_base.html.twig' %}

{% block title %}User Hierarchy Statistics - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('admin_user_hierarchy_list') }}">User Hierarchy</a></li>
                                <li>Statistics</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--chart-bar] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">User Hierarchy Statistics</h1>
                                <p class="text-sm text-base-content/60 mt-1">Overview of user distribution and hierarchy metrics</p>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('admin_user_hierarchy_list') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to List
                    </a>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# Statistics cards #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-primary/10 text-primary rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--users] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Total Users</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ statistics.totalUsers }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-secondary/10 text-secondary rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--shield-check] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Shipping Line Admins</p>
                            <p class="text-2xl sm:text-3xl font-bold text-secondary">{{ statistics.adminUsers }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm sm:col-span-2 lg:col-span-1">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-success/10 text-success rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--users-group] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Subordinate Users</p>
                            <p class="text-2xl sm:text-3xl font-bold text-success">{{ statistics.subordinateUsers }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Distribution summary #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-6">
                <div class="flex items-center gap-2 mb-4">
                    <span class="icon-[tabler--chart-pie] size-5 text-base-content/70"></span>
                    <h3 class="font-semibold text-base text-base-content">Distribution</h3>
                </div>
                {% set adminPct = statistics.totalUsers > 0 ? (statistics.adminUsers / statistics.totalUsers * 100)|round(1) : 0 %}
                {% set subPct = statistics.totalUsers > 0 ? (statistics.subordinateUsers / statistics.totalUsers * 100)|round(1) : 0 %}
                <div class="space-y-4">
                    <div>
                        <div class="flex items-center justify-between text-sm mb-1">
                            <span class="text-base-content/70">Shipping Line Admins</span>
                            <span class="font-medium text-base-content">{{ statistics.adminUsers }} <span class="text-base-content/50">({{ adminPct }}%)</span></span>
                        </div>
                        <progress class="progress progress-secondary w-full" value="{{ adminPct }}" max="100"></progress>
                    </div>
                    <div>
                        <div class="flex items-center justify-between text-sm mb-1">
                            <span class="text-base-content/70">Subordinate Users</span>
                            <span class="font-medium text-base-content">{{ statistics.subordinateUsers }} <span class="text-base-content/50">({{ subPct }}%)</span></span>
                        </div>
                        <progress class="progress progress-success w-full" value="{{ subPct }}" max="100"></progress>
                    </div>
                </div>
            </div>
        </div>

        {# Quick actions #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-6">
                <div class="flex items-center gap-2 mb-4">
                    <span class="icon-[tabler--bolt] size-5 text-base-content/70"></span>
                    <h3 class="font-semibold text-base text-base-content">Quick Actions</h3>
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('admin_user_hierarchy_list') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--list] size-4"></span>
                        View All Users
                    </a>
                    <a href="{{ path('admin_user_hierarchy_create') }}" class="btn btn-primary btn-sm gap-2">
                        <span class="icon-[tabler--plus] size-4"></span>
                        Create New User
                    </a>
                    <a href="{{ path('admin_user_hierarchy_validate_integrity') }}" class="btn btn-outline btn-sm gap-2">
                        <span class="icon-[tabler--shield-check] size-4"></span>
                        Validate Integrity
                    </a>
                    <a href="{{ path('admin_user_hierarchy_export', {format: 'csv'}) }}" class="btn btn-outline btn-sm gap-2">
                        <span class="icon-[tabler--download] size-4"></span>
                        Export Data
                    </a>
                    <a href="{{ path('admin_user_hierarchy_pending_invitations') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--inbox] size-4"></span>
                        Pending Invitations
                    </a>
                </div>
            </div>
        </div>
</div>
{% endblock %}
