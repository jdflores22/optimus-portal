{% extends 'layout/admin_base.html.twig' %}

{% block title %}Validate Integrity - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('admin_user_hierarchy_list') }}">User Hierarchy</a></li>
                                <li>Validate Integrity</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--shield-check] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">User Hierarchy Integrity Check</h1>
                                <p class="text-sm text-base-content/60 mt-1">Validate hierarchy relationships and identify potential issues</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button type="button" onclick="window.location.reload()" class="btn btn-primary btn-sm gap-2">
                            <span class="icon-[tabler--refresh] size-4"></span>
                            Re-check
                        </button>
                        <a href="{{ path('admin_user_hierarchy_list') }}" class="btn btn-ghost btn-sm gap-2">
                            <span class="icon-[tabler--arrow-left] size-4"></span>
                            Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# Summary #}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 {{ issues is empty ? 'bg-success/10 text-success' : 'bg-warning/10 text-warning' }} rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--{{ issues is empty ? 'circle-check' : 'alert-triangle' }}] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Status</p>
                            <p class="text-lg sm:text-xl font-bold {{ issues is empty ? 'text-success' : 'text-warning' }}">
                                {{ issues is empty ? 'All Clear' : 'Issues Found' }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-error/10 text-error rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--alert-circle] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Critical Issues</p>
                            <p class="text-2xl sm:text-3xl font-bold text-error">{{ issues|filter(i => i.type == 'error')|length }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-warning/10 text-warning rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--alert-triangle] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Warnings</p>
                            <p class="text-2xl sm:text-3xl font-bold text-warning">{{ issues|filter(i => i.type == 'warning')|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Results #}
        {% if issues is empty %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body flex flex-col items-center justify-center py-12 sm:py-16 text-center">
                    <div class="size-16 bg-success/10 rounded-full flex items-center justify-center mb-4">
                        <span class="icon-[tabler--circle-check] size-8 text-success"></span>
                    </div>
                    <h3 class="text-lg font-semibold text-base-content">All Clear!</h3>
                    <p class="mt-2 text-sm text-base-content/60 max-w-md">
                        No integrity issues found in the user hierarchy. All relationships are properly configured.
                    </p>
                </div>
            </div>
        {% else %}
            <div class="space-y-4">
                {% for issue in issues %}
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-body p-4 sm:p-6">
                            {% if issue.type == 'error' %}
                                <div class="alert alert-error mb-0">
                                    <span class="icon-[tabler--alert-circle] size-5"></span>
                                    <div>
                                        <p class="font-semibold">Critical Issue</p>
                                        <p class="text-sm mt-1 opacity-90">{{ issue.message }}</p>
                                    </div>
                                </div>
                            {% elseif issue.type == 'warning' %}
                                <div class="alert alert-warning mb-0">
                                    <span class="icon-[tabler--alert-triangle] size-5"></span>
                                    <div>
                                        <p class="font-semibold">Warning</p>
                                        <p class="text-sm mt-1 opacity-90">{{ issue.message }}</p>
                                    </div>
                                </div>
                            {% else %}
                                <div class="alert alert-info mb-0">
                                    <span class="icon-[tabler--info-circle] size-5"></span>
                                    <div>
                                        <p class="font-semibold">Information</p>
                                        <p class="text-sm mt-1 opacity-90">{{ issue.message }}</p>
                                    </div>
                                </div>
                            {% endif %}

                            {% if issue.users is defined and issue.users|length > 0 %}
                                <div class="mt-4">
                                    <h4 class="text-sm font-semibold text-base-content mb-3 flex items-center gap-2">
                                        <span class="icon-[tabler--users] size-4 text-base-content/60"></span>
                                        Affected Users ({{ issue.users|length }})
                                    </h4>
                                    <div class="overflow-x-auto rounded-box border border-base-300">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>User</th>
                                                    <th>Role</th>
                                                    <th class="text-right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for user in issue.users %}
                                                    <tr class="hover">
                                                        <td>
                                                            <div class="flex items-center gap-3">
                                                                <div class="size-8 rounded-full {{ avatar_colors(user) }} flex items-center justify-center shrink-0">
                                                                    <span class="text-xs font-semibold">
                                                                        {% if user.firstName is defined and user.lastName is defined %}
                                                                            {{ (user.firstName ~ user.lastName)|slice(0, 2)|upper }}
                                                                        {% else %}
                                                                            {{ user.email|slice(0, 2)|upper }}
                                                                        {% endif %}
                                                                    </span>
                                                                </div>
                                                                <div class="min-w-0">
                                                                    <div class="font-medium text-sm truncate">
                                                                        {% if user.firstName is defined and user.lastName is defined %}
                                                                            {{ user.firstName }} {{ user.lastName }}
                                                                        {% else %}
                                                                            {{ user.email|split('@')[0]|title }}
                                                                        {% endif %}
                                                                    </div>
                                                                    <div class="text-xs text-base-content/50 truncate">{{ user.email }}</div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            {% if user.role.value == 'SHIPPING_LINES_ADMIN' %}
                                                                <span class="badge badge-secondary badge-sm">{{ user.role.value|replace({'_': ' '})|title }}</span>
                                                            {% elseif user.role.value == 'SL_STAFF' %}
                                                                <span class="badge badge-primary badge-sm">{{ user.role.value|replace({'_': ' '})|title }}</span>
                                                            {% elseif user.role.value == 'EVALUATOR' %}
                                                                <span class="badge badge-info badge-sm">{{ user.role.value|replace({'_': ' '})|title }}</span>
                                                            {% elseif user.role.value == 'ACCOUNTING' %}
                                                                <span class="badge badge-warning badge-sm">{{ user.role.value|replace({'_': ' '})|title }}</span>
                                                            {% elseif user.role.value == 'TERMINAL_TEAM' %}
                                                                <span class="badge badge-accent badge-sm">{{ user.role.value|replace({'_': ' '})|title }}</span>
                                                            {% else %}
                                                                <span class="badge badge-ghost badge-sm">{{ user.role.value|replace({'_': ' '})|title }}</span>
                                                            {% endif %}
                                                        </td>
                                                        <td class="text-right">
                                                            <a href="{{ path('admin_user_hierarchy_edit', {id: user.id}) }}"
                                                               class="btn btn-xs btn-primary gap-1"
                                                               title="Edit user">
                                                                <span class="icon-[tabler--edit] size-3"></span>
                                                                Fix
                                                            </a>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {# Quick actions #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-6">
                <div class="flex items-center gap-2 mb-4">
                    <span class="icon-[tabler--bolt] size-5 text-base-content/70"></span>
                    <h3 class="font-semibold text-base text-base-content">Quick Actions</h3>
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('admin_user_hierarchy_list') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--list] size-4"></span>
                        View All Users
                    </a>
                    <a href="{{ path('admin_user_hierarchy_statistics') }}" class="btn btn-outline btn-sm gap-2">
                        <span class="icon-[tabler--chart-bar] size-4"></span>
                        View Statistics
                    </a>
                    <a href="{{ path('admin_user_hierarchy_create') }}" class="btn btn-primary btn-sm gap-2">
                        <span class="icon-[tabler--plus] size-4"></span>
                        Create User
                    </a>
                </div>
            </div>
        </div>
</div>
{% endblock %}
