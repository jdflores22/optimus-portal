{% extends 'layout/admin_base.html.twig' %}

{% block title %}Create User - OPTIMUS{% endblock %}

{% block content %}
<div class="space-y-6">
<!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('admin_user_hierarchy_list') }}">User Hierarchy</a></li>
                            <li>Create</li>
                        </ul>
                    </div>
                    <h1 class="text-xl sm:text-2xl font-bold text-base-content">
                        {% if preselectedAdminId %}Add Subordinate User{% else %}Create New User{% endif %}
                    </h1>
                    <p class="text-sm text-base-content/60 mt-1">
                        {% if preselectedAdminId %}
                            Add a new subordinate user to the selected admin's team
                        {% else %}
                            Add a user with role-specific access and shipping line scope
                        {% endif %}
                    </p>
                </div>
                <a href="{{ path('admin_user_hierarchy_list') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        <div class="max-w-2xl mx-auto">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success mb-6">
                    <span class="icon-[tabler--check] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error mb-6">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning mb-6">
                    <span class="icon-[tabler--alert-triangle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('info') %}
                <div class="alert alert-info mb-6">
                    <span class="icon-[tabler--info-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6 sm:p-8">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="size-12 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--user-plus] size-6 text-primary"></span>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-base-content">User Details</h2>
                            <p class="text-sm text-base-content/60">Enter account information, role, and hierarchy</p>
                        </div>
                    </div>

                    <form id="createUserForm"
                          method="POST"
                          action="{{ path('admin_user_hierarchy_create', preselectedAdminId ? {admin_id: preselectedAdminId} : {}) }}"
                          class="space-y-5">
                        <input type="hidden" name="_token" value="{{ csrf_token('user_create') }}">

                        <div class="form-control">
                            <label class="label py-1" for="email">
                                <span class="label-text font-medium">Email Address <span class="text-error">*</span></span>
                            </label>
                            <label class="input input-bordered flex items-center gap-2 w-full">
                                <span class="icon-[tabler--mail] size-4 text-base-content/50 shrink-0"></span>
                                <input type="email"
                                       name="email"
                                       id="email"
                                       required
                                       oninput="validateEmail(this.value)"
                                       class="grow"
                                       value="{{ data.email|default('') }}">
                                <span id="emailValidationIcon" class="hidden shrink-0">
                                    <span id="emailSuccessIcon" class="icon-[tabler--circle-check] size-5 text-success hidden"></span>
                                    <span id="emailErrorIcon" class="icon-[tabler--alert-circle] size-5 text-error hidden"></span>
                                    <span id="emailLoadingIcon" class="loading loading-spinner loading-sm hidden"></span>
                                </span>
                            </label>
                            <div id="emailValidationMessage" class="label py-1 hidden">
                                <span class="label-text-alt"></span>
                            </div>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="password">
                                <span class="label-text font-medium" id="passwordLabel">Password</span>
                            </label>
                            <input type="password"
                                   name="password"
                                   id="password"
                                   minlength="8"
                                   class="input input-bordered w-full">
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Minimum 8 characters (required only when skipping email notification)</span>
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="firstName">
                                <span class="label-text font-medium">First Name <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   name="firstName"
                                   id="firstName"
                                   required
                                   class="input input-bordered w-full"
                                   value="{{ data.firstName|default('') }}">
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="lastName">
                                <span class="label-text font-medium">Last Name <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   name="lastName"
                                   id="lastName"
                                   required
                                   class="input input-bordered w-full"
                                   value="{{ data.lastName|default('') }}">
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="role">
                                <span class="label-text font-medium">Role <span class="text-error">*</span></span>
                            </label>
                            <select name="role"
                                    id="role"
                                    required
                                    onchange="handleRoleChange()"
                                    class="select select-bordered w-full">
                                <option value="">Select a role</option>
                                {% if currentUser.role.value == 'SYSTEM_ADMIN' and not preselectedAdminId %}
                                    <option value="SHIPPING_LINES_ADMIN" {% if data.role|default('') == 'SHIPPING_LINES_ADMIN' %}selected{% endif %}>
                                        Shipping Lines Admin
                                    </option>
                                {% endif %}
                                <option value="SL_STAFF" {% if data.role|default('') == 'SL_STAFF' %}selected{% endif %}>SL Staff</option>
                                <option value="EVALUATOR" {% if data.role|default('') == 'EVALUATOR' %}selected{% endif %}>Evaluator</option>
                                <option value="ACCOUNTING" {% if data.role|default('') == 'ACCOUNTING' %}selected{% endif %}>Accounting</option>
                                <option value="TERMINAL_TEAM" {% if data.role|default('') == 'TERMINAL_TEAM' %}selected{% endif %}>Terminal Team</option>
                            </select>
                            {% if preselectedAdminId %}
                                <label class="label py-1">
                                    <span class="label-text-alt text-base-content/60">Creating subordinate user — only subordinate roles available</span>
                                </label>
                            {% elseif currentUser.role.value == 'SHIPPING_LINES_ADMIN' %}
                                <label class="label py-1">
                                    <span class="label-text-alt text-base-content/60">As a shipping line admin, you can only create subordinate users</span>
                                </label>
                            {% endif %}
                        </div>

                        <div id="shippingLineField" class="form-control hidden">
                            <label class="label py-1" for="shippingLineId">
                                <span class="label-text font-medium">Shipping Line <span class="text-error">*</span></span>
                            </label>
                            <select name="shippingLineId"
                                    id="shippingLineId"
                                    class="select select-bordered w-full">
                                <option value="">Select a shipping line</option>
                                {% for shippingLine in shippingLines %}
                                    <option value="{{ shippingLine.id }}" {% if data.shippingLineId|default('') == shippingLine.id %}selected{% endif %}>
                                        {{ shippingLine.brandName }}
                                    </option>
                                {% endfor %}
                            </select>
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Required for Shipping Lines Admin role</span>
                            </label>
                        </div>

                        <div id="adminField" class="form-control {% if currentUser.role.value != 'SHIPPING_LINES_ADMIN' %}hidden{% endif %}">
                            {% if currentUser.role.value == 'SHIPPING_LINES_ADMIN' %}
                                <input type="hidden" name="shippingLineAdminId" value="{{ currentUser.id }}">
                                <div class="alert alert-info">
                                    <span class="icon-[tabler--info-circle] size-5"></span>
                                    <div class="text-sm">
                                        <p class="font-medium">Automatic Admin Assignment</p>
                                        <p class="mt-1 opacity-90">You will be automatically assigned as the admin for any user you create. All team members will report to you.</p>
                                    </div>
                                </div>
                            {% else %}
                                <label class="label py-1" for="shippingLineAdminId">
                                    <span class="label-text font-medium">Shipping Line Admin <span class="text-error">*</span></span>
                                </label>
                                <select name="shippingLineAdminId"
                                        id="shippingLineAdminId"
                                        class="select select-bordered w-full">
                                    <option value="">Select an admin</option>
                                </select>
                                <label class="label py-1">
                                    <span class="label-text-alt text-base-content/60">Required for subordinate roles</span>
                                </label>
                            {% endif %}
                        </div>

                        <div id="roleDescription" class="alert alert-info hidden">
                            <span class="icon-[tabler--info-circle] size-5"></span>
                            <div class="text-sm">
                                <p class="font-medium">Role Information</p>
                                <p id="roleDescriptionText" class="mt-1 opacity-90"></p>
                            </div>
                        </div>

                        {% if currentUser.role.value == 'SYSTEM_ADMIN' %}
                            <label class="flex items-start gap-3 cursor-pointer rounded-xl bg-base-200/60 p-4">
                                <input id="skipEmailNotification"
                                       name="skipEmailNotification"
                                       type="checkbox"
                                       value="1"
                                       onchange="handleSkipEmailChange()"
                                       class="checkbox checkbox-primary mt-0.5">
                                <div>
                                    <span class="font-medium text-base-content">Skip email notification and create user directly</span>
                                    <p class="text-sm text-base-content/60 mt-1">
                                        When checked, the account is created immediately without an email invitation.
                                        You must provide login credentials manually.
                                    </p>
                                </div>
                            </label>

                            <div id="emailWorkflowInfo" class="alert alert-success">
                                <span class="icon-[tabler--mail] size-5"></span>
                                <div class="text-sm">
                                    <p class="font-medium">Email Invitation Workflow (Default)</p>
                                    <p class="mt-1 opacity-90">The user receives an email invitation to accept their role, ensuring explicit consent during onboarding.</p>
                                </div>
                            </div>

                            <div id="directCreationInfo" class="alert alert-warning hidden">
                                <span class="icon-[tabler--alert-triangle] size-5"></span>
                                <div class="text-sm">
                                    <p class="font-medium">Direct User Creation (Legacy Mode)</p>
                                    <p class="mt-1 opacity-90">The account is created immediately with the provided password. You must share credentials manually.</p>
                                </div>
                            </div>
                        {% endif %}

                        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
                            <a href="{{ path('admin_user_hierarchy_list') }}" class="btn btn-ghost w-full sm:w-auto">
                                Cancel
                            </a>
                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-primary gap-2 w-full sm:w-auto">
                                <span id="btnSpinner" class="loading loading-spinner loading-sm hidden"></span>
                                <span id="btnText">Create User</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
{% endblock %}

{% block page_modals %}
<div id="createUserToastContainer" class="fixed top-20 right-4 z-[10003] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>
{% endblock %}

{% block page_scripts %}
<script>
function handleSkipEmailChange() {
    const skipEmailCheckbox = document.getElementById('skipEmailNotification');
    const passwordField = document.getElementById('password');
    const passwordLabel = document.getElementById('passwordLabel');
    const emailWorkflowInfo = document.getElementById('emailWorkflowInfo');
    const directCreationInfo = document.getElementById('directCreationInfo');

    if (!skipEmailCheckbox) return;

    if (skipEmailCheckbox.checked) {
        passwordField.setAttribute('required', 'required');
        passwordLabel.innerHTML = 'Password <span class="text-error">*</span>';
        emailWorkflowInfo.classList.add('hidden');
        directCreationInfo.classList.remove('hidden');
    } else {
        passwordField.removeAttribute('required');
        passwordLabel.textContent = 'Password';
        emailWorkflowInfo.classList.remove('hidden');
        directCreationInfo.classList.add('hidden');
    }
}

function showToast(message, type) {
    type = type || 'info';
    const container = document.getElementById('createUserToastContainer');
    if (!container) return;

    const map = {
        success: ['alert-success', 'icon-[tabler--circle-check]'],
        error: ['alert-error', 'icon-[tabler--alert-circle]'],
        warning: ['alert-warning', 'icon-[tabler--alert-triangle]'],
        info: ['alert-info', 'icon-[tabler--info-circle]']
    };
    const pair = map[type] || map.info;

    const toast = document.createElement('div');
    toast.className = 'alert ' + pair[0] + ' shadow-lg pointer-events-auto text-sm';
    toast.innerHTML = '<span class="' + pair[1] + ' size-5"></span><span>' + message + '</span>';
    container.appendChild(toast);

    window.setTimeout(function () { toast.remove(); }, 3000);
}

let emailValidationTimeout;
let isEmailValid = false;

function validateEmail(email) {
    if (emailValidationTimeout) {
        clearTimeout(emailValidationTimeout);
    }

    if (!email || email.trim() === '') {
        clearEmailValidation();
        return;
    }

    showEmailValidationState('loading');

    emailValidationTimeout = setTimeout(function () {
        fetch('{{ path('admin_user_hierarchy_validate_email') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'email=' + encodeURIComponent(email)
        })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.valid) {
                    showEmailValidationState('success', data.message);
                    isEmailValid = true;
                } else {
                    showEmailValidationState('error', data.message);
                    isEmailValid = false;
                }
            })
            .catch(function () {
                showEmailValidationState('error', 'Unable to validate email. Please try again.');
                isEmailValid = false;
            });
    }, 500);
}

function clearEmailValidation() {
    const iconContainer = document.getElementById('emailValidationIcon');
    const message = document.getElementById('emailValidationMessage');
    const emailInput = document.getElementById('email');

    if (iconContainer) iconContainer.classList.add('hidden');
    if (message) message.classList.add('hidden');
    if (emailInput) emailInput.classList.remove('input-success', 'input-error');

    ['emailSuccessIcon', 'emailErrorIcon', 'emailLoadingIcon'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
    });

    isEmailValid = false;
}

function showEmailValidationState(state, message) {
    message = message || '';

    const iconContainer = document.getElementById('emailValidationIcon');
    const messageDiv = document.getElementById('emailValidationMessage');
    const emailInput = document.getElementById('email');
    const successIcon = document.getElementById('emailSuccessIcon');
    const errorIcon = document.getElementById('emailErrorIcon');
    const loadingIcon = document.getElementById('emailLoadingIcon');
    const emailWrapper = emailInput ? emailInput.closest('.input') : null;

    if (!iconContainer || !messageDiv || !emailInput) return;

    iconContainer.classList.remove('hidden');
    if (successIcon) successIcon.classList.add('hidden');
    if (errorIcon) errorIcon.classList.add('hidden');
    if (loadingIcon) loadingIcon.classList.add('hidden');

    if (state === 'loading') {
        if (loadingIcon) loadingIcon.classList.remove('hidden');
        if (emailWrapper) emailWrapper.classList.remove('input-success', 'input-error');
        messageDiv.classList.add('hidden');
    } else if (state === 'success') {
        if (successIcon) successIcon.classList.remove('hidden');
        if (emailWrapper) {
            emailWrapper.classList.add('input-success');
            emailWrapper.classList.remove('input-error');
        }
        emailInput.classList.add('validated');
        messageDiv.querySelector('.label-text-alt').textContent = message;
        messageDiv.querySelector('.label-text-alt').className = 'label-text-alt text-success';
        messageDiv.classList.remove('hidden');
    } else if (state === 'error') {
        if (errorIcon) errorIcon.classList.remove('hidden');
        if (emailWrapper) {
            emailWrapper.classList.add('input-error');
            emailWrapper.classList.remove('input-success');
        }
        emailInput.classList.add('validated');
        messageDiv.querySelector('.label-text-alt').textContent = message;
        messageDiv.querySelector('.label-text-alt').className = 'label-text-alt text-error';
        messageDiv.classList.remove('hidden');
    }
}

const availableAdmins = {{ shippingLines|map(sl => {
    id: sl.id,
    brandName: sl.brandName,
    admins: sl.shippingLineAdmins|map(admin => {
        id: admin.id,
        email: admin.email,
        name: admin.firstName ~ ' ' ~ admin.lastName
    })
})|json_encode|raw }};

const roleDescriptions = {
    'SHIPPING_LINES_ADMIN': 'Manages a specific shipping line and can supervise SL Staff, Evaluators, Accounting, and Terminal Team members. Has full access to shipping line operations and user management within their scope.',
    'SL_STAFF': 'General staff member under a Shipping Lines Admin. Handles day-to-day operations and administrative tasks within the shipping line scope.',
    'EVALUATOR': 'Specialized role for evaluation and assessment tasks. Reports to a Shipping Lines Admin and has access to evaluation-specific functionality.',
    'ACCOUNTING': 'Handles financial and accounting operations within the shipping line. Reports to a Shipping Lines Admin and has access to financial data and reports.',
    'TERMINAL_TEAM': 'Manages terminal operations, container assignments, and port logistics. Reports to a Shipping Lines Admin and has specialized access to terminal management features.'
};

function handleRoleChange() {
    const roleSelect = document.getElementById('role');
    const shippingLineField = document.getElementById('shippingLineField');
    const adminField = document.getElementById('adminField');
    const roleDescription = document.getElementById('roleDescription');
    const roleDescriptionText = document.getElementById('roleDescriptionText');
    const selectedRole = roleSelect.value;
    const isShippingLineAdmin = {{ currentUser.role.value == 'SHIPPING_LINES_ADMIN' ? 'true' : 'false' }};

    shippingLineField.classList.add('hidden');
    roleDescription.classList.add('hidden');

    if (!isShippingLineAdmin) {
        adminField.classList.add('hidden');
    }

    document.getElementById('shippingLineId').removeAttribute('required');
    const adminSelect = document.getElementById('shippingLineAdminId');
    if (adminSelect) {
        adminSelect.removeAttribute('required');
    }

    if (selectedRole) {
        roleDescriptionText.textContent = roleDescriptions[selectedRole] || '';
        roleDescription.classList.remove('hidden');

        if (selectedRole === 'SHIPPING_LINES_ADMIN') {
            shippingLineField.classList.remove('hidden');
            document.getElementById('shippingLineId').setAttribute('required', 'required');
        } else {
            adminField.classList.remove('hidden');

            if (!isShippingLineAdmin && adminSelect) {
                adminSelect.setAttribute('required', 'required');
                populateAdminOptions();
            }
        }
    }
}

function populateAdminOptions() {
    const adminSelect = document.getElementById('shippingLineAdminId');
    if (!adminSelect) return;

    adminSelect.innerHTML = '<option value="">Select an admin</option>';

    availableAdmins.forEach(function (shippingLine) {
        if (shippingLine.admins && shippingLine.admins.length > 0) {
            const optgroup = document.createElement('optgroup');
            optgroup.label = shippingLine.brandName;

            shippingLine.admins.forEach(function (admin) {
                const option = document.createElement('option');
                option.value = admin.id;
                option.textContent = admin.name + ' (' + admin.email + ')';
                optgroup.appendChild(option);
            });

            adminSelect.appendChild(optgroup);
        }
    });
}

document.addEventListener('DOMContentLoaded', function () {
    const preselectedAdminId = {{ preselectedAdminId|default('null') }};

    if (preselectedAdminId) {
        const roleSelect = document.getElementById('role');
        if (roleSelect) {
            roleSelect.value = 'SL_STAFF';
            handleRoleChange();

            window.setTimeout(function () {
                const adminSelect = document.getElementById('shippingLineAdminId');
                if (adminSelect) {
                    adminSelect.value = preselectedAdminId;
                }
            }, 100);
        }
    } else {
        handleRoleChange();
    }
});

document.getElementById('createUserForm').addEventListener('submit', function (e) {
    const submitBtn = document.getElementById('submitBtn');

    if (submitBtn.disabled) {
        e.preventDefault();
        return;
    }

    const emailInput = document.getElementById('email');
    if (emailInput.classList.contains('validated') && !isEmailValid) {
        e.preventDefault();
        showToast('Please fix the email validation error before submitting.', 'error');
        return;
    }

    submitBtn.disabled = true;
    document.getElementById('btnText').textContent = 'Creating User...';
    document.getElementById('btnSpinner').classList.remove('hidden');
});
</script>
{% endblock %}
