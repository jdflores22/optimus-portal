{% extends 'base.html.twig' %}

{% block title %}Payment Fee Configuration - OPTIMUS{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-base-content">Payment Fee Configuration</h1>
                    <p class="mt-1 text-sm text-base-content/70">Manage eDO release fee amounts</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success mb-4">
            <span class="icon-[tabler--check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error mb-4">
            <span class="icon-[tabler--alert-circle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Current Fee Configuration -->
        <div class="lg:col-span-1 space-y-6">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title text-lg">Current Fee</h3>
                    <div class="text-center py-6">
                        <p class="text-sm text-base-content/60 mb-2">eDO Release Fee</p>
                        <p class="text-5xl font-bold text-primary">₱{{ currentFee|number_format(2) }}</p>
                        {% if history|length > 0 %}
                            <div class="mt-4 text-xs text-base-content/60">
                                <p>Configured by: {{ history[0].configuredBy.email }}</p>
                                <p>Date: {{ history[0].configuredAt|date('M j, Y g:i A') }}</p>
                            </div>
                        {% endif %}
                    </div>
                    
                    <button onclick="showUpdateModal()" 
                            class="btn btn-primary w-full">
                        <span class="icon-[tabler--edit] size-5"></span>
                        Update Fee Amount
                    </button>
                </div>
            </div>

            <!-- QR Code Section -->
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title text-lg">Payment QR Code</h3>
                    
                    {% if currentQrCode %}
                        <div class="text-center mb-4">
                            <img src="{{ currentQrCode }}" alt="Payment QR Code" class="mx-auto max-w-full h-auto rounded-lg border border-base-300" style="max-height: 300px;">
                        </div>
                    {% else %}
                        <div class="text-center py-8 bg-base-200 rounded-lg border-2 border-dashed border-base-300 mb-4">
                            <span class="icon-[tabler--qrcode] size-12 mx-auto text-base-content/40"></span>
                            <p class="mt-2 text-sm text-base-content/60">No QR code uploaded</p>
                        </div>
                    {% endif %}
                    
                    <button onclick="showQrUploadModal()" 
                            class="btn btn-secondary w-full">
                        <span class="icon-[tabler--upload] size-5"></span>
                        {{ currentQrCode ? 'Update QR Code' : 'Upload QR Code' }}
                    </button>
                </div>
            </div>
        </div>

        <!-- Fee Configuration History -->
        <div class="lg:col-span-2">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
                        <div>
                            <h3 class="card-title text-lg">Configuration History</h3>
                            <p class="text-sm text-base-content/60">All payment fee changes</p>
                        </div>
                    </div>
                    
                    <!-- Desktop Table -->
                    <div class="hidden md:block overflow-x-auto">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Previous Amount</th>
                                    <th>New Amount</th>
                                    <th>Configured By</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if history|length > 0 %}
                                    {% for config in history %}
                                        <tr>
                                            <td>
                                                <div class="text-sm">{{ config.configuredAt|date('M j, Y') }}</div>
                                                <div class="text-xs text-base-content/60">{{ config.configuredAt|date('g:i A') }}</div>
                                            </td>
                                            <td>
                                                {% if config.previousAmount %}
                                                    <div class="text-sm text-base-content/70">₱{{ config.previousAmount|number_format(2) }}</div>
                                                {% else %}
                                                    <div class="badge badge-soft badge-ghost badge-sm">Initial</div>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="text-sm font-medium">₱{{ config.amount|number_format(2) }}</div>
                                            </td>
                                            <td>
                                                <div class="text-sm">{{ config.configuredBy.email }}</div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center py-12">
                                            <span class="icon-[tabler--database-off] size-12 mx-auto text-base-content/40"></span>
                                            <p class="mt-2 text-sm text-base-content/60">No configuration history available</p>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Cards -->
                    <div class="md:hidden space-y-3">
                        {% if history|length > 0 %}
                            {% for config in history %}
                                <div class="card bg-base-200">
                                    <div class="card-body p-4 space-y-2">
                                        <div class="flex items-center gap-2">
                                            <span class="icon-[tabler--calendar] size-4 text-base-content/60"></span>
                                            <span class="text-sm font-medium">{{ config.configuredAt|date('M j, Y g:i A') }}</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="icon-[tabler--arrow-right] size-4 text-base-content/60"></span>
                                            <span class="text-sm">
                                                {% if config.previousAmount %}
                                                    <span class="text-base-content/70">₱{{ config.previousAmount|number_format(2) }}</span>
                                                {% else %}
                                                    <span class="badge badge-soft badge-ghost badge-sm">Initial</span>
                                                {% endif %}
                                                <span class="mx-1">→</span>
                                                <span class="font-medium">₱{{ config.amount|number_format(2) }}</span>
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="icon-[tabler--user] size-4 text-base-content/60"></span>
                                            <span class="text-sm">{{ config.configuredBy.email }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-12">
                                <span class="icon-[tabler--database-off] size-12 mx-auto text-base-content/40"></span>
                                <p class="mt-2 text-sm text-base-content/60">No configuration history available</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Fee Modal -->
<dialog id="updateFeeModal" class="modal">
    <div class="modal-box">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold">Update Payment Fee</h3>
            <button onclick="closeUpdateModal()" class="btn btn-text btn-circle btn-sm">
                <span class="icon-[tabler--x] size-5"></span>
            </button>
        </div>
        <form id="updateFeeForm" onsubmit="submitFeeUpdate(event)">
            <div class="mb-4">
                <label for="feeAmount" class="label">
                    <span class="label-text">New Fee Amount (₱) <span class="text-error">*</span></span>
                </label>
                <label class="input input-bordered flex items-center gap-2">
                    <span class="text-base-content/60">₱</span>
                    <input type="number" 
                           id="feeAmount" 
                           name="amount" 
                           step="0.01" 
                           min="0.01" 
                           required
                           value="{{ currentFee }}"
                           class="grow"
                           placeholder="500.00">
                </label>
                <div class="label">
                    <span class="label-text-alt">Enter a positive decimal value</span>
                </div>
            </div>
            <div class="alert alert-warning mb-4">
                <span class="icon-[tabler--alert-triangle] size-5"></span>
                <span class="text-xs">This change will not affect existing pending or completed payment transactions.</span>
            </div>
            <div class="modal-action">
                <button type="button" 
                        onclick="closeUpdateModal()" 
                        class="btn btn-ghost">
                    Cancel
                </button>
                <button type="submit" 
                        class="btn btn-primary">
                    <span class="icon-[tabler--check] size-5"></span>
                    Update Fee
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button onclick="closeUpdateModal()">close</button>
    </form>
</dialog>

<!-- QR Code Upload Modal -->
<dialog id="qrUploadModal" class="modal">
    <div class="modal-box max-w-md">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold">Upload Payment QR Code</h3>
            <button onclick="closeQrUploadModal()" class="btn btn-text btn-circle btn-sm">
                <span class="icon-[tabler--x] size-5"></span>
            </button>
        </div>
        <form id="qrUploadForm" onsubmit="submitQrUpload(event)">
            <div class="mb-4">
                <!-- Upload Area -->
                <div id="qrUploadArea" class="border-2 border-dashed border-base-300 rounded-lg p-8 text-center hover:border-secondary transition-colors cursor-pointer">
                    <input type="file" id="qrCodeFile" name="qr_code" accept="image/jpeg,image/jpg,image/png" class="hidden" required>
                    <span class="icon-[tabler--photo] size-12 mx-auto text-base-content/40"></span>
                    <p class="mt-2 text-sm">
                        <span class="font-medium text-secondary">Click to upload</span> or drag and drop
                    </p>
                    <p class="mt-1 text-xs text-base-content/60">JPG or PNG (max 2MB)</p>
                </div>

                <!-- File Selected Area -->
                <div id="qrFileSelectedArea" class="hidden border-2 border-success rounded-lg p-6 bg-success/10">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="icon-[tabler--circle-check] size-10 text-success"></span>
                            <div>
                                <p class="text-sm font-medium" id="qrFileName"></p>
                                <p class="text-xs text-base-content/60" id="qrFileSize"></p>
                            </div>
                        </div>
                        <button type="button" id="changeQrFileBtn" class="btn btn-text btn-sm text-secondary">
                            Change
                        </button>
                    </div>
                    <!-- Image Preview -->
                    <div class="mt-4">
                        <img id="qrPreview" src="" alt="QR Code Preview" class="mx-auto max-w-full h-auto rounded-lg border border-base-300" style="max-height: 200px;">
                    </div>
                </div>
            </div>
            
            <div class="alert alert-info mb-4">
                <span class="icon-[tabler--info-circle] size-5"></span>
                <span class="text-xs">This QR code will be displayed to brokers when they make eDO release payments.</span>
            </div>
            
            <div class="modal-action">
                <button type="button" 
                        onclick="closeQrUploadModal()" 
                        class="btn btn-ghost">
                    Cancel
                </button>
                <button type="submit" 
                        class="btn btn-secondary">
                    <span class="icon-[tabler--upload] size-5"></span>
                    Upload QR Code
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button onclick="closeQrUploadModal()">close</button>
    </form>
</dialog>

<script>
function showUpdateModal() {
    document.getElementById('updateFeeModal').showModal();
}

function closeUpdateModal() {
    document.getElementById('updateFeeModal').close();
}

function showQrUploadModal() {
    document.getElementById('qrUploadModal').showModal();
}

function closeQrUploadModal() {
    document.getElementById('qrUploadModal').close();
    // Reset form
    document.getElementById('qrUploadForm').reset();
    document.getElementById('qrUploadArea').classList.remove('hidden');
    document.getElementById('qrFileSelectedArea').classList.add('hidden');
}

// QR Code upload handling
document.addEventListener('DOMContentLoaded', function() {
    const qrFileInput = document.getElementById('qrCodeFile');
    const qrUploadArea = document.getElementById('qrUploadArea');
    const qrFileSelectedArea = document.getElementById('qrFileSelectedArea');
    const changeQrFileBtn = document.getElementById('changeQrFileBtn');
    const qrFileName = document.getElementById('qrFileName');
    const qrFileSize = document.getElementById('qrFileSize');
    const qrPreview = document.getElementById('qrPreview');

    // Click upload area to trigger file input
    qrUploadArea.addEventListener('click', () => qrFileInput.click());

    // Change file button
    changeQrFileBtn.addEventListener('click', () => qrFileInput.click());

    // Handle file selection
    qrFileInput.addEventListener('change', function() {
        if (this.files && this.files[0]) {
            const file = this.files[0];
            
            // Validate file size (2MB)
            if (file.size > 2097152) {
                alert('File size must not exceed 2MB');
                this.value = '';
                return;
            }

            // Validate file type
            if (!['image/jpeg', 'image/jpg', 'image/png'].includes(file.type)) {
                alert('Only JPG and PNG images are allowed');
                this.value = '';
                return;
            }

            // Show file info
            qrFileName.textContent = file.name;
            qrFileSize.textContent = formatFileSize(file.size);
            
            // Show preview
            const reader = new FileReader();
            reader.onload = function(e) {
                qrPreview.src = e.target.result;
            };
            reader.readAsDataURL(file);
            
            // Toggle areas
            qrUploadArea.classList.add('hidden');
            qrFileSelectedArea.classList.remove('hidden');
        }
    });

    // Drag and drop
    qrUploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        qrUploadArea.classList.add('border-secondary', 'bg-secondary/10');
    });

    qrUploadArea.addEventListener('dragleave', () => {
        qrUploadArea.classList.remove('border-secondary', 'bg-secondary/10');
    });

    qrUploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        qrUploadArea.classList.remove('border-secondary', 'bg-secondary/10');
        
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            qrFileInput.files = e.dataTransfer.files;
            qrFileInput.dispatchEvent(new Event('change'));
        }
    });
});

function submitFeeUpdate(event) {
    event.preventDefault();
    
    const amount = document.getElementById('feeAmount').value;
    
    if (!amount || parseFloat(amount) <= 0) {
        alert('Please enter a valid positive amount');
        return;
    }
    
    if (!confirm(`Are you sure you want to update the payment fee to ₱${parseFloat(amount).toFixed(2)}?`)) {
        return;
    }
    
    fetch('/admin/payment-fee-config/update', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ amount: parseFloat(amount) })
    })
    .then(response => {
        console.log('Response status:', response.status);
        return response.json();
    })
    .then(data => {
        console.log('Response data:', data);
        if (data.success) {
            window.location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Fetch error:', error);
        alert('An error occurred while updating the payment fee: ' + error.message);
    });
}

function submitQrUpload(event) {
    event.preventDefault();
    
    const fileInput = document.getElementById('qrCodeFile');
    
    if (!fileInput.files || !fileInput.files[0]) {
        alert('Please select a QR code image');
        return;
    }
    
    if (!confirm('Upload this QR code? It will be displayed to brokers when making payments.')) {
        return;
    }
    
    const formData = new FormData();
    formData.append('qr_code', fileInput.files[0]);
    
    fetch('/admin/payment-fee-config/upload-qr', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('QR code uploaded successfully!');
            window.location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while uploading QR code');
    });
}

function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
}
</script>
{% endblock %}
