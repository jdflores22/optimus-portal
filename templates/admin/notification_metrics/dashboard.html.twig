{% extends 'base.html.twig' %}

{% block title %}Notification Metrics Dashboard{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="bg-base-100 border-b border-base-300">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8">
            <div class="py-4 sm:py-6">
                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold flex items-center gap-2">
                    <span class="icon-[tabler--chart-line] size-6 sm:size-7"></span>
                    Notification Metrics Dashboard
                </h1>
                <p class="mt-1 sm:mt-2 text-xs sm:text-sm text-base-content/70">Monitor and analyze notification delivery performance</p>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        {# Date Range Filter #}
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-body p-4 sm:p-6">
                <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div>
                        <label for="start_date" class="label">
                            <span class="label-text">Start Date</span>
                        </label>
                        <input type="date" id="start_date" name="start_date" 
                               value="{{ startDate|date('Y-m-d') }}"
                               class="input input-bordered w-full">
                    </div>
                    <div>
                        <label for="end_date" class="label">
                            <span class="label-text">End Date</span>
                        </label>
                        <input type="date" id="end_date" name="end_date" 
                               value="{{ endDate|date('Y-m-d') }}"
                               class="input input-bordered w-full">
                    </div>
                    <div class="flex items-end gap-2 sm:col-span-2 lg:col-span-2">
                        <button type="submit" class="btn btn-primary flex-1 sm:flex-initial">
                            <span class="icon-[tabler--filter] size-5"></span>
                            Apply Filter
                        </button>
                        <a href="{{ path('admin_notification_metrics') }}" class="btn btn-soft flex-1 sm:flex-initial">
                            <span class="icon-[tabler--refresh] size-5"></span>
                            Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>

        {# Overall Statistics #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
            <div class="card bg-primary text-primary-content shadow-sm">
                <div class="card-body p-4 sm:p-6">
                    <h5 class="text-sm sm:text-base opacity-90">Total Sent</h5>
                    <h2 class="text-2xl sm:text-3xl font-bold">{{ overallStats.totalSent|number_format }}</h2>
                </div>
            </div>
            <div class="card bg-success text-success-content shadow-sm">
                <div class="card-body p-4 sm:p-6">
                    <h5 class="text-sm sm:text-base opacity-90">Delivery Rate</h5>
                    <h2 class="text-2xl sm:text-3xl font-bold">{{ overallStats.deliveryRate|number_format(1) }}%</h2>
                    <small class="opacity-80 text-xs">{{ overallStats.totalDelivered|number_format }} delivered</small>
                </div>
            </div>
            <div class="card bg-info text-info-content shadow-sm">
                <div class="card-body p-4 sm:p-6">
                    <h5 class="text-sm sm:text-base opacity-90">Open Rate</h5>
                    <h2 class="text-2xl sm:text-3xl font-bold">{{ overallStats.openRate|number_format(1) }}%</h2>
                    <small class="opacity-80 text-xs">{{ overallStats.totalOpened|number_format }} opened</small>
                </div>
            </div>
            <div class="card bg-error text-error-content shadow-sm">
                <div class="card-body p-4 sm:p-6">
                    <h5 class="text-sm sm:text-base opacity-90">Failure Rate</h5>
                    <h2 class="text-2xl sm:text-3xl font-bold">{{ overallStats.failureRate|number_format(1) }}%</h2>
                    <small class="opacity-80 text-xs">{{ overallStats.totalFailed|number_format }} failed</small>
                </div>
            </div>
        </div>

        {# Alert if delivery rate is below 95% #}
        {% if overallStats.deliveryRate < 95 %}
        <div class="alert alert-warning mb-6">
            
            <div><span class="icon-[tabler--alert-triangle] size-5"></span>
                <strong>Warning:</strong> Notification delivery rate ({{ overallStats.deliveryRate|number_format(1) }}%) 
                is below the 95% threshold. Please investigate potential issues.
            </div>
        </div>
        {% endif %}

        {# Metrics by Notification Type #}
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-header">
                <h5 class="card-title text-base sm:text-lg">Metrics by Notification Type</h5>
            </div>
            <div class="card-body p-0">
                {# Desktop Table #}
                <div class="hidden lg:block overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Notification Type</th>
                                <th class="text-right">Total Sent</th>
                                <th class="text-right">Delivered</th>
                                <th class="text-right">Opened</th>
                                <th class="text-right">Failed</th>
                                <th class="text-right">Delivery Rate</th>
                                <th class="text-right">Open Rate</th>
                                <th class="text-right">Failure Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for metric in metricsByType %}
                            <tr class="hover">
                                <td>
                                    <span class="badge badge-secondary">{{ metric.type }}</span>
                                </td>
                                <td class="text-right">{{ metric.total|number_format }}</td>
                                <td class="text-right">{{ metric.delivered|number_format }}</td>
                                <td class="text-right">{{ metric.opened|number_format }}</td>
                                <td class="text-right">{{ metric.failed|number_format }}</td>
                                <td class="text-right">
                                    <span class="badge {% if metric.delivery_rate >= 95 %}badge-success{% elseif metric.delivery_rate >= 80 %}badge-warning{% else %}badge-error{% endif %}">
                                        {{ metric.delivery_rate|number_format(1) }}%
                                    </span>
                                </td>
                                <td class="text-right">
                                    <span class="badge badge-info">
                                        {{ metric.open_rate|number_format(1) }}%
                                    </span>
                                </td>
                                <td class="text-right">
                                    <span class="badge {% if metric.failure_rate < 5 %}badge-success{% elseif metric.failure_rate < 20 %}badge-warning{% else %}badge-error{% endif %}">
                                        {{ metric.failure_rate|number_format(1) }}%
                                    </span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-base-content/60 py-8">
                                    No metrics data available for the selected date range.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Mobile Cards #}
                <div class="lg:hidden p-3 space-y-3">
                    {% for metric in metricsByType %}
                    <div class="card bg-base-200 shadow-sm">
                        <div class="card-body p-4">
                            <div class="flex items-center justify-between mb-3">
                                <span class="badge badge-secondary">{{ metric.type }}</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div>
                                    <p class="text-base-content/60">Total Sent</p>
                                    <p class="font-semibold">{{ metric.total|number_format }}</p>
                                </div>
                                <div>
                                    <p class="text-base-content/60">Delivered</p>
                                    <p class="font-semibold">{{ metric.delivered|number_format }}</p>
                                </div>
                                <div>
                                    <p class="text-base-content/60">Opened</p>
                                    <p class="font-semibold">{{ metric.opened|number_format }}</p>
                                </div>
                                <div>
                                    <p class="text-base-content/60">Failed</p>
                                    <p class="font-semibold">{{ metric.failed|number_format }}</p>
                                </div>
                            </div>
                            <div class="divider my-2"></div>
                            <div class="flex gap-2 flex-wrap">
                                <span class="badge badge-sm {% if metric.delivery_rate >= 95 %}badge-success{% elseif metric.delivery_rate >= 80 %}badge-warning{% else %}badge-error{% endif %}">
                                    Delivery: {{ metric.delivery_rate|number_format(1) }}%
                                </span>
                                <span class="badge badge-sm badge-info">
                                    Open: {{ metric.open_rate|number_format(1) }}%
                                </span>
                                <span class="badge badge-sm {% if metric.failure_rate < 5 %}badge-success{% elseif metric.failure_rate < 20 %}badge-warning{% else %}badge-error{% endif %}">
                                    Failure: {{ metric.failure_rate|number_format(1) }}%
                                </span>
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <div class="text-center text-base-content/60 py-8">
                        No metrics data available for the selected date range.
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Metrics Trend Chart #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header">
                <h5 class="card-title text-base sm:text-lg">Notification Metrics Trend</h5>
            </div>
            <div class="card-body p-3 sm:p-6">
                <canvas id="metricsTrendChart" class="w-full" height="80"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const trendData = {{ metricsTrend|json_encode|raw }};
    
    const labels = trendData.map(d => d.date);
    const sentData = trendData.map(d => d.total);
    const deliveredData = trendData.map(d => d.delivered);
    const openedData = trendData.map(d => d.opened);
    const failedData = trendData.map(d => d.failed);
    
    const ctx = document.getElementById('metricsTrendChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Sent',
                    data: sentData,
                    borderColor: 'rgb(54, 162, 235)',
                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                    tension: 0.1
                },
                {
                    label: 'Delivered',
                    data: deliveredData,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.1
                },
                {
                    label: 'Opened',
                    data: openedData,
                    borderColor: 'rgb(153, 102, 255)',
                    backgroundColor: 'rgba(153, 102, 255, 0.1)',
                    tension: 0.1
                },
                {
                    label: 'Failed',
                    data: failedData,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    tension: 0.1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                title: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
});
</script>
{% endblock %}
