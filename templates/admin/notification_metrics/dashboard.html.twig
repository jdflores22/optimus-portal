{% extends 'base.html.twig' %}

{% block title %}Notification Metrics Dashboard{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3">
                <i class="fas fa-chart-line"></i> Notification Metrics Dashboard
            </h1>
        </div>
    </div>

    {# Date Range Filter #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form method="GET" class="row g-3">
                        <div class="col-md-4">
                            <label for="start_date" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="start_date" name="start_date" 
                                   value="{{ startDate|date('Y-m-d') }}">
                        </div>
                        <div class="col-md-4">
                            <label for="end_date" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="end_date" name="end_date" 
                                   value="{{ endDate|date('Y-m-d') }}">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-filter"></i> Apply Filter
                            </button>
                            <a href="{{ path('admin_notification_metrics') }}" class="btn btn-secondary ms-2">
                                <i class="fas fa-redo"></i> Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {# Overall Statistics #}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Sent</h5>
                    <h2 class="mb-0">{{ overallStats.totalSent|number_format }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Delivery Rate</h5>
                    <h2 class="mb-0">{{ overallStats.deliveryRate|number_format(1) }}%</h2>
                    <small>{{ overallStats.totalDelivered|number_format }} delivered</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Open Rate</h5>
                    <h2 class="mb-0">{{ overallStats.openRate|number_format(1) }}%</h2>
                    <small>{{ overallStats.totalOpened|number_format }} opened</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Failure Rate</h5>
                    <h2 class="mb-0">{{ overallStats.failureRate|number_format(1) }}%</h2>
                    <small>{{ overallStats.totalFailed|number_format }} failed</small>
                </div>
            </div>
        </div>
    </div>

    {# Alert if delivery rate is below 95% #}
    {% if overallStats.deliveryRate < 95 %}
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Warning:</strong> Notification delivery rate ({{ overallStats.deliveryRate|number_format(1) }}%) 
                is below the 95% threshold. Please investigate potential issues.
            </div>
        </div>
    </div>
    {% endif %}

    {# Metrics by Notification Type #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Metrics by Notification Type</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Notification Type</th>
                                    <th class="text-end">Total Sent</th>
                                    <th class="text-end">Delivered</th>
                                    <th class="text-end">Opened</th>
                                    <th class="text-end">Failed</th>
                                    <th class="text-end">Delivery Rate</th>
                                    <th class="text-end">Open Rate</th>
                                    <th class="text-end">Failure Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for metric in metricsByType %}
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">{{ metric.type }}</span>
                                    </td>
                                    <td class="text-end">{{ metric.total|number_format }}</td>
                                    <td class="text-end">{{ metric.delivered|number_format }}</td>
                                    <td class="text-end">{{ metric.opened|number_format }}</td>
                                    <td class="text-end">{{ metric.failed|number_format }}</td>
                                    <td class="text-end">
                                        <span class="badge {% if metric.delivery_rate >= 95 %}bg-success{% elseif metric.delivery_rate >= 80 %}bg-warning{% else %}bg-danger{% endif %}">
                                            {{ metric.delivery_rate|number_format(1) }}%
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-info">
                                            {{ metric.open_rate|number_format(1) }}%
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge {% if metric.failure_rate < 5 %}bg-success{% elseif metric.failure_rate < 20 %}bg-warning{% else %}bg-danger{% endif %}">
                                            {{ metric.failure_rate|number_format(1) }}%
                                        </span>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="8" class="text-center text-muted">
                                        No metrics data available for the selected date range.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Metrics Trend Chart #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Notification Metrics Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="metricsTrendChart" height="80"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const trendData = {{ metricsTrend|json_encode|raw }};
    
    const labels = trendData.map(d => d.date);
    const sentData = trendData.map(d => d.total);
    const deliveredData = trendData.map(d => d.delivered);
    const openedData = trendData.map(d => d.opened);
    const failedData = trendData.map(d => d.failed);
    
    const ctx = document.getElementById('metricsTrendChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Sent',
                    data: sentData,
                    borderColor: 'rgb(54, 162, 235)',
                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                    tension: 0.1
                },
                {
                    label: 'Delivered',
                    data: deliveredData,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.1
                },
                {
                    label: 'Opened',
                    data: openedData,
                    borderColor: 'rgb(153, 102, 255)',
                    backgroundColor: 'rgba(153, 102, 255, 0.1)',
                    tension: 0.1
                },
                {
                    label: 'Failed',
                    data: failedData,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    tension: 0.1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                title: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
});
</script>
{% endblock %}
