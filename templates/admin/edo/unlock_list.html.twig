{% extends 'layout/admin_base.html.twig' %}

{% block title %}eDO Unlock Management - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>eDO Unlock</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="card-title text-xl sm:text-2xl">
                        <span class="icon-[tabler--lock-open] size-6"></span>
                        Locked eDOs
                    </h1>
                    <p class="text-sm text-base-content/70 mt-1">View and unlock eDOs without requiring payment</p>
                </div>
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm gap-2">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <div class="alert alert-warning shadow-sm">
        <span class="icon-[tabler--alert-triangle] size-5"></span>
        <div>
            <h3 class="font-semibold">Administrator action required</h3>
            <p class="text-sm">Unlocking eDOs without payment is privileged. All unlock operations are logged in the audit trail with your user ID, timestamp, and reason.</p>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>eDO Number</th>
                            <th>Container</th>
                            <th>Status</th>
                            <th>Expired Days</th>
                            <th>Consignee</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for edo in edos %}
                        <tr>
                            <td class="font-medium">{{ edo.edoNumber }}</td>
                            <td>{{ edo.container.containerNumber }}</td>
                            <td>
                                {% if edo.status.value == 'locked' %}
                                    <span class="badge badge-warning badge-sm">{{ edo.status.value|upper }}</span>
                                {% elseif edo.status.value == 'expired' %}
                                    <span class="badge badge-error badge-sm">{{ edo.status.value|upper }}</span>
                                {% else %}
                                    <span class="badge badge-ghost badge-sm">{{ edo.status.value|upper }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if edo.expiredDays %}
                                    <span class="font-semibold text-error">{{ edo.expiredDays }} days</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="text-sm">{{ edo.manifest.consignee.user.email }}</td>
                            <td class="text-right">
                                <a href="{{ path('admin_edo_unlock_detail', {id: edo.id}) }}" class="btn btn-primary btn-xs gap-1">
                                    <span class="icon-[tabler--lock-open] size-3.5"></span>
                                    View & Unlock
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-12 text-base-content/60">
                                <span class="icon-[tabler--circle-check] size-10 block mx-auto mb-2 opacity-40"></span>
                                No locked or expired eDOs found
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
