{% extends 'base.html.twig' %}

{% block title %}Unlock eDO - {{ edo.edoNumber }}{% endblock %}

{% block page_title %}Unlock eDO{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back Button -->
    <div class="mb-4">
        <a href="{{ path('admin_edo_unlock_list') }}" class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Unlock List
        </a>
    </div>

    <div class="bg-white shadow-sm rounded-lg">
        <!-- Header -->
        <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">{{ edo.edoNumber }}</h2>
                    <p class="mt-1 text-sm text-gray-600">Review eDO details and unlock without payment</p>
                </div>
                <span class="px-3 py-1 rounded-full text-sm font-medium
                    {% if edo.status.value == 'locked' %}bg-yellow-100 text-yellow-800
                    {% elseif edo.status.value == 'expired' %}bg-red-100 text-red-800
                    {% endif %}">
                    {{ edo.status.value|upper }}
                </span>
            </div>
        </div>

        <!-- eDO Details -->
        <div class="px-6 py-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">eDO Information</h3>
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-6">
                <div>
                    <dt class="text-sm font-medium text-gray-500">eDO Number</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ edo.edoNumber }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Container Number</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ container.containerNumber }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Generated Date</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ edo.generatedAt|date('Y-m-d H:i:s') }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Expiration Date</dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {% if edo.expiresAt %}
                            {{ edo.expiresAt|date('Y-m-d H:i:s') }}
                        {% else %}
                            N/A
                        {% endif %}
                    </dd>
                </div>
                {% if edo.expiredDays %}
                <div>
                    <dt class="text-sm font-medium text-gray-500">Expired Days</dt>
                    <dd class="mt-1 text-sm font-semibold text-red-600">{{ edo.expiredDays }} days</dd>
                </div>
                {% endif %}
                <div>
                    <dt class="text-sm font-medium text-gray-500">Consignee</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ manifest.consignee.user.email }}</dd>
                </div>
            </dl>
        </div>

        <!-- Unlock Form -->
        <div class="px-6 py-6 border-t border-gray-200">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Unlock eDO</h3>
            
            <form action="{{ path('admin_edo_unlock', {id: edo.id}) }}" method="POST" id="unlockForm">
                <div class="mb-6">
                    <label for="unlock_reason" class="block text-sm font-medium text-gray-700">Unlock Reason *</label>
                    <textarea id="unlock_reason" name="unlock_reason" rows="4" required
                              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                              placeholder="Provide a detailed reason for unlocking this eDO without payment..."></textarea>
                    <p class="mt-1 text-sm text-gray-500">This reason will be recorded in the audit trail</p>
                </div>

                <!-- Confirmation Modal Trigger -->
                <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">Warning</h3>
                            <div class="mt-2 text-sm text-red-700">
                                <ul class="list-disc list-inside space-y-1">
                                    <li>This action will unlock the eDO without requiring payment</li>
                                    <li>Your user ID, timestamp, and reason will be permanently logged</li>
                                    <li>This action cannot be undone</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-end space-x-3">
                    <a href="{{ path('admin_edo_unlock_list') }}"
                       class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        Cancel
                    </a>
                    <button type="button" onclick="showConfirmModal()"
                            class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700">
                        Unlock eDO
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="relative bg-white rounded-lg shadow-xl max-w-md w-full mx-auto">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Confirm eDO Unlock</h3>
            </div>
            <div class="px-6 py-4">
                <p class="text-sm text-gray-600">
                    Are you sure you want to unlock this eDO without payment? This action will be permanently logged in the audit trail.
                </p>
            </div>
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end space-x-3">
                <button type="button" onclick="hideConfirmModal()"
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </button>
                <button type="button" onclick="submitUnlock()"
                        class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700">
                    Confirm Unlock
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function showConfirmModal() {
    const reason = document.getElementById('unlock_reason').value.trim();
    if (!reason) {
        alert('Please provide a reason for unlocking this eDO');
        return;
    }
    document.getElementById('confirmModal').classList.remove('hidden');
}

function hideConfirmModal() {
    document.getElementById('confirmModal').classList.add('hidden');
}

function submitUnlock() {
    document.getElementById('unlockForm').submit();
}
</script>
{% endblock %}
