{% extends 'layout/admin_base.html.twig' %}

{% block title %}Unlock eDO {{ edo.edoNumber }} - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li><a href="{{ path('admin_edo_unlock_list') }}">eDO Unlock</a></li>
        <li>{{ edo.edoNumber }}</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6 max-w-4xl">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div>
                    <h1 class="card-title text-xl">{{ edo.edoNumber }}</h1>
                    <p class="text-sm text-base-content/70 mt-1">Review eDO details and unlock without payment</p>
                </div>
                {% if edo.status.value == 'locked' %}
                    <span class="badge badge-warning">{{ edo.status.value|upper }}</span>
                {% elseif edo.status.value == 'expired' %}
                    <span class="badge badge-error">{{ edo.status.value|upper }}</span>
                {% else %}
                    <span class="badge badge-ghost">{{ edo.status.value|upper }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="text-lg font-semibold mb-4">eDO Information</h2>
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                <div>
                    <dt class="text-sm text-base-content/60">eDO Number</dt>
                    <dd class="font-medium">{{ edo.edoNumber }}</dd>
                </div>
                <div>
                    <dt class="text-sm text-base-content/60">Container Number</dt>
                    <dd class="font-medium">{{ container.containerNumber }}</dd>
                </div>
                <div>
                    <dt class="text-sm text-base-content/60">Generated Date</dt>
                    <dd>{{ edo.generatedAt|date('Y-m-d H:i:s') }}</dd>
                </div>
                <div>
                    <dt class="text-sm text-base-content/60">Expiration Date</dt>
                    <dd>{% if edo.expiresAt %}{{ edo.expiresAt|date('Y-m-d H:i:s') }}{% else %}N/A{% endif %}</dd>
                </div>
                {% if edo.expiredDays %}
                <div>
                    <dt class="text-sm text-base-content/60">Expired Days</dt>
                    <dd class="font-semibold text-error">{{ edo.expiredDays }} days</dd>
                </div>
                {% endif %}
                <div>
                    <dt class="text-sm text-base-content/60">Consignee</dt>
                    <dd>{{ manifest.consignee.user.email }}</dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="text-lg font-semibold mb-4">Unlock eDO</h2>

            <form action="{{ path('admin_edo_unlock', {id: edo.id}) }}" method="POST" id="unlockForm" class="space-y-4">
                <div class="form-control">
                    <label class="label" for="unlock_reason">
                        <span class="label-text font-medium">Unlock Reason *</span>
                    </label>
                    <textarea id="unlock_reason" name="unlock_reason" rows="4" required
                              class="textarea textarea-bordered w-full"
                              placeholder="Provide a detailed reason for unlocking this eDO without payment..."></textarea>
                    <label class="label">
                        <span class="label-text-alt text-base-content/60">This reason will be recorded in the audit trail</span>
                    </label>
                </div>

                <div class="alert alert-error">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <div class="text-sm">
                        <p class="font-semibold">Warning</p>
                        <ul class="list-disc list-inside mt-1 space-y-1">
                            <li>This action will unlock the eDO without requiring payment</li>
                            <li>Your user ID, timestamp, and reason will be permanently logged</li>
                            <li>This action cannot be undone</li>
                        </ul>
                    </div>
                </div>

                <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
                    <a href="{{ path('admin_edo_unlock_list') }}" class="btn btn-ghost">Cancel</a>
                    <button type="button" onclick="showConfirmModal()" class="btn btn-error gap-2">
                        <span class="icon-[tabler--lock-open] size-4"></span>
                        Unlock eDO
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<dialog id="confirmUnlockModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg">Confirm eDO Unlock</h3>
        <p class="py-4 text-sm text-base-content/70">
            Are you sure you want to unlock this eDO without payment? This action will be permanently logged in the audit trail.
        </p>
        <div class="modal-action">
            <form method="dialog">
                <button class="btn btn-ghost">Cancel</button>
            </form>
            <button type="button" onclick="submitUnlock()" class="btn btn-error">Confirm Unlock</button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
{% endblock %}

{% block page_scripts %}
<script>
function showConfirmModal() {
    const reason = document.getElementById('unlock_reason').value.trim();
    if (!reason) {
        alert('Please provide a reason for unlocking this eDO');
        return;
    }
    document.getElementById('confirmUnlockModal').showModal();
}

function submitUnlock() {
    document.getElementById('unlockForm').submit();
}
</script>
{% endblock %}
