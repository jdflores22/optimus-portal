{% extends 'base.html.twig' %}

{% block title %}Transfer Request #{{ transferRequest.id }} - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Header -->
    <div class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="py-6">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="flex items-center">
                            <a href="{{ path('admin_broker_transfer_requests') }}" class="text-gray-400 hover:text-gray-600 mr-4">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                </svg>
                            </a>
                            <div>
                                <h1 class="text-2xl font-bold text-gray-900">Transfer Request #{{ transferRequest.id }}</h1>
                                <p class="mt-1 text-sm text-gray-600">Review broker transfer request details</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        {% if transferRequest.status == 'pending' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                                </svg>
                                Pending Review
                            </span>
                        {% elseif transferRequest.status == 'approved' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                                Approved
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                </svg>
                                Rejected
                            </span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Main Details -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Manifest Information -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Manifest Information</h2>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm font-medium text-gray-500">Manifest Number</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.manifest.manifestNumber }}</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-500">Shipping Line</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.manifest.shippingLine.brandName }}</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-500">BL Number</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.manifest.blNumber ?? 'N/A' }}</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-500">Workflow State</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.manifest.workflowState.displayName }}</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a href="{{ path('consignee_manifest_detail', {id: transferRequest.manifest.id}) }}" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
                            View Manifest Details →
                        </a>
                    </div>
                </div>

                <!-- Transfer Details -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Transfer Details</h2>
                    
                    <!-- From/To Brokers -->
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex-1">
                            <p class="text-xs font-medium text-gray-500 uppercase mb-2">
                                {% if transferRequest.status == 'approved' %}Old Broker{% else %}Current Broker{% endif %}
                            </p>
                            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                                <p class="text-sm font-medium text-gray-900">{{ transferRequest.oldBroker.fullName }}</p>
                                <p class="text-xs text-gray-600">{{ transferRequest.oldBroker.email }}</p>
                            </div>
                        </div>
                        <div class="px-4">
                            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <p class="text-xs font-medium text-gray-500 uppercase mb-2">
                                {% if transferRequest.status == 'approved' %}Current Broker{% else %}New Broker{% endif %}
                            </p>
                            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                                <p class="text-sm font-medium text-gray-900">{{ transferRequest.newBroker.fullName }}</p>
                                <p class="text-xs text-gray-600">{{ transferRequest.newBroker.email }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="mb-4">
                        <p class="text-sm font-medium text-gray-500 mb-2">Reason for Transfer</p>
                        <div class="bg-gray-50 rounded-lg p-4">
                            <p class="text-sm text-gray-900 whitespace-pre-wrap">{{ transferRequest.reason }}</p>
                        </div>
                    </div>

                    <!-- Transfer Letter -->
                    {% if transferRequest.transferLetter %}
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-2">Transfer Letter</p>
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center">
                                    <svg class="w-8 h-8 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                    </svg>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Transfer Letter Document</p>
                                        <p class="text-xs text-gray-600">Uploaded by consignee</p>
                                    </div>
                                </div>
                                <a href="{{ transferRequest.transferLetter }}" target="_blank" class="inline-flex items-center px-3 py-2 text-sm font-medium text-blue-600 hover:text-blue-700 bg-white border border-blue-300 rounded-lg hover:bg-blue-50">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                                    </svg>
                                    Download
                                </a>
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <div>
                        <p class="text-sm font-medium text-gray-500 mb-2">Transfer Letter</p>
                        <div class="bg-gray-50 rounded-lg p-4">
                            <p class="text-sm text-gray-600 italic">No transfer letter attached</p>
                        </div>
                    </div>
                    {% endif %}
                </div>

                <!-- Review Notes (if rejected) -->
                {% if transferRequest.status == 'rejected' and transferRequest.reviewNotes %}
                <div class="bg-red-50 border border-red-200 rounded-xl p-6">
                    <h2 class="text-lg font-semibold text-red-900 mb-2">Rejection Reason</h2>
                    <p class="text-sm text-red-800 whitespace-pre-wrap">{{ transferRequest.reviewNotes }}</p>
                </div>
                {% endif %}
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Request Information -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">Request Information</h3>
                    <div class="space-y-4">
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase">Requested By</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.consignee.businessName ?? transferRequest.consignee.email }}</p>
                            <p class="text-xs text-gray-600">{{ transferRequest.consignee.email }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase">Requested Date</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.requestedAt|date('F d, Y') }}</p>
                            <p class="text-xs text-gray-600">{{ transferRequest.requestedAt|date('g:i A') }}</p>
                        </div>
                        {% if transferRequest.reviewedAt %}
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase">Reviewed By</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.reviewedBy.email }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase">Reviewed Date</p>
                            <p class="mt-1 text-sm text-gray-900">{{ transferRequest.reviewedAt|date('F d, Y') }}</p>
                            <p class="text-xs text-gray-600">{{ transferRequest.reviewedAt|date('g:i A') }}</p>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Actions -->
                {% if transferRequest.status == 'pending' %}
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">Review Actions</h3>
                    <div class="space-y-3">
                        <button onclick="showApproveModal()" class="w-full inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-green-600 border border-transparent rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Approve Transfer
                        </button>
                        <button onclick="showRejectModal()" class="w-full inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-red-700 bg-red-50 border border-red-300 rounded-lg hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            Reject Transfer
                        </button>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Approve Confirmation Modal -->
<div id="approveModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999]">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="relative bg-white rounded-lg shadow-xl max-w-md w-full mx-auto">
            <form method="POST" action="{{ path('admin_broker_transfer_approve', {id: transferRequest.id}) }}" onsubmit="showApproveLoading()">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('approve_transfer') }}">
                <div class="p-6">
                    <div class="flex items-center justify-center w-12 h-12 mx-auto bg-green-100 rounded-full mb-4">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 text-center mb-2">Approve Transfer Request?</h3>
                    <p class="text-sm text-gray-600 text-center mb-4">
                        This will immediately transfer manifest <span class="font-semibold">{{ transferRequest.manifest.manifestNumber }}</span> from <span class="font-semibold">{{ transferRequest.oldBroker.fullName }}</span> to <span class="font-semibold">{{ transferRequest.newBroker.fullName }}</span>.
                    </p>
                    
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
                        <p class="text-sm text-blue-800 font-medium mb-2">The following will happen:</p>
                        <ul class="text-sm text-blue-700 space-y-1">
                            <li class="flex items-start">
                                <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                                Manifest broker will be changed
                            </li>
                            <li class="flex items-start">
                                <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                                Consignee will be notified
                            </li>
                            <li class="flex items-start">
                                <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                                New broker will be notified
                            </li>
                            <li class="flex items-start">
                                <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                                Old broker will be notified
                            </li>
                            <li class="flex items-start">
                                <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                                Activity & audit logs will be created
                            </li>
                        </ul>
                    </div>
                </div>
                
                <div class="flex items-center justify-end space-x-3 px-6 py-4 border-t border-gray-200 bg-gray-50 rounded-b-lg">
                    <button type="button" 
                            onclick="closeApproveModal()"
                            id="approveCancelBtn"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                        Cancel
                    </button>
                    <button type="submit" 
                            id="approveSubmitBtn"
                            class="px-4 py-2 text-sm font-medium text-white bg-green-600 border border-transparent rounded-lg hover:bg-green-700 inline-flex items-center">
                        <span id="approveButtonText">Yes, Approve Transfer</span>
                        <svg id="approveSpinner" class="hidden animate-spin ml-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999]">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="relative bg-white rounded-lg shadow-xl max-w-md w-full mx-auto">
            <form method="POST" action="{{ path('admin_broker_transfer_reject', {id: transferRequest.id}) }}" onsubmit="showRejectLoading()">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reject_transfer') }}">
                <div class="p-6">
                    <div class="flex items-center justify-center w-12 h-12 mx-auto bg-red-100 rounded-full mb-4">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 text-center mb-2">Reject Transfer Request</h3>
                    <p class="text-sm text-gray-600 text-center mb-4">
                        Please provide a detailed reason for rejecting this transfer request. The consignee will receive this explanation.
                    </p>
                    
                    <div>
                        <label for="rejection_reason" class="block text-sm font-medium text-gray-700 mb-1">
                            Rejection Reason <span class="text-red-500">*</span>
                        </label>
                        <textarea 
                            name="rejection_reason" 
                            id="rejection_reason" 
                            rows="4" 
                            required
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500"
                            placeholder="Explain why this transfer request is being rejected..."></textarea>
                        <p class="mt-1 text-xs text-gray-500">Be specific and professional. This message will be sent to the consignee.</p>
                    </div>
                </div>
                
                <div class="flex items-center justify-end space-x-3 px-6 py-4 border-t border-gray-200 bg-gray-50 rounded-b-lg">
                    <button type="button" 
                            onclick="closeRejectModal()"
                            id="rejectCancelBtn"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                        Cancel
                    </button>
                    <button type="submit" 
                            id="rejectSubmitBtn"
                            class="px-4 py-2 text-sm font-medium text-white bg-red-600 border border-transparent rounded-lg hover:bg-red-700 inline-flex items-center">
                        <span id="rejectButtonText">Reject Request</span>
                        <svg id="rejectSpinner" class="hidden animate-spin ml-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function showApproveModal() {
    document.getElementById('approveModal').classList.remove('hidden');
}

function closeApproveModal() {
    document.getElementById('approveModal').classList.add('hidden');
    // Reset button state
    document.getElementById('approveButtonText').textContent = 'Yes, Approve Transfer';
    document.getElementById('approveSpinner').classList.add('hidden');
    document.getElementById('approveSubmitBtn').disabled = false;
    document.getElementById('approveCancelBtn').disabled = false;
}

function showApproveLoading() {
    // Show spinner and disable buttons
    document.getElementById('approveButtonText').textContent = 'Processing...';
    document.getElementById('approveSpinner').classList.remove('hidden');
    document.getElementById('approveSubmitBtn').disabled = true;
    document.getElementById('approveCancelBtn').disabled = true;
    return true; // Allow form submission
}

function showRejectModal() {
    document.getElementById('rejectModal').classList.remove('hidden');
}

function closeRejectModal() {
    document.getElementById('rejectModal').classList.add('hidden');
    // Reset button state
    document.getElementById('rejectButtonText').textContent = 'Reject Request';
    document.getElementById('rejectSpinner').classList.add('hidden');
    document.getElementById('rejectSubmitBtn').disabled = false;
    document.getElementById('rejectCancelBtn').disabled = false;
}

function showRejectLoading() {
    // Show spinner and disable buttons
    document.getElementById('rejectButtonText').textContent = 'Processing...';
    document.getElementById('rejectSpinner').classList.remove('hidden');
    document.getElementById('rejectSubmitBtn').disabled = true;
    document.getElementById('rejectCancelBtn').disabled = true;
    return true; // Allow form submission
}
</script>
{% endblock %}
