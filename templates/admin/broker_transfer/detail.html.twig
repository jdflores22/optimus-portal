{% extends 'layout/admin_base.html.twig' %}

{% block title %}Transfer Request #{{ transferRequest.id }} - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li><a href="{{ path('admin_broker_transfer_requests') }}">Broker Transfer Requests</a></li>
                                <li>Request #{{ transferRequest.id }}</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
<div class="space-y-5 sm:space-y-6 max-w-6xl mx-auto">

        {# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-start gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--arrows-exchange] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Transfer Request #{{ transferRequest.id }}</h1>
                                <p class="text-sm text-base-content/60 mt-1">Review broker transfer request details</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        {% if transferRequest.status == 'pending' %}
                            <span class="badge badge-warning badge-lg badge-soft gap-1">
                                <span class="icon-[tabler--clock] size-4"></span>
                                Pending Review
                            </span>
                        {% elseif transferRequest.status == 'approved' %}
                            <span class="badge badge-success badge-lg badge-soft gap-1">
                                <span class="icon-[tabler--circle-check] size-4"></span>
                                Approved
                            </span>
                        {% else %}
                            <span class="badge badge-error badge-lg badge-soft gap-1">
                                <span class="icon-[tabler--circle-x] size-4"></span>
                                Rejected
                            </span>
                        {% endif %}
                        <a href="{{ path('admin_broker_transfer_requests') }}" class="btn btn-ghost btn-sm gap-2">
                            <span class="icon-[tabler--arrow-left] size-4"></span>
                            Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 sm:gap-6">

            {# Main content #}
            <div class="lg:col-span-2 space-y-5 sm:space-y-6">

                {# Manifest information #}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                        <div class="flex items-center gap-2">
                            <span class="icon-[tabler--package] size-5 text-base-content/70"></span>
                            <h2 class="card-title text-base sm:text-lg">Manifest Information</h2>
                        </div>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="form-control">
                                <label class="label py-1"><span class="label-text font-medium text-base-content/70">Manifest Number</span></label>
                                <p class="text-sm text-base-content font-medium">{{ transferRequest.manifest.manifestNumber }}</p>
                            </div>
                            <div class="form-control">
                                <label class="label py-1"><span class="label-text font-medium text-base-content/70">Shipping Line</span></label>
                                <p class="text-sm text-base-content">{{ transferRequest.manifest.shippingLine.brandName }}</p>
                            </div>
                            <div class="form-control">
                                <label class="label py-1"><span class="label-text font-medium text-base-content/70">BL Number</span></label>
                                <p class="text-sm text-base-content">{{ transferRequest.manifest.blNumber ?? 'N/A' }}</p>
                            </div>
                            <div class="form-control">
                                <label class="label py-1"><span class="label-text font-medium text-base-content/70">Workflow State</span></label>
                                <p class="text-sm text-base-content">{{ transferRequest.manifest.workflowState.displayName }}</p>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-base-300">
                            <a href="{{ path('consignee_manifest_detail', {id: transferRequest.manifest.id}) }}"
                               class="btn btn-ghost btn-sm gap-2 text-primary">
                                <span class="icon-[tabler--external-link] size-4"></span>
                                View Manifest Details
                            </a>
                        </div>
                    </div>
                </div>

                {# Transfer details #}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                        <div class="flex items-center gap-2">
                            <span class="icon-[tabler--arrows-exchange] size-5 text-base-content/70"></span>
                            <h2 class="card-title text-base sm:text-lg">Transfer Details</h2>
                        </div>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-5">

                        {# From / To brokers #}
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                            <div class="flex-1">
                                <p class="text-xs font-medium text-base-content/60 uppercase mb-2">
                                    {% if transferRequest.status == 'approved' %}Old Broker{% else %}Current Broker{% endif %}
                                </p>
                                <div class="bg-error/5 border border-error/20 rounded-xl p-4">
                                    <p class="text-sm font-semibold text-base-content">{{ transferRequest.oldBroker.fullName }}</p>
                                    <p class="text-xs text-base-content/60 mt-0.5">{{ transferRequest.oldBroker.email }}</p>
                                </div>
                            </div>
                            <div class="flex justify-center shrink-0">
                                <span class="icon-[tabler--arrow-right] size-6 text-primary"></span>
                            </div>
                            <div class="flex-1">
                                <p class="text-xs font-medium text-base-content/60 uppercase mb-2">
                                    {% if transferRequest.status == 'approved' %}Current Broker{% else %}New Broker{% endif %}
                                </p>
                                <div class="bg-success/5 border border-success/20 rounded-xl p-4">
                                    <p class="text-sm font-semibold text-base-content">{{ transferRequest.newBroker.fullName }}</p>
                                    <p class="text-xs text-base-content/60 mt-0.5">{{ transferRequest.newBroker.email }}</p>
                                </div>
                            </div>
                        </div>

                        {# Reason #}
                        <div class="form-control">
                            <label class="label py-1"><span class="label-text font-medium text-base-content/70">Reason for Transfer</span></label>
                            <div class="bg-base-200 rounded-lg p-4 border border-base-300">
                                <p class="text-sm text-base-content whitespace-pre-wrap leading-relaxed">{{ transferRequest.reason }}</p>
                            </div>
                        </div>

                        {# Transfer letter #}
                        <div class="form-control">
                            <label class="label py-1"><span class="label-text font-medium text-base-content/70">Transfer Letter</span></label>
                            {% if transferRequest.transferLetter %}
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 bg-primary/5 border border-primary/20 rounded-xl">
                                    <div class="flex items-center gap-3">
                                        <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                                            <span class="icon-[tabler--file-text] size-5 text-primary"></span>
                                        </div>
                                        <div>
                                            <p class="text-sm font-medium text-base-content">Transfer Letter Document</p>
                                            <p class="text-xs text-base-content/60">Uploaded by consignee</p>
                                        </div>
                                    </div>
                                    <a href="{{ transferRequest.transferLetter }}" target="_blank" rel="noopener"
                                       class="btn btn-outline btn-primary btn-sm gap-2 shrink-0">
                                        <span class="icon-[tabler--download] size-4"></span>
                                        Download
                                    </a>
                                </div>
                            {% else %}
                                <div class="bg-base-200 rounded-lg p-4 border border-base-300">
                                    <p class="text-sm text-base-content/50 italic">No transfer letter attached</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Rejection reason #}
                {% if transferRequest.status == 'rejected' and transferRequest.reviewNotes %}
                    <div class="alert alert-error">
                        <span class="icon-[tabler--alert-circle] size-5 shrink-0"></span>
                        <div>
                            <p class="font-medium">Rejection Reason</p>
                            <p class="text-sm mt-1 whitespace-pre-wrap">{{ transferRequest.reviewNotes }}</p>
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Sidebar #}
            <div class="space-y-5 sm:space-y-6">

                {# Request information #}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                        <div class="flex items-center gap-2">
                            <span class="icon-[tabler--info-circle] size-5 text-base-content/70"></span>
                            <h3 class="card-title text-base">Request Information</h3>
                        </div>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-4">
                        <div class="form-control">
                            <label class="label py-0"><span class="label-text text-xs font-medium text-base-content/60 uppercase">Requested By</span></label>
                            <p class="text-sm font-medium text-base-content">{{ transferRequest.consignee.businessName ?? transferRequest.consignee.email }}</p>
                            <p class="text-xs text-base-content/50">{{ transferRequest.consignee.email }}</p>
                        </div>
                        <div class="form-control">
                            <label class="label py-0"><span class="label-text text-xs font-medium text-base-content/60 uppercase">Requested Date</span></label>
                            <p class="text-sm text-base-content">{{ transferRequest.requestedAt|date('F d, Y') }}</p>
                            <p class="text-xs text-base-content/50">{{ transferRequest.requestedAt|date('g:i A') }}</p>
                        </div>
                        {% if transferRequest.reviewedAt %}
                            <div class="divider my-1"></div>
                            <div class="form-control">
                                <label class="label py-0"><span class="label-text text-xs font-medium text-base-content/60 uppercase">Reviewed By</span></label>
                                <p class="text-sm text-base-content">{{ transferRequest.reviewedBy.email }}</p>
                            </div>
                            <div class="form-control">
                                <label class="label py-0"><span class="label-text text-xs font-medium text-base-content/60 uppercase">Reviewed Date</span></label>
                                <p class="text-sm text-base-content">{{ transferRequest.reviewedAt|date('F d, Y') }}</p>
                                <p class="text-xs text-base-content/50">{{ transferRequest.reviewedAt|date('g:i A') }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Review actions #}
                {% if transferRequest.status == 'pending' %}
                    <div class="card bg-base-100 shadow-sm border border-warning/30">
                        <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                            <div class="flex items-center gap-2">
                                <span class="icon-[tabler--gavel] size-5 text-warning"></span>
                                <h3 class="card-title text-base">Review Actions</h3>
                            </div>
                        </div>
                        <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-2">
                            <button type="button" id="btrShowApproveBtn" class="btn btn-success w-full gap-2">
                                <span class="icon-[tabler--circle-check] size-4"></span>
                                Approve Transfer
                            </button>
                            <button type="button" id="btrShowRejectBtn" class="btn btn-outline btn-error w-full gap-2">
                                <span class="icon-[tabler--circle-x] size-4"></span>
                                Reject Transfer
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
{% endblock %}

{% block page_modals %}
{# Approve modal #}
<div id="btrApproveModal"
     class="hidden fixed inset-0 z-[999999] items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="btrApproveTitle">
    <div class="absolute inset-0 bg-black/60" data-btr-approve-dismiss></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <form method="POST" action="{{ path('admin_broker_transfer_approve', {id: transferRequest.id}) }}" id="btrApproveForm">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('approve_transfer') }}">
            <div class="p-5 sm:p-6 text-center">
                <div class="size-14 rounded-xl bg-success/10 flex items-center justify-center mx-auto mb-4">
                    <span class="icon-[tabler--circle-check] size-7 text-success"></span>
                </div>
                <h3 id="btrApproveTitle" class="text-lg font-bold text-base-content mb-2">Approve Transfer Request?</h3>
                <p class="text-sm text-base-content/70 mb-4">
                    This will immediately transfer manifest
                    <span class="font-semibold text-base-content">{{ transferRequest.manifest.manifestNumber }}</span>
                    from <span class="font-semibold text-base-content">{{ transferRequest.oldBroker.fullName }}</span>
                    to <span class="font-semibold text-base-content">{{ transferRequest.newBroker.fullName }}</span>.
                </p>
                <div class="alert alert-info text-left">
                    <span class="icon-[tabler--info-circle] size-5 shrink-0"></span>
                    <div class="text-sm">
                        <p class="font-medium mb-2">The following will happen:</p>
                        <ul class="space-y-1.5 list-none">
                            <li class="flex items-start gap-2"><span class="icon-[tabler--check] size-4 text-info shrink-0 mt-0.5"></span>Manifest broker will be changed</li>
                            <li class="flex items-start gap-2"><span class="icon-[tabler--check] size-4 text-info shrink-0 mt-0.5"></span>Consignee will be notified</li>
                            <li class="flex items-start gap-2"><span class="icon-[tabler--check] size-4 text-info shrink-0 mt-0.5"></span>New broker will be notified</li>
                            <li class="flex items-start gap-2"><span class="icon-[tabler--check] size-4 text-info shrink-0 mt-0.5"></span>Old broker will be notified</li>
                            <li class="flex items-start gap-2"><span class="icon-[tabler--check] size-4 text-info shrink-0 mt-0.5"></span>Activity & audit logs will be created</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="flex justify-end gap-2 px-5 py-4 border-t border-base-300">
                <button type="button" data-btr-approve-dismiss id="btrApproveCancelBtn" class="btn btn-ghost btn-sm">Cancel</button>
                <button type="submit" id="btrApproveSubmitBtn" class="btn btn-success btn-sm gap-2">
                    <span id="btrApproveButtonText">Yes, Approve Transfer</span>
                    <span id="btrApproveSpinner" class="loading loading-spinner loading-sm hidden"></span>
                </button>
            </div>
        </form>
    </div>
</div>

{# Reject modal #}
<div id="btrRejectModal"
     class="hidden fixed inset-0 z-[999999] items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="btrRejectTitle">
    <div class="absolute inset-0 bg-black/60" data-btr-reject-dismiss></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10" onclick="event.stopPropagation()">
        <form method="POST" action="{{ path('admin_broker_transfer_reject', {id: transferRequest.id}) }}" id="btrRejectForm">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('reject_transfer') }}">
            <div class="p-5 sm:p-6">
                <div class="text-center mb-4">
                    <div class="size-14 rounded-xl bg-error/10 flex items-center justify-center mx-auto mb-4">
                        <span class="icon-[tabler--circle-x] size-7 text-error"></span>
                    </div>
                    <h3 id="btrRejectTitle" class="text-lg font-bold text-base-content mb-2">Reject Transfer Request</h3>
                    <p class="text-sm text-base-content/70">
                        Please provide a detailed reason. The consignee will receive this explanation.
                    </p>
                </div>
                <div class="form-control">
                    <label class="label py-1" for="rejection_reason">
                        <span class="label-text font-medium">Rejection Reason <span class="text-error">*</span></span>
                    </label>
                    <textarea name="rejection_reason" id="rejection_reason" rows="4" required
                              class="textarea textarea-bordered w-full"
                              placeholder="Explain why this transfer request is being rejected..."></textarea>
                    <label class="label py-1"><span class="label-text-alt">Be specific and professional. This message will be sent to the consignee.</span></label>
                </div>
            </div>
            <div class="flex justify-end gap-2 px-5 py-4 border-t border-base-300">
                <button type="button" data-btr-reject-dismiss id="btrRejectCancelBtn" class="btn btn-ghost btn-sm">Cancel</button>
                <button type="submit" id="btrRejectSubmitBtn" class="btn btn-error btn-sm gap-2">
                    <span id="btrRejectButtonText">Reject Request</span>
                    <span id="btrRejectSpinner" class="loading loading-spinner loading-sm hidden"></span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    const approveModal = document.getElementById('btrApproveModal');
    const rejectModal = document.getElementById('btrRejectModal');

    function openModal(el) {
        el.classList.remove('hidden');
        el.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(el) {
        el.classList.add('hidden');
        el.classList.remove('flex');
        if (approveModal.classList.contains('hidden') && rejectModal.classList.contains('hidden')) {
            document.body.style.overflow = '';
        }
    }

    function resetApproveModal() {
        document.getElementById('btrApproveButtonText').textContent = 'Yes, Approve Transfer';
        document.getElementById('btrApproveSpinner').classList.add('hidden');
        document.getElementById('btrApproveSubmitBtn').disabled = false;
        document.getElementById('btrApproveCancelBtn').disabled = false;
    }

    function resetRejectModal() {
        document.getElementById('btrRejectButtonText').textContent = 'Reject Request';
        document.getElementById('btrRejectSpinner').classList.add('hidden');
        document.getElementById('btrRejectSubmitBtn').disabled = false;
        document.getElementById('btrRejectCancelBtn').disabled = false;
    }

    const showApproveBtn = document.getElementById('btrShowApproveBtn');
    const showRejectBtn = document.getElementById('btrShowRejectBtn');

    if (showApproveBtn) {
        showApproveBtn.addEventListener('click', function () {
            resetApproveModal();
            openModal(approveModal);
        });
    }

    if (showRejectBtn) {
        showRejectBtn.addEventListener('click', function () {
            resetRejectModal();
            openModal(rejectModal);
        });
    }

    document.querySelectorAll('[data-btr-approve-dismiss]').forEach(function (el) {
        el.addEventListener('click', function () {
            closeModal(approveModal);
            resetApproveModal();
        });
    });

    document.querySelectorAll('[data-btr-reject-dismiss]').forEach(function (el) {
        el.addEventListener('click', function () {
            closeModal(rejectModal);
            resetRejectModal();
        });
    });

    const approveForm = document.getElementById('btrApproveForm');
    if (approveForm) {
        approveForm.addEventListener('submit', function () {
            document.getElementById('btrApproveButtonText').textContent = 'Processing...';
            document.getElementById('btrApproveSpinner').classList.remove('hidden');
            document.getElementById('btrApproveSubmitBtn').disabled = true;
            document.getElementById('btrApproveCancelBtn').disabled = true;
        });
    }

    const rejectForm = document.getElementById('btrRejectForm');
    if (rejectForm) {
        rejectForm.addEventListener('submit', function () {
            document.getElementById('btrRejectButtonText').textContent = 'Processing...';
            document.getElementById('btrRejectSpinner').classList.remove('hidden');
            document.getElementById('btrRejectSubmitBtn').disabled = true;
            document.getElementById('btrRejectCancelBtn').disabled = true;
        });
    }

    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (!approveModal.classList.contains('hidden')) {
            closeModal(approveModal);
            resetApproveModal();
        } else if (!rejectModal.classList.contains('hidden')) {
            closeModal(rejectModal);
            resetRejectModal();
        }
    });
})();
</script>
{% endblock %}
