{% extends 'layout/admin_base.html.twig' %}

{% block title %}Broker Transfer Requests - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li>Broker Transfer Requests</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--arrows-exchange] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Broker Transfer Requests</h1>
                                <p class="text-sm text-base-content/60 mt-1">Review and manage broker transfer requests from consignees</p>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# Stats #}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-warning/10 text-warning rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--clock] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Pending</p>
                            <p class="text-2xl sm:text-3xl font-bold text-warning">{{ pendingRequests|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-success/10 text-success rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-check] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Approved</p>
                            <p class="text-2xl sm:text-3xl font-bold text-success">{{ approvedRequests|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-error/10 text-error rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-x] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Rejected</p>
                            <p class="text-2xl sm:text-3xl font-bold text-error">{{ rejectedRequests|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Tabbed requests #}
        <div class="card bg-base-100 shadow-sm overflow-hidden">
            <div class="card-body p-4 sm:p-5 border-b border-base-300">
                <div class="join flex-wrap" role="tablist" aria-label="Transfer request status">
                    <button type="button" class="btr-tab-btn btn btn-sm join-item btn-primary" data-tab="pending">
                        Pending
                        {% if pendingRequests|length > 0 %}
                            <span class="badge badge-warning badge-xs ml-1">{{ pendingRequests|length }}</span>
                        {% endif %}
                    </button>
                    <button type="button" class="btr-tab-btn btn btn-sm join-item btn-outline" data-tab="approved">
                        Approved
                        <span class="text-base-content/50 ml-1">({{ approvedRequests|length }})</span>
                    </button>
                    <button type="button" class="btr-tab-btn btn btn-sm join-item btn-outline" data-tab="rejected">
                        Rejected
                        <span class="text-base-content/50 ml-1">({{ rejectedRequests|length }})</span>
                    </button>
                </div>
            </div>

            {# Pending #}
            <div id="btr-content-pending" class="btr-tab-content">
                {% if pendingRequests|length > 0 %}
                    <div class="hidden md:block overflow-x-auto">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Manifest</th>
                                    <th>Consignee</th>
                                    <th>From Broker</th>
                                    <th>To Broker</th>
                                    <th>Requested</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for request in pendingRequests %}
                                    <tr class="hover">
                                        <td>
                                            <div class="font-medium text-base-content">{{ request.manifest.manifestNumber }}</div>
                                            <div class="text-xs text-base-content/50">{{ request.manifest.shippingLine.brandName }}</div>
                                        </td>
                                        <td class="text-sm">{{ request.consignee.businessName ?? request.consignee.email }}</td>
                                        <td>
                                            <div class="text-sm text-base-content">{{ request.oldBroker.fullName }}</div>
                                            <div class="text-xs text-base-content/50">{{ request.oldBroker.email }}</div>
                                        </td>
                                        <td>
                                            <div class="text-sm text-base-content">{{ request.newBroker.fullName }}</div>
                                            <div class="text-xs text-base-content/50">{{ request.newBroker.email }}</div>
                                        </td>
                                        <td class="text-sm text-base-content/60">{{ request.requestedAt|date('M d, Y') }}</td>
                                        <td class="text-right">
                                            <a href="{{ path('admin_broker_transfer_detail', {id: request.id}) }}" class="btn btn-primary btn-xs gap-1">
                                                <span class="icon-[tabler--eye] size-3.5"></span>
                                                Review
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="md:hidden p-4 space-y-3">
                        {% for request in pendingRequests %}
                            <div class="card bg-base-200 border border-base-300">
                                <div class="card-body p-4 space-y-3">
                                    <div class="flex items-start justify-between gap-2">
                                        <div>
                                            <p class="font-medium text-base-content">{{ request.manifest.manifestNumber }}</p>
                                            <p class="text-xs text-base-content/50">{{ request.manifest.shippingLine.brandName }}</p>
                                        </div>
                                        <span class="badge badge-warning badge-soft badge-sm">Pending</span>
                                    </div>
                                    <p class="text-sm text-base-content/70">{{ request.consignee.businessName ?? request.consignee.email }}</p>
                                    <div class="flex items-center gap-2 text-sm">
                                        <span class="text-base-content/60">{{ request.oldBroker.fullName }}</span>
                                        <span class="icon-[tabler--arrow-right] size-4 text-primary"></span>
                                        <span class="font-medium text-base-content">{{ request.newBroker.fullName }}</span>
                                    </div>
                                    <p class="text-xs text-base-content/50">{{ request.requestedAt|date('M d, Y') }}</p>
                                    <a href="{{ path('admin_broker_transfer_detail', {id: request.id}) }}" class="btn btn-primary btn-sm w-full gap-2">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        Review
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="flex flex-col items-center justify-center py-16 text-center px-4">
                        <span class="icon-[tabler--inbox] size-12 text-base-content/30"></span>
                        <h3 class="mt-4 text-base font-medium text-base-content">No pending requests</h3>
                        <p class="mt-2 text-sm text-base-content/60">All transfer requests have been reviewed.</p>
                    </div>
                {% endif %}
            </div>

            {# Approved #}
            <div id="btr-content-approved" class="btr-tab-content hidden">
                {% if approvedRequests|length > 0 %}
                    <div class="hidden md:block overflow-x-auto">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Manifest</th>
                                    <th>Consignee</th>
                                    <th>Transfer</th>
                                    <th>Reviewed By</th>
                                    <th>Date</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for request in approvedRequests %}
                                    <tr class="hover">
                                        <td class="font-medium text-base-content">{{ request.manifest.manifestNumber }}</td>
                                        <td class="text-sm">{{ request.consignee.businessName ?? request.consignee.email }}</td>
                                        <td>
                                            <div class="text-xs text-base-content/50">{{ request.oldBroker.fullName }} →</div>
                                            <div class="text-sm text-base-content">{{ request.newBroker.fullName }}</div>
                                        </td>
                                        <td class="text-sm text-base-content/70">{{ request.reviewedBy.email }}</td>
                                        <td class="text-sm text-base-content/60">{{ request.reviewedAt|date('M d, Y') }}</td>
                                        <td class="text-right">
                                            <a href="{{ path('admin_broker_transfer_detail', {id: request.id}) }}" class="btn btn-ghost btn-xs gap-1">
                                                <span class="icon-[tabler--eye] size-3.5"></span>
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="md:hidden p-4 space-y-3">
                        {% for request in approvedRequests %}
                            <div class="card bg-base-200 border border-base-300">
                                <div class="card-body p-4 space-y-3">
                                    <div class="flex items-start justify-between gap-2">
                                        <p class="font-medium text-base-content">{{ request.manifest.manifestNumber }}</p>
                                        <span class="badge badge-success badge-soft badge-sm">Approved</span>
                                    </div>
                                    <p class="text-sm text-base-content/70">{{ request.consignee.businessName ?? request.consignee.email }}</p>
                                    <div class="flex items-center gap-2 text-sm">
                                        <span class="text-base-content/60">{{ request.oldBroker.fullName }}</span>
                                        <span class="icon-[tabler--arrow-right] size-4 text-success"></span>
                                        <span class="font-medium text-base-content">{{ request.newBroker.fullName }}</span>
                                    </div>
                                    <p class="text-xs text-base-content/50">Reviewed by {{ request.reviewedBy.email }} · {{ request.reviewedAt|date('M d, Y') }}</p>
                                    <a href="{{ path('admin_broker_transfer_detail', {id: request.id}) }}" class="btn btn-outline btn-sm w-full gap-2">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        View
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="flex flex-col items-center justify-center py-16 text-center px-4">
                        <span class="icon-[tabler--circle-check] size-12 text-base-content/30"></span>
                        <h3 class="mt-4 text-base font-medium text-base-content">No approved requests</h3>
                        <p class="mt-2 text-sm text-base-content/60">Approved transfer requests will appear here.</p>
                    </div>
                {% endif %}
            </div>

            {# Rejected #}
            <div id="btr-content-rejected" class="btr-tab-content hidden">
                {% if rejectedRequests|length > 0 %}
                    <div class="hidden md:block overflow-x-auto">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Manifest</th>
                                    <th>Consignee</th>
                                    <th>Transfer</th>
                                    <th>Reviewed By</th>
                                    <th>Date</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for request in rejectedRequests %}
                                    <tr class="hover">
                                        <td class="font-medium text-base-content">{{ request.manifest.manifestNumber }}</td>
                                        <td class="text-sm">{{ request.consignee.businessName ?? request.consignee.email }}</td>
                                        <td>
                                            <div class="text-xs text-base-content/50">{{ request.oldBroker.fullName }} →</div>
                                            <div class="text-sm text-base-content">{{ request.newBroker.fullName }}</div>
                                        </td>
                                        <td class="text-sm text-base-content/70">{{ request.reviewedBy.email }}</td>
                                        <td class="text-sm text-base-content/60">{{ request.reviewedAt|date('M d, Y') }}</td>
                                        <td class="text-right">
                                            <a href="{{ path('admin_broker_transfer_detail', {id: request.id}) }}" class="btn btn-ghost btn-xs gap-1">
                                                <span class="icon-[tabler--eye] size-3.5"></span>
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="md:hidden p-4 space-y-3">
                        {% for request in rejectedRequests %}
                            <div class="card bg-base-200 border border-base-300">
                                <div class="card-body p-4 space-y-3">
                                    <div class="flex items-start justify-between gap-2">
                                        <p class="font-medium text-base-content">{{ request.manifest.manifestNumber }}</p>
                                        <span class="badge badge-error badge-soft badge-sm">Rejected</span>
                                    </div>
                                    <p class="text-sm text-base-content/70">{{ request.consignee.businessName ?? request.consignee.email }}</p>
                                    <div class="flex items-center gap-2 text-sm">
                                        <span class="text-base-content/60">{{ request.oldBroker.fullName }}</span>
                                        <span class="icon-[tabler--arrow-right] size-4 text-error"></span>
                                        <span class="font-medium text-base-content">{{ request.newBroker.fullName }}</span>
                                    </div>
                                    <p class="text-xs text-base-content/50">Reviewed by {{ request.reviewedBy.email }} · {{ request.reviewedAt|date('M d, Y') }}</p>
                                    <a href="{{ path('admin_broker_transfer_detail', {id: request.id}) }}" class="btn btn-outline btn-sm w-full gap-2">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        View
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="flex flex-col items-center justify-center py-16 text-center px-4">
                        <span class="icon-[tabler--circle-x] size-12 text-base-content/30"></span>
                        <h3 class="mt-4 text-base font-medium text-base-content">No rejected requests</h3>
                        <p class="mt-2 text-sm text-base-content/60">Rejected transfer requests will appear here.</p>
                    </div>
                {% endif %}
            </div>
        </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    function showTab(tabName) {
        document.querySelectorAll('.btr-tab-content').forEach(function (el) {
            el.classList.add('hidden');
        });
        document.querySelectorAll('.btr-tab-btn').forEach(function (btn) {
            const active = btn.dataset.tab === tabName;
            btn.classList.toggle('btn-primary', active);
            btn.classList.toggle('btn-outline', !active);
        });
        const content = document.getElementById('btr-content-' + tabName);
        if (content) content.classList.remove('hidden');
    }

    document.querySelectorAll('.btr-tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            showTab(this.dataset.tab);
        });
    });
})();
</script>
{% endblock %}
