{% extends 'layout/admin_base.html.twig' %}

{% block title %}Branding Configuration - {{ shipping_line.brandName }}{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li><a href="{{ path('admin_shipping_lines_list') }}">Shipping Lines</a></li>
        <li><a href="{{ path('admin_shipping_line_configuration_index', {id: shipping_line.id}) }}">{{ shipping_line.brandName }}</a></li>
        <li>Branding</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="card bg-base-100 shadow-sm">
    <div class="card-body">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
                <h1 class="card-title text-xl sm:text-2xl">
                    <span class="icon-[tabler--palette] size-6"></span>
                    Branding Configuration
                </h1>
                <p class="text-sm text-base-content/70 mt-1">{{ shipping_line.brandName }}</p>
            </div>
            <a href="{{ path('admin_shipping_line_configuration_index', {id: shipping_line.id}) }}"
               class="btn btn-ghost btn-sm">
                <span class="icon-[tabler--arrow-left] size-4"></span>
                Back
            </a>
        </div>

        <form method="POST">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label for="company_name" class="label py-1"><span class="label-text font-medium">Company Name</span></label>
                            <input type="text" id="company_name" name="company_name" class="input input-bordered w-full"
                                   value="{{ branding.companyName ?? shipping_line.brandName }}">
                        </div>
                        <div class="form-control">
                            <label for="tagline" class="label py-1"><span class="label-text font-medium">Tagline</span></label>
                            <input type="text" id="tagline" name="tagline" class="input input-bordered w-full"
                                   value="{{ branding.tagline ?? '' }}">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label for="primary_color" class="label py-1"><span class="label-text font-medium">Primary Color</span></label>
                            <div class="flex gap-2">
                                <input type="color" id="primary_color" name="primary_color" class="w-14 h-12 rounded-lg border border-base-300"
                                       value="{{ branding.primaryColor ?? '#007bff' }}">
                                <input type="text" id="primary_color_text" class="input input-bordered flex-1 font-mono text-sm"
                                       value="{{ branding.primaryColor ?? '#007bff' }}">
                            </div>
                        </div>
                        <div class="form-control">
                            <label for="secondary_color" class="label py-1"><span class="label-text font-medium">Secondary Color</span></label>
                            <div class="flex gap-2">
                                <input type="color" id="secondary_color" name="secondary_color" class="w-14 h-12 rounded-lg border border-base-300"
                                       value="{{ branding.secondaryColor ?? '#6c757d' }}">
                                <input type="text" id="secondary_color_text" class="input input-bordered flex-1 font-mono text-sm"
                                       value="{{ branding.secondaryColor ?? '#6c757d' }}">
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label for="logo_url" class="label py-1"><span class="label-text font-medium">Logo URL</span></label>
                            <input type="url" id="logo_url" name="logo_url" class="input input-bordered w-full"
                                   value="{{ branding.logoUrl ?? '' }}" placeholder="https://...">
                        </div>
                        <div class="form-control">
                            <label for="favicon_url" class="label py-1"><span class="label-text font-medium">Favicon URL</span></label>
                            <input type="url" id="favicon_url" name="favicon_url" class="input input-bordered w-full"
                                   value="{{ branding.faviconUrl ?? '' }}" placeholder="https://...">
                        </div>
                    </div>
                </div>

                <div class="card bg-base-200">
                    <div class="card-body p-4">
                        <h3 class="font-semibold text-sm mb-4">Live Preview</h3>
                        <div id="preview-header" class="rounded-lg bg-base-100 p-4 border-l-4 border-primary">
                            <div class="flex items-center gap-3">
                                <img id="preview-logo"
                                     src="{{ branding.logoUrl ?? asset('images/optimus.jpg') }}"
                                     alt="Logo preview"
                                     class="h-10 w-auto max-w-[80px] object-contain"
                                     onerror="this.classList.add('hidden')">
                                <div>
                                    <p class="font-semibold" id="preview-company-name">{{ branding.companyName ?? shipping_line.brandName }}</p>
                                    <p class="text-xs text-base-content/60" id="preview-tagline">{{ branding.tagline ?? 'Your shipping partner' }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2 mt-4">
                            <button type="button" id="preview-primary-btn" class="btn btn-sm text-white">Primary</button>
                            <button type="button" id="preview-secondary-btn" class="btn btn-sm text-white">Secondary</button>
                        </div>
                        <div class="card bg-base-100 mt-4 overflow-hidden">
                            <div id="preview-card-header" class="px-3 py-2 text-sm font-medium text-white">Sample Header</div>
                            <div class="p-3 text-sm text-base-content/70">Portal preview with your selected colors.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-base-300">
                <button type="submit" class="btn btn-primary">
                    <span class="icon-[tabler--device-floppy] size-4"></span>
                    Save Branding
                </button>
                <button type="button" class="btn btn-ghost" onclick="resetToDefaults()">
                    <span class="icon-[tabler--refresh] size-4"></span>
                    Reset to Defaults
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
const defaultBrandName = {{ shipping_line.brandName|json_encode|raw }};

function updatePreview() {
    const companyName = document.getElementById('company_name').value || defaultBrandName;
    const tagline = document.getElementById('tagline').value || 'Your shipping partner';
    const primaryColor = document.getElementById('primary_color').value;
    const secondaryColor = document.getElementById('secondary_color').value;
    const logoUrl = document.getElementById('logo_url').value;

    document.getElementById('preview-company-name').textContent = companyName;
    document.getElementById('preview-tagline').textContent = tagline;

    const logo = document.getElementById('preview-logo');
    if (logoUrl) {
        logo.src = logoUrl;
        logo.classList.remove('hidden');
    } else {
        logo.classList.add('hidden');
    }

    document.getElementById('preview-primary-btn').style.backgroundColor = primaryColor;
    document.getElementById('preview-secondary-btn').style.backgroundColor = secondaryColor;
    document.getElementById('preview-card-header').style.backgroundColor = primaryColor;
    document.getElementById('preview-header').style.borderLeftColor = primaryColor;
}

function syncColorInputs(colorId, textId) {
    const color = document.getElementById(colorId);
    const text = document.getElementById(textId);

    color.addEventListener('input', () => {
        text.value = color.value;
        updatePreview();
    });

    text.addEventListener('input', () => {
        if (/^#[0-9A-Fa-f]{6}$/.test(text.value)) {
            color.value = text.value;
            updatePreview();
        }
    });
}

function resetToDefaults() {
    document.getElementById('company_name').value = defaultBrandName;
    document.getElementById('tagline').value = '';
    document.getElementById('primary_color').value = '#007bff';
    document.getElementById('primary_color_text').value = '#007bff';
    document.getElementById('secondary_color').value = '#6c757d';
    document.getElementById('secondary_color_text').value = '#6c757d';
    document.getElementById('logo_url').value = '';
    document.getElementById('favicon_url').value = '';
    updatePreview();
}

document.addEventListener('DOMContentLoaded', () => {
    syncColorInputs('primary_color', 'primary_color_text');
    syncColorInputs('secondary_color', 'secondary_color_text');
    ['company_name', 'tagline', 'logo_url'].forEach(id => {
        document.getElementById(id).addEventListener('input', updatePreview);
    });
    updatePreview();
});
</script>
{% endblock %}
