{% extends 'layout/admin_base.html.twig' %}

{% block title %}Create Configuration - {{ shipping_line.brandName }}{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li><a href="{{ path('admin_shipping_lines_list') }}">Shipping Lines</a></li>
        <li><a href="{{ path('admin_shipping_line_configuration_index', {id: shipping_line.id}) }}">{{ shipping_line.brandName }}</a></li>
        <li>Create Configuration</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="card bg-base-100 shadow-sm">
    <div class="card-body">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
                <h1 class="card-title text-xl sm:text-2xl">
                    <span class="icon-[tabler--plus] size-6"></span>
                    Create Configuration
                </h1>
                <p class="text-sm text-base-content/70 mt-1">{{ shipping_line.brandName }}</p>
            </div>
            <a href="{{ path('admin_shipping_line_configuration_index', {id: shipping_line.id}) }}"
               class="btn btn-ghost btn-sm">
                <span class="icon-[tabler--arrow-left] size-4"></span>
                Back
            </a>
        </div>

        <form method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-control">
                    <label for="config_key" class="label py-1">
                        <span class="label-text font-medium">Configuration Key <span class="text-error">*</span></span>
                    </label>
                    <input type="text"
                           id="config_key"
                           name="config_key"
                           required
                           class="input input-bordered w-full"
                           placeholder="portal_theme">
                    <label class="label py-1">
                        <span class="label-text-alt">e.g. portal_theme, notification_settings</span>
                    </label>
                </div>
                <div class="form-control">
                    <label for="description" class="label py-1">
                        <span class="label-text font-medium">Description</span>
                    </label>
                    <input type="text"
                           id="description"
                           name="description"
                           class="input input-bordered w-full"
                           placeholder="Optional description">
                </div>
            </div>

            <div class="form-control">
                <label for="config_value" class="label py-1">
                    <span class="label-text font-medium">Configuration Value (JSON) <span class="text-error">*</span></span>
                </label>
                <textarea id="config_value"
                          name="config_value"
                          rows="12"
                          required
                          class="textarea textarea-bordered font-mono text-sm w-full"
                          placeholder='{"primaryColor": "#007bff"}'></textarea>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="card bg-base-200">
                    <div class="card-body p-4">
                        <h3 class="font-semibold text-sm mb-3">Templates</h3>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-soft" onclick="loadTemplate('portal_theme')">Portal Theme</button>
                            <button type="button" class="btn btn-sm btn-soft" onclick="loadTemplate('notification_settings')">Notifications</button>
                            <button type="button" class="btn btn-sm btn-soft" onclick="loadTemplate('security_settings')">Security</button>
                            <button type="button" class="btn btn-sm btn-soft" onclick="loadTemplate('feature_flags')">Feature Flags</button>
                        </div>
                    </div>
                </div>
                <div class="card bg-base-200">
                    <div class="card-body p-4">
                        <h3 class="font-semibold text-sm mb-3">JSON Validation</h3>
                        <div id="json-validation" class="alert alert-info text-sm">
                            <span class="icon-[tabler--info-circle] size-4"></span>
                            Enter JSON to validate
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap gap-2 pt-2">
                <button type="submit" class="btn btn-primary">
                    <span class="icon-[tabler--device-floppy] size-4"></span>
                    Create Configuration
                </button>
                <a href="{{ path('admin_shipping_line_configuration_index', {id: shipping_line.id}) }}"
                   class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
const templates = {
    portal_theme: {
        key: 'portal_theme',
        value: {
            primaryColor: '#007bff',
            secondaryColor: '#6c757d',
            logoUrl: null,
            faviconUrl: null
        }
    },
    notification_settings: {
        key: 'notification_settings',
        value: {
            emailNotifications: true,
            smsNotifications: false,
            pushNotifications: true
        }
    },
    security_settings: {
        key: 'security_settings',
        value: {
            sessionTimeout: 1800,
            maxLoginAttempts: 5,
            passwordExpiry: 90
        }
    },
    feature_flags: {
        key: 'feature_flags',
        value: {
            enableAdvancedReporting: true,
            enableBulkOperations: true,
            enableApiAccess: false
        }
    }
};

function loadTemplate(templateName) {
    const template = templates[templateName];
    if (!template) {
        return;
    }
    document.getElementById('config_key').value = template.key;
    document.getElementById('config_value').value = JSON.stringify(template.value, null, 2);
    validateJson();
}

function validateJson() {
    const textarea = document.getElementById('config_value');
    const validation = document.getElementById('json-validation');

    try {
        const value = textarea.value.trim();
        if (!value) {
            validation.className = 'alert alert-info text-sm';
            validation.innerHTML = '<span class="icon-[tabler--info-circle] size-4"></span> Enter JSON to validate';
            return;
        }

        JSON.parse(value);
        validation.className = 'alert alert-success text-sm';
        validation.innerHTML = '<span class="icon-[tabler--circle-check] size-4"></span> Valid JSON';
    } catch (e) {
        validation.className = 'alert alert-error text-sm';
        validation.innerHTML = '<span class="icon-[tabler--alert-circle] size-4"></span> Invalid JSON: ' + e.message;
    }
}

document.getElementById('config_value').addEventListener('input', validateJson);
</script>
{% endblock %}
