{% extends 'layout/admin_base.html.twig' %}

{% block title %}Configuration - {{ shipping_line.brandName }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-cog"></i>
                        Configuration - {{ shipping_line.brandName }}
                    </h3>
                    <div class="btn-group">
                        <a href="{{ path('admin_shipping_line_configuration_create', {id: shipping_line.id}) }}" 
                           class="btn btn-primary">
                            <i class="fas fa-plus"></i> Add Configuration
                        </a>
                        <a href="{{ path('admin_shipping_line_branding', {id: shipping_line.id}) }}" 
                           class="btn btn-info">
                            <i class="fas fa-palette"></i> Branding
                        </a>
                        <a href="{{ path('admin_shipping_line_configuration_history', {id: shipping_line.id}) }}" 
                           class="btn btn-secondary">
                            <i class="fas fa-history"></i> History
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {% if configurations is empty %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            No configurations found. <a href="{{ path('admin_shipping_line_configuration_create', {id: shipping_line.id}) }}">Create your first configuration</a>.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Configuration Key</th>
                                        <th>Description</th>
                                        <th>Status</th>
                                        <th>Last Updated</th>
                                        <th>Updated By</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for config in configurations %}
                                        <tr>
                                            <td>
                                                <strong>{{ config.configKey }}</strong>
                                            </td>
                                            <td>{{ config.description ?? 'No description' }}</td>
                                            <td>
                                                {% if config.isActive %}
                                                    <span class="badge badge-success">Active</span>
                                                {% else %}
                                                    <span class="badge badge-secondary">Inactive</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ config.updatedAt|date('Y-m-d H:i:s') }}</td>
                                            <td>{{ config.updatedBy ? config.updatedBy.email : config.createdBy.email }}</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-info" 
                                                            onclick="viewConfiguration('{{ config.configKey }}', {{ config.configValue|json_encode|e('html_attr') }})">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <a href="{{ path('admin_shipping_line_configuration_edit', {id: shipping_line.id, configKey: config.configKey}) }}" 
                                                       class="btn btn-warning">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-danger" 
                                                            onclick="deleteConfiguration('{{ config.configKey }}')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Configuration View Modal -->
<div class="modal fade" id="configViewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Configuration Details</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label><strong>Configuration Key:</strong></label>
                    <p id="configKey"></p>
                </div>
                <div class="form-group">
                    <label><strong>Configuration Value:</strong></label>
                    <pre id="configValue" class="bg-light p-3 rounded"></pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function viewConfiguration(key, value) {
    document.getElementById('configKey').textContent = key;
    document.getElementById('configValue').textContent = JSON.stringify(value, null, 2);
    $('#configViewModal').modal('show');
}

function deleteConfiguration(configKey) {
    if (confirm('Are you sure you want to delete this configuration?')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/shipping-line-configuration/${shipping_line.id}/delete/${configKey}`;
        
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = '{{ csrf_token('delete_configuration') }}';
        form.appendChild(tokenInput);
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}