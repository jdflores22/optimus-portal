            <h3 class="text-lg font-medium text-gray-900">Reject EDO Payment</h3>
            <button onclick="closeRejectPaymentModal()" class="text-gray-400 hover:text-gray-500">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <form id="rejectPaymentForm" onsubmit="submitPaymentRejection(event)">
            <input type="hidden" id="rejectPaymentId">
            <div class="mb-4">
                <label for="paymentRejectionReason" class="block text-sm font-medium text-gray-700 mb-2">
                    Rejection Reason <span class="text-red-500">*</span>
                </label>
                <textarea id="paymentRejectionReason" 
                          rows="4" 
                          required
                          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
