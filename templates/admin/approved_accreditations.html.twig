{% extends 'layout/admin_base.html.twig' %}

{% block title %}Approved Accreditations - OPTIMUS{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li>Approved Accreditations</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-success/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--circle-check] size-6 text-success"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Approved Accreditations</h1>
                                <p class="text-sm text-base-content/60 mt-1">Complete overview of all approved broker and consignee applications</p>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# Summary statistics #}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-success/10 text-success rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-check] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Total Approved</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ totalApproved }}</p>
                            <p class="text-xs text-success font-medium mt-0.5">All accreditations</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--briefcase] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Approved Brokers</p>
                            <p class="text-2xl sm:text-3xl font-bold text-primary">{{ brokers|length }}</p>
                            <p class="text-xs text-primary/80 font-medium mt-0.5">Active brokers</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="size-10 sm:size-12 bg-secondary/10 text-secondary rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--building] size-5 sm:size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm text-base-content/70">Approved Consignees</p>
                            <p class="text-2xl sm:text-3xl font-bold text-secondary">{{ consignees|length }}</p>
                            <p class="text-xs text-secondary/80 font-medium mt-0.5">Active consignees</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Distribution chart #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                <div class="flex items-center gap-2">
                    <span class="icon-[tabler--chart-pie] size-5 text-base-content/70"></span>
                    <div>
                        <h3 class="card-title text-base sm:text-lg">Accreditation Distribution</h3>
                        <p class="text-sm text-base-content/60 mt-1">Breakdown of approved applications by type</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 sm:p-6">
                <div id="accreditationChart" class="min-h-[300px]"></div>
            </div>
        </div>

        {# Approved brokers #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                <div class="flex items-center gap-2">
                    <span class="icon-[tabler--briefcase] size-5 text-primary"></span>
                    <div>
                        <h3 class="card-title text-base sm:text-lg">Approved Brokers</h3>
                        <p class="text-sm text-base-content/60 mt-1">Broker applications with final approval</p>
                    </div>
                </div>
                <span class="badge badge-primary badge-soft">{{ brokers|length }} broker{{ brokers|length != 1 ? 's' : '' }}</span>
            </div>
            <div class="card-body p-4 sm:p-6 pt-2 sm:pt-3">
                {% if brokers|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                        {% for broker in brokers %}
                            <div class="card bg-base-200 border border-base-300 hover:shadow-md transition-shadow">
                                <div class="card-body p-4">
                                    <div class="flex items-center justify-between gap-2 mb-3">
                                        <span class="badge badge-success badge-soft gap-1">
                                            <span class="size-1.5 rounded-full bg-success"></span>
                                            Approved Broker
                                        </span>
                                        <span class="text-xs text-base-content/50 shrink-0">{{ broker.approvedAt|date('M j, Y') }}</span>
                                    </div>

                                    <div class="flex items-start gap-3 mb-4">
                                        <div class="size-10 rounded-full {{ avatar_colors(broker.applicant) }} flex items-center justify-center shrink-0">
                                            <span class="text-sm font-semibold">{{ broker.applicant.email|slice(0, 1)|upper }}</span>
                                        </div>
                                        <div class="min-w-0">
                                            <h4 class="text-sm font-semibold text-base-content break-words">{{ broker.applicant.email }}</h4>
                                            {% if broker.applicant.fullName %}
                                                <p class="text-xs text-base-content/60 mt-0.5">{{ broker.applicant.fullName }}</p>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <dl class="space-y-2 text-xs text-base-content/70 mb-4">
                                        <div class="flex justify-between gap-2">
                                            <dt>Submitted</dt>
                                            <dd class="font-medium text-base-content">{{ broker.submittedAt|date('M j, Y') }}</dd>
                                        </div>
                                        {% if broker.evaluator %}
                                            <div class="flex justify-between gap-2">
                                                <dt>Evaluated by</dt>
                                                <dd class="font-medium text-base-content text-right truncate max-w-[60%]" title="{{ broker.evaluator.email }}">
                                                    {{ broker.evaluator.email }}
                                                </dd>
                                            </div>
                                        {% endif %}
                                    </dl>

                                    <a href="{{ path('app_admin_application_detail', {id: broker.id}) }}"
                                       class="btn btn-outline btn-primary btn-sm w-full gap-2">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        View Details
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="flex flex-col items-center justify-center py-16 text-center">
                        <span class="icon-[tabler--briefcase-off] size-12 text-base-content/30"></span>
                        <h3 class="mt-4 text-base font-medium text-base-content">No approved brokers</h3>
                        <p class="mt-2 text-sm text-base-content/60">Approved broker applications will appear here.</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Approved consignees #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                <div class="flex items-center gap-2">
                    <span class="icon-[tabler--building] size-5 text-secondary"></span>
                    <div>
                        <h3 class="card-title text-base sm:text-lg">Approved Consignees</h3>
                        <p class="text-sm text-base-content/60 mt-1">Consignee applications with final approval</p>
                    </div>
                </div>
                <span class="badge badge-secondary badge-soft">{{ consignees|length }} consignee{{ consignees|length != 1 ? 's' : '' }}</span>
            </div>
            <div class="card-body p-4 sm:p-6 pt-2 sm:pt-3">
                {% if consignees|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                        {% for consignee in consignees %}
                            <div class="card bg-base-200 border border-base-300 hover:shadow-md transition-shadow">
                                <div class="card-body p-4">
                                    <div class="flex items-center justify-between gap-2 mb-3">
                                        <span class="badge badge-success badge-soft gap-1">
                                            <span class="size-1.5 rounded-full bg-success"></span>
                                            Approved Consignee
                                        </span>
                                        <span class="text-xs text-base-content/50 shrink-0">{{ consignee.approvedAt|date('M j, Y') }}</span>
                                    </div>

                                    <div class="flex items-start gap-3 mb-4">
                                        <div class="size-10 rounded-full {{ avatar_colors(consignee.applicant) }} flex items-center justify-center shrink-0">
                                            <span class="text-sm font-semibold">{{ consignee.applicant.email|slice(0, 1)|upper }}</span>
                                        </div>
                                        <div class="min-w-0">
                                            <h4 class="text-sm font-semibold text-base-content break-words">{{ consignee.applicant.email }}</h4>
                                            {% if consignee.applicant.businessName is defined and consignee.applicant.businessName %}
                                                <p class="text-xs text-base-content/60 mt-0.5">{{ consignee.applicant.businessName }}</p>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <dl class="space-y-2 text-xs text-base-content/70 mb-4">
                                        <div class="flex justify-between gap-2">
                                            <dt>Submitted</dt>
                                            <dd class="font-medium text-base-content">{{ consignee.submittedAt|date('M j, Y') }}</dd>
                                        </div>
                                        {% if consignee.evaluator %}
                                            <div class="flex justify-between gap-2">
                                                <dt>Evaluated by</dt>
                                                <dd class="font-medium text-base-content text-right truncate max-w-[60%]" title="{{ consignee.evaluator.email }}">
                                                    {{ consignee.evaluator.email }}
                                                </dd>
                                            </div>
                                        {% endif %}
                                    </dl>

                                    <a href="{{ path('app_admin_application_detail', {id: consignee.id}) }}"
                                       class="btn btn-outline btn-secondary btn-sm w-full gap-2">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        View Details
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="flex flex-col items-center justify-center py-16 text-center">
                        <span class="icon-[tabler--building-off] size-12 text-base-content/30"></span>
                        <h3 class="mt-4 text-base font-medium text-base-content">No approved consignees</h3>
                        <p class="mt-2 text-sm text-base-content/60">Approved consignee applications will appear here.</p>
                    </div>
                {% endif %}
            </div>
        </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const chartEl = document.getElementById('accreditationChart');
    if (!chartEl) return;

    const brokersCount = {{ brokers|length }};
    const consigneesCount = {{ consignees|length }};
    const totalCount = brokersCount + consigneesCount;

    const emptyStateHtml = `
        <div class="flex flex-col items-center justify-center py-12 text-base-content/40">
            <span class="icon-[tabler--chart-pie-off] size-16 mb-4"></span>
            <p class="text-sm font-medium text-base-content/60">No data to display</p>
            <p class="text-xs text-base-content/40 mt-1">Chart will appear when applications are approved</p>
        </div>`;

    const errorStateHtml = `
        <div class="flex flex-col items-center justify-center py-12 text-base-content/40">
            <span class="icon-[tabler--alert-circle] size-16 mb-4 text-error/60"></span>
            <p class="text-sm font-medium text-base-content/60">Unable to load chart</p>
        </div>`;

    if (totalCount === 0) {
        chartEl.innerHTML = emptyStateHtml;
        return;
    }

    try {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark'
            || document.documentElement.getAttribute('data-theme') === 'claude';

        const chartOptions = {
            series: [brokersCount, consigneesCount],
            chart: {
                type: 'donut',
                height: 300,
                fontFamily: 'Inter, system-ui, sans-serif',
                foreColor: isDark ? '#a3a3a3' : '#6b7280',
            },
            labels: ['Brokers', 'Consignees'],
            colors: ['#570df8', '#f000b8'],
            plotOptions: {
                pie: {
                    donut: {
                        size: '70%',
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: 'Total Approved',
                                fontSize: '14px',
                                fontWeight: 600,
                                formatter: function () {
                                    return totalCount;
                                }
                            }
                        }
                    }
                }
            },
            dataLabels: {
                enabled: true,
                formatter: function (val, opts) {
                    return opts.w.config.series[opts.seriesIndex];
                },
                style: {
                    fontSize: '13px',
                    fontWeight: 'bold',
                    colors: ['#ffffff']
                }
            },
            legend: {
                position: 'bottom',
                fontSize: '13px',
                fontWeight: 500,
            },
            stroke: {
                width: 2,
                colors: [isDark ? '#1d232a' : '#ffffff']
            },
            tooltip: {
                y: {
                    formatter: function (val) {
                        return val + ' approved';
                    }
                }
            }
        };

        new ApexCharts(chartEl, chartOptions).render();
    } catch (error) {
        console.error('Error rendering accreditation chart:', error);
        chartEl.innerHTML = errorStateHtml;
    }
});
</script>
{% endblock %}
