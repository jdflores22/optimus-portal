{% extends 'base.html.twig' %}

{% block title %}Approved Accreditations - OPTIMUS{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="py-6">
                <h1 class="text-3xl font-bold text-gray-900">Approved Accreditations</h1>
                <p class="mt-2 text-gray-600">Complete overview of all approved broker and consignee applications</p>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg">
                {{ message }}
            </div>
        {% endfor %}

        <!-- Summary Statistics -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Total Approved -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total Approved</p>
                        <p class="text-3xl font-bold text-gray-900">{{ totalApproved }}</p>
                        <p class="text-xs text-green-600 font-medium">All accreditations</p>
                    </div>
                </div>
            </div>

            <!-- Approved Brokers -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6M8 8v10l4-2 4 2V8"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Approved Brokers</p>
                        <p class="text-3xl font-bold text-gray-900">{{ brokers|length }}</p>
                        <p class="text-xs text-blue-600 font-medium">Active brokers</p>
                    </div>
                </div>
            </div>

            <!-- Approved Consignees -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Approved Consignees</p>
                        <p class="text-3xl font-bold text-gray-900">{{ consignees|length }}</p>
                        <p class="text-xs text-purple-600 font-medium">Active consignees</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribution Chart -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-8">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Accreditation Distribution</h3>
                <p class="text-sm text-gray-500">Breakdown of approved applications by type</p>
            </div>
            <div class="p-6">
                <div id="accreditationChart" style="height: 300px;"></div>
            </div>
        </div>

        <!-- Approved Brokers Section -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-8">
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                <h3 class="text-lg font-medium text-gray-900">Approved Brokers</h3>
                <span class="text-sm text-gray-500">{{ brokers|length }} broker{{ brokers|length != 1 ? 's' : '' }}</span>
            </div>
            <div class="p-6">
                {% if brokers|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for broker in brokers %}
                            <div class="bg-gray-50 rounded-lg p-4 hover:bg-gray-100 transition-colors">
                                <div class="flex items-center justify-between mb-3">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <div class="w-2 h-2 bg-green-400 rounded-full mr-1"></div>
                                        Approved Broker
                                    </span>
                                    <span class="text-xs text-gray-500">{{ broker.approvedAt|date('M j, Y') }}</span>
                                </div>
                                
                                <div class="mb-4">
                                    <h4 class="text-sm font-medium text-gray-900 mb-1 break-words">{{ broker.applicant.email }}</h4>
                                    {% if broker.applicant.fullName %}
                                        <p class="text-xs text-gray-600">{{ broker.applicant.fullName }}</p>
                                    {% endif %}
                                </div>

                                <div class="space-y-2 text-xs text-gray-600 mb-4">
                                    <div class="flex justify-between">
                                        <span>Submitted:</span>
                                        <span class="font-medium">{{ broker.submittedAt|date('M j, Y') }}</span>
                                    </div>
                                    {% if broker.evaluator %}
                                        <div class="flex justify-between">
                                            <span>Evaluated by:</span>
                                            <span class="font-medium text-right">{{ broker.evaluator.email|slice(0, 20) }}{{ broker.evaluator.email|length > 20 ? '...' : '' }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                <a href="{{ path('app_admin_application_detail', {id: broker.id}) }}" 
                                   class="inline-flex items-center justify-center w-full px-3 py-2 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-md hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                    View Details
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6M8 8v10l4-2 4 2V8"></path>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">No approved brokers</h3>
                        <p class="mt-1 text-sm text-gray-500">Approved broker applications will appear here</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Approved Consignees Section -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                <h3 class="text-lg font-medium text-gray-900">Approved Consignees</h3>
                <span class="text-sm text-gray-500">{{ consignees|length }} consignee{{ consignees|length != 1 ? 's' : '' }}</span>
            </div>
            <div class="p-6">
                {% if consignees|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for consignee in consignees %}
                            <div class="bg-gray-50 rounded-lg p-4 hover:bg-gray-100 transition-colors">
                                <div class="flex items-center justify-between mb-3">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <div class="w-2 h-2 bg-green-400 rounded-full mr-1"></div>
                                        Approved Consignee
                                    </span>
                                    <span class="text-xs text-gray-500">{{ consignee.approvedAt|date('M j, Y') }}</span>
                                </div>
                                
                                <div class="mb-4">
                                    <h4 class="text-sm font-medium text-gray-900 mb-1 break-words">{{ consignee.applicant.email }}</h4>
                                    {% if consignee.applicant.businessName is defined and consignee.applicant.businessName %}
                                        <p class="text-xs text-gray-600">{{ consignee.applicant.businessName }}</p>
                                    {% endif %}
                                </div>

                                <div class="space-y-2 text-xs text-gray-600 mb-4">
                                    <div class="flex justify-between">
                                        <span>Submitted:</span>
                                        <span class="font-medium">{{ consignee.submittedAt|date('M j, Y') }}</span>
                                    </div>
                                    {% if consignee.evaluator %}
                                        <div class="flex justify-between">
                                            <span>Evaluated by:</span>
                                            <span class="font-medium text-right">{{ consignee.evaluator.email|slice(0, 20) }}{{ consignee.evaluator.email|length > 20 ? '...' : '' }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                <a href="{{ path('app_admin_application_detail', {id: consignee.id}) }}" 
                                   class="inline-flex items-center justify-center w-full px-3 py-2 text-xs font-medium text-purple-600 bg-purple-50 border border-purple-200 rounded-md hover:bg-purple-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                    View Details
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">No approved consignees</h3>
                        <p class="mt-1 text-sm text-gray-500">Approved consignee applications will appear here</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Accreditation Distribution Chart
    try {
        const brokersCount = {{ brokers|length }};
        const consigneesCount = {{ consignees|length }};
        const totalCount = brokersCount + consigneesCount;

        if (totalCount > 0) {
            const chartOptions = {
                series: [brokersCount, consigneesCount],
                chart: {
                    type: 'donut',
                    height: 300,
                    fontFamily: 'Inter, system-ui, sans-serif'
                },
                labels: ['Brokers', 'Consignees'],
                colors: ['#3B82F6', '#8B5CF6'],
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total Approved',
                                    fontSize: '16px',
                                    fontWeight: 600,
                                    color: '#374151',
                                    formatter: function () {
                                        return totalCount;
                                    }
                                }
                            }
                        }
                    }
                },
                dataLabels: {
                    enabled: true,
                    formatter: function(val, opts) {
                        return opts.w.config.series[opts.seriesIndex];
                    },
                    style: {
                        fontSize: '14px',
                        fontWeight: 'bold',
                        colors: ['#ffffff']
                    }
                },
                legend: {
                    position: 'bottom',
                    fontSize: '14px',
                    fontWeight: 500,
                    fontFamily: 'Inter, system-ui, sans-serif'
                },
                stroke: {
                    width: 2,
                    colors: ['#ffffff']
                },
                tooltip: {
                    enabled: true,
                    style: {
                        fontSize: '14px',
                        fontFamily: 'Inter, system-ui, sans-serif'
                    },
                    y: {
                        formatter: function(val) {
                            return val + ' approved';
                        }
                    }
                },
                noData: {
                    text: 'No data available'
                }
            };

            new ApexCharts(document.querySelector("#accreditationChart"), chartOptions).render();
        } else {
            document.getElementById('accreditationChart').innerHTML = `
                <div class="flex flex-col items-center justify-center h-full text-gray-400">
                    <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
                    </svg>
                    <p class="text-sm font-medium">No data to display</p>
                    <p class="text-xs text-gray-400 mt-1">Chart will appear when applications are approved</p>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error rendering accreditation chart:', error);
        document.getElementById('accreditationChart').innerHTML = `
            <div class="flex flex-col items-center justify-center h-full text-gray-400">
                <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <p class="text-sm font-medium">Unable to load chart</p>
            </div>
        `;
    }
});
</script>
{% endblock %}