{% extends 'layout/admin_base.html.twig' %}

{% block title %}System Settings - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
                                <li>System Settings</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--settings] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">System Settings</h1>
                                <p class="text-sm text-base-content/60 mt-1">Manage rate limits, sessions, and reference data from one place</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <div class="flex flex-col lg:flex-row gap-5 sm:gap-6">
            {# Sidebar navigation #}
            <div class="lg:w-64 shrink-0">
                <div class="card bg-base-100 shadow-sm lg:sticky lg:top-4">
                    <div class="card-body p-2 sm:p-3">
                        <p class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-base-content/50">Configuration</p>
                        <ul class="menu menu-sm rounded-box gap-0.5">
                            <li>
                                <a href="{{ path('admin_configuration_index') }}" class="gap-2">
                                    <span class="icon-[tabler--file-certificate] size-4"></span>
                                    eDO Configuration
                                </a>
                            </li>
                            <li>
                                <button type="button" class="settings-tab-btn active gap-2" data-tab="rate-limiter">
                                    <span class="icon-[tabler--gauge] size-4"></span>
                                    Rate Limiter
                                </button>
                            </li>
                            <li>
                                <button type="button" class="settings-tab-btn gap-2" data-tab="session-config">
                                    <span class="icon-[tabler--clock] size-4"></span>
                                    Session Config
                                </button>
                            </li>
                        </ul>

                        <p class="px-3 py-2 mt-2 text-xs font-semibold uppercase tracking-wide text-base-content/50">Reference Data</p>
                        <ul class="menu menu-sm rounded-box gap-0.5">
                            <li>
                                <button type="button" class="settings-tab-btn gap-2" data-tab="shipping-lines">
                                    <span class="icon-[tabler--ship] size-4"></span>
                                    Shipping Lines
                                </button>
                            </li>
                            <li>
                                <button type="button" class="settings-tab-btn gap-2" data-tab="terminals">
                                    <span class="icon-[tabler--building-warehouse] size-4"></span>
                                    Terminals
                                </button>
                            </li>
                            <li>
                                <button type="button" class="settings-tab-btn gap-2" data-tab="container-types">
                                    <span class="icon-[tabler--box] size-4"></span>
                                    Container Types
                                </button>
                            </li>
                            <li>
                                <button type="button" class="settings-tab-btn gap-2" data-tab="container-sizes">
                                    <span class="icon-[tabler--resize] size-4"></span>
                                    Container Sizes
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            {# Content area #}
            <div class="flex-1 min-w-0 space-y-5 sm:space-y-6">

                {# Rate Limiter #}
                <div id="rate-limiter-tab" class="settings-tab-content">
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-body p-4 sm:p-6">
                            <div class="flex items-center gap-3 mb-6">
                                <div class="size-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                                    <span class="icon-[tabler--gauge] size-5 text-primary"></span>
                                </div>
                                <div>
                                    <h2 class="text-lg font-semibold text-base-content">Rate Limiter Configuration</h2>
                                    <p class="text-sm text-base-content/60">Configure rate limits for system operations</p>
                                </div>
                            </div>

                            {% if rateLimiters is empty %}
                                <div class="text-center py-10 text-base-content/60">
                                    <span class="icon-[tabler--gauge-off] size-10 mx-auto block opacity-40"></span>
                                    <p class="mt-3 text-sm">No rate limiters configured.</p>
                                </div>
                            {% else %}
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
                                    {% for name, config in rateLimiters %}
                                        <div class="card bg-base-200/40 border border-base-300">
                                            <div class="card-body p-4 sm:p-5">
                                                <form method="POST" action="{{ path('admin_system_settings_rate_limiter_update') }}" class="space-y-4">
                                                    <input type="hidden" name="limiter_name" value="{{ name }}">
                                                    <div class="flex items-start justify-between gap-2">
                                                        <h3 class="font-semibold text-base-content">{{ name|replace({'_': ' '})|title }}</h3>
                                                        <span class="badge badge-success badge-sm">Active</span>
                                                    </div>
                                                    <div class="grid grid-cols-2 gap-3">
                                                        <div class="form-control">
                                                            <label class="label py-1"><span class="label-text font-medium">Limit</span></label>
                                                            <input type="number" name="limit" value="{{ config.limit }}" min="1" required class="input input-bordered input-sm w-full">
                                                        </div>
                                                        <div class="form-control">
                                                            <label class="label py-1"><span class="label-text font-medium">Interval</span></label>
                                                            <input type="text" name="interval" value="{{ config.interval }}" required class="input input-bordered input-sm w-full font-mono">
                                                        </div>
                                                    </div>
                                                    <div class="rounded-lg bg-base-100 px-3 py-2 text-sm flex items-center justify-between">
                                                        <span class="text-base-content/60">Current rate</span>
                                                        <span class="font-medium">{{ config.limit }} / {{ config.interval }}</span>
                                                    </div>
                                                    <button type="submit" class="btn btn-primary btn-sm w-full gap-2">
                                                        <span class="icon-[tabler--device-floppy] size-4"></span>
                                                        Update
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <div class="alert alert-warning mt-6">
                                <span class="icon-[tabler--alert-triangle] size-5"></span>
                                <div class="text-sm">
                                    <p class="font-medium">After updating rate limiters</p>
                                    <p class="mt-1 opacity-90">Run <code class="bg-base-100/80 px-1.5 py-0.5 rounded font-mono text-xs">php bin/console cache:clear</code> to apply changes.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Session Config #}
                <div id="session-config-tab" class="settings-tab-content hidden">
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-body p-4 sm:p-6">
                            <div class="flex items-center gap-3 mb-6">
                                <div class="size-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                                    <span class="icon-[tabler--clock] size-5 text-primary"></span>
                                </div>
                                <div>
                                    <h2 class="text-lg font-semibold text-base-content">Session Configuration</h2>
                                    <p class="text-sm text-base-content/60">Configure session timeout and monitoring intervals</p>
                                </div>
                            </div>

                            <form method="POST" action="{{ path('admin_system_settings_session_update') }}" class="max-w-2xl space-y-5">
                                <div class="form-control">
                                    <label class="label py-1">
                                        <span class="label-text font-medium gap-2 flex items-center">
                                            <span class="icon-[tabler--device-desktop] size-4 text-base-content/50"></span>
                                            Desktop Session Timeout (minutes)
                                        </span>
                                    </label>
                                    <input type="number"
                                           name="desktop_timeout_minutes"
                                           value="{{ sessionConfig.desktop_timeout_minutes ?? 30 }}"
                                           min="1" max="1440" required
                                           class="input input-bordered w-full">
                                    <label class="label py-1">
                                        <span class="label-text-alt text-base-content/60">How long before desktop users are logged out due to inactivity</span>
                                    </label>
                                </div>

                                <div class="form-control">
                                    <label class="label py-1">
                                        <span class="label-text font-medium gap-2 flex items-center">
                                            <span class="icon-[tabler--refresh] size-4 text-base-content/50"></span>
                                            Check Interval (seconds)
                                        </span>
                                    </label>
                                    <input type="number"
                                           name="check_interval_seconds"
                                           value="{{ sessionConfig.check_interval_seconds ?? 60 }}"
                                           min="10" max="300" required
                                           class="input input-bordered w-full">
                                    <label class="label py-1">
                                        <span class="label-text-alt text-base-content/60">How often the system checks for session expiration on desktop</span>
                                    </label>
                                </div>

                                <div class="form-control">
                                    <label class="label py-1">
                                        <span class="label-text font-medium gap-2 flex items-center">
                                            <span class="icon-[tabler--device-mobile] size-4 text-base-content/50"></span>
                                            PWA Ping Interval (minutes)
                                        </span>
                                    </label>
                                    <input type="number"
                                           name="pwa_ping_interval_minutes"
                                           value="{{ sessionConfig.pwa_ping_interval_minutes ?? 5 }}"
                                           min="1" max="60" required
                                           class="input input-bordered w-full">
                                    <label class="label py-1">
                                        <span class="label-text-alt text-base-content/60">How often PWA apps ping to keep the session alive</span>
                                    </label>
                                </div>

                                <div class="alert alert-info">
                                    <span class="icon-[tabler--info-circle] size-5"></span>
                                    <div class="text-sm">
                                        <p class="font-medium">Current Configuration</p>
                                        <ul class="mt-2 space-y-1 opacity-90 list-disc list-inside">
                                            <li>Desktop timeout: {{ sessionConfig.desktop_timeout_minutes ?? 30 }} minutes</li>
                                            <li>Check interval: {{ sessionConfig.check_interval_seconds ?? 60 }} seconds</li>
                                            <li>PWA ping: {{ sessionConfig.pwa_ping_interval_minutes ?? 5 }} minutes</li>
                                        </ul>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary gap-2">
                                    <span class="icon-[tabler--device-floppy] size-4"></span>
                                    Update Session Configuration
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                {# Shipping Lines #}
                <div id="shipping-lines-tab" class="settings-tab-content hidden">
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                            <div>
                                <h3 class="card-title text-base sm:text-lg">Shipping Lines</h3>
                                <p class="text-sm text-base-content/60 mt-1">{{ shippingLines|length }} registered</p>
                            </div>
                            <a href="{{ path('admin_shipping_lines_list') }}" class="btn btn-outline btn-sm gap-2">
                                <span class="icon-[tabler--external-link] size-4"></span>
                                Manage All
                            </a>
                        </div>
                        {% if shippingLines is empty %}
                            <div class="card-body flex flex-col items-center py-12 text-center">
                                <span class="icon-[tabler--ship] size-10 text-base-content/30"></span>
                                <p class="mt-3 text-sm text-base-content/60">No shipping lines configured.</p>
                            </div>
                        {% else %}
                            <div class="divide-y divide-base-300">
                                {% for shippingLine in shippingLines %}
                                    <div class="flex items-center justify-between gap-4 px-4 sm:px-6 py-4 hover:bg-base-200/50">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <div class="size-10 rounded-full bg-primary text-primary-content flex items-center justify-center shrink-0">
                                                <span class="text-sm font-semibold">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                                            </div>
                                            <div class="min-w-0">
                                                <p class="font-medium truncate">{{ shippingLine.brandName }}</p>
                                                <p class="text-sm text-base-content/50">{{ shippingLine.shippingLineAdmins|length }} admin(s)</p>
                                            </div>
                                        </div>
                                        <a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}" class="btn btn-xs btn-ghost gap-1 shrink-0">
                                            <span class="icon-[tabler--eye] size-3"></span>
                                            View
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Terminals #}
                <div id="terminals-tab" class="settings-tab-content hidden">
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                            <div>
                                <h3 class="card-title text-base sm:text-lg">Terminals</h3>
                                <p class="text-sm text-base-content/60 mt-1">{{ terminals|length }} registered</p>
                            </div>
                            <a href="{{ path('admin_terminals_index') }}" class="btn btn-outline btn-sm gap-2">
                                <span class="icon-[tabler--external-link] size-4"></span>
                                Manage All
                            </a>
                        </div>
                        {% if terminals is empty %}
                            <div class="card-body flex flex-col items-center py-12 text-center">
                                <span class="icon-[tabler--building-warehouse] size-10 text-base-content/30"></span>
                                <p class="mt-3 text-sm text-base-content/60">No terminals configured.</p>
                            </div>
                        {% else %}
                            <div class="overflow-x-auto">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Location</th>
                                            <th class="text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for terminal in terminals %}
                                            <tr class="hover">
                                                <td class="font-medium">{{ terminal.name }}</td>
                                                <td class="text-sm text-base-content/60">{{ terminal.location ?: '—' }}</td>
                                                <td class="text-right">
                                                    <a href="{{ path('admin_terminals_view', {id: terminal.id}) }}" class="btn btn-xs btn-ghost">
                                                        <span class="icon-[tabler--eye] size-3"></span>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Container Types #}
                <div id="container-types-tab" class="settings-tab-content hidden">
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                            <div>
                                <h3 class="card-title text-base sm:text-lg">Container Types</h3>
                                <p class="text-sm text-base-content/60 mt-1">{{ containerTypes|length }} registered</p>
                            </div>
                            <a href="{{ path('admin_container_types_index') }}" class="btn btn-outline btn-sm gap-2">
                                <span class="icon-[tabler--external-link] size-4"></span>
                                Manage All
                            </a>
                        </div>
                        {% if containerTypes is empty %}
                            <div class="card-body flex flex-col items-center py-12 text-center">
                                <span class="icon-[tabler--box] size-10 text-base-content/30"></span>
                                <p class="mt-3 text-sm text-base-content/60">No container types configured.</p>
                            </div>
                        {% else %}
                            <div class="overflow-x-auto">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Code</th>
                                            <th class="text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for type in containerTypes %}
                                            <tr class="hover">
                                                <td class="font-medium">{{ type.name }}</td>
                                                <td><span class="badge badge-primary badge-sm font-mono">{{ type.code }}</span></td>
                                                <td class="text-right">
                                                    <a href="{{ path('admin_container_types_edit', {id: type.id}) }}" class="btn btn-xs btn-ghost">
                                                        <span class="icon-[tabler--edit] size-3"></span>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Container Sizes #}
                <div id="container-sizes-tab" class="settings-tab-content hidden">
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                            <div>
                                <h3 class="card-title text-base sm:text-lg">Container Sizes</h3>
                                <p class="text-sm text-base-content/60 mt-1">{{ containerSizes|length }} registered</p>
                            </div>
                            <a href="{{ path('admin_container_sizes_index') }}" class="btn btn-outline btn-sm gap-2">
                                <span class="icon-[tabler--external-link] size-4"></span>
                                Manage All
                            </a>
                        </div>
                        {% if containerSizes is empty %}
                            <div class="card-body flex flex-col items-center py-12 text-center">
                                <span class="icon-[tabler--resize] size-10 text-base-content/30"></span>
                                <p class="mt-3 text-sm text-base-content/60">No container sizes configured.</p>
                            </div>
                        {% else %}
                            <div class="overflow-x-auto">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Code</th>
                                            <th class="text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for size in containerSizes %}
                                            <tr class="hover">
                                                <td class="font-medium">{{ size.name }}</td>
                                                <td><span class="badge badge-primary badge-sm font-mono">{{ size.code }}</span></td>
                                                <td class="text-right">
                                                    <a href="{{ path('admin_container_sizes_edit', {id: size.id}) }}" class="btn btn-xs btn-ghost">
                                                        <span class="icon-[tabler--edit] size-3"></span>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>

            </div>
        </div>
</div>
{% endblock %}

{% block page_scripts %}
<style>
    .settings-tab-btn {
        width: 100%;
        justify-content: flex-start;
        border-radius: 0.5rem;
        font-weight: 500;
    }
    .settings-tab-btn.active {
        background-color: oklch(var(--p) / 0.1);
        color: oklch(var(--p));
    }
</style>
<script>
(function () {
    const tabButtons = document.querySelectorAll('.settings-tab-btn');
    const tabContents = document.querySelectorAll('.settings-tab-content');

    function showTab(tabId) {
        tabContents.forEach(function (el) {
            el.classList.add('hidden');
        });
        tabButtons.forEach(function (btn) {
            btn.classList.remove('active');
        });

        const content = document.getElementById(tabId + '-tab');
        const button = document.querySelector('.settings-tab-btn[data-tab="' + tabId + '"]');

        if (content) content.classList.remove('hidden');
        if (button) button.classList.add('active');

        if (history.replaceState) {
            history.replaceState(null, '', '#' + tabId);
        }
    }

    tabButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            showTab(btn.dataset.tab);
        });
    });

    const hash = window.location.hash.replace('#', '');
    const validTabs = ['rate-limiter', 'session-config', 'shipping-lines', 'terminals', 'container-types', 'container-sizes'];
    if (hash && validTabs.indexOf(hash) !== -1) {
        showTab(hash);
    }
})();
</script>
{% endblock %}
