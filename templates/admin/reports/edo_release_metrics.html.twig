{% extends 'layout/admin_base.html.twig' %}

{% block title %}eDO Release Metrics - OPTIMUS{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>eDO Release Metrics</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title text-xl sm:text-2xl">
                <span class="icon-[tabler--chart-line] size-6"></span>
                eDO Release Metrics
            </h1>
            <p class="text-sm text-base-content/70">Monitor eDO release workflow efficiency and performance</p>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <form id="filterForm" class="flex flex-wrap items-end gap-3">
                <div class="form-control flex-1 min-w-[180px]">
                    <label class="label py-0" for="startDate"><span class="label-text">Start Date</span></label>
                    <input type="date" id="startDate" name="start_date" class="input input-bordered input-sm">
                </div>
                <div class="form-control flex-1 min-w-[180px]">
                    <label class="label py-0" for="endDate"><span class="label-text">End Date</span></label>
                    <input type="date" id="endDate" name="end_date" class="input input-bordered input-sm">
                </div>
                <button type="button" onclick="loadMetrics()" class="btn btn-primary btn-sm">Apply Filter</button>
                <button type="button" onclick="exportReport('csv')" class="btn btn-outline btn-sm">Export CSV</button>
                <button type="button" onclick="exportReport('pdf')" class="btn btn-outline btn-sm">Export PDF</button>
            </form>
        </div>
    </div>

    <div class="stats stats-vertical sm:stats-horizontal shadow w-full bg-base-100">
        <div class="stat">
            <div class="stat-figure text-info"><span class="icon-[tabler--clock] size-8"></span></div>
            <div class="stat-title">Avg Release Time</div>
            <div class="stat-value text-info text-2xl" id="avgReleaseTime">--</div>
            <div class="stat-desc">hours</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-success"><span class="icon-[tabler--circle-check] size-8"></span></div>
            <div class="stat-title">Total Released</div>
            <div class="stat-value text-success text-2xl" id="totalReleased">--</div>
            <div class="stat-desc">in period</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-error"><span class="icon-[tabler--circle-x] size-8"></span></div>
            <div class="stat-title">Total Rejected</div>
            <div class="stat-value text-error text-2xl" id="totalRejected">--</div>
            <div class="stat-desc">in period</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-warning"><span class="icon-[tabler--clock-pause] size-8"></span></div>
            <div class="stat-title">Pending</div>
            <div class="stat-value text-warning text-2xl" id="totalPending">--</div>
            <div class="stat-desc">current</div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h3 class="font-semibold">eDOs Released Per Day</h3>
                <p class="text-sm text-base-content/60 mb-4">Daily release volume</p>
                <div id="releasedPerDayChart" style="height: 300px;"></div>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h3 class="font-semibold">Pending eDOs by Age</h3>
                <p class="text-sm text-base-content/60 mb-4">Age distribution of pending releases</p>
                <div id="pendingByAgeChart" style="height: 300px;"></div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
            <div class="p-4 sm:p-6 border-b border-base-200">
                <h3 class="font-semibold">Rejected eDOs</h3>
                <p class="text-sm text-base-content/60">eDOs rejected with reasons</p>
            </div>
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>eDO Number</th>
                            <th>Manifest Number</th>
                            <th>Rejected Date</th>
                            <th>Rejected By</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody id="rejectedEdosTable">
                        <tr>
                            <td colspan="5" class="text-center py-12">
                                <span class="loading loading-spinner loading-md"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
let releasedPerDayChart = null;
let pendingByAgeChart = null;

function loadMetrics() {
    const startDate = document.getElementById('startDate').value;
    const endDate = document.getElementById('endDate').value;
    
    let url = '/admin/reports/edo-release-metrics?';
    if (startDate) url += `start_date=${startDate}&`;
    if (endDate) url += `end_date=${endDate}&`;
    
    fetch(url)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                updateMetrics(data.data);
            } else {
                alert('Error loading metrics: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while loading metrics');
        });
}

function updateMetrics(data) {
    // Update key metrics
    document.getElementById('avgReleaseTime').textContent = 
        data.average_release_time_hours ? data.average_release_time_hours.toFixed(2) : '0.00';
    
    const totalReleased = data.edos_released_per_day.reduce((sum, item) => sum + item.count, 0);
    document.getElementById('totalReleased').textContent = totalReleased;
    
    document.getElementById('totalRejected').textContent = data.rejected_edos.length;
    
    const totalPending = Object.values(data.pending_edos_by_age).reduce((sum, count) => sum + count, 0);
    document.getElementById('totalPending').textContent = totalPending;
    
    // Update charts
    updateReleasedPerDayChart(data.edos_released_per_day);
    updatePendingByAgeChart(data.pending_edos_by_age);
    updateRejectedTable(data.rejected_edos);
}

function updateReleasedPerDayChart(data) {
    const dates = data.map(item => item.date);
    const counts = data.map(item => item.count);
    
    const options = {
        series: [{
            name: 'eDOs Released',
            data: counts
        }],
        chart: {
            type: 'area',
            height: 300,
            toolbar: { show: false }
        },
        colors: ['#10B981'],
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2 },
        xaxis: {
            categories: dates,
            labels: {
                rotate: -45,
                rotateAlways: true
            }
        },
        yaxis: {
            title: { text: 'Count' }
        },
        fill: {
            type: 'gradient',
            gradient: {
                shadeIntensity: 1,
                opacityFrom: 0.7,
                opacityTo: 0.3
            }
        }
    };
    
    if (releasedPerDayChart) {
        releasedPerDayChart.destroy();
    }
    releasedPerDayChart = new ApexCharts(document.querySelector("#releasedPerDayChart"), options);
    releasedPerDayChart.render();
}

function updatePendingByAgeChart(data) {
    const labels = Object.keys(data);
    const values = Object.values(data);
    
    const options = {
        series: values,
        chart: {
            type: 'donut',
            height: 300
        },
        labels: labels,
        colors: ['#10B981', '#F59E0B', '#EF4444'],
        legend: { position: 'bottom' },
        plotOptions: {
            pie: {
                donut: { size: '70%' }
            }
        }
    };
    
    if (pendingByAgeChart) {
        pendingByAgeChart.destroy();
    }
    pendingByAgeChart = new ApexCharts(document.querySelector("#pendingByAgeChart"), options);
    pendingByAgeChart.render();
}

function updateRejectedTable(data) {
    const tbody = document.getElementById('rejectedEdosTable');
    
    if (data.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="5" class="px-6 py-12 text-center">
                    <p class="text-sm text-gray-500">No rejected eDOs in this period</p>
                </td>
            </tr>
        `;
        return;
    }
    
    tbody.innerHTML = data.map(edo => `
        <tr class="hover:bg-base-200">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-base-content">
                ${edo.edo_number}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-base-content">
                ${edo.manifest_number}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-base-content">
                ${edo.rejected_at}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-base-content">
                ${edo.rejected_by}
            </td>
            <td class="px-6 py-4 text-sm text-base-content">
                ${edo.rejection_reason}
            </td>
        </tr>
    `).join('');
}

function exportReport(format) {
    const startDate = document.getElementById('startDate').value;
    const endDate = document.getElementById('endDate').value;
    
    let url = `/admin/reports/edo-release-metrics/export/${format}?type=rejected_edos&`;
    if (startDate) url += `start_date=${startDate}&`;
    if (endDate) url += `end_date=${endDate}`;
    
    window.location.href = url;
}

// Set default date range (last 30 days)
document.addEventListener('DOMContentLoaded', function() {
    const endDate = new Date();
    const startDate = new Date();
    startDate.setDate(startDate.getDate() - 30);
    
    document.getElementById('endDate').valueAsDate = endDate;
    document.getElementById('startDate').valueAsDate = startDate;
    
    loadMetrics();
});
</script>
{% endblock %}
