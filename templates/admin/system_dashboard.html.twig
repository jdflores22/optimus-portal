{% extends 'layout/admin_base.html.twig' %}

{% block title %}System Dashboard - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>System Dashboard</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title text-xl sm:text-2xl">
                <span class="icon-[tabler--dashboard] size-6"></span>
                System Dashboard
            </h1>
            <p class="text-sm text-base-content/70">Overview of system-wide metrics and activity</p>
        </div>
    </div>

    <div class="stats stats-vertical sm:stats-horizontal shadow w-full bg-base-100">
        <div class="stat">
            <div class="stat-figure text-primary"><span class="icon-[tabler--users] size-8"></span></div>
            <div class="stat-title">Total Users</div>
            <div class="stat-value text-primary">{{ metrics.users.total }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-info"><span class="icon-[tabler--clipboard-list] size-8"></span></div>
            <div class="stat-title">Audit Events (7d)</div>
            <div class="stat-value text-info">{{ metrics.recent_activity.audit_logs }}</div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6">
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-lg">Users by Role</h2>
                <div class="space-y-3 mt-2">
                    {% for role, count in metrics.users.by_role %}
                    <div class="flex justify-between items-center">
                        <span class="text-sm">{{ role|replace({'_': ' '})|title }}</span>
                        <span class="font-medium">{{ count }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-lg">Recent Activity (Last 7 Days)</h2>
            <div class="mt-4">
                <div class="text-center p-4 bg-base-200/50 rounded-xl max-w-sm mx-auto">
                    <div class="text-3xl font-bold text-success">{{ metrics.recent_activity.audit_logs }}</div>
                    <div class="text-sm text-base-content/60 mt-1">Audit Log Entries</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-lg">Quick Actions</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-4">
                <a href="{{ path('app_admin_users') }}" class="btn btn-primary gap-2">
                    <span class="icon-[tabler--users] size-4"></span>
                    Manage Users
                </a>
                <a href="{{ path('app_admin_audit_logs') }}" class="btn btn-success gap-2">
                    <span class="icon-[tabler--file-text] size-4"></span>
                    View Audit Logs
                </a>
                <a href="{{ path('app_form_builder_list') }}" class="btn btn-secondary gap-2">
                    <span class="icon-[tabler--forms] size-4"></span>
                    Form Builder
                </a>
            </div>
        </div>
    </div>

    {% if limiters is defined and limiters is not empty %}
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div>
                    <h2 class="card-title text-lg">Rate Limiter Settings</h2>
                    <p class="text-sm text-base-content/60">Configure rate limiting for system operations</p>
                </div>
                <span class="badge badge-info">{{ limiters|length }} limiters</span>
            </div>

            <div class="alert alert-warning mb-4">
                <span class="icon-[tabler--alert-triangle] size-5"></span>
                <span class="text-sm">Changes require cache clear: <code class="bg-base-200 px-1 rounded">php bin/console cache:clear</code></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for name, config in limiters %}
                <div class="card bg-base-200/40 border border-base-300">
                    <div class="card-body p-4">
                        <h3 class="font-semibold text-sm mb-3">{{ name|replace({'_': ' '})|title }}</h3>
                        <form method="POST" action="{{ path('app_admin_update_rate_limiter') }}" class="space-y-3">
                            <input type="hidden" name="limiter_name" value="{{ name }}">
                            <div class="grid grid-cols-2 gap-2">
                                <div class="form-control">
                                    <label class="label py-0"><span class="label-text text-xs">Limit</span></label>
                                    <input type="number" name="limit" value="{{ config.limit }}" min="1" required class="input input-bordered input-sm">
                                </div>
                                <div class="form-control">
                                    <label class="label py-0"><span class="label-text text-xs">Interval</span></label>
                                    <select name="interval" required class="select select-bordered select-sm">
                                        <option value="1 minute" {% if config.interval == '1 minute' %}selected{% endif %}>1 min</option>
                                        <option value="5 minutes" {% if config.interval == '5 minutes' %}selected{% endif %}>5 min</option>
                                        <option value="15 minutes" {% if config.interval == '15 minutes' %}selected{% endif %}>15 min</option>
                                        <option value="30 minutes" {% if config.interval == '30 minutes' %}selected{% endif %}>30 min</option>
                                        <option value="1 hour" {% if config.interval == '1 hour' %}selected{% endif %}>1 hour</option>
                                        <option value="24 hours" {% if config.interval == '24 hours' %}selected{% endif %}>24 hours</option>
                                    </select>
                                </div>
                            </div>
                            <p class="text-xs text-base-content/60">Current: <span class="font-medium">{{ config.limit }}/{{ config.interval }}</span></p>
                            <button type="submit" class="btn btn-primary btn-sm w-full">Update</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}
</div>

<div id="toastContainer" class="toast toast-top toast-end z-50"></div>
{% endblock %}

{% block page_scripts %}
<script>
function showToast(message, type = 'success') {
    const container = document.getElementById('toastContainer');
    const alertClass = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-error' : 'alert-info';
    const toast = document.createElement('div');
    toast.className = `alert ${alertClass} shadow-lg mb-2 max-w-sm`;
    toast.innerHTML = `<span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
}

{% for message in app.flashes('success') %}
    showToast({{ message|json_encode|raw }}, 'success');
{% endfor %}
{% for message in app.flashes('error') %}
    showToast({{ message|json_encode|raw }}, 'error');
{% endfor %}
</script>
{% endblock %}
