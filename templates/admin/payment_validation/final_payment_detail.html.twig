{% extends 'base.html.twig' %}

{% block title %}Final Payment Validation - {{ payment.manifest.manifestNumber }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('admin_payment_validation_dashboard') }}">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('admin_payment_validation_final_payment') }}">Final Payments</a></li>
                    <li class="breadcrumb-item active">Payment #{{ payment.id }}</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">Final Payment Validation</h1>
        </div>
    </div>

    <!-- Payment Details -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Payment Details</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th width="40%">Payment ID:</th>
                                    <td>#{{ payment.id }}</td>
                                </tr>
                                <tr>
                                    <th>Manifest Number:</th>
                                    <td>
                                        <a href="{{ path('manifest_workflow_detail', {id: payment.manifest.id}) }}">
                                            {{ payment.manifest.manifestNumber }}
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Consignee:</th>
                                    <td>
                                        {% if payment.manifest.consignee %}
                                            {{ payment.manifest.consignee.businessName }}
                                        {% else %}
                                            <span class="text-muted">Not declared</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Broker:</th>
                                    <td>
                                        {% if payment.manifest.broker %}
                                            {{ payment.manifest.broker.fullName }}
                                        {% else %}
                                            <span class="text-muted">None</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th width="40%">Submitted By:</th>
                                    <td>
                                        {{ payment.submittedBy.fullName }}
                                        <br>
                                        <small class="text-muted">{{ payment.submittedBy.email }}</small>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Submitted At:</th>
                                    <td>{{ payment.createdAt|date('F d, Y H:i:s') }}</td>
                                </tr>
                                <tr>
                                    <th>Status:</th>
                                    <td>
                                        {% if payment.status.value == 'pending_validation' %}
                                            <span class="badge bg-warning fs-6">Pending Validation</span>
                                        {% elseif payment.status.value == 'verified' %}
                                            <span class="badge bg-success fs-6">Verified</span>
                                        {% elseif payment.status.value == 'rejected' %}
                                            <span class="badge bg-danger fs-6">Rejected</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% if payment.validatedBy %}
                                    <tr>
                                        <th>Validated By:</th>
                                        <td>
                                            {{ payment.validatedBy.fullName }}
                                            <br>
                                            <small class="text-muted">{{ payment.validatedAt|date('F d, Y H:i:s') }}</small>
                                        </td>
                                    </tr>
                                {% endif %}
                            </table>
                        </div>
                    </div>

                    <!-- Amount Comparison -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card {% if discrepancy > 0.01 %}border-danger{% else %}border-success{% endif %}">
                                <div class="card-body">
                                    <h6 class="card-title">Amount Comparison</h6>
                                    <div class="row text-center">
                                        <div class="col-md-4">
                                            <div class="mb-2">
                                                <small class="text-muted">Billing Amount</small>
                                            </div>
                                            <h3 class="mb-0">₱{{ billing.totalAmount|number_format(2) }}</h3>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-2">
                                                <small class="text-muted">Payment Amount</small>
                                            </div>
                                            <h3 class="mb-0">₱{{ payment.amount|number_format(2) }}</h3>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-2">
                                                <small class="text-muted">Discrepancy</small>
                                            </div>
                                            {% if discrepancy > 0.01 %}
                                                <h3 class="mb-0 text-danger">
                                                    <i class="fas fa-exclamation-triangle"></i> ₱{{ discrepancy|number_format(2) }}
                                                </h3>
                                                <div class="alert alert-warning mt-2 mb-0">
                                                    <strong>Amount Mismatch!</strong><br>
                                                    The payment amount does not match the billing total.
                                                    You can override this with justification.
                                                </div>
                                            {% else %}
                                                <h3 class="mb-0 text-success">
                                                    <i class="fas fa-check-circle"></i> Match
                                                </h3>
                                                <small class="text-success">Amounts match perfectly</small>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if payment.rejectionReason %}
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="alert alert-danger">
                                    <strong>Rejection Reason:</strong><br>
                                    {{ payment.rejectionReason }}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Side-by-Side Billing and Receipt -->
    <div class="row mb-4">
        <!-- Billing Document -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                    <h5 class="mb-0">Billing Document</h5>
                    {% if billing.pdfPath %}
                        <a href="{{ asset('uploads/billing/' ~ billing.pdfPath|split('/')|last) }}" 
                           target="_blank" 
                           class="btn btn-sm btn-light">
                            <i class="fas fa-external-link-alt"></i> Open
                        </a>
                    {% endif %}
                </div>
                <div class="card-body p-3">
                    <div class="billing-details">
                        <h6 class="border-bottom pb-2">Charge Breakdown</h6>
                        <table class="table table-sm">
                            <tr>
                                <th>Freight Charges:</th>
                                <td class="text-end">₱{{ billing.freightCharges|number_format(2) }}</td>
                            </tr>
                            <tr>
                                <th>THC Charges:</th>
                                <td class="text-end">₱{{ billing.thcCharges|number_format(2) }}</td>
                            </tr>
                            {% if billing.additionalCharges %}
                                {% for charge in billing.additionalCharges %}
                                    <tr>
                                        <th>{{ charge.description }}:</th>
                                        <td class="text-end">₱{{ charge.amount|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                            <tr class="table-primary">
                                <th><strong>Total Amount:</strong></th>
                                <td class="text-end"><strong>₱{{ billing.totalAmount|number_format(2) }}</strong></td>
                            </tr>
                        </table>

                        <div class="mt-3">
                            <small class="text-muted">
                                Generated by: {{ billing.generatedBy.fullName }}<br>
                                Generated at: {{ billing.createdAt|date('F d, Y H:i:s') }}
                            </small>
                        </div>
                    </div>

                    {% if billing.pdfPath %}
                        <hr>
                        <div class="billing-viewer" style="height: 400px; overflow: auto; border: 1px solid #dee2e6;">
                            {% set fileExtension = billing.pdfPath|split('.')|last|lower %}
                            {% if fileExtension == 'pdf' %}
                                <iframe src="{{ asset('uploads/billing/' ~ billing.pdfPath|split('/')|last) }}" 
                                        width="100%" 
                                        height="400px" 
                                        style="border: none;">
                                </iframe>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Payment Receipt -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center bg-success text-white">
                    <h5 class="mb-0">Payment Receipt</h5>
                    <a href="{{ asset('uploads/receipts/' ~ payment.receiptFilePath|split('/')|last) }}" 
                       target="_blank" 
                       class="btn btn-sm btn-light">
                        <i class="fas fa-external-link-alt"></i> Open
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="receipt-viewer" style="height: 600px; overflow: auto;">
                        {% set fileExtension = payment.receiptFilePath|split('.')|last|lower %}
                        {% if fileExtension in ['jpg', 'jpeg', 'png', 'gif'] %}
                            <img src="{{ asset('uploads/receipts/' ~ payment.receiptFilePath|split('/')|last) }}" 
                                 alt="Payment Receipt" 
                                 class="img-fluid w-100">
                        {% elseif fileExtension == 'pdf' %}
                            <iframe src="{{ asset('uploads/receipts/' ~ payment.receiptFilePath|split('/')|last) }}" 
                                    width="100%" 
                                    height="600px" 
                                    style="border: none;">
                            </iframe>
                        {% else %}
                            <div class="text-center py-5">
                                <i class="fas fa-file fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Preview not available for this file type.</p>
                                <a href="{{ asset('uploads/receipts/' ~ payment.receiptFilePath|split('/')|last) }}" 
                                   target="_blank" 
                                   class="btn btn-primary">
                                    <i class="fas fa-download"></i> Download Receipt
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Validation Actions -->
    {% if payment.status.value == 'pending_validation' %}
        <div class="row mb-4">
            <div class="col">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Validation Actions</h5>
                    </div>
                    <div class="card-body">
                        <form id="validationForm">
                            <div class="mb-3">
                                <label for="reason" class="form-label">
                                    Reason / Justification
                                    <span class="text-danger">*</span>
                                    <small class="text-muted">(Required for rejection, optional for approval with override)</small>
                                </label>
                                <textarea class="form-control" id="reason" name="reason" rows="4" 
                                          placeholder="Enter reason for rejection or justification for amount override..."></textarea>
                            </div>

                            {% if discrepancy > 0.01 %}
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <strong>Amount Mismatch Detected</strong><br>
                                    If you approve this payment, please provide justification for the override in the reason field above.
                                </div>
                            {% endif %}

                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-success btn-lg" onclick="validatePayment({{ payment.id }}, true)">
                                    <i class="fas fa-check-circle"></i> Approve Payment
                                </button>
                                <button type="button" class="btn btn-danger btn-lg" onclick="validatePayment({{ payment.id }}, false)">
                                    <i class="fas fa-times-circle"></i> Reject Payment
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Validation History -->
    {% if validationHistory is not empty %}
        <div class="row">
            <div class="col">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Validation History</h5>
                        <small class="text-muted">Previous payment attempts for this manifest</small>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Payment ID</th>
                                        <th>Submitted By</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Validated By</th>
                                        <th>Validated At</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for historyPayment in validationHistory %}
                                        <tr>
                                            <td>#{{ historyPayment.id }}</td>
                                            <td>{{ historyPayment.submittedBy.fullName }}</td>
                                            <td>₱{{ historyPayment.amount|number_format(2) }}</td>
                                            <td>
                                                {% if historyPayment.status.value == 'verified' %}
                                                    <span class="badge bg-success">Verified</span>
                                                {% elseif historyPayment.status.value == 'rejected' %}
                                                    <span class="badge bg-danger">Rejected</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ historyPayment.validatedBy.fullName }}</td>
                                            <td>{{ historyPayment.validatedAt|date('Y-m-d H:i') }}</td>
                                            <td>
                                                {% if historyPayment.rejectionReason %}
                                                    <small>{{ historyPayment.rejectionReason }}</small>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<script>
function validatePayment(paymentId, approved) {
    const reason = document.getElementById('reason').value.trim();
    
    if (!approved && !reason) {
        alert('Please provide a reason for rejection.');
        return;
    }
    
    if (approved && !confirm('Are you sure you want to APPROVE this payment? This will automatically generate the eDO.')) {
        return;
    }
    
    if (!approved && !confirm('Are you sure you want to REJECT this payment?')) {
        return;
    }
    
    // Disable buttons to prevent double submission
    const buttons = document.querySelectorAll('#validationForm button');
    buttons.forEach(btn => btn.disabled = true);
    
    fetch(`/api/payments/${paymentId}/validate-final`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            approved: approved,
            reason: reason || null
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.error) {
            alert('Error: ' + data.error);
            buttons.forEach(btn => btn.disabled = false);
        } else {
            if (approved && data.edoGenerated) {
                alert('Payment approved successfully! eDO ' + data.edoNumber + ' has been generated.');
            } else if (approved) {
                alert('Payment approved successfully!');
            } else {
                alert('Payment rejected successfully!');
            }
            window.location.reload();
        }
    })
    .catch(error => {
        alert('An error occurred. Please try again.');
        console.error('Error:', error);
        buttons.forEach(btn => btn.disabled = false);
    });
}
</script>
{% endblock %}
