{% extends 'base.html.twig' %}

{% block title %}Payment Validation - {{ payment.manifest.manifestNumber }} - OPTIMUS{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2 text-sm text-gray-500">
            <li><a href="{{ path('admin_payment_validation_dashboard') }}" class="hover:text-gray-700">Dashboard</a></li>
            <li><span class="mx-2">/</span></li>
            <li><a href="{{ path('admin_payment_validation_manifest_access') }}" class="hover:text-gray-700">Manifest Access Payments</a></li>
            <li><span class="mx-2">/</span></li>
            <li class="text-gray-900">Payment #{{ payment.id }}</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Payment Validation</h1>
        <p class="mt-2 text-gray-600">Review and validate manifest access payment</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Payment Details -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Payment Details</h3>
            </div>
            <div class="p-6">
                <dl class="space-y-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Payment ID</dt>
                        <dd class="mt-1 text-sm text-gray-900">#{{ payment.id }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Manifest Number</dt>
                        <dd class="mt-1">
                            <a href="{{ path('manifest_workflow_detail', {id: payment.manifest.id}) }}" 
                               class="text-sm text-blue-600 hover:text-blue-900">
                                {{ payment.manifest.manifestNumber }}
                            </a>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Consignee</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {% if payment.manifest.consignee %}
                                {{ payment.manifest.consignee.businessName }}
                            {% else %}
                                <span class="text-gray-400">Not declared</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Broker</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {% if payment.manifest.broker %}
                                {{ payment.manifest.broker.fullName }}
                            {% else %}
                                <span class="text-gray-400">None</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Submitted By</dt>
                        <dd class="mt-1">
                            <div class="text-sm text-gray-900">{{ payment.submittedBy.fullName }}</div>
                            <div class="text-xs text-gray-500">{{ payment.submittedBy.email }}</div>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Submitted At</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ payment.createdAt|date('F d, Y H:i:s') }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Payment Amount</dt>
                        <dd class="mt-1">
                            <div class="text-2xl font-bold text-gray-900">₱{{ payment.amount|number_format(2) }}</div>
                            {% if payment.amount != 500 %}
                                <div class="mt-2 bg-yellow-50 border border-yellow-200 rounded-lg p-3">
                                    <div class="flex">
                                        <svg class="w-5 h-5 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                        </svg>
                                        <div>
                                            <p class="text-sm font-medium text-yellow-800">Amount Mismatch!</p>
                                            <p class="text-xs text-yellow-700 mt-1">Expected: ₱500.00</p>
                                            <p class="text-xs text-yellow-700">Submitted: ₱{{ payment.amount|number_format(2) }}</p>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="mt-1 flex items-center text-sm text-green-600">
                                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                    </svg>
                                    Amount matches expected ₱500.00
                                </div>
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Status</dt>
                        <dd class="mt-1">
                            {% if payment.status.value == 'pending_validation' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                                    Pending Validation
                                </span>
                            {% elseif payment.status.value == 'verified' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                    Verified
                                </span>
                            {% elseif payment.status.value == 'rejected' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                    Rejected
                                </span>
                            {% endif %}
                        </dd>
                    </div>
                    {% if payment.validatedBy %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Validated By</dt>
                            <dd class="mt-1">
                                <div class="text-sm text-gray-900">{{ payment.validatedBy.fullName }}</div>
                                <div class="text-xs text-gray-500">{{ payment.validatedAt|date('F d, Y H:i:s') }}</div>
                            </dd>
                        </div>
                    {% endif %}
                    {% if payment.rejectionReason %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Rejection Reason</dt>
                            <dd class="mt-1">
                                <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-800">
                                    {{ payment.rejectionReason }}
                                </div>
                            </dd>
                        </div>
                    {% endif %}
                </dl>

                <!-- Validation Actions -->
                {% if payment.status.value == 'pending_validation' %}
                    <div class="mt-6 pt-6 border-t border-gray-200">
                        <h4 class="text-sm font-medium text-gray-900 mb-4">Validation Actions</h4>
                        <form id="validationForm">
                            <div class="mb-4">
                                <label for="reason" class="block text-sm font-medium text-gray-700 mb-2">
                                    Reason (required for rejection)
                                </label>
                                <textarea id="reason" name="reason" rows="3" 
                                          placeholder="Enter reason for rejection..."
                                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                            </div>
                            <div class="space-y-3">
                                <button type="button" 
                                        onclick="validatePayment({{ payment.id }}, true)"
                                        class="w-full inline-flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    Approve Payment
                                </button>
                                <button type="button" 
                                        onclick="validatePayment({{ payment.id }}, false)"
                                        class="w-full inline-flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-red-600 hover:bg-red-700">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    Reject Payment
                                </button>
                            </div>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Receipt Viewer -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h3 class="text-lg font-medium text-gray-900">Payment Receipt</h3>
                {% set filePath = payment.receiptFilePath %}
                
                {# Handle both absolute and relative paths #}
                {% if filePath starts with 'C:' or filePath starts with '/' and not (filePath starts with '/uploads') %}
                    {# Old absolute path format - extract relative path #}
                    {% set pathParts = filePath|split('/uploads/') %}
                    {% if pathParts|length > 1 %}
                        {% set relativePath = '/uploads/' ~ pathParts[1] %}
                    {% else %}
                        {% set relativePath = filePath %}
                    {% endif %}
                {% else %}
                    {# Already a relative path #}
                    {% set relativePath = filePath %}
                {% endif %}
                
                <a href="{{ asset(relativePath) }}" 
                   target="_blank" 
                   class="inline-flex items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    Open in New Tab
                </a>
            </div>
            <div class="p-0">
                <div class="receipt-viewer" style="height: 600px; overflow: auto;">
                    {% set fileExtension = payment.receiptFilePath|split('.')|last|lower %}
                    {% set filePath = payment.receiptFilePath %}
                    
                    {# Handle both absolute and relative paths #}
                    {% if filePath starts with 'C:' or filePath starts with '/' and not (filePath starts with '/uploads') %}
                        {# Old absolute path format - extract relative path #}
                        {% set pathParts = filePath|split('/uploads/') %}
                        {% if pathParts|length > 1 %}
                            {% set relativePath = '/uploads/' ~ pathParts[1] %}
                        {% else %}
                            {% set relativePath = filePath %}
                        {% endif %}
                    {% else %}
                        {# Already a relative path #}
                        {% set relativePath = filePath %}
                    {% endif %}
                    
                    {% if fileExtension in ['jpg', 'jpeg', 'png', 'gif'] %}
                        <img src="{{ asset(relativePath) }}" 
                             alt="Payment Receipt" 
                             class="w-full h-auto">
                    {% elseif fileExtension == 'pdf' %}
                        <iframe src="{{ asset(relativePath) }}" 
                                width="100%" 
                                height="600px" 
                                style="border: none;">
                        </iframe>
                    {% else %}
                        <div class="text-center py-12">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">Preview not available</h3>
                            <p class="mt-1 text-sm text-gray-500">Preview not available for this file type.</p>
                            <div class="mt-6">
                                <a href="{{ asset(relativePath) }}" 
                                   target="_blank" 
                                   class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                                    </svg>
                                    Download Receipt
                                </a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Validation History -->
    {% if validationHistory is not empty %}
        <div class="mt-6 bg-white rounded-lg shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Validation History</h3>
                <p class="mt-1 text-sm text-gray-500">Previous payment attempts for this manifest</p>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted By</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Validated By</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Validated At</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reason</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for historyPayment in validationHistory %}
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">#{{ historyPayment.id }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ historyPayment.submittedBy.fullName }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₱{{ historyPayment.amount|number_format(2) }}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if historyPayment.status.value == 'verified' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Verified
                                        </span>
                                    {% elseif historyPayment.status.value == 'rejected' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            Rejected
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ historyPayment.validatedBy.fullName }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ historyPayment.validatedAt|date('M j, Y H:i') }}</td>
                                <td class="px-6 py-4 text-sm text-gray-500">
                                    {% if historyPayment.rejectionReason %}
                                        {{ historyPayment.rejectionReason }}
                                    {% else %}
                                        <span class="text-gray-400">-</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>

<script>
function validatePayment(paymentId, approved) {
    const reason = document.getElementById('reason').value.trim();
    
    if (!approved && !reason) {
        alert('Please provide a reason for rejection.');
        return;
    }
    
    if (approved && !confirm('Are you sure you want to APPROVE this payment?')) {
        return;
    }
    
    if (!approved && !confirm('Are you sure you want to REJECT this payment?')) {
        return;
    }
    
    // Disable buttons to prevent double submission
    const buttons = document.querySelectorAll('#validationForm button');
    buttons.forEach(btn => btn.disabled = true);
    
    fetch(`/api/payments/${paymentId}/validate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            approved: approved,
            reason: reason || null
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.error) {
            alert('Error: ' + data.error);
            buttons.forEach(btn => btn.disabled = false);
        } else {
            alert(approved ? 'Payment approved successfully!' : 'Payment rejected successfully!');
            window.location.reload();
        }
    })
    .catch(error => {
        alert('An error occurred. Please try again.');
        console.error('Error:', error);
        buttons.forEach(btn => btn.disabled = false);
    });
}
</script>
{% endblock %}
