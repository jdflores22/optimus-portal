{% extends 'layout/admin_base.html.twig' %}

{% block title %}Terminal Management - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>Terminals</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
                <div>
                    <h1 class="card-title text-xl sm:text-2xl">Terminal Management</h1>
                    <p class="text-sm text-base-content/70">Manage container yards and terminals</p>
                </div>
                <a href="{{ path('admin_terminals_new') }}"
                   class="btn btn-primary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--plus] size-4 sm:size-5"></span>
                    Add Terminal
                </a>
            </div>
        </div>
    </div>

    <div>
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Statistics -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-primary/10 text-primary rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--building] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Total Terminals</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ statistics.total }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-success/10 text-success rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-check] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Active</p>
                            <p class="text-2xl sm:text-3xl font-bold text-success">{{ statistics.active }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-error/10 text-error rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-x] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Inactive</p>
                            <p class="text-2xl sm:text-3xl font-bold text-error">{{ statistics.inactive }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-secondary/10 text-secondary rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--stack-2] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Total Capacity</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ statistics.totalCapacity }}</p>
                            <p class="text-xs text-base-content/60">TEU</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search and Filter -->
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-body p-4 sm:p-5">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="form-control">
                        <label class="label py-1" for="searchInput">
                            <span class="label-text font-medium">Search</span>
                        </label>
                        <label class="input input-bordered flex items-center gap-2">
                            <span class="icon-[tabler--search] size-4 text-base-content/50"></span>
                            <input type="text"
                                   id="searchInput"
                                   class="grow"
                                   placeholder="Search by name or location...">
                        </label>
                    </div>
                    <div class="form-control">
                        <label class="label py-1" for="statusFilter">
                            <span class="label-text font-medium">Status</span>
                        </label>
                        <select id="statusFilter" class="select select-bordered w-full">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="form-control">
                        <label class="label py-1" for="typeFilter">
                            <span class="label-text font-medium">Type</span>
                        </label>
                        <select id="typeFilter" class="select select-bordered w-full">
                            <option value="">All Types</option>
                            {% for type in terminalTypes %}
                                <option value="{{ type.value }}">{{ type.value }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Terminals Table -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-4 sm:px-6 pt-4 sm:pt-5">
                <h3 class="card-title text-base sm:text-lg">All Terminals</h3>
                <span class="badge badge-ghost">{{ terminals|length }} total</span>
            </div>

            {% if terminals|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Terminal Name</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Region</th>
                                <th>Daily Capacity</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="terminalsTableBody">
                            {% for terminal in terminals %}
                                <tr id="terminal-row-{{ terminal.id }}"
                                    class="hover"
                                    data-name="{{ terminal.name|lower }}"
                                    data-location="{{ terminal.location|lower }}"
                                    data-status="{{ terminal.isActive ? 'active' : 'inactive' }}"
                                    data-type="{{ terminal.type.value }}">
                                    <td class="font-medium whitespace-nowrap">{{ terminal.name }}</td>
                                    <td>
                                        <span class="badge badge-primary badge-sm">{{ terminal.type.value }}</span>
                                    </td>
                                    <td class="text-sm text-base-content/80 whitespace-nowrap">{{ terminal.location }}</td>
                                    <td class="text-sm text-base-content/60 whitespace-nowrap">
                                        {% if terminal.region %}
                                            {{ terminal.region.name }}{% if terminal.city %} — {{ terminal.city.name }}{% endif %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="text-sm whitespace-nowrap">{{ terminal.dailyCapacity }} TEU</td>
                                    <td>
                                        <span class="badge badge-sm {{ terminal.isActive ? 'badge-success' : 'badge-error' }}"
                                              id="status-badge-{{ terminal.id }}">
                                            {{ terminal.isActive ? 'Active' : 'Inactive' }}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="flex items-center justify-end gap-1">
                                            <a href="{{ path('admin_terminals_view', {id: terminal.id}) }}"
                                               class="btn btn-xs btn-ghost"
                                               title="View">
                                                <span class="icon-[tabler--eye] size-3"></span>
                                            </a>
                                            <a href="{{ path('admin_terminals_edit', {id: terminal.id}) }}"
                                               class="btn btn-xs btn-primary"
                                               title="Edit">
                                                <span class="icon-[tabler--edit] size-3"></span>
                                            </a>
                                            <button type="button"
                                                    onclick="toggleTerminalStatus({{ terminal.id }})"
                                                    class="btn btn-xs btn-warning"
                                                    title="{{ terminal.isActive ? 'Deactivate' : 'Activate' }}"
                                                    id="toggle-btn-{{ terminal.id }}">
                                                <span class="icon-[tabler--{{ terminal.isActive ? 'ban' : 'circle-check' }}] size-3"></span>
                                            </button>
                                            <button type="button"
                                                    onclick="deleteTerminal({{ terminal.id }})"
                                                    class="btn btn-xs btn-error"
                                                    title="Delete">
                                                <span class="icon-[tabler--trash] size-3"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 pb-4 sm:pb-5">
                    <p class="text-sm text-base-content/70">
                        Showing <span id="showingFrom">1</span> to <span id="showingTo">{{ terminals|length }}</span>
                        of <span id="totalResults">{{ terminals|length }}</span> results
                    </p>
                    <div class="flex flex-wrap gap-1" id="paginationControls"></div>
                </div>
            {% else %}
                <div class="card-body text-center py-12">
                    <span class="icon-[tabler--building] size-12 text-base-content/30 mx-auto"></span>
                    <h3 class="mt-4 text-base font-medium">No terminals found</h3>
                    <p class="mt-2 text-sm text-base-content/70">Get started by adding your first terminal.</p>
                    <div class="mt-6">
                        <a href="{{ path('admin_terminals_new') }}" class="btn btn-primary gap-2">
                            <span class="icon-[tabler--plus] size-4"></span>
                            Add Terminal
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<div id="confirmModal"
     class="hidden fixed inset-0 z-[10005] items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirmTitle">
    <div class="absolute inset-0 bg-black/60" onclick="closeConfirmModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div id="confirmIconWrap" class="size-14 rounded-full flex items-center justify-center mx-auto mb-4">
                <span id="confirmIcon" class="size-7"></span>
            </div>
            <h3 id="confirmTitle" class="text-lg font-bold mb-2">Confirm Action</h3>
            <p id="confirmMessage" class="text-sm text-base-content/70 mb-6">Are you sure you want to proceed?</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeConfirmModal()" class="btn btn-ghost flex-1">Cancel</button>
                <button type="button" id="confirmButton" onclick="confirmAction()" class="btn flex-1">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="terminalToastContainer" class="fixed top-20 right-4 z-[10010] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>
{% endblock %}

{% block page_scripts %}
<script>
let pendingAction = null;
let pendingTerminalId = null;
let currentPage = 1;
let itemsPerPage = 10;
let filteredRows = [];

document.addEventListener('DOMContentLoaded', function () {
    initializeFilters();
    updatePagination();
});

function initializeFilters() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const typeFilter = document.getElementById('typeFilter');

    if (!searchInput) return;

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    typeFilter.addEventListener('change', applyFilters);
}

function applyFilters() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value;
    const typeFilter = document.getElementById('typeFilter').value;

    const rows = document.querySelectorAll('#terminalsTableBody tr[data-name]');
    filteredRows = [];

    rows.forEach(function (row) {
        const name = row.getAttribute('data-name');
        const location = row.getAttribute('data-location');
        const status = row.getAttribute('data-status');
        const type = row.getAttribute('data-type');

        const matchesSearch = !searchTerm || name.includes(searchTerm) || location.includes(searchTerm);
        const matchesStatus = !statusFilter || status === statusFilter;
        const matchesType = !typeFilter || type === typeFilter;

        if (matchesSearch && matchesStatus && matchesType) {
            filteredRows.push(row);
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });

    let noResultsRow = document.getElementById('no-results-row');
    if (filteredRows.length === 0 && rows.length > 0) {
        if (!noResultsRow) {
            const tbody = document.getElementById('terminalsTableBody');
            tbody.insertAdjacentHTML('beforeend',
                '<tr id="no-results-row"><td colspan="7" class="text-center py-8 text-sm text-base-content/60">No terminals match your search criteria.</td></tr>'
            );
        }
    } else if (noResultsRow && filteredRows.length > 0) {
        noResultsRow.remove();
    }

    currentPage = 1;
    updatePagination();
}

function updatePagination() {
    const tbody = document.getElementById('terminalsTableBody');
    if (!tbody) return;

    const rows = filteredRows.length > 0 ? filteredRows : document.querySelectorAll('#terminalsTableBody tr[data-name]');
    const totalItems = rows.length;
    const totalPages = Math.ceil(totalItems / itemsPerPage);

    const showingFromEl = document.getElementById('showingFrom');
    const showingToEl = document.getElementById('showingTo');
    const totalResultsEl = document.getElementById('totalResults');

    if (showingFromEl) {
        const showingFrom = totalItems === 0 ? 0 : (currentPage - 1) * itemsPerPage + 1;
        const showingTo = Math.min(currentPage * itemsPerPage, totalItems);
        showingFromEl.textContent = showingFrom;
        showingToEl.textContent = showingTo;
        totalResultsEl.textContent = totalItems;
    }

    rows.forEach(function (row, index) {
        const shouldShow = index >= (currentPage - 1) * itemsPerPage && index < currentPage * itemsPerPage;
        row.style.display = shouldShow ? '' : 'none';
    });

    const paginationControls = document.getElementById('paginationControls');
    if (!paginationControls) return;

    paginationControls.innerHTML = '';

    if (totalPages <= 1) return;

    paginationControls.appendChild(createPaginationButton('Previous', currentPage > 1, function () {
        if (currentPage > 1) {
            currentPage--;
            updatePagination();
        }
    }));

    for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
            paginationControls.appendChild(createPaginationButton(String(i), true, function () {
                currentPage = i;
                updatePagination();
            }, i === currentPage));
        } else if (i === currentPage - 2 || i === currentPage + 2) {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'btn btn-sm btn-ghost btn-disabled';
            ellipsis.textContent = '...';
            paginationControls.appendChild(ellipsis);
        }
    }

    paginationControls.appendChild(createPaginationButton('Next', currentPage < totalPages, function () {
        if (currentPage < totalPages) {
            currentPage++;
            updatePagination();
        }
    }));
}

function createPaginationButton(text, enabled, onClick, isActive) {
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = text;
    button.onclick = onClick;

    if (isActive) {
        button.className = 'btn btn-sm btn-primary';
    } else if (enabled) {
        button.className = 'btn btn-sm btn-ghost';
    } else {
        button.className = 'btn btn-sm btn-ghost btn-disabled';
        button.disabled = true;
    }

    return button;
}

function openConfirmModal(title, message, action, terminalId, iconType) {
    const modal = document.getElementById('confirmModal');
    const iconWrap = document.getElementById('confirmIconWrap');
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');

    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMessage').textContent = message;

    if (iconType === 'warning') {
        iconWrap.className = 'size-14 bg-warning/10 rounded-full flex items-center justify-center mx-auto mb-4';
        icon.className = 'icon-[tabler--alert-triangle] size-7 text-warning';
        confirmBtn.className = 'btn btn-warning flex-1';
    } else {
        iconWrap.className = 'size-14 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-4';
        icon.className = 'icon-[tabler--alert-circle] size-7 text-error';
        confirmBtn.className = 'btn btn-error flex-1';
    }

    pendingAction = action;
    pendingTerminalId = terminalId;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    pendingAction = null;
    pendingTerminalId = null;
}

function confirmAction() {
    if (pendingAction === 'toggle') {
        executeToggleStatus(pendingTerminalId);
    } else if (pendingAction === 'delete') {
        executeDelete(pendingTerminalId);
    }
    closeConfirmModal();
}

function toggleTerminalStatus(terminalId) {
    const badge = document.getElementById('status-badge-' + terminalId);
    const isActive = badge.textContent.trim() === 'Active';

    openConfirmModal(
        isActive ? 'Deactivate Terminal' : 'Activate Terminal',
        isActive
            ? 'Are you sure you want to deactivate this terminal? It will no longer be available for operations.'
            : 'Are you sure you want to activate this terminal?',
        'toggle',
        terminalId,
        'warning'
    );
}

function executeToggleStatus(terminalId) {
    fetch('/admin/terminals/' + terminalId + '/toggle-status', { method: 'POST' })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                showNotification(data.message, 'success');

                const badge = document.getElementById('status-badge-' + terminalId);
                const toggleBtn = document.getElementById('toggle-btn-' + terminalId);
                const row = document.getElementById('terminal-row-' + terminalId);

                if (data.isActive) {
                    badge.className = 'badge badge-sm badge-success';
                    badge.textContent = 'Active';
                    toggleBtn.title = 'Deactivate';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--ban] size-3"></span>';
                    row.setAttribute('data-status', 'active');
                } else {
                    badge.className = 'badge badge-sm badge-error';
                    badge.textContent = 'Inactive';
                    toggleBtn.title = 'Activate';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--circle-check] size-3"></span>';
                    row.setAttribute('data-status', 'inactive');
                }
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(function () {
            showNotification('Failed to update terminal status', 'error');
        });
}

function deleteTerminal(terminalId) {
    openConfirmModal(
        'Delete Terminal',
        'Are you sure you want to delete this terminal? This action cannot be undone and may affect existing operations.',
        'delete',
        terminalId,
        'danger'
    );
}

function executeDelete(terminalId) {
    fetch('/admin/terminals/' + terminalId + '/delete', { method: 'POST' })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                showNotification(data.message, 'success');
                const row = document.getElementById('terminal-row-' + terminalId);
                if (row) {
                    row.remove();
                    applyFilters();
                }
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(function () {
            showNotification('Failed to delete terminal', 'error');
        });
}

function showNotification(message, type) {
    const container = document.getElementById('terminalToastContainer');
    if (!container) return;

    const typeClass = type === 'success' ? 'alert-success' : (type === 'error' ? 'alert-error' : 'alert-info');
    const icon = type === 'success' ? 'icon-[tabler--check]' : (type === 'error' ? 'icon-[tabler--alert-circle]' : 'icon-[tabler--info-circle]');
    const toast = document.createElement('div');
    toast.className = 'alert ' + typeClass + ' shadow-lg pointer-events-auto';
    toast.innerHTML = '<span class="' + icon + ' size-5"></span><span>' + message + '</span>';
    container.appendChild(toast);

    window.setTimeout(function () {
        toast.remove();
    }, 4000);
}
</script>
{% endblock %}
