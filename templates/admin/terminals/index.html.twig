{% extends 'base.html.twig' %}

{% block title %}Terminal Management - OPTIMUS{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6">
    <!-- Header -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Terminal Management</h1>
            <p class="mt-1 text-sm text-gray-600">Manage container yards and terminals</p>
        </div>
        <a href="{{ path('admin_terminals_new') }}" 
           class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Add Terminal
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Total Terminals</p>
                    <p class="text-2xl font-bold text-gray-900">{{ statistics.total }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Active</p>
                    <p class="text-2xl font-bold text-green-900">{{ statistics.active }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Inactive</p>
                    <p class="text-2xl font-bold text-red-900">{{ statistics.inactive }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Total Capacity</p>
                    <p class="text-2xl font-bold text-purple-900">{{ statistics.totalCapacity }}</p>
                    <p class="text-xs text-gray-500">TEU</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label for="searchInput" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
                <input type="text" 
                       id="searchInput" 
                       placeholder="Search by name or location..."
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500">
            </div>
            <div>
                <label for="statusFilter" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <select id="statusFilter" 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            <div>
                <label for="typeFilter" class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                <select id="typeFilter" 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                    <option value="">All Types</option>
                    {% for type in terminalTypes %}
                    <option value="{{ type.value }}">{{ type.value }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>

    <!-- Terminals Table -->
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Terminal Name
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Type
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Location
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Region
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Daily Capacity (TEU)
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Status
                    </th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200" id="terminalsTableBody">
                {% for terminal in terminals %}
                <tr id="terminal-row-{{ terminal.id }}" 
                    data-name="{{ terminal.name|lower }}" 
                    data-location="{{ terminal.location|lower }}" 
                    data-status="{{ terminal.isActive ? 'active' : 'inactive' }}" 
                    data-type="{{ terminal.type.value }}">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">{{ terminal.name }}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                            {{ terminal.type.value }}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">{{ terminal.location }}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-500">
                            {% if terminal.region %}
                                {{ terminal.region.name }}
                                {% if terminal.city %} - {{ terminal.city.name }}{% endif %}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">{{ terminal.dailyCapacity }}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {{ terminal.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}" id="status-badge-{{ terminal.id }}">
                            {{ terminal.isActive ? 'Active' : 'Inactive' }}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <a href="{{ path('admin_terminals_view', {id: terminal.id}) }}" 
                           class="text-green-600 hover:text-green-900 mr-3">
                            View
                        </a>
                        <a href="{{ path('admin_terminals_edit', {id: terminal.id}) }}" 
                           class="text-blue-600 hover:text-blue-900 mr-3">
                            Edit
                        </a>
                        <button onclick="toggleTerminalStatus({{ terminal.id }})" 
                                class="text-yellow-600 hover:text-yellow-900 mr-3" 
                                id="toggle-btn-{{ terminal.id }}">
                            {{ terminal.isActive ? 'Deactivate' : 'Activate' }}
                        </button>
                        <button onclick="deleteTerminal({{ terminal.id }})" 
                                class="text-red-600 hover:text-red-900">
                            Delete
                        </button>
                    </td>
                </tr>
                {% else %}
                <tr id="no-results-row">
                    <td colspan="7" class="px-6 py-4 text-center text-sm text-gray-500">
                        No terminals found. Click "Add Terminal" to create one.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="mt-4 flex items-center justify-between">
        <div class="text-sm text-gray-700">
            Showing <span id="showingFrom">1</span> to <span id="showingTo">{{ terminals|length }}</span> of <span id="totalResults">{{ terminals|length }}</span> results
        </div>
        <div class="flex space-x-2" id="paginationControls">
            <!-- Pagination buttons will be inserted here -->
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999]" style="display: none;">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="relative p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <div class="flex items-center mb-4">
                    <div class="flex-shrink-0" id="confirmIcon">
                        <!-- Icon will be inserted here -->
                    </div>
                    <h3 class="ml-3 text-lg font-medium leading-6 text-gray-900" id="confirmTitle">Confirm Action</h3>
                </div>
                <p class="text-sm text-gray-500 mb-6" id="confirmMessage">Are you sure you want to proceed?</p>
                <div class="flex justify-end space-x-3">
                    <button type="button" 
                            onclick="closeConfirmModal()" 
                            class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400">
                        Cancel
                    </button>
                    <button type="button" 
                            id="confirmButton"
                            onclick="confirmAction()" 
                            class="px-4 py-2 text-white rounded-md focus:outline-none focus:ring-2">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let pendingAction = null;
let pendingTerminalId = null;
let currentPage = 1;
let itemsPerPage = 10;
let filteredRows = [];

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    initializeFilters();
    updatePagination();
});

// Search and filter functionality
function initializeFilters() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const typeFilter = document.getElementById('typeFilter');

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    typeFilter.addEventListener('change', applyFilters);
}

function applyFilters() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value;
    const typeFilter = document.getElementById('typeFilter').value;

    const rows = document.querySelectorAll('#terminalsTableBody tr[data-name]');
    filteredRows = [];

    rows.forEach(row => {
        const name = row.getAttribute('data-name');
        const location = row.getAttribute('data-location');
        const status = row.getAttribute('data-status');
        const type = row.getAttribute('data-type');

        const matchesSearch = !searchTerm || name.includes(searchTerm) || location.includes(searchTerm);
        const matchesStatus = !statusFilter || status === statusFilter;
        const matchesType = !typeFilter || type === typeFilter;

        if (matchesSearch && matchesStatus && matchesType) {
            filteredRows.push(row);
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });

    // Handle no results
    const noResultsRow = document.getElementById('no-results-row');
    if (filteredRows.length === 0 && rows.length > 0) {
        if (!noResultsRow) {
            const tbody = document.getElementById('terminalsTableBody');
            tbody.insertAdjacentHTML('beforeend', `
                <tr id="no-results-row">
                    <td colspan="7" class="px-6 py-4 text-center text-sm text-gray-500">
                        No terminals match your search criteria.
                    </td>
                </tr>
            `);
        }
    } else if (noResultsRow && filteredRows.length > 0) {
        noResultsRow.remove();
    }

    currentPage = 1;
    updatePagination();
}

function updatePagination() {
    const rows = filteredRows.length > 0 ? filteredRows : document.querySelectorAll('#terminalsTableBody tr[data-name]');
    const totalItems = rows.length;
    const totalPages = Math.ceil(totalItems / itemsPerPage);

    // Update showing text
    const showingFrom = totalItems === 0 ? 0 : (currentPage - 1) * itemsPerPage + 1;
    const showingTo = Math.min(currentPage * itemsPerPage, totalItems);
    
    document.getElementById('showingFrom').textContent = showingFrom;
    document.getElementById('showingTo').textContent = showingTo;
    document.getElementById('totalResults').textContent = totalItems;

    // Show/hide rows based on current page
    rows.forEach((row, index) => {
        const shouldShow = index >= (currentPage - 1) * itemsPerPage && index < currentPage * itemsPerPage;
        row.style.display = shouldShow ? '' : 'none';
    });

    // Update pagination controls
    const paginationControls = document.getElementById('paginationControls');
    paginationControls.innerHTML = '';

    if (totalPages <= 1) return;

    // Previous button
    const prevButton = createPaginationButton('Previous', currentPage > 1, () => {
        if (currentPage > 1) {
            currentPage--;
            updatePagination();
        }
    });
    paginationControls.appendChild(prevButton);

    // Page numbers
    for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
            const pageButton = createPaginationButton(i, true, () => {
                currentPage = i;
                updatePagination();
            }, i === currentPage);
            paginationControls.appendChild(pageButton);
        } else if (i === currentPage - 2 || i === currentPage + 2) {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'px-3 py-2 text-gray-500';
            ellipsis.textContent = '...';
            paginationControls.appendChild(ellipsis);
        }
    }

    // Next button
    const nextButton = createPaginationButton('Next', currentPage < totalPages, () => {
        if (currentPage < totalPages) {
            currentPage++;
            updatePagination();
        }
    });
    paginationControls.appendChild(nextButton);
}

function createPaginationButton(text, enabled, onClick, isActive = false) {
    const button = document.createElement('button');
    button.textContent = text;
    button.onclick = onClick;
    
    if (isActive) {
        button.className = 'px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-md';
    } else if (enabled) {
        button.className = 'px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50';
    } else {
        button.className = 'px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-md cursor-not-allowed';
        button.disabled = true;
    }
    
    return button;
}

// Modal functions
function openConfirmModal(title, message, action, terminalId, iconType) {
    const modal = document.getElementById('confirmModal');
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');
    
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMessage').textContent = message;
    
    // Set icon based on type
    if (iconType === 'warning') {
        icon.innerHTML = `
            <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        `;
        confirmBtn.className = 'px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500';
    } else if (iconType === 'danger') {
        icon.innerHTML = `
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        `;
        confirmBtn.className = 'px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-red-500';
    }
    
    pendingAction = action;
    pendingTerminalId = terminalId;
    modal.style.display = 'block';
    modal.classList.remove('hidden');
}

function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.style.display = 'none';
    modal.classList.add('hidden');
    pendingAction = null;
    pendingTerminalId = null;
}

function confirmAction() {
    if (pendingAction === 'toggle') {
        executeToggleStatus(pendingTerminalId);
    } else if (pendingAction === 'delete') {
        executeDelete(pendingTerminalId);
    }
    closeConfirmModal();
}

// Terminal actions
function toggleTerminalStatus(terminalId) {
    const badge = document.getElementById(`status-badge-${terminalId}`);
    const isActive = badge.textContent.trim() === 'Active';
    
    const title = isActive ? 'Deactivate Terminal' : 'Activate Terminal';
    const message = isActive 
        ? 'Are you sure you want to deactivate this terminal? It will no longer be available for operations.' 
        : 'Are you sure you want to activate this terminal?';
    
    openConfirmModal(title, message, 'toggle', terminalId, 'warning');
}

function executeToggleStatus(terminalId) {
    fetch(`/admin/terminals/${terminalId}/toggle-status`, {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification(data.message, 'success');
            // Update status badge
            const badge = document.getElementById(`status-badge-${terminalId}`);
            const toggleBtn = document.getElementById(`toggle-btn-${terminalId}`);
            const row = document.getElementById(`terminal-row-${terminalId}`);
            
            if (data.isActive) {
                badge.className = 'px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800';
                badge.textContent = 'Active';
                toggleBtn.textContent = 'Deactivate';
                row.setAttribute('data-status', 'active');
            } else {
                badge.className = 'px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800';
                badge.textContent = 'Inactive';
                toggleBtn.textContent = 'Activate';
                row.setAttribute('data-status', 'inactive');
            }
        } else {
            showNotification(data.message, 'error');
        }
    })
    .catch(error => {
        showNotification('Failed to update terminal status', 'error');
    });
}

function deleteTerminal(terminalId) {
    openConfirmModal(
        'Delete Terminal',
        'Are you sure you want to delete this terminal? This action cannot be undone and may affect existing operations.',
        'delete',
        terminalId,
        'danger'
    );
}

function executeDelete(terminalId) {
    fetch(`/admin/terminals/${terminalId}/delete`, {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification(data.message, 'success');
            // Remove row from table
            const row = document.getElementById(`terminal-row-${terminalId}`);
            if (row) {
                row.remove();
                applyFilters(); // Reapply filters to update counts
            }
        } else {
            showNotification(data.message, 'error');
        }
    })
    .catch(error => {
        showNotification('Failed to delete terminal', 'error');
    });
}

// Notification system (Tailwind UI style)
function showNotification(message, type = 'success') {
    const notificationId = 'notification-' + Date.now();
    
    const config = {
        success: {
            bgColor: 'bg-white',
            iconBg: 'bg-green-100',
            iconColor: 'text-green-600',
            textColor: 'text-gray-900',
            iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
        },
        error: {
            bgColor: 'bg-white',
            iconBg: 'bg-red-100',
            iconColor: 'text-red-600',
            textColor: 'text-gray-900',
            iconPath: 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z'
        },
        info: {
            bgColor: 'bg-white',
            iconBg: 'bg-blue-100',
            iconColor: 'text-blue-600',
            textColor: 'text-gray-900',
            iconPath: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
        }
    };
    
    const style = config[type] || config.success;
    
    const notificationHtml = `
        <div id="${notificationId}" class="fixed top-20 right-4 z-[9999] w-full max-w-sm pointer-events-auto transform transition-all duration-500 ease-out translate-x-0 opacity-100">
            <div class="${style.bgColor} rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 overflow-hidden">
                <div class="p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="${style.iconBg} rounded-full p-2">
                                <svg class="h-5 w-5 ${style.iconColor}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${style.iconPath}"/>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-3 w-0 flex-1 pt-0.5">
                            <p class="text-sm font-medium ${style.textColor}">${message}</p>
                        </div>
                        <div class="ml-4 flex-shrink-0 flex">
                            <button onclick="closeNotification('${notificationId}')" class="inline-flex text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 rounded-md">
                                <span class="sr-only">Close</span>
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    document.body.insertAdjacentHTML('beforeend', notificationHtml);
    
    setTimeout(() => {
        closeNotification(notificationId);
    }, 5000);
}

function closeNotification(notificationId) {
    const notification = document.getElementById(notificationId);
    if (notification) {
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(100%)';
        setTimeout(() => notification.remove(), 300);
    }
}
</script>
{% endblock %}
