{% extends 'base.html.twig' %}

{% block title %}Create New Terminal - OPTIMUS{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center mb-2">
            <a href="{{ path('admin_terminals_index') }}" class="text-blue-600 hover:text-blue-800 mr-2">
                <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-2xl font-bold text-gray-900">Create New Terminal</h1>
        </div>
        <p class="text-sm text-gray-600">Add a new container yard terminal to the system</p>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-100 text-green-800">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-100 text-red-800">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Create Form -->
    <div class="bg-white shadow-md rounded-lg p-6 max-w-2xl">
        <form id="terminalForm" method="POST" action="{{ path('admin_terminals_store') }}">
            <div class="space-y-6">
                <!-- Terminal Name -->
                <div>
                    <label for="terminalName" class="block text-sm font-medium text-gray-700 mb-2">
                        Terminal Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" 
                           id="terminalName" 
                           name="name" 
                           required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., ICTSI Manila">
                </div>

                <!-- Terminal Type -->
                <div>
                    <label for="terminalType" class="block text-sm font-medium text-gray-700 mb-2">
                        Type <span class="text-red-500">*</span>
                    </label>
                    <select id="terminalType" 
                            name="type" 
                            required
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Select Type</option>
                        {% for type in terminalTypes %}
                        <option value="{{ type.value }}">{{ type.value }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Location -->
                <div>
                    <label for="terminalLocation" class="block text-sm font-medium text-gray-700 mb-2">
                        Location <span class="text-red-500">*</span>
                    </label>
                    <input type="text" 
                           id="terminalLocation" 
                           name="location" 
                           required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., Manila, Philippines">
                </div>

                <!-- Region -->
                <div>
                    <label for="terminalRegion" class="block text-sm font-medium text-gray-700 mb-2">
                        Region
                    </label>
                    <select id="terminalRegion" 
                            name="region_id" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Select Region</option>
                        {% for region in regions %}
                        <option value="{{ region.id }}">{{ region.name }}</option>
                        {% endfor %}
                    </select>
                    <p class="mt-1 text-sm text-gray-500">Select the region where this terminal is located</p>
                </div>

                <!-- City/Municipality -->
                <div>
                    <label for="terminalCity" class="block text-sm font-medium text-gray-700 mb-2">
                        City/Municipality
                    </label>
                    <select id="terminalCity" 
                            name="city_id" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            disabled>
                        <option value="">Select region first</option>
                    </select>
                    <p class="mt-1 text-sm text-gray-500">Select the city or municipality</p>
                </div>

                <!-- Daily Capacity -->
                <div>
                    <label for="terminalCapacity" class="block text-sm font-medium text-gray-700 mb-2">
                        Daily Capacity (TEU) <span class="text-red-500">*</span>
                    </label>
                    <input type="number" 
                           id="terminalCapacity" 
                           name="dailyCapacity" 
                           required
                           min="1"
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., 1000">
                    <p class="mt-1 text-sm text-gray-500">Enter the maximum number of containers this terminal can handle per day</p>
                </div>

                <!-- Info Box -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                        </svg>
                        <div>
                            <p class="text-sm text-blue-800 font-medium">New Terminal Status</p>
                            <p class="text-sm text-blue-700 mt-1">The terminal will be created with an <strong>Inactive</strong> status by default. You can activate it later from the terminal list or edit page.</p>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
                    <a href="{{ path('admin_terminals_index') }}" 
                       class="px-6 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition-colors">
                        Cancel
                    </a>
                    <button type="submit" 
                            id="submitBtn"
                            class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors inline-flex items-center">
                        <span id="btnText">Create Terminal</span>
                        <svg id="btnSpinner" class="hidden animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
// Load cities when region is selected
document.getElementById('terminalRegion').addEventListener('change', function() {
    const regionId = this.value;
    const citySelect = document.getElementById('terminalCity');
    
    if (!regionId) {
        citySelect.innerHTML = '<option value="">Select region first</option>';
        citySelect.disabled = true;
        return;
    }
    
    // Show loading state
    citySelect.innerHTML = '<option value="">Loading cities...</option>';
    citySelect.disabled = true;
    
    // Fetch cities for selected region
    fetch(`/api/locations/cities/${regionId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.cities) {
                citySelect.innerHTML = '<option value="">Select City/Municipality</option>';
                data.cities.forEach(city => {
                    const option = document.createElement('option');
                    option.value = city.id;
                    option.textContent = city.name;
                    citySelect.appendChild(option);
                });
                citySelect.disabled = false;
            } else {
                citySelect.innerHTML = '<option value="">No cities found</option>';
            }
        })
        .catch(error => {
            console.error('Error loading cities:', error);
            citySelect.innerHTML = '<option value="">Error loading cities</option>';
        });
});

document.getElementById('terminalForm').addEventListener('submit', function(e) {
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    
    // Disable button and show spinner
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
    btnText.textContent = 'Creating...';
    btnSpinner.classList.remove('hidden');
});
</script>
{% endblock %}
