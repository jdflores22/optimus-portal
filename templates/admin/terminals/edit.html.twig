{% extends 'base.html.twig' %}

{% block title %}Edit Terminal - OPTIMUS{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-6">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center mb-2">
            <a href="{{ path('admin_terminals_index') }}" class="text-blue-600 hover:text-blue-800 mr-2">
                <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-2xl font-bold text-gray-900">Edit Terminal</h1>
        </div>
        <p class="text-sm text-gray-600">Update terminal information</p>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-100 text-green-800">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-100 text-red-800">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Edit Form -->
    <div class="bg-white shadow-md rounded-lg p-6 max-w-2xl">
        <form id="terminalForm" method="POST" action="{{ path('admin_terminals_update', {id: terminal.id}) }}">
            <div class="space-y-6">
                <!-- Terminal Name -->
                <div>
                    <label for="terminalName" class="block text-sm font-medium text-gray-700 mb-2">
                        Terminal Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" 
                           id="terminalName" 
                           name="name" 
                           value="{{ terminal.name }}"
                           required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., ICTSI Manila">
                </div>

                <!-- Terminal Type -->
                <div>
                    <label for="terminalType" class="block text-sm font-medium text-gray-700 mb-2">
                        Type <span class="text-red-500">*</span>
                    </label>
                    <select id="terminalType" 
                            name="type" 
                            required
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Select Type</option>
                        {% for type in terminalTypes %}
                        <option value="{{ type.value }}" {{ terminal.type.value == type.value ? 'selected' : '' }}>
                            {{ type.value }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Location -->
                <div>
                    <label for="terminalLocation" class="block text-sm font-medium text-gray-700 mb-2">
                        Location <span class="text-red-500">*</span>
                    </label>
                    <input type="text" 
                           id="terminalLocation" 
                           name="location" 
                           value="{{ terminal.location }}"
                           required
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., Manila, Philippines">
                </div>

                <!-- Region -->
                <div>
                    <label for="terminalRegion" class="block text-sm font-medium text-gray-700 mb-2">
                        Region
                    </label>
                    <select id="terminalRegion" 
                            name="region_id" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Select Region</option>
                        {% for region in regions %}
                        <option value="{{ region.id }}" {{ terminal.region and terminal.region.id == region.id ? 'selected' : '' }}>
                            {{ region.name }}
                        </option>
                        {% endfor %}
                    </select>
                    <p class="mt-1 text-sm text-gray-500">Select the region where this terminal is located</p>
                </div>

                <!-- City/Municipality -->
                <div>
                    <label for="terminalCity" class="block text-sm font-medium text-gray-700 mb-2">
                        City/Municipality
                    </label>
                    <select id="terminalCity" 
                            name="city_id" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            {{ terminal.region ? '' : 'disabled' }}>
                        <option value="">{{ terminal.region ? 'Loading cities...' : 'Select region first' }}</option>
                    </select>
                    <p class="mt-1 text-sm text-gray-500">Select the city or municipality</p>
                </div>

                <!-- Daily Capacity -->
                <div>
                    <label for="terminalCapacity" class="block text-sm font-medium text-gray-700 mb-2">
                        Daily Capacity (TEU) <span class="text-red-500">*</span>
                    </label>
                    <input type="number" 
                           id="terminalCapacity" 
                           name="dailyCapacity" 
                           value="{{ terminal.dailyCapacity }}"
                           required
                           min="1"
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., 1000">
                </div>

                <!-- Terminal Status Toggle -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-700">Terminal Status</p>
                            <p class="text-xs text-gray-500 mt-1">Activate or deactivate this terminal</p>
                        </div>
                        <div class="flex items-center space-x-3">
                            <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full {{ terminal.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}" id="statusBadge">
                                {{ terminal.isActive ? 'Active' : 'Inactive' }}
                            </span>
                            <button type="button" 
                                    onclick="toggleTerminalStatus()"
                                    id="toggleStatusBtn"
                                    class="px-4 py-2 {{ terminal.isActive ? 'bg-yellow-600 hover:bg-yellow-700' : 'bg-green-600 hover:bg-green-700' }} text-white text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors">
                                {{ terminal.isActive ? 'Deactivate' : 'Activate' }}
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Timestamps -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-gray-500">Created</p>
                            <p class="text-gray-900 font-medium">{{ terminal.createdAt|date('M d, Y H:i') }}</p>
                        </div>
                        <div>
                            <p class="text-gray-500">Last Updated</p>
                            <p class="text-gray-900 font-medium">{{ terminal.updatedAt|date('M d, Y H:i') }}</p>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
                    <a href="{{ path('admin_terminals_index') }}" 
                       class="px-6 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 transition-colors">
                        Cancel
                    </a>
                    <button type="submit" 
                            id="submitBtn"
                            class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors inline-flex items-center">
                        <span id="btnText">Update Terminal</span>
                        <svg id="btnSpinner" class="hidden animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999] flex items-center justify-center">
    <div class="relative p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <div class="flex items-center mb-4">
                <div class="flex-shrink-0" id="confirmIcon">
                    <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
                <h3 class="ml-3 text-lg font-medium leading-6 text-gray-900" id="confirmTitle">Confirm Action</h3>
            </div>
            <p class="text-sm text-gray-500 mb-6" id="confirmMessage">Are you sure you want to proceed?</p>
            <div class="flex justify-end space-x-3">
                <button type="button" 
                        onclick="closeConfirmModal()" 
                        class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400">
                    Cancel
                </button>
                <button type="button" 
                        id="confirmButton"
                        onclick="confirmAction()" 
                        class="px-4 py-2 text-white rounded-md focus:outline-none focus:ring-2">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let pendingAction = null;
const selectedCityId = {{ terminal.city ? terminal.city.id : 'null' }};
const selectedRegionId = {{ terminal.region ? terminal.region.id : 'null' }};

// Load cities when region is selected
document.getElementById('terminalRegion').addEventListener('change', function() {
    const regionId = this.value;
    const citySelect = document.getElementById('terminalCity');
    
    if (!regionId) {
        citySelect.innerHTML = '<option value="">Select region first</option>';
        citySelect.disabled = true;
        return;
    }
    
    // Show loading state
    citySelect.innerHTML = '<option value="">Loading cities...</option>';
    citySelect.disabled = true;
    
    // Fetch cities for selected region
    fetch(`/api/locations/cities/${regionId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.cities) {
                citySelect.innerHTML = '<option value="">Select City/Municipality</option>';
                data.cities.forEach(city => {
                    const option = document.createElement('option');
                    option.value = city.id;
                    option.textContent = city.name;
                    citySelect.appendChild(option);
                });
                citySelect.disabled = false;
            } else {
                citySelect.innerHTML = '<option value="">No cities found</option>';
            }
        })
        .catch(error => {
            console.error('Error loading cities:', error);
            citySelect.innerHTML = '<option value="">Error loading cities</option>';
        });
});

// Load cities on page load if region is already selected
window.addEventListener('DOMContentLoaded', function() {
    if (selectedRegionId) {
        const citySelect = document.getElementById('terminalCity');
        
        fetch(`/api/locations/cities/${selectedRegionId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success && data.cities) {
                    citySelect.innerHTML = '<option value="">Select City/Municipality</option>';
                    data.cities.forEach(city => {
                        const option = document.createElement('option');
                        option.value = city.id;
                        option.textContent = city.name;
                        if (selectedCityId && city.id === selectedCityId) {
                            option.selected = true;
                        }
                        citySelect.appendChild(option);
                    });
                    citySelect.disabled = false;
                } else {
                    citySelect.innerHTML = '<option value="">No cities found</option>';
                }
            })
            .catch(error => {
                console.error('Error loading cities:', error);
                citySelect.innerHTML = '<option value="">Error loading cities</option>';
            });
    }
});

document.getElementById('terminalForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Show confirmation modal for update
    document.getElementById('confirmTitle').textContent = 'Update Terminal';
    document.getElementById('confirmMessage').textContent = 'Are you sure you want to save these changes to the terminal?';
    
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');
    
    icon.innerHTML = `
        <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
    `;
    confirmBtn.className = 'px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
    
    pendingAction = 'update';
    document.getElementById('confirmModal').classList.remove('hidden');
});

function toggleTerminalStatus() {
    const statusBadge = document.getElementById('statusBadge');
    const isActive = statusBadge.textContent.trim() === 'Active';
    
    const title = isActive ? 'Deactivate Terminal' : 'Activate Terminal';
    const message = isActive 
        ? 'Are you sure you want to deactivate this terminal? It will no longer be available for operations.' 
        : 'Are you sure you want to activate this terminal?';
    
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');
    
    icon.innerHTML = `
        <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
    `;
    confirmBtn.className = 'px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500';
    
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMessage').textContent = message;
    
    pendingAction = 'toggle';
    document.getElementById('confirmModal').classList.remove('hidden');
}

function closeConfirmModal() {
    document.getElementById('confirmModal').classList.add('hidden');
    pendingAction = null;
}

function confirmAction() {
    if (pendingAction === 'update') {
        submitForm();
    } else if (pendingAction === 'toggle') {
        executeToggleStatus();
    }
    closeConfirmModal();
}

function submitForm() {
    const form = document.getElementById('terminalForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    
    // Disable button and show spinner
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
    btnText.textContent = 'Updating...';
    btnSpinner.classList.remove('hidden');
    
    // Submit the form
    form.submit();
}

function executeToggleStatus() {
    const terminalId = {{ terminal.id }};
    const statusBadge = document.getElementById('statusBadge');
    const toggleBtn = document.getElementById('toggleStatusBtn');
    
    // Disable button during request
    toggleBtn.disabled = true;
    toggleBtn.classList.add('opacity-75', 'cursor-not-allowed');
    
    fetch(`/admin/terminals/${terminalId}/toggle-status`, {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update badge and button
            if (data.isActive) {
                statusBadge.className = 'px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 text-green-800';
                statusBadge.textContent = 'Active';
                toggleBtn.className = 'px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors';
                toggleBtn.textContent = 'Deactivate';
            } else {
                statusBadge.className = 'px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-red-100 text-red-800';
                statusBadge.textContent = 'Inactive';
                toggleBtn.className = 'px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors';
                toggleBtn.textContent = 'Activate';
            }
            
            // Show success message
            showMessage(data.message, 'success');
        } else {
            showMessage(data.message, 'error');
        }
        
        // Re-enable button
        toggleBtn.disabled = false;
        toggleBtn.classList.remove('opacity-75', 'cursor-not-allowed');
    })
    .catch(error => {
        showMessage('Failed to update terminal status', 'error');
        toggleBtn.disabled = false;
        toggleBtn.classList.remove('opacity-75', 'cursor-not-allowed');
    });
}

function showMessage(message, type) {
    // Create message element if it doesn't exist
    let messageContainer = document.getElementById('messageContainer');
    if (!messageContainer) {
        messageContainer = document.createElement('div');
        messageContainer.id = 'messageContainer';
        messageContainer.className = 'fixed top-20 right-4 z-[9999]';
        messageContainer.innerHTML = `
            <div class="bg-white shadow-lg rounded-lg p-4 max-w-md min-w-[300px]">
                <div class="flex items-center">
                    <div class="flex-shrink-0" id="messageIcon"></div>
                    <div class="ml-3 flex-1">
                        <p class="text-sm font-medium text-gray-900" id="messageText"></p>
                    </div>
                    <button onclick="closeMessage()" class="ml-4 flex-shrink-0 text-gray-400 hover:text-gray-500">
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                        </svg>
                    </button>
                </div>
            </div>
        `;
        document.body.appendChild(messageContainer);
    }
    
    const icon = document.getElementById('messageIcon');
    const text = document.getElementById('messageText');
    
    if (type === 'success') {
        icon.innerHTML = `
            <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        `;
    } else {
        icon.innerHTML = `
            <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        `;
    }
    
    text.textContent = message;
    messageContainer.classList.remove('hidden');
    
    setTimeout(() => {
        messageContainer.classList.add('hidden');
    }, 4000);
}

function closeMessage() {
    const container = document.getElementById('messageContainer');
    if (container) {
        container.classList.add('hidden');
    }
}

// Close modal when clicking outside
document.getElementById('confirmModal').addEventListener('click', function(event) {
    if (event.target === this) {
        closeConfirmModal();
    }
});
</script>
{% endblock %}
