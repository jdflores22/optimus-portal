{% extends 'layout/admin_base.html.twig' %}

{% block title %}Edit Terminal — {{ terminal.name }} - OPTIMUS{% endblock %}

{% block content %}
<div class="space-y-6">
<!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('admin_terminals_index') }}">Terminals</a></li>
                            <li><a href="{{ path('admin_terminals_view', {id: terminal.id}) }}">{{ terminal.name }}</a></li>
                            <li>Edit</li>
                        </ul>
                    </div>
                    <h1 class="text-xl sm:text-2xl font-bold text-base-content truncate">Edit Terminal</h1>
                    <p class="text-sm text-base-content/60 mt-1">Update terminal information and settings</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <a href="{{ path('admin_terminals_view', {id: terminal.id}) }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--eye] size-4"></span>
                        View
                    </a>
                    <a href="{{ path('admin_terminals_index') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        <div class="max-w-2xl mx-auto">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success mb-6">
                    <span class="icon-[tabler--check] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error mb-6">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-6 sm:p-8">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="size-12 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--building] size-6 text-primary"></span>
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-lg font-semibold text-base-content truncate">{{ terminal.name }}</h2>
                            <div class="flex flex-wrap items-center gap-2 mt-1">
                                <span class="badge badge-primary badge-sm">{{ terminal.type.value }}</span>
                                <span class="badge badge-sm {{ terminal.isActive ? 'badge-success' : 'badge-error' }}" id="statusBadge">
                                    {{ terminal.isActive ? 'Active' : 'Inactive' }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <form id="terminalForm" method="POST" action="{{ path('admin_terminals_update', {id: terminal.id}) }}" class="space-y-5">
                        <div class="form-control">
                            <label class="label py-1" for="terminalName">
                                <span class="label-text font-medium">Terminal Name <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   id="terminalName"
                                   name="name"
                                   value="{{ terminal.name }}"
                                   required
                                   class="input input-bordered w-full"
                                   placeholder="e.g., ICTSI Manila">
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="terminalType">
                                <span class="label-text font-medium">Type <span class="text-error">*</span></span>
                            </label>
                            <select id="terminalType"
                                    name="type"
                                    required
                                    class="select select-bordered w-full">
                                <option value="">Select Type</option>
                                {% for type in terminalTypes %}
                                    <option value="{{ type.value }}" {{ terminal.type.value == type.value ? 'selected' : '' }}>
                                        {{ type.value }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="terminalLocation">
                                <span class="label-text font-medium">Location <span class="text-error">*</span></span>
                            </label>
                            <input type="text"
                                   id="terminalLocation"
                                   name="location"
                                   value="{{ terminal.location }}"
                                   required
                                   class="input input-bordered w-full"
                                   placeholder="e.g., Manila, Philippines">
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="terminalRegion">
                                <span class="label-text font-medium">Region</span>
                            </label>
                            <select id="terminalRegion"
                                    name="region_id"
                                    class="select select-bordered w-full">
                                <option value="">Select Region</option>
                                {% for region in regions %}
                                    <option value="{{ region.id }}" {{ terminal.region and terminal.region.id == region.id ? 'selected' : '' }}>
                                        {{ region.name }}
                                    </option>
                                {% endfor %}
                            </select>
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Select the region where this terminal is located</span>
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="terminalCity">
                                <span class="label-text font-medium">City/Municipality</span>
                            </label>
                            <select id="terminalCity"
                                    name="city_id"
                                    class="select select-bordered w-full"
                                    {{ terminal.region ? '' : 'disabled' }}>
                                <option value="">{{ terminal.region ? 'Loading cities...' : 'Select region first' }}</option>
                            </select>
                            <label class="label py-1">
                                <span class="label-text-alt text-base-content/60">Select the city or municipality</span>
                            </label>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="terminalCapacity">
                                <span class="label-text font-medium">Daily Capacity (TEU) <span class="text-error">*</span></span>
                            </label>
                            <input type="number"
                                   id="terminalCapacity"
                                   name="dailyCapacity"
                                   value="{{ terminal.dailyCapacity }}"
                                   required
                                   min="1"
                                   class="input input-bordered w-full"
                                   placeholder="e.g., 1000">
                        </div>

                        <!-- Status Toggle -->
                        <div class="bg-base-200/60 rounded-xl p-4 sm:p-5">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                                <div>
                                    <p class="text-sm font-medium text-base-content">Terminal Status</p>
                                    <p class="text-xs text-base-content/60 mt-1">Activate or deactivate this terminal</p>
                                </div>
                                <button type="button"
                                        onclick="toggleTerminalStatus()"
                                        id="toggleStatusBtn"
                                        class="btn btn-sm {{ terminal.isActive ? 'btn-warning' : 'btn-success' }} gap-2 w-full sm:w-auto">
                                    <span class="icon-[tabler--{{ terminal.isActive ? 'ban' : 'circle-check' }}] size-4"></span>
                                    {{ terminal.isActive ? 'Deactivate' : 'Activate' }}
                                </button>
                            </div>
                        </div>

                        <!-- Timestamps -->
                        <div class="bg-base-200/60 rounded-xl p-4 sm:p-5">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                                <div>
                                    <p class="text-base-content/60 flex items-center gap-1">
                                        <span class="icon-[tabler--calendar-plus] size-4"></span>
                                        Created
                                    </p>
                                    <p class="text-base-content font-medium mt-1">{{ terminal.createdAt|date('M d, Y H:i') }}</p>
                                </div>
                                <div>
                                    <p class="text-base-content/60 flex items-center gap-1">
                                        <span class="icon-[tabler--calendar-event] size-4"></span>
                                        Last Updated
                                    </p>
                                    <p class="text-base-content font-medium mt-1">{{ terminal.updatedAt|date('M d, Y H:i') }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
                            <a href="{{ path('admin_terminals_index') }}" class="btn btn-ghost w-full sm:w-auto">
                                Cancel
                            </a>
                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-primary gap-2 w-full sm:w-auto">
                                <span id="btnSpinner" class="loading loading-spinner loading-sm hidden"></span>
                                <span id="btnText">Update Terminal</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal"
     class="hidden fixed inset-0 z-[10005] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirmTitle">
    <div class="absolute inset-0 bg-black/60" onclick="closeConfirmModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div id="confirmIconWrap" class="size-14 rounded-full flex items-center justify-center mx-auto mb-4">
                <span id="confirmIcon" class="size-7"></span>
            </div>
            <h3 id="confirmTitle" class="text-lg font-bold mb-2">Confirm Action</h3>
            <p id="confirmMessage" class="text-sm text-base-content/70 mb-6">Are you sure you want to proceed?</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeConfirmModal()" class="btn btn-ghost flex-1">Cancel</button>
                <button type="button" id="confirmButton" onclick="confirmAction()" class="btn flex-1">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="terminalToastContainer" class="fixed top-20 right-4 z-[10010] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>

<script>
let pendingAction = null;
const selectedCityId = {{ terminal.city ? terminal.city.id : 'null' }};
const selectedRegionId = {{ terminal.region ? terminal.region.id : 'null' }};

document.getElementById('terminalRegion').addEventListener('change', function () {
    const regionId = this.value;
    const citySelect = document.getElementById('terminalCity');

    if (!regionId) {
        citySelect.innerHTML = '<option value="">Select region first</option>';
        citySelect.disabled = true;
        return;
    }

    citySelect.innerHTML = '<option value="">Loading cities...</option>';
    citySelect.disabled = true;

    fetch('/api/locations/cities/' + regionId)
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success && data.cities) {
                citySelect.innerHTML = '<option value="">Select City/Municipality</option>';
                data.cities.forEach(function (city) {
                    const option = document.createElement('option');
                    option.value = city.id;
                    option.textContent = city.name;
                    citySelect.appendChild(option);
                });
                citySelect.disabled = false;
            } else {
                citySelect.innerHTML = '<option value="">No cities found</option>';
            }
        })
        .catch(function (error) {
            console.error('Error loading cities:', error);
            citySelect.innerHTML = '<option value="">Error loading cities</option>';
        });
});

window.addEventListener('DOMContentLoaded', function () {
    if (selectedRegionId) {
        const citySelect = document.getElementById('terminalCity');

        fetch('/api/locations/cities/' + selectedRegionId)
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.success && data.cities) {
                    citySelect.innerHTML = '<option value="">Select City/Municipality</option>';
                    data.cities.forEach(function (city) {
                        const option = document.createElement('option');
                        option.value = city.id;
                        option.textContent = city.name;
                        if (selectedCityId && city.id === selectedCityId) {
                            option.selected = true;
                        }
                        citySelect.appendChild(option);
                    });
                    citySelect.disabled = false;
                } else {
                    citySelect.innerHTML = '<option value="">No cities found</option>';
                }
            })
            .catch(function (error) {
                console.error('Error loading cities:', error);
                citySelect.innerHTML = '<option value="">Error loading cities</option>';
            });
    }
});

document.getElementById('terminalForm').addEventListener('submit', function (e) {
    e.preventDefault();

    document.getElementById('confirmTitle').textContent = 'Update Terminal';
    document.getElementById('confirmMessage').textContent = 'Are you sure you want to save these changes to the terminal?';

    setConfirmModalStyle('primary', 'icon-[tabler--device-floppy]', 'btn-primary', 'Save Changes');

    pendingAction = 'update';
    openConfirmModal();
});

function toggleTerminalStatus() {
    const statusBadge = document.getElementById('statusBadge');
    const isActive = statusBadge.textContent.trim() === 'Active';

    document.getElementById('confirmTitle').textContent = isActive ? 'Deactivate Terminal' : 'Activate Terminal';
    document.getElementById('confirmMessage').textContent = isActive
        ? 'Are you sure you want to deactivate this terminal? It will no longer be available for operations.'
        : 'Are you sure you want to activate this terminal?';

    setConfirmModalStyle('warning', 'icon-[tabler--alert-triangle]', 'btn-warning', isActive ? 'Deactivate' : 'Activate');

    pendingAction = 'toggle';
    openConfirmModal();
}

function setConfirmModalStyle(iconBg, iconClass, btnClass, btnText) {
    const iconWrap = document.getElementById('confirmIconWrap');
    const icon = document.getElementById('confirmIcon');
    const confirmBtn = document.getElementById('confirmButton');

    if (iconBg === 'primary') {
        iconWrap.className = 'size-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4';
        icon.className = iconClass + ' size-7 text-primary';
    } else {
        iconWrap.className = 'size-14 bg-warning/10 rounded-full flex items-center justify-center mx-auto mb-4';
        icon.className = iconClass + ' size-7 text-warning';
    }

    confirmBtn.className = 'btn ' + btnClass + ' flex-1';
    confirmBtn.textContent = btnText;
}

function openConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    pendingAction = null;
}

function confirmAction() {
    if (pendingAction === 'update') {
        submitForm();
    } else if (pendingAction === 'toggle') {
        executeToggleStatus();
    }
    closeConfirmModal();
}

function submitForm() {
    const form = document.getElementById('terminalForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    submitBtn.disabled = true;
    btnText.textContent = 'Updating...';
    btnSpinner.classList.remove('hidden');

    form.submit();
}

function executeToggleStatus() {
    const terminalId = {{ terminal.id }};
    const statusBadge = document.getElementById('statusBadge');
    const toggleBtn = document.getElementById('toggleStatusBtn');

    toggleBtn.disabled = true;

    fetch('/admin/terminals/' + terminalId + '/toggle-status', { method: 'POST' })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                if (data.isActive) {
                    statusBadge.className = 'badge badge-sm badge-success';
                    statusBadge.textContent = 'Active';
                    toggleBtn.className = 'btn btn-sm btn-warning gap-2 w-full sm:w-auto';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--ban] size-4"></span> Deactivate';
                } else {
                    statusBadge.className = 'badge badge-sm badge-error';
                    statusBadge.textContent = 'Inactive';
                    toggleBtn.className = 'btn btn-sm btn-success gap-2 w-full sm:w-auto';
                    toggleBtn.innerHTML = '<span class="icon-[tabler--circle-check] size-4"></span> Activate';
                }

                showNotification(data.message, 'success');
            } else {
                showNotification(data.message, 'error');
            }

            toggleBtn.disabled = false;
        })
        .catch(function () {
            showNotification('Failed to update terminal status', 'error');
            toggleBtn.disabled = false;
        });
}

function showNotification(message, type) {
    const container = document.getElementById('terminalToastContainer');
    if (!container) return;

    const typeClass = type === 'success' ? 'alert-success' : 'alert-error';
    const icon = type === 'success' ? 'icon-[tabler--check]' : 'icon-[tabler--alert-circle]';
    const toast = document.createElement('div');
    toast.className = 'alert ' + typeClass + ' shadow-lg pointer-events-auto';
    toast.innerHTML = '<span class="' + icon + ' size-5"></span><span>' + message + '</span>';
    container.appendChild(toast);

    window.setTimeout(function () {
        toast.remove();
    }, 4000);
}
</script>
{% endblock %}
