{% extends 'layout/admin_base.html.twig' %}

{% block title %}Terminal Utilization — {{ terminal.name }} - OPTIMUS{% endblock %}

{% block content %}
<div class="space-y-6">
<!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-1">
                        <ul>
                            <li><a href="{{ path('admin_terminals_index') }}">Terminals</a></li>
                            <li>{{ terminal.name }}</li>
                        </ul>
                    </div>
                    <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content truncate">{{ terminal.name }}</h1>
                    <p class="text-sm text-base-content/60 mt-1">Terminal capacity allocation and utilization overview</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <a href="{{ path('admin_terminals_edit', {id: terminal.id}) }}" class="btn btn-primary btn-sm gap-2">
                        <span class="icon-[tabler--edit] size-4"></span>
                        Edit
                    </a>
                    <a href="{{ path('admin_terminals_index') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-6">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-6">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Terminal Info -->
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-body p-4 sm:p-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
                    <div>
                        <p class="text-xs sm:text-sm text-base-content/60">Terminal Name</p>
                        <p class="text-base sm:text-lg font-semibold text-base-content mt-1">{{ terminal.name }}</p>
                    </div>
                    <div>
                        <p class="text-xs sm:text-sm text-base-content/60">Location</p>
                        <p class="text-base sm:text-lg font-semibold text-base-content mt-1">{{ terminal.location }}</p>
                    </div>
                    <div>
                        <p class="text-xs sm:text-sm text-base-content/60">Region</p>
                        <p class="text-base font-semibold text-base-content mt-1">
                            {% if terminal.region %}
                                {{ terminal.region.name }}
                                {% if terminal.city %}
                                    <span class="block text-sm font-normal text-base-content/60">{{ terminal.city.name }}</span>
                                {% endif %}
                            {% else %}
                                <span class="text-base-content/40">—</span>
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <p class="text-xs sm:text-sm text-base-content/60">Type</p>
                        <span class="badge badge-primary badge-sm mt-1">{{ terminal.type.value }}</span>
                    </div>
                    <div>
                        <p class="text-xs sm:text-sm text-base-content/60">Status</p>
                        <span class="badge badge-sm mt-1 {{ terminal.isActive ? 'badge-success' : 'badge-error' }}">
                            {{ terminal.isActive ? 'Active' : 'Inactive' }}
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Capacity Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-primary/10 text-primary rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--stack-2] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Total Capacity</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ terminal.dailyCapacity }}</p>
                            <p class="text-xs text-primary font-medium">TEU</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-success/10 text-success rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--chart-pie] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Allocated</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ totalAllocated }}</p>
                            <p class="text-xs text-success font-medium">TEU</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-warning/10 text-warning rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--clock] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Available</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ availableCapacity }}</p>
                            <p class="text-xs text-warning font-medium">TEU</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 sm:size-12 bg-secondary/10 text-secondary rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--chart-bar] size-5 sm:size-6"></span>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Utilization</p>
                            <p class="text-2xl sm:text-3xl font-bold text-base-content">{{ utilizationPercentage|number_format(1) }}%</p>
                            <p class="text-xs text-secondary font-medium">of capacity</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Utilization Progress -->
        {% set progressClass = utilizationPercentage >= 90 ? 'progress-error' : (utilizationPercentage >= 70 ? 'progress-warning' : 'progress-success') %}
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-body p-4 sm:p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
                    <h3 class="text-base sm:text-lg font-semibold text-base-content">Capacity Utilization</h3>
                    <span class="text-sm text-base-content/60">{{ totalAllocated }} / {{ terminal.dailyCapacity }} TEU</span>
                </div>
                <progress class="progress {{ progressClass }} w-full h-4"
                          value="{{ utilizationPercentage > 100 ? 100 : utilizationPercentage }}"
                          max="100"></progress>
                <div class="flex justify-between mt-2 text-xs sm:text-sm text-base-content/60">
                    <span>0 TEU</span>
                    <span class="font-medium text-base-content">{{ utilizationPercentage|number_format(1) }}% used</span>
                    <span>{{ terminal.dailyCapacity }} TEU</span>
                </div>
            </div>
        </div>

        <!-- Shipping Line Allocations -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5">
                <div>
                    <h3 class="card-title text-base sm:text-lg">Shipping Line Allocations</h3>
                    <p class="text-sm text-base-content/60 mt-1">Container yard capacity allocated to each shipping line</p>
                </div>
                {% if allocations|length > 0 %}
                    <span class="badge badge-ghost">{{ allocations|length }} allocation{{ allocations|length != 1 ? 's' : '' }}</span>
                {% endif %}
            </div>

            {% if allocations|length > 0 %}
                <div class="card-body p-4 sm:p-6 pt-0">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
                        {% for allocation in allocations %}
                            {% set allocationPercentage = (allocation.allocatedCapacity / terminal.dailyCapacity * 100) %}
                            {% if allocationPercentage >= 100 %}
                                {% set cardBorder = 'border-error/30' %}
                                {% set statBg = 'bg-error/10' %}
                                {% set statText = 'text-error' %}
                                {% set progressClass = 'progress-error' %}
                            {% elseif allocationPercentage >= 80 %}
                                {% set cardBorder = 'border-warning/30' %}
                                {% set statBg = 'bg-warning/10' %}
                                {% set statText = 'text-warning' %}
                                {% set progressClass = 'progress-warning' %}
                            {% else %}
                                {% set cardBorder = 'border-success/30' %}
                                {% set statBg = 'bg-success/10' %}
                                {% set statText = 'text-success' %}
                                {% set progressClass = 'progress-success' %}
                            {% endif %}

                            <div class="card bg-base-200/50 border {{ cardBorder }} shadow-sm">
                                <div class="card-body p-4 sm:p-5">
                                    <div class="mb-4">
                                        <h4 class="text-base sm:text-lg font-bold text-base-content">
                                            {{ allocation.staffUser.managedShippingLine ? allocation.staffUser.managedShippingLine.brandName : allocation.staffUser.fullName }}
                                        </h4>
                                        <p class="text-sm text-base-content/60 flex items-center gap-1 mt-1">
                                            <span class="icon-[tabler--calendar] size-4"></span>
                                            Allocated on {{ allocation.createdAt|date('M d, Y') }}
                                        </p>
                                    </div>

                                    <div class="grid grid-cols-2 gap-3 mb-4">
                                        <div class="bg-primary/10 rounded-xl p-3">
                                            <p class="text-xs text-primary font-medium mb-1">Allocated TEUs</p>
                                            <p class="text-2xl font-bold text-base-content">{{ allocation.allocatedCapacity }}</p>
                                        </div>
                                        <div class="{{ statBg }} rounded-xl p-3">
                                            <p class="text-xs {{ statText }} font-medium mb-1">Utilization</p>
                                            <p class="text-2xl font-bold {{ statText }}">{{ allocationPercentage|number_format(0) }}%</p>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-2 gap-3 mb-4">
                                        <div class="bg-base-100 rounded-xl p-3">
                                            <div class="flex items-center justify-between">
                                                <span class="text-xs text-base-content/60 font-medium">20ft</span>
                                                <span class="icon-[tabler--box] size-4 text-base-content/40"></span>
                                            </div>
                                            <p class="text-lg font-bold text-base-content mt-1">
                                                {{ allocation.capacity20ft }}
                                                <span class="text-sm font-normal text-base-content/50">units</span>
                                            </p>
                                        </div>
                                        <div class="bg-base-100 rounded-xl p-3">
                                            <div class="flex items-center justify-between">
                                                <span class="text-xs text-base-content/60 font-medium">40ft</span>
                                                <span class="icon-[tabler--box] size-4 text-base-content/40"></span>
                                            </div>
                                            <p class="text-lg font-bold text-base-content mt-1">
                                                {{ allocation.capacity40ft }}
                                                <span class="text-sm font-normal text-base-content/50">units</span>
                                            </p>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="flex justify-between text-xs text-base-content/60 mb-1">
                                            <span>Allocated: {{ allocation.allocatedCapacity }} TEUs</span>
                                            <span>Terminal: {{ terminal.dailyCapacity }} TEUs</span>
                                        </div>
                                        <progress class="progress {{ progressClass }} w-full h-2"
                                                  value="{{ allocationPercentage > 100 ? 100 : allocationPercentage }}"
                                                  max="100"></progress>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="card-body text-center py-12 sm:py-16">
                    <span class="icon-[tabler--package-off] size-12 sm:size-16 text-base-content/30 mx-auto"></span>
                    <h3 class="mt-4 text-base font-medium text-base-content">No Allocations Yet</h3>
                    <p class="mt-2 text-sm text-base-content/60 max-w-md mx-auto">
                        No shipping lines have been allocated capacity at this terminal yet.
                    </p>
                </div>
            {% endif %}
        </div>
{% endblock %}
