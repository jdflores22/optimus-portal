{% extends 'layout/admin_base.html.twig' %}

{% block title %}Audit Logs - OPTIMUS{% endblock %}
{% set perPage = app.request.query.get('per_page', 25)|number_format(0, '', '') %}
{% set currentPage = app.request.query.get('page', 1)|number_format(0, '', '') %}
{% set totalCount = totalLogs ?? logs|length %}
{% set totalPages = (totalCount / perPage)|round(0, 'ceil') %}
{% set hasActiveFilters = filters.start_date|default('') or filters.end_date|default('') or filters.user_id|default('') or filters.action|default('') or filters.entity_type|default('') or filters.ip_address|default('') %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li>Audit Logs</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-5 sm:space-y-6">
{# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-4">
                            <div class="size-12 rounded-xl bg-secondary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--clipboard-list] size-6 text-secondary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Audit Logs</h1>
                                <p class="text-sm text-base-content/60 mt-1">View system activity and changes</p>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </div>

        {# Stats #}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--file-text] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Total Logs</p>
                            <p class="text-2xl font-bold text-base-content">{{ logs|length }}</p>
                            <p class="text-xs text-primary/80">Latest 100 max</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-success/10 text-success rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--clock] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Latest Entry</p>
                            <p class="text-2xl font-bold text-base-content">{{ logs|length > 0 ? logs|first.timestamp|date('M j') : 'N/A' }}</p>
                            <p class="text-xs text-success/80">Most recent</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-info/10 text-info rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--bolt] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Action Types</p>
                            <p class="text-2xl font-bold text-base-content">{{ actions|length }}</p>
                            <p class="text-xs text-info/80">Distinct actions</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-accent/10 text-accent rounded-xl flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--database] size-5"></span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs text-base-content/70">Entity Types</p>
                            <p class="text-2xl font-bold text-base-content">{{ entityTypes|length }}</p>
                            <p class="text-xs text-accent/80">Tracked entities</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Filters #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-5">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--filter] size-5 text-base-content/70"></span>
                        <h3 class="font-semibold text-base text-base-content">Advanced Filters</h3>
                        {% if hasActiveFilters %}
                            <span class="badge badge-primary badge-sm">Active</span>
                        {% endif %}
                    </div>
                    <button type="button" id="auditFilterToggle" class="btn btn-ghost btn-sm gap-1">
                        <span id="auditFilterToggleText">{{ hasActiveFilters ? 'Hide Filters' : 'Show Filters' }}</span>
                        <span id="auditFilterToggleIcon" class="icon-[tabler--chevron-down] size-4 transition-transform {{ hasActiveFilters ? 'rotate-180' : '' }}"></span>
                    </button>
                </div>

                <div id="auditFilterPanel" class="{{ hasActiveFilters ? '' : 'hidden' }}">
                    <form method="GET" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            <div class="form-control">
                                <label class="label py-1" for="start_date"><span class="label-text font-medium">Start Date</span></label>
                                <input type="date" name="start_date" id="start_date" value="{{ filters.start_date ?? '' }}" class="input input-bordered w-full">
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="end_date"><span class="label-text font-medium">End Date</span></label>
                                <input type="date" name="end_date" id="end_date" value="{{ filters.end_date ?? '' }}" class="input input-bordered w-full">
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="user_id"><span class="label-text font-medium">User</span></label>
                                <select name="user_id" id="user_id" class="select select-bordered w-full">
                                    <option value="">All Users</option>
                                    {% for user in users %}
                                        <option value="{{ user.id }}" {% if filters.user_id is defined and filters.user_id == user.id %}selected{% endif %}>{{ user.email }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="action"><span class="label-text font-medium">Action Type</span></label>
                                <select name="action" id="action" class="select select-bordered w-full">
                                    <option value="">All Actions</option>
                                    {% for action in actions %}
                                        <option value="{{ action }}" {% if filters.action is defined and filters.action == action %}selected{% endif %}>{{ action|replace({'_': ' '})|title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="entity_type"><span class="label-text font-medium">Entity Type</span></label>
                                <select name="entity_type" id="entity_type" class="select select-bordered w-full">
                                    <option value="">All Entity Types</option>
                                    {% for entityType in entityTypes %}
                                        <option value="{{ entityType }}" {% if filters.entity_type is defined and filters.entity_type == entityType %}selected{% endif %}>{{ entityType }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-control">
                                <label class="label py-1" for="ip_address"><span class="label-text font-medium">IP Address</span></label>
                                <input type="text" name="ip_address" id="ip_address" value="{{ filters.ip_address ?? '' }}" placeholder="e.g., 192.168.1.1" class="input input-bordered w-full">
                            </div>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-4 border-t border-base-300">
                            <div class="flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-primary btn-sm gap-2">
                                    <span class="icon-[tabler--search] size-4"></span>
                                    Apply Filters
                                </button>
                                <a href="{{ path('app_admin_audit_logs') }}" class="btn btn-ghost btn-sm gap-2">
                                    <span class="icon-[tabler--refresh] size-4"></span>
                                    Clear All
                                </a>
                            </div>
                            <span class="text-sm text-base-content/50">Showing latest 100 results</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {# Results #}
        <div class="card bg-base-100 shadow-sm overflow-hidden">
            <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 pt-4 sm:pt-5">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="icon-[tabler--list] size-5 text-base-content/70"></span>
                    <h3 class="card-title text-base sm:text-lg">Audit Log Entries</h3>
                    <span class="badge badge-primary badge-soft">{{ logs|length }} entries</span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <div class="flex items-center gap-2">
                        <label for="per_page" class="text-sm text-base-content/70">Show</label>
                        <select id="per_page" class="select select-bordered select-sm" onchange="changePerPage(this.value)">
                            <option value="25" {{ perPage == 25 ? 'selected' : '' }}>25</option>
                            <option value="50" {{ perPage == 50 ? 'selected' : '' }}>50</option>
                            <option value="100" {{ perPage == 100 ? 'selected' : '' }}>100</option>
                        </select>
                    </div>
                    <button type="button" onclick="refreshLogs()" class="btn btn-outline btn-sm gap-1">
                        <span class="icon-[tabler--refresh] size-4"></span>
                        Refresh
                    </button>
                </div>
            </div>

            {% if logs|length > 0 %}
                {# Desktop table #}
                <div class="hidden lg:block overflow-x-auto">
                    <table class="table table-sm table-fixed">
                        <thead>
                            <tr>
                                <th class="w-[8.5rem]">Timestamp</th>
                                <th class="w-[12rem]">User</th>
                                <th class="w-[10.5rem]">Action</th>
                                <th class="w-[11rem]">Entity</th>
                                <th class="w-[20rem]">Changes</th>
                                <th class="w-[5.5rem] pl-3">IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                                <tr class="hover align-top">
                                    <td class="whitespace-nowrap text-sm align-top">
                                        <div>{{ log.timestamp|date('M j, Y') }}</div>
                                        <div class="text-xs text-base-content/50">{{ log.timestamp|date('H:i:s') }}</div>
                                    </td>
                                    <td class="align-top overflow-hidden">
                                        <div class="text-sm font-medium truncate" title="{{ log.user.email }}">{{ log.user.email }}</div>
                                        <div class="text-xs text-base-content/50 truncate">{{ log.user.role.value|replace({'_': ' '})|title }}</div>
                                    </td>
                                    <td class="align-top overflow-hidden">
                                        {% set actionBadge = 'badge-ghost' %}
                                        {% if log.action == 'status_change' %}{% set actionBadge = 'badge-info' %}
                                        {% elseif log.action == 'approval' %}{% set actionBadge = 'badge-success' %}
                                        {% elseif log.action == 'denial' %}{% set actionBadge = 'badge-error' %}
                                        {% elseif log.action == 'access' %}{% set actionBadge = 'badge-primary' %}
                                        {% endif %}
                                        <span class="badge {{ actionBadge }} badge-soft badge-sm block w-full max-w-full box-border whitespace-normal break-words text-left leading-snug h-auto min-h-6 py-1 px-2">{{ log.action|replace({'_': ' '})|title }}</span>
                                    </td>
                                    <td class="align-top overflow-hidden">
                                        <div class="text-sm font-medium truncate" title="{{ log.entityType }}">{{ log.entityType }}</div>
                                        <div class="text-xs text-base-content/50 whitespace-nowrap">ID: {{ log.entityId }}</div>
                                    </td>
                                    <td class="align-top w-[20rem] max-w-[20rem] overflow-hidden">
                                        {% if log.changes|length > 0 %}
                                            <div class="text-xs space-y-1.5 whitespace-normal [overflow-wrap:anywhere]">
                                                {% for field, change in log.changes %}
                                                    <div class="min-w-0">
                                                        <span class="font-medium">{{ field }}:</span>
                                                        {% if change.from is defined and change.to is defined %}
                                                            <span class="text-error break-all">{{ change.from }}</span>
                                                            <span class="text-base-content/40">→</span>
                                                            <span class="text-success break-all">{{ change.to }}</span>
                                                        {% else %}
                                                            <span class="text-base-content/70 break-all">{{ change|json_encode }}</span>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <span class="text-xs text-base-content/40">No changes</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-sm text-base-content/60 whitespace-nowrap align-top pl-3">{{ log.ipAddress }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Mobile / tablet cards #}
                <div class="lg:hidden p-4 space-y-3">
                    {% for log in logs %}
                        <div class="card bg-base-200 border border-base-300">
                            <div class="card-body p-4 space-y-3">
                                <div class="flex items-start justify-between gap-2">
                                    <div>
                                        <p class="text-sm font-medium text-base-content">{{ log.user.email }}</p>
                                        <p class="text-xs text-base-content/50">{{ log.timestamp|date('M j, Y H:i:s') }}</p>
                                    </div>
                                    {% set actionBadge = 'badge-ghost' %}
                                    {% if log.action == 'status_change' %}{% set actionBadge = 'badge-info' %}
                                    {% elseif log.action == 'approval' %}{% set actionBadge = 'badge-success' %}
                                    {% elseif log.action == 'denial' %}{% set actionBadge = 'badge-error' %}
                                    {% elseif log.action == 'access' %}{% set actionBadge = 'badge-primary' %}
                                    {% endif %}
                                    <span class="badge {{ actionBadge }} badge-soft badge-sm shrink-0">{{ log.action|replace({'_': ' '})|title }}</span>
                                </div>
                                <div class="text-sm">
                                    <span class="text-base-content/60">Entity:</span>
                                    <span class="font-medium">{{ log.entityType }}</span>
                                    <span class="text-base-content/50">#{{ log.entityId }}</span>
                                </div>
                                {% if log.changes|length > 0 %}
                                    <div class="text-xs bg-base-100 rounded-lg p-3 border border-base-300 space-y-1.5 overflow-hidden">
                                        {% for field, change in log.changes %}
                                            <div class="break-words">
                                                <span class="font-medium">{{ field }}:</span>
                                                {% if change.from is defined and change.to is defined %}
                                                    <span class="text-error break-all">{{ change.from }}</span> → <span class="text-success break-all">{{ change.to }}</span>
                                                {% else %}
                                                    <span class="text-base-content/70 break-all block mt-0.5">{{ change|json_encode }}</span>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                <p class="text-xs text-base-content/50 inline-flex items-center gap-1">
                                    <span class="icon-[tabler--world] size-3.5"></span>
                                    {{ log.ipAddress }}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Pagination #}
                {% if totalPages > 1 %}
                    <div class="px-4 sm:px-6 py-4 border-t border-base-300">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <p class="text-sm text-base-content/60">
                                Showing <span class="font-medium text-base-content">1</span>–<span class="font-medium text-base-content">{{ logs|length }}</span>
                                of <span class="font-medium text-base-content">{{ totalCount }}</span> results
                            </p>
                            <div class="join">
                                <a id="auditPrevPage" href="#" class="join-item btn btn-sm btn-outline audit-page-nav">
                                    <span class="icon-[tabler--chevron-left] size-4"></span>
                                </a>
                                {% for page in 1..totalPages %}
                                    {% if page <= 3 or (page >= currentPage - 1 and page <= currentPage + 1) or page >= totalPages - 1 %}
                                        {% if page == currentPage %}
                                            <span class="join-item btn btn-sm btn-primary">{{ page }}</span>
                                        {% else %}
                                            <a href="{{ path('app_admin_audit_logs', app.request.query.all|merge({'page': page})) }}" class="join-item btn btn-sm btn-outline">{{ page }}</a>
                                        {% endif %}
                                    {% elseif page == currentPage - 2 or page == currentPage + 2 %}
                                        <span class="join-item btn btn-sm btn-disabled">…</span>
                                    {% endif %}
                                {% endfor %}
                                <a id="auditNextPage" href="#" class="join-item btn btn-sm btn-outline audit-page-nav">
                                    <span class="icon-[tabler--chevron-right] size-4"></span>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="flex flex-col items-center justify-center py-16 text-center px-4">
                    <span class="icon-[tabler--clipboard-off] size-12 text-base-content/30"></span>
                    <h3 class="mt-4 text-base font-medium text-base-content">No audit logs found</h3>
                    <p class="mt-2 text-sm text-base-content/60 max-w-md">No audit logs match the current filter criteria. Try adjusting your search parameters.</p>
                    <a href="{{ path('app_admin_audit_logs') }}" class="btn btn-primary btn-sm gap-2 mt-6">
                        <span class="icon-[tabler--refresh] size-4"></span>
                        Clear Filters
                    </a>
                </div>
            {% endif %}
        </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    const currentPage = {{ currentPage }};
    const totalPages = {{ totalPages > 0 ? totalPages : 1 }};

    function toggleFilters() {
        const panel = document.getElementById('auditFilterPanel');
        const toggleText = document.getElementById('auditFilterToggleText');
        const toggleIcon = document.getElementById('auditFilterToggleIcon');
        const isHidden = panel.classList.contains('hidden');
        panel.classList.toggle('hidden');
        toggleText.textContent = isHidden ? 'Hide Filters' : 'Show Filters';
        toggleIcon.classList.toggle('rotate-180', isHidden);
    }

    document.getElementById('auditFilterToggle')?.addEventListener('click', toggleFilters);

    window.refreshLogs = function () { window.location.reload(); };

    window.changePerPage = function (perPage) {
        const url = new URL(window.location);
        url.searchParams.set('per_page', perPage);
        url.searchParams.set('page', 1);
        window.location.href = url.toString();
    };

    function getPageUrl(page) {
        const url = new URL(window.location);
        url.searchParams.set('page', page);
        return url.toString();
    }

    const prevLink = document.getElementById('auditPrevPage');
    const nextLink = document.getElementById('auditNextPage');

    if (prevLink) {
        if (currentPage > 1) {
            prevLink.href = getPageUrl(currentPage - 1);
        } else {
            prevLink.classList.add('btn-disabled');
            prevLink.addEventListener('click', function (e) { e.preventDefault(); });
        }
    }

    if (nextLink) {
        if (currentPage < totalPages) {
            nextLink.href = getPageUrl(currentPage + 1);
        } else {
            nextLink.classList.add('btn-disabled');
            nextLink.addEventListener('click', function (e) { e.preventDefault(); });
        }
    }
})();
</script>
{% endblock %}
