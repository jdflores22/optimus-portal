{% extends 'base.html.twig' %}

{% block title %}Audit Logs - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="py-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">Audit Logs</h1>
                        <p class="mt-2 text-gray-600">View system activity and changes</p>
                    </div>
                    <a href="{{ path('app_admin_dashboard') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Stats Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <!-- Total Logs -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total Logs</p>
                        <p class="text-3xl font-bold text-gray-900">{{ logs|length }}</p>
                        <p class="text-xs text-blue-600 font-medium">All entries</p>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Latest Entry</p>
                        <p class="text-3xl font-bold text-gray-900">{{ logs|length > 0 ? logs|first.timestamp|date('M j') : 'N/A' }}</p>
                        <p class="text-xs text-green-600 font-medium">Most recent</p>
                    </div>
                </div>
            </div>

            <!-- System Actions -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">System Actions</p>
                        <p class="text-3xl font-bold text-gray-900">{{ logs|length }}</p>
                        <p class="text-xs text-purple-600 font-medium">Total events</p>
                    </div>
                </div>
            </div>

            <!-- Active Users -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Active Users</p>
                        <p class="text-3xl font-bold text-gray-900">{{ logs|length }}</p>
                        <p class="text-xs text-indigo-600 font-medium">In logs</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Advanced Filters -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-8">
            <div class="px-6 py-4 border-b border-gray-100">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"></path>
                        </svg>
                        <h3 class="text-lg font-semibold text-gray-900">Advanced Filters</h3>
                    </div>
                    <button type="button" onclick="toggleFilters()" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
                        <span id="filter-toggle-text">Show Filters</span>
                        <svg id="filter-toggle-icon" class="w-4 h-4 ml-1 inline-block transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <div id="filter-panel" class="hidden">
                <div class="p-6">
                    <form method="GET" class="space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <div class="space-y-2">
                                <label for="start_date" class="block text-sm font-semibold text-gray-700">Start Date</label>
                                <div class="relative">
                                    <input type="date" name="start_date" id="start_date" value="{{ filters.start_date ?? '' }}" class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-colors">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <label for="end_date" class="block text-sm font-semibold text-gray-700">End Date</label>
                                <div class="relative">
                                    <input type="date" name="end_date" id="end_date" value="{{ filters.end_date ?? '' }}" class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-colors">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <label for="user_id" class="block text-sm font-semibold text-gray-700">User</label>
                                <div class="relative">
                                    <select name="user_id" id="user_id" class="block w-full pl-10 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-lg shadow-sm transition-colors">
                                        <option value="">All Users</option>
                                        {% for user in users %}
                                            <option value="{{ user.id }}" {% if filters.user_id is defined and filters.user_id == user.id %}selected{% endif %}>
                                                {{ user.email }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <label for="action" class="block text-sm font-semibold text-gray-700">Action Type</label>
                                <div class="relative">
                                    <select name="action" id="action" class="block w-full pl-10 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-lg shadow-sm transition-colors">
                                        <option value="">All Actions</option>
                                        {% for action in actions %}
                                            <option value="{{ action }}" {% if filters.action is defined and filters.action == action %}selected{% endif %}>
                                                {{ action|title }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <label for="entity_type" class="block text-sm font-semibold text-gray-700">Entity Type</label>
                                <div class="relative">
                                    <select name="entity_type" id="entity_type" class="block w-full pl-10 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-lg shadow-sm transition-colors">
                                        <option value="">All Entity Types</option>
                                        {% for entityType in entityTypes %}
                                            <option value="{{ entityType }}" {% if filters.entity_type is defined and filters.entity_type == entityType %}selected{% endif %}>
                                                {{ entityType }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <label for="ip_address" class="block text-sm font-semibold text-gray-700">IP Address</label>
                                <div class="relative">
                                    <input type="text" name="ip_address" id="ip_address" value="{{ filters.ip_address ?? '' }}" placeholder="e.g., 192.168.1.1" class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-colors">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pt-6 border-t border-gray-200">
                            <div class="flex space-x-3">
                                <button type="submit" class="inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all shadow-sm">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                    </svg>
                                    Apply Filters
                                </button>
                                <a href="{{ path('app_admin_audit_logs') }}" class="inline-flex items-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors shadow-sm">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                    </svg>
                                    Clear All
                                </a>
                            </div>
                            <div class="mt-3 sm:mt-0">
                                <span class="text-sm text-gray-500">Showing latest 100 results</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Results Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-center space-x-3">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                        <h3 class="text-lg font-semibold text-gray-900">Audit Log Entries</h3>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            {{ logs|length }} entries
                        </span>
                    </div>
                    <div class="mt-3 sm:mt-0 flex items-center space-x-3">
                        <div class="flex items-center space-x-2">
                            <label for="per_page" class="text-sm font-medium text-gray-700">Show:</label>
                            <select id="per_page" onchange="changePerPage(this.value)" class="text-sm border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500">
                                <option value="25" {{ app.request.query.get('per_page', 25) == 25 ? 'selected' : '' }}>25</option>
                                <option value="50" {{ app.request.query.get('per_page', 25) == 50 ? 'selected' : '' }}>50</option>
                                <option value="100" {{ app.request.query.get('per_page', 25) == 100 ? 'selected' : '' }}>100</option>
                            </select>
                        </div>
                        <button onclick="refreshLogs()" class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            Refresh
                        </button>
                    </div>
                </div>
            </div>
            
            {% if logs|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Timestamp
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    User
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Action
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Entity
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Changes
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    IP Address
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for log in logs %}
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        {{ log.timestamp|date('M j, Y H:i:s') }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-gray-900">{{ log.user.email }}</div>
                                        <div class="text-sm text-gray-500">{{ log.user.role.value|replace({'_': ' '})|title }}</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        {% set actionClass = 'bg-gray-100 text-gray-800' %}
                                        {% if log.action == 'status_change' %}
                                            {% set actionClass = 'bg-blue-100 text-blue-800' %}
                                        {% elseif log.action == 'approval' %}
                                            {% set actionClass = 'bg-green-100 text-green-800' %}
                                        {% elseif log.action == 'denial' %}
                                            {% set actionClass = 'bg-red-100 text-red-800' %}
                                        {% elseif log.action == 'access' %}
                                            {% set actionClass = 'bg-indigo-100 text-indigo-800' %}
                                        {% endif %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ actionClass }}">
                                            {{ log.action|title }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-gray-900">{{ log.entityType }}</div>
                                        <div class="text-sm text-gray-500">ID: {{ log.entityId }}</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        {% if log.changes|length > 0 %}
                                            <div class="text-sm text-gray-900">
                                                {% for field, change in log.changes %}
                                                    <div class="mb-1">
                                                        <span class="font-medium">{{ field }}:</span>
                                                        {% if change.from is defined and change.to is defined %}
                                                            <span class="text-red-600">{{ change.from }}</span> → 
                                                            <span class="text-green-600">{{ change.to }}</span>
                                                        {% else %}
                                                            {{ change|json_encode }}
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <span class="text-gray-500 text-sm">No changes recorded</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        {{ log.ipAddress }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="px-6 py-16 text-center">
                    <div class="mx-auto h-24 w-24 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                        <svg class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No audit logs found</h3>
                    <p class="text-gray-500 mb-6">No audit logs match the current filter criteria. Try adjusting your search parameters.</p>
                    <a href="{{ path('app_admin_audit_logs') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-blue-700 bg-blue-100 hover:bg-blue-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        Clear Filters
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- Pagination -->
        {% if logs|length > 0 %}
            <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
                <div class="flex-1 flex justify-between sm:hidden">
                    <!-- Mobile pagination -->
                    <a href="#" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        Previous
                    </a>
                    <a href="#" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        Next
                    </a>
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing
                            <span class="font-medium">1</span>
                            to
                            <span class="font-medium">{{ logs|length }}</span>
                            of
                            <span class="font-medium">{{ totalLogs ?? logs|length }}</span>
                            results
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <!-- Previous Page Link -->
                            <a href="#" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                <span class="sr-only">Previous</span>
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                            </a>
                            
                            <!-- Page Numbers -->
                            {% set currentPage = app.request.query.get('page', 1)|number_format(0, '', '') %}
                            {% set totalPages = ((totalLogs ?? logs|length) / 25)|round(0, 'ceil') %}
                            
                            {% for page in 1..totalPages %}
                                {% if page <= 7 or (page >= currentPage - 2 and page <= currentPage + 2) or page >= totalPages - 2 %}
                                    {% if page == currentPage %}
                                        <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-blue-50 text-sm font-medium text-blue-600">
                                            {{ page }}
                                        </span>
                                    {% else %}
                                        <a href="{{ path('app_admin_audit_logs', app.request.query.all|merge({'page': page})) }}" class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                            {{ page }}
                                        </a>
                                    {% endif %}
                                {% elseif page == currentPage - 3 or page == currentPage + 3 %}
                                    <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                                        ...
                                    </span>
                                {% endif %}
                            {% endfor %}
                            
                            <!-- Next Page Link -->
                            <a href="#" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                <span class="sr-only">Next</span>
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        </nav>
                    </div>
                </div>
            </div>
        {% endif %}
        </div>
    </div>
</div>

<!-- JavaScript for Enhanced Functionality -->
<script>
function toggleFilters() {
    const panel = document.getElementById('filter-panel');
    const toggleText = document.getElementById('filter-toggle-text');
    const toggleIcon = document.getElementById('filter-toggle-icon');
    
    if (panel.classList.contains('hidden')) {
        panel.classList.remove('hidden');
        toggleText.textContent = 'Hide Filters';
        toggleIcon.classList.add('rotate-180');
    } else {
        panel.classList.add('hidden');
        toggleText.textContent = 'Show Filters';
        toggleIcon.classList.remove('rotate-180');
    }
}

function refreshLogs() {
    window.location.reload();
}

function changePerPage(perPage) {
    const url = new URL(window.location);
    url.searchParams.set('per_page', perPage);
    url.searchParams.set('page', 1); // Reset to first page
    window.location.href = url.toString();
}

function goToPage(page) {
    const url = new URL(window.location);
    url.searchParams.set('page', page);
    window.location.href = url.toString();
}

function exportLogs() {
    // Create a simple CSV export
    const logs = {{ logs|json_encode|raw }};
    let csv = 'Timestamp,User,Role,Action,Entity Type,Entity ID,IP Address\n';
    
    logs.forEach(log => {
        csv += `"${log.timestamp}","${log.user.email}","${log.user.role.value}","${log.action}","${log.entityType}","${log.entityId}","${log.ipAddress}"\n`;
    });
    
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `audit_logs_${new Date().toISOString().split('T')[0]}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
}

function viewLogDetails(logId) {
    // This would typically open a modal or navigate to a detail page
    alert('View details for log ID: ' + logId);
}

function exportLogEntry(logId) {
    // Export individual log entry
    alert('Export log entry ID: ' + logId);
}

// Auto-refresh functionality (optional)
let autoRefresh = false;
let refreshInterval;

function toggleAutoRefresh() {
    if (autoRefresh) {
        clearInterval(refreshInterval);
        autoRefresh = false;
    } else {
        refreshInterval = setInterval(refreshLogs, 30000); // Refresh every 30 seconds
        autoRefresh = true;
    }
}

// Initialize tooltips and other interactive elements
document.addEventListener('DOMContentLoaded', function() {
    // Add any initialization code here
    console.log('Audit Logs page loaded');
    
    // Update pagination links
    updatePaginationLinks();
});

function updatePaginationLinks() {
    const currentPage = {{ app.request.query.get('page', 1) }};
    const totalPages = {{ ((totalLogs ?? logs|length) / (app.request.query.get('per_page', 25)))|round(0, 'ceil') }};
    
    // Update Previous/Next links - find by text content instead of :contains()
    const allLinks = document.querySelectorAll('a[href="#"]');
    const prevLinks = Array.from(allLinks).filter(link => link.textContent.includes('Previous'));
    const nextLinks = Array.from(allLinks).filter(link => link.textContent.includes('Next'));
    
    prevLinks.forEach(link => {
        if (currentPage > 1) {
            link.href = getPageUrl(currentPage - 1);
            link.classList.remove('cursor-not-allowed', 'opacity-50');
        } else {
            link.classList.add('cursor-not-allowed', 'opacity-50');
            link.onclick = (e) => e.preventDefault();
        }
    });
    
    nextLinks.forEach(link => {
        if (currentPage < totalPages) {
            link.href = getPageUrl(currentPage + 1);
            link.classList.remove('cursor-not-allowed', 'opacity-50');
        } else {
            link.classList.add('cursor-not-allowed', 'opacity-50');
            link.onclick = (e) => e.preventDefault();
        }
    });
}

function getPageUrl(page) {
    const url = new URL(window.location);
    url.searchParams.set('page', page);
    return url.toString();
}
</script>

{% endblock %}