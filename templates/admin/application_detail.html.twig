{% extends 'layout/admin_base.html.twig' %}

{% block title %}Application Review - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li><a href="{{ path('app_admin_approved_accreditations') }}">Accreditations</a></li>
                                <li>Application #{{ submission.id }}</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
<div class="space-y-5 sm:space-y-6 max-w-5xl mx-auto">

        {# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-start gap-4">
                            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--file-description] size-6 text-primary"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Application #{{ submission.id }}</h1>
                                <p class="text-sm text-base-content/60 mt-1">
                                    Submitted {{ submission.submittedAt|date('F d, Y \\a\\t g:i A') }}
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                        {% set statusBadge = 'badge-ghost' %}
                        {% if submission.status.value == 'APPROVED' %}
                            {% set statusBadge = 'badge-success' %}
                        {% elseif submission.status.value in ['DENIED', 'REJECTED'] %}
                            {% set statusBadge = 'badge-error' %}
                        {% elseif submission.status.value == 'PENDING' %}
                            {% set statusBadge = 'badge-warning' %}
                        {% elseif submission.status.value == 'COMPLIANCE_REQUIRED' %}
                            {% set statusBadge = 'badge-warning' %}
                        {% else %}
                            {% set statusBadge = 'badge-info' %}
                        {% endif %}
                        <span class="badge {{ statusBadge }} badge-lg">{{ submission.status.value|replace({'_': ' '})|title }}</span>
                        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm gap-2">
                            <span class="icon-[tabler--arrow-left] size-4"></span>
                            Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# Applicant information #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                <div class="flex items-center gap-2">
                    <span class="icon-[tabler--user] size-5 text-base-content/70"></span>
                    <h2 class="card-title text-base sm:text-lg">Applicant Information</h2>
                </div>
            </div>
            <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text font-medium text-base-content/70">Email Address</span></label>
                        <p class="text-sm text-base-content">{{ submission.applicant.email }}</p>
                    </div>
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text font-medium text-base-content/70">User Role</span></label>
                        {% set roleBadge = submission.applicant.role.value == 'BROKER' ? 'badge-primary' : (submission.applicant.role.value == 'CONSIGNEE' ? 'badge-secondary' : 'badge-ghost') %}
                        <span class="badge {{ roleBadge }} badge-soft w-fit">{{ submission.applicant.role.value|replace({'_': ' '})|title }}</span>
                    </div>
                    {% if submission.applicant.role.value == 'BROKER' %}
                        <div class="form-control">
                            <label class="label py-1"><span class="label-text font-medium text-base-content/70">Full Name</span></label>
                            <p class="text-sm text-base-content">{{ submission.applicant.fullName }}</p>
                        </div>
                    {% elseif submission.applicant.role.value == 'CONSIGNEE' %}
                        <div class="form-control">
                            <label class="label py-1"><span class="label-text font-medium text-base-content/70">Business Name</span></label>
                            <p class="text-sm text-base-content">{{ submission.applicant.businessName }}</p>
                        </div>
                    {% endif %}
                    {% if submission.applicant.linkedBroker is defined and submission.applicant.linkedBroker %}
                        <div class="form-control">
                            <label class="label py-1"><span class="label-text font-medium text-base-content/70">Linked Broker</span></label>
                            <p class="text-sm text-base-content">{{ submission.applicant.linkedBroker.fullName }}</p>
                        </div>
                    {% endif %}
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text font-medium text-base-content/70">Account Status</span></label>
                        {% set acctBadge = submission.applicant.status.value == 'APPROVED' ? 'badge-success' : (submission.applicant.status.value == 'PENDING' ? 'badge-warning' : 'badge-error') %}
                        <span class="badge {{ acctBadge }} badge-soft w-fit">{{ submission.applicant.status.value|title }}</span>
                    </div>
                    <div class="form-control">
                        <label class="label py-1"><span class="label-text font-medium text-base-content/70">Account Created</span></label>
                        <p class="text-sm text-base-content">{{ submission.applicant.createdAt|date('M d, Y') }}</p>
                    </div>
                </div>
            </div>
        </div>

        {# Application details #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                <div class="flex items-center gap-2">
                    <span class="icon-[tabler--clipboard-list] size-5 text-base-content/70"></span>
                    <h2 class="card-title text-base sm:text-lg">Application Details</h2>
                </div>
            </div>
            <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                {% if submission.submittedData and submission.formConfig %}
                    {% set formFields = submission.formConfig.fields.fields %}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                        {% for key, value in submission.submittedData %}
                            {% if key != '_files' and key != '_csrf_token' %}
                                {% set fieldLabel = key|replace({'_': ' '})|title %}
                                {% set fieldType = 'text' %}
                                {% for field in formFields %}
                                    {% if field.id == key %}
                                        {% set fieldLabel = field.label %}
                                        {% set fieldType = field.type %}
                                    {% endif %}
                                {% endfor %}

                                <div class="form-control">
                                    <label class="label py-1"><span class="label-text font-medium text-base-content/70">{{ fieldLabel }}</span></label>

                                    {% if fieldType == 'checkbox' %}
                                        {% set fieldConfig = null %}
                                        {% for field in formFields %}
                                            {% if field.id == key %}
                                                {% set fieldConfig = field %}
                                            {% endif %}
                                        {% endfor %}

                                        {% if fieldConfig and fieldConfig.validation is defined and fieldConfig.validation.options is defined %}
                                            {% if value is iterable and value is not same as(value|join('')) %}
                                                <div class="flex flex-wrap gap-2">
                                                    {% for optionValue, optionLabel in fieldConfig.validation.options %}
                                                        {% if optionValue in value %}
                                                            <span class="badge badge-primary badge-soft">{{ optionLabel }}</span>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                <p class="text-sm text-base-content/50 italic">No options selected</p>
                                            {% endif %}
                                        {% else %}
                                            {% if value == '1' or value == 1 or value == true %}
                                                <span class="badge badge-success badge-soft gap-1 w-fit">
                                                    <span class="icon-[tabler--check] size-3.5"></span>
                                                    Accepted
                                                </span>
                                            {% else %}
                                                <span class="badge badge-error badge-soft gap-1 w-fit">
                                                    <span class="icon-[tabler--x] size-3.5"></span>
                                                    Not Accepted
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    {% elseif fieldType == 'checkbox_group' %}
                                        {% if value is iterable and value is not same as(value|join('')) %}
                                            <div class="flex flex-wrap gap-2">
                                                {% for item in value %}
                                                    <span class="badge badge-primary badge-soft">{{ item }}</span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <p class="text-sm text-base-content/50 italic">No options selected</p>
                                        {% endif %}
                                    {% elseif fieldType == 'select' and value is iterable and value is not same as(value|join('')) %}
                                        <div class="flex flex-wrap gap-2">
                                            {% for item in value %}
                                                <span class="badge badge-secondary badge-soft">{{ item }}</span>
                                            {% endfor %}
                                        </div>
                                    {% elseif value is iterable and value is not same as(value|join('')) %}
                                        <div class="flex flex-wrap gap-2">
                                            {% for item in value %}
                                                <span class="badge badge-ghost">{{ item }}</span>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <div class="bg-base-200 rounded-lg p-3 border border-base-300">
                                            <p class="text-sm text-base-content">{{ value }}</p>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-sm text-base-content/50">No form data available</p>
                {% endif %}
            </div>
        </div>

        {# Evaluator information #}
        {% if submission.evaluator and submission.evaluatedAt %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--user-check] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Evaluator Information</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <div class="flex items-start gap-4">
                        <div class="size-12 rounded-full {{ avatar_colors(submission.evaluator) }} flex items-center justify-center shrink-0">
                            <span class="text-sm font-semibold">{{ submission.evaluator.email|slice(0, 2)|upper }}</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-base font-semibold text-base-content">{{ submission.evaluator.email }}</p>
                            <p class="text-sm text-base-content/60 mt-1">Evaluated {{ submission.evaluatedAt|date('F d, Y \\a\\t g:i A') }}</p>
                            {% if submission.denialReason %}
                                <div class="mt-4 alert alert-info">
                                    <span class="icon-[tabler--message] size-5 shrink-0"></span>
                                    <div>
                                        <p class="text-sm font-medium">Evaluation Comments</p>
                                        <p class="text-sm mt-1">{{ submission.denialReason }}</p>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Supporting documents #}
        {% if submission.submittedData._files is defined and submission.submittedData._files|length > 0 %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--files] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Supporting Documents</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {% for fieldName, fileId in submission.submittedData._files %}
                            {% set documentName = '' %}
                            {% if fieldName == 'broker_license_document' %}
                                {% set documentName = 'Broker License Document' %}
                            {% elseif fieldName == 'company_registration' %}
                                {% set documentName = 'Company Registration Certificate' %}
                            {% elseif fieldName == 'representative_id' %}
                                {% set documentName = 'Representative ID Document' %}
                            {% elseif fieldName == 'financial_guarantee' %}
                                {% set documentName = 'Financial Guarantee Document' %}
                            {% elseif fieldName == 'professional_indemnity' %}
                                {% set documentName = 'Professional Indemnity Insurance' %}
                            {% elseif fieldName == 'business_license' %}
                                {% set documentName = 'Business License Document' %}
                            {% elseif fieldName == 'insurance_certificate' %}
                                {% set documentName = 'Insurance Certificate' %}
                            {% else %}
                                {% set documentName = fieldName|title %}
                            {% endif %}

                            <div class="card bg-base-200 border border-base-300 hover:shadow-md transition-shadow">
                                <div class="card-body p-4">
                                    <div class="flex items-start gap-3">
                                        <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                                            <span class="icon-[tabler--file-text] size-5 text-primary"></span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-base-content">{{ documentName }}</p>
                                            <p class="text-xs text-base-content/50 mt-1">ID: {{ fileId }}</p>
                                            <div class="flex flex-wrap gap-2 mt-3">
                                                <button type="button"
                                                        class="view-document-btn btn btn-outline btn-primary btn-xs gap-1"
                                                        data-file-id="{{ fileId }}"
                                                        data-document-name="{{ documentName }}">
                                                    <span class="icon-[tabler--eye] size-3.5"></span>
                                                    View
                                                </button>
                                                <a href="{{ path('app_admin_file_download', {fileId: fileId}) }}"
                                                   class="btn btn-ghost btn-xs gap-1">
                                                    <span class="icon-[tabler--download] size-3.5"></span>
                                                    Download
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {# Final decision form or status #}
        {% if submission.status.value == 'APPROVED' and submission.evaluator and not submission.finalApprover %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--gavel] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Final Decision</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                    <form method="POST" action="{{ path('app_admin_approve', {id: submission.id}) }}" id="finalApprovalForm" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_approve') }}">

                        <div class="form-control">
                            <label class="label py-1" for="decision">
                                <span class="label-text font-medium">Decision <span class="text-error">*</span></span>
                            </label>
                            <select id="decision" name="decision" required class="select select-bordered w-full">
                                <option value="">Select a decision...</option>
                                <option value="approve">Approve — Grant full system access</option>
                                <option value="deny">Deny — Reject application</option>
                            </select>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="reason">
                                <span class="label-text font-medium">Reason / Comments</span>
                            </label>
                            <textarea id="reason" name="reason" rows="4"
                                      class="textarea textarea-bordered w-full"
                                      placeholder="Provide reason for denial or additional comments..."></textarea>
                            <label class="label py-1"><span class="label-text-alt">Required for denials</span></label>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3 pt-2">
                            <button type="submit" id="submitBtn" class="btn btn-primary flex-1 gap-2">
                                <span id="submitText">Submit Final Decision</span>
                                <span id="loadingText" class="hidden gap-2 items-center">
                                    <span class="loading loading-spinner loading-sm"></span>
                                    Processing...
                                </span>
                            </button>
                            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost flex-1">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        {% elseif submission.finalApprover %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--gavel] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Final Decision</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-4">
                    {% if submission.applicant.status.value == 'APPROVED' %}
                        <div class="alert alert-success">
                            <span class="icon-[tabler--circle-check] size-5"></span>
                            <div>
                                <p class="font-medium">Application Finally Approved</p>
                                <p class="text-sm opacity-80">Full system access granted</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-error">
                            <span class="icon-[tabler--x] size-5"></span>
                            <div>
                                <p class="font-medium">Application Finally Denied</p>
                                <p class="text-sm opacity-80">Application has been rejected</p>
                            </div>
                        </div>
                    {% endif %}

                    <div class="flex items-center gap-3 p-4 bg-base-200 rounded-xl">
                        <div class="size-10 rounded-full {{ avatar_colors(submission.finalApprover) }} flex items-center justify-center shrink-0">
                            <span class="text-sm font-semibold">{{ submission.finalApprover.email|slice(0, 2)|upper }}</span>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-base-content">Final decision by {{ submission.finalApprover.email }}</p>
                            {% if submission.approvedAt %}
                                <p class="text-xs text-base-content/50 mt-0.5">{{ submission.approvedAt|date('F d, Y \\a\\t g:i A') }}</p>
                            {% endif %}
                        </div>
                    </div>

                    {% if submission.denialReason %}
                        <div class="bg-base-200 rounded-lg p-4 border border-base-300">
                            <p class="text-sm font-medium text-base-content mb-1">Final Decision Comments</p>
                            <p class="text-sm text-base-content/70">{{ submission.denialReason }}</p>
                        </div>
                    {% endif %}

                    <div class="flex flex-wrap gap-2 pt-2">
                        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm gap-2">
                            <span class="icon-[tabler--arrow-left] size-4"></span>
                            Back to Dashboard
                        </a>
                        <a href="{{ path('app_admin_approved_accreditations') }}" class="btn btn-success btn-sm gap-2">
                            <span class="icon-[tabler--circle-check] size-4"></span>
                            View Approved Accreditations
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                    <div class="flex items-center gap-2">
                        <span class="icon-[tabler--info-circle] size-5 text-base-content/70"></span>
                        <h2 class="card-title text-base sm:text-lg">Application Status</h2>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-4">
                    {% if submission.status.value == 'PENDING' %}
                        <div class="alert alert-warning">
                            <span class="icon-[tabler--clock] size-5"></span>
                            <div>
                                <p class="font-medium">Awaiting Evaluator Review</p>
                                <p class="text-sm opacity-80">This application must be evaluated before final approval</p>
                            </div>
                        </div>
                    {% elseif submission.status.value == 'DENIED' %}
                        <div class="alert alert-error">
                            <span class="icon-[tabler--x] size-5"></span>
                            <div>
                                <p class="font-medium">Application Denied</p>
                                <p class="text-sm opacity-80">This application has been rejected</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <span class="icon-[tabler--info-circle] size-5"></span>
                            <div>
                                <p class="font-medium">{{ submission.status.value|replace({'_': ' '})|title }}</p>
                                <p class="text-sm opacity-80">Current application status</p>
                            </div>
                        </div>
                    {% endif %}

                    {% if submission.denialReason %}
                        <div class="bg-base-200 rounded-lg p-4 border border-base-300">
                            <p class="text-sm font-medium text-base-content mb-1">Comments</p>
                            <p class="text-sm text-base-content/70">{{ submission.denialReason }}</p>
                        </div>
                    {% endif %}

                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm gap-2 w-fit">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to Dashboard
                    </a>
                </div>
            </div>
        {% endif %}
{% endblock %}

{% block page_modals %}
<div id="appDocumentModal"
     class="hidden fixed inset-0 z-[999999] items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="appDocumentModalTitle">
    <div class="absolute inset-0 bg-black/60" data-app-doc-dismiss></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col z-10" onclick="event.stopPropagation()">
        <div class="flex items-center justify-between px-5 py-4 border-b border-base-300 shrink-0">
            <h3 id="appDocumentModalTitle" class="font-semibold text-base text-base-content">Document Viewer</h3>
            <button type="button" data-app-doc-dismiss class="btn btn-ghost btn-sm btn-circle">
                <span class="icon-[tabler--x] size-4"></span>
            </button>
        </div>
        <div class="flex-1 p-5 overflow-auto min-h-0">
            <div id="appDocumentContent" class="flex items-center justify-center min-h-[400px]">
                <div class="text-center">
                    <span class="loading loading-spinner loading-lg text-primary"></span>
                    <p class="mt-3 text-sm text-base-content/60">Loading document...</p>
                </div>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-base-300 shrink-0">
            <a id="appDocumentDownloadLink" href="#" target="_blank" class="btn btn-primary btn-sm gap-2">
                <span class="icon-[tabler--download] size-4"></span>
                Download
            </a>
            <button type="button" data-app-doc-dismiss class="btn btn-ghost btn-sm">Close</button>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    const modal = document.getElementById('appDocumentModal');
    const modalTitle = document.getElementById('appDocumentModalTitle');
    const documentContent = document.getElementById('appDocumentContent');
    const downloadLink = document.getElementById('appDocumentDownloadLink');

    function openDocumentModal() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeDocumentModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';

        const iframe = modal.querySelector('iframe');
        const img = modal.querySelector('img');
        if (iframe && iframe.src.startsWith('blob:')) URL.revokeObjectURL(iframe.src);
        if (img && img.src.startsWith('blob:')) URL.revokeObjectURL(img.src);
    }

    function showDocumentError(message) {
        documentContent.innerHTML = `
            <div class="text-center py-8">
                <span class="icon-[tabler--alert-circle] size-16 text-error/60 block mx-auto mb-4"></span>
                <p class="text-error font-medium mb-2">Error loading document</p>
                <p class="text-sm text-base-content/60">${message}</p>
                <p class="text-sm text-base-content/50 mt-2">Please try downloading the document instead.</p>
            </div>`;
    }

    function showUnsupportedFormat() {
        documentContent.innerHTML = `
            <div class="text-center py-8">
                <span class="icon-[tabler--file-off] size-16 text-base-content/30 block mx-auto mb-4"></span>
                <p class="text-base-content/70 font-medium mb-2">Preview not available for this file type</p>
                <p class="text-sm text-base-content/50">Click download to view the document</p>
            </div>`;
    }

    function createImageElement(url, documentName) {
        const container = document.createElement('div');
        container.className = 'flex items-center justify-center w-full h-full';
        const img = document.createElement('img');
        img.src = url;
        img.alt = documentName;
        img.className = 'max-w-full max-h-[500px] object-contain rounded-lg shadow-lg';
        img.onload = function () {
            documentContent.innerHTML = '';
            container.appendChild(img);
            documentContent.appendChild(container);
        };
        img.onerror = function () { showDocumentError('Failed to load image'); };
    }

    function createPdfElement(url) {
        const container = document.createElement('div');
        container.className = 'w-full h-full';
        const iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.className = 'w-full border border-base-300 rounded-lg';
        iframe.style.height = '500px';
        iframe.style.minHeight = '500px';
        documentContent.innerHTML = '';
        container.appendChild(iframe);
        documentContent.appendChild(container);
        iframe.onerror = function () { showDocumentError('Failed to load PDF'); };
    }

    function viewDocument(fileId, documentName) {
        modalTitle.textContent = documentName;
        downloadLink.href = `/admin/file/${fileId}`;
        openDocumentModal();

        documentContent.innerHTML = `
            <div class="text-center">
                <span class="loading loading-spinner loading-lg text-primary"></span>
                <p class="mt-3 text-sm text-base-content/60">Loading document...</p>
            </div>`;

        fetch(`/admin/file/${fileId}`)
            .then(function (response) {
                if (!response.ok) throw new Error('Document not found');
                return response.blob();
            })
            .then(function (blob) {
                const url = URL.createObjectURL(blob);
                const contentType = blob.type;

                if (contentType.startsWith('image/') || documentName.toLowerCase().match(/\.(jpg|jpeg|png|gif|bmp|webp)$/i)) {
                    createImageElement(url, documentName);
                } else if (contentType === 'application/pdf' || contentType.includes('pdf') || documentName.toLowerCase().endsWith('.pdf')) {
                    createPdfElement(url);
                } else {
                    showUnsupportedFormat();
                }
            })
            .catch(function (error) {
                showDocumentError(error.message);
            });
    }

    document.querySelectorAll('[data-app-doc-dismiss]').forEach(function (el) {
        el.addEventListener('click', closeDocumentModal);
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeDocumentModal();
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.view-document-btn').forEach(function (button) {
            button.addEventListener('click', function () {
                viewDocument(this.getAttribute('data-file-id'), this.getAttribute('data-document-name'));
            });
        });

        const finalApprovalForm = document.getElementById('finalApprovalForm');
        if (finalApprovalForm) {
            finalApprovalForm.addEventListener('submit', function (e) {
                const decision = document.getElementById('decision').value;
                const reason = document.getElementById('reason').value.trim();
                const submitBtn = document.getElementById('submitBtn');
                const submitText = document.getElementById('submitText');
                const loadingText = document.getElementById('loadingText');

                if (decision === 'deny' && !reason) {
                    e.preventDefault();
                    alert('Please provide a reason for denial.');
                    return false;
                }

                submitBtn.disabled = true;
                submitText.classList.add('hidden');
                loadingText.classList.remove('hidden');
                loadingText.classList.add('inline-flex');

                setTimeout(function () {
                    submitBtn.disabled = false;
                    submitText.classList.remove('hidden');
                    loadingText.classList.add('hidden');
                    loadingText.classList.remove('inline-flex');
                }, 10000);
            });
        }
    });
})();
</script>
{% endblock %}
