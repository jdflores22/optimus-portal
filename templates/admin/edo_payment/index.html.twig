{% extends 'layout/admin_base.html.twig' %}

{% block title %}eDO Payment Validation - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>eDO Payment Validation</li>
    </ul>
</div>
{% endblock %}

{% block content %}
{% set totalAmount = 0 %}
{% set uniqueBrokers = [] %}
{% for payment in pending_payments %}
    {% set totalAmount = totalAmount + payment.amount %}
    {% if payment.submittedBy.id not in uniqueBrokers %}
        {% set uniqueBrokers = uniqueBrokers|merge([payment.submittedBy.id]) %}
    {% endif %}
{% endfor %}

<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="card-title text-xl sm:text-2xl">
                        <span class="icon-[tabler--credit-card] size-6"></span>
                        eDO Payment Validation
                    </h1>
                    <p class="text-sm text-base-content/70 mt-1">Review and validate eDO release payments submitted by brokers</p>
                </div>
                <a href="{{ path('admin_edo_release_queue') }}" class="btn btn-primary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--list-check] size-5"></span>
                    eDO Release Queue
                </a>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <span class="icon-[tabler--check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">
            <span class="icon-[tabler--alert-circle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="stats stats-vertical sm:stats-horizontal shadow w-full bg-base-100">
        <div class="stat">
            <div class="stat-figure text-warning">
                <span class="icon-[tabler--clock-pause] size-8"></span>
            </div>
            <div class="stat-title">Pending Validation</div>
            <div class="stat-value text-warning">{{ pending_payments|length }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-primary">
                <span class="icon-[tabler--currency-peso] size-8"></span>
            </div>
            <div class="stat-title">Total Amount</div>
            <div class="stat-value text-primary text-2xl sm:text-3xl">{{ totalAmount|format_money('PHP') }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-secondary">
                <span class="icon-[tabler--users] size-8"></span>
            </div>
            <div class="stat-title">Unique Brokers</div>
            <div class="stat-value text-secondary">{{ uniqueBrokers|length }}</div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>Manifest</th>
                            <th>eDO Number</th>
                            <th>Broker</th>
                            <th>Amount</th>
                            <th>Submitted</th>
                            <th>Receipt</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if pending_payments|length > 0 %}
                            {% for payment in pending_payments %}
                                <tr>
                                    <td>
                                        <div class="font-medium">{{ payment.manifest.manifestNumber }}</div>
                                        <div class="text-xs text-base-content/60">ID: {{ payment.manifest.id }}</div>
                                    </td>
                                    <td>
                                        {% if payment.manifest.edo %}
                                            {{ payment.manifest.edo.edoNumber }}
                                        {% else %}
                                            <span class="text-base-content/40">Not generated</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div>{{ payment.submittedBy.fullName }}</div>
                                        <div class="text-xs text-base-content/60">{{ payment.submittedBy.email }}</div>
                                    </td>
                                    <td class="font-semibold">{{ payment.amount|format_money('PHP') }}</td>
                                    <td>
                                        <div>{{ payment.createdAt|date('M j, Y') }}</div>
                                        <div class="text-xs text-base-content/60">{{ payment.createdAt|date('g:i A') }}</div>
                                    </td>
                                    <td>
                                        <button type="button"
                                                onclick="viewReceipt('{{ path('admin_edo_payment_receipt', {id: payment.id}) }}?inline=1')"
                                                class="btn btn-ghost btn-xs gap-1">
                                            <span class="icon-[tabler--eye] size-4"></span>
                                            View
                                        </button>
                                    </td>
                                    <td class="text-right">
                                        <div class="flex justify-end gap-1">
                                            <button type="button"
                                                    onclick="approvePayment({{ payment.id }})"
                                                    class="btn btn-success btn-xs gap-1">
                                                <span class="icon-[tabler--circle-check] size-4"></span>
                                                Approve
                                            </button>
                                            <button type="button"
                                                    onclick="showRejectModal({{ payment.id }})"
                                                    class="btn btn-error btn-xs btn-outline gap-1">
                                                <span class="icon-[tabler--circle-x] size-4"></span>
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-12">
                                    <span class="icon-[tabler--circle-check] size-12 text-success/40 mx-auto block"></span>
                                    <p class="mt-3 font-medium">No pending eDO payments</p>
                                    <p class="text-sm text-base-content/60 mt-1">All eDO payments have been validated</p>
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<div id="receiptModal"
     class="hidden fixed inset-0 z-[10002] items-center justify-center p-4"
     role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeReceiptModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-4xl z-10 p-6 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-lg">Payment Receipt</h3>
            <button type="button" onclick="closeReceiptModal()" class="btn btn-sm btn-circle btn-ghost" aria-label="Close">
                <span class="icon-[tabler--x] size-5"></span>
            </button>
        </div>
        <div id="receiptContent" class="min-h-[50vh]"></div>
    </div>
</div>

<div id="rejectModal"
     class="hidden fixed inset-0 z-[10002] items-center justify-center p-4"
     role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeRejectModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="flex justify-between items-center mb-2">
            <h3 class="font-bold text-lg">Reject eDO Payment</h3>
            <button type="button" onclick="closeRejectModal()" class="btn btn-sm btn-circle btn-ghost" aria-label="Close">
                <span class="icon-[tabler--x] size-5"></span>
            </button>
        </div>
        <p class="text-sm text-base-content/70 mb-4">The broker will be notified and can resubmit payment.</p>
        <form id="rejectForm" class="space-y-4" onsubmit="submitRejection(event)">
            <input type="hidden" id="rejectPaymentId" name="paymentId">
            <div class="form-control">
                <label class="label py-1" for="rejectionReason">
                    <span class="label-text font-medium">Rejection Reason <span class="text-error">*</span></span>
                </label>
                <textarea id="rejectionReason"
                          name="reason"
                          rows="4"
                          required
                          class="textarea textarea-bordered w-full"
                          placeholder="Provide a detailed reason for rejecting this payment..."></textarea>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
                <button type="button" onclick="closeRejectModal()" class="btn btn-ghost">Cancel</button>
                <button type="submit" class="btn btn-error">Reject Payment</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
function openDialog(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('hidden');
    el.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeDialog(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add('hidden');
    el.classList.remove('flex');
    document.body.style.overflow = '';
}

function viewReceipt(receiptPath) {
    const content = document.getElementById('receiptContent');
    const extension = receiptPath.split('.').pop().split('?')[0].toLowerCase();

    if (extension === 'pdf') {
        content.innerHTML = `<iframe src="${receiptPath}" class="w-full min-h-[60vh] border-0 rounded-lg"></iframe>`;
    } else if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(extension)) {
        content.innerHTML = `<img src="${receiptPath}" class="max-w-full h-auto mx-auto rounded-lg" alt="Payment Receipt">`;
    } else {
        content.innerHTML = `<p class="text-center text-base-content/60">Unable to preview this file type. <a href="${receiptPath}" target="_blank" class="link link-primary">Open receipt</a></p>`;
    }

    openDialog('receiptModal');
}

function closeReceiptModal() {
    closeDialog('receiptModal');
}

function approvePayment(paymentId) {
    if (!confirm('Approve this eDO payment? The eDO will be released automatically.')) {
        return;
    }

    fetch(`/admin/edo-payments/${paymentId}/validate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved: true })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error: ' + (data.message || 'Approval failed'));
        }
    })
    .catch(() => alert('An error occurred while approving the payment'));
}

function showRejectModal(paymentId) {
    document.getElementById('rejectPaymentId').value = paymentId;
    document.getElementById('rejectionReason').value = '';
    openDialog('rejectModal');
}

function closeRejectModal() {
    closeDialog('rejectModal');
}

function submitRejection(event) {
    event.preventDefault();

    const paymentId = document.getElementById('rejectPaymentId').value;
    const reason = document.getElementById('rejectionReason').value.trim();

    if (!reason) {
        alert('Please provide a rejection reason');
        return;
    }

    fetch(`/admin/edo-payments/${paymentId}/validate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved: false, reason: reason })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error: ' + (data.message || 'Rejection failed'));
        }
    })
    .catch(() => alert('An error occurred while rejecting the payment'));
}

document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeReceiptModal();
    closeRejectModal();
});
</script>
{% endblock %}
