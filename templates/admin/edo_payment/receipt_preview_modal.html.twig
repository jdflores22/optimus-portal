{# Receipt Preview Modal Template #}
<div id="receiptPreviewModalContainer" class="fixed inset-0 z-50 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeReceiptPreviewModal()"></div>

        <!-- Center modal -->
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
            <!-- Modal Header -->
            <div class="bg-white px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900" id="modal-title">
                            Payment Receipt Preview
                        </h3>
                        <p class="mt-1 text-sm text-gray-500" id="receiptModalSubtitle">
                            Review the payment receipt submitted by the broker
                        </p>
                    </div>
                    <button type="button" onclick="closeReceiptPreviewModal()" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="bg-gray-50 px-6 py-4">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Payment Details Sidebar -->
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-lg shadow-sm p-4 space-y-4">
                            <h4 class="text-sm font-semibold text-gray-900 border-b pb-2">Payment Details</h4>
                            
                            <div>
                                <p class="text-xs text-gray-500 mb-1">eDO Number</p>
                                <p class="text-sm font-medium text-gray-900" id="receiptEdoNumber">-</p>
                            </div>
                            
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Container Number</p>
                                <p class="text-sm font-medium text-gray-900" id="receiptContainerNumber">-</p>
                            </div>
                            
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Manifest Number</p>
                                <p class="text-sm font-medium text-gray-900" id="receiptManifestNumber">-</p>
                            </div>
                            
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Payment Amount</p>
                                <p class="text-lg font-bold text-indigo-600" id="receiptAmount">-</p>
                            </div>
                            
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Submitted By</p>
                                <p class="text-sm font-medium text-gray-900" id="receiptBrokerName">-</p>
                                <p class="text-xs text-gray-500" id="receiptBrokerCompany">-</p>
                            </div>
                            
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Submission Date</p>
                                <p class="text-sm font-medium text-gray-900" id="receiptSubmissionDate">-</p>
                            </div>

                            <div class="pt-4 border-t">
                                <a href="#" id="receiptDownloadLink" download class="inline-flex items-center justify-center w-full px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                                    </svg>
                                    Download Receipt
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Receipt Preview Area -->
                    <div class="lg:col-span-2">
                        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                            <!-- Loading State -->
                            <div id="receiptLoadingState" class="flex items-center justify-center h-96">
                                <div class="text-center">
                                    <svg class="animate-spin h-10 w-10 text-indigo-600 mx-auto mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <p class="text-sm text-gray-500">Loading receipt...</p>
                                </div>
                            </div>

                            <!-- PDF Viewer -->
                            <div id="receiptPdfViewer" class="hidden">
                                <iframe id="receiptPdfFrame" class="w-full h-96 lg:h-[600px]" frameborder="0"></iframe>
                            </div>

                            <!-- Image Viewer -->
                            <div id="receiptImageViewer" class="hidden relative">
                                <div class="absolute top-4 right-4 z-10 flex space-x-2">
                                    <button onclick="zoomIn()" class="p-2 bg-white rounded-lg shadow-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
                                        </svg>
                                    </button>
                                    <button onclick="zoomOut()" class="p-2 bg-white rounded-lg shadow-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path>
                                        </svg>
                                    </button>
                                    <button onclick="resetZoom()" class="p-2 bg-white rounded-lg shadow-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                        </svg>
                                    </button>
                                </div>
                                <div class="overflow-auto h-96 lg:h-[600px] flex items-center justify-center bg-gray-100">
                                    <img id="receiptImage" src="" alt="Payment Receipt" class="max-w-full h-auto transition-transform duration-200" style="transform: scale(1);">
                                </div>
                            </div>

                            <!-- Error State -->
                            <div id="receiptErrorState" class="hidden flex items-center justify-center h-96">
                                <div class="text-center">
                                    <svg class="w-16 h-16 text-red-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <p class="text-sm font-medium text-gray-900 mb-1">Failed to load receipt</p>
                                    <p class="text-xs text-gray-500">Please try again or contact support</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="closeReceiptPreviewModal()" class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentZoom = 1;
const zoomStep = 0.2;
const minZoom = 0.5;
const maxZoom = 3;

/**
 * Open receipt preview modal with payment data
 */
function openReceiptPreviewModal(data) {
    const modal = document.getElementById('receiptPreviewModalContainer');
    
    // Populate payment details
    document.getElementById('receiptEdoNumber').textContent = data.edoNumber || '-';
    document.getElementById('receiptContainerNumber').textContent = data.containerNumber || '-';
    document.getElementById('receiptManifestNumber').textContent = data.manifestNumber || '-';
    
    const formattedAmount = new Intl.NumberFormat('en-PH', {
        style: 'currency',
        currency: 'PHP'
    }).format(data.amount || 0);
    document.getElementById('receiptAmount').textContent = formattedAmount;
    
    document.getElementById('receiptBrokerName').textContent = data.brokerName || '-';
    document.getElementById('receiptBrokerCompany').textContent = data.brokerCompany || '-';
    
    const submittedDate = new Date(data.submittedAt);
    const formattedDate = submittedDate.toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
    });
    document.getElementById('receiptSubmissionDate').textContent = formattedDate;
    
    // Set download link
    const downloadLink = document.getElementById('receiptDownloadLink');
    downloadLink.href = data.receiptUrl || '#';
    
    // Show loading state
    showReceiptLoadingState();
    
    // Load receipt based on type
    if (data.receiptType === 'pdf') {
        loadPdfReceipt(data.receiptUrl);
    } else {
        loadImageReceipt(data.receiptUrl);
    }
    
    // Show modal
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}

/**
 * Close receipt preview modal
 */
function closeReceiptPreviewModal() {
    const modal = document.getElementById('receiptPreviewModalContainer');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
    
    // Reset zoom
    currentZoom = 1;
    
    // Clear viewers
    document.getElementById('receiptPdfFrame').src = '';
    document.getElementById('receiptImage').src = '';
}

/**
 * Show loading state
 */
function showReceiptLoadingState() {
    document.getElementById('receiptLoadingState').classList.remove('hidden');
    document.getElementById('receiptPdfViewer').classList.add('hidden');
    document.getElementById('receiptImageViewer').classList.add('hidden');
    document.getElementById('receiptErrorState').classList.add('hidden');
}

/**
 * Show error state
 */
function showReceiptErrorState() {
    document.getElementById('receiptLoadingState').classList.add('hidden');
    document.getElementById('receiptPdfViewer').classList.add('hidden');
    document.getElementById('receiptImageViewer').classList.add('hidden');
    document.getElementById('receiptErrorState').classList.remove('hidden');
}

/**
 * Load PDF receipt
 */
function loadPdfReceipt(url) {
    const iframe = document.getElementById('receiptPdfFrame');
    
    iframe.onload = function() {
        document.getElementById('receiptLoadingState').classList.add('hidden');
        document.getElementById('receiptPdfViewer').classList.remove('hidden');
    };
    
    iframe.onerror = function() {
        showReceiptErrorState();
    };
    
    iframe.src = url;
}

/**
 * Load image receipt
 */
function loadImageReceipt(url) {
    const img = document.getElementById('receiptImage');
    
    img.onload = function() {
        document.getElementById('receiptLoadingState').classList.add('hidden');
        document.getElementById('receiptImageViewer').classList.remove('hidden');
    };
    
    img.onerror = function() {
        showReceiptErrorState();
    };
    
    img.src = url;
}

/**
 * Zoom in image
 */
function zoomIn() {
    if (currentZoom < maxZoom) {
        currentZoom += zoomStep;
        applyZoom();
    }
}

/**
 * Zoom out image
 */
function zoomOut() {
    if (currentZoom > minZoom) {
        currentZoom -= zoomStep;
        applyZoom();
    }
}

/**
 * Reset zoom to 100%
 */
function resetZoom() {
    currentZoom = 1;
    applyZoom();
}

/**
 * Apply zoom transformation
 */
function applyZoom() {
    const img = document.getElementById('receiptImage');
    img.style.transform = `scale(${currentZoom})`;
}

// Export functions for global access
window.openReceiptPreviewModal = openReceiptPreviewModal;
window.closeReceiptPreviewModal = closeReceiptPreviewModal;
window.zoomIn = zoomIn;
window.zoomOut = zoomOut;
window.resetZoom = resetZoom;
</script>
