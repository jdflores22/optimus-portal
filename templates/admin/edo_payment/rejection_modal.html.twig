{# Rejection Reason Modal Template #}
<div id="rejectionModalContainer" class="fixed inset-0 z-50 overflow-y-auto hidden" aria-labelledby="rejection-modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeRejectionModal()"></div>

        <!-- Center modal -->
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <!-- Modal Header -->
            <div class="bg-white px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0 w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900" id="rejection-modal-title">
                                Reject Payment
                            </h3>
                            <p class="text-sm text-gray-500">
                                Provide a reason for rejecting this payment
                            </p>
                        </div>
                    </div>
                    <button type="button" onclick="closeRejectionModal()" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <form id="rejectionForm" onsubmit="submitRejection(event)">
                <div class="bg-white px-6 py-4">
                    <!-- Warning Message -->
                    <div class="mb-4 bg-yellow-50 border-l-4 border-yellow-400 p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm text-yellow-700">
                                    The broker will be notified of this rejection and can resubmit a new payment.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Rejection Reason Input -->
                    <div class="mb-4">
                        <label for="rejectionReason" class="block text-sm font-medium text-gray-700 mb-2">
                            Rejection Reason <span class="text-red-500">*</span>
                        </label>
                        <textarea 
                            id="rejectionReason" 
                            name="rejectionReason" 
                            rows="4" 
                            required
                            minlength="10"
                            maxlength="500"
                            class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md"
                            placeholder="Please provide a clear and detailed reason for rejecting this payment (minimum 10 characters)"
                            oninput="updateCharacterCount()"
                        ></textarea>
                        
                        <!-- Character Count -->
                        <div class="mt-2 flex items-center justify-between">
                            <div id="characterCountDisplay" class="text-xs text-gray-500">
                                <span id="currentCharCount">0</span> / 500 characters
                                <span id="minCharWarning" class="text-red-500 ml-2 hidden">(Minimum 10 characters required)</span>
                            </div>
                            <div id="validationIcon" class="hidden">
                                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Validation Error Display -->
                    <div id="rejectionValidationError" class="hidden mb-4 bg-red-50 border-l-4 border-red-400 p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm text-red-700" id="rejectionErrorMessage"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Info Summary -->
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="text-xs font-semibold text-gray-700 uppercase mb-3">Payment Information</h4>
                        <div class="grid grid-cols-2 gap-3 text-sm">
                            <div>
                                <p class="text-xs text-gray-500">eDO Number</p>
                                <p class="font-medium text-gray-900" id="rejectionEdoNumber">-</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Container</p>
                                <p class="font-medium text-gray-900" id="rejectionContainerNumber">-</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Broker</p>
                                <p class="font-medium text-gray-900" id="rejectionBrokerName">-</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Amount</p>
                                <p class="font-medium text-gray-900" id="rejectionAmount">-</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
                    <div class="flex justify-end space-x-3">
                        <button 
                            type="button" 
                            onclick="closeRejectionModal()" 
                            class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                        >
                            Cancel
                        </button>
                        <button 
                            type="submit" 
                            id="submitRejectionButton"
                            class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 disabled:opacity-50 disabled:cursor-not-allowed"
                            disabled
                        >
                            <span id="submitRejectionText">Reject Payment</span>
                            <svg id="submitRejectionSpinner" class="hidden animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let currentRejectionPaymentId = null;

/**
 * Open rejection modal for a payment
 */
function openRejectionModal(paymentId) {
    currentRejectionPaymentId = paymentId;
    
    // Find payment data from the table
    const paymentRow = document.querySelector(`tr[data-payment-id="${paymentId}"]`);
    if (paymentRow) {
        const cells = paymentRow.querySelectorAll('td');
        document.getElementById('rejectionEdoNumber').textContent = cells[0]?.textContent.trim() || '-';
        document.getElementById('rejectionContainerNumber').textContent = cells[1]?.textContent.trim() || '-';
        document.getElementById('rejectionBrokerName').textContent = cells[3]?.querySelector('.text-sm')?.textContent.trim() || '-';
        document.getElementById('rejectionAmount').textContent = cells[4]?.textContent.trim() || '-';
    }
    
    // Reset form
    document.getElementById('rejectionForm').reset();
    document.getElementById('rejectionValidationError').classList.add('hidden');
    updateCharacterCount();
    
    // Show modal
    const modal = document.getElementById('rejectionModalContainer');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Focus on textarea
    setTimeout(() => {
        document.getElementById('rejectionReason').focus();
    }, 100);
}

/**
 * Close rejection modal
 */
function closeRejectionModal() {
    const modal = document.getElementById('rejectionModalContainer');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
    currentRejectionPaymentId = null;
}

/**
 * Update character count and validation
 */
function updateCharacterCount() {
    const textarea = document.getElementById('rejectionReason');
    const currentCount = textarea.value.length;
    const minChars = 10;
    
    // Update count display
    document.getElementById('currentCharCount').textContent = currentCount;
    
    // Show/hide minimum character warning
    const minWarning = document.getElementById('minCharWarning');
    const validationIcon = document.getElementById('validationIcon');
    const submitButton = document.getElementById('submitRejectionButton');
    
    if (currentCount > 0 && currentCount < minChars) {
        minWarning.classList.remove('hidden');
        validationIcon.classList.add('hidden');
        submitButton.disabled = true;
    } else if (currentCount >= minChars) {
        minWarning.classList.add('hidden');
        validationIcon.classList.remove('hidden');
        submitButton.disabled = false;
    } else {
        minWarning.classList.add('hidden');
        validationIcon.classList.add('hidden');
        submitButton.disabled = true;
    }
}

/**
 * Submit rejection
 */
function submitRejection(event) {
    event.preventDefault();
    
    const textarea = document.getElementById('rejectionReason');
    const rejectionReason = textarea.value.trim();
    
    // Validate minimum length
    if (rejectionReason.length < 10) {
        showRejectionError('Rejection reason must be at least 10 characters long');
        return;
    }
    
    if (!currentRejectionPaymentId) {
        showRejectionError('Invalid payment ID');
        return;
    }
    
    // Show loading state
    const submitButton = document.getElementById('submitRejectionButton');
    const submitText = document.getElementById('submitRejectionText');
    const submitSpinner = document.getElementById('submitRejectionSpinner');
    
    submitButton.disabled = true;
    submitText.textContent = 'Rejecting...';
    submitSpinner.classList.remove('hidden');
    
    // Hide any previous errors
    document.getElementById('rejectionValidationError').classList.add('hidden');
    
    // Submit rejection
    fetch(`/admin/edo-payments/${currentRejectionPaymentId}/reject`, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
            rejectionReason: rejectionReason
        })
    })
    .then(response => {
        if (!response.ok) {
            return response.json().then(data => {
                throw new Error(data.message || 'Failed to reject payment');
            });
        }
        return response.json();
    })
    .then(data => {
        // Close modal
        closeRejectionModal();
        
        // Show success toast
        showToast('success', 'Payment Rejected', data.message || 'Payment rejected and broker notified successfully');
        
        // Remove the row from table
        const row = document.querySelector(`tr[data-payment-id="${currentRejectionPaymentId}"]`);
        if (row) {
            row.remove();
        }
        
        // Update pending count
        updatePendingCountBadge(-1);
        
        // Reload if table is empty
        const remainingRows = document.querySelectorAll('#paymentsTableBody tr:not(#loadingRow):not(#emptyRow)');
        if (remainingRows.length === 0) {
            loadPendingPayments();
        }
    })
    .catch(error => {
        console.error('Error rejecting payment:', error);
        showRejectionError(error.message);
    })
    .finally(() => {
        // Reset button state
        submitButton.disabled = false;
        submitText.textContent = 'Reject Payment';
        submitSpinner.classList.add('hidden');
    });
}

/**
 * Show rejection error message
 */
function showRejectionError(message) {
    const errorDiv = document.getElementById('rejectionValidationError');
    const errorMessage = document.getElementById('rejectionErrorMessage');
    
    errorMessage.textContent = message;
    errorDiv.classList.remove('hidden');
    
    // Scroll to error
    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// Export functions for global access
window.openRejectionModal = openRejectionModal;
window.closeRejectionModal = closeRejectionModal;
window.updateCharacterCount = updateCharacterCount;
window.submitRejection = submitRejection;
</script>
