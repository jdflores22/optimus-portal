{% extends 'base.html.twig' %}

{% block title %}Rate Limiter Settings - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 py-8">
    <div class="max-w-6xl mx-auto px-4">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Rate Limiter Settings</h1>
            <p class="mt-2 text-gray-600">Configure rate limiting for various system operations</p>
        </div>

        <!-- Info Alert -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
            <div class="flex">
                <svg class="w-5 h-5 text-blue-400 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div class="text-sm text-blue-700">
                    <p class="font-medium mb-1">Important Notes:</p>
                    <ul class="list-disc list-inside space-y-1">
                        <li>Changes require cache clear to take effect: <code class="bg-blue-100 px-2 py-0.5 rounded">php bin/console cache:clear</code></li>
                        <li>All rate limiters use sliding window policy for gradual limit recovery</li>
                        <li>Lower limits increase security but may impact user experience</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Rate Limiters Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {% for name, config in limiters %}
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">{{ name|replace({'_': ' '})|title }}</h3>
                            <p class="text-sm text-gray-500 mt-1">
                                {% if name == 'api_user' %}
                                    API requests per user
                                {% elseif name == 'api_ip' %}
                                    API requests per IP address
                                {% elseif name == 'photo_upload' %}
                                    Photo uploads per user
                                {% elseif name == 'api_auth' %}
                                    Authentication attempts per IP
                                {% elseif name == 'role_acceptance' %}
                                    Role acceptance attempts per IP
                                {% elseif name == 'payment_submission' %}
                                    Payment submissions per user
                                {% elseif name == 'referral_code_generation' %}
                                    Referral code generation per consignee
                                {% elseif name == 'broker_transfer_request' %}
                                    Broker assignments/transfers per consignee
                                {% elseif name == 'workspace_switching' %}
                                    Workspace switches per broker
                                {% elseif name == 'referral_code_application' %}
                                    Referral code applications per broker
                                {% else %}
                                    Rate limiting configuration
                                {% endif %}
                            </p>
                        </div>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Active
                        </span>
                    </div>

                    <form method="POST" action="{{ path('admin_rate_limiter_settings_update') }}" class="space-y-4">
                        <input type="hidden" name="limiter_name" value="{{ name }}">
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    Limit
                                </label>
                                <input type="number" 
                                       name="limit" 
                                       value="{{ config.limit }}" 
                                       min="1"
                                       required
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    Interval
                                </label>
                                <select name="interval" 
                                        required
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    <option value="1 minute" {% if config.interval == '1 minute' %}selected{% endif %}>1 minute</option>
                                    <option value="5 minutes" {% if config.interval == '5 minutes' %}selected{% endif %}>5 minutes</option>
                                    <option value="15 minutes" {% if config.interval == '15 minutes' %}selected{% endif %}>15 minutes</option>
                                    <option value="30 minutes" {% if config.interval == '30 minutes' %}selected{% endif %}>30 minutes</option>
                                    <option value="1 hour" {% if config.interval == '1 hour' %}selected{% endif %}>1 hour</option>
                                    <option value="24 hours" {% if config.interval == '24 hours' %}selected{% endif %}>24 hours</option>
                                </select>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-lg p-3">
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-gray-600">Current Rate:</span>
                                <span class="font-semibold text-gray-900">{{ config.limit }} per {{ config.interval }}</span>
                            </div>
                        </div>

                        <button type="submit" 
                                class="w-full px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-200">
                            Update Settings
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>

        <!-- Cache Clear Instructions -->
        <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <div class="flex">
                <svg class="w-5 h-5 text-yellow-400 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <div class="text-sm text-yellow-700">
                    <p class="font-medium mb-1">After updating settings:</p>
                    <p>Run the following command to apply changes:</p>
                    <code class="block mt-2 bg-yellow-100 px-3 py-2 rounded font-mono text-xs">php bin/console cache:clear</code>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification Container -->
<div id="toastContainer" class="fixed top-4 right-4 z-50 space-y-2"></div>

<script>
// Show toast notification
function showToast(message, type = 'success') {
    const container = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    
    const bgColor = type === 'success' ? 'bg-green-50 border-green-200' : 
                    type === 'error' ? 'bg-red-50 border-red-200' : 
                    'bg-blue-50 border-blue-200';
    const textColor = type === 'success' ? 'text-green-800' : 
                      type === 'error' ? 'text-red-800' : 
                      'text-blue-800';
    const iconColor = type === 'success' ? 'text-green-400' : 
                      type === 'error' ? 'text-red-400' : 
                      'text-blue-400';
    
    const icon = type === 'success' ? 
        '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>' :
        '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>';
    
    toast.className = `${bgColor} border rounded-lg p-4 shadow-lg flex items-start space-x-3 min-w-[300px] max-w-md transform transition-all duration-300 translate-x-0`;
    toast.innerHTML = `
        <svg class="w-5 h-5 ${iconColor} flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            ${icon}
        </svg>
        <div class="flex-1">
            <p class="text-sm font-medium ${textColor}">${message}</p>
        </div>
        <button onclick="this.parentElement.remove()" class="flex-shrink-0 ${textColor}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    `;
    
    container.appendChild(toast);
    
    // Auto dismiss after 5 seconds
    setTimeout(() => {
        toast.style.transform = 'translateX(400px)';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
    }, 5000);
}

// Check for flash messages and show as toast
{% for message in app.flashes('success') %}
    showToast('{{ message|e('js') }}', 'success');
{% endfor %}
{% for message in app.flashes('error') %}
    showToast('{{ message|e('js') }}', 'error');
{% endfor %}
</script>
{% endblock %}
