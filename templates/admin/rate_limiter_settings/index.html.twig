{% extends 'layout/admin_base.html.twig' %}

{% block title %}Rate Limiter Settings - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>Rate Limiter Settings</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold flex items-center gap-2">
            <span class="icon-[tabler--shield-lock] size-6"></span>
            Rate Limiter Settings
        </h1>
        <p class="text-sm text-base-content/70 mt-1">Configure rate limiting for various system operations</p>
    </div>

    <div class="alert alert-info">
        <span class="icon-[tabler--info-circle] size-5"></span>
        <div class="text-sm">
            <p class="font-medium">Important notes</p>
            <ul class="list-disc list-inside mt-1 space-y-0.5">
                <li>Changes require cache clear: <code class="bg-base-200 px-1 rounded">php bin/console cache:clear</code></li>
                <li>All limiters use a sliding window policy</li>
                <li>Lower limits increase security but may impact user experience</li>
            </ul>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <span class="icon-[tabler--check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">
            <span class="icon-[tabler--alert-circle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for name, config in limiters %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">
                    <div class="flex items-start justify-between gap-3 mb-4">
                        <div>
                            <h2 class="card-title text-base">{{ name|replace({'_': ' '})|title }}</h2>
                            <p class="text-sm text-base-content/60 mt-1">
                                {% if name == 'api_user' %}API requests per user
                                {% elseif name == 'api_ip' %}API requests per IP address
                                {% elseif name == 'photo_upload' %}Photo uploads per user
                                {% elseif name == 'api_auth' %}Authentication attempts per IP
                                {% elseif name == 'role_acceptance' %}Role acceptance attempts per IP
                                {% elseif name == 'payment_submission' %}Payment submissions per user
                                {% elseif name == 'referral_code_generation' %}Referral code generation per consignee
                                {% elseif name == 'broker_transfer_request' %}Broker assignments/transfers per consignee
                                {% elseif name == 'workspace_switching' %}Workspace switches per broker
                                {% elseif name == 'referral_code_application' %}Referral code applications per broker
                                {% else %}Rate limiting configuration
                                {% endif %}
                            </p>
                        </div>
                        <span class="badge badge-success badge-sm">Active</span>
                    </div>

                    <form method="POST" action="{{ path('admin_rate_limiter_settings_update') }}" class="space-y-4">
                        <input type="hidden" name="limiter_name" value="{{ name }}">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="form-control">
                                <label class="label py-1"><span class="label-text font-medium">Limit</span></label>
                                <input type="number" name="limit" value="{{ config.limit }}" min="1" required class="input input-bordered input-sm w-full">
                            </div>
                            <div class="form-control">
                                <label class="label py-1"><span class="label-text font-medium">Interval</span></label>
                                <select name="interval" required class="select select-bordered select-sm w-full">
                                    <option value="1 minute" {% if config.interval == '1 minute' %}selected{% endif %}>1 minute</option>
                                    <option value="5 minutes" {% if config.interval == '5 minutes' %}selected{% endif %}>5 minutes</option>
                                    <option value="15 minutes" {% if config.interval == '15 minutes' %}selected{% endif %}>15 minutes</option>
                                    <option value="30 minutes" {% if config.interval == '30 minutes' %}selected{% endif %}>30 minutes</option>
                                    <option value="1 hour" {% if config.interval == '1 hour' %}selected{% endif %}>1 hour</option>
                                    <option value="24 hours" {% if config.interval == '24 hours' %}selected{% endif %}>24 hours</option>
                                </select>
                            </div>
                        </div>
                        <div class="bg-base-200 rounded-lg px-3 py-2 text-sm flex justify-between">
                            <span class="text-base-content/70">Current rate</span>
                            <span class="font-semibold">{{ config.limit }} per {{ config.interval }}</span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-full gap-2">
                            <span class="icon-[tabler--device-floppy] size-4"></span>
                            Update Settings
                        </button>
                    </form>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="alert alert-warning">
        <span class="icon-[tabler--alert-triangle] size-5"></span>
        <div class="text-sm">
            <p class="font-medium">After updating settings</p>
            <code class="block mt-2 bg-base-200 px-3 py-2 rounded font-mono text-xs">php bin/console cache:clear</code>
        </div>
    </div>
</div>
{% endblock %}
