{% extends 'layout/admin_base.html.twig' %}

{% block title %}Shipping Lines Management - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>Shipping Lines</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title text-xl sm:text-2xl">Shipping Lines Management</h1>
            <p class="text-sm text-base-content/70">Manage shipping lines and their configurations</p>
        </div>
    </div>

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6 sm:mb-8">
            <div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="avatar placeholder">
                            <div class="w-10 sm:w-12 bg-primary/10 text-primary rounded-full">
                                <span class="icon-[tabler--building] size-5 sm:size-6"></span>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Total Lines</p>
                            <p class="text-2xl sm:text-3xl font-bold">{{ shippingLines|length }}</p>
                            <p class="text-xs text-primary font-medium">Registered</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="avatar placeholder">
                            <div class="w-10 sm:w-12 bg-success/10 text-success rounded-full">
                                <span class="icon-[tabler--circle-check] size-5 sm:size-6"></span>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Active Lines</p>
                            <p class="text-2xl sm:text-3xl font-bold">{{ shippingLines|filter(line => line.isActive)|length }}</p>
                            <p class="text-xs text-success font-medium">Operational</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="avatar placeholder">
                            <div class="w-10 sm:w-12 bg-secondary/10 text-secondary rounded-full">
                                <span class="icon-[tabler--users] size-5 sm:size-6"></span>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Total Admins</p>
                            {% set totalAdmins = 0 %}
                            {% for line in shippingLines %}
                                {% set totalAdmins = totalAdmins + line.shippingLineAdmins|length %}
                            {% endfor %}
                            <p class="text-2xl sm:text-3xl font-bold">{{ totalAdmins }}</p>
                            <p class="text-xs text-secondary font-medium">Assigned</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="avatar placeholder">
                            <div class="w-10 sm:w-12 bg-warning/10 text-warning rounded-full">
                                <span class="icon-[tabler--clock] size-5 sm:size-6"></span>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs sm:text-sm text-base-content/70">Unassigned</p>
                            <p class="text-2xl sm:text-3xl font-bold">{{ shippingLines|filter(line => line.shippingLineAdmins|length == 0)|length }}</p>
                            <p class="text-xs text-warning font-medium">Need admins</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions Bar -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-6">
                <h3 class="font-semibold text-base sm:text-lg mb-4">Quick Actions</h3>
                <div class="flex flex-col sm:flex-row flex-wrap gap-2 sm:gap-3">
                    <a href="{{ path('admin_shipping_lines_create') }}" class="btn btn-primary btn-sm sm:btn-md w-full sm:w-auto">
                        <span class="icon-[tabler--plus] size-4 sm:size-5"></span>
                        Create Shipping Line
                    </a>
                    {% if app.user.role.value == 'SYSTEM_ADMIN' %}
                    <a href="{{ path('admin_shipping_lines_statistics') }}" class="btn btn-outline btn-sm sm:btn-md w-full sm:w-auto">
                        <span class="icon-[tabler--chart-bar] size-4 sm:size-5"></span>
                        View Statistics
                    </a>
                    {% endif %}
                    <a href="{{ path('admin_shipping_lines_export') }}" class="btn btn-outline btn-sm sm:btn-md w-full sm:w-auto">
                        <span class="icon-[tabler--download] size-4 sm:size-5"></span>
                        Export Data
                    </a>
                </div>
            </div>
        </div>

        <!-- Shipping Lines List -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-3 sm:p-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-semibold text-base sm:text-lg">All Shipping Lines</h3>
                    <span class="badge badge-ghost text-xs sm:text-sm">{{ shippingLines|length }} total</span>
                </div>
                {% if shippingLines is empty %}
                    <div class="text-center py-8 sm:py-12">
                        <span class="icon-[tabler--building] size-10 sm:size-12 text-base-content/40 mx-auto"></span>
                        <h3 class="mt-3 sm:mt-4 text-sm sm:text-base font-medium">No shipping lines</h3>
                        <p class="mt-2 text-xs sm:text-sm text-base-content/70">Get started by creating a new shipping line.</p>
                        <div class="mt-4 sm:mt-6">
                            <a href="{{ path('admin_shipping_lines_create') }}" class="btn btn-primary btn-sm sm:btn-md">
                                <span class="icon-[tabler--plus] size-4 sm:size-5"></span>
                                Create Shipping Line
                            </a>
                        </div>
                    </div>
                {% else %}
                    <div class="space-y-2 sm:space-y-3">
                        {% for shippingLine in shippingLines %}
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between p-3 sm:p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors gap-3">
                                <div class="flex items-center gap-3 flex-1 min-w-0">
                                    <div class="avatar placeholder flex-shrink-0">
                                        {% if shippingLine.shippingLineAdmins|length > 0 %}
                                            {% set firstAdmin = shippingLine.shippingLineAdmins|first %}
                                            <div class="w-10 h-10 sm:w-12 sm:h-12 {{ avatar_colors(firstAdmin) }} rounded-full">
                                                <span class="text-xs sm:text-sm font-medium">
                                                    {{ shippingLine.brandName|slice(0, 2)|upper }}
                                                </span>
                                            </div>
                                        {% else %}
                                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-neutral text-neutral-content rounded-full">
                                                <span class="text-xs sm:text-sm font-medium">
                                                    {{ shippingLine.brandName|slice(0, 2)|upper }}
                                                </span>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <h4 class="text-base sm:text-lg font-medium truncate">{{ shippingLine.brandName }}</h4>
                                            {% if shippingLine.isActive %}
                                                <span class="badge badge-success badge-soft badge-xs sm:badge-sm gap-1">
                                                    <span class="badge-dot"></span>
                                                    Active
                                                </span>
                                            {% else %}
                                                <span class="badge badge-error badge-soft badge-xs sm:badge-sm gap-1">
                                                    <span class="badge-dot"></span>
                                                    Inactive
                                                </span>
                                            {% endif %}
                                        </div>
                                        <div class="mt-1 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 text-xs sm:text-sm text-base-content/70">
                                            <span class="flex items-center gap-1">
                                                <span class="icon-[tabler--users] size-3 sm:size-4"></span>
                                                {{ shippingLine.shippingLineAdmins|length }} admin(s)
                                            </span>
                                            <span class="hidden sm:flex items-center gap-1">
                                                <span class="icon-[tabler--calendar] size-4"></span>
                                                Created {{ shippingLine.createdAt|date('M d, Y') }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
                                    <a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}" 
                                       class="btn btn-xs sm:btn-sm btn-outline flex-1 sm:flex-initial">
                                        <span class="icon-[tabler--eye] size-3 sm:size-4"></span>
                                        <span class="hidden sm:inline">View Details</span>
                                        <span class="sm:hidden">View</span>
                                    </a>
                                    {% if app.user.role.value == 'SYSTEM_ADMIN' %}
                                        {% if shippingLine.isActive %}
                                            <button onclick="openDeactivateModal({{ shippingLine.id }}, '{{ shippingLine.brandName|e('js') }}')" 
                                                    class="btn btn-xs sm:btn-sm btn-error btn-outline flex-1 sm:flex-initial">
                                                <span class="icon-[tabler--ban] size-3 sm:size-4"></span>
                                                <span class="hidden sm:inline">Deactivate</span>
                                            </button>
                                        {% else %}
                                            <button onclick="openActivateModal({{ shippingLine.id }}, '{{ shippingLine.brandName|e('js') }}')" 
                                                    class="btn btn-xs sm:btn-sm btn-success btn-outline flex-1 sm:flex-initial">
                                                <span class="icon-[tabler--circle-check] size-3 sm:size-4"></span>
                                                <span class="hidden sm:inline">Activate</span>
                                            </button>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
</div>
{% endblock %}

{% block page_modals %}
<!-- Activate Modal -->
<div id="activateModal" class="hidden fixed inset-0 z-[10002] items-center justify-center p-4" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeActivateModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6 text-center">
        <div class="mx-auto flex items-center justify-center size-14 rounded-full bg-success/10 mb-4">
            <span class="icon-[tabler--circle-check] size-7 text-success"></span>
        </div>
        <h3 class="text-lg font-bold mb-2">Activate Shipping Line</h3>
        <p class="text-sm text-base-content/70 mb-2" id="activateModalMessage">Are you sure you want to activate this shipping line?</p>
        <p class="text-xs text-success mb-6">This shipping line will become operational and accessible.</p>
        <div class="flex gap-3">
            <button type="button" onclick="closeActivateModal()" class="btn btn-ghost flex-1">Cancel</button>
            <button type="button" id="confirmActivateBtn" class="btn btn-success flex-1">Activate</button>
        </div>
    </div>
</div>

<!-- Deactivate Modal -->
<div id="deactivateModal" class="hidden fixed inset-0 z-[10002] items-center justify-center p-4" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeDeactivateModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6 text-center">
        <div class="mx-auto flex items-center justify-center size-14 rounded-full bg-error/10 mb-4">
            <span class="icon-[tabler--alert-triangle] size-7 text-error"></span>
        </div>
        <h3 class="text-lg font-bold mb-2">Deactivate Shipping Line</h3>
        <p class="text-sm text-base-content/70 mb-2" id="deactivateModalMessage">Are you sure you want to deactivate this shipping line?</p>
        <p class="text-xs text-error mb-6">This shipping line will no longer be accessible.</p>
        <div class="flex gap-3">
            <button type="button" onclick="closeDeactivateModal()" class="btn btn-ghost flex-1">Cancel</button>
            <button type="button" id="confirmDeactivateBtn" class="btn btn-error flex-1">Deactivate</button>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
let currentShippingLineId = null;

// Modal functions
function openActivateModal(id, name) {
    currentShippingLineId = id;
    document.getElementById('activateModalMessage').textContent = `Are you sure you want to activate ${name}?`;
    const modal = document.getElementById('activateModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeActivateModal() {
    const modal = document.getElementById('activateModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    currentShippingLineId = null;
}

function openDeactivateModal(id, name) {
    currentShippingLineId = id;
    document.getElementById('deactivateModalMessage').textContent = `Are you sure you want to deactivate ${name}?`;
    const modal = document.getElementById('deactivateModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeDeactivateModal() {
    const modal = document.getElementById('deactivateModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    currentShippingLineId = null;
}

// Confirm button handlers
document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('confirmActivateBtn').addEventListener('click', function() {
        if (currentShippingLineId) {
            activateShippingLine(currentShippingLineId);
        }
    });

    document.getElementById('confirmDeactivateBtn').addEventListener('click', function() {
        if (currentShippingLineId) {
            deactivateShippingLine(currentShippingLineId);
        }
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeActivateModal();
            closeDeactivateModal();
        }
    });
});

function deactivateShippingLine(id) {
    const btn = document.getElementById('confirmDeactivateBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Deactivating...';
    
    // Get CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    
    fetch(`/admin/shipping-lines/${id}/deactivate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            ...(csrfToken && { 'X-CSRF-Token': csrfToken })
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            closeDeactivateModal();
            location.reload();
        } else {
            alert('Error: ' + (data.error || data.message || 'Unknown error occurred'));
            // Reset button state
            btn.disabled = false;
            btn.textContent = 'Deactivate';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while deactivating the shipping line.');
        // Reset button state
        btn.disabled = false;
        btn.textContent = 'Deactivate';
    });
}

function activateShippingLine(id) {
    const btn = document.getElementById('confirmActivateBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Activating...';
    
    // Get CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    
    fetch(`/admin/shipping-lines/${id}/activate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            ...(csrfToken && { 'X-CSRF-Token': csrfToken })
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            closeActivateModal();
            location.reload();
        } else {
            alert('Error: ' + (data.error || data.message || 'Unknown error occurred'));
            // Reset button state
            btn.disabled = false;
            btn.textContent = 'Activate';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while activating the shipping line.');
        // Reset button state
        btn.disabled = false;
        btn.textContent = 'Activate';
    });
}
</script>
{% endblock %}