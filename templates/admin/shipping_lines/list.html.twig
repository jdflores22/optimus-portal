{% extends 'layout/admin_base.html.twig' %}

{% block title %}Shipping Lines Management - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>Shipping Lines</li>
    </ul>
</div>
{% endblock %}

{% block content %}
{% set totalLines = shippingLines|length %}
{% set activeLines = shippingLines|filter(line => line.isActive)|length %}
{% set unassignedLines = shippingLines|filter(line => line.shippingLineAdmins|length == 0)|length %}
{% set totalAdmins = 0 %}
{% for line in shippingLines %}
    {% set totalAdmins = totalAdmins + line.shippingLineAdmins|length %}
{% endfor %}

<div class="max-w-7xl mx-auto w-full space-y-6">
    <div class="rounded-3xl border border-primary/20 bg-gradient-to-br from-primary/15 via-base-100 to-base-100 shadow-sm p-5 sm:p-7">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
            <div class="space-y-3">
                <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
                    <span class="icon-[tabler--building-community] size-3.5"></span>
                    Shipping Lines Console
                </span>
                <div>
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-base-content leading-tight">Shipping Lines Management</h1>
                    <p class="mt-2 text-sm sm:text-base text-base-content/70 max-w-2xl">
                        Manage shipping lines, monitor admin assignments, and keep each line operational.
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="badge badge-primary badge-lg gap-2">
                        <span class="icon-[tabler--building] size-4"></span>
                        {{ totalLines }} total
                    </span>
                    <span class="badge badge-success badge-soft badge-lg gap-2">
                        <span class="icon-[tabler--circle-check] size-4"></span>
                        {{ activeLines }} active
                    </span>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 xl:justify-end">
                <a href="{{ path('admin_shipping_lines_create') }}" class="btn btn-primary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--plus] size-4"></span>
                    New Shipping Line
                </a>
                {% if app.user.role.value == 'SYSTEM_ADMIN' %}
                <a href="{{ path('admin_shipping_lines_statistics') }}" class="btn btn-outline btn-primary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--chart-bar] size-4"></span>
                    Statistics
                </a>
                {% endif %}
                <a href="{{ path('admin_shipping_lines_export') }}" class="btn btn-ghost btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--download] size-4"></span>
                    Export
                </a>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm">
            <span class="icon-[tabler--check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error shadow-sm">
            <span class="icon-[tabler--alert-circle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <div class="card bg-base-100 shadow-sm border border-primary/15">
            <div class="card-body p-5">
                <p class="text-xs uppercase tracking-wide text-base-content/60">Total Lines</p>
                <div class="mt-2 flex items-end justify-between">
                    <p class="text-4xl font-bold">{{ totalLines }}</p>
                    <span class="icon-[tabler--building] size-8 text-primary/70"></span>
                </div>
                <p class="text-xs text-primary mt-2">Registered</p>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm border border-success/15">
            <div class="card-body p-5">
                <p class="text-xs uppercase tracking-wide text-base-content/60">Active Lines</p>
                <div class="mt-2 flex items-end justify-between">
                    <p class="text-4xl font-bold">{{ activeLines }}</p>
                    <span class="icon-[tabler--circle-check] size-8 text-success/70"></span>
                </div>
                <p class="text-xs text-success mt-2">Operational</p>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm border border-info/15">
            <div class="card-body p-5">
                <p class="text-xs uppercase tracking-wide text-base-content/60">Assigned Admins</p>
                <div class="mt-2 flex items-end justify-between">
                    <p class="text-4xl font-bold">{{ totalAdmins }}</p>
                    <span class="icon-[tabler--users] size-8 text-info/70"></span>
                </div>
                <p class="text-xs text-info mt-2">Across lines</p>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm border border-warning/15">
            <div class="card-body p-5">
                <p class="text-xs uppercase tracking-wide text-base-content/60">Need Admins</p>
                <div class="mt-2 flex items-end justify-between">
                    <p class="text-4xl font-bold">{{ unassignedLines }}</p>
                    <span class="icon-[tabler--alert-triangle] size-8 text-warning/70"></span>
                </div>
                <p class="text-xs text-warning mt-2">Unassigned lines</p>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm border border-base-content/10">
        <div class="card-body p-4 sm:p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-semibold text-lg">All Shipping Lines</h3>
                <span class="badge badge-ghost">{{ totalLines }} total</span>
            </div>

            {% if shippingLines is empty %}
                <div class="text-center py-10 sm:py-14">
                    <span class="icon-[tabler--building] size-12 text-base-content/40 mx-auto"></span>
                    <h3 class="mt-4 text-base font-medium">No shipping lines yet</h3>
                    <p class="mt-2 text-sm text-base-content/70">Get started by creating your first shipping line.</p>
                    <div class="mt-6">
                        <a href="{{ path('admin_shipping_lines_create') }}" class="btn btn-primary">
                            <span class="icon-[tabler--plus] size-4"></span>
                            Create Shipping Line
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="space-y-3">
                    {% for shippingLine in shippingLines %}
                        <div class="rounded-xl border border-base-content/10 p-4 hover:bg-base-200/50 transition-colors">
                            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                                <div class="flex items-center gap-3 min-w-0 flex-1">
                                    <div class="avatar placeholder shrink-0">
                                        {% if shippingLine.shippingLineAdmins|length > 0 %}
                                            {% set firstAdmin = shippingLine.shippingLineAdmins|first %}
                                            <div class="w-12 h-12 {{ avatar_colors(firstAdmin) }} rounded-full">
                                                <span class="text-sm font-medium">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                                            </div>
                                        {% else %}
                                            <div class="w-12 h-12 bg-neutral text-neutral-content rounded-full">
                                                <span class="text-sm font-medium">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center flex-wrap gap-2">
                                            <h4 class="text-base sm:text-lg font-semibold truncate">{{ shippingLine.brandName }}</h4>
                                            {% if shippingLine.isActive %}
                                                <span class="badge badge-success badge-soft badge-sm gap-1"><span class="badge-dot"></span>Active</span>
                                            {% else %}
                                                <span class="badge badge-error badge-soft badge-sm gap-1"><span class="badge-dot"></span>Inactive</span>
                                            {% endif %}
                                        </div>
                                        <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs sm:text-sm text-base-content/70">
                                            <span class="inline-flex items-center gap-1"><span class="icon-[tabler--users] size-4"></span>{{ shippingLine.shippingLineAdmins|length }} admin(s)</span>
                                            <span class="inline-flex items-center gap-1"><span class="icon-[tabler--calendar] size-4"></span>Created {{ shippingLine.createdAt|date('M d, Y') }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 flex-wrap lg:flex-nowrap">
                                    <a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}" class="btn btn-sm btn-outline flex-1 lg:flex-initial">
                                        <span class="icon-[tabler--eye] size-4"></span>
                                        View
                                    </a>
                                    {% if app.user.role.value == 'SYSTEM_ADMIN' %}
                                        {% if shippingLine.isActive %}
                                            <button onclick="openDeactivateModal({{ shippingLine.id }}, '{{ shippingLine.brandName|e('js') }}')" class="btn btn-sm btn-error btn-outline flex-1 lg:flex-initial">
                                                <span class="icon-[tabler--ban] size-4"></span>
                                                Deactivate
                                            </button>
                                        {% else %}
                                            <button onclick="openActivateModal({{ shippingLine.id }}, '{{ shippingLine.brandName|e('js') }}')" class="btn btn-sm btn-success btn-outline flex-1 lg:flex-initial">
                                                <span class="icon-[tabler--circle-check] size-4"></span>
                                                Activate
                                            </button>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<!-- Activate Modal -->
<div id="activateModal" class="hidden fixed inset-0 z-[10002] items-center justify-center p-4" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeActivateModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6 text-center">
        <div class="mx-auto flex items-center justify-center size-14 rounded-full bg-success/10 mb-4">
            <span class="icon-[tabler--circle-check] size-7 text-success"></span>
        </div>
        <h3 class="text-lg font-bold mb-2">Activate Shipping Line</h3>
        <p class="text-sm text-base-content/70 mb-2" id="activateModalMessage">Are you sure you want to activate this shipping line?</p>
        <p class="text-xs text-success mb-6">This shipping line will become operational and accessible.</p>
        <div class="flex gap-3">
            <button type="button" onclick="closeActivateModal()" class="btn btn-ghost flex-1">Cancel</button>
            <button type="button" id="confirmActivateBtn" class="btn btn-success flex-1">Activate</button>
        </div>
    </div>
</div>

<!-- Deactivate Modal -->
<div id="deactivateModal" class="hidden fixed inset-0 z-[10002] items-center justify-center p-4" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeDeactivateModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6 text-center">
        <div class="mx-auto flex items-center justify-center size-14 rounded-full bg-error/10 mb-4">
            <span class="icon-[tabler--alert-triangle] size-7 text-error"></span>
        </div>
        <h3 class="text-lg font-bold mb-2">Deactivate Shipping Line</h3>
        <p class="text-sm text-base-content/70 mb-2" id="deactivateModalMessage">Are you sure you want to deactivate this shipping line?</p>
        <p class="text-xs text-error mb-6">This shipping line will no longer be accessible.</p>
        <div class="flex gap-3">
            <button type="button" onclick="closeDeactivateModal()" class="btn btn-ghost flex-1">Cancel</button>
            <button type="button" id="confirmDeactivateBtn" class="btn btn-error flex-1">Deactivate</button>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
let currentShippingLineId = null;

// Modal functions
function openActivateModal(id, name) {
    currentShippingLineId = id;
    document.getElementById('activateModalMessage').textContent = `Are you sure you want to activate ${name}?`;
    const modal = document.getElementById('activateModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeActivateModal() {
    const modal = document.getElementById('activateModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    currentShippingLineId = null;
}

function openDeactivateModal(id, name) {
    currentShippingLineId = id;
    document.getElementById('deactivateModalMessage').textContent = `Are you sure you want to deactivate ${name}?`;
    const modal = document.getElementById('deactivateModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeDeactivateModal() {
    const modal = document.getElementById('deactivateModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    currentShippingLineId = null;
}

// Confirm button handlers
document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('confirmActivateBtn').addEventListener('click', function() {
        if (currentShippingLineId) {
            activateShippingLine(currentShippingLineId);
        }
    });

    document.getElementById('confirmDeactivateBtn').addEventListener('click', function() {
        if (currentShippingLineId) {
            deactivateShippingLine(currentShippingLineId);
        }
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeActivateModal();
            closeDeactivateModal();
        }
    });
});

function deactivateShippingLine(id) {
    const btn = document.getElementById('confirmDeactivateBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Deactivating...';
    
    // Get CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    
    fetch(`/admin/shipping-lines/${id}/deactivate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            ...(csrfToken && { 'X-CSRF-Token': csrfToken })
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            closeDeactivateModal();
            location.reload();
        } else {
            alert('Error: ' + (data.error || data.message || 'Unknown error occurred'));
            // Reset button state
            btn.disabled = false;
            btn.textContent = 'Deactivate';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while deactivating the shipping line.');
        // Reset button state
        btn.disabled = false;
        btn.textContent = 'Deactivate';
    });
}

function activateShippingLine(id) {
    const btn = document.getElementById('confirmActivateBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Activating...';
    
    // Get CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    
    fetch(`/admin/shipping-lines/${id}/activate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            ...(csrfToken && { 'X-CSRF-Token': csrfToken })
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            closeActivateModal();
            location.reload();
        } else {
            alert('Error: ' + (data.error || data.message || 'Unknown error occurred'));
            // Reset button state
            btn.disabled = false;
            btn.textContent = 'Activate';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while activating the shipping line.');
        // Reset button state
        btn.disabled = false;
        btn.textContent = 'Activate';
    });
}
</script>
{% endblock %}