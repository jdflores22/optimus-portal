{% extends 'layout/admin_base.html.twig' %}

{% block title %}Shipping Lines Statistics - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('admin_shipping_lines_list') }}">Shipping Lines</a></li>
        <li>Statistics</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title text-xl sm:text-2xl">
                <span class="icon-[tabler--chart-bar] size-6"></span>
                Shipping Lines Statistics
            </h1>
            <p class="text-sm text-base-content/70">Overview of shipping line management metrics</p>
        </div>
    </div>

    <div class="stats stats-vertical sm:stats-horizontal shadow w-full bg-base-100">
        <div class="stat">
            <div class="stat-figure text-primary"><span class="icon-[tabler--building] size-8"></span></div>
            <div class="stat-title">Total Shipping Lines</div>
            <div class="stat-value text-primary">{{ statistics.totalShippingLines ?? 0 }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-success"><span class="icon-[tabler--circle-check] size-8"></span></div>
            <div class="stat-title">Active</div>
            <div class="stat-value text-success">{{ statistics.activeShippingLines ?? 0 }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-info"><span class="icon-[tabler--users] size-8"></span></div>
            <div class="stat-title">Total Admins</div>
            <div class="stat-value text-info">{{ statistics.totalAdmins ?? 0 }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-warning"><span class="icon-[tabler--user-exclamation] size-8"></span></div>
            <div class="stat-title">Unassigned Admins</div>
            <div class="stat-value text-warning">{{ statistics.unassignedAdmins ?? 0 }}</div>
        </div>
    </div>

    {% if statistics.recentActivity is defined and statistics.recentActivity is not empty %}
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-lg">Recent Activity</h2>
            <p class="text-sm text-base-content/60 -mt-2 mb-4">Latest shipping line management activities</p>
            <ul class="divide-y divide-base-200">
                {% for activity in statistics.recentActivity %}
                <li class="py-4 flex items-start gap-3">
                    {% if activity.type == 'create' %}
                        <span class="badge badge-success badge-sm">Create</span>
                    {% elseif activity.type == 'update' %}
                        <span class="badge badge-info badge-sm">Update</span>
                    {% else %}
                        <span class="badge badge-ghost badge-sm">Activity</span>
                    {% endif %}
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">{{ activity.description }}</p>
                        <p class="text-xs text-base-content/60 mt-1">by {{ activity.user }} · {{ activity.timestamp|date('M d, Y H:i') }}</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    {% if statistics.shippingLinesWithoutAdmins is defined and statistics.shippingLinesWithoutAdmins is not empty %}
    <div class="card bg-base-100 shadow-sm border border-warning/30">
        <div class="card-body">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div>
                    <h2 class="card-title text-lg">Shipping Lines Without Admins</h2>
                    <p class="text-sm text-base-content/60">These shipping lines need administrators assigned</p>
                </div>
                <span class="badge badge-warning">Requires Attention</span>
            </div>
            <ul class="divide-y divide-base-200">
                {% for shippingLine in statistics.shippingLinesWithoutAdmins %}
                <li class="py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="avatar placeholder">
                            <div class="bg-warning/20 text-warning rounded-full w-10">
                                <span class="text-xs font-bold">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                            </div>
                        </div>
                        <div>
                            <p class="font-medium">{{ shippingLine.brandName }}</p>
                            <p class="text-xs text-base-content/60">Created {{ shippingLine.createdAt|date('M d, Y') }}</p>
                        </div>
                    </div>
                    <a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}" class="btn btn-primary btn-sm">Assign Admin</a>
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    {% if statistics.allShippingLines is defined and statistics.allShippingLines is not empty %}
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
            <div class="p-4 sm:p-6 border-b border-base-200">
                <h2 class="text-lg font-semibold">All Shipping Lines</h2>
                <p class="text-sm text-base-content/60">Complete list of all shipping lines in the system</p>
            </div>
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>Brand</th>
                            <th>Status</th>
                            <th>Admins</th>
                            <th>Users</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for shippingLine in statistics.allShippingLines %}
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="avatar placeholder">
                                        <div class="rounded-full w-8 {{ shippingLine.isActive ? 'bg-success/20 text-success' : 'bg-error/20 text-error' }}">
                                            <span class="text-xs">{{ shippingLine.brandName|slice(0, 2)|upper }}</span>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="font-medium">{{ shippingLine.brandName }}</div>
                                        <div class="text-xs text-base-content/60">{{ shippingLine.createdAt|date('M d, Y') }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if shippingLine.isActive %}
                                    <span class="badge badge-success badge-sm">Active</span>
                                {% else %}
                                    <span class="badge badge-error badge-sm">Inactive</span>
                                {% endif %}
                            </td>
                            <td>{{ shippingLine.shippingLineAdmins|length }}</td>
                            <td>{{ shippingLine.scopedUsers|length }}</td>
                            <td class="text-right">
                                <a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}" class="btn btn-ghost btn-xs">View Details</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
