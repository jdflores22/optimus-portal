{% extends 'layout/admin_base.html.twig' %}

{% block title %}{{ shippingLine.brandName }} - Shipping Line Details{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li><a href="{{ path('admin_shipping_lines_list') }}">Shipping Lines</a></li>
        <li>{{ shippingLine.brandName }}</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
                <div class="min-w-0">
                    <div class="flex items-center gap-4">
                        <div class="size-12 rounded-xl bg-primary text-primary-content flex items-center justify-center shrink-0 font-bold text-lg">
                            {{ shippingLine.brandName|slice(0, 2)|upper }}
                        </div>
                        <div class="min-w-0">
                            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content truncate">{{ shippingLine.brandName }}</h1>
                            <p class="text-sm text-base-content/60 mt-1">Shipping line management and configuration</p>
                            <div class="flex flex-wrap items-center gap-2 mt-2">
                                {% if shippingLine.isActive %}
                                    <span class="badge badge-success badge-sm">Active</span>
                                {% else %}
                                    <span class="badge badge-error badge-sm">Inactive</span>
                                {% endif %}
                                <span class="text-xs text-base-content/50 flex items-center gap-1">
                                    <span class="icon-[tabler--calendar] size-3"></span>
                                    Created {{ statistics.createdAt|date('M d, Y') }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                    <a href="{{ path('admin_shipping_lines_edit', {id: shippingLine.id}) }}" class="btn btn-outline btn-sm gap-2">
                        <span class="icon-[tabler--edit] size-4"></span>
                        Edit
                    </a>
                    {% if shippingLine.isActive %}
                        <button type="button" onclick="deactivateShippingLine()" class="btn btn-error btn-sm gap-2">
                            <span class="icon-[tabler--ban] size-4"></span>
                            Deactivate
                        </button>
                    {% endif %}
                    <a href="{{ path('admin_shipping_lines_list') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span class="icon-[tabler--circle-check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-base-content/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--users] size-5 text-base-content/70"></span>
                        </div>
                        <div>
                            <p class="text-xs text-base-content/60">Total Admins</p>
                            <p class="text-2xl font-bold">{{ statistics.totalAdmins }}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-success/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--circle-check] size-5 text-success"></span>
                        </div>
                        <div>
                            <p class="text-xs text-base-content/60">Active Admins</p>
                            <p class="text-2xl font-bold text-success">{{ statistics.activeAdmins }}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--users-group] size-5 text-primary"></span>
                        </div>
                        <div>
                            <p class="text-xs text-base-content/60">Total Users</p>
                            <p class="text-2xl font-bold">{{ statistics.totalUsers }}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <div class="flex items-center gap-3">
                        <div class="size-10 bg-secondary/10 rounded-full flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--clock] size-5 text-secondary"></span>
                        </div>
                        <div>
                            <p class="text-xs text-base-content/60">Last Updated</p>
                            <p class="text-lg font-bold">
                                {% if statistics.lastUpdated %}{{ statistics.lastUpdated|date('M d') }}{% else %}Never{% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:gap-6 lg:grid-cols-3">
            <div class="lg:col-span-2 space-y-5 sm:space-y-6">

                <!-- Administrators -->
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 pt-4 sm:pt-5">
                        <div>
                            <h3 class="card-title text-base sm:text-lg flex items-center gap-2">
                                <span class="icon-[tabler--user-shield] size-5 text-secondary"></span>
                                Shipping Line Administrators
                            </h3>
                            <p class="text-sm text-base-content/60 mt-1">Manage administrators for this shipping line</p>
                        </div>
                        <button type="button" onclick="openAssignAdminModal()" class="btn btn-secondary btn-sm gap-2">
                            <span class="icon-[tabler--plus] size-4"></span>
                            Assign Admin
                        </button>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-0">
                        {% if shippingLine.shippingLineAdmins is empty %}
                            <div class="flex flex-col items-center justify-center py-12 text-center">
                                <div class="size-14 bg-secondary/10 rounded-full flex items-center justify-center mb-4">
                                    <span class="icon-[tabler--user-shield] size-7 text-secondary"></span>
                                </div>
                                <h3 class="font-medium text-base-content">No administrators assigned</h3>
                                <p class="text-sm text-base-content/60 mt-1">Get started by assigning an administrator.</p>
                                <button type="button" onclick="openAssignAdminModal()" class="btn btn-secondary btn-sm gap-2 mt-4">
                                    <span class="icon-[tabler--plus] size-4"></span>
                                    Assign First Admin
                                </button>
                            </div>
                        {% else %}
                            <div class="space-y-3">
                                {% for admin in shippingLine.shippingLineAdmins %}
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 rounded-xl bg-base-200/50 border border-base-300 p-4">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <div class="size-10 rounded-full {{ avatar_colors(admin) }} flex items-center justify-center shrink-0">
                                                <span class="text-sm font-semibold">{{ admin.email|slice(0, 2)|upper }}</span>
                                            </div>
                                            <div class="min-w-0">
                                                <p class="font-medium text-sm truncate">{{ admin.email }}</p>
                                                <p class="text-xs text-base-content/50 flex items-center gap-1 mt-0.5">
                                                    <span class="icon-[tabler--users] size-3"></span>
                                                    {% if admin.subordinateUsers|length > 0 %}
                                                        Manages {{ admin.subordinateUsers|length }} user(s)
                                                    {% else %}
                                                        No subordinates
                                                    {% endif %}
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 shrink-0">
                                            {% if admin.isActive %}
                                                <span class="badge badge-success badge-sm">Active</span>
                                            {% else %}
                                                <span class="badge badge-error badge-sm">Inactive</span>
                                            {% endif %}
                                            <button type="button" onclick="removeAdmin({{ admin.id }})" class="btn btn-xs btn-error gap-1">
                                                <span class="icon-[tabler--user-minus] size-3"></span>
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- User Hierarchy -->
                {% if canViewUserHierarchy %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5">
                        <h3 class="card-title text-base sm:text-lg">Complete User Hierarchy</h3>
                        <p class="text-sm text-base-content/60 mt-1">All users associated with this shipping line</p>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-0">
                        {% if userHierarchy is empty %}
                            <div class="flex flex-col items-center py-10 text-center">
                                <span class="icon-[tabler--users] size-10 text-base-content/30"></span>
                                <p class="mt-3 text-sm text-base-content/60">No administrators or users assigned.</p>
                            </div>
                        {% else %}
                            <div class="space-y-4">
                                {% for hierarchy in userHierarchy %}
                                    <div class="rounded-xl border border-base-300 p-4">
                                        <div class="flex items-center justify-between gap-3 mb-3">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="size-10 rounded-full {{ avatar_colors(hierarchy.admin) }} flex items-center justify-center shrink-0">
                                                    <span class="text-sm font-semibold">{{ hierarchy.admin.email|slice(0, 2)|upper }}</span>
                                                </div>
                                                <div class="min-w-0">
                                                    <p class="font-medium text-sm truncate">
                                                        {% if hierarchy.admin.firstName is defined and hierarchy.admin.lastName is defined %}
                                                            {{ hierarchy.admin.firstName }} {{ hierarchy.admin.lastName }}
                                                        {% else %}
                                                            {{ hierarchy.admin.email|split('@')[0]|title }}
                                                        {% endif %}
                                                    </p>
                                                    <p class="text-xs text-base-content/50 truncate">
                                                        <span class="badge badge-primary badge-xs">{{ hierarchy.admin.role.value|replace({'_': ' '})|title }}</span>
                                                        · {{ hierarchy.admin.email }}
                                                    </p>
                                                </div>
                                            </div>
                                            <span class="badge badge-sm {{ hierarchy.admin.isActive ? 'badge-success' : 'badge-error' }}">
                                                {{ hierarchy.admin.isActive ? 'Active' : 'Inactive' }}
                                            </span>
                                        </div>
                                        {% if hierarchy.subordinates is not empty %}
                                            <div class="ml-4 sm:ml-6 border-l-2 border-base-300 pl-4 space-y-2">
                                                <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2">
                                                    Subordinates ({{ hierarchy.subordinates|length }})
                                                </p>
                                                {% for subordinate in hierarchy.subordinates %}
                                                    <div class="flex items-center justify-between gap-2 rounded-lg bg-base-200/50 p-2">
                                                        <div class="flex items-center gap-2 min-w-0">
                                                            <div class="size-7 rounded-full {{ avatar_colors(subordinate) }} flex items-center justify-center shrink-0">
                                                                <span class="text-xs font-semibold">{{ subordinate.email|slice(0, 1)|upper }}</span>
                                                            </div>
                                                            <div class="min-w-0">
                                                                <p class="text-xs font-medium truncate">
                                                                    {% if subordinate.firstName is defined and subordinate.lastName is defined %}
                                                                        {{ subordinate.firstName }} {{ subordinate.lastName }}
                                                                    {% else %}
                                                                        {{ subordinate.email|split('@')[0]|title }}
                                                                    {% endif %}
                                                                </p>
                                                                <p class="text-xs text-base-content/50 truncate">
                                                                    <span class="badge badge-ghost badge-xs">{{ subordinate.role.value|replace({'_': ' '})|title }}</span>
                                                                    · {{ subordinate.email }}
                                                                </p>
                                                            </div>
                                                        </div>
                                                        <span class="badge badge-xs {{ subordinate.isActive ? 'badge-success' : 'badge-error' }} shrink-0">
                                                            {{ subordinate.isActive ? 'Active' : 'Inactive' }}
                                                        </span>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="ml-4 sm:ml-6 border-l-2 border-base-300 pl-4">
                                                <p class="text-xs text-base-content/50 italic">No subordinate users</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}

                <!-- Container Yard Allocations -->
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 pt-4 sm:pt-5">
                        <div>
                            <h3 class="card-title text-base sm:text-lg flex items-center gap-2">
                                <span class="icon-[tabler--building-warehouse] size-5 text-primary"></span>
                                Container Yard Allocations
                            </h3>
                            <p class="text-sm text-base-content/60 mt-1">
                                <span class="badge badge-primary badge-xs">Shipping Line Level</span>
                                Shared across all staff in {{ shippingLine.brandName }}
                            </p>
                        </div>
                        <button type="button" onclick="openAddContainerYardModal()" class="btn btn-primary btn-sm gap-2">
                            <span class="icon-[tabler--plus] size-4"></span>
                            Add Container Yard
                        </button>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-0">
                        <div id="containerYardAllocations">
                            <div class="flex flex-col items-center py-12 text-center">
                                <span class="loading loading-spinner loading-lg text-primary"></span>
                                <p class="mt-3 text-sm text-base-content/60">Loading allocations...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-5 sm:space-y-6">
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5">
                        <h3 class="card-title text-base">Portal Configuration</h3>
                        <p class="text-sm text-base-content/60 mt-1">Branding and portal settings</p>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-0 space-y-4">
                        {% if shippingLine.portalConfig.primaryColor is defined %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Primary Color</p>
                                <div class="flex items-center gap-2">
                                    <div class="size-6 rounded border border-base-300 shrink-0" style="background-color: {{ shippingLine.portalConfig.primaryColor }}"></div>
                                    <span class="text-sm font-mono">{{ shippingLine.portalConfig.primaryColor }}</span>
                                </div>
                            </div>
                        {% endif %}
                        {% if shippingLine.portalConfig.logoUrl is defined and shippingLine.portalConfig.logoUrl %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Logo</p>
                                <img src="{{ shippingLine.portalConfig.logoUrl }}"
                                     alt="{{ shippingLine.brandName }} Logo"
                                     class="h-16 w-auto border border-base-300 rounded-lg"
                                     onerror="this.classList.add('hidden')">
                                <a href="{{ shippingLine.portalConfig.logoUrl }}" target="_blank" class="link link-primary text-xs mt-1 block truncate">
                                    {{ shippingLine.portalConfig.logoUrl }}
                                </a>
                            </div>
                        {% endif %}
                        {% if shippingLine.portalConfig.contactEmail is defined and shippingLine.portalConfig.contactEmail %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Contact Email</p>
                                <p class="text-sm">{{ shippingLine.portalConfig.contactEmail }}</p>
                            </div>
                        {% endif %}
                        {% if shippingLine.portalConfig.contactPhone is defined and shippingLine.portalConfig.contactPhone %}
                            <div>
                                <p class="text-xs font-medium text-base-content/60 mb-1">Contact Phone</p>
                                <p class="text-sm">{{ shippingLine.portalConfig.contactPhone }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<div id="slToastContainer" class="fixed top-20 right-4 z-[10003] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>

<div id="slConfirmModal"
     class="hidden fixed inset-0 z-[10002] items-center justify-center p-4"
     role="dialog"
     aria-modal="true">
    <div class="absolute inset-0 bg-black/60" data-sl-dismiss></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6" onclick="event.stopPropagation()">
        <div class="text-center">
            <div id="slConfirmIconWrap" class="size-14 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span id="slConfirmIcon" class="icon-[tabler--alert-triangle] size-7 text-error"></span>
            </div>
            <h3 id="slConfirmTitle" class="text-lg font-bold mb-2">Confirm Action</h3>
            <p id="slConfirmMessage" class="text-sm text-base-content/70 mb-6"></p>
            <div class="flex gap-3">
                <button type="button" data-sl-dismiss class="btn btn-ghost flex-1">Cancel</button>
                <button type="button" id="slConfirmBtn" class="btn btn-error flex-1">Confirm</button>
            </div>
        </div>
    </div>
</div>

<div id="dynamicModalHost"></div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    const shippingLineId = {{ shippingLine.id }};
    let allTerminals = [];
    let slConfirmCallback = null;

    function escHtml(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    function openDynamicModal(id, html) {
        closeDynamicModal(id);
        const host = document.getElementById('dynamicModalHost');
        host.insertAdjacentHTML('beforeend', html);
        document.body.style.overflow = 'hidden';
    }

    function closeDynamicModal(id) {
        const el = id ? document.getElementById(id) : document.querySelector('#dynamicModalHost > div');
        if (el) el.remove();
        if (!document.querySelector('#dynamicModalHost > div') && !document.getElementById('slConfirmModal').classList.contains('flex')) {
            document.body.style.overflow = '';
        }
    }

    window.closeContainerYardModal = function () { closeDynamicModal('containerYardModal'); };
    window.closeAssignAdminModal = function () { closeDynamicModal('assignAdminModal'); };
    window.closeRemoveConfirmModal = function () { closeDynamicModal('removeConfirmModal'); };

    function showToast(message, type) {
        type = type || 'success';
        const container = document.getElementById('slToastContainer');
        const map = { success: 'alert-success', error: 'alert-error', info: 'alert-info' };
        const icons = { success: 'icon-[tabler--circle-check]', error: 'icon-[tabler--alert-circle]', info: 'icon-[tabler--info-circle]' };
        const el = document.createElement('div');
        el.className = 'alert ' + (map[type] || map.success) + ' shadow-lg pointer-events-auto text-sm';
        el.innerHTML = '<span class="' + (icons[type] || icons.success) + ' size-5"></span><span>' + escHtml(message) + '</span>';
        container.appendChild(el);
        setTimeout(function () { el.remove(); }, 5000);
    }

    window.showError = function (m) { showToast(m, 'error'); };
    window.showSuccess = function (m) { showToast(m, 'success'); };

    function openSlConfirm(title, message, callback, btnClass, btnText) {
        document.getElementById('slConfirmTitle').textContent = title;
        document.getElementById('slConfirmMessage').textContent = message;
        document.getElementById('slConfirmBtn').className = 'btn flex-1 ' + (btnClass || 'btn-error');
        document.getElementById('slConfirmBtn').textContent = btnText || 'Confirm';
        slConfirmCallback = callback;
        const modal = document.getElementById('slConfirmModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeSlConfirm() {
        document.getElementById('slConfirmModal').classList.add('hidden');
        document.getElementById('slConfirmModal').classList.remove('flex');
        slConfirmCallback = null;
        if (!document.querySelector('#dynamicModalHost > div')) {
            document.body.style.overflow = '';
        }
    }

    document.querySelectorAll('[data-sl-dismiss]').forEach(function (el) {
        el.addEventListener('click', closeSlConfirm);
    });

    document.getElementById('slConfirmBtn').addEventListener('click', function () {
        if (slConfirmCallback) slConfirmCallback();
        closeSlConfirm();
    });

    function modalShell(id, title, bodyHtml) {
        return '<div id="' + id + '" class="fixed inset-0 z-[10002] flex items-center justify-center p-4" role="dialog" aria-modal="true">' +
            '<div class="absolute inset-0 bg-black/60" onclick="' + (id === 'containerYardModal' ? 'closeContainerYardModal()' : id === 'assignAdminModal' ? 'closeAssignAdminModal()' : 'closeRemoveConfirmModal()') + '"></div>' +
            '<div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">' +
            '<div class="flex items-center justify-between mb-4">' +
            '<h3 class="text-lg font-semibold">' + escHtml(title) + '</h3>' +
            '<button type="button" class="btn btn-ghost btn-sm btn-circle" onclick="' + (id === 'containerYardModal' ? 'closeContainerYardModal()' : id === 'assignAdminModal' ? 'closeAssignAdminModal()' : 'closeRemoveConfirmModal()') + '"><span class="icon-[tabler--x] size-4"></span></button>' +
            '</div>' + bodyHtml + '</div></div>';
    }

    window.loadContainerYardAllocations = function () {
        fetch('/admin/shipping-lines/' + shippingLineId + '/container-yards')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    allTerminals = data.terminals || [];
                    displayContainerYardAllocations(allTerminals);
                } else {
                    showError('Error loading container yard allocations: ' + data.message);
                }
            })
            .catch(function () { showError('An error occurred while loading container yard allocations.'); });
    };

    function displayContainerYardAllocations(terminals) {
        const container = document.getElementById('containerYardAllocations');
        const allocations = terminals.filter(function (t) { return t.allocation !== null; });

        if (allocations.length === 0) {
            container.innerHTML = '<div class="flex flex-col items-center py-12 text-center">' +
                '<span class="icon-[tabler--building-warehouse] size-10 text-base-content/30"></span>' +
                '<p class="mt-3 font-medium">No container yards allocated</p>' +
                '<p class="text-sm text-base-content/60 mt-1">Get started by adding a container yard allocation.</p>' +
                '<button type="button" onclick="openAddContainerYardModal()" class="btn btn-primary btn-sm gap-2 mt-4">' +
                '<span class="icon-[tabler--plus] size-4"></span>Add First Container Yard</button></div>';
            return;
        }

        const html = allocations.map(function (terminal) {
            const a = terminal.allocation;
            const u = a.utilization || { currentTEUs: 0, allocatedTEUs: a.allocatedTEUs, percentage: 0, container20ft: 0, container40ft: 0 };
            const pct = u.percentage;
            let progressClass = 'progress-success';
            if (pct >= 100) progressClass = 'progress-error';
            else if (pct >= 80) progressClass = 'progress-warning';
            const tName = escHtml(terminal.name);
            const tLoc = escHtml(terminal.location || 'N/A');
            const tType = escHtml(terminal.type || '');

            return '<div class="card bg-base-200/40 border border-base-300">' +
                '<div class="card-body p-4 sm:p-5">' +
                '<div class="flex items-start justify-between gap-3 mb-4">' +
                '<div><h4 class="font-bold text-base">' + tName + '</h4>' +
                '<p class="text-sm text-base-content/60 flex items-center gap-1 mt-1">' +
                '<span class="icon-[tabler--map-pin] size-4"></span>' + tLoc + ' · ' + tType + '</p></div>' +
                '<div class="flex gap-1 shrink-0">' +
                '<button type="button" onclick="openEditContainerYardModal(' + a.id + ',' + terminal.id + ',\'' + terminal.name.replace(/'/g, "\\'") + '\',' + a.allocatedTEUs + ',' + (a.capacity20ft || 0) + ',' + (a.capacity40ft || 0) + ')" class="btn btn-xs btn-ghost text-primary" title="Edit"><span class="icon-[tabler--edit] size-3"></span></button>' +
                '<button type="button" onclick="removeContainerYard(' + a.id + ',\'' + terminal.name.replace(/'/g, "\\'") + '\')" class="btn btn-xs btn-error" title="Remove"><span class="icon-[tabler--trash] size-3"></span></button>' +
                '</div></div>' +
                '<div class="grid grid-cols-2 gap-3 mb-4">' +
                '<div class="rounded-lg bg-primary/10 p-3"><p class="text-xs text-primary font-medium">Allocated TEUs</p><p class="text-2xl font-bold text-primary">' + a.allocatedTEUs + '</p></div>' +
                '<div class="rounded-lg bg-base-100 p-3 border border-base-300"><p class="text-xs text-base-content/60 font-medium">Utilization</p><p class="text-2xl font-bold">' + pct + '%</p></div>' +
                '</div>' +
                '<div class="grid grid-cols-2 gap-3 mb-4">' +
                '<div class="rounded-lg bg-base-100 p-3 border border-base-300"><p class="text-xs text-base-content/60">20ft</p><p class="text-lg font-bold">' + (a.capacity20ft || 0) + ' <span class="text-sm font-normal text-base-content/50">units</span></p></div>' +
                '<div class="rounded-lg bg-base-100 p-3 border border-base-300"><p class="text-xs text-base-content/60">40ft</p><p class="text-lg font-bold">' + (a.capacity40ft || 0) + ' <span class="text-sm font-normal text-base-content/50">units</span></p></div>' +
                '</div>' +
                '<div class="flex justify-between text-xs text-base-content/60 mb-1"><span>Current: ' + u.currentTEUs + ' TEUs</span><span>Target: ' + a.allocatedTEUs + ' TEUs</span></div>' +
                '<progress class="progress ' + progressClass + ' w-full" value="' + Math.min(pct, 100) + '" max="100"></progress>' +
                '<div class="flex justify-between text-xs text-base-content/50 mt-2 pt-2 border-t border-base-300">' +
                '<span>20ft: ' + u.container20ft + ' in use</span><span>40ft: ' + u.container40ft + ' in use</span></div>' +
                '</div></div>';
        }).join('');

        container.innerHTML = '<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">' + html + '</div>';
    }

    window.openAddContainerYardModal = function () {
        const available = allTerminals.filter(function (t) { return t.allocation === null && t.isActive; });
        let body;
        if (available.length === 0) {
            body = '<div class="text-center py-8 text-base-content/60"><span class="icon-[tabler--building-warehouse] size-10 mx-auto block opacity-40"></span><p class="mt-3 text-sm">No available container yards.</p></div>';
        } else {
            body = '<form id="containerYardForm" onsubmit="submitContainerYardAllocation(event)" class="space-y-4">' +
                '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">Container Yard</span></label>' +
                '<select id="terminalSelect" required class="select select-bordered w-full"><option value="">Choose a container yard...</option>' +
                available.map(function (t) { return '<option value="' + t.id + '">' + escHtml(t.name) + ' - ' + escHtml(t.location || 'N/A') + '</option>'; }).join('') +
                '</select></div>' +
                '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">20ft Container Capacity</span></label>' +
                '<input type="number" id="capacity20ft" required min="0" step="1" value="0" oninput="calculateTEU()" class="input input-bordered w-full"></div>' +
                '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">40ft Container Capacity</span></label>' +
                '<input type="number" id="capacity40ft" required min="0" step="1" value="0" oninput="calculateTEU()" class="input input-bordered w-full"></div>' +
                '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">Allocated TEU (auto)</span></label>' +
                '<input type="number" id="allocatedTEUs" required min="1" readonly class="input input-bordered w-full input-disabled"></div>' +
                '<div id="modalError" class="alert alert-error hidden text-sm"></div>' +
                '<div class="flex gap-3"><button type="button" onclick="closeContainerYardModal()" class="btn btn-ghost flex-1">Cancel</button>' +
                '<button type="submit" id="submitButton" class="btn btn-primary flex-1">Save Allocation</button></div></form>';
        }
        openDynamicModal('containerYardModal', modalShell('containerYardModal', 'Add Container Yard Allocation', body));
    };

    window.openEditContainerYardModal = function (allocationId, terminalId, terminalName, currentCapacity, capacity20ft, capacity40ft) {
        const body = '<form id="containerYardForm" onsubmit="submitContainerYardAllocation(event,' + terminalId + ')" class="space-y-4">' +
            '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">Container Yard</span></label>' +
            '<input type="text" value="' + escHtml(terminalName) + '" disabled class="input input-bordered w-full input-disabled"></div>' +
            '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">20ft Container Capacity</span></label>' +
            '<input type="number" id="capacity20ft" required min="0" step="1" value="' + capacity20ft + '" oninput="calculateTEU()" class="input input-bordered w-full"></div>' +
            '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">40ft Container Capacity</span></label>' +
            '<input type="number" id="capacity40ft" required min="0" step="1" value="' + capacity40ft + '" oninput="calculateTEU()" class="input input-bordered w-full"></div>' +
            '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">Allocated TEU (auto)</span></label>' +
            '<input type="number" id="allocatedTEUs" required min="1" value="' + currentCapacity + '" readonly class="input input-bordered w-full input-disabled"></div>' +
            '<div id="modalError" class="alert alert-error hidden text-sm"></div>' +
            '<div class="flex gap-3"><button type="button" onclick="closeContainerYardModal()" class="btn btn-ghost flex-1">Cancel</button>' +
            '<button type="submit" id="submitButton" class="btn btn-primary flex-1">Update Allocation</button></div></form>';
        openDynamicModal('containerYardModal', modalShell('containerYardModal', 'Edit Container Yard Allocation', body));
        calculateTEU();
    };

    window.calculateTEU = function () {
        const c20 = document.getElementById('capacity20ft');
        const c40 = document.getElementById('capacity40ft');
        const teu = document.getElementById('allocatedTEUs');
        if (!c20 || !c40 || !teu) return;
        teu.value = (parseInt(c20.value, 10) || 0) + (parseInt(c40.value, 10) || 0);
    };

    window.showModalError = function (message) {
        const errorDiv = document.getElementById('modalError');
        if (errorDiv) {
            errorDiv.textContent = message;
            errorDiv.classList.remove('hidden');
        }
    };

    window.submitContainerYardAllocation = function (event, terminalId) {
        event.preventDefault();
        const terminalIdValue = terminalId || document.getElementById('terminalSelect').value;
        const allocatedTEUs = document.getElementById('allocatedTEUs').value;
        const capacity20ft = document.getElementById('capacity20ft').value;
        const capacity40ft = document.getElementById('capacity40ft').value;

        if (!terminalIdValue) { showModalError('Please select a container yard.'); return; }
        if (!allocatedTEUs || allocatedTEUs <= 0) { showModalError('Allocated capacity must be greater than zero.'); return; }

        const submitButton = document.getElementById('submitButton');
        const originalText = submitButton.textContent;
        submitButton.textContent = 'Saving...';
        submitButton.disabled = true;

        const formData = new FormData();
        formData.append('terminalId', terminalIdValue);
        formData.append('allocatedTEUs', allocatedTEUs);
        formData.append('capacity20ft', capacity20ft);
        formData.append('capacity40ft', capacity40ft);

        fetch('/admin/shipping-lines/' + shippingLineId + '/container-yards/allocate', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    closeContainerYardModal();
                    showSuccess(data.message || 'Container yard allocated successfully');
                    loadContainerYardAllocations();
                } else {
                    showModalError(data.message || 'Error allocating container yard');
                    submitButton.textContent = originalText;
                    submitButton.disabled = false;
                }
            })
            .catch(function () {
                showModalError('An error occurred while allocating the container yard.');
                submitButton.textContent = originalText;
                submitButton.disabled = false;
            });
    };

    window.removeContainerYard = function (allocationId, terminalName) {
        const body = '<p class="text-sm text-base-content/70 text-center mb-6">Remove allocation for <strong>' + escHtml(terminalName) + '</strong>? This cannot be undone.</p>' +
            '<div class="flex gap-3"><button type="button" onclick="closeRemoveConfirmModal()" class="btn btn-ghost flex-1">Cancel</button>' +
            '<button type="button" onclick="confirmRemoveContainerYard(' + allocationId + ')" class="btn btn-error flex-1">Remove</button></div>';
        openDynamicModal('removeConfirmModal', modalShell('removeConfirmModal', 'Remove Container Yard', body));
    };

    window.confirmRemoveContainerYard = function (allocationId) {
        closeRemoveConfirmModal();
        fetch('/admin/shipping-lines/' + shippingLineId + '/container-yards/' + allocationId + '/remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    showSuccess(data.message || 'Allocation removed');
                    loadContainerYardAllocations();
                } else {
                    showError(data.message || 'Error removing allocation');
                }
            })
            .catch(function () { showError('An error occurred while removing the allocation.'); });
    };

    window.openAssignAdminModal = function () {
        fetch('/admin/shipping-lines/' + shippingLineId + '/available-admins')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) showAssignAdminModal(data.admins);
                else showError('Error loading available admins: ' + data.message);
            })
            .catch(function () { showError('An error occurred while loading available admins.'); });
    };

    function showAssignAdminModal(admins) {
        let body;
        if (admins.length === 0) {
            body = '<div class="text-center py-8 text-base-content/60"><span class="icon-[tabler--users] size-10 mx-auto block opacity-40"></span><p class="mt-3 text-sm">No available administrators.</p></div>';
        } else {
            body = '<div class="space-y-4">' +
                '<div class="form-control"><label class="label py-1"><span class="label-text font-medium">Select Administrator</span></label>' +
                '<select id="adminSelect" class="select select-bordered w-full"><option value="">Choose an administrator...</option>' +
                admins.map(function (a) { return '<option value="' + a.id + '">' + escHtml(a.name) + ' (' + escHtml(a.email) + ')</option>'; }).join('') +
                '</select></div>' +
                '<div class="flex gap-3"><button type="button" onclick="closeAssignAdminModal()" class="btn btn-ghost flex-1">Cancel</button>' +
                '<button type="button" id="assignAdminBtn" onclick="assignSelectedAdmin()" class="btn btn-primary flex-1">Assign Admin</button></div></div>';
        }
        openDynamicModal('assignAdminModal', modalShell('assignAdminModal', 'Assign Administrator', body));
    }

    window.assignSelectedAdmin = function () {
        const adminSelect = document.getElementById('adminSelect');
        if (!adminSelect || !adminSelect.value) {
            showError('Please select an administrator.');
            return;
        }
        const assignButton = document.getElementById('assignAdminBtn');
        assignButton.textContent = 'Assigning...';
        assignButton.disabled = true;

        fetch('/admin/shipping-lines/' + shippingLineId + '/assign-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'adminId=' + encodeURIComponent(adminSelect.value)
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    closeAssignAdminModal();
                    location.reload();
                } else {
                    showError('Error assigning admin: ' + data.message);
                    assignButton.textContent = 'Assign Admin';
                    assignButton.disabled = false;
                }
            })
            .catch(function () {
                showError('An error occurred while assigning the admin.');
                assignButton.textContent = 'Assign Admin';
                assignButton.disabled = false;
            });
    };

    window.removeAdmin = function (adminId) {
        openSlConfirm(
            'Remove Administrator',
            'Are you sure you want to remove this administrator from the shipping line?',
            function () {
                fetch('/admin/shipping-lines/' + shippingLineId + '/remove-admin/' + adminId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success) location.reload();
                        else showError('Error removing admin: ' + data.message);
                    })
                    .catch(function () { showError('An error occurred while removing the admin.'); });
            },
            'btn-error',
            'Remove'
        );
    };

    window.deactivateShippingLine = function () {
        openSlConfirm(
            'Deactivate Shipping Line',
            'Are you sure you want to deactivate this shipping line? This will restrict access for all associated users.',
            function () {
                fetch('/admin/shipping-lines/' + shippingLineId + '/deactivate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success) location.reload();
                        else showError('Error: ' + (data.error || data.message));
                    })
                    .catch(function () { showError('An error occurred while deactivating the shipping line.'); });
            },
            'btn-error',
            'Deactivate'
        );
    };

    document.addEventListener('DOMContentLoaded', loadContainerYardAllocations);
})();
</script>
{% endblock %}
