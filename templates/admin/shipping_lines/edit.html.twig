{% extends 'layout/admin_base.html.twig' %}

{% block title %}Edit {{ shippingLine.brandName }} - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li><a href="{{ path('admin_shipping_lines_list') }}">Shipping Lines</a></li>
        <li><a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}">{{ shippingLine.brandName }}</a></li>
        <li>Edit</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="min-w-0">
                    <h1 class="text-xl sm:text-2xl font-bold text-base-content truncate">Edit {{ shippingLine.brandName }}</h1>
                    <p class="text-sm text-base-content/60 mt-1">Update shipping line information and portal configuration</p>
                </div>
                <a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to Detail
                </a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6 md:py-8">
        <div class="max-w-3xl mx-auto">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success mb-6">
                    <span class="icon-[tabler--check] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error mb-6">
                    <span class="icon-[tabler--alert-circle] size-5"></span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <form id="shippingLineEditForm" method="POST" enctype="multipart/form-data">
                <div class="card bg-base-100 shadow-sm mb-5">
                    <div class="card-body p-6 sm:p-8">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="size-12 bg-primary text-primary-content rounded-xl flex items-center justify-center shrink-0 font-bold">
                                {{ shippingLine.brandName|slice(0, 2)|upper }}
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-base-content">Basic Information</h2>
                                <p class="text-sm text-base-content/60">Brand name, status, and company details</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="form-control sm:col-span-2 sm:grid-cols-1">
                                <label class="label py-1" for="brandName">
                                    <span class="label-text font-medium">Brand Name <span class="text-error">*</span></span>
                                </label>
                                <input type="text"
                                       name="brandName"
                                       id="brandName"
                                       value="{{ shippingLine.brandName }}"
                                       required
                                       class="input input-bordered w-full">
                            </div>

                            <div class="form-control">
                                <label class="label py-1" for="isActive">
                                    <span class="label-text font-medium">Status</span>
                                </label>
                                <select name="isActive" id="isActive" class="select select-bordered w-full">
                                    <option value="1" {% if shippingLine.isActive %}selected{% endif %}>Active</option>
                                    <option value="0" {% if not shippingLine.isActive %}selected{% endif %}>Inactive</option>
                                </select>
                            </div>

                            <div class="form-control">
                                <label class="label py-1" for="headquarters">
                                    <span class="label-text font-medium">Headquarters</span>
                                </label>
                                <input type="text"
                                       name="headquarters"
                                       id="headquarters"
                                       value="{{ shippingLine.headquarters }}"
                                       class="input input-bordered w-full">
                            </div>

                            <div class="form-control sm:col-span-2">
                                <label class="label py-1" for="description">
                                    <span class="label-text font-medium">Description</span>
                                </label>
                                <textarea name="description"
                                          id="description"
                                          rows="3"
                                          class="textarea textarea-bordered w-full">{{ shippingLine.description }}</textarea>
                                <label class="label py-1">
                                    <span class="label-text-alt text-base-content/60">Brief description of the shipping line</span>
                                </label>
                            </div>

                            <div class="form-control">
                                <label class="label py-1" for="website">
                                    <span class="label-text font-medium">Website</span>
                                </label>
                                <label class="input input-bordered flex items-center gap-2 w-full">
                                    <span class="icon-[tabler--world] size-4 text-base-content/50 shrink-0"></span>
                                    <input type="url"
                                           name="website"
                                           id="website"
                                           value="{{ shippingLine.website }}"
                                           class="grow"
                                           placeholder="https://">
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card bg-base-100 shadow-sm mb-5">
                    <div class="card-body p-6 sm:p-8 space-y-5">
                        <div class="flex items-center gap-3 mb-1">
                            <span class="icon-[tabler--address-book] size-5 text-primary"></span>
                            <h2 class="text-lg font-semibold text-base-content">Contact Information</h2>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="form-control">
                                <label class="label py-1" for="contactEmail">
                                    <span class="label-text font-medium">Contact Email</span>
                                </label>
                                <label class="input input-bordered flex items-center gap-2 w-full">
                                    <span class="icon-[tabler--mail] size-4 text-base-content/50 shrink-0"></span>
                                    <input type="email"
                                           name="contactEmail"
                                           id="contactEmail"
                                           value="{{ shippingLine.contactEmail }}"
                                           class="grow">
                                </label>
                            </div>

                            <div class="form-control">
                                <label class="label py-1" for="contactPhone">
                                    <span class="label-text font-medium">Contact Phone</span>
                                </label>
                                <label class="input input-bordered flex items-center gap-2 w-full">
                                    <span class="icon-[tabler--phone] size-4 text-base-content/50 shrink-0"></span>
                                    <input type="tel"
                                           name="contactPhone"
                                           id="contactPhone"
                                           value="{{ shippingLine.contactPhone }}"
                                           class="grow">
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card bg-base-100 shadow-sm mb-6">
                    <div class="card-body p-6 sm:p-8 space-y-5">
                        <div class="flex items-center gap-3 mb-1">
                            <span class="icon-[tabler--palette] size-5 text-primary"></span>
                            <h2 class="text-lg font-semibold text-base-content">Portal Configuration</h2>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="primaryColor">
                                <span class="label-text font-medium">Primary Color</span>
                            </label>
                            <div class="flex items-center gap-3">
                                <input type="color"
                                       name="primaryColor"
                                       id="primaryColor"
                                       value="{{ shippingLine.primaryColor }}"
                                       class="h-10 w-14 rounded-lg border border-base-300 cursor-pointer shrink-0">
                                <input type="text"
                                       name="primaryColorText"
                                       value="{{ shippingLine.primaryColor }}"
                                       class="input input-bordered flex-1 font-mono">
                            </div>
                        </div>

                        <div class="form-control">
                            <label class="label py-1" for="logo">
                                <span class="label-text font-medium">Logo</span>
                            </label>
                            {% if shippingLine.logoUrl %}
                                <div class="mb-3 flex items-center gap-3 rounded-xl bg-base-200/50 p-3">
                                    <img src="{{ shippingLine.logoUrl }}" alt="Current logo" class="h-14 w-auto border border-base-300 rounded-lg">
                                    <span class="text-xs text-base-content/60">Current logo — upload below to replace</span>
                                </div>
                            {% endif %}
                            <div class="rounded-xl border-2 border-dashed border-base-300 p-6 transition-colors" id="logoDropzone">
                                <div class="text-center" id="logoUploadArea">
                                    <span class="icon-[tabler--photo-up] size-10 text-base-content/30 mx-auto block"></span>
                                    <div class="mt-3 flex flex-wrap items-center justify-center gap-1 text-sm text-base-content/70">
                                        <label for="logo" class="link link-primary cursor-pointer font-medium">
                                            {% if shippingLine.logoUrl %}Upload new file{% else %}Upload a file{% endif %}
                                        </label>
                                        <span>or drag and drop</span>
                                    </div>
                                    <input id="logo" name="logo" type="file" accept="image/*" class="hidden">
                                    <p class="text-xs text-base-content/50 mt-2">PNG, JPG, GIF up to 10MB</p>
                                </div>
                                <div class="hidden text-center" id="logoPreview">
                                    <img id="logoPreviewImage" class="mx-auto h-32 w-auto rounded-lg border border-base-300" src="" alt="Logo preview">
                                    <p id="logoFileName" class="text-sm font-medium mt-2"></p>
                                    <p id="logoFileSize" class="text-xs text-base-content/50"></p>
                                    <button type="button" onclick="clearLogo()" class="btn btn-ghost btn-xs text-error mt-2 gap-1">
                                        <span class="icon-[tabler--x] size-3"></span>
                                        Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
                    <a href="{{ path('admin_shipping_lines_detail', {id: shippingLine.id}) }}" class="btn btn-ghost w-full sm:w-auto">
                        Cancel
                    </a>
                    <button type="submit" id="submitBtn" class="btn btn-primary gap-2 w-full sm:w-auto">
                        <span id="btnSpinner" class="loading loading-spinner loading-sm hidden"></span>
                        <span id="btnText">Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    const colorPicker = document.getElementById('primaryColor');
    const colorText = document.querySelector('input[name="primaryColorText"]');
    const logoInput = document.getElementById('logo');
    const dropzone = document.getElementById('logoDropzone');

    if (colorPicker && colorText) {
        colorPicker.addEventListener('input', function () {
            colorText.value = colorPicker.value;
        });
        colorText.addEventListener('input', function () {
            if (/^#[0-9A-Fa-f]{6}$/.test(colorText.value)) {
                colorPicker.value = colorText.value;
            }
        });
    }

    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function handleLogoFile(file) {
        if (!file) return;
        if (!file.type.startsWith('image/')) {
            alert('Please select an image file.');
            logoInput.value = '';
            return;
        }
        if (file.size > 10 * 1024 * 1024) {
            alert('File size must be less than 10MB.');
            logoInput.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById('logoUploadArea').classList.add('hidden');
            document.getElementById('logoPreview').classList.remove('hidden');
            document.getElementById('logoPreviewImage').src = e.target.result;
            document.getElementById('logoFileName').textContent = file.name;
            document.getElementById('logoFileSize').textContent = formatFileSize(file.size);
            dropzone.classList.add('border-success', 'bg-success/5');
            dropzone.classList.remove('border-base-300');
        };
        reader.readAsDataURL(file);
    }

    window.clearLogo = function () {
        logoInput.value = '';
        document.getElementById('logoPreview').classList.add('hidden');
        document.getElementById('logoUploadArea').classList.remove('hidden');
        dropzone.classList.remove('border-success', 'bg-success/5');
        dropzone.classList.add('border-base-300');
    };

    if (logoInput) {
        logoInput.addEventListener('change', function (e) {
            handleLogoFile(e.target.files[0]);
        });
    }

    if (dropzone) {
        dropzone.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropzone.classList.add('border-primary', 'bg-primary/5');
        });
        dropzone.addEventListener('dragleave', function () {
            dropzone.classList.remove('border-primary', 'bg-primary/5');
        });
        dropzone.addEventListener('drop', function (e) {
            e.preventDefault();
            dropzone.classList.remove('border-primary', 'bg-primary/5');
            const file = e.dataTransfer.files[0];
            if (file && logoInput) {
                const dt = new DataTransfer();
                dt.items.add(file);
                logoInput.files = dt.files;
                handleLogoFile(file);
            }
        });
    }

    document.getElementById('shippingLineEditForm').addEventListener('submit', function () {
        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        document.getElementById('btnText').textContent = 'Saving...';
        document.getElementById('btnSpinner').classList.remove('hidden');
    });
})();
</script>
{% endblock %}
