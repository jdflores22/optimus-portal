{% extends 'base.html.twig' %}

{% block title %}Appeal Detail - OPTIMUS{% endblock %}

{% block body %}
<div class="bg-gradient-to-br from-gray-50 via-blue-50 to-gray-50 min-h-screen">
    <!-- Header -->
    <div class="bg-white border-b border-gray-200 shadow-sm mb-6">
        <div class="px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Appeal #{{ appeal.id }}</h1>
                    <p class="text-sm text-gray-600 mt-1">Submitted by {{ appeal.user.email }}</p>
                </div>
                <a href="{{ path('admin_appeals_list') }}" 
                   class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="px-6 max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Appeal Status -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Appeal Status</h3>
                    <div class="flex items-center space-x-4">
                        {% if appeal.status == 'pending' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Pending Review
                            </span>
                        {% elseif appeal.status == 'approved' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Approved
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Rejected
                            </span>
                        {% endif %}
                        <span class="text-sm text-gray-500">Submitted {{ appeal.submittedAt|date('M j, Y g:i A') }}</span>
                    </div>
                </div>

                <!-- Original Suspension Reason -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Original Suspension Reason</h3>
                    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                        <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ originalSuspensionReason ?? 'No reason provided' }}</p>
                    </div>
                    {% if appeal.user.suspensionAttachments and appeal.user.suspensionAttachments|length > 0 %}
                        <div class="mt-4">
                            <p class="text-sm font-medium text-gray-700 mb-2">Suspension Attachments:</p>
                            <div class="space-y-2">
                                {% for attachment in appeal.user.suspensionAttachments %}
                                    <a href="{{ attachment }}" target="_blank" class="flex items-center text-sm text-blue-600 hover:text-blue-800">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                        </svg>
                                        {{ attachment|split('/')|last }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>

                <!-- Appeal Letter -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Appeal Letter</h3>
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                        <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ appeal.appealLetter }}</p>
                    </div>
                </div>

                <!-- Appeal Attachments -->
                {% if appeal.appealAttachments and appeal.appealAttachments|length > 0 %}
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Supporting Documents</h3>
                    <div class="space-y-2">
                        {% for attachment in appeal.appealAttachments %}
                            <a href="{{ attachment }}" target="_blank" download
                               class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors">
                                <div class="flex items-center">
                                    <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                    </svg>
                                    <span class="text-sm text-gray-700">{{ attachment|split('/')|last }}</span>
                                </div>
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                                </svg>
                            </a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Review Section (if already reviewed) -->
                {% if appeal.status != 'pending' %}
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Review Decision</h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm font-medium text-gray-700">Reviewed By:</p>
                            <p class="text-sm text-gray-900">{{ appeal.reviewedBy.email }}</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-700">Reviewed At:</p>
                            <p class="text-sm text-gray-900">{{ appeal.reviewedAt|date('M j, Y g:i A') }}</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-700">Review Notes:</p>
                            <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 mt-1">
                                <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ appeal.reviewNotes }}</p>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Broker Info -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Broker Information</h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase">Email</p>
                            <p class="text-sm text-gray-900 mt-1">{{ appeal.user.email }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase">User ID</p>
                            <p class="text-sm text-gray-900 mt-1">{{ appeal.user.id }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase">Current Status</p>
                            <p class="text-sm text-gray-900 mt-1">{{ appeal.user.status.value }}</p>
                        </div>
                    </div>
                </div>

                <!-- Review Actions (if pending) -->
                {% if appeal.status == 'pending' %}
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Review Appeal</h3>
                    <form id="reviewForm">
                        <div class="mb-4">
                            <label for="review_notes" class="block text-sm font-medium text-gray-700 mb-2">
                                Review Notes <span class="text-red-500">*</span>
                            </label>
                            <textarea id="review_notes" name="review_notes" rows="4" required
                                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                      placeholder="Explain your decision..."></textarea>
                        </div>

                        <div class="space-y-2">
                            <button type="button" onclick="reviewAppeal('approve')"
                                    class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Approve & Reactivate
                            </button>
                            <button type="button" onclick="reviewAppeal('reject')"
                                    class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Reject Appeal
                            </button>
                        </div>
                    </form>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="hidden fixed inset-0 z-[9999] overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="fixed inset-0 transition-opacity bg-gray-900 bg-opacity-75" onclick="closeConfirmModal()"></div>
        
        <div class="relative bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all max-w-lg w-full">
            <div class="bg-white px-6 pt-5 pb-4">
                <div class="sm:flex sm:items-start">
                    <div id="modalIcon" class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full sm:mx-0 sm:h-10 sm:w-10">
                    </div>
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left flex-1">
                        <h3 id="modalTitle" class="text-lg leading-6 font-medium text-gray-900"></h3>
                        <div class="mt-2">
                            <p id="modalMessage" class="text-sm text-gray-500"></p>
                            <div class="mt-3 bg-gray-50 border border-gray-200 rounded-lg p-3">
                                <p class="text-xs font-medium text-gray-700 mb-1">Your Review Notes:</p>
                                <p id="modalReviewNotes" class="text-sm text-gray-600 whitespace-pre-wrap"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-6 py-3 sm:flex sm:flex-row-reverse gap-2">
                <button type="button" id="confirmBtn"
                        class="w-full inline-flex justify-center rounded-lg border border-transparent shadow-sm px-4 py-2 text-base font-medium text-white focus:outline-none focus:ring-2 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm">
                </button>
                <button type="button" onclick="closeConfirmModal()"
                        class="mt-3 w-full inline-flex justify-center rounded-lg border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 sm:mt-0 sm:w-auto sm:text-sm">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let currentAction = '';
let currentReviewNotes = '';

function reviewAppeal(action) {
    const reviewNotes = document.getElementById('review_notes').value;
    
    if (!reviewNotes.trim()) {
        showToast('Please provide review notes', 'error');
        return;
    }

    // Show confirmation modal
    showConfirmModal(action, reviewNotes);
}

function showConfirmModal(action, reviewNotes) {
    currentAction = action;
    currentReviewNotes = reviewNotes;
    
    const isApprove = action === 'approve';
    const modal = document.getElementById('confirmModal');
    const modalIcon = document.getElementById('modalIcon');
    const modalTitle = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');
    const modalReviewNotes = document.getElementById('modalReviewNotes');
    const confirmBtn = document.getElementById('confirmBtn');
    
    // Set icon
    modalIcon.className = `mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full ${isApprove ? 'bg-green-100' : 'bg-red-100'} sm:mx-0 sm:h-10 sm:w-10`;
    modalIcon.innerHTML = isApprove 
        ? `<svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
           </svg>`
        : `<svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1-1.964-1-2.732 0L3.732 16c-.77 1.333.192 3 1.732 3z"></path>
           </svg>`;
    
    // Set title and message
    modalTitle.textContent = isApprove ? 'Approve Appeal' : 'Reject Appeal';
    modalMessage.textContent = isApprove 
        ? 'Are you sure you want to approve this appeal and reactivate the broker account? This action will restore full access to the broker.'
        : 'Are you sure you want to reject this appeal? The broker will remain suspended and will be notified of your decision.';
    
    // Set review notes
    modalReviewNotes.textContent = reviewNotes;
    
    // Set confirm button
    confirmBtn.className = `w-full inline-flex justify-center rounded-lg border border-transparent shadow-sm px-4 py-2 text-base font-medium text-white focus:outline-none focus:ring-2 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm ${isApprove ? 'bg-green-600 hover:bg-green-700 focus:ring-green-500' : 'bg-red-600 hover:bg-red-700 focus:ring-red-500'}`;
    confirmBtn.textContent = isApprove ? 'Approve & Reactivate' : 'Reject Appeal';
    confirmBtn.onclick = confirmReview;
    
    // Show modal
    modal.classList.remove('hidden');
}

function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    modal.classList.add('hidden');
    currentAction = '';
    currentReviewNotes = '';
}

function confirmReview() {
    // Store values before closing modal
    const action = currentAction;
    const reviewNotes = currentReviewNotes;
    
    closeConfirmModal();
    
    const formData = new FormData();
    formData.append('action', action);
    formData.append('review_notes', reviewNotes);

    // Show loading state
    const buttons = document.querySelectorAll('button[onclick^="reviewAppeal"]');
    buttons.forEach(btn => {
        btn.disabled = true;
        btn.innerHTML = '<svg class="animate-spin h-4 w-4 mx-auto" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
    });

    fetch('{{ path('admin_appeals_review', {id: appeal.id}) }}', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast(data.message, 'success');
            setTimeout(() => {
                window.location.reload();
            }, 1500);
        } else {
            showToast('Error: ' + data.message, 'error');
            buttons.forEach(btn => {
                btn.disabled = false;
            });
        }
    })
    .catch(error => {
        showToast('An error occurred. Please try again.', 'error');
        console.error('Error:', error);
        buttons.forEach(btn => {
            btn.disabled = false;
        });
    });
}

function showToast(message, type = 'success') {
    // Create toast container if it doesn't exist
    let toastContainer = document.getElementById('toastContainer');
    if (!toastContainer) {
        toastContainer = document.createElement('div');
        toastContainer.id = 'toastContainer';
        toastContainer.className = 'fixed top-20 right-4 z-[10000] space-y-2';
        document.body.appendChild(toastContainer);
    }
    
    const toast = document.createElement('div');
    toast.className = `rounded-lg p-4 shadow-lg transform transition-all duration-300 ${
        type === 'success' ? 'bg-green-50 border border-green-200' : 'bg-red-50 border border-red-200'
    }`;
    
    const iconColor = type === 'success' ? 'text-green-600' : 'text-red-600';
    const textColor = type === 'success' ? 'text-green-800' : 'text-red-800';
    const iconPath = type === 'success' 
        ? 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
        : 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z';
    
    toast.innerHTML = `
        <div class="flex items-center">
            <svg class="w-5 h-5 ${iconColor} mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${iconPath}"></path>
            </svg>
            <span class="text-sm font-medium ${textColor}">${message}</span>
        </div>
    `;
    
    toastContainer.appendChild(toast);
    
    // Auto dismiss after 5 seconds
    setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => {
            toast.remove();
            // Remove container if empty
            if (toastContainer.children.length === 0) {
                toastContainer.remove();
            }
        }, 300);
    }, 5000);
}
</script>
{% endblock %}
