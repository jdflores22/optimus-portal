{% extends 'layout/admin_base.html.twig' %}

{% block title %}Appeal #{{ appeal.id }} - OPTIMUS{% endblock %}
{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
                                <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
                                <li><a href="{{ path('admin_appeals_list') }}">Suspension Appeals</a></li>
                                <li>Appeal #{{ appeal.id }}</li>
                            </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
<div class="space-y-5 sm:space-y-6 max-w-6xl mx-auto">

        {# Header #}
        <div class="bg-base-100 shadow-sm rounded-xl">
            <div class="p-4 sm:p-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-start gap-4">
                            <div class="size-12 rounded-xl bg-warning/10 flex items-center justify-center shrink-0">
                                <span class="icon-[tabler--scale] size-6 text-warning"></span>
                            </div>
                            <div class="min-w-0">
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Appeal #{{ appeal.id }}</h1>
                                <p class="text-sm text-base-content/60 mt-1">Submitted by {{ appeal.user.email }}</p>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('admin_appeals_list') }}" class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to List
                    </a>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 sm:gap-6">
            {# Main content #}
            <div class="lg:col-span-2 space-y-5 sm:space-y-6">

                {# Appeal status #}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                        <div class="flex items-center gap-2">
                            <span class="icon-[tabler--info-circle] size-5 text-base-content/70"></span>
                            <h2 class="card-title text-base sm:text-lg">Appeal Status</h2>
                        </div>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                        <div class="flex flex-wrap items-center gap-3">
                            {% if appeal.status == 'pending' %}
                                <span class="badge badge-warning badge-lg badge-soft gap-1">
                                    <span class="icon-[tabler--clock] size-4"></span>
                                    Pending Review
                                </span>
                            {% elseif appeal.status == 'approved' %}
                                <span class="badge badge-success badge-lg badge-soft gap-1">
                                    <span class="icon-[tabler--circle-check] size-4"></span>
                                    Approved
                                </span>
                            {% else %}
                                <span class="badge badge-error badge-lg badge-soft gap-1">
                                    <span class="icon-[tabler--circle-x] size-4"></span>
                                    Rejected
                                </span>
                            {% endif %}
                            <span class="text-sm text-base-content/60 inline-flex items-center gap-1.5">
                                <span class="icon-[tabler--calendar] size-4"></span>
                                Submitted {{ appeal.submittedAt|date('M j, Y g:i A') }}
                            </span>
                        </div>
                    </div>
                </div>

                {# Original suspension reason #}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                        <div class="flex items-center gap-2">
                            <span class="icon-[tabler--ban] size-5 text-error/70"></span>
                            <h2 class="card-title text-base sm:text-lg">Original Suspension Reason</h2>
                        </div>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-4">
                        <div class="alert alert-error">
                            <span class="icon-[tabler--alert-triangle] size-5 shrink-0"></span>
                            <p class="text-sm whitespace-pre-wrap">{{ originalSuspensionReason ?? 'No reason provided' }}</p>
                        </div>
                        {% if appeal.user.suspensionAttachments and appeal.user.suspensionAttachments|length > 0 %}
                            <div>
                                <p class="text-sm font-medium text-base-content mb-2">Suspension Attachments</p>
                                <div class="space-y-2">
                                    {% for attachment in appeal.user.suspensionAttachments %}
                                        <a href="{{ attachment }}" target="_blank" rel="noopener"
                                           class="flex items-center gap-2 p-3 bg-base-200 rounded-lg border border-base-300 hover:bg-base-300/50 transition-colors text-sm text-primary">
                                            <span class="icon-[tabler--file] size-4 shrink-0"></span>
                                            <span class="truncate">{{ attachment|split('/')|last }}</span>
                                            <span class="icon-[tabler--external-link] size-3.5 ml-auto shrink-0"></span>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Appeal letter #}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                        <div class="flex items-center gap-2">
                            <span class="icon-[tabler--mail] size-5 text-base-content/70"></span>
                            <h2 class="card-title text-base sm:text-lg">Appeal Letter</h2>
                        </div>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                        <div class="bg-base-200 rounded-lg p-4 border border-base-300">
                            <p class="text-sm text-base-content whitespace-pre-wrap leading-relaxed">{{ appeal.appealLetter }}</p>
                        </div>
                    </div>
                </div>

                {# Appeal attachments #}
                {% if appeal.appealAttachments and appeal.appealAttachments|length > 0 %}
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                            <div class="flex items-center gap-2">
                                <span class="icon-[tabler--files] size-5 text-base-content/70"></span>
                                <h2 class="card-title text-base sm:text-lg">Supporting Documents</h2>
                            </div>
                        </div>
                        <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-2">
                            {% for attachment in appeal.appealAttachments %}
                                <a href="{{ attachment }}" target="_blank" rel="noopener" download
                                   class="flex items-center justify-between gap-3 p-3 bg-base-200 rounded-lg border border-base-300 hover:bg-base-300/50 transition-colors">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="icon-[tabler--file-text] size-5 text-base-content/50 shrink-0"></span>
                                        <span class="text-sm text-base-content truncate">{{ attachment|split('/')|last }}</span>
                                    </div>
                                    <span class="icon-[tabler--download] size-4 text-base-content/50 shrink-0"></span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {# Review decision (if already reviewed) #}
                {% if appeal.status != 'pending' %}
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                            <div class="flex items-center gap-2">
                                <span class="icon-[tabler--gavel] size-5 text-base-content/70"></span>
                                <h2 class="card-title text-base sm:text-lg">Review Decision</h2>
                            </div>
                        </div>
                        <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4 space-y-4">
                            {% if appeal.status == 'approved' %}
                                <div class="alert alert-success">
                                    <span class="icon-[tabler--circle-check] size-5"></span>
                                    <span class="text-sm">This appeal was approved and the broker account was reactivated.</span>
                                </div>
                            {% else %}
                                <div class="alert alert-error">
                                    <span class="icon-[tabler--circle-x] size-5"></span>
                                    <span class="text-sm">This appeal was rejected. The broker remains suspended.</span>
                                </div>
                            {% endif %}

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="form-control">
                                    <label class="label py-1"><span class="label-text font-medium text-base-content/70">Reviewed By</span></label>
                                    <p class="text-sm text-base-content">{{ appeal.reviewedBy.email }}</p>
                                </div>
                                <div class="form-control">
                                    <label class="label py-1"><span class="label-text font-medium text-base-content/70">Reviewed At</span></label>
                                    <p class="text-sm text-base-content">{{ appeal.reviewedAt|date('M j, Y g:i A') }}</p>
                                </div>
                            </div>

                            <div class="form-control">
                                <label class="label py-1"><span class="label-text font-medium text-base-content/70">Review Notes</span></label>
                                <div class="bg-base-200 rounded-lg p-4 border border-base-300">
                                    <p class="text-sm text-base-content whitespace-pre-wrap">{{ appeal.reviewNotes }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Sidebar #}
            <div class="space-y-5 sm:space-y-6">
                {# Broker info #}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                        <div class="flex items-center gap-2">
                            <span class="icon-[tabler--user] size-5 text-base-content/70"></span>
                            <h2 class="card-title text-base sm:text-lg">Broker Information</h2>
                        </div>
                    </div>
                    <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                        <div class="flex items-center gap-3 mb-4 pb-4 border-b border-base-300">
                            <div class="size-12 rounded-full {{ avatar_colors(appeal.user) }} flex items-center justify-center shrink-0">
                                <span class="text-sm font-semibold">{{ appeal.user.email|slice(0, 2)|upper }}</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-base-content truncate">{{ appeal.user.email }}</p>
                                <p class="text-xs text-base-content/50">User ID: {{ appeal.user.id }}</p>
                            </div>
                        </div>
                        <div class="space-y-3">
                            <div class="form-control">
                                <label class="label py-0"><span class="label-text text-xs font-medium text-base-content/60 uppercase">Current Status</span></label>
                                {% set acctBadge = appeal.user.status.value == 'APPROVED' ? 'badge-success' : (appeal.user.status.value == 'PENDING' ? 'badge-warning' : 'badge-error') %}
                                <span class="badge {{ acctBadge }} badge-soft w-fit mt-1">{{ appeal.user.status.value|title }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Review actions (if pending) #}
                {% if appeal.status == 'pending' %}
                    <div class="card bg-base-100 shadow-sm border border-warning/30">
                        <div class="card-header px-4 sm:px-6 pt-4 sm:pt-5 pb-0">
                            <div class="flex items-center gap-2">
                                <span class="icon-[tabler--gavel] size-5 text-warning"></span>
                                <h2 class="card-title text-base sm:text-lg">Review Appeal</h2>
                            </div>
                        </div>
                        <div class="card-body p-4 sm:p-6 pt-3 sm:pt-4">
                            <form id="appealReviewForm" class="space-y-4">
                                <div class="form-control">
                                    <label class="label py-1" for="review_notes">
                                        <span class="label-text font-medium">Review Notes <span class="text-error">*</span></span>
                                    </label>
                                    <textarea id="review_notes" name="review_notes" rows="4" required
                                              class="textarea textarea-bordered w-full"
                                              placeholder="Explain your decision..."></textarea>
                                </div>

                                <div class="space-y-2">
                                    <button type="button" id="appealApproveBtn"
                                            class="btn btn-success w-full gap-2">
                                        <span class="icon-[tabler--circle-check] size-4"></span>
                                        Approve & Reactivate
                                    </button>
                                    <button type="button" id="appealRejectBtn"
                                            class="btn btn-outline btn-error w-full gap-2">
                                        <span class="icon-[tabler--circle-x] size-4"></span>
                                        Reject Appeal
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
{% endblock %}

{% block page_modals %}
<div id="appealToastContainer" class="fixed top-20 right-4 z-[10003] space-y-2 pointer-events-none max-w-sm w-full sm:w-auto"></div>

<div id="appealConfirmModal"
     class="hidden fixed inset-0 z-[999999] items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="appealConfirmTitle">
    <div class="absolute inset-0 bg-black/60" data-appeal-modal-dismiss></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-lg z-10" onclick="event.stopPropagation()">
        <div class="flex items-start gap-4 px-5 py-5 border-b border-base-300">
            <div id="appealModalIconWrap" class="size-12 rounded-xl bg-success/10 flex items-center justify-center shrink-0">
                <span id="appealModalIcon" class="icon-[tabler--circle-check] size-6 text-success"></span>
            </div>
            <div class="flex-1 min-w-0">
                <h3 id="appealConfirmTitle" class="text-lg font-bold text-base-content"></h3>
                <p id="appealConfirmMessage" class="text-sm text-base-content/70 mt-2"></p>
            </div>
            <button type="button" data-appeal-modal-dismiss class="btn btn-ghost btn-sm btn-circle shrink-0">
                <span class="icon-[tabler--x] size-4"></span>
            </button>
        </div>
        <div class="px-5 py-4">
            <div class="bg-base-200 rounded-lg p-4 border border-base-300">
                <p class="text-xs font-medium text-base-content/70 mb-1">Your Review Notes</p>
                <p id="appealModalReviewNotes" class="text-sm text-base-content whitespace-pre-wrap"></p>
            </div>
        </div>
        <div class="flex justify-end gap-2 px-5 py-4 border-t border-base-300">
            <button type="button" data-appeal-modal-dismiss class="btn btn-ghost btn-sm">Cancel</button>
            <button type="button" id="appealConfirmBtn" class="btn btn-sm">Confirm</button>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function () {
    let currentAction = '';
    let currentReviewNotes = '';

    const modal = document.getElementById('appealConfirmModal');
    const modalTitle = document.getElementById('appealConfirmTitle');
    const modalMessage = document.getElementById('appealConfirmMessage');
    const modalReviewNotes = document.getElementById('appealModalReviewNotes');
    const modalIconWrap = document.getElementById('appealModalIconWrap');
    const modalIcon = document.getElementById('appealModalIcon');
    const confirmBtn = document.getElementById('appealConfirmBtn');
    const approveBtn = document.getElementById('appealApproveBtn');
    const rejectBtn = document.getElementById('appealRejectBtn');

    function showToast(message, type) {
        type = type || 'info';
        const container = document.getElementById('appealToastContainer');
        const map = {
            success: ['alert-success', 'icon-[tabler--circle-check]'],
            error: ['alert-error', 'icon-[tabler--alert-circle]'],
            info: ['alert-info', 'icon-[tabler--info-circle]']
        };
        const pair = map[type] || map.info;
        const el = document.createElement('div');
        el.className = 'alert ' + pair[0] + ' shadow-lg pointer-events-auto text-sm';
        el.innerHTML = '<span class="' + pair[1] + ' size-5 shrink-0"></span><span>' + message + '</span>';
        container.appendChild(el);
        setTimeout(function () { el.remove(); }, 5000);
    }

    function openModal() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        currentAction = '';
        currentReviewNotes = '';
    }

    function setActionButtonsLoading(loading) {
        [approveBtn, rejectBtn].forEach(function (btn) {
            if (!btn) return;
            btn.disabled = loading;
            if (loading) {
                btn.dataset.originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="loading loading-spinner loading-sm"></span>';
            } else if (btn.dataset.originalHtml) {
                btn.innerHTML = btn.dataset.originalHtml;
            }
        });
    }

    function reviewAppeal(action) {
        const reviewNotesEl = document.getElementById('review_notes');
        const reviewNotes = reviewNotesEl ? reviewNotesEl.value : '';

        if (!reviewNotes.trim()) {
            showToast('Please provide review notes', 'error');
            return;
        }

        currentAction = action;
        currentReviewNotes = reviewNotes;

        const isApprove = action === 'approve';
        modalTitle.textContent = isApprove ? 'Approve Appeal' : 'Reject Appeal';
        modalMessage.textContent = isApprove
            ? 'Are you sure you want to approve this appeal and reactivate the broker account? This will restore full access.'
            : 'Are you sure you want to reject this appeal? The broker will remain suspended and be notified.';
        modalReviewNotes.textContent = reviewNotes;

        modalIconWrap.className = 'size-12 rounded-xl flex items-center justify-center shrink-0 ' + (isApprove ? 'bg-success/10' : 'bg-error/10');
        modalIcon.className = (isApprove ? 'icon-[tabler--circle-check] text-success' : 'icon-[tabler--alert-triangle] text-error') + ' size-6';

        confirmBtn.className = 'btn btn-sm ' + (isApprove ? 'btn-success' : 'btn-error');
        confirmBtn.textContent = isApprove ? 'Approve & Reactivate' : 'Reject Appeal';

        openModal();
    }

    function confirmReview() {
        const action = currentAction;
        const reviewNotes = currentReviewNotes;
        closeModal();
        setActionButtonsLoading(true);

        const formData = new FormData();
        formData.append('action', action);
        formData.append('review_notes', reviewNotes);

        fetch('{{ path('admin_appeals_review', {id: appeal.id}) }}', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                showToast(data.message, 'success');
                setTimeout(function () { window.location.reload(); }, 1500);
            } else {
                showToast('Error: ' + data.message, 'error');
                setActionButtonsLoading(false);
            }
        })
        .catch(function (error) {
            console.error('Error:', error);
            showToast('An error occurred. Please try again.', 'error');
            setActionButtonsLoading(false);
        });
    }

    document.querySelectorAll('[data-appeal-modal-dismiss]').forEach(function (el) {
        el.addEventListener('click', closeModal);
    });

    if (confirmBtn) confirmBtn.addEventListener('click', confirmReview);

    if (approveBtn) approveBtn.addEventListener('click', function () { reviewAppeal('approve'); });
    if (rejectBtn) rejectBtn.addEventListener('click', function () { reviewAppeal('reject'); });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });
})();
</script>
{% endblock %}
