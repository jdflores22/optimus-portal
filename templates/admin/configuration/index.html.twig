{% extends 'base.html.twig' %}
{% block title %}System Configuration{% endblock %}
{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Top Navigation Bar -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="{{ path('admin_system_settings') }}" class="text-gray-600 hover:text-gray-900 mr-4">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span class="text-2xl font-bold text-meta-blue">System Configuration</span>
                    <span class="ml-4 text-gray-600">Manage eDO workflow settings</span>
                </div>
                <div class="flex items-center space-x-4">
                    <form method="POST" action="{{ path('admin_configuration_cache_clear') }}">
                        <button type="submit" class="px-3 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                            <i class="fas fa-sync-alt mr-1"></i>Clear Cache
                        </button>
                    </form>
                    <span class="text-sm text-gray-600">System Admin</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fas fa-check-circle text-green-600 mr-3"></i>
                <span class="text-green-800">{{ message }}</span>
            </div>
        </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex items-center">
                <i class="fas fa-exclamation-circle text-red-600 mr-3"></i>
                <span class="text-red-800">{{ message }}</span>
            </div>
        </div>
        {% endfor %}

        <div class="space-y-6">
            <!-- eDO Configuration Section -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900">eDO Configuration</h2>
                        <p class="text-gray-600 mt-1">Configure eDO validity period and billing rates</p>
                    </div>
                    <i class="fas fa-file-invoice text-4xl text-blue-500"></i>
                </div>

                <form method="POST" action="{{ path('admin_configuration_edo_update') }}" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-gray-50 rounded-lg p-4 {{ permissions.can_edit_validity_period ? '' : 'opacity-60' }}">
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-calendar-alt mr-2"></i>eDO Validity Period (days)
                                {% if not permissions.can_edit_validity_period %}
                                    <span class="text-xs text-red-600 ml-2">(SL_STAFF only)</span>
                                {% endif %}
                            </label>
                            {% set validityConfig = configurations.edo|filter(c => c.configKey == 'edo.validity_period_days')|first %}
                            <input type="number" name="validity_days" 
                                   value="{{ validityConfig ? validityConfig.typedValue : 30 }}" 
                                   min="1" max="365" 
                                   {{ permissions.can_edit_validity_period ? 'required' : 'readonly disabled' }}
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 {{ permissions.can_edit_validity_period ? '' : 'bg-gray-200 cursor-not-allowed' }}">
                            <p class="mt-2 text-sm text-gray-500">
                                Number of days an eDO remains valid after generation
                                {% if not permissions.can_edit_validity_period %}
                                    <br><span class="text-red-600 font-medium">Only SL_STAFF can modify this setting</span>
                                {% endif %}
                            </p>
                        </div>

                        <div class="bg-gray-50 rounded-lg p-4 {{ permissions.can_edit_per_day_rate ? '' : 'opacity-60' }}">
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-dollar-sign mr-2"></i>Per-Day Rate for Expired eDOs
                                {% if not permissions.can_edit_per_day_rate %}
                                    <span class="text-xs text-red-600 ml-2">(ACCOUNTING only)</span>
                                {% endif %}
                            </label>
                            {% set rateConfig = configurations.edo|filter(c => c.configKey == 'edo.expired_per_day_rate')|first %}
                            <input type="number" name="per_day_rate" step="0.01" 
                                   value="{{ rateConfig ? rateConfig.typedValue : 50.00 }}" 
                                   min="0" 
                                   {{ permissions.can_edit_per_day_rate ? 'required' : 'readonly disabled' }}
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 {{ permissions.can_edit_per_day_rate ? '' : 'bg-gray-200 cursor-not-allowed' }}">
                            <p class="mt-2 text-sm text-gray-500">
                                Daily charge applied for expired eDO days
                                {% if not permissions.can_edit_per_day_rate %}
                                    <br><span class="text-red-600 font-medium">Only ACCOUNTING can modify this setting</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    {% if permissions.can_edit_validity_period or permissions.can_edit_per_day_rate %}
                    <div class="bg-gray-50 rounded-lg p-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-comment mr-2"></i>Reason for Change (Optional)
                        </label>
                        <textarea name="reason" rows="2" 
                                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                  placeholder="Describe why this configuration is being changed..."></textarea>
                    </div>

                    <button type="submit" class="w-full px-4 py-3 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-200">
                        <i class="fas fa-save mr-2"></i>Update eDO Configuration
                    </button>
                    {% else %}
                    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                        <div class="flex items-center">
                            <i class="fas fa-info-circle text-yellow-600 mr-3"></i>
                            <span class="text-yellow-800">You do not have permission to modify eDO configuration settings.</span>
                        </div>
                    </div>
                    {% endif %}
                </form>
            </div>

            <!-- CY Locations Configuration Section -->
            {% if permissions.can_edit_cy_locations %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900">Container Yard Locations</h2>
                        <p class="text-gray-600 mt-1">Manage CY locations and their TEU capacities</p>
                    </div>
                    <i class="fas fa-warehouse text-4xl text-green-500"></i>
                </div>

                <!-- Existing CY Locations -->
                <form method="POST" action="{{ path('admin_configuration_cy_update') }}" class="space-y-4 mb-6">
                    <div class="space-y-3">
                        {% for location, capacity in cyLocations %}
                        <div class="flex items-center space-x-4 bg-gray-50 rounded-lg p-4">
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-gray-700 mb-1">{{ location }}</label>
                                <div class="flex items-center space-x-2">
                                    <input type="number" name="cy_locations[{{ location }}]" 
                                           value="{{ capacity }}" step="0.1" min="0" required
                                           class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    <span class="text-sm text-gray-600">TEU</span>
                                </div>
                            </div>
                            <form method="POST" action="{{ path('admin_configuration_cy_remove', {location: location}) }}" class="inline">
                                <button type="submit" onclick="return confirm('Remove {{ location }}?')" 
                                        class="px-3 py-2 text-sm text-red-600 hover:text-red-800">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                        {% endfor %}
                    </div>

                    <div class="bg-gray-50 rounded-lg p-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-comment mr-2"></i>Reason for Change (Optional)
                        </label>
                        <textarea name="reason" rows="2" 
                                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                  placeholder="Describe why capacities are being changed..."></textarea>
                    </div>

                    <button type="submit" class="w-full px-4 py-3 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-200">
                        <i class="fas fa-save mr-2"></i>Update CY Capacities
                    </button>
                </form>

                <!-- Add New CY Location -->
                <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Add New CY Location</h3>
                    <form method="POST" action="{{ path('admin_configuration_cy_add') }}" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Location Name</label>
                                <input type="text" name="new_location" required 
                                       placeholder="e.g., CY-WEST"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">TEU Capacity</label>
                                <input type="number" name="new_capacity" step="0.1" min="0" required 
                                       placeholder="e.g., 1500"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                        </div>
                        <button type="submit" class="w-full px-4 py-3 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-200">
                            <i class="fas fa-plus mr-2"></i>Add CY Location
                        </button>
                    </form>
                </div>
            </div>
            {% endif %}

            <!-- Configuration History Links -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Configuration History</h2>
                <div class="space-y-2">
                    {% for config in configurations.edo %}
                    <a href="{{ path('admin_configuration_history', {key: config.configKey}) }}" 
                       class="block px-4 py-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-gray-900">{{ config.configKey }}</span>
                            <i class="fas fa-history text-gray-400"></i>
                        </div>
                        <span class="text-sm text-gray-600">{{ config.description }}</span>
                    </a>
                    {% endfor %}
                    <a href="{{ path('admin_configuration_history', {key: 'cy.locations'}) }}" 
                       class="block px-4 py-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-gray-900">cy.locations</span>
                            <i class="fas fa-history text-gray-400"></i>
                        </div>
                        <span class="text-sm text-gray-600">Container Yard locations with TEU capacities</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
