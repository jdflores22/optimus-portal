{% extends 'layout/admin_base.html.twig' %}

{% block title %}Configuration History - {{ configKey }}{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('admin_configuration_index') }}">eDO Configuration</a></li>
        <li>History</li>
        <li class="font-mono text-xs">{{ configKey }}</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="card-title text-xl sm:text-2xl">
                        <span class="icon-[tabler--history] size-6"></span>
                        Configuration History
                    </h1>
                    <p class="text-sm text-base-content/70 mt-1 font-mono">{{ configKey }}</p>
                </div>
                <a href="{{ path('admin_configuration_index') }}" class="btn btn-ghost btn-sm gap-2">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Back to Configuration
                </a>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
            {% if history is empty %}
                <div class="text-center py-16 px-6">
                    <span class="icon-[tabler--history-off] size-12 text-base-content/30 block mx-auto mb-3"></span>
                    <p class="text-base-content/60">No history available for this configuration</p>
                </div>
            {% else %}
                <div class="divide-y divide-base-200">
                    {% for entry in history %}
                    <div class="p-4 sm:p-6 hover:bg-base-200/40 transition-colors">
                        <div class="flex flex-wrap items-center gap-2 mb-3">
                            <span class="badge badge-info badge-sm gap-1">
                                <span class="icon-[tabler--edit] size-3"></span>
                                Changed
                            </span>
                            <span class="text-sm text-base-content/60">{{ entry.changedAt|date('Y-m-d H:i:s') }}</span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                            <div class="bg-error/10 rounded-lg p-3 border border-error/20">
                                <div class="text-xs font-medium text-error mb-1">Old Value</div>
                                <div class="text-sm font-mono break-all">{{ entry.oldValue }}</div>
                            </div>
                            <div class="bg-success/10 rounded-lg p-3 border border-success/20">
                                <div class="text-xs font-medium text-success mb-1">New Value</div>
                                <div class="text-sm font-mono break-all">{{ entry.newValue }}</div>
                            </div>
                        </div>

                        {% if entry.changeReason %}
                        <div class="bg-base-200 rounded-lg p-3 mb-3">
                            <div class="text-xs font-medium text-base-content/60 mb-1">Reason</div>
                            <div class="text-sm">{{ entry.changeReason }}</div>
                        </div>
                        {% endif %}

                        <div class="flex items-center gap-2 text-sm text-base-content/70">
                            <span class="icon-[tabler--user] size-4"></span>
                            Changed by <span class="font-medium text-base-content">{{ entry.changedBy.fullName }}</span>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
