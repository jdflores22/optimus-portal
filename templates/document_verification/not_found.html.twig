{% extends 'layout/public_minimal.html.twig' %}

{% block title %}Document Not Found - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg mx-auto text-center">
        {% include 'components/_brand_mark.html.twig' with { size: 'md' } %}

        <div class="card bg-base-100 shadow-lg mt-8">
            <div class="card-body p-8">
                <div class="rounded-full bg-error/15 p-4 w-fit mx-auto mb-4">
                    <span class="icon-[tabler--alert-circle] size-10 text-error"></span>
                </div>
                <h1 class="text-2xl font-bold text-base-content">Document Not Found</h1>
                <p class="text-base-content/60 mt-3">
                    We could not verify this document. The QR code may be invalid, expired, or the document may not have been registered in OPTIMUS.
                </p>
                <p class="text-xs text-base-content/40 mt-6 break-all">Reference: {{ token }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
