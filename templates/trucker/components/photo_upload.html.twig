<!-- Enhanced Photo Upload Component -->
<div class="photo-upload-container">
    <!-- Photo Requirements -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
        <div class="flex">
            <svg class="w-5 h-5 text-blue-400 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
            <div>
                <h4 class="text-sm font-medium text-blue-800 mb-2">Photo Requirements</h4>
                <ul class="text-sm text-blue-700 space-y-1">
                    <li class="flex items-start">
                        <span class="font-semibold mr-1">GPS Coordinates Required:</span>
                        <span>Photos must contain location data (geotag)</span>
                    </li>
                    <li class="flex items-start">
                        <span class="font-semibold mr-1">Container Side View:</span>
                        <span>Take clear photos showing the container side</span>
                    </li>
                    <li class="flex items-start">
                        <span class="font-semibold mr-1">File Size:</span>
                        <span>Maximum 10MB per photo</span>
                    </li>
                    <li class="flex items-start">
                        <span class="font-semibold mr-1">Format:</span>
                        <span>JPEG or PNG only</span>
                    </li>
                    <li class="flex items-start">
                        <span class="font-semibold mr-1">Resolution:</span>
                        <span>Minimum 800x600 pixels</span>
                    </li>
                    <li class="flex items-start">
                        <span class="font-semibold mr-1">Multiple Photos:</span>
                        <span>You can upload multiple photos for better verification</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- File Upload Area -->
    <div class="mb-6">
        <label for="photos" class="block text-sm font-medium text-gray-700 mb-3">
            <svg class="w-5 h-5 inline mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Upload Container Photos
        </label>
        
        <!-- Custom File Upload Area -->
        <div class="relative">
            <input type="file" 
                   class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" 
                   id="photos" 
                   name="photos[]" 
                   multiple 
                   accept="image/jpeg,image/jpg,image/png"
                   required>
            
            <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-purple-400 hover:bg-purple-50 transition-colors duration-200" id="uploadArea">
                <svg class="w-12 h-12 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                </svg>
                <div class="text-gray-600">
                    <p class="text-lg font-medium mb-2">Drop your photos here or click to browse</p>
                    <p class="text-sm text-gray-500">Select one or more photos. At least one photo with GPS coordinates is required.</p>
                </div>
                <div class="mt-4">
                    <span class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                        </svg>
                        Choose Files
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Photo Validation Status -->
    <div id="photoValidationStatus" class="mb-6 hidden">
        <div class="bg-white rounded-lg border border-gray-200 shadow-sm">
            <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
                <h4 class="text-lg font-semibold text-gray-900 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    Photo Validation Status
                </h4>
            </div>
            <div class="p-6">
                <div id="validationResults">
                    <!-- Validation results will be populated here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Photo Preview Grid -->
    <div id="photoPreview" class="mb-6 hidden">
        <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
            <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Photo Preview
        </h4>
        <div id="photoGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Photo cards will be added here -->
        </div>
    </div>

    <!-- GPS Location Map (if supported) -->
    <div id="gpsMapContainer" class="mb-6 hidden">
        <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
            <svg class="w-5 h-5 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Photo Locations
        </h4>
        <div class="bg-white rounded-lg border border-gray-200 shadow-sm">
            <div class="p-6">
                <div id="gpsMap" class="min-h-[300px] bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-center">
                    <p class="text-gray-500">GPS coordinates will be displayed here</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const photoInput = document.getElementById('photos');
    const photoPreview = document.getElementById('photoPreview');
    const photoGrid = document.getElementById('photoGrid');
    const validationStatus = document.getElementById('photoValidationStatus');
    const validationResults = document.getElementById('validationResults');
    const gpsMapContainer = document.getElementById('gpsMapContainer');
    const uploadArea = document.getElementById('uploadArea');
    
    let uploadedPhotos = [];
    let validPhotos = 0;

    // Drag and drop functionality
    uploadArea.addEventListener('dragover', function(e) {
        e.preventDefault();
        uploadArea.classList.add('border-purple-400', 'bg-purple-50');
    });

    uploadArea.addEventListener('dragleave', function(e) {
        e.preventDefault();
        uploadArea.classList.remove('border-purple-400', 'bg-purple-50');
    });

    uploadArea.addEventListener('drop', function(e) {
        e.preventDefault();
        uploadArea.classList.remove('border-purple-400', 'bg-purple-50');
        
        const files = Array.from(e.dataTransfer.files);
        if (files.length > 0) {
            // Update the file input
            const dt = new DataTransfer();
            files.forEach(file => dt.items.add(file));
            photoInput.files = dt.files;
            
            processPhotos(files);
        }
    });

    photoInput.addEventListener('change', function() {
        const files = Array.from(this.files);
        
        if (files.length > 0) {
            uploadedPhotos = [];
            validPhotos = 0;
            processPhotos(files);
        } else {
            hidePhotoPreview();
        }
    });

    function processPhotos(files) {
        photoGrid.innerHTML = '';
        validationResults.innerHTML = '';
        
        let processedCount = 0;
        const totalFiles = files.length;

        files.forEach((file, index) => {
            validatePhoto(file, index, (result) => {
                processedCount++;
                uploadedPhotos.push(result);
                
                createPhotoCard(result, index);
                updateValidationStatus();
                
                if (processedCount === totalFiles) {
                    showPhotoPreview();
                    updateGPSMap();
                }
            });
        });
    }

    function validatePhoto(file, index, callback) {
        const result = {
            file: file,
            index: index,
            name: file.name,
            size: file.size,
            valid: true,
            errors: [],
            warnings: [],
            gpsData: null,
            preview: null
        };

        // Validate file size
        if (file.size > 10 * 1024 * 1024) { // 10MB
            result.valid = false;
            result.errors.push('File size exceeds 10MB limit');
        }

        // Validate file type
        if (!['image/jpeg', 'image/jpg', 'image/png'].includes(file.type)) {
            result.valid = false;
            result.errors.push('Invalid file type. Only JPEG and PNG are allowed');
        }

        // Create image preview
        const reader = new FileReader();
        reader.onload = function(e) {
            result.preview = e.target.result;
            
            // Create image element to check dimensions
            const img = new Image();
            img.onload = function() {
                // Check minimum dimensions
                if (img.width < 800 || img.height < 600) {
                    result.valid = false;
                    result.errors.push(`Image resolution too low (${img.width}x${img.height}). Minimum required: 800x600`);
                }

                // Try to extract GPS data (simplified - in real implementation would use EXIF library)
                extractGPSData(file, (gpsData) => {
                    if (gpsData) {
                        result.gpsData = gpsData;
                        if (result.valid) {
                            validPhotos++;
                        }
                    } else {
                        result.valid = false;
                        result.errors.push('No GPS coordinates found in photo. Please enable location services when taking photos.');
                    }
                    
                    callback(result);
                });
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function extractGPSData(file, callback) {
        // Simplified GPS extraction - in real implementation would use EXIF.js or similar
        // For demo purposes, we'll simulate GPS data extraction
        setTimeout(() => {
            // Simulate GPS data (in real implementation, this would extract from EXIF)
            const hasGPS = Math.random() > 0.3; // 70% chance of having GPS data for demo
            
            if (hasGPS) {
                callback({
                    latitude: (Math.random() * 180 - 90).toFixed(6),
                    longitude: (Math.random() * 360 - 180).toFixed(6),
                    timestamp: new Date().toISOString()
                });
            } else {
                callback(null);
            }
        }, 100);
    }

    function createPhotoCard(result, index) {
        const div = document.createElement('div');
        
        const borderClass = result.valid ? 'border-green-200 bg-green-50' : 'border-red-200 bg-red-50';
        const statusBadge = result.valid ? 
            '<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800"><svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Valid</span>' :
            '<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800"><svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>Invalid</span>';

        div.innerHTML = `
            <div class="bg-white rounded-lg border-2 ${borderClass} shadow-sm overflow-hidden">
                <div class="aspect-w-16 aspect-h-9">
                    <img src="${result.preview}" class="w-full h-48 object-cover">
                </div>
                <div class="p-4">
                    <h5 class="font-medium text-gray-900 truncate mb-2">${result.name}</h5>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm text-gray-500">
                            ${(result.size / 1024 / 1024).toFixed(2)} MB
                        </span>
                        ${statusBadge}
                    </div>
                    
                    ${result.gpsData ? `
                        <div class="bg-green-50 border border-green-200 rounded-md p-3 mb-3">
                            <div class="flex items-start">
                                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <div>
                                    <p class="text-sm font-medium text-green-800">GPS Location Found</p>
                                    <p class="text-xs text-green-600">
                                        ${result.gpsData.latitude}, ${result.gpsData.longitude}
                                    </p>
                                </div>
                            </div>
                        </div>
                    ` : ''}
                    
                    ${result.errors.length > 0 ? `
                        <div class="space-y-1">
                            ${result.errors.map(error => `
                                <div class="flex items-start text-sm text-red-600">
                                    <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                    </svg>
                                    <span>${error}</span>
                                </div>
                            `).join('')}
                        </div>
                    ` : ''}
                    
                    ${result.warnings.length > 0 ? `
                        <div class="mt-2 space-y-1">
                            ${result.warnings.map(warning => `
                                <div class="flex items-start text-sm text-yellow-600">
                                    <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                    </svg>
                                    <span>${warning}</span>
                                </div>
                            `).join('')}
                        </div>
                    ` : ''}
                </div>
            </div>
        `;

        photoGrid.appendChild(div);
    }

    function updateValidationStatus() {
        const totalPhotos = uploadedPhotos.length;
        const invalidPhotos = totalPhotos - validPhotos;

        let statusHtml = `
            <div class="grid grid-cols-3 gap-6 mb-6">
                <div class="text-center">
                    <div class="text-3xl font-bold text-gray-900 mb-1">${totalPhotos}</div>
                    <div class="text-sm text-gray-500">Total Photos</div>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-green-600 mb-1">${validPhotos}</div>
                    <div class="text-sm text-gray-500">Valid Photos</div>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-red-600 mb-1">${invalidPhotos}</div>
                    <div class="text-sm text-gray-500">Invalid Photos</div>
                </div>
            </div>
        `;

        if (validPhotos === 0 && totalPhotos > 0) {
            statusHtml += `
                <div class="bg-red-50 border border-red-200 rounded-md p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                            <h4 class="text-sm font-medium text-red-800">No valid photos found</h4>
                            <p class="text-sm text-red-700 mt-1">Please ensure your photos contain GPS coordinates and meet the requirements.</p>
                        </div>
                    </div>
                </div>
            `;
        } else if (validPhotos > 0 && invalidPhotos > 0) {
            statusHtml += `
                <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-yellow-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                            <h4 class="text-sm font-medium text-yellow-800">Some photos are invalid</h4>
                            <p class="text-sm text-yellow-700 mt-1">You can proceed with ${validPhotos} valid photo(s), but consider fixing the invalid ones for better verification.</p>
                        </div>
                    </div>
                </div>
            `;
        } else if (validPhotos > 0) {
            statusHtml += `
                <div class="bg-green-50 border border-green-200 rounded-md p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                            <h4 class="text-sm font-medium text-green-800">All photos are valid!</h4>
                            <p class="text-sm text-green-700 mt-1">You can proceed with your FREE-ADVICE submission.</p>
                        </div>
                    </div>
                </div>
            `;
        }

        validationResults.innerHTML = statusHtml;
    }

    function updateGPSMap() {
        const photosWithGPS = uploadedPhotos.filter(photo => photo.gpsData);
        
        if (photosWithGPS.length > 0) {
            let mapHtml = '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';
            
            photosWithGPS.forEach((photo, index) => {
                mapHtml += `
                    <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                        <svg class="w-5 h-5 text-red-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <div>
                            <div class="font-medium text-gray-900">${photo.name}</div>
                            <div class="text-sm text-gray-500">
                                Lat: ${photo.gpsData.latitude}, Lng: ${photo.gpsData.longitude}
                            </div>
                        </div>
                    </div>
                `;
            });
            
            mapHtml += '</div>';
            
            document.getElementById('gpsMap').innerHTML = mapHtml;
            gpsMapContainer.classList.remove('hidden');
        } else {
            gpsMapContainer.classList.add('hidden');
        }
    }

    function showPhotoPreview() {
        photoPreview.classList.remove('hidden');
        validationStatus.classList.remove('hidden');
    }

    function hidePhotoPreview() {
        photoPreview.classList.add('hidden');
        validationStatus.classList.add('hidden');
        gpsMapContainer.classList.add('hidden');
        uploadedPhotos = [];
        validPhotos = 0;
    }

    // Expose validation function for form submission
    window.validatePhotosForSubmission = function() {
        if (uploadedPhotos.length === 0) {
            alert('Please upload at least one photo.');
            return false;
        }
        
        if (validPhotos === 0) {
            alert('No valid photos found. Please ensure your photos contain GPS coordinates and meet the requirements.');
            return false;
        }
        
        return true;
    };
});
</script>

