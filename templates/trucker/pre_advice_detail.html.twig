{% extends 'base.html.twig' %}

{% block title %}FREE-ADVICE Request #{{ pre_advice.id }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header Section -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">FREE-ADVICE Request #{{ pre_advice.id }}</h1>
                    <p class="mt-1 text-sm text-gray-600">View details and status of your container return request</p>
                </div>
                <div class="flex space-x-3">
                    <a href="{{ path('trucker_pre_advice_list') }}" 
                       class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Back to List
                    </a>
                    {% if pre_advice.edoNumber %}
                        <a href="{{ path('trucker_edo_download', {id: pre_advice.id}) }}" 
                           class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-4-4m4 4l4-4m-6 8h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            Download EDO
                        </a>
                    {% endif %}
                    {% if pre_advice.qrCode %}
                        <a href="{{ path('trucker_qr_download', {id: pre_advice.id}) }}" 
                           class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                            </svg>
                            Download QR Code
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Status Banner -->
        <div class="mb-8">
            {% set status_class = 'gray' %}
            {% set status_bg = 'bg-gray-50' %}
            {% set status_border = 'border-gray-200' %}
            {% set status_text = 'text-gray-800' %}
            {% if pre_advice.status.value == 'pending' %}
                {% set status_class = 'yellow' %}
                {% set status_bg = 'bg-yellow-50' %}
                {% set status_border = 'border-yellow-200' %}
                {% set status_text = 'text-yellow-800' %}
            {% elseif pre_advice.status.value == 'verified' %}
                {% set status_class = 'blue' %}
                {% set status_bg = 'bg-blue-50' %}
                {% set status_border = 'border-blue-200' %}
                {% set status_text = 'text-blue-800' %}
            {% elseif pre_advice.status.value == 'completed' %}
                {% set status_class = 'green' %}
                {% set status_bg = 'bg-green-50' %}
                {% set status_border = 'border-green-200' %}
                {% set status_text = 'text-green-800' %}
            {% elseif pre_advice.status.value == 'rejected' %}
                {% set status_class = 'red' %}
                {% set status_bg = 'bg-red-50' %}
                {% set status_border = 'border-red-200' %}
                {% set status_text = 'text-red-800' %}
            {% endif %}

            <div class="rounded-lg border {{ status_border }} {{ status_bg }} p-6">
                <div class="flex items-center">
                    {% if pre_advice.status.value == 'pending' %}
                        <svg class="w-8 h-8 text-yellow-500 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    {% elseif pre_advice.status.value == 'verified' %}
                        <svg class="w-8 h-8 text-blue-500 mr-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                    {% elseif pre_advice.status.value == 'completed' %}
                        <svg class="w-8 h-8 text-green-500 mr-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                    {% elseif pre_advice.status.value == 'rejected' %}
                        <svg class="w-8 h-8 text-red-500 mr-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    {% else %}
                        <svg class="w-8 h-8 text-gray-500 mr-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                        </svg>
                    {% endif %}
                    <div>
                        <h3 class="text-lg font-semibold {{ status_text }} mb-1">Status: {{ pre_advice.status.value|title }}</h3>
                        {% if pre_advice.status.value == 'pending' %}
                            <p class="text-sm {{ status_text }}">Your FREE-ADVICE request is being reviewed by the Terminal Team.</p>
                        {% elseif pre_advice.status.value == 'verified' %}
                            <p class="text-sm {{ status_text }}">Your request has been verified. EDO and QR code are being generated.</p>
                        {% elseif pre_advice.status.value == 'completed' %}
                            <p class="text-sm {{ status_text }}">Your request is complete! You can now download your EDO and QR code.</p>
                        {% elseif pre_advice.status.value == 'rejected' %}
                            <p class="text-sm {{ status_text }}">Your request was rejected. Please see the reason below and submit a new request if needed.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Request Information -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-indigo-50">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Request Information
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Request ID:</span>
                            <span class="text-gray-900">#{{ pre_advice.id }}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Submitted:</span>
                            <span class="text-gray-900">{{ pre_advice.createdAt|date('M d, Y H:i') }}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Payment Reference:</span>
                            <span class="text-gray-900">{{ pre_advice.paymentReference }}</span>
                        </div>
                        {% if pre_advice.verifiedAt %}
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Verified:</span>
                            <span class="text-gray-900">{{ pre_advice.verifiedAt|date('M d, Y H:i') }}</span>
                        </div>
                        {% endif %}
                        {% if pre_advice.edoNumber %}
                        <div class="flex justify-between py-2 bg-green-50 px-3 rounded-md">
                            <span class="font-medium text-green-800">EDO Number:</span>
                            <span class="font-bold text-green-900">{{ pre_advice.edoNumber }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Container Information -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-emerald-50">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                        Container Information
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Container Number:</span>
                            <span class="font-bold text-gray-900">{{ pre_advice.container.containerNumber }}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Size:</span>
                            <span class="text-gray-900">{{ pre_advice.container.size }}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Type:</span>
                            <span class="text-gray-900">{{ pre_advice.container.type }}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Current Location:</span>
                            <span class="text-gray-900">{{ pre_advice.container.currentLocation ?? 'Not specified' }}</span>
                        </div>
                        <div class="flex justify-between py-2">
                            <span class="font-medium text-gray-600">Expected Return Date:</span>
                            <span class="text-gray-900">{{ pre_advice.container.expectedReturnDate|date('M d, Y') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
            <!-- Terminal Information -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-purple-50 to-pink-50">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                        Terminal Information
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Terminal:</span>
                            <span class="font-bold text-gray-900">{{ pre_advice.selectedTerminal.name }}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Type:</span>
                            <span class="text-gray-900">{{ pre_advice.selectedTerminal.type.value }}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100">
                            <span class="font-medium text-gray-600">Location:</span>
                            <span class="text-gray-900">{{ pre_advice.selectedTerminal.location }}</span>
                        </div>
                        {% if pre_advice.assignedSlot %}
                        <div class="flex justify-between py-2 bg-purple-50 px-3 rounded-md">
                            <span class="font-medium text-purple-800">Assigned Slot:</span>
                            <span class="font-bold text-purple-900">{{ pre_advice.assignedSlot.date|date('M d, Y') }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Next Steps -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-indigo-50 to-blue-50">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                        </svg>
                        Next Steps
                    </h3>
                </div>
                <div class="p-6">
                    {% if pre_advice.status.value == 'pending' %}
                        <ol class="space-y-3">
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-yellow-100 text-yellow-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">1</span>
                                <span class="text-gray-700">Wait for Terminal Team review</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-yellow-100 text-yellow-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">2</span>
                                <span class="text-gray-700">You'll receive notification of the decision</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-yellow-100 text-yellow-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">3</span>
                                <span class="text-gray-700">If approved, EDO and QR code will be generated</span>
                            </li>
                        </ol>
                    {% elseif pre_advice.status.value == 'verified' %}
                        <ol class="space-y-3">
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">1</span>
                                <span class="text-gray-700">EDO and QR code are being generated</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">2</span>
                                <span class="text-gray-700">You'll receive notification when ready</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">3</span>
                                <span class="text-gray-700">Download documents when available</span>
                            </li>
                        </ol>
                    {% elseif pre_advice.status.value == 'completed' %}
                        <ol class="space-y-3">
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">1</span>
                                <span class="font-semibold text-gray-900">Download your EDO and QR code</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">2</span>
                                <span class="text-gray-700">Print the documents</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">3</span>
                                <span class="text-gray-700">Present QR code at terminal for container return</span>
                            </li>
                        </ol>
                    {% elseif pre_advice.status.value == 'rejected' %}
                        <ol class="space-y-3">
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-red-100 text-red-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">1</span>
                                <span class="text-gray-700">Review the rejection reason below</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-red-100 text-red-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">2</span>
                                <span class="text-gray-700">Address the issues mentioned</span>
                            </li>
                            <li class="flex items-start">
                                <span class="flex-shrink-0 w-6 h-6 bg-red-100 text-red-600 rounded-full flex items-center justify-center text-sm font-medium mr-3 mt-0.5">3</span>
                                <a href="{{ path('trucker_container_search') }}" class="text-blue-600 hover:text-blue-800 underline">Submit a new FREE-ADVICE request</a>
                            </li>
                        </ol>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Rejection Reason (if applicable) -->
        {% if pre_advice.status.value == 'rejected' and pre_advice.rejectionReason %}
        <div class="mt-8">
            <div class="bg-white rounded-xl shadow-sm border border-red-200">
                <div class="px-6 py-4 border-b border-red-200 bg-gradient-to-r from-red-50 to-pink-50">
                    <h3 class="text-lg font-semibold text-red-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                        Rejection Reason
                    </h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-900">{{ pre_advice.rejectionReason }}</p>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Uploaded Photos -->
        {% if pre_advice.geotagPhotos|length > 0 %}
        <div class="mt-8">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-purple-50 to-pink-50">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        Uploaded Photos ({{ pre_advice.geotagPhotos|length }})
                    </h3>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {% for photo in pre_advice.geotagPhotos %}
                        <div class="bg-gray-50 rounded-lg border border-gray-200 overflow-hidden">
                            <div class="p-4">
                                <h4 class="font-medium text-gray-900 truncate mb-3">{{ photo.originalName }}</h4>
                                <div class="space-y-2 text-sm">
                                    <div class="flex items-start">
                                        <svg class="w-4 h-4 text-red-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </svg>
                                        <div>
                                            <span class="font-medium text-gray-600">GPS:</span>
                                            <div class="text-gray-900">{{ photo.latitude|number_format(6) }}, {{ photo.longitude|number_format(6) }}</div>
                                        </div>
                                    </div>
                                    <div class="flex items-start">
                                        <svg class="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </svg>
                                        <div>
                                            <span class="font-medium text-gray-600">Captured:</span>
                                            <div class="text-gray-900">{{ photo.capturedAt|date('M d, Y H:i') }}</div>
                                        </div>
                                    </div>
                                    <div class="flex items-start">
                                        <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                                        </svg>
                                        <div>
                                            <span class="font-medium text-gray-600">Uploaded:</span>
                                            <div class="text-gray-900">{{ photo.uploadedAt|date('M d, Y H:i') }}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4 flex items-center justify-between">
                                    {% if photo.isVerified %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                            </svg>
                                            Verified
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            Pending Review
                                        </span>
                                    {% endif %}
                                </div>
                                {% if photo.verificationNotes %}
                                    <div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-md">
                                        <div class="flex">
                                            <svg class="w-4 h-4 text-blue-400 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                            </svg>
                                            <div>
                                                <p class="text-sm font-medium text-blue-800">Notes:</p>
                                                <p class="text-sm text-blue-700">{{ photo.verificationNotes }}</p>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}