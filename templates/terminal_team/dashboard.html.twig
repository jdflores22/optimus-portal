                                                    <td class="font-medium">{{ container.container_number }}</td>
                                                    <td>
                                                        <span class="badge badge-info">
                                                            {{ container.size_type }}
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="flex flex-col space-y-1">
                                                            <span class="badge badge-error">
                                                                {{ container.dwell_time }} days
