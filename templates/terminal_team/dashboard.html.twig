                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">Review Pending Requests</p>
                                    <p class="text-xs opacity-70">{{ metrics.overall.total_pending }} requests waiting</p>
