                            </div>
                            <svg class="w-5 h-5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </a>

                        <a href="{{ path('app_terminal_team_pre_advice_requests', {status: 'verified'}) }}" 
                           class="flex items-center justify-between p-4 bg-success/10 border border-success rounded-lg hover:bg-success/20 transition-colors">
                            <div class="flex items-center space-x-3">
                                <div class="avatar placeholder">
                                    <div class="w-8 bg-success text-success-content rounded-full">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">View Verified Requests</p>
                                    <p class="text-xs opacity-70">{{ metrics.overall.total_verified_today }} verified today</p>
                                </div>
                            </div>
                            <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </a>

                        <a href="{{ path('app_terminal_team_pre_advice_requests') }}" 
                           class="flex items-center justify-between p-4 bg-info/10 border border-info rounded-lg hover:bg-info/20 transition-colors">
                            <div class="flex items-center space-x-3">
                                <div class="avatar placeholder">
                                    <div class="w-8 bg-info text-info-content rounded-full">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">All FREE-ADVICE Requests</p>
                                    <p class="text-xs opacity-70">View and manage all requests</p>
                                </div>
                            </div>
                            <svg class="w-5 h-5 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="card">
                <div class="card-body">
                    <div class="flex justify-between items-center mb-4">
                        <div>
                            <h3 class="card-title">Recent Activity</h3>
                            <p class="text-sm text-base-content/70">Latest FREE-ADVICE operations</p>
                        </div>
                        <span class="badge badge-ghost">{{ recent_activity|length }} activities</span>
                    </div>
                    
                    {% if recent_activity|length > 0 %}
                        <div class="space-y-4 max-h-80 overflow-y-auto">
                            {% for activity in recent_activity %}
                                <div class="flex items-center justify-between p-3 bg-base-200 rounded-lg">
                                    <div class="flex items-center space-x-3">
                                        {% if activity.status.value == 'pending' %}
                                            <div class="avatar placeholder">
                                                <div class="w-8 bg-warning text-warning-content rounded-full">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                    </svg>
                                                </div>
                                            </div>
                                        {% elseif activity.status.value == 'verified' %}
                                            <div class="avatar placeholder">
                                                <div class="w-8 bg-success text-success-content rounded-full">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                    </svg>
                                                </div>
                                            </div>
                                        {% elseif activity.status.value == 'rejected' %}
                                            <div class="avatar placeholder">
                                                <div class="w-8 bg-error text-error-content rounded-full">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                    </svg>
                                                </div>
                                            </div>
                                        {% else %}
                                            <div class="avatar placeholder">
                                                <div class="w-8 bg-base-300 rounded-full">
                                                    <div class="w-2 h-2 bg-base-content rounded-full"></div>
                                                </div>
                                            </div>
                                        {% endif %}
                                        <div>
