{% extends 'base.html.twig' %}

{% block title %}Terminal Team Dashboard - OPTIMUS{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Breadcrumbs -->
    <div class="bg-base-100 border-b border-base-300">
        <div class="w-full px-4 sm:px-6 lg:px-8 py-4">
            <div class="breadcrumbs text-sm">
                <ul>
                    <li aria-current="page">Terminal Team Dashboard</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Header -->
    <div class="bg-base-100 shadow-sm border-b border-base-300">
        <div class="w-full px-4 sm:px-6 lg:px-8">
            <div class="py-6">
                <h1 class="text-3xl font-bold text-base-content">Terminal Team Dashboard</h1>
                <p class="mt-2 text-base-content/70">Monitor FREE-ADVICE operations and terminal metrics</p>
            </div>
        </div>
    </div>

    <!-- Skeleton Loader -->
    <div id="dashboardSkeleton" class="w-full px-4 sm:px-6 lg:px-8 py-8">
        <!-- Skeleton for System Health Status -->
        <div class="card mb-8">
            <div class="card-body">
                <div class="skeleton h-6 w-48 mb-4"></div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="skeleton h-16"></div>
                    <div class="skeleton h-16"></div>
                    <div class="skeleton h-16"></div>
                </div>
            </div>
        </div>

        <!-- Skeleton for Key Metrics -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <div class="skeleton h-32"></div>
            <div class="skeleton h-32"></div>
            <div class="skeleton h-32"></div>
            <div class="skeleton h-32"></div>
        </div>

        <!-- Skeleton for NOA Management -->
        <div class="card mb-8">
            <div class="card-body">
                <div class="skeleton h-6 w-64 mb-4"></div>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                    <div class="skeleton h-24"></div>
                    <div class="skeleton h-24"></div>
                    <div class="skeleton h-24"></div>
                    <div class="skeleton h-24"></div>
                </div>
                <div class="skeleton h-64"></div>
            </div>
        </div>

        <!-- Skeleton for Terminal Type Breakdown -->
        <div class="card mb-8">
            <div class="card-body">
                <div class="skeleton h-6 w-48 mb-4"></div>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="skeleton h-64"></div>
                    <div class="skeleton h-64"></div>
                    <div class="skeleton h-64"></div>
                </div>
            </div>
        </div>

        <!-- Skeleton for Dwell Time Monitoring -->
        <div class="card mb-8">
            <div class="card-body">
                <div class="skeleton h-8 w-64 mb-6"></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="skeleton h-40"></div>
                    <div class="skeleton h-40"></div>
                </div>
                <div class="skeleton h-96"></div>
            </div>
        </div>

        <!-- Skeleton for Management Sections -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <div class="skeleton h-96"></div>
            <div class="skeleton h-96"></div>
        </div>
    </div>

    <!-- Main Content -->
    <div id="dashboardContent" class="w-full px-4 sm:px-6 lg:px-8 py-8" style="display: none;">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- System Health Status -->
        <div class="card mb-8">
            <div class="card-body">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="card-title">Terminal Operations Status</h2>
                    <div class="flex items-center space-x-2">
                        <div class="w-3 h-3 bg-success rounded-full"></div>
                        <span class="text-sm text-success font-medium">All Terminals Operational</span>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="flex items-center space-x-3">
                        <div class="avatar placeholder">
                            <div class="w-8 bg-success text-success-content rounded-full">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-medium">Container Terminal</p>
                            <p class="text-xs text-success">Active</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="avatar placeholder">
                            <div class="w-8 bg-info text-info-content rounded-full">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-medium">Bulk Terminal</p>
                            <p class="text-xs text-info">Active</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="avatar placeholder">
                            <div class="w-8 bg-secondary text-secondary-content rounded-full">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-medium">System Uptime</p>
                            <p class="text-xs text-secondary">Online</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Key Metrics - 4 Cards per Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <!-- Pending Requests -->
            <div class="stats shadow">
                <div class="stat">
                    <div class="stat-figure text-warning">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="stat-title">Pending Requests</div>
                    <div class="stat-value text-4xl">{{ metrics.overall.total_pending }}</div>
                    <div class="stat-desc text-warning">Awaiting review</div>
                </div>
            </div>

            <!-- Verified Today -->
            <div class="stats shadow">
                <div class="stat">
                    <div class="stat-figure text-success">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="stat-title">Verified Today</div>
                    <div class="stat-value text-4xl">{{ metrics.overall.total_verified_today }}</div>
                    <div class="stat-desc text-success">Approved requests</div>
                </div>
            </div>

            <!-- Available Slots -->
            <div class="stats shadow">
                <div class="stat">
                    <div class="stat-figure text-info">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div class="stat-title">Available Slots</div>
                    <div class="stat-value text-4xl">{{ metrics.overall.total_available_slots }}</div>
                    <div class="stat-desc text-info">Next 7 days</div>
                </div>
            </div>

            <!-- Total Capacity -->
            <div class="stats shadow">
                <div class="stat">
                    <div class="stat-figure text-secondary">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                        </svg>
                    </div>
                    <div class="stat-title">Total Capacity</div>
                    <div class="stat-value text-4xl">{{ metrics.overall.total_capacity }}</div>
                    <div class="stat-desc text-secondary">TEU capacity</div>
                </div>
            </div>
        </div>

        <!-- Pre-Advice Management Section -->
        <div class="card mb-8">
            <div class="card-body">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="card-title">FREE-ADVICE Request Management</h3>
                        <p class="text-sm text-base-content/70">Review and manage container return pre-advice requests</p>
                    </div>
                    <a href="{{ path('app_terminal_team_pre_advice_requests') }}" class="btn btn-primary">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                        View All Requests
                    </a>
                </div>

                <!-- Pending Pre-Advice Requests Table -->
                <div>
                    <h4 class="text-sm font-semibold mb-3">Pending Pre-Advice Requests</h4>
                    {% if pending_requests|length > 0 %}
                        <div class="overflow-x-auto">
                            <table class="table table-zebra">
                                <thead>
                                    <tr>
                                        <th>Container Number</th>
                                        <th>Terminal</th>
                                        <th>Terminal Type</th>
                                        <th>Trucker</th>
                                        <th>Submitted</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for request in pending_requests %}
                                        <tr class="hover">
                                            <td class="font-medium text-primary">{{ request.container.containerNumber }}</td>
                                            <td>{{ request.selectedTerminal.name }}</td>
                                            <td>
                                                <span class="badge badge-info badge-sm">
                                                    {{ request.selectedTerminal.type.value|title }}
                                                </span>
                                            </td>
                                            <td>{{ request.trucker.businessName ?? request.trucker.email }}</td>
                                            <td class="text-sm opacity-70">
                                                {{ request.createdAt|date('M j, g:i A') }}
                                            </td>
                                            <td>
                                                <a href="{{ path('app_terminal_team_pre_advice_detail', {id: request.id}) }}" 
                                                   class="btn btn-xs btn-primary">
                                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                    </svg>
                                                    Review
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-4 text-center">
                            <a href="{{ path('app_terminal_team_pre_advice_requests', {status: 'pending'}) }}" 
                               class="btn btn-sm btn-outline">
                                View All Pending Requests
                                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </a>
                        </div>
                    {% else %}
                        <div class="text-center py-8 bg-base-200 rounded-lg">
                            <svg class="mx-auto h-12 w-12 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                            </svg>
                            <p class="mt-2 text-sm opacity-70">No pending pre-advice requests</p>
                            <p class="text-xs opacity-60 mt-1">Pending requests from truckers will appear here</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Container Yard Allocations -->
        <div class="card mb-8">
            <div class="card-body p-0">
                <div class="px-5 py-4">
                    <h3 class="font-semibold text-base text-base-content">Container Yard Allocations</h3>
                    <p class="text-xs text-base-content/50 mt-0.5">Manage the allowed TEU capacity for each container yard. Current TEUs is a real-time count of containers in the yard.</p>
                </div>
                <div class="p-5">
                    {% if terminal_stats is empty %}
                        <div class="text-center py-8 bg-base-200 rounded-lg">
                            <svg class="mx-auto h-12 w-12 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                            </svg>
                            <p class="mt-2 text-sm opacity-70">No terminal allocations found for your shipping line</p>
                        </div>
                    {% else %}
                        {% set yardsByRegion = {} %}
                        {% for stat in terminal_stats %}
                            {% set regionName = stat.terminal.region ? stat.terminal.region.name : 'Other' %}
                            {% if yardsByRegion[regionName] is not defined %}
                                {% set yardsByRegion = yardsByRegion|merge({(regionName): []}) %}
                            {% endif %}
                            {% set yardsByRegion = yardsByRegion|merge({(regionName): yardsByRegion[regionName]|merge([stat])}) %}
                        {% endfor %}

                        {% for regionName, regionYards in yardsByRegion %}
                            {% if regionYards|length > 0 %}
                                {# Region divider #}
                                <div class="flex items-center gap-3 mb-5 {% if not loop.first %}mt-8{% endif %}">
                                    <span class="icon-[tabler--map-pin] size-4 text-primary"></span>
                                    <span class="font-semibold text-base text-primary">{{ regionName }}</span>
                                    <div class="flex-1 h-px bg-base-300"></div>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-4">
                                    {% for stat in regionYards %}
                                        <div class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300">
                                            <div class="card-body p-5">
                                                <!-- Terminal Header -->
                                                <div class="flex items-start justify-between mb-4">
                                                    <div class="flex items-center gap-3 flex-1 min-w-0">
                                                        <div class="w-12 h-12 bg-base-content/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                                            <span class="icon-[tabler--building-warehouse] size-6 text-base-content"></span>
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <h4 class="font-bold text-base text-base-content truncate">{{ stat.terminal.name }}</h4>
                                                            <p class="text-xs text-base-content/60 truncate">
                                                                {% if stat.terminal.city %}
                                                                    {{ stat.terminal.city.name }}
                                                                {% elseif stat.terminal.region %}
                                                                    {{ stat.terminal.region.name }}
                                                                {% else %}
                                                                    Port Area
                                                                {% endif %}
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <span class="badge badge-success badge-sm ml-2 flex-shrink-0">Available</span>
                                                </div>
                                                
                                                <!-- 20ft Containers Section -->
                                                <div class="mb-4">
                                                    <div class="flex items-center justify-between mb-3">
                                                        <h5 class="text-sm font-bold text-base-content">20ft Containers</h5>
                                                        <span class="badge badge-neutral badge-sm">20ft</span>
                                                    </div>
                                                    
                                                    <div class="grid grid-cols-4 gap-3 mb-3">
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--box] size-4 text-base-content/40"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Capacity</p>
                                                            <p class="text-lg font-bold text-base-content">{{ stat.capacity_20ft }}</p>
                                                        </div>
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--box-multiple] size-4 text-info"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Allocated</p>
                                                            <p class="text-lg font-bold text-info">{{ stat.allocated_20ft }}</p>
                                                        </div>
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--clock] size-4 text-warning"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Pre-Forecast</p>
                                                            <p class="text-lg font-bold text-warning">{{ stat.pre_forecast_20ft }}</p>
                                                        </div>
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--circle-check] size-4 text-success"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Available</p>
                                                            <p class="text-lg font-bold text-success">{{ stat.available_20ft }}</p>
                                                        </div>
                                                    </div>
                                                    
                                                    <div>
                                                        <div class="flex justify-between items-center mb-2">
                                                            <span class="text-xs text-base-content/60 flex items-center gap-1">
                                                                <span class="icon-[tabler--chart-bar] size-3"></span>
                                                                Utilization
                                                            </span>
                                                            <span class="text-sm font-bold text-base-content">{{ stat.utilization_20ft }}%</span>
                                                        </div>
                                                        <div class="w-full bg-base-300 rounded-full h-2.5">
                                                            <div class="h-2.5 rounded-full transition-all 
                                                                {{ stat.utilization_20ft >= 90 ? 'bg-error' : (stat.utilization_20ft >= 70 ? 'bg-warning' : 'bg-success') }}" 
                                                                 style="width: {{ stat.utilization_20ft > 100 ? 100 : stat.utilization_20ft }}%"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- 40ft Containers Section -->
                                                <div class="mb-4">
                                                    <div class="flex items-center justify-between mb-3">
                                                        <h5 class="text-sm font-bold text-base-content">40ft Containers</h5>
                                                        <span class="badge badge-neutral badge-sm">40ft</span>
                                                    </div>
                                                    
                                                    <div class="grid grid-cols-4 gap-3 mb-3">
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--box] size-4 text-base-content/40"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Capacity</p>
                                                            <p class="text-lg font-bold text-base-content">{{ stat.capacity_40ft }}</p>
                                                        </div>
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--box-multiple] size-4 text-info"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Allocated</p>
                                                            <p class="text-lg font-bold text-info">{{ stat.allocated_40ft }}</p>
                                                        </div>
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--clock] size-4 text-warning"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Pre-Forecast</p>
                                                            <p class="text-lg font-bold text-warning">{{ stat.pre_forecast_40ft }}</p>
                                                        </div>
                                                        <div class="text-center">
                                                            <div class="flex items-center justify-center mb-1">
                                                                <span class="icon-[tabler--circle-check] size-4 text-success"></span>
                                                            </div>
                                                            <p class="text-xs text-base-content/60 mb-1">Available</p>
                                                            <p class="text-lg font-bold text-success">{{ stat.available_40ft }}</p>
                                                        </div>
                                                    </div>
                                                    
                                                    <div>
                                                        <div class="flex justify-between items-center mb-2">
                                                            <span class="text-xs text-base-content/60 flex items-center gap-1">
                                                                <span class="icon-[tabler--chart-bar] size-3"></span>
                                                                Utilization
                                                            </span>
                                                            <span class="text-sm font-bold text-base-content">{{ stat.utilization_40ft }}%</span>
                                                        </div>
                                                        <div class="w-full bg-base-300 rounded-full h-2.5">
                                                            <div class="h-2.5 rounded-full transition-all 
                                                                {{ stat.utilization_40ft >= 90 ? 'bg-error' : (stat.utilization_40ft >= 70 ? 'bg-warning' : 'bg-success') }}" 
                                                                 style="width: {{ stat.utilization_40ft > 100 ? 100 : stat.utilization_40ft }}%"></div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <a href="{{ path('app_terminal_team_detailed_stack_view', {depotId: stat.terminal.name}) }}" class="btn btn-primary btn-sm w-full gap-2">
                                                    <span class="icon-[tabler--file-description] size-4"></span>
                                                    View Detailed Stack
                                                </a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Dwell Time Monitoring Section -->
        <div class="card mb-8 bg-gradient-to-r from-warning/10 to-error/10 border-2 border-warning">
            <div class="card-body">
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center">
                        <svg class="w-8 h-8 text-warning mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div>
