                <h3 class="card-title mb-4">Terminal Operations</h3>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                    <a href="{{ path('app_terminal_team_pre_advice_requests', {status: 'pending'}) }}" 
                       class="btn btn-outline">
