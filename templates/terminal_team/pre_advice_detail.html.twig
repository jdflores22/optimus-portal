{% extends 'base.html.twig' %}

{% block title %}Pre-Advice Request #{{ pre_advice.id }} - Terminal Team{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="card">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <h1 class="card-title text-xl sm:text-2xl">Pre-Advice Request #{{ pre_advice.id }}</h1>
                    <p class="text-sm sm:text-base text-base-content/70 mt-1 break-words">
                        Container {{ pre_advice.container.containerNumber }} - {{ pre_advice.selectedTerminal.name }} ({{ pre_advice.selectedTerminal.type.value }})
                    </p>
                </div>
                <div class="flex gap-3 flex-shrink-0">
                    <a href="{{ path('app_terminal_team_pre_advice_requests') }}" class="btn btn-soft btn-secondary btn-sm sm:btn-md w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        <span class="hidden sm:inline">Back to Requests</span>
                        <span class="sm:hidden">Back</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="space-y-6">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error mb-4">
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Status Banner -->
        {% set status = pre_advice.status.value %}
        <div class="alert mb-8
            {% if status == 'pending' %}alert-warning
            {% elseif status == 'verified' %}alert-success
            {% elseif status == 'rejected' %}alert-error
            {% elseif status == 'completed' %}alert-info
            {% else %}alert-ghost{% endif %}">
            {% if status == 'pending' %}
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            {% elseif status == 'verified' %}
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
            {% elseif status == 'rejected' %}
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
            {% endif %}
            <div>
                <h3 class="font-bold">Status: {{ status|title }}</h3>
                <div class="text-sm">
                    {% if status == 'pending' %}
                        This FREE-ADVICE request is awaiting your review and verification.
                    {% elseif status == 'verified' %}
                        This request has been verified and EDO/QR code generation is in progress.
                    {% elseif status == 'rejected' %}
                        This request has been rejected. See details below.
                    {% elseif status == 'completed' %}
                        This request is complete. EDO and QR code are available for download.
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Request Information -->
        <div class="card bg-base-100 shadow-md mb-8">
            <div class="card-body">
                <h2 class="card-title">Request Information</h2>
                
                <!-- Container Number Highlight -->
                <div class="alert alert-info mb-4">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                    <div>
                        <div class="text-sm font-medium">Container Number</div>
                        <div class="text-2xl font-bold font-mono">{{ pre_advice.container.containerNumber }}</div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="stats shadow">
                        <div class="stat p-4">
                            <div class="stat-title text-xs">Submitted</div>
                            <div class="stat-value text-base sm:text-lg">{{ pre_advice.createdAt|date('M j, Y') }}</div>
                            <div class="stat-desc text-xs">{{ pre_advice.createdAt|date('g:i A') }}</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat p-4">
                            <div class="stat-title text-xs">Terminal Type</div>
                            <div class="stat-value text-base sm:text-lg">{{ pre_advice.selectedTerminal.type.value }}</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat p-4">
                            <div class="stat-title text-xs">Payment Reference</div>
                            <div class="stat-value text-xs sm:text-sm font-mono break-all">{{ pre_advice.paymentReference }}</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat p-4">
                            <div class="stat-title text-xs">Photos</div>
                            <div class="stat-value text-base sm:text-lg">{{ pre_advice.geotagPhotos|length }}</div>
                            <div class="stat-desc text-xs">Uploaded</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Container & Trucker Info Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Container Information -->
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h3 class="card-title">Container Information</h3>
                    <div class="divider my-2"></div>
                    <div class="space-y-3 text-sm">
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Container Number:</span>
                            <span class="font-mono break-all">{{ pre_advice.container.containerNumber }}</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Size & Type:</span>
                            <span>{{ pre_advice.container.size }} {{ pre_advice.container.type }}</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Current Status:</span>
                            <span class="badge badge-info badge-sm">{{ pre_advice.container.status.value|title|replace({'_': ' '}) }}</span>
                        </div>
                        {% if pre_advice.container.currentLocation %}
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Current Location:</span>
                            <span class="break-words">{{ pre_advice.container.currentLocation }}</span>
                        </div>
                        {% endif %}
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Expected Return Date:</span>
                            <span>{{ pre_advice.container.expectedReturnDate|date('M j, Y') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trucker Information -->
            <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                    <h3 class="card-title">Trucker Information</h3>
                    <div class="divider my-2"></div>
                    <div class="space-y-3 text-sm">
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Name:</span>
                            <span>{{ pre_advice.trucker.firstName }} {{ pre_advice.trucker.lastName }}</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Email:</span>
                            <span class="break-all">{{ pre_advice.trucker.email }}</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">Phone:</span>
                            <span>{{ pre_advice.trucker.phoneNumber }}</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                            <span class="font-medium text-base-content/70">License Number:</span>
                            <span class="font-mono break-all">{{ pre_advice.trucker.licenseNumber }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Terminal Information -->
        <div class="card bg-base-100 shadow-md mb-8">
            <div class="card-body">
                <h3 class="card-title">Terminal Information</h3>
                <div class="divider my-2"></div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm">
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                        <span class="font-medium text-base-content/70">Terminal Name:</span>
                        <span class="break-words">{{ pre_advice.selectedTerminal.name }}</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                        <span class="font-medium text-base-content/70">Type:</span>
                        <span class="badge badge-info badge-sm">{{ pre_advice.selectedTerminal.type.value }}</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
                        <span class="font-medium text-base-content/70">Location:</span>
                        <span class="break-words">{{ pre_advice.selectedTerminal.location }}</span>
                    </div>
                </div>
                
                {% if pre_advice.assignedSlot %}
                    <div class="alert alert-success mt-4">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                            <h4 class="font-medium">Assigned Slot</h4>
                            <p class="text-sm">Date: {{ pre_advice.assignedSlot.date|date('M j, Y') }}</p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Verification Actions -->
        {% if pre_advice.status.value == 'pending' %}
        <div class="card bg-base-100 shadow-md mb-8">
            <div class="card-body">
                <h3 class="card-title">Verification Actions</h3>
                <div class="divider my-2"></div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Approve Section -->
                    <div class="card bg-success/10 border border-success">
                        <div class="card-body">
                            <h4 class="card-title text-success">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Approve FREE-ADVICE
                            </h4>
                            <form method="POST" action="{{ path('app_terminal_team_pre_advice_verify', {id: pre_advice.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('verify_pre_advice_' ~ pre_advice.id) }}">
                                <div class="space-y-4">
                                    <div class="form-control">
                                        <label class="label">
                                            <span class="label-text">Select Time Slot <span class="text-error">*</span></span>
                                        </label>
                                        <select name="slot_id" id="slot_id" required class="select select-bordered w-full">
                                            <option value="">Choose a time slot...</option>
                                            {% for slot in available_slots %}
                                                <option value="{{ slot.id }}">
                                                    {{ slot.date|date('M j, Y') }} - 
                                                    Available: {{ slot.capacity - slot.assignedCount }}/{{ slot.capacity }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                        {% if available_slots|length == 0 %}
                                            <label class="label">
                                                <span class="label-text-alt text-error">No available slots for this terminal in the next 30 days.</span>
                                            </label>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="form-control">
                                        <label class="label">
                                            <span class="label-text">Verification Notes (Optional)</span>
                                        </label>
                                        <textarea name="verification_notes" rows="3" class="textarea textarea-bordered" placeholder="Add any notes about the verification..."></textarea>
                                    </div>
                                    
                                    <button type="submit" class="btn btn-success w-full" {% if available_slots|length == 0 %}disabled{% endif %}>
                                        {% if available_slots|length == 0 %}
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                                            </svg>
                                            No Slots Available
                                        {% else %}
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                            </svg>
                                            Approve & Generate EDO
                                        {% endif %}
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    
                    <!-- Reject Section -->
                    <div class="card bg-error/10 border border-error">
                        <div class="card-body">
                            <h4 class="card-title text-error">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                                Reject FREE-ADVICE
                            </h4>
                            <form method="POST" action="{{ path('app_terminal_team_pre_advice_reject', {id: pre_advice.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('reject_pre_advice_' ~ pre_advice.id) }}">
                                <div class="space-y-4">
                                    <div class="form-control">
                                        <label class="label">
                                            <span class="label-text">Rejection Reason <span class="text-error">*</span></span>
                                        </label>
                                        <textarea name="rejection_reason" rows="4" required class="textarea textarea-bordered" placeholder="Please provide a detailed reason for rejection..."></textarea>
                                    </div>
                                    
                                    <button type="submit" class="btn btn-error w-full" onclick="return confirm('Are you sure you want to reject this FREE-ADVICE request?')">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                        </svg>
                                        Reject FREE-ADVICE
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Geotag Photos -->
        <div class="card bg-base-100 shadow-md mb-8">
            <div class="card-body">
                <h3 class="card-title">Geotag Photos</h3>
                <div class="divider my-2"></div>
                {% if pre_advice.geotagPhotos|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for photo in pre_advice.geotagPhotos %}
                            <div class="card bg-base-100 border border-base-300 shadow-sm">
                                <figure class="relative">
                                    <img src="{{ asset('uploads/' ~ photo.filename) }}" alt="Container photo" class="w-full h-48 object-cover cursor-pointer" onclick="openPhotoModal('{{ asset('uploads/' ~ photo.filename) }}', '{{ photo.originalName }}')">
                                    <div class="absolute top-2 right-2">
                                        {% if photo.isVerified %}
                                            <span class="badge badge-success gap-1">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                </svg>
                                                Verified
                                            </span>
                                        {% else %}
                                            <span class="badge badge-warning gap-1">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                </svg>
                                                Pending
                                            </span>
                                        {% endif %}
                                    </div>
                                </figure>
                                <div class="card-body p-4">
                                    <div class="space-y-2">
                                        <div>
                                            <div class="text-xs font-medium text-base-content/60">GPS Coordinates</div>
                                            <div class="text-sm font-mono">{{ photo.latitude|number_format(6) }}, {{ photo.longitude|number_format(6) }}</div>
                                        </div>
                                        <div>
                                            <div class="text-xs font-medium text-base-content/60">Captured</div>
                                            <div class="text-sm">{{ photo.capturedAt|date('M j, Y g:i A') }}</div>
                                        </div>
                                        {% if photo.verificationNotes %}
                                            <div class="alert alert-info py-2">
                                                <div class="text-xs">{{ photo.verificationNotes }}</div>
                                            </div>
                                        {% endif %}
                                        
                                        {% if pre_advice.status.value == 'pending' %}
                                            <div class="divider my-2"></div>
                                            <form method="POST" action="{{ path('app_terminal_team_photo_verify', {id: pre_advice.id, photoId: photo.id}) }}" class="space-y-2">
                                                <input type="hidden" name="_token" value="{{ csrf_token('verify_photo_' ~ pre_advice.id ~ '_' ~ photo.id) }}">
                                                <div class="form-control">
                                                    <label class="label py-1">
                                                        <span class="label-text text-xs">Verification Status</span>
                                                    </label>
                                                    <select name="is_verified" class="select select-bordered select-sm">
                                                        <option value="1" {{ photo.isVerified ? 'selected' : '' }}>✓ Verified</option>
                                                        <option value="0" {{ not photo.isVerified ? 'selected' : '' }}>⚠ Flagged</option>
                                                    </select>
                                                </div>
                                                <div class="form-control">
                                                    <label class="label py-1">
                                                        <span class="label-text text-xs">Notes</span>
                                                    </label>
                                                    <textarea name="verification_notes" rows="2" class="textarea textarea-bordered textarea-sm text-xs" placeholder="Add verification notes...">{{ photo.verificationNotes }}</textarea>
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-sm w-full">
                                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                    </svg>
                                                    Update Verification
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-12">
                        <svg class="w-16 h-16 text-base-content/20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <p class="text-base-content/60 font-medium">No photos uploaded</p>
                        <p class="text-base-content/40 text-sm mt-1">Photos will appear here once the trucker uploads them</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Photo Modal -->
        <dialog id="photoModal" class="modal">
            <div class="modal-box max-w-4xl">
                <h3 class="font-bold text-lg mb-4" id="modalTitle">Photo Preview</h3>
                <img id="modalImage" src="" alt="Photo preview" class="w-full rounded-lg">
                <div class="modal-action">
                    <form method="dialog">
                        <button class="btn">Close</button>
                    </form>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop">
                <button>close</button>
            </form>
        </dialog>

        <!-- Verification History -->
        {% if pre_advice.verifiedBy or pre_advice.rejectionReason %}
        <div class="card bg-base-100 shadow-md mb-8">
            <div class="card-body">
                <h3 class="card-title">Verification History</h3>
                <div class="divider my-2"></div>
                {% if pre_advice.verifiedBy %}
                    <div class="flex items-start gap-4">
                        <div class="avatar placeholder">
                            <div class="w-12 rounded-full
                                {% if pre_advice.status.value == 'verified' %}bg-success text-success-content
                                {% else %}bg-error text-error-content{% endif %}">
                                {% if pre_advice.status.value == 'verified' %}
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                {% else %}
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                    </svg>
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="card bg-base-200">
                                <div class="card-body p-4">
                                    <div class="flex items-center justify-between mb-2">
                                        <div class="font-bold">{{ pre_advice.status.value|title }}</div>
                                        <div class="text-sm text-base-content/60">{{ pre_advice.verifiedAt|date('M j, Y g:i A') }}</div>
                                    </div>
                                    <div class="text-sm text-base-content/70">
                                        Processed by <span class="font-medium">{{ pre_advice.verifiedBy.firstName }} {{ pre_advice.verifiedBy.lastName }}</span>
                                    </div>
                                    {% if pre_advice.rejectionReason %}
                                        <div class="alert alert-error mt-3">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                            <div>
                                                <div class="font-medium">Rejection Reason</div>
                                                <div class="text-sm">{{ pre_advice.rejectionReason }}</div>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- EDO and QR Code Information -->
        {% if pre_advice.edoNumber or pre_advice.qrCode %}
        <div class="card bg-base-100 shadow-md mb-8">
            <div class="card-body">
                <h3 class="card-title">EDO & QR Code</h3>
                <div class="divider my-2"></div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    {% if pre_advice.edoNumber %}
                        <div class="stats shadow border border-info">
                            <div class="stat">
                                <div class="stat-figure text-info">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                    </svg>
                                </div>
                                <div class="stat-title">EDO Number</div>
                                <div class="stat-value text-info text-lg font-mono">{{ pre_advice.edoNumber }}</div>
                            </div>
                        </div>
                    {% endif %}
                    {% if pre_advice.qrCode %}
                        <div class="stats shadow border border-success">
                            <div class="stat">
                                <div class="stat-figure text-success">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                                    </svg>
                                </div>
                                <div class="stat-title">QR Code Status</div>
                                <div class="stat-value text-success text-sm">
                                    <span class="badge badge-success gap-1">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        Generated
                                    </span>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
                
                {% if pre_advice.edoNumber and pre_advice.qrCode %}
                    <div class="divider">Download Options</div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <a href="{{ path('app_terminal_team_edo_download', {id: pre_advice.id}) }}" class="btn btn-info btn-sm sm:btn-md">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <span class="hidden sm:inline">Download EDO</span>
                            <span class="sm:hidden">EDO</span>
                        </a>
                        
                        <a href="{{ path('app_terminal_team_qr_code_download', {id: pre_advice.id}) }}" class="btn btn-success btn-sm sm:btn-md">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                            </svg>
                            <span class="hidden sm:inline">Download QR Code</span>
                            <span class="sm:hidden">QR Code</span>
                        </a>
                        
                        <a href="{{ path('app_terminal_team_print_package', {id: pre_advice.id}) }}" class="btn btn-secondary btn-sm sm:btn-md sm:col-span-1 col-span-full">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                            </svg>
                            Print Package
                        </a>
                    </div>
                    <div class="alert alert-info mt-4">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                            <div class="font-medium">Print Package Information</div>
                            <div class="text-sm">The print package includes both the EDO and QR code in a single document optimized for printing and terminal operations.</div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>

<script>
    function openPhotoModal(imageSrc, title) {
        document.getElementById('modalImage').src = imageSrc;
        document.getElementById('modalTitle').textContent = title || 'Photo Preview';
        document.getElementById('photoModal').showModal();
    }
</script>
{% endblock %}
