{% extends 'base.html.twig' %}

{% block title %}Pre-Advice Requests - Terminal Team{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="card">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <h1 class="card-title text-xl sm:text-2xl">Pre-Advice Requests</h1>
                    <p class="text-sm sm:text-base text-base-content/70 mt-1">Review and manage container return pre-advice requests</p>
                </div>
                <div class="flex gap-3 flex-shrink-0">
                    <a href="{{ path('app_terminal_team_dashboard') }}" class="btn btn-soft btn-secondary btn-sm sm:btn-md w-full sm:w-auto">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        <span class="hidden sm:inline">Back to Dashboard</span>
                        <span class="sm:hidden">Dashboard</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card">
        <div class="card-body">
            <form method="GET" class="flex flex-col sm:flex-row flex-wrap items-end gap-4">
                <div class="flex-1 min-w-0 w-full sm:w-auto">
                    <label for="status" class="label">
                        <span class="label-text">Status</span>
                    </label>
                    <select name="status" id="status" class="select select-bordered w-full">
                        <option value="all" {{ current_status == 'all' ? 'selected' : '' }}>All Statuses</option>
                        {% for status in statuses %}
                            <option value="{{ status.value }}" {{ current_status == status.value ? 'selected' : '' }}>
                                {{ status.value|title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="flex-1 min-w-0 w-full sm:w-auto">
                    <label for="terminal_type" class="label">
                        <span class="label-text">Terminal Type</span>
                    </label>
                    <select name="terminal_type" id="terminal_type" class="select select-bordered w-full">
                        <option value="all" {{ current_terminal_type == 'all' ? 'selected' : '' }}>All Terminals</option>
                        {% for terminal_type in terminal_types %}
                            <option value="{{ terminal_type.value }}" {{ current_terminal_type == terminal_type.value ? 'selected' : '' }}>
                                {{ terminal_type.value }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="flex-shrink-0 w-full sm:w-auto">
                    <button type="submit" class="btn btn-primary w-full sm:w-auto">
                        <span class="icon-[tabler--filter] size-5"></span>
                        Apply Filters
                    </button>
                </div>

                {% if current_status != 'pending' or current_terminal_type != 'all' %}
                    <div class="flex-shrink-0 w-full sm:w-auto">
                        <a href="{{ path('app_terminal_team_pre_advice_requests') }}" class="btn btn-soft btn-secondary w-full sm:w-auto">
                            <span class="icon-[tabler--x] size-5"></span>
                            Clear Filters
                        </a>
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="card">
        <div class="card-body py-3">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div class="text-xs sm:text-sm text-base-content/70">
                    Showing {{ requests|length }} of {{ total_count }} requests
                    {% if current_status != 'all' %}
                        with status "{{ current_status|title }}"
                    {% endif %}
                    {% if current_terminal_type != 'all' %}
                        for {{ current_terminal_type }} terminals
                    {% endif %}
                </div>
                {% if total_pages > 1 %}
                    <div class="text-xs sm:text-sm text-base-content/70">
                        Page {{ current_page }} of {{ total_pages }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Requests List -->
    <div class="card">
        {% if no_shipping_line is defined and no_shipping_line %}
            <div class="card-body text-center py-12">
                <div class="alert alert-warning inline-flex flex-col items-center max-w-2xl mx-auto">
                    <span class="icon-[tabler--alert-triangle] size-12"></span>
                    <h3 class="alert-title mt-2">No Shipping Line Association</h3>
                    <div class="alert-description">
                        Your account is not associated with a shipping line. To view pre-advice requests, you need to be assigned to a shipping line admin.
                    </div>
                    <p class="text-xs text-base-content/50 mt-2">
                        Please contact your system administrator to set up the proper shipping line association.
                    </p>
                </div>
            </div>
        {% elseif requests|length > 0 %}
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Container</th>
                            <th>Trucker</th>
                            <th>Terminal</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for request in requests %}
                            <tr class="hover">
                                <td>
                                    <div class="font-medium text-base-content">
                                        {{ request.container.containerNumber }}
                                    </div>
                                    <div class="text-sm text-base-content/70">
                                        {{ request.container.size }} {{ request.container.type }}
                                    </div>
                                </td>
                                <td>
                                    <div class="text-base-content">
                                        {{ request.trucker.firstName }} {{ request.trucker.lastName }}
                                    </div>
                                    <div class="text-sm text-base-content/70">
                                        {{ request.trucker.email }}
                                    </div>
                                </td>
                                <td>
                                    <div class="font-medium text-base-content">
                                        {{ request.selectedTerminal.name }}
                                    </div>
                                    <div class="text-sm text-base-content/70">
                                        {{ request.selectedTerminal.type.value }}
                                    </div>
                                </td>
                                <td>
                                    {% set status = request.status.value %}
                                    {% if status == 'pending' %}
                                        <span class="badge badge-warning badge-soft">
                                            <span class="badge-icon icon-[tabler--clock]"></span>
                                            Pending
                                        </span>
                                    {% elseif status == 'verified' %}
                                        <span class="badge badge-success badge-soft">
                                            <span class="badge-icon icon-[tabler--check]"></span>
                                            Verified
                                        </span>
                                    {% elseif status == 'rejected' %}
                                        <span class="badge badge-error badge-soft">
                                            <span class="badge-icon icon-[tabler--x]"></span>
                                            Rejected
                                        </span>
                                    {% elseif status == 'completed' %}
                                        <span class="badge badge-info badge-soft">
                                            <span class="badge-icon icon-[tabler--circle-check]"></span>
                                            Completed
                                        </span>
                                    {% else %}
                                        <span class="badge badge-soft">
                                            {{ status|title }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="text-base-content">{{ request.createdAt|date('M j, Y') }}</div>
                                    <div class="text-xs text-base-content/50">
                                        {{ request.createdAt|date('g:i A') }}
                                    </div>
                                </td>
                                <td>
                                    <a href="{{ path('app_terminal_team_pre_advice_detail', {id: request.id}) }}" 
                                       class="btn btn-sm btn-primary btn-soft">
                                        {% if status == 'pending' %}
                                            <span class="icon-[tabler--eye-check] size-4"></span>
                                            Review
                                        {% else %}
                                            <span class="icon-[tabler--eye] size-4"></span>
                                            View Details
                                        {% endif %}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="md:hidden divide-y divide-base-content/10">
                {% for request in requests %}
                    {% set status = request.status.value %}
                    <div class="p-4 hover:bg-base-200/50 transition-colors">
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <div class="flex-1 min-w-0">
                                <div class="font-bold text-base-content break-all">
                                    {{ request.container.containerNumber }}
                                </div>
                                <div class="text-xs text-base-content/70 mt-1">
                                    {{ request.container.size }} {{ request.container.type }}
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                {% if status == 'pending' %}
                                    <span class="badge badge-warning badge-soft badge-sm">
                                        <span class="badge-icon icon-[tabler--clock]"></span>
                                        Pending
                                    </span>
                                {% elseif status == 'verified' %}
                                    <span class="badge badge-success badge-soft badge-sm">
                                        <span class="badge-icon icon-[tabler--check]"></span>
                                        Verified
                                    </span>
                                {% elseif status == 'rejected' %}
                                    <span class="badge badge-error badge-soft badge-sm">
                                        <span class="badge-icon icon-[tabler--x]"></span>
                                        Rejected
                                    </span>
                                {% elseif status == 'completed' %}
                                    <span class="badge badge-info badge-soft badge-sm">
                                        <span class="badge-icon icon-[tabler--circle-check]"></span>
                                        Completed
                                    </span>
                                {% else %}
                                    <span class="badge badge-soft badge-sm">
                                        {{ status|title }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="space-y-2 text-sm mb-3">
                            <div class="flex items-start gap-2">
                                <span class="icon-[tabler--user] size-4 text-base-content/50 flex-shrink-0 mt-0.5"></span>
                                <div class="flex-1 min-w-0">
                                    <div class="text-base-content">{{ request.trucker.firstName }} {{ request.trucker.lastName }}</div>
                                    <div class="text-xs text-base-content/70 break-all">{{ request.trucker.email }}</div>
                                </div>
                            </div>

                            <div class="flex items-start gap-2">
                                <span class="icon-[tabler--building] size-4 text-base-content/50 flex-shrink-0 mt-0.5"></span>
                                <div class="flex-1 min-w-0">
                                    <div class="text-base-content break-words">{{ request.selectedTerminal.name }}</div>
                                    <div class="text-xs text-base-content/70">{{ request.selectedTerminal.type.value }}</div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <span class="icon-[tabler--calendar] size-4 text-base-content/50 flex-shrink-0"></span>
                                <div class="text-base-content/70">
                                    {{ request.createdAt|date('M j, Y') }} at {{ request.createdAt|date('g:i A') }}
                                </div>
                            </div>
                        </div>

                        <a href="{{ path('app_terminal_team_pre_advice_detail', {id: request.id}) }}" 
                           class="btn btn-sm btn-primary btn-soft w-full">
                            {% if status == 'pending' %}
                                <span class="icon-[tabler--eye-check] size-4"></span>
                                Review Request
                            {% else %}
                                <span class="icon-[tabler--eye] size-4"></span>
                                View Details
                            {% endif %}
                        </a>
                    </div>
                {% endfor %}
            </div>

            <!-- Pagination -->
            {% if total_pages > 1 %}
                <div class="card-body border-t border-base-content/10">
                    <div class="flex items-center justify-between">
                        <!-- Mobile Pagination -->
                        <div class="flex flex-1 justify-between md:hidden gap-2">
                            {% if current_page > 1 %}
                                <a href="{{ path('app_terminal_team_pre_advice_requests', app.request.query.all|merge({page: current_page - 1})) }}" 
                                   class="btn btn-sm btn-secondary flex-1">
                                    <span class="icon-[tabler--chevron-left] size-4"></span>
                                    Previous
                                </a>
                            {% else %}
                                <button class="btn btn-sm btn-disabled flex-1" disabled>
                                    <span class="icon-[tabler--chevron-left] size-4"></span>
                                    Previous
                                </button>
                            {% endif %}
                            
                            <div class="flex items-center px-3 text-sm text-base-content/70">
                                {{ current_page }}/{{ total_pages }}
                            </div>
                            
                            {% if current_page < total_pages %}
                                <a href="{{ path('app_terminal_team_pre_advice_requests', app.request.query.all|merge({page: current_page + 1})) }}" 
                                   class="btn btn-sm btn-secondary flex-1">
                                    Next
                                    <span class="icon-[tabler--chevron-right] size-4"></span>
                                </a>
                            {% else %}
                                <button class="btn btn-sm btn-disabled flex-1" disabled>
                                    Next
                                    <span class="icon-[tabler--chevron-right] size-4"></span>
                                </button>
                            {% endif %}
                        </div>
                        
                        <!-- Desktop Pagination -->
                        <div class="hidden md:flex md:flex-1 md:items-center md:justify-between">
                            <div>
                                <p class="text-sm text-base-content/70">
                                    Showing page <span class="font-medium">{{ current_page }}</span> of <span class="font-medium">{{ total_pages }}</span>
                                </p>
                            </div>
                            <div>
                                <div class="join">
                                    {% if current_page > 1 %}
                                        <a href="{{ path('app_terminal_team_pre_advice_requests', app.request.query.all|merge({page: current_page - 1})) }}" 
                                           class="join-item btn btn-sm">
                                            <span class="icon-[tabler--chevron-left] size-4"></span>
                                            Previous
                                        </a>
                                    {% endif %}
                                    
                                    {% for page in 1..total_pages %}
                                        {% if page == current_page %}
                                            <button class="join-item btn btn-sm btn-primary">
                                                {{ page }}
                                            </button>
                                        {% elseif page == 1 or page == total_pages or (page >= current_page - 2 and page <= current_page + 2) %}
                                            <a href="{{ path('app_terminal_team_pre_advice_requests', app.request.query.all|merge({page: page})) }}" 
                                               class="join-item btn btn-sm">
                                                {{ page }}
                                            </a>
                                        {% elseif page == current_page - 3 or page == current_page + 3 %}
                                            <button class="join-item btn btn-sm btn-disabled">
                                                ...
                                            </button>
                                        {% endif %}
                                    {% endfor %}
                                    
                                    {% if current_page < total_pages %}
                                        <a href="{{ path('app_terminal_team_pre_advice_requests', app.request.query.all|merge({page: current_page + 1})) }}" 
                                           class="join-item btn btn-sm">
                                            Next
                                            <span class="icon-[tabler--chevron-right] size-4"></span>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% else %}
            <div class="card-body text-center py-12">
                <span class="icon-[tabler--clipboard-off] size-12 text-base-content/40 mx-auto"></span>
                <h3 class="mt-2 text-sm font-medium text-base-content">No pre-advice requests found</h3>
                <p class="mt-1 text-sm text-base-content/70">
                    {% if current_status != 'all' or current_terminal_type != 'all' %}
                        Try adjusting your filters to see more results.
                    {% else %}
                        No pre-advice requests have been submitted yet.
                    {% endif %}
                </p>
                {% if current_status != 'all' or current_terminal_type != 'all' %}
                    <div class="mt-6">
                        <a href="{{ path('app_terminal_team_pre_advice_requests') }}" 
                           class="btn btn-primary">
                            <span class="icon-[tabler--filter-off] size-5"></span>
                            Clear Filters
                        </a>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
