{% extends 'base.html.twig' %}

{% block title %}Referral Codes - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <!-- Header -->
    <div class="bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-base-content">Broker Referral Codes</h1>
                    <p class="text-sm text-base-content/60 mt-1">Generate and manage referral codes for broker registration</p>
                </div>
                <button type="button"
                        id="guide-generate-new-code"
                        onclick="openGenerateModal()"
                        class="btn btn-primary gap-2">
                    <span class="icon-[tabler--plus] size-5"></span>
                    Generate New Code
                </button>
            </div>
        </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-8 py-6 space-y-6">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <div class="alert alert-info">
            <span class="icon-[tabler--info-circle] size-5"></span>
            <span class="text-sm">Each referral code can only be used once by a single broker. Generate a new code for each broker you want to link with.</span>
        </div>

        <!-- Referral Codes List -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 border-b border-base-300">
                <h3 class="text-sm font-semibold text-base-content">Your Referral Codes</h3>
            </div>

            {% if codeStats|length > 0 %}
                <!-- Mobile: Card Layout -->
                <div class="divide-y divide-base-300 lg:hidden">
                    {% for stat in codeStats %}
                        {% set code = stat.code %}
                        <div class="p-4 space-y-3">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-xs text-base-content/60 mb-1">Code</p>
                                    <div class="flex items-center gap-2">
                                        <code class="text-sm font-mono font-semibold bg-base-200 px-2 py-1 rounded-lg">{{ code.code }}</code>
                                        <button type="button"
                                                onclick="copyToClipboard('{{ code.code }}')"
                                                class="btn btn-text btn-circle btn-sm"
                                                title="Copy code">
                                            <span class="icon-[tabler--copy] size-4"></span>
                                        </button>
                                    </div>
                                </div>
                                {% include 'consignee/referral_codes/_code_status_badge.html.twig' with {
                                    code: code,
                                    broker_count: stat.broker_count
                                } %}
                            </div>

                            <div class="grid grid-cols-2 gap-3 text-sm">
                                <div>
                                    <p class="text-xs text-base-content/60">Usage</p>
                                    <p class="font-medium">
                                        {{ code.currentUses }} / {{ code.maxUses ?? 1 }}
                                        {% if code.currentUses >= (code.maxUses ?? 1) %}
                                            <span class="badge badge-warning badge-soft badge-xs ml-1">Used</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-xs text-base-content/60">Brokers Linked</p>
                                    <p class="font-medium">{{ stat.broker_count }}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-base-content/60">Expires</p>
                                    <p class="font-medium">
                                        {% if code.expiresAt %}
                                            {{ code.expiresAt|date('M d, Y') }}
                                            {% if code.expiresAt < date() %}
                                                <span class="text-error text-xs">(Expired)</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-base-content/50">Never</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-xs text-base-content/60">Created</p>
                                    <p class="font-medium">{{ code.createdAt|date('M d, Y') }}</p>
                                </div>
                            </div>

                            <div class="pt-1">
                                {% if code.isActive %}
                                    <button type="button"
                                            onclick="showDeactivateModal('{{ code.id }}', '{{ code.code }}')"
                                            class="btn btn-error btn-soft btn-sm w-full">
                                        Deactivate
                                    </button>
                                {% elseif code.currentUses >= (code.maxUses ?? 1) %}
                                    <span class="text-xs text-base-content/50">Used — cannot reactivate</span>
                                {% else %}
                                    <button type="button"
                                            onclick="showReactivateModal('{{ code.id }}', '{{ code.code }}')"
                                            class="btn btn-success btn-soft btn-sm w-full">
                                        Reactivate
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Desktop: Table -->
                <div class="hidden lg:block overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Status</th>
                                <th>Usage</th>
                                <th>Brokers Linked</th>
                                <th>Expires</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for stat in codeStats %}
                                {% set code = stat.code %}
                                <tr class="hover">
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <code class="text-sm font-mono font-semibold bg-base-200 px-2 py-1 rounded-lg">{{ code.code }}</code>
                                            <button type="button"
                                                    onclick="copyToClipboard('{{ code.code }}')"
                                                    class="btn btn-text btn-circle btn-sm"
                                                    title="Copy code">
                                                <span class="icon-[tabler--copy] size-4"></span>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        {% include 'consignee/referral_codes/_code_status_badge.html.twig' with {
                                            code: code,
                                            broker_count: stat.broker_count
                                        } %}
                                    </td>
                                    <td>
                                        {{ code.currentUses }} / {{ code.maxUses ?? 1 }}
                                        {% if code.currentUses >= (code.maxUses ?? 1) %}
                                            <span class="badge badge-warning badge-soft badge-xs ml-1">Used</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ stat.broker_count }}</td>
                                    <td>
                                        {% if code.expiresAt %}
                                            <div class="text-sm">{{ code.expiresAt|date('M d, Y') }}</div>
                                            {% if code.expiresAt < date() %}
                                                <div class="text-xs text-error">Expired</div>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-base-content/50">Never</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="text-sm">{{ code.createdAt|date('M d, Y') }}</div>
                                    </td>
                                    <td class="text-end">
                                        {% if code.isActive %}
                                            <button type="button"
                                                    onclick="showDeactivateModal('{{ code.id }}', '{{ code.code }}')"
                                                    class="btn btn-error btn-soft btn-sm">
                                                Deactivate
                                            </button>
                                        {% elseif code.currentUses >= (code.maxUses ?? 1) %}
                                            <span class="text-xs text-base-content/50">Used — cannot reactivate</span>
                                        {% else %}
                                            <button type="button"
                                                    onclick="showReactivateModal('{{ code.id }}', '{{ code.code }}')"
                                                    class="btn btn-success btn-soft btn-sm">
                                                Reactivate
                                            </button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="card-body items-center text-center py-16">
                    <div class="size-20 bg-base-200 rounded-full flex items-center justify-center mb-6">
                        <span class="icon-[tabler--ticket] size-10 text-base-content/40"></span>
                    </div>
                    <h3 class="text-lg font-bold text-base-content mb-2">No referral codes</h3>
                    <p class="text-sm text-base-content/60 mb-6">Get started by generating your first referral code.</p>
                    <button type="button"
                            onclick="openGenerateModal()"
                            class="btn btn-primary gap-2">
                        <span class="icon-[tabler--plus] size-4"></span>
                        Generate Code
                    </button>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div id="copyToastContainer" class="fixed top-20 end-4 z-[10020] space-y-2 pointer-events-none"></div>
{% endblock %}

{% block app_main_overlays %}
    {% if show_onboarding_guide|default(false) %}
        {% include 'consignee/_onboarding_guide_overlay.html.twig' %}
    {% endif %}
{% endblock %}

{% block page_modals %}
<!-- Generate Code Modal -->
<div id="generateModal"
     class="hidden fixed inset-0 z-[10005] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="generateModalTitle">
    <div id="generateModalBackdrop" class="absolute inset-0 bg-black/60" onclick="closeGenerateModal()"></div>
    <div id="guide-generate-referral-modal" class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10">
        <form method="POST" action="{{ path('consignee_generate_code') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('generate_referral_code') }}">

            <div class="flex justify-between items-center p-6 pb-0">
                <h3 id="generateModalTitle" class="text-lg font-bold">Generate Referral Code</h3>
                <button type="button" onclick="closeGenerateModal()" class="btn btn-text btn-circle btn-sm" aria-label="Close">
                    <span class="icon-[tabler--x] size-5"></span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div class="alert alert-info">
                    <span class="icon-[tabler--info-circle] size-5"></span>
                    <span class="text-sm">Each referral code can only be used once by a single broker. Generate a new code for each broker you want to link with.</span>
                </div>

                <div class="form-control">
                    <label for="expires_at" class="label">
                        <span class="label-text">Expiry Date (Optional)</span>
                    </label>
                    <input type="date"
                           name="expires_at"
                           id="expires_at"
                           min="{{ 'now'|date('Y-m-d') }}"
                           class="input input-bordered w-full">
                    <label class="label">
                        <span class="label-text-alt">Leave empty for no expiration</span>
                    </label>
                </div>
            </div>

            <div class="flex justify-end gap-3 p-6 pt-0">
                <button type="button" onclick="closeGenerateModal()" class="btn btn-ghost">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary gap-2">
                    <span class="icon-[tabler--ticket] size-4"></span>
                    Generate Code
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Deactivate Confirmation Modal -->
<div id="deactivateModal"
     class="hidden fixed inset-0 z-[10005] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeDeactivateModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div class="size-14 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="icon-[tabler--alert-triangle] size-7 text-error"></span>
            </div>
            <h3 class="text-lg font-bold mb-2">Deactivate Referral Code</h3>
            <p class="text-sm text-base-content/70 mb-4">
                Are you sure you want to deactivate this code?
            </p>
            <div class="bg-base-200 rounded-lg p-3 mb-4 text-left">
                <p class="text-xs text-base-content/60 mb-1">Code</p>
                <p id="deactivateCodeDisplay" class="text-lg font-mono font-bold"></p>
            </div>
            <p class="text-xs text-error mb-6">
                This code will no longer be usable by brokers.
            </p>
            <div class="flex gap-3">
                <button type="button"
                        onclick="closeDeactivateModal()"
                        class="btn btn-ghost flex-1">
                    Cancel
                </button>
                <button type="button"
                        onclick="confirmDeactivate()"
                        class="btn btn-error flex-1">
                    Deactivate
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reactivate Confirmation Modal -->
<div id="reactivateModal"
     class="hidden fixed inset-0 z-[10005] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true">
    <div class="absolute inset-0 bg-black/60" onclick="closeReactivateModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-md z-10 p-6">
        <div class="text-center">
            <div class="size-14 bg-success/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="icon-[tabler--circle-check] size-7 text-success"></span>
            </div>
            <h3 class="text-lg font-bold mb-2">Reactivate Referral Code</h3>
            <p class="text-sm text-base-content/70 mb-4">
                Are you sure you want to reactivate this code?
            </p>
            <div class="bg-base-200 rounded-lg p-3 mb-4 text-left">
                <p class="text-xs text-base-content/60 mb-1">Code</p>
                <p id="reactivateCodeDisplay" class="text-lg font-mono font-bold"></p>
            </div>
            <p class="text-xs text-success mb-6">
                This code will become usable again by brokers.
            </p>
            <div class="flex gap-3">
                <button type="button"
                        onclick="closeReactivateModal()"
                        class="btn btn-ghost flex-1">
                    Cancel
                </button>
                <button type="button"
                        onclick="confirmReactivate()"
                        class="btn btn-success flex-1">
                    Reactivate
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Forms -->
<form method="POST" id="deactivateForm" class="hidden">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('deactivate_referral_code') }}">
    <input type="hidden" name="code_id" id="deactivateCodeId">
</form>

<form method="POST" id="reactivateForm" class="hidden">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('reactivate_referral_code') }}">
    <input type="hidden" name="code_id" id="reactivateCodeId">
</form>
{% endblock %}

{% block page_scripts %}
    {{ parent() }}
    {% include 'consignee/_onboarding_guide_scripts.html.twig' %}
    <style>
        #generateModal.guide-backdrop-hidden #generateModalBackdrop {
            background-color: transparent !important;
        }
    </style>
    <script>
    function showToast(message, type) {
        const container = document.getElementById('copyToastContainer');
        if (!container) {
            return;
        }

        const typeClass = type === 'error' ? 'alert-error' : 'alert-success';
        const icon = type === 'error' ? 'icon-[tabler--alert-circle]' : 'icon-[tabler--check]';
        const toast = document.createElement('div');
        toast.className = 'alert ' + typeClass + ' shadow-lg pointer-events-auto';
        toast.innerHTML = '<span class="' + icon + ' size-5"></span><span>' + message + '</span>';
        container.appendChild(toast);

        window.setTimeout(function () {
            toast.remove();
        }, 2500);
    }

    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function () {
            showToast('Code copied to clipboard!', 'success');
        }, function (err) {
            console.error('Could not copy text: ', err);
            showToast('Could not copy code', 'error');
        });
    }

    function openModal(id) {
        const modal = document.getElementById(id);
        if (!modal) {
            return;
        }
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        if (!modal) {
            return;
        }
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    function openGenerateModal() {
        openModal('generateModal');
    }

    function closeGenerateModal() {
        closeModal('generateModal');
    }

    function showDeactivateModal(codeId, codeText) {
        document.getElementById('deactivateCodeId').value = codeId;
        document.getElementById('deactivateCodeDisplay').textContent = codeText;
        document.getElementById('deactivateForm').action = '{{ path('consignee_deactivate_code', {id: '__ID__'}) }}'.replace('__ID__', codeId);
        openModal('deactivateModal');
    }

    function closeDeactivateModal() {
        closeModal('deactivateModal');
    }

    function confirmDeactivate() {
        document.getElementById('deactivateForm').submit();
    }

    function showReactivateModal(codeId, codeText) {
        document.getElementById('reactivateCodeId').value = codeId;
        document.getElementById('reactivateCodeDisplay').textContent = codeText;
        document.getElementById('reactivateForm').action = '{{ path('consignee_reactivate_code', {id: '__ID__'}) }}'.replace('__ID__', codeId);
        openModal('reactivateModal');
    }

    function closeReactivateModal() {
        closeModal('reactivateModal');
    }

    function confirmReactivate() {
        document.getElementById('reactivateForm').submit();
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeGenerateModal();
            closeDeactivateModal();
            closeReactivateModal();
        }
    });
    </script>
{% endblock %}
