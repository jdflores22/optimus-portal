{% extends 'base.html.twig' %}

{% block title %}My Brokers - OPTIMUS{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200">
    <div class="bg-base-100 shadow-sm">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-base-content">My Brokers</h1>
                    <p class="text-sm text-base-content/60 mt-1">Manage linked brokers and referral codes</p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right hidden sm:block">
                        <p class="text-xs text-base-content/60">Total Brokers</p>
                        <p class="text-xl font-bold">{{ totalBrokers }}</p>
                    </div>
                    <button type="button"
                            id="guide-generate-new-code"
                            onclick="openGenerateModal()"
                            class="btn btn-primary gap-2">
                        <span class="icon-[tabler--plus] size-5"></span>
                        Generate New Code
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <span class="icon-[tabler--check] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <span class="icon-[tabler--alert-circle] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">
                    <div class="flex items-center gap-4">
                        <div class="avatar placeholder">
                            <div class="size-12 bg-success/20 text-success rounded-lg flex items-center justify-center">
                                <span class="icon-[tabler--circle-check] size-6"></span>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-base-content/60">Active Brokers</p>
                            <p class="text-2xl font-bold">{{ activeCount }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">
                    <div class="flex items-center gap-4">
                        <div class="avatar placeholder">
                            <div class="size-12 bg-error/20 text-error rounded-lg flex items-center justify-center">
                                <span class="icon-[tabler--alert-triangle] size-6"></span>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-base-content/60">Suspended Brokers</p>
                            <p class="text-2xl font-bold">{{ suspendedCount }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% include 'consignee/referral_codes/_section.html.twig' %}

        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title">Active Brokers</h2>

                {% if activeBrokers|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
                        {% for brokerData in activeBrokers %}
                            <div class="card card-compact bg-base-100 shadow hover:shadow-lg transition-all">
                                <div class="card-body">
                                    <div class="flex items-start justify-between mb-3">
                                        <div class="flex items-center">
                                            <div class="avatar placeholder">
                                                <div class="size-10 bg-primary/20 text-primary rounded-full flex items-center justify-center">
                                                    <span class="font-semibold text-sm">
                                                        {{ brokerData.broker.fullName|slice(0, 2)|upper }}
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="ml-3">
                                                <h3 class="text-sm font-semibold">{{ brokerData.broker.fullName }}</h3>
                                                <span class="badge badge-success badge-sm">Active</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="space-y-2 mb-3">
                                        <div class="flex items-center text-sm">
                                            <span class="icon-[tabler--mail] size-4 mr-2 text-base-content/60"></span>
                                            <a href="mailto:{{ brokerData.broker.email }}" class="link link-primary">
                                                {{ brokerData.broker.email }}
                                            </a>
                                        </div>
                                        <div class="flex items-center text-xs text-base-content/70">
                                            <span class="icon-[tabler--file-text] size-4 mr-2"></span>
                                            {{ brokerData.manifestCount }} manifest(s) assigned
                                        </div>
                                        <div class="flex items-center text-xs text-base-content/70">
                                            <span class="icon-[tabler--calendar] size-4 mr-2"></span>
                                            Linked since {{ brokerData.relationship.createdAt|date('M j, Y') }}
                                        </div>
                                    </div>

                                    <div class="divider my-2"></div>

                                    <div class="text-xs text-base-content/60">
                                        <strong>Contact:</strong> Click email above to send message
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-12">
                        <div class="size-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="icon-[tabler--users] size-8 text-base-content/40"></span>
                        </div>
                        <h3 class="text-sm font-medium">No active brokers</h3>
                        <p class="mt-1 text-sm text-base-content/60">Generate a referral code and share it with a broker to link.</p>
                        <div class="mt-6">
                            <button type="button" onclick="openGenerateModal()" class="btn btn-primary gap-2">
                                <span class="icon-[tabler--plus] size-5"></span>
                                Generate Referral Code
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {% if suspendedBrokers|length > 0 %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <div class="alert alert-error mb-4">
                    <span class="icon-[tabler--alert-triangle] size-5"></span>
                    <div>
                        <h3 class="font-bold">Suspended Brokers</h3>
                        <div class="text-sm">These brokers are currently suspended and cannot be assigned to new manifests</div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for brokerData in suspendedBrokers %}
                        <div class="card card-compact bg-error/5 shadow">
                            <div class="card-body">
                                <div class="flex items-start justify-between mb-3">
                                    <div class="flex items-center">
                                        <div class="avatar placeholder">
                                            <div class="size-10 bg-error/20 text-error rounded-full flex items-center justify-center">
                                                <span class="icon-[tabler--alert-triangle] size-5"></span>
                                            </div>
                                        </div>
                                        <div class="ml-3">
                                            <h3 class="text-sm font-semibold">{{ brokerData.broker.fullName }}</h3>
                                            <span class="badge badge-error badge-sm">Suspended</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="space-y-2 mb-3">
                                    <div class="flex items-center text-sm">
                                        <span class="icon-[tabler--mail] size-4 mr-2 text-base-content/60"></span>
                                        <a href="mailto:{{ brokerData.broker.email }}" class="link link-primary">
                                            {{ brokerData.broker.email }}
                                        </a>
                                    </div>
                                    <div class="flex items-center text-xs text-base-content/70">
                                        <span class="icon-[tabler--file-text] size-4 mr-2"></span>
                                        {{ brokerData.manifestCount }} manifest(s) assigned
                                    </div>
                                </div>

                                {% if brokerData.manifestCount > 0 %}
                                <div class="divider my-2"></div>
                                <div class="alert alert-warning py-2">
                                    <span class="icon-[tabler--info-circle] size-4"></span>
                                    <span class="text-xs">Transfer manifests to another broker</span>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<div id="copyToastContainer" class="fixed top-20 end-4 z-[10020] space-y-2 pointer-events-none"></div>
{% endblock %}

{% block app_main_overlays %}
    {% if show_onboarding_guide|default(false) %}
        {% include 'consignee/_onboarding_guide_overlay.html.twig' %}
    {% endif %}
{% endblock %}

{% block page_modals %}
    {% include 'consignee/referral_codes/_modals.html.twig' %}
{% endblock %}

{% block page_scripts %}
    {{ parent() }}
    {% if show_onboarding_guide|default(false) %}
        {% include 'consignee/_onboarding_guide_scripts.html.twig' %}
    {% endif %}
    {% include 'consignee/referral_codes/_scripts.html.twig' %}
{% endblock %}
