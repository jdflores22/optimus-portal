{% extends 'base.html.twig' %}

{% block title %}Manifest {{ manifest.manifestNumber }} - OPTIMUS{% endblock %}

{% block body %}
{% set noa = manifest.noa %}
{% set state = manifest.workflowState %}
{% set currentStep = manifest_workflow_current_step(manifest) %}
{% set workflowComplete = manifest_workflow_is_complete(manifest) %}

<div class="min-h-screen bg-base-200">
    {# Page header #}
    <div class="bg-base-100 border-b border-base-content/10 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5">
            <a href="{{ path('consignee_manifest_list') }}"
               class="inline-flex items-center gap-1.5 text-sm text-base-content/60 hover:text-primary mb-3">
                <span class="icon-[tabler--arrow-left] size-4"></span>
                Back to Manifests
            </a>

            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0 space-y-2">
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="text-xl sm:text-2xl font-bold text-base-content">{{ manifest.manifestNumber }}</h1>
                        {% if state.value == 'edo_released' %}
                            <span class="badge badge-success gap-1">
                                <span class="icon-[tabler--circle-check] size-3.5"></span>
                                {{ state.getDisplayName() }}
                            </span>
                        {% elseif state.value in ['billing_generated', 'payment_submitted'] %}
                            <span class="badge badge-warning">{{ state.getDisplayName() }}</span>
                        {% elseif state.value in ['bl_generated', 'bl_uploaded', 'edo_generated'] %}
                            <span class="badge badge-info">{{ state.getDisplayName() }}</span>
                        {% elseif state.value == 'noa_generated' %}
                            <span class="badge badge-primary">{{ state.getDisplayName() }}</span>
                        {% else %}
                            <span class="badge badge-ghost">{{ state.getDisplayName() }}</span>
                        {% endif %}
                    </div>
                    <p class="text-sm text-base-content/60">
                        Read-only manifest view. Contact your broker for updates or actions.
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2 shrink-0">
                    <a href="{{ path('consignee_manifest_documents', {id: manifest.id}) }}"
                       class="btn btn-outline btn-primary btn-sm gap-2">
                        <span class="icon-[tabler--folder] size-4"></span>
                        All Documents
                    </a>
                    <button type="button"
                            class="btn btn-primary btn-sm gap-2"
                            aria-haspopup="dialog"
                            aria-controls="broker-assignment-modal"
                            onclick="openBrokerAssignmentModal()">
                        <span class="icon-[tabler--user-plus] size-4"></span>
                        {% if manifest.broker %}
                            Change Broker
                        {% else %}
                            Assign Broker
                        {% endif %}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        <div class="alert alert-info mb-6">
            <span class="icon-[tabler--info-circle] size-5 shrink-0"></span>
            <span class="text-sm">You have read-only access to this manifest. Your broker handles workflow actions on your behalf.</span>
        </div>

        {% if pendingTransferRequest %}
            <div class="alert alert-warning mb-6">
                <span class="icon-[tabler--clock] size-5 shrink-0"></span>
                <div class="text-sm">
                    <p class="font-medium">Broker transfer pending approval</p>
                    <p class="text-base-content/70 mt-0.5">Your request is awaiting admin review. The current broker remains assigned until approved.</p>
                </div>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 items-start">
            {# Main column #}
            <div class="lg:col-span-2 space-y-4 sm:space-y-6 min-w-0">
                {# Workflow progress #}
                <div class="card card-border bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex items-center justify-between gap-3 mb-5">
                            <h2 class="card-title text-base sm:text-lg">Workflow Progress</h2>
                            {% if workflowComplete %}
                                <span class="badge badge-success badge-sm gap-1">
                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                    Complete
                                </span>
                            {% else %}
                                <span class="badge badge-soft badge-primary badge-sm">Step {{ currentStep }} of {{ manifest_workflow_total_steps() }}</span>
                            {% endif %}
                        </div>
                        <div class="overflow-x-auto pb-1">
                            {% include 'components/flyonui_stepper.html.twig' with {
                                steps: [
                                    { label: 'NOA' },
                                    { label: 'BL Gen' },
                                    { label: 'BL Upload' },
                                    { label: 'Billing' },
                                    { label: 'Payment' },
                                    { label: 'Validate' },
                                    { label: 'eDO' },
                                    { label: 'Release' }
                                ],
                                current: workflowComplete ? manifest_workflow_total_steps() + 1 : currentStep
                            } %}
                        </div>
                    </div>
                </div>

                {# Manifest information #}
                <div class="card card-border bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-6">
                        <h2 class="card-title text-base sm:text-lg mb-4">Manifest Information</h2>
                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Manifest Number</dt>
                                <dd class="mt-1 text-sm font-mono text-base-content">{{ manifest.manifestNumber }}</dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Created Date</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.createdAt|date('M j, Y g:i A') }}</dd>
                            </div>
                            {% if manifest.vesselName %}
                                <div>
                                    <dt class="text-sm font-medium text-base-content/60">Vessel Name</dt>
                                    <dd class="mt-1 text-sm text-base-content">{{ manifest.vesselName }}</dd>
                                </div>
                            {% endif %}
                            {% if manifest.voyageNumber %}
                                <div>
                                    <dt class="text-sm font-medium text-base-content/60">Voyage Number</dt>
                                    <dd class="mt-1 text-sm text-base-content">{{ manifest.voyageNumber }}</dd>
                                </div>
                            {% endif %}
                            {% if manifest.arrivalDate %}
                                <div>
                                    <dt class="text-sm font-medium text-base-content/60">Arrival Date</dt>
                                    <dd class="mt-1 text-sm text-base-content">{{ manifest.arrivalDate|date('M j, Y g:i A') }}</dd>
                                </div>
                            {% endif %}
                            {% if manifest.blNumber %}
                                <div>
                                    <dt class="text-sm font-medium text-base-content/60">BL Number</dt>
                                    <dd class="mt-1 text-sm text-base-content">{{ manifest.blNumber }}</dd>
                                </div>
                            {% endif %}
                        </dl>
                    </div>
                </div>

                {# Parties #}
                <div class="card card-border bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-6">
                        <h2 class="card-title text-base sm:text-lg mb-4">Parties</h2>
                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Consignee</dt>
                                <dd class="mt-1 text-sm font-medium text-base-content">
                                    {% if manifest.consignee %}
                                        {{ manifest.consignee.businessName }}
                                    {% else %}
                                        <span class="text-base-content/40">Not declared</span>
                                    {% endif %}
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Broker</dt>
                                <dd class="mt-1 text-sm font-medium text-base-content">
                                    {% if manifest.broker %}
                                        {{ manifest.broker.fullName }}
                                        {% if manifest.broker.email %}
                                            <a href="mailto:{{ manifest.broker.email }}" class="link link-primary block text-xs mt-0.5 font-normal">
                                                {{ manifest.broker.email }}
                                            </a>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-base-content/40">None assigned</span>
                                    {% endif %}
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                {# Containers #}
                {% if noa and noa.containers|length > 0 %}
                    <div class="card card-border bg-base-100 shadow-sm">
                        <div class="card-body p-4 sm:p-6">
                            <div class="flex items-center justify-between gap-3 mb-4">
                                <h2 class="card-title text-base sm:text-lg">Containers</h2>
                                <span class="badge badge-soft badge-info badge-sm">
                                    {{ noa.containers|length }} container{{ noa.containers|length != 1 ? 's' : '' }}
                                </span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                {% for container in noa.containers %}
                                    <div class="rounded-xl border border-base-content/10 bg-base-200/40 p-4">
                                        <div class="flex items-center gap-3">
                                            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-base-100 text-base-content/60">
                                                <span class="icon-[tabler--box] size-5"></span>
                                            </span>
                                            <div class="min-w-0">
                                                <div class="font-mono text-sm font-bold text-base-content">{{ container.containerNumber }}</div>
                                                <div class="text-xs text-base-content/60 mt-0.5">
                                                    {{ container.containerSize ? container.containerSize.name : 'N/A' }}
                                                    ·
                                                    {{ container.containerType ? container.containerType.name : 'N/A' }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Payment history #}
                <div class="card card-border bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-6">
                        <h2 class="card-title text-base sm:text-lg mb-4">Payment History</h2>
                        {% set hasFinalPayment = false %}
                        {% for payment in manifest.payments %}
                            {% if payment.paymentType.value == 'final_payment' %}
                                {% set hasFinalPayment = true %}
                            {% endif %}
                        {% endfor %}

                        {% if hasFinalPayment or (manifest.edo and manifest.edo.edoPayment) %}
                            <div class="space-y-3">
                                {% for payment in manifest.payments %}
                                    {% if payment.paymentType.value == 'final_payment' %}
                                        <div class="rounded-xl border border-base-content/10 bg-base-200/40 p-4">
                                            <div class="flex items-center justify-between gap-2 mb-2">
                                                <span class="text-sm font-medium text-base-content">Final Payment</span>
                                                {% if payment.status.value == 'verified' %}
                                                    <span class="badge badge-success badge-sm">Verified</span>
                                                {% elseif payment.status.value == 'rejected' %}
                                                    <span class="badge badge-error badge-sm">Rejected</span>
                                                {% else %}
                                                    <span class="badge badge-warning badge-sm">Pending</span>
                                                {% endif %}
                                            </div>
                                            <p class="text-sm text-base-content/70">Amount: {{ payment|format_payment }}</p>
                                            <p class="text-xs text-base-content/60 mt-1">Submitted: {{ payment.createdAt|date('M j, Y g:i A') }}</p>
                                            {% if payment.status.value == 'rejected' and payment.rejectionReason %}
                                                <div class="mt-2 rounded-lg border border-error/20 bg-error/10 p-2 text-xs text-error">
                                                    Reason: {{ payment.rejectionReason }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% endfor %}

                                {% if manifest.edo and manifest.edo.edoPayment %}
                                    <div class="rounded-xl border border-base-content/10 bg-base-200/40 p-4">
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <span class="text-sm font-medium text-base-content">eDO Access Payment</span>
                                            {% if manifest.edo.edoPayment.status.value == 'verified' %}
                                                <span class="badge badge-success badge-sm">Paid</span>
                                            {% elseif manifest.edo.edoPayment.status.value == 'rejected' %}
                                                <span class="badge badge-error badge-sm">Rejected</span>
                                            {% else %}
                                                <span class="badge badge-warning badge-sm">Pending Validation</span>
                                            {% endif %}
                                        </div>
                                        <p class="text-sm text-base-content/70">Amount: {{ manifest.edo.edoPayment.amount|format_money('PHP') }}</p>
                                        <p class="text-xs text-base-content/60 mt-1">Submitted: {{ manifest.edo.edoPayment.createdAt|date('M j, Y g:i A') }}</p>
                                        {% if manifest.edo.edoPayment.status.value == 'verified' and manifest.edo.edoPayment.validatedAt %}
                                            <p class="text-xs text-base-content/60 mt-1">Validated: {{ manifest.edo.edoPayment.validatedAt|date('M j, Y g:i A') }}</p>
                                        {% endif %}
                                        {% if manifest.edo.edoPayment.status.value == 'rejected' and manifest.edo.edoPayment.rejectionReason %}
                                            <div class="mt-2 rounded-lg border border-error/20 bg-error/10 p-2 text-xs text-error">
                                                Reason: {{ manifest.edo.edoPayment.rejectionReason }}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="flex flex-col items-center justify-center py-10 text-base-content/40 gap-2">
                                <span class="icon-[tabler--receipt-off] size-10"></span>
                                <p class="text-sm">No payments submitted yet</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Documents #}
                <div class="card card-border bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex items-center justify-between gap-3 mb-4">
                            <h2 class="card-title text-base sm:text-lg">Available Documents</h2>
                            <a href="{{ path('consignee_manifest_documents', {id: manifest.id}) }}" class="btn btn-ghost btn-sm gap-1">
                                <span class="icon-[tabler--folder] size-4"></span>
                                View all
                            </a>
                        </div>

                        <div class="space-y-2 sm:space-y-3">
                            {% if (noa and noa.pdfPath) or (manifest.noaDocument and manifest.noaDocument.pdfPath) %}
                                <div class="flex items-center justify-between gap-3 rounded-xl bg-primary/10 p-3 hover:bg-primary/15 transition-colors">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-content">
                                            <span class="icon-[tabler--file-text] size-5"></span>
                                        </span>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium text-base-content truncate">Notice of Arrival (NOA)</span>
                                                <span class="icon-[tabler--circle-check] size-4 text-success shrink-0"></span>
                                            </div>
                                            <p class="text-xs text-base-content/60 truncate">{{ noa ? noa.noaNumber : manifest.noaDocument.noaNumber }}</p>
                                        </div>
                                    </div>
                                    <a href="{{ path('api_noa_download', {noaNumber: noa ? noa.noaNumber : manifest.noaDocument.noaNumber}) }}"
                                       target="_blank"
                                       class="btn btn-primary btn-sm btn-soft gap-1 shrink-0">
                                        <span class="icon-[tabler--download] size-4"></span>
                                        Download
                                    </a>
                                </div>
                            {% endif %}

                            {% if noa and (noa.manifestPdfPath or manifest.manifestFilePath) %}
                                <div class="flex items-center justify-between gap-3 rounded-xl bg-info/10 p-3 hover:bg-info/15 transition-colors">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-info text-info-content">
                                            <span class="icon-[tabler--file-description] size-5"></span>
                                        </span>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium text-base-content truncate">Manifest/BL Document</span>
                                                <span class="icon-[tabler--circle-check] size-4 text-success shrink-0"></span>
                                            </div>
                                            <p class="text-xs text-base-content/60 truncate">{{ manifest.manifestNumber }}</p>
                                        </div>
                                    </div>
                                    <a href="{{ path('api_manifest_download_by_id', {manifestId: manifest.id}) }}"
                                       target="_blank"
                                       class="btn btn-info btn-sm btn-soft gap-1 shrink-0">
                                        <span class="icon-[tabler--download] size-4"></span>
                                        Download
                                    </a>
                                </div>
                            {% endif %}

                            {% if manifest.blNumber and manifest.blFilePath %}
                                <div class="flex items-center justify-between gap-3 rounded-xl bg-base-200/80 p-3 hover:bg-base-300/60 transition-colors">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-info text-info-content">
                                            <span class="icon-[tabler--file] size-5"></span>
                                        </span>
                                        <div class="min-w-0">
                                            <p class="text-sm font-medium text-base-content truncate">Bill of Lading</p>
                                            <p class="text-xs text-base-content/60 truncate">{{ manifest.blNumber }}</p>
                                        </div>
                                    </div>
                                    <a href="/api/bl/{{ manifest.blNumber }}/download"
                                       target="_blank"
                                       class="btn btn-info btn-sm btn-soft gap-1 shrink-0">
                                        <span class="icon-[tabler--download] size-4"></span>
                                        Download
                                    </a>
                                </div>
                            {% endif %}

                            {% if manifest.billing %}
                                <div class="flex items-center justify-between gap-3 rounded-xl bg-warning/10 p-3 hover:bg-warning/15 transition-colors">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-warning text-warning-content">
                                            <span class="icon-[tabler--receipt] size-5"></span>
                                        </span>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium text-base-content truncate">Billing Document</span>
                                                <span class="icon-[tabler--circle-check] size-4 text-success shrink-0"></span>
                                            </div>
                                            <p class="text-xs text-base-content/60 truncate">Total: {{ manifest.billing|format_billing }}</p>
                                        </div>
                                    </div>
                                    <a href="/api/billing/{{ manifest.billing.id }}/download"
                                       target="_blank"
                                       class="btn btn-warning btn-sm btn-soft gap-1 shrink-0">
                                        <span class="icon-[tabler--download] size-4"></span>
                                        Download
                                    </a>
                                </div>
                            {% endif %}

                            {% set finalPayment = null %}
                            {% for payment in manifest.payments %}
                                {% if payment.paymentType.value == 'final_payment' and payment.status.value == 'verified' %}
                                    {% set finalPayment = payment %}
                                {% endif %}
                            {% endfor %}

                            {% if finalPayment and finalPayment.officialReceiptPath %}
                                <div class="flex items-center justify-between gap-3 rounded-xl bg-success/10 p-3 hover:bg-success/15 transition-colors">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-success text-success-content">
                                            <span class="icon-[tabler--file-check] size-5"></span>
                                        </span>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-medium text-base-content truncate">Official Receipt</span>
                                                <span class="icon-[tabler--circle-check] size-4 text-success shrink-0"></span>
                                            </div>
                                            <p class="text-xs text-base-content/60 truncate">Payment verified — OR issued</p>
                                        </div>
                                    </div>
                                    <a href="{{ finalPayment.officialReceiptPath }}"
                                       target="_blank"
                                       class="btn btn-success btn-sm btn-soft gap-1 shrink-0">
                                        <span class="icon-[tabler--download] size-4"></span>
                                        Download
                                    </a>
                                </div>
                            {% endif %}

                            {% if manifest.edo %}
                                <div class="flex items-center justify-between gap-3 rounded-xl bg-base-200/80 p-3">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-success text-success-content">
                                            <span class="icon-[tabler--shield-check] size-5"></span>
                                        </span>
                                        <div class="min-w-0">
                                            <p class="text-sm font-medium text-base-content truncate">Electronic Delivery Order</p>
                                            <p class="text-xs text-base-content/60 truncate">{{ manifest.edo.edoNumber }}</p>
                                            {% if manifest.edo.expiresAt %}
                                                <p class="text-xs text-base-content/60 mt-0.5">Expires: {{ manifest.edo.expiresAt|date('M d, Y H:i') }}</p>
                                            {% endif %}
                                            {% if manifest.edo.status.value == 'pending_release' %}
                                                <span class="badge badge-warning badge-xs mt-1">Pending release</span>
                                            {% elseif manifest.edo.status.value == 'rejected' %}
                                                <span class="badge badge-error badge-xs mt-1">Rejected</span>
                                            {% elseif not manifest.edo.edoPayment %}
                                                <span class="badge badge-warning badge-xs mt-1">Payment required</span>
                                            {% elseif manifest.edo.edoPayment.status.value == 'pending_validation' %}
                                                <span class="badge badge-warning badge-xs mt-1">Payment pending</span>
                                            {% elseif manifest.edo.edoPayment.status.value == 'rejected' %}
                                                <span class="badge badge-error badge-xs mt-1">Payment rejected</span>
                                            {% elseif manifest.edo.edoPayment.status.value == 'verified' and manifest.edo.status.value == 'released' %}
                                                <span class="badge badge-success badge-xs mt-1">Ready</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% if manifest.edo.status.value == 'released' and manifest.edo.edoPayment and manifest.edo.edoPayment.status.value == 'verified' %}
                                        <a href="/api/edos/{{ manifest.edo.edoNumber }}/download"
                                           target="_blank"
                                           class="btn btn-success btn-sm btn-soft gap-1 shrink-0">
                                            <span class="icon-[tabler--download] size-4"></span>
                                            Download
                                        </a>
                                    {% else %}
                                        <span class="text-xs text-base-content/40 shrink-0">Not available</span>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if not noa and not manifest.blNumber and not manifest.billing and not manifest.edo %}
                                <div class="flex flex-col items-center justify-center py-10 text-base-content/40 gap-2">
                                    <span class="icon-[tabler--file-off] size-10"></span>
                                    <p class="text-sm">No documents available yet</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# Sidebar #}
            <div class="lg:col-span-1 space-y-4 sm:space-y-6">
                <div class="card card-border bg-base-100 shadow-sm lg:sticky lg:top-20">
                    <div class="card-body p-4 sm:p-6">
                        <h2 class="card-title text-base sm:text-lg mb-4">Current Status</h2>

                        {% if workflowComplete %}
                            <div class="alert alert-success">
                                <span class="icon-[tabler--circle-check] size-5 shrink-0"></span>
                                <div class="text-sm">
                                    <p class="font-medium">Workflow complete</p>
                                    <p class="text-xs mt-1 text-base-content/70">All steps finished successfully.</p>
                                </div>
                            </div>
                        {% else %}
                            <div class="alert alert-info">
                                <span class="icon-[tabler--clock] size-5 shrink-0"></span>
                                <p class="text-sm">Workflow in progress. Your broker will handle required actions.</p>
                            </div>
                        {% endif %}

                        <div class="divider my-4"></div>

                        {% if manifest.broker %}
                            <div class="space-y-1">
                                <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Assigned Broker</p>
                                <p class="text-sm font-semibold text-base-content">{{ manifest.broker.fullName }}</p>
                                {% if manifest.broker.email %}
                                    <a href="mailto:{{ manifest.broker.email }}" class="link link-primary text-sm">
                                        {{ manifest.broker.email }}
                                    </a>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="alert alert-warning">
                                <span class="icon-[tabler--alert-triangle] size-5 shrink-0"></span>
                                <p class="text-sm">No broker assigned yet. Use <strong>Assign Broker</strong> above to get started.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_modals %}
<div id="broker-assignment-modal"
     class="hidden fixed inset-0 z-[10005] flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="broker-assignment-modal-title">
    <div class="absolute inset-0 bg-black/60" onclick="closeBrokerAssignmentModal()"></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-2xl z-10">
        <form action="{{ path('consignee_request_broker_transfer') }}" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('request_broker_transfer') }}">
            <input type="hidden" name="manifest_id" value="{{ manifest.id }}">

            <div class="flex justify-between items-center p-6 pb-0">
                <h3 id="broker-assignment-modal-title" class="text-lg font-bold">
                    {% if manifest.broker %}Change Broker{% else %}Assign Broker{% endif %}
                </h3>
                <button type="button"
                        onclick="closeBrokerAssignmentModal()"
                        class="btn btn-text btn-circle btn-sm"
                        aria-label="Close">
                    <span class="icon-[tabler--x] size-5"></span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                {% if manifest.broker %}
                    <div class="alert alert-info">
                        <span class="icon-[tabler--info-circle] size-5 shrink-0"></span>
                        <p class="text-sm">Changing the broker requires admin approval. The current broker remains assigned until the transfer is approved.</p>
                    </div>
                {% endif %}

                <div class="form-control w-full">
                    <label class="label pb-1" for="new_broker_id">
                        <span class="label-text font-medium">Select Broker <span class="text-error">*</span></span>
                    </label>
                    <select name="new_broker_id" id="new_broker_id" required class="select select-bordered w-full">
                        <option value="">Choose a broker...</option>
                        {% for relationship in availableBrokers %}
                            <option value="{{ relationship.broker.id }}"
                                    {% if manifest.broker and manifest.broker.id == relationship.broker.id %}disabled{% endif %}>
                                {{ relationship.broker.fullName }} ({{ relationship.broker.email }})
                                {% if manifest.broker and manifest.broker.id == relationship.broker.id %}(Current){% endif %}
                            </option>
                        {% endfor %}
                    </select>
                    <label class="label pt-1">
                        <span class="label-text-alt text-base-content/60">
                            {% if availableBrokers|length == 0 %}
                                No brokers available. Please link a broker first.
                            {% else %}
                                Only active brokers linked to your account are shown.
                            {% endif %}
                        </span>
                    </label>
                </div>

                <div class="form-control w-full">
                    <label class="label pb-1" for="broker_transfer_reason">
                        <span class="label-text font-medium">Reason <span class="text-error">*</span></span>
                    </label>
                    <textarea name="reason"
                              id="broker_transfer_reason"
                              required
                              rows="3"
                              placeholder="Explain why you are {% if manifest.broker %}changing{% else %}assigning{% endif %} the broker..."
                              class="textarea textarea-bordered w-full"></textarea>
                </div>

                {% if manifest.broker %}
                    <div class="form-control w-full">
                        <label class="label pb-1" for="transfer_letter">
                            <span class="label-text font-medium">Transfer Letter (Optional)</span>
                        </label>
                        <input type="file"
                               name="transfer_letter"
                               id="transfer_letter"
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                               class="file-input file-input-bordered w-full">
                        <label class="label pt-1">
                            <span class="label-text-alt text-base-content/60">PDF, DOC, DOCX, JPG, PNG (max 5MB)</span>
                        </label>
                    </div>
                {% endif %}
            </div>

            <div class="flex justify-end gap-3 p-6 pt-0">
                <button type="button" onclick="closeBrokerAssignmentModal()" class="btn btn-ghost">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary gap-2" {% if availableBrokers|length == 0 or pendingTransferRequest %}disabled{% endif %}>
                    <span class="icon-[tabler--check] size-4"></span>
                    {% if pendingTransferRequest %}
                        Transfer Pending
                    {% elseif manifest.broker %}
                        Request Transfer
                    {% else %}
                        Assign Broker
                    {% endif %}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
    {{ parent() }}
    <script>
        function openBrokerAssignmentModal() {
            const modal = document.getElementById('broker-assignment-modal');
            if (!modal) {
                return;
            }
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeBrokerAssignmentModal() {
            const modal = document.getElementById('broker-assignment-modal');
            if (!modal) {
                return;
            }
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeBrokerAssignmentModal();
            }
        });
    </script>
{% endblock %}
