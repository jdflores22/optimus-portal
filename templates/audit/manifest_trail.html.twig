{% extends 'base.html.twig' %}

{% block title %}Audit Trail — {{ manifest.manifestNumber }}{% endblock %}
{% block page_title %}Audit Trail{% endblock %}

{% macro action_icon(action) %}
    {% if action == 'state_transition' %}
        <span class="icon-[tabler--arrow-right] size-5"></span>
    {% elseif action in ['payment_verification', 'payment_submission', 'payment_resubmission'] %}
        <span class="icon-[tabler--credit-card] size-5"></span>
    {% elseif action starts with 'edo_payment_' %}
        <span class="icon-[tabler--receipt] size-5"></span>
    {% elseif action == 'document_upload' %}
        <span class="icon-[tabler--upload] size-5"></span>
    {% elseif action == 'document_download' %}
        <span class="icon-[tabler--download] size-5"></span>
    {% else %}
        <span class="icon-[tabler--activity] size-5"></span>
    {% endif %}
{% endmacro %}

{% macro action_color(action) %}
    {% if action == 'state_transition' %}bg-info/15 text-info ring-info/20
    {% elseif action in ['payment_verification', 'edo_payment_approved'] %}bg-success/15 text-success ring-success/20
    {% elseif action in ['payment_submission', 'payment_resubmission', 'edo_payment_submitted'] %}bg-warning/15 text-warning ring-warning/20
    {% elseif action in ['edo_payment_rejected'] %}bg-error/15 text-error ring-error/20
    {% elseif action == 'document_upload' %}bg-secondary/15 text-secondary ring-secondary/20
    {% elseif action == 'document_download' %}bg-base-content/10 text-base-content/70 ring-base-content/10
    {% else %}bg-warning/15 text-warning ring-warning/20{% endif %}
{% endmacro %}

{% set hasFilters = filters.action_type or filters.user_id or filters.date_from or filters.date_to %}

{% block body %}
<div class="space-y-5 sm:space-y-6 max-w-6xl mx-auto">

    {# Header #}
    <div class="bg-base-100 shadow-sm rounded-xl">
        <div class="p-4 sm:p-6">
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-2">
                        <ul>
                            <li><a href="{{ manifest_workflow_detail_path(manifest) }}">{{ manifest.manifestNumber }}</a></li>
                            <li>Audit trail</li>
                        </ul>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="size-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--history] size-6"></span>
                        </div>
                        <div class="min-w-0">
                            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">Audit Trail</h1>
                            <p class="text-sm text-base-content/60 mt-1">
                                Workflow, payment, and eDO activity for manifest <span class="font-medium text-base-content">{{ manifest.manifestNumber }}</span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2 shrink-0">
                    {% if is_granted('ROLE_SYSTEM_ADMIN') %}
                        <div class="dropdown">
                            <button type="button" tabindex="0" class="btn btn-ghost btn-sm gap-2">
                                <span class="icon-[tabler--download] size-4"></span>
                                Export
                                <span class="icon-[tabler--chevron-down] size-4"></span>
                            </button>
                            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-xl shadow-lg z-20 w-44 p-2 mt-1">
                                <li><a href="{{ path('audit_trail_export', {id: manifest.id, format: 'csv'}) }}">CSV file</a></li>
                                <li><a href="{{ path('audit_trail_export', {id: manifest.id, format: 'json'}) }}">JSON file</a></li>
                                <li><a href="{{ path('audit_trail_export', {id: manifest.id, format: 'pdf'}) }}">PDF report</a></li>
                            </ul>
                        </div>
                    {% endif %}
                    <a href="{{ manifest_workflow_detail_path(manifest) }}" class="btn btn-primary btn-sm gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to manifest
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Filters #}
    <div class="card bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 py-4 bg-base-200/50 rounded-t-xl flex items-center justify-between gap-3">
            <h2 class="font-semibold text-base-content flex items-center gap-2">
                <span class="icon-[tabler--filter] size-5 text-base-content/70"></span>
                Filter activity
            </h2>
            {% if hasFilters %}
                <a href="{{ path('audit_trail_manifest', {id: manifest.id}) }}" class="btn btn-ghost btn-xs gap-1">
                    <span class="icon-[tabler--x] size-3.5"></span>
                    Clear
                </a>
            {% endif %}
        </div>
        <div class="card-body p-4 sm:p-6">
            <form method="get" action="{{ path('audit_trail_manifest', {id: manifest.id}) }}" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="form-control">
                    <label class="label py-1" for="action_type"><span class="label-text text-xs font-medium">Action type</span></label>
                    <select name="action_type" id="action_type" class="select w-full bg-base-200/50 focus:outline-none focus:ring-2 focus:ring-primary/30">
                        <option value="">All actions</option>
                        {% for actionType in actionTypes %}
                            <option value="{{ actionType }}" {% if filters.action_type == actionType %}selected{% endif %}>
                                {{ actionType|replace({'_': ' '})|title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-control">
                    <label class="label py-1" for="user_id"><span class="label-text text-xs font-medium">User</span></label>
                    <select name="user_id" id="user_id" class="select w-full bg-base-200/50 focus:outline-none focus:ring-2 focus:ring-primary/30">
                        <option value="">All users</option>
                        {% for user in users %}
                            <option value="{{ user.id }}" {% if filters.user_id == user.id %}selected{% endif %}>
                                {{ user.fullName ?? user.email }} ({{ user.role.value }})
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-control">
                    <label class="label py-1" for="date_from"><span class="label-text text-xs font-medium">From date</span></label>
                    <input type="date" name="date_from" id="date_from" value="{{ filters.date_from }}"
                           class="input w-full bg-base-200/50 focus:outline-none focus:ring-2 focus:ring-primary/30">
                </div>
                <div class="form-control">
                    <label class="label py-1" for="date_to"><span class="label-text text-xs font-medium">To date</span></label>
                    <input type="date" name="date_to" id="date_to" value="{{ filters.date_to }}"
                           class="input w-full bg-base-200/50 focus:outline-none focus:ring-2 focus:ring-primary/30">
                </div>
                <div class="form-control justify-end">
                    <label class="label py-1 hidden sm:block"><span class="label-text">&nbsp;</span></label>
                    <button type="submit" class="btn btn-primary gap-2">
                        <span class="icon-[tabler--search] size-4"></span>
                        Apply filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Timeline #}
    <div class="card bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 py-4 bg-base-200/50 rounded-t-xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
                <h2 class="font-semibold text-base-content">Activity timeline</h2>
                <p class="text-sm text-base-content/60 mt-0.5">Who did what, and when</p>
            </div>
            <span class="badge badge-lg badge-ghost">{{ auditLogs|length }} {{ auditLogs|length == 1 ? 'entry' : 'entries' }}</span>
        </div>

        <div class="card-body p-4 sm:p-6">
            {% if auditLogs is empty %}
                <div class="text-center py-16 px-4">
                    <div class="inline-flex items-center justify-center size-14 bg-base-200 rounded-2xl mb-3">
                        <span class="icon-[tabler--history-off] size-7 text-base-content/40"></span>
                    </div>
                    <p class="font-medium text-base-content">No activity found</p>
                    <p class="text-sm text-base-content/60 mt-1">
                        {% if hasFilters %}Try clearing or changing your filters.{% else %}Activity will appear here as users work on this manifest.{% endif %}
                    </p>
                    {% if hasFilters %}
                        <a href="{{ path('audit_trail_manifest', {id: manifest.id}) }}" class="btn btn-ghost btn-sm mt-4 gap-1">
                            <span class="icon-[tabler--x] size-4"></span>
                            Clear filters
                        </a>
                    {% endif %}
                </div>
            {% else %}
                <ul class="space-y-0">
                    {% for log in auditLogs %}
                        <li class="relative flex gap-4 pb-8 last:pb-0">
                            {% if not loop.last %}
                                <span class="absolute left-5 top-11 bottom-0 w-px bg-base-300/80" aria-hidden="true"></span>
                            {% endif %}
                            <div class="relative z-10 shrink-0">
                                <div class="size-10 rounded-xl ring-4 ring-base-100 flex items-center justify-center {{ _self.action_color(log.action) }}">
                                    {{ _self.action_icon(log.action) }}
                                </div>
                            </div>
                            <div class="flex-1 min-w-0 pt-0.5">
                                <div class="rounded-xl bg-base-200/40 p-4 sm:p-5">
                                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <h3 class="font-semibold text-sm text-base-content">
                                                {{ log.action|replace({'_': ' '})|title }}
                                            </h3>
                                            <span class="badge badge-ghost badge-sm">{{ log.entityType }}</span>
                                        </div>
                                        <time class="text-xs text-base-content/50 whitespace-nowrap" datetime="{{ log.timestamp|date('c') }}">
                                            {{ log.timestamp|date('M j, Y g:i A') }}
                                        </time>
                                    </div>

                                    <div class="flex flex-wrap items-center gap-2 text-sm">
                                        <span class="icon-[tabler--user] size-4 text-base-content/40"></span>
                                        <span class="font-medium">{{ log.user.fullName ?? log.user.email }}</span>
                                        <span class="badge badge-primary badge-sm badge-soft">{{ log.user.role.value|replace({'_': ' '})|title }}</span>
                                    </div>
                                    {% if log.ipAddress %}
                                        <p class="text-xs text-base-content/50 mt-1.5 flex items-center gap-1">
                                            <span class="icon-[tabler--world] size-3.5"></span>
                                            IP {{ log.ipAddress }}
                                        </p>
                                    {% endif %}

                                    {% if log.changes is not empty %}
                                        <div class="mt-4 pt-4 border-t border-base-300/50">
                                            <p class="text-xs font-medium text-base-content/70 mb-2">Details</p>
                                            <div class="rounded-lg bg-base-100/80 p-3 sm:p-4 text-sm">
                                                {% if log.action == 'state_transition' %}
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <span class="badge badge-ghost">{{ log.changes.from_state|default('N/A')|replace({'_': ' '})|title }}</span>
                                                        <span class="icon-[tabler--arrow-right] size-4 text-base-content/40"></span>
                                                        <span class="badge badge-info badge-soft">{{ log.changes.to_state|replace({'_': ' '})|title }}</span>
                                                    </div>
                                                    {% if log.changes.reason %}
                                                        <p class="text-xs text-base-content/60 mt-2">
                                                            <span class="font-medium">Reason:</span> {{ log.changes.reason }}
                                                        </p>
                                                    {% endif %}
                                                {% elseif log.action == 'payment_verification' %}
                                                    {% if log.changes.approved %}
                                                        <span class="badge badge-success gap-1">
                                                            <span class="icon-[tabler--check] size-3"></span>
                                                            Approved
                                                        </span>
                                                    {% else %}
                                                        <span class="badge badge-error gap-1">
                                                            <span class="icon-[tabler--x] size-3"></span>
                                                            Rejected
                                                        </span>
                                                    {% endif %}
                                                    {% if log.changes.reason %}
                                                        <p class="text-xs text-base-content/60 mt-2">
                                                            <span class="font-medium">Reason:</span> {{ log.changes.reason }}
                                                        </p>
                                                    {% endif %}
                                                {% elseif log.action in ['payment_submission', 'payment_resubmission', 'edo_payment_submitted', 'edo_payment_approved', 'edo_payment_rejected'] %}
                                                    {% if log.changes.amount is defined %}
                                                        <p class="text-sm font-semibold">{{ log.changes.amount|format_money(log.changes.currency|default('PHP')) }}</p>
                                                    {% endif %}
                                                    {% if log.changes.payment_type is defined %}
                                                        <p class="text-xs text-base-content/60 mt-1">Type: {{ log.changes.payment_type|replace({'_': ' '})|title }}</p>
                                                    {% endif %}
                                                    {% if log.changes.edo_number is defined %}
                                                        <p class="text-xs text-base-content/60 mt-1">eDO: {{ log.changes.edo_number }}</p>
                                                    {% endif %}
                                                    {% if log.changes.version is defined %}
                                                        <p class="text-xs text-base-content/60">Version {{ log.changes.version }}</p>
                                                    {% endif %}
                                                    {% if log.changes.rejection_reason is defined %}
                                                        <p class="text-xs text-error mt-2"><span class="font-medium">Reason:</span> {{ log.changes.rejection_reason }}</p>
                                                    {% endif %}
                                                {% elseif log.action == 'document_upload' %}
                                                    <p><span class="text-base-content/60">File:</span> <span class="font-medium">{{ log.changes.filename }}</span></p>
                                                    {% if log.changes.upload_time %}
                                                        <p class="text-xs text-base-content/50 mt-1">Uploaded {{ log.changes.upload_time }}</p>
                                                    {% endif %}
                                                {% elseif log.action == 'document_download' %}
                                                    <p class="text-xs text-base-content/60">
                                                        Downloaded {{ log.changes.download_time }}
                                                    </p>
                                                {% else %}
                                                    <pre class="text-xs text-base-content/70 overflow-x-auto whitespace-pre-wrap"><code>{{ log.changes|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
