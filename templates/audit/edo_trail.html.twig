{% extends 'layout/admin_base.html.twig' %}

{% block title %}eDO Audit Trail - OPTIMUS{% endblock %}

{% block admin_breadcrumbs %}
<div class="breadcrumbs text-sm mb-2">
    <ul>
        <li><a href="{{ path('app_admin_dashboard') }}">Admin</a></li>
        <li>eDO Audit Search</li>
    </ul>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title text-xl">eDO Audit Trail</h1>
            <p class="text-sm text-base-content/70">Search audit history by container number or eDO number.</p>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="form-control">
                    <label class="label py-1" for="searchType"><span class="label-text font-medium">Search By</span></label>
                    <select id="searchType" class="select select-bordered w-full">
                        <option value="container">Container Number</option>
                        <option value="edo">eDO Number</option>
                    </select>
                </div>
                <div class="form-control">
                    <label class="label py-1" for="searchValue"><span class="label-text font-medium">Search Value</span></label>
                    <input type="text" id="searchValue" class="input input-bordered w-full" placeholder="Enter container or eDO number">
                </div>
                <div class="form-control justify-end">
                    <label class="label py-1 invisible"><span class="label-text">Search</span></label>
                    <button type="button" onclick="searchAuditLogs()" class="btn btn-primary w-full">Search</button>
                </div>
            </div>
        </div>
    </div>

    <div id="resultsSection" class="hidden card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                <div>
                    <h2 class="font-semibold">Search Results</h2>
                    <p class="text-sm text-base-content/70"><span id="resultCount">0</span> audit log entries found</p>
                </div>
                <button type="button" onclick="exportAuditLogs()" class="btn btn-outline btn-sm">Export CSV</button>
            </div>
            <ul id="auditTimeline" class="space-y-4"></ul>
        </div>
    </div>

    <div id="emptyState" class="card bg-base-100 shadow-sm">
        <div class="card-body text-center py-12">
            <span class="icon-[tabler--search] size-12 text-base-content/30 mx-auto block"></span>
            <h3 class="mt-4 font-medium">No search performed</h3>
            <p class="text-sm text-base-content/60 mt-1">Enter a container number or eDO number to search audit logs.</p>
        </div>
    </div>

    <div id="loadingState" class="hidden card bg-base-100 shadow-sm">
        <div class="card-body text-center py-12">
            <span class="loading loading-spinner loading-lg text-primary"></span>
            <p class="text-sm text-base-content/60 mt-3">Searching audit logs...</p>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script src="{{ asset('js/audit-trail.js') }}"></script>
{% endblock %}
