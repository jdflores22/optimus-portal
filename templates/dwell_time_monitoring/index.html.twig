{% extends 'base.html.twig' %}

{% block title %}Container Dwell Time Monitoring - OPTIMUS{% endblock %}

{% block body %}
<div class="space-y-5">
    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs text-base-content/50">
        <ul>
            <li>
                <a href="{{ path('app_shipping_admin_dashboard') }}" class="hover:text-base-content inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Dashboard
                </a>
            </li>
            <li class="text-base-content">Dwell Time Monitoring</li>
        </ul>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="size-12 rounded-full bg-warning/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-base-content">Container Dwell Time Monitoring</h1>
                <p class="text-sm text-base-content/60 mt-1">Containers with 50+ days dwell time requiring attention</p>
            </div>
        </div>
        <div class="text-left sm:text-right">
            <p class="text-sm text-base-content/60">Total Containers</p>
            <p class="text-2xl font-bold text-base-content">{{ stats.total }}</p>
            <p class="text-sm text-base-content/60">Avg: {{ stats.avg_dwell_time }} days</p>
        </div>
    </div>

    <!-- Summary Statistics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- 50-59 Day Range -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-success hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-success/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-success" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.count_50_to_59 }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">50-59 Days</p>
                <p class="text-xs text-base-content/50 mt-1">Approaching threshold</p>
            </div>
        </div>

        <!-- 60-89 Day Threshold -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-warning hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-warning/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-warning" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.count_60_to_89 }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">60-89 Days</p>
                <p class="text-xs text-base-content/50 mt-1">Warning threshold</p>
            </div>
        </div>

        <!-- 90+ Day Threshold -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-error hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-error/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-error" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.count_90_plus }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">90+ Days</p>
                <p class="text-xs text-base-content/50 mt-1">Critical threshold</p>
            </div>
        </div>

        <!-- Alert Status -->
        <div class="card bg-base-100 shadow-sm border-t-4 border-t-accent hover:shadow-md transition-shadow">
            <div class="card-body p-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="size-12 rounded-full bg-accent/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-accent" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <span class="text-4xl font-bold text-base-content">{{ stats.alert_status }}</span>
                </div>
                <p class="text-sm font-medium text-base-content">On Alert</p>
                <p class="text-xs text-base-content/50 mt-1">Requires action</p>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-4">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex-1">
                    <input type="text" id="searchInput" placeholder="Search by container number, location..." 
                           class="input input-bordered w-full">
                </div>
                <div class="flex gap-2">
                    <select id="statusFilter" class="select select-bordered">
                        <option value="">All Status</option>
                        <option value="Available">Available</option>
                        <option value="Hold">Alert/Hold</option>
                        <option value="Reserved">Reserved</option>
                    </select>
                    <select id="dwellTimeFilter" class="select select-bordered">
                        <option value="">All Dwell Times</option>
                        <option value="50-59">50-59 days</option>
                        <option value="60-89">60-89 days</option>
                        <option value="90+">90+ days</option>
                    </select>
                    <button onclick="resetFilters()" class="btn btn-ghost">
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Container Table -->
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
            <div class="px-6 py-4 border-b border-base-300">
                <h3 class="text-lg font-semibold text-base-content">Container Details</h3>
                <p class="text-sm text-base-content/60">All containers with dwell time tracking</p>
            </div>
            
            <div class="overflow-x-auto">
                <table class="table table-zebra" id="containerTable">
                    <thead>
                        <tr>
                            <th class="cursor-pointer hover:bg-base-200" onclick="sortTable(0)">
                                <div class="flex items-center gap-2">
                                    Container Number
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                    </svg>
                                </div>
                            </th>
                            <th>Size/Type</th>
                            <th class="cursor-pointer hover:bg-base-200" onclick="sortTable(2)">
                                <div class="flex items-center gap-2">
                                    Terminal Arrival
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                    </svg>
                                </div>
                            </th>
                            <th class="cursor-pointer hover:bg-base-200" onclick="sortTable(3)">
                                <div class="flex items-center gap-2">
                                    Dwell Time
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                    </svg>
                                </div>
                            </th>
                            <th>Status</th>
                            <th>Location</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        {% for container in containers %}
                            <tr class="container-row" 
                                data-container-number="{{ container.containerNumber }}"
                                data-status="{{ container.status }}"
                                data-dwell-time="{{ container.dwellTime }}"
                                data-location="{{ container.location }}">
                                <td class="font-medium">{{ container.containerNumber }}</td>
                                <td>
                                    <span class="badge {% if container.sizeType starts with '20ft' %}badge-info{% else %}badge-secondary{% endif %} badge-sm">
                                        {{ container.sizeType }}
                                    </span>
                                </td>
                                <td class="text-sm">{{ container.gateInDate|date('M j, Y') }}</td>
                                <td>
                                    <div class="flex flex-col gap-1">
                                        <span class="badge badge-sm
                                            {% if container.dwellTime < 60 %}badge-success
                                            {% elseif container.dwellTime < 90 %}badge-warning
                                            {% else %}badge-error{% endif %}">
                                            {{ container.dwellTime }} days
                                        </span>
                                        {% if container.totalPausedDays > 0 %}
                                            <span class="badge badge-info badge-sm gap-1">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                </svg>
                                                {{ container.totalPausedDays }}d paused
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-sm
                                        {% if container.status == 'Available' %}badge-success
                                        {% elseif container.status == 'Hold' %}badge-error
                                        {% else %}badge-ghost{% endif %}">
                                        {{ container.status }}
                                    </span>
                                </td>
                                <td class="text-sm">{{ container.location }}</td>
                                <td>
                                    <a href="{{ path('app_container_detail', {'containerNumber': container.containerNumber}) }}" 
                                       class="link link-primary">View Details</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden p-12 text-center">
                <svg class="mx-auto h-16 w-16 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
                <h3 class="mt-4 text-lg font-medium text-base-content">No containers found</h3>
                <p class="mt-2 text-sm text-base-content/50">Try adjusting your filters or search criteria.</p>
            </div>
        </div>
    </div>
</div>

<script>
// Filtering and Search
function filterTable() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value;
    const dwellTimeFilter = document.getElementById('dwellTimeFilter').value;
    
    const rows = document.querySelectorAll('.container-row');
    let visibleCount = 0;
    
    rows.forEach(row => {
        const containerNumber = row.dataset.containerNumber.toLowerCase();
        const location = row.dataset.location.toLowerCase();
        const status = row.dataset.status;
        const dwellTime = parseInt(row.dataset.dwellTime);
        
        let show = true;
        
        // Search filter
        if (searchTerm && !containerNumber.includes(searchTerm) && !location.includes(searchTerm)) {
            show = false;
        }
        
        // Status filter
        if (statusFilter && status !== statusFilter) {
            show = false;
        }
        
        // Dwell time filter
        if (dwellTimeFilter) {
            if (dwellTimeFilter === '50-59' && (dwellTime < 50 || dwellTime >= 60)) {
                show = false;
            } else if (dwellTimeFilter === '60-89' && (dwellTime < 60 || dwellTime >= 90)) {
                show = false;
            } else if (dwellTimeFilter === '90+' && dwellTime < 90) {
                show = false;
            }
        }
        
        row.style.display = show ? '' : 'none';
        if (show) visibleCount++;
    });
    
    // Show/hide empty state
    document.getElementById('emptyState').classList.toggle('hidden', visibleCount > 0);
    document.getElementById('tableBody').classList.toggle('hidden', visibleCount === 0);
}

function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('statusFilter').value = '';
    document.getElementById('dwellTimeFilter').value = '';
    filterTable();
}

// Table sorting
let sortDirection = {};
function sortTable(columnIndex) {
    const table = document.getElementById('containerTable');
    const tbody = table.getElementsByTagName('tbody')[0];
    const rows = Array.from(tbody.getElementsByTagName('tr')).filter(row => row.style.display !== 'none');
    
    const currentDirection = sortDirection[columnIndex] || 'asc';
    const newDirection = currentDirection === 'asc' ? 'desc' : 'asc';
    sortDirection[columnIndex] = newDirection;
    
    rows.sort((a, b) => {
        let aValue, bValue;
        const aCells = a.getElementsByTagName('td');
        const bCells = b.getElementsByTagName('td');
        
        if (columnIndex === 3) { // Dwell time
            aValue = parseInt(a.dataset.dwellTime);
            bValue = parseInt(b.dataset.dwellTime);
        } else if (columnIndex === 2) { // Date
            aValue = new Date(aCells[columnIndex].textContent.trim());
            bValue = new Date(bCells[columnIndex].textContent.trim());
        } else {
            aValue = aCells[columnIndex].textContent.trim();
            bValue = bCells[columnIndex].textContent.trim();
        }
        
        let comparison = 0;
        if (typeof aValue === 'number') {
            comparison = aValue - bValue;
        } else if (aValue instanceof Date) {
            comparison = aValue - bValue;
        } else {
            comparison = aValue.localeCompare(bValue);
        }
        
        return newDirection === 'asc' ? comparison : -comparison;
    });
    
    rows.forEach(row => tbody.appendChild(row));
}

// Event listeners
document.getElementById('searchInput').addEventListener('input', filterTable);
document.getElementById('statusFilter').addEventListener('change', filterTable);
document.getElementById('dwellTimeFilter').addEventListener('change', filterTable);
</script>
{% endblock %}
