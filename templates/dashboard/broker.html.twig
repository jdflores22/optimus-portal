{% extends 'base.html.twig' %}

{% block title %}Broker Dashboard - OPTIMUS{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto w-full space-y-5 sm:space-y-6 pb-10">

    {# ── Hero header ── #}
    <div class="rounded-3xl border border-secondary/20 bg-gradient-to-br from-secondary/15 via-base-100 to-base-100 shadow-sm p-5 sm:p-7">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
            <div class="space-y-3 min-w-0">
                <span class="inline-flex items-center gap-2 rounded-full bg-secondary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-secondary">
                    <span class="icon-[tabler--briefcase] size-3.5"></span>
                    Broker Workspace
                </span>
                <div>
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-base-content leading-tight">
                        Welcome, {{ user.fullName }}
                    </h1>
                    <p class="mt-2 text-sm sm:text-base text-base-content/70 max-w-2xl">
                        Process manifests, submit eDO payments, and manage cargo release for your linked consignee companies.
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    {% if activeWorkspace is defined and activeWorkspace %}
                        <span class="badge badge-secondary badge-soft badge-lg gap-2">
                            <span class="icon-[tabler--building-warehouse] size-4"></span>
                            {{ activeWorkspace.name }}
                        </span>
                    {% endif %}
                    {% if workspaceCount is defined and workspaceCount > 1 %}
                        <span class="badge badge-ghost badge-lg gap-2">
                            <span class="icon-[tabler--layers-linked] size-4"></span>
                            {{ workspaceCount }} workspaces
                        </span>
                    {% endif %}
                    {% if accreditation is defined and accreditation %}
                        {% if accreditation.status.value == 'APPROVED' %}
                            <span class="badge badge-success badge-soft badge-lg gap-2">
                                <span class="icon-[tabler--shield-check] size-4"></span>
                                Broker accredited
                            </span>
                        {% else %}
                            <span class="badge badge-warning badge-soft badge-lg gap-2">
                                <span class="icon-[tabler--shield] size-4"></span>
                                {{ accreditation.status.value|replace({'_': ' '})|title }}
                            </span>
                        {% endif %}
                    {% else %}
                        <span class="badge badge-error badge-soft badge-lg gap-2">
                            <span class="icon-[tabler--alert-triangle] size-4"></span>
                            Accreditation required
                        </span>
                    {% endif %}
                    {% if edosNeedingPayment|length > 0 %}
                        <span class="badge badge-error badge-lg gap-2">
                            <span class="icon-[tabler--credit-card] size-4"></span>
                            {{ edosNeedingPayment|length }} payment{{ edosNeedingPayment|length > 1 ? 's' : '' }} due
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 xl:justify-end shrink-0">
                <a href="{{ path('broker_edo_list_page') }}" class="btn btn-error btn-sm sm:btn-md gap-2{% if edosNeedingPayment|length == 0 %} btn-soft{% endif %}">
                    <span class="icon-[tabler--credit-card] size-4"></span>
                    eDO Payments
                </a>
                <a href="{{ path('broker_manifest_list') }}" class="btn btn-outline btn-secondary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--files] size-4"></span>
                    All Manifests
                </a>
                <a href="{{ path('app_broker_dashboard') }}" class="btn btn-ghost btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--refresh] size-4"></span>
                    Refresh
                </a>
            </div>
        </div>
    </div>

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'error' : (type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'info')) }} shadow-sm">
                <span class="icon-[tabler--{{ type == 'success' ? 'circle-check' : (type == 'error' ? 'circle-x' : 'info-circle') }}] size-5"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {% if noWorkspaces is defined and noWorkspaces %}
        <div class="card bg-base-100 shadow-sm border border-warning/20">
            <div class="card-body items-center text-center py-14 sm:py-16">
                <div class="avatar avatar-placeholder mb-4">
                    <div class="bg-warning/15 text-warning size-20 rounded-full">
                        <span class="icon-[tabler--alert-triangle] size-10"></span>
                    </div>
                </div>
                <h2 class="text-2xl font-bold text-base-content">No Workspaces Available</h2>
                <p class="text-base-content/60 mt-2 max-w-md">{{ message }}</p>
                <a href="{{ path('app_logout') }}" class="btn btn-ghost gap-2 mt-6">
                    <span class="icon-[tabler--logout] size-5"></span>
                    Sign Out
                </a>
            </div>
        </div>
    {% else %}

        {# Accreditation notice #}
        {% if not accreditation %}
            <div class="alert alert-warning shadow-sm border border-warning/30">
                <span class="icon-[tabler--shield-off] size-6 shrink-0"></span>
                <div class="flex-1">
                    <p class="font-semibold">Broker accreditation required</p>
                    <p class="text-sm opacity-80">Submit your accreditation to unlock full broker services.</p>
                </div>
                <a href="{{ path('accreditation_index') }}" class="btn btn-sm btn-warning">Submit Now</a>
            </div>
        {% elseif accreditation.status.value != 'APPROVED' %}
            <div class="alert alert-info shadow-sm">
                <span class="icon-[tabler--clock-hour-4] size-6 shrink-0"></span>
                <div>
                    <p class="font-semibold">Accreditation: {{ accreditation.status.value|replace({'_': ' '})|title }}</p>
                    <p class="text-sm opacity-80">Your application is being reviewed. Some actions may be limited.</p>
                </div>
            </div>
        {% endif %}

        {# Shipping line filter #}
        {% if allShippingLines|length > 0 %}
            <div class="card bg-base-100 shadow-sm border border-base-content/10">
                <div class="card-body p-4 sm:p-5">
                    <form method="GET" action="{{ path('app_broker_dashboard') }}" class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
                        <div class="flex items-center gap-2 text-sm font-semibold text-base-content/70 shrink-0">
                            <span class="icon-[tabler--filter] size-5"></span>
                            Shipping line
                        </div>
                        <select id="shipping_line" name="shipping_line" onchange="this.form.submit()" class="select select-bordered select-sm sm:select-md flex-1 max-w-md rounded-xl">
                            <option value="">All shipping lines</option>
                            {% for shippingLine in allShippingLines %}
                                <option value="{{ shippingLine.id }}" {% if selectedShippingLineId == shippingLine.id %}selected{% endif %}>
                                    {{ shippingLine.brandName }}
                                </option>
                            {% endfor %}
                        </select>
                        {% if selectedShippingLineId %}
                            <a href="{{ path('app_broker_dashboard') }}" class="btn btn-ghost btn-sm gap-2 rounded-xl">
                                <span class="icon-[tabler--x] size-4"></span>
                                Clear
                            </a>
                        {% endif %}
                    </form>
                </div>
            </div>
        {% endif %}

        {# Key metrics — FlyonUI stats #}
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <a href="{{ path('broker_edo_list_page') }}" class="card bg-base-100 shadow-sm border border-error/15 hover:border-error/30 transition-colors">
                <div class="card-body p-5">
                    <div class="stats shadow-none p-0">
                        <div class="stat p-0">
                            <div class="stat-figure text-error">
                                <span class="icon-[tabler--credit-card] size-8"></span>
                            </div>
                            <div class="stat-title">Payment Needed</div>
                            <div class="stat-value text-error">{{ edosNeedingPayment|length }}</div>
                            <div class="stat-desc">eDOs awaiting payment</div>
                        </div>
                    </div>
                </div>
            </a>
            <a href="{{ path('broker_edo_list_page') }}" class="card bg-base-100 shadow-sm border border-warning/15 hover:border-warning/30 transition-colors">
                <div class="card-body p-5">
                    <div class="stats shadow-none p-0">
                        <div class="stat p-0">
                            <div class="stat-figure text-warning">
                                <span class="icon-[tabler--hourglass] size-8"></span>
                            </div>
                            <div class="stat-title">Pending Validation</div>
                            <div class="stat-value text-warning">{{ edosWithPendingPayment|length }}</div>
                            <div class="stat-desc">Payments under review</div>
                        </div>
                    </div>
                </div>
            </a>
            <a href="{{ path('broker_edo_list_page') }}" class="card bg-base-100 shadow-sm border border-success/15 hover:border-success/30 transition-colors">
                <div class="card-body p-5">
                    <div class="stats shadow-none p-0">
                        <div class="stat p-0">
                            <div class="stat-figure text-success">
                                <span class="icon-[tabler--circle-check] size-8"></span>
                            </div>
                            <div class="stat-title">Ready to Download</div>
                            <div class="stat-value text-success">{{ edosWithVerifiedPayment|length }}</div>
                            <div class="stat-desc">Verified eDOs</div>
                        </div>
                    </div>
                </div>
            </a>
            <a href="{{ path('broker_manifest_list') }}" class="card bg-base-100 shadow-sm border border-secondary/15 hover:border-secondary/30 transition-colors">
                <div class="card-body p-5">
                    <div class="stats shadow-none p-0">
                        <div class="stat p-0">
                            <div class="stat-figure text-secondary">
                                <span class="icon-[tabler--file-text] size-8"></span>
                            </div>
                            <div class="stat-title">Manifests</div>
                            <div class="stat-value text-secondary">{{ manifests|length }}</div>
                            <div class="stat-desc">Recent in workspace</div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-5 sm:gap-6">
            {# Main column #}
            <div class="xl:col-span-2 space-y-5 sm:space-y-6">

                {# eDO activity — tabbed #}
                <div class="card bg-base-100 shadow-sm border border-base-content/10">
                    <div class="px-4 sm:px-5 pt-4 sm:pt-5 border-b border-base-content/10">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                            <div>
                                <h2 class="font-semibold text-lg text-base-content">eDO Activity</h2>
                                <p class="text-xs text-base-content/60">Payments and releases for your active workspace</p>
                            </div>
                            <a href="{{ path('broker_edo_list_page') }}" class="btn btn-ghost btn-sm gap-2 self-start sm:self-auto">
                                View all
                                <span class="icon-[tabler--arrow-right] size-4"></span>
                            </a>
                        </div>
                        <nav class="tabs tabs-bordered overflow-x-auto -mb-px" aria-label="eDO tabs" role="tablist">
                            <button type="button" class="tab active-tab:tab-active active whitespace-nowrap" id="broker-edo-tab-pay" data-tab="#broker-edo-panel-pay" role="tab" aria-selected="true">
                                Payment needed
                                {% if edosNeedingPayment|length > 0 %}
                                    <span class="badge badge-soft badge-error badge-sm ms-2 rounded-full">{{ edosNeedingPayment|length }}</span>
                                {% endif %}
                            </button>
                            <button type="button" class="tab active-tab:tab-active whitespace-nowrap" id="broker-edo-tab-pending" data-tab="#broker-edo-panel-pending" role="tab" aria-selected="false">
                                Pending
                                {% if edosWithPendingPayment|length > 0 %}
                                    <span class="badge badge-soft badge-warning badge-sm ms-2 rounded-full">{{ edosWithPendingPayment|length }}</span>
                                {% endif %}
                            </button>
                            <button type="button" class="tab active-tab:tab-active whitespace-nowrap" id="broker-edo-tab-ready" data-tab="#broker-edo-panel-ready" role="tab" aria-selected="false">
                                Ready
                                {% if edosWithVerifiedPayment|length > 0 %}
                                    <span class="badge badge-soft badge-success badge-sm ms-2 rounded-full">{{ edosWithVerifiedPayment|length }}</span>
                                {% endif %}
                            </button>
                        </nav>
                    </div>

                    <div class="card-body p-0">
                        {# Payment needed panel #}
                        <div id="broker-edo-panel-pay" role="tabpanel" aria-labelledby="broker-edo-tab-pay">
                            {% if edosNeedingPayment|length > 0 %}
                                <div class="overflow-x-auto">
                                    <table class="table table-sm sm:table-md">
                                        <thead>
                                            <tr class="bg-error/5 text-xs uppercase tracking-wide text-base-content/60">
                                                <th>eDO #</th>
                                                <th>Container</th>
                                                <th class="hidden sm:table-cell">Manifest</th>
                                                <th class="hidden md:table-cell">Generated</th>
                                                <th class="text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for edo in edosNeedingPayment|slice(0, 8) %}
                                                <tr class="hover:bg-base-200/50">
                                                    <td><span class="font-mono text-sm font-medium">{{ edo.edoNumber }}</span></td>
                                                    <td><span class="font-mono text-sm">{{ edo.container.containerNumber }}</span></td>
                                                    <td class="hidden sm:table-cell"><span class="font-mono text-xs text-base-content/70">{{ edo.manifest.manifestNumber }}</span></td>
                                                    <td class="hidden md:table-cell text-xs text-base-content/60">{{ edo.generatedAt|date('M d, Y') }}</td>
                                                    <td class="text-right">
                                                        <a href="{{ path('broker_manifest_edo_payment_specific', {id: edo.manifest.id, edoNumber: edo.edoNumber}) }}" class="btn btn-error btn-xs sm:btn-sm gap-1">
                                                            <span class="icon-[tabler--credit-card] size-3.5"></span>
                                                            Pay
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-12 px-4">
                                    <span class="icon-[tabler--circle-check] size-12 text-success/40 mx-auto block"></span>
                                    <p class="text-sm text-base-content/60 mt-3">No eDOs waiting for payment</p>
                                </div>
                            {% endif %}
                        </div>

                        {# Pending panel #}
                        <div id="broker-edo-panel-pending" class="hidden" role="tabpanel" aria-labelledby="broker-edo-tab-pending">
                            {% if edosWithPendingPayment|length > 0 %}
                                <div class="overflow-x-auto">
                                    <table class="table table-sm sm:table-md">
                                        <thead>
                                            <tr class="bg-warning/5 text-xs uppercase tracking-wide text-base-content/60">
                                                <th>eDO #</th>
                                                <th>Container</th>
                                                <th class="hidden sm:table-cell">Manifest</th>
                                                <th class="hidden md:table-cell">Submitted</th>
                                                <th class="text-right">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for edo in edosWithPendingPayment|slice(0, 8) %}
                                                {% set payment = edo.payments.first %}
                                                <tr class="hover:bg-base-200/50">
                                                    <td><span class="font-mono text-sm font-medium">{{ edo.edoNumber }}</span></td>
                                                    <td><span class="font-mono text-sm">{{ edo.container.containerNumber }}</span></td>
                                                    <td class="hidden sm:table-cell"><span class="font-mono text-xs text-base-content/70">{{ edo.manifest.manifestNumber }}</span></td>
                                                    <td class="hidden md:table-cell text-xs text-base-content/60">{{ payment ? payment.createdAt|date('M d, Y') : '—' }}</td>
                                                    <td class="text-right">
                                                        <span class="badge badge-soft badge-warning badge-sm gap-1">
                                                            <span class="icon-[tabler--clock] size-3"></span>
                                                            In review
                                                        </span>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-12 px-4">
                                    <span class="icon-[tabler--inbox] size-12 text-base-content/20 mx-auto block"></span>
                                    <p class="text-sm text-base-content/60 mt-3">No payments pending validation</p>
                                </div>
                            {% endif %}
                        </div>

                        {# Ready panel #}
                        <div id="broker-edo-panel-ready" class="hidden" role="tabpanel" aria-labelledby="broker-edo-tab-ready">
                            {% if edosWithVerifiedPayment|length > 0 %}
                                <div class="overflow-x-auto">
                                    <table class="table table-sm sm:table-md">
                                        <thead>
                                            <tr class="bg-success/5 text-xs uppercase tracking-wide text-base-content/60">
                                                <th>eDO #</th>
                                                <th>Container</th>
                                                <th class="hidden sm:table-cell">Manifest</th>
                                                <th class="hidden md:table-cell">Verified</th>
                                                <th class="text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for edo in edosWithVerifiedPayment|slice(0, 8) %}
                                                {% set payment = edo.payments.first %}
                                                <tr class="hover:bg-base-200/50">
                                                    <td><span class="font-mono text-sm font-medium">{{ edo.edoNumber }}</span></td>
                                                    <td><span class="font-mono text-sm">{{ edo.container.containerNumber }}</span></td>
                                                    <td class="hidden sm:table-cell"><span class="font-mono text-xs text-base-content/70">{{ edo.manifest.manifestNumber }}</span></td>
                                                    <td class="hidden md:table-cell text-xs text-base-content/60">{{ payment ? payment.validatedAt|date('M d, Y') : '—' }}</td>
                                                    <td class="text-right">
                                                        <a href="{{ path('broker_edo_download', {id: edo.id}) }}" class="btn btn-success btn-xs sm:btn-sm gap-1">
                                                            <span class="icon-[tabler--download] size-3.5"></span>
                                                            Download
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-12 px-4">
                                    <span class="icon-[tabler--file-off] size-12 text-base-content/20 mx-auto block"></span>
                                    <p class="text-sm text-base-content/60 mt-3">No verified eDOs ready yet</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Recent manifests #}
                <div class="card bg-base-100 shadow-sm border border-base-content/10">
                    <div class="px-5 py-4 border-b border-base-content/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div>
                            <h2 class="font-semibold text-lg">Recent Manifests</h2>
                            <p class="text-xs text-base-content/60">Latest NOA-linked manifests in this workspace</p>
                        </div>
                        <a href="{{ path('broker_manifest_list') }}" class="btn btn-ghost btn-sm gap-2">
                            View all
                            <span class="icon-[tabler--arrow-right] size-4"></span>
                        </a>
                    </div>
                    <div class="card-body p-0">
                        {% if manifests|length > 0 %}
                            <div class="overflow-x-auto">
                                <table class="table table-sm sm:table-md">
                                    <thead>
                                        <tr class="text-xs uppercase tracking-wide text-base-content/60">
                                            <th>Manifest</th>
                                            <th class="hidden sm:table-cell">Consignee</th>
                                            <th class="hidden md:table-cell">Vessel</th>
                                            <th>eDOs</th>
                                            <th>Payment</th>
                                            <th class="text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in manifestsWithEdoData|slice(0, 8) %}
                                            {% set manifest = item.manifest %}
                                            <tr class="hover:bg-base-200/50">
                                                <td>
                                                    <span class="font-mono text-sm font-semibold">{{ manifest.manifestNumber }}</span>
                                                </td>
                                                <td class="hidden sm:table-cell text-sm">
                                                    {{ manifest.consignee ? manifest.consignee.businessName : '—' }}
                                                </td>
                                                <td class="hidden md:table-cell text-sm text-base-content/70">{{ manifest.vesselName }}</td>
                                                <td>
                                                    {% if item.containers_with_edo > 0 %}
                                                        <span class="badge badge-soft badge-{{ item.all_edos_paid ? 'success' : (item.all_edos_generated ? 'info' : 'warning') }} badge-sm">
                                                            {{ item.containers_with_edo }}/{{ item.total_containers }}
                                                        </span>
                                                    {% else %}
                                                        <span class="badge badge-ghost badge-sm">{{ item.total_containers }} ctr</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if item.all_edos_paid %}
                                                        <span class="badge badge-soft badge-success badge-sm">All paid</span>
                                                    {% elseif item.edos_paid > 0 %}
                                                        <span class="badge badge-soft badge-info badge-sm">{{ item.edos_paid }} paid</span>
                                                    {% elseif item.containers_with_edo > 0 %}
                                                        <span class="badge badge-soft badge-warning badge-sm">Pending</span>
                                                    {% else %}
                                                        <span class="text-base-content/40 text-xs">—</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-right">
                                                    <a href="{{ path('broker_manifest_detail', {id: manifest.id}) }}" class="btn btn-ghost btn-xs sm:btn-sm gap-1">
                                                        <span class="icon-[tabler--eye] size-4"></span>
                                                        Open
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-14 px-4">
                                <span class="icon-[tabler--file-off] size-12 text-base-content/20 mx-auto block"></span>
                                <p class="text-sm text-base-content/60 mt-3">No manifests in this workspace yet</p>
                                <a href="{{ path('manifest_workflow_create') }}" class="btn btn-secondary btn-sm gap-2 mt-4">
                                    <span class="icon-[tabler--upload] size-4"></span>
                                    Upload Manifest
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Claimable shipments #}
                {% if claimableShipments is defined and claimableShipments|length > 0 %}
                    <div class="card bg-base-100 shadow-sm border border-accent/20">
                        <div class="px-5 py-4 border-b border-base-content/10 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2">
                                <span class="icon-[tabler--hand-grab] size-5 text-accent"></span>
                                <h2 class="font-semibold text-lg">Claimable Shipments</h2>
                            </div>
                            <span class="badge badge-accent badge-soft">{{ claimableShipments|length }}</span>
                        </div>
                        <div class="card-body p-4 sm:p-5 space-y-2">
                            {% for shipment in claimableShipments|slice(0, 5) %}
                                <div class="flex items-center justify-between gap-3 rounded-xl border border-base-content/10 bg-base-200/40 px-4 py-3">
                                    <div class="min-w-0">
                                        <p class="font-mono font-semibold text-sm truncate">{{ shipment.containerNumber }}</p>
                                        <p class="text-xs text-base-content/60 truncate">{{ shipment.consignee ? shipment.consignee.businessName : '—' }}</p>
                                    </div>
                                    <form method="POST" action="{{ path('broker_claim_shipment', {id: shipment.id}) }}" class="shrink-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('claim_shipment_' ~ shipment.id) }}">
                                        <button type="submit" class="btn btn-accent btn-sm gap-1">
                                            <span class="icon-[tabler--hand-grab] size-4"></span>
                                            Claim
                                        </button>
                                    </form>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Sidebar #}
            <div class="space-y-5 sm:space-y-6">
                <div class="card bg-base-100 shadow-sm border border-base-content/10">
                    <div class="card-body p-5">
                        <h3 class="font-semibold text-base mb-4">Quick Actions</h3>
                        <ul class="menu menu-sm p-0 gap-1">
                            <li>
                                <a href="{{ path('manifest_workflow_create') }}" class="rounded-xl gap-3 font-medium">
                                    <span class="icon-[tabler--upload] size-5 text-secondary"></span>
                                    Upload Manifest
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('broker_edo_list_page') }}" class="rounded-xl gap-3 font-medium">
                                    <span class="icon-[tabler--file-download] size-5 text-error"></span>
                                    eDO Payments
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('broker_manifest_list') }}" class="rounded-xl gap-3 font-medium">
                                    <span class="icon-[tabler--list] size-5 text-primary"></span>
                                    All Manifests
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('accreditation_index') }}" class="rounded-xl gap-3 font-medium">
                                    <span class="icon-[tabler--shield-check] size-5 text-success"></span>
                                    SAS Accreditation
                                </a>
                            </li>
                            {% if activeWorkspace is defined and activeWorkspace %}
                                <li>
                                    <a href="{{ path('broker_workspace_selector') }}" class="rounded-xl gap-3 font-medium">
                                        <span class="icon-[tabler--switch-horizontal] size-5 text-info"></span>
                                        Switch Workspace
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>

                {% if activeWorkspace is defined and activeWorkspace %}
                    <div class="card bg-base-100 shadow-sm border border-secondary/15">
                        <div class="card-body p-5">
                            <h3 class="font-semibold text-base mb-4">Active Workspace</h3>
                            <div class="flex items-start gap-3">
                                <div class="avatar avatar-placeholder shrink-0">
                                    <div class="bg-secondary/15 text-secondary size-12 rounded-xl">
                                        <span class="icon-[tabler--building] size-6"></span>
                                    </div>
                                </div>
                                <div class="min-w-0 space-y-2">
                                    <p class="font-bold text-base-content leading-tight">{{ activeWorkspace.name }}</p>
                                    {% if activeWorkspace.description %}
                                        <p class="text-xs text-base-content/60">{{ activeWorkspace.description }}</p>
                                    {% endif %}
                                    <div class="flex flex-wrap gap-2 text-xs">
                                        <span class="badge badge-ghost badge-sm">{{ activeWorkspace.members|length }} member{{ activeWorkspace.members|length != 1 ? 's' : '' }}</span>
                                        <span class="badge badge-ghost badge-sm">Since {{ activeWorkspace.createdAt|date('M Y') }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if recentShipments is defined and recentShipments|length > 0 %}
                    <div class="card bg-base-100 shadow-sm border border-base-content/10">
                        <div class="card-body p-5">
                            <h3 class="font-semibold text-base mb-3">Recent Shipments</h3>
                            <ul class="space-y-2">
                                {% for shipment in recentShipments|slice(0, 4) %}
                                    <li>
                                        <a href="{{ path('shipment_detail', {id: shipment.id}) }}" class="flex items-center justify-between gap-2 rounded-xl px-3 py-2 hover:bg-base-200 transition-colors">
                                            <div class="min-w-0">
                                                <p class="font-mono text-sm font-medium truncate">{{ shipment.containerNumber }}</p>
                                                <p class="text-xs text-base-content/60 truncate">{{ shipment.manifest.vesselName }}</p>
                                            </div>
                                            <span class="icon-[tabler--chevron-right] size-4 text-base-content/40 shrink-0"></span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}

                <div class="card bg-info/10 border border-info/20 shadow-none">
                    <div class="card-body p-5">
                        <div class="flex gap-3">
                            <span class="icon-[tabler--help-circle] size-6 text-info shrink-0"></span>
                            <div>
                                <h4 class="font-semibold text-info">Need help?</h4>
                                <p class="text-sm text-info/80 mt-1 mb-3">Contact support for manifests, payments, or eDO downloads.</p>
                                <a href="mailto:support@optimus.com" class="btn btn-info btn-sm gap-2">
                                    <span class="icon-[tabler--mail] size-4"></span>
                                    Get Support
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('[data-tab^="#broker-edo-panel-"]');
    const panels = document.querySelectorAll('[id^="broker-edo-panel-"]');

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            const target = this.getAttribute('data-tab');
            tabs.forEach(function (t) {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });
            panels.forEach(function (p) {
                p.classList.add('hidden');
            });
            this.classList.add('active');
            this.setAttribute('aria-selected', 'true');
            const panel = document.querySelector(target);
            if (panel) {
                panel.classList.remove('hidden');
            }
        });
    });
});
</script>
{% endblock %}
