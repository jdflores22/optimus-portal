{% extends 'base.html.twig' %}

{% block title %}Broker Dashboard - OPTIMUS{% endblock %}

{% block body %}
<!-- Toast Notification Container -->
<div class="toast toast-top toast-end z-50">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert {% if type == 'success' %}alert-success{% elseif type == 'error' %}alert-error{% elseif type == 'warning' %}alert-warning{% else %}alert-info{% endif %}">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<div class="min-h-screen bg-base-200">
    <!-- Header Section -->
    <div class="bg-base-100 shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-base-content">Broker Dashboard</h1>
                    <p class="text-base-content/60 mt-1">Welcome back, {{ user.fullName }}</p>
                </div>
                
                <!-- Workspace Info Badge -->
                {% if activeWorkspace %}
                    <div class="flex items-center gap-3 bg-primary/10 rounded-xl px-4 py-3">
                        <span class="icon-[tabler--briefcase] size-6 text-primary"></span>
                        <div>
                            <p class="text-xs text-primary/70 font-medium">Active Workspace</p>
                            <p class="text-sm font-bold text-primary">{{ activeWorkspace.name }}</p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-8 py-8">
        <!-- No Workspaces Message -->
        {% if noWorkspaces is defined and noWorkspaces %}
            <div class="card bg-base-100 shadow-xl">
                <div class="card-body items-center text-center py-16">
                    <div class="size-20 bg-warning/10 rounded-full flex items-center justify-center mb-6">
                        <span class="icon-[tabler--alert-triangle] size-10 text-warning"></span>
                    </div>
                    <h3 class="text-2xl font-bold text-base-content mb-3">No Workspaces Available</h3>
                    <p class="text-base-content/60 mb-8 max-w-md">{{ message }}</p>
                    <a href="{{ path('app_logout') }}" class="btn btn-ghost gap-2">
                        <span class="icon-[tabler--logout] size-5"></span>
                        Sign Out
                    </a>
                </div>
            </div>
        {% else %}
            <!-- Accreditation Alert -->
            {% if not accreditation %}
                <div class="alert alert-warning mb-6">
                    <span class="icon-[tabler--alert-triangle] size-5"></span>
                    <div class="flex-1">
                        <p class="font-semibold">Accreditation Required</p>
                        <p class="text-sm">Submit your accreditation to access full broker services.</p>
                    </div>
                    <a href="{{ path('accreditation_index') }}" class="btn btn-sm btn-warning">
                        Submit Now
                    </a>
                </div>
            {% elseif accreditation.status.value != 'APPROVED' %}
                <div class="alert alert-info mb-6">
                    <span class="icon-[tabler--info-circle] size-5"></span>
                    <div>
                        <p class="font-semibold">Accreditation Status: {{ accreditation.status.value|replace({'_': ' '})|title }}</p>
                        <p class="text-sm">Your application is being reviewed.</p>
                    </div>
                </div>
            {% endif %}

            <!-- Statistics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6 sm:mb-8">
                <!-- eDO Payments Needed -->
                <a href="{{ path('broker_edo_list_page') }}" class="card bg-base-100 shadow-sm hover:shadow-md transition-all cursor-pointer border-2 border-transparent hover:border-error/20">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex items-start justify-between mb-3">
                            <div class="size-10 sm:size-12 bg-error/10 rounded-xl flex items-center justify-center flex-shrink-0">
                                <span class="icon-[tabler--credit-card] size-5 sm:size-6 text-error"></span>
                            </div>
                            {% if edosNeedingPayment|length > 0 %}
                                <span class="badge badge-error badge-sm">Action Required</span>
                            {% endif %}
                        </div>
                        <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-1">Payment Needed</p>
                        <p class="text-3xl sm:text-4xl font-bold text-error">{{ edosNeedingPayment|length }}</p>
                        <p class="text-xs sm:text-sm text-base-content/60 mt-1">eDOs awaiting payment</p>
                    </div>
                </a>

                <!-- Pending Validation -->
                <a href="{{ path('broker_edo_list_page') }}" class="card bg-base-100 shadow-sm hover:shadow-md transition-all cursor-pointer border-2 border-transparent hover:border-warning/20">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex items-start justify-between mb-3">
                            <div class="size-10 sm:size-12 bg-warning/10 rounded-xl flex items-center justify-center flex-shrink-0">
                                <span class="icon-[tabler--clock-hour-3] size-5 sm:size-6 text-warning"></span>
                            </div>
                            {% if edosWithPendingPayment|length > 0 %}
                                <span class="badge badge-warning badge-sm">In Review</span>
                            {% endif %}
                        </div>
                        <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-1">Pending</p>
                        <p class="text-3xl sm:text-4xl font-bold text-warning">{{ edosWithPendingPayment|length }}</p>
                        <p class="text-xs sm:text-sm text-base-content/60 mt-1">Awaiting validation</p>
                    </div>
                </a>

                <!-- eDOs Available -->
                <a href="{{ path('broker_edo_list_page') }}" class="card bg-base-100 shadow-sm hover:shadow-md transition-all cursor-pointer border-2 border-transparent hover:border-success/20">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex items-start justify-between mb-3">
                            <div class="size-10 sm:size-12 bg-success/10 rounded-xl flex items-center justify-center flex-shrink-0">
                                <span class="icon-[tabler--circle-check] size-5 sm:size-6 text-success"></span>
                            </div>
                            {% if edosWithVerifiedPayment|length > 0 %}
                                <span class="badge badge-success badge-sm">Ready</span>
                            {% endif %}
                        </div>
                        <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-1">Available</p>
                        <p class="text-3xl sm:text-4xl font-bold text-success">{{ edosWithVerifiedPayment|length }}</p>
                        <p class="text-xs sm:text-sm text-base-content/60 mt-1">Ready to download</p>
                    </div>
                </a>

                <!-- Total Manifests -->
                <a href="{{ path('broker_manifest_list') }}" class="card bg-base-100 shadow-sm hover:shadow-md transition-all cursor-pointer border-2 border-transparent hover:border-primary/20">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex items-start justify-between mb-3">
                            <div class="size-10 sm:size-12 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0">
                                <span class="icon-[tabler--files] size-5 sm:size-6 text-primary"></span>
                            </div>
                        </div>
                        <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-1">Total Manifests</p>
                        <p class="text-3xl sm:text-4xl font-bold text-primary">{{ manifests|length }}</p>
                        <p class="text-xs sm:text-sm text-base-content/60 mt-1">Recent records</p>
                    </div>
                </a>
            </div>

            <!-- Action Required: eDOs Needing Payment -->
            {% if edosNeedingPayment|length > 0 %}
                <div class="card bg-gradient-to-br from-error/5 to-error/10 border-2 border-error/20 shadow-sm mb-6">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
                            <div class="flex items-center gap-3 flex-1">
                                <div class="size-10 bg-error rounded-xl flex items-center justify-center flex-shrink-0">
                                    <span class="icon-[tabler--alert-circle] size-6 text-white"></span>
                                </div>
                                <div>
                                    <h2 class="text-lg sm:text-xl font-bold text-error">Action Required: Payment Needed</h2>
                                    <p class="text-xs sm:text-sm text-error/70">{{ edosNeedingPayment|length }} eDO{{ edosNeedingPayment|length > 1 ? 's' : '' }} waiting for payment</p>
                                </div>
                            </div>
                            <span class="badge badge-error gap-2 self-start sm:self-auto">
                                <span class="icon-[tabler--clock] size-4"></span>
                                Urgent
                            </span>
                        </div>
                        
                        <div class="overflow-x-auto -mx-4 sm:mx-0">
                            <div class="inline-block min-w-full align-middle">
                                <table class="table table-sm sm:table-md">
                                    <thead>
                                        <tr class="bg-error/5">
                                            <th class="text-xs">eDO #</th>
                                            <th class="text-xs">Container</th>
                                            <th class="text-xs hidden sm:table-cell">Manifest</th>
                                            <th class="text-xs hidden md:table-cell">Vessel</th>
                                            <th class="text-xs hidden lg:table-cell">Generated</th>
                                            <th class="text-xs text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for edo in edosNeedingPayment|slice(0, 5) %}
                                            <tr class="hover">
                                                <td>
                                                    <span class="font-mono text-xs sm:text-sm font-semibold text-base-content">{{ edo.edoNumber }}</span>
                                                </td>
                                                <td>
                                                    <div class="flex items-center gap-2">
                                                        <span class="icon-[tabler--container] size-4 text-base-content/40 hidden sm:inline-block"></span>
                                                        <span class="font-mono text-xs sm:text-sm text-base-content">{{ edo.container.containerNumber }}</span>
                                                    </div>
                                                </td>
                                                <td class="hidden sm:table-cell">
                                                    <span class="font-mono text-xs text-base-content/70">{{ edo.manifest.manifestNumber }}</span>
                                                </td>
                                                <td class="hidden md:table-cell">
                                                    <span class="text-xs text-base-content/70">{{ edo.manifest.vesselName }}</span>
                                                </td>
                                                <td class="hidden lg:table-cell">
                                                    <span class="text-xs text-base-content/60">{{ edo.generatedAt|date('M d, Y') }}</span>
                                                </td>
                                                <td class="text-right">
                                                    <a href="{{ path('broker_manifest_edo_payment_specific', {id: edo.manifest.id, edoNumber: edo.edoNumber}) }}" 
                                                       class="btn btn-error btn-xs sm:btn-sm gap-1 sm:gap-2 whitespace-nowrap">
                                                        <span class="icon-[tabler--credit-card] size-3 sm:size-4"></span>
                                                        <span class="hidden sm:inline">Pay Now</span>
                                                        <span class="sm:hidden">Pay</span>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        {% if edosNeedingPayment|length > 5 %}
                            <div class="mt-4 text-center">
                                <a href="{{ path('broker_edo_list_page') }}" class="btn btn-outline btn-error btn-sm gap-2">
                                    View All {{ edosNeedingPayment|length }} eDOs
                                    <span class="icon-[tabler--arrow-right] size-4"></span>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <!-- In Progress: Pending Validation -->
            {% if edosWithPendingPayment|length > 0 %}
                <div class="card bg-gradient-to-br from-warning/5 to-warning/10 border-2 border-warning/20 shadow-sm mb-6">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
                            <div class="flex items-center gap-3 flex-1">
                                <div class="size-10 bg-warning rounded-xl flex items-center justify-center flex-shrink-0">
                                    <span class="icon-[tabler--hourglass] size-6 text-white"></span>
                                </div>
                                <div>
                                    <h2 class="text-lg sm:text-xl font-bold text-warning">In Progress: Pending Validation</h2>
                                    <p class="text-xs sm:text-sm text-warning/70">{{ edosWithPendingPayment|length }} payment{{ edosWithPendingPayment|length > 1 ? 's' : '' }} being reviewed</p>
                                </div>
                            </div>
                            <span class="badge badge-warning gap-2 self-start sm:self-auto">
                                <span class="icon-[tabler--refresh] size-4"></span>
                                In Review
                            </span>
                        </div>
                        
                        <div class="overflow-x-auto -mx-4 sm:mx-0">
                            <div class="inline-block min-w-full align-middle">
                                <table class="table table-sm sm:table-md">
                                    <thead>
                                        <tr class="bg-warning/5">
                                            <th class="text-xs">eDO #</th>
                                            <th class="text-xs">Container</th>
                                            <th class="text-xs hidden sm:table-cell">Manifest</th>
                                            <th class="text-xs hidden md:table-cell">Vessel</th>
                                            <th class="text-xs hidden lg:table-cell">Submitted</th>
                                            <th class="text-xs text-right">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for edo in edosWithPendingPayment|slice(0, 5) %}
                                            {% set payment = edo.payments.first %}
                                            <tr class="hover">
                                                <td>
                                                    <span class="font-mono text-xs sm:text-sm font-semibold text-base-content">{{ edo.edoNumber }}</span>
                                                </td>
                                                <td>
                                                    <div class="flex items-center gap-2">
                                                        <span class="icon-[tabler--container] size-4 text-base-content/40 hidden sm:inline-block"></span>
                                                        <span class="font-mono text-xs sm:text-sm text-base-content">{{ edo.container.containerNumber }}</span>
                                                    </div>
                                                </td>
                                                <td class="hidden sm:table-cell">
                                                    <span class="font-mono text-xs text-base-content/70">{{ edo.manifest.manifestNumber }}</span>
                                                </td>
                                                <td class="hidden md:table-cell">
                                                    <span class="text-xs text-base-content/70">{{ edo.manifest.vesselName }}</span>
                                                </td>
                                                <td class="hidden lg:table-cell">
                                                    <span class="text-xs text-base-content/60">{{ payment ? payment.createdAt|date('M d, Y') : 'N/A' }}</span>
                                                </td>
                                                <td class="text-right">
                                                    <span class="badge badge-warning badge-xs sm:badge-sm gap-1">
                                                        <span class="icon-[tabler--clock] size-3"></span>
                                                        Pending
                                                    </span>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        {% if edosWithPendingPayment|length > 5 %}
                            <div class="mt-4 text-center">
                                <a href="{{ path('broker_edo_list_page') }}" class="btn btn-outline btn-warning btn-sm gap-2">
                                    View All {{ edosWithPendingPayment|length }} eDOs
                                    <span class="icon-[tabler--arrow-right] size-4"></span>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <!-- Ready: eDOs Available for Download -->
            {% if edosWithVerifiedPayment|length > 0 %}
                <div class="card bg-gradient-to-br from-success/5 to-success/10 border-2 border-success/20 shadow-sm mb-6">
                    <div class="card-body p-4 sm:p-6">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
                            <div class="flex items-center gap-3 flex-1">
                                <div class="size-10 bg-success rounded-xl flex items-center justify-center flex-shrink-0">
                                    <span class="icon-[tabler--circle-check] size-6 text-white"></span>
                                </div>
                                <div>
                                    <h2 class="text-lg sm:text-xl font-bold text-success">Ready: eDOs Available for Download</h2>
                                    <p class="text-xs sm:text-sm text-success/70">{{ edosWithVerifiedPayment|length }} eDO{{ edosWithVerifiedPayment|length > 1 ? 's' : '' }} ready to download</p>
                                </div>
                            </div>
                            <span class="badge badge-success gap-2 self-start sm:self-auto">
                                <span class="icon-[tabler--download] size-4"></span>
                                Available
                            </span>
                        </div>
                        
                        <div class="overflow-x-auto -mx-4 sm:mx-0">
                            <div class="inline-block min-w-full align-middle">
                                <table class="table table-sm sm:table-md">
                                    <thead>
                                        <tr class="bg-success/5">
                                            <th class="text-xs">eDO #</th>
                                            <th class="text-xs">Container</th>
                                            <th class="text-xs hidden sm:table-cell">Manifest</th>
                                            <th class="text-xs hidden md:table-cell">Vessel</th>
                                            <th class="text-xs hidden lg:table-cell">Verified</th>
                                            <th class="text-xs text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for edo in edosWithVerifiedPayment|slice(0, 5) %}
                                            {% set payment = edo.payments.first %}
                                            <tr class="hover">
                                                <td>
                                                    <span class="font-mono text-xs sm:text-sm font-semibold text-base-content">{{ edo.edoNumber }}</span>
                                                </td>
                                                <td>
                                                    <div class="flex items-center gap-2">
                                                        <span class="icon-[tabler--container] size-4 text-base-content/40 hidden sm:inline-block"></span>
                                                        <span class="font-mono text-xs sm:text-sm text-base-content">{{ edo.container.containerNumber }}</span>
                                                    </div>
                                                </td>
                                                <td class="hidden sm:table-cell">
                                                    <span class="font-mono text-xs text-base-content/70">{{ edo.manifest.manifestNumber }}</span>
                                                </td>
                                                <td class="hidden md:table-cell">
                                                    <span class="text-xs text-base-content/70">{{ edo.manifest.vesselName }}</span>
                                                </td>
                                                <td class="hidden lg:table-cell">
                                                    <span class="text-xs text-base-content/60">{{ payment ? payment.validatedAt|date('M d, Y') : 'N/A' }}</span>
                                                </td>
                                                <td class="text-right">
                                                    <a href="{{ path('broker_edo_download', {id: edo.id}) }}" 
                                                       class="btn btn-success btn-xs sm:btn-sm gap-1 sm:gap-2 whitespace-nowrap">
                                                        <span class="icon-[tabler--download] size-3 sm:size-4"></span>
                                                        <span class="hidden sm:inline">Download</span>
                                                        <span class="sm:hidden">Get</span>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        {% if edosWithVerifiedPayment|length > 5 %}
                            <div class="mt-4 text-center">
                                <a href="{{ path('broker_edo_list_page') }}" class="btn btn-outline btn-success btn-sm gap-2">
                                    View All {{ edosWithVerifiedPayment|length }} eDOs
                                    <span class="icon-[tabler--arrow-right] size-4"></span>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <!-- Two Column Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Main Content (2/3 width) -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Recent NOAs -->
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-body p-6">
                            <div class="flex items-center gap-3 mb-4">
                                <span class="icon-[tabler--file-text] size-6 text-primary"></span>
                                <h2 class="text-xl font-bold text-base-content">Recent NOAs</h2>
                            </div>
                            
                            {% if manifests|length > 0 %}
                                <div class="overflow-x-auto">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Manifest #</th>
                                                <th>Consignee</th>
                                                <th>Vessel</th>
                                                <th>Containers/eDOs</th>
                                                <th>Payment</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for item in manifestsWithEdoData|slice(0, 5) %}
                                                {% set manifest = item.manifest %}
                                                <tr class="hover">
                                                    <td>
                                                        <span class="font-mono font-semibold text-base-content">{{ manifest.manifestNumber }}</span>
                                                    </td>
                                                    <td>
                                                        {% if manifest.consignee %}
                                                            <span class="text-sm text-base-content">{{ manifest.consignee.businessName }}</span>
                                                        {% else %}
                                                            <span class="text-sm text-base-content/40">-</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <span class="text-sm text-base-content">{{ manifest.vesselName }}</span>
                                                    </td>
                                                    <td>
                                                        {% if item.all_edos_paid %}
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="badge badge-success badge-sm gap-1">
                                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                                    {{ item.containers_with_edo }}/{{ item.total_containers }}
                                                                </span>
                                                                <span class="text-xs text-success font-medium">All Paid</span>
                                                            </div>
                                                        {% elseif item.all_edos_generated %}
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="badge badge-success badge-sm gap-1">
                                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                                    {{ item.containers_with_edo }}/{{ item.total_containers }}
                                                                </span>
                                                                {% if item.edos_paid > 0 %}
                                                                    <span class="badge badge-info badge-xs">{{ item.edos_paid }} paid</span>
                                                                {% endif %}
                                                            </div>
                                                        {% elseif item.containers_with_edo > 0 %}
                                                            <div class="flex flex-col gap-1">
                                                                <div class="flex items-center gap-1.5">
                                                                    <span class="badge badge-warning badge-sm">
                                                                        {{ item.containers_with_edo }}/{{ item.total_containers }} eDOs
                                                                    </span>
                                                                    {% if item.edos_paid > 0 %}
                                                                        <span class="badge badge-info badge-xs">{{ item.edos_paid }} paid</span>
                                                                    {% endif %}
                                                                </div>
                                                                <div class="w-16 bg-base-300 rounded-full h-1">
                                                                    <div class="bg-warning h-1 rounded-full" style="width: {{ item.edo_progress }}%"></div>
                                                                </div>
                                                            </div>
                                                        {% else %}
                                                            <span class="badge badge-info badge-sm">{{ item.total_containers }}</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if item.containers_with_edo > 0 %}
                                                            {% if item.all_edos_paid %}
                                                                <span class="badge badge-success badge-lg gap-2">
                                                                    <span class="icon-[tabler--check] size-3"></span>
                                                                    All Paid
                                                                </span>
                                                            {% elseif item.edos_paid > 0 %}
                                                                <span class="badge badge-info badge-lg gap-2">
                                                                    <span class="icon-[tabler--file-check] size-3"></span>
                                                                    {{ item.edos_paid }}/{{ item.containers_with_edo }} Paid
                                                                </span>
                                                            {% else %}
                                                                <span class="badge badge-warning badge-lg gap-2">
                                                                    <span class="icon-[tabler--clock] size-3"></span>
                                                                    Pending
                                                                </span>
                                                            {% endif %}
                                                        {% else %}
                                                            <span class="badge badge-ghost badge-lg">N/A</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('broker_manifest_detail', {'id': manifest.id}) }}" 
                                                           class="btn btn-ghost btn-sm gap-2">
                                                            <span class="icon-[tabler--eye] size-4"></span>
                                                            View
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                
                                {% if manifests|length > 5 %}
                                    <div class="mt-4 text-center">
                                        <a href="{{ path('broker_manifest_list') }}" class="btn btn-outline btn-primary btn-sm gap-2">
                                            View All NOAs
                                            <span class="icon-[tabler--arrow-right] size-4"></span>
                                        </a>
                                    </div>
                                {% endif %}
                            {% else %}
                                <div class="text-center py-12">
                                    <div class="size-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <span class="icon-[tabler--file-off] size-8 text-base-content/40"></span>
                                    </div>
                                    <p class="text-base-content/60">No NOAs found</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Recent Shipments -->
                    {% if recentShipments is defined and recentShipments|length > 0 %}
                        <div class="card bg-base-100 shadow-sm">
                            <div class="card-body p-6">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="icon-[tabler--package] size-6 text-info"></span>
                                    <h2 class="text-xl font-bold text-base-content">Recent Shipments</h2>
                                </div>
                                
                                <div class="space-y-3">
                                    {% for shipment in recentShipments|slice(0, 5) %}
                                        <div class="flex items-center justify-between p-4 bg-base-200 rounded-xl hover:bg-base-300 transition-colors">
                                            <div class="flex items-center gap-4">
                                                <div class="size-10 bg-info/10 rounded-lg flex items-center justify-center">
                                                    <span class="icon-[tabler--box] size-5 text-info"></span>
                                                </div>
                                                <div>
                                                    <p class="font-mono font-semibold text-base-content">{{ shipment.containerNumber }}</p>
                                                    <p class="text-sm text-base-content/60">{{ shipment.manifest.vesselName }}</p>
                                                </div>
                                            </div>
                                            <a href="{{ path('shipment_detail', {'id': shipment.id}) }}" 
                                               class="btn btn-ghost btn-sm">
                                                <span class="icon-[tabler--arrow-right] size-4"></span>
                                            </a>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Claimable Shipments -->
                    {% if claimableShipments is defined and claimableShipments|length > 0 %}
                        <div class="card bg-base-100 shadow-sm">
                            <div class="card-body p-6">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="icon-[tabler--hand-grab] size-6 text-accent"></span>
                                    <h2 class="text-xl font-bold text-base-content">Claimable Shipments</h2>
                                    <span class="badge badge-accent badge-lg ml-auto">{{ claimableShipments|length }}</span>
                                </div>
                                
                                <div class="space-y-3">
                                    {% for shipment in claimableShipments|slice(0, 5) %}
                                        <div class="flex items-center justify-between p-4 bg-base-200 rounded-xl hover:bg-base-300 transition-colors">
                                            <div class="flex items-center gap-4">
                                                <div class="size-10 bg-accent/10 rounded-lg flex items-center justify-center">
                                                    <span class="icon-[tabler--package] size-5 text-accent"></span>
                                                </div>
                                                <div>
                                                    <p class="font-mono font-semibold text-base-content">{{ shipment.containerNumber }}</p>
                                                    <p class="text-sm text-base-content/60">{{ shipment.consigneeName }}</p>
                                                </div>
                                            </div>
                                            <form method="POST" action="{{ path('broker_claim_shipment', {'id': shipment.id}) }}" class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('claim_shipment_' ~ shipment.id) }}">
                                                <button type="submit" class="btn btn-accent btn-sm gap-2">
                                                    <span class="icon-[tabler--hand-grab] size-4"></span>
                                                    Claim
                                                </button>
                                            </form>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <!-- Sidebar (1/3 width) -->
                <div class="space-y-6">
                    <!-- Quick Actions -->
                    <div class="card bg-base-100 shadow-sm">
                        <div class="card-body p-6">
                            <h3 class="text-lg font-bold text-base-content mb-4">Quick Actions</h3>
                            
                            <div class="space-y-2">
                                <a href="{{ path('manifest_workflow_create') }}" 
                                   class="btn btn-primary w-full justify-start gap-3">
                                    <span class="icon-[tabler--upload] size-5"></span>
                                    Upload Manifest
                                </a>
                                
                                <a href="{{ path('broker_edo_list_page') }}" 
                                   class="btn btn-ghost w-full justify-start gap-3">
                                    <span class="icon-[tabler--file-download] size-5"></span>
                                    View eDOs
                                </a>
                                
                                <a href="{{ path('broker_manifest_list') }}" 
                                   class="btn btn-ghost w-full justify-start gap-3">
                                    <span class="icon-[tabler--list] size-5"></span>
                                    All Manifests
                                </a>
                                
                                {% if activeWorkspace %}
                                    <a href="{{ path('broker_workspace_selector') }}" 
                                       class="btn btn-ghost w-full justify-start gap-3">
                                        <span class="icon-[tabler--switch-horizontal] size-5"></span>
                                        Switch Workspace
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Workspace Info -->
                    {% if activeWorkspace %}
                        <div class="card bg-base-100 shadow-sm">
                            <div class="card-body p-6">
                                <h3 class="text-lg font-bold text-base-content mb-4">Workspace Info</h3>
                                
                                <div class="space-y-4">
                                    <div>
                                        <p class="text-xs text-base-content/50 uppercase tracking-wide mb-1">Name</p>
                                        <p class="font-semibold text-base-content">{{ activeWorkspace.name }}</p>
                                    </div>
                                    
                                    {% if activeWorkspace.description %}
                                        <div>
                                            <p class="text-xs text-base-content/50 uppercase tracking-wide mb-1">Description</p>
                                            <p class="text-sm text-base-content/70">{{ activeWorkspace.description }}</p>
                                        </div>
                                    {% endif %}
                                    
                                    <div>
                                        <p class="text-xs text-base-content/50 uppercase tracking-wide mb-1">Members</p>
                                        <p class="font-semibold text-base-content">{{ activeWorkspace.members|length }}</p>
                                    </div>
                                    
                                    <div>
                                        <p class="text-xs text-base-content/50 uppercase tracking-wide mb-1">Created</p>
                                        <p class="text-sm text-base-content/70">{{ activeWorkspace.createdAt|date('M d, Y') }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Info Box -->
                    <div class="card bg-info/10 shadow-sm">
                        <div class="card-body p-6">
                            <div class="flex items-start gap-3">
                                <span class="icon-[tabler--info-circle] size-6 text-info flex-shrink-0 mt-0.5"></span>
                                <div>
                                    <h4 class="font-bold text-info mb-2">Need Help?</h4>
                                    <p class="text-sm text-info/80 mb-3">
                                        Contact support for assistance with manifests, payments, or eDO downloads.
                                    </p>
                                    <a href="mailto:support@optimus.com" class="btn btn-info btn-sm gap-2">
                                        <span class="icon-[tabler--help] size-4"></span>
                                        Get Support
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
    // Auto-dismiss flash messages after 5 seconds
    document.addEventListener('DOMContentLoaded', function() {
        const alerts = document.querySelectorAll('.toast .alert');
        alerts.forEach(alert => {
            setTimeout(() => {
                alert.style.opacity = '0';
                alert.style.transition = 'opacity 0.3s ease';
                setTimeout(() => alert.remove(), 300);
            }, 5000);
        });
    });
</script>

{% endblock %}
