{% extends 'base.html.twig' %}

{% block title %}Accounting Dashboard - OPTIMUS{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50 to-gray-50">
    <!-- Professional Header with Gradient -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-700 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="py-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-white">Accounting Dashboard</h1>
                        <p class="mt-2 text-blue-100">Payment Validation & Financial Operations</p>
                    </div>
                    <div class="hidden md:flex items-center space-x-4">
                        <div class="text-right">
                            <p class="text-sm text-blue-100">Last Updated</p>
                            <p class="text-white font-medium">{{ "now"|date("M d, Y H:i") }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Payment Type Tabs -->
        <div class="mb-8">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="border-b border-gray-200">
                    <nav class="flex -mb-px">
                        <button onclick="switchTab('billing')" id="tab-billing" class="payment-tab active flex-1 py-4 px-6 text-center border-b-2 font-medium text-sm transition-colors">
                            <div class="flex items-center justify-center">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                Billing Payments
                            </div>
                        </button>
                        <button onclick="switchTab('edo')" id="tab-edo" class="payment-tab flex-1 py-4 px-6 text-center border-b-2 font-medium text-sm transition-colors">
                            <div class="flex items-center justify-center">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                </svg>
                                eDO Access Payments
                            </div>
                        </button>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Billing Payments Section -->
        <div id="section-billing" class="payment-section">
            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <!-- Pending -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-orange-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-orange-600 bg-orange-50 px-3 py-1 rounded-full">PENDING</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Pending Validation</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.edo_pending_count }}</p>
                    <p class="text-xs text-gray-500 mt-2">Requires immediate attention</p>
                </div>

                <!-- Verified Today -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-green-400 to-green-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-green-600 bg-green-50 px-3 py-1 rounded-full">TODAY</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Verified Today</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.edo_verified_today }}</p>
                    <p class="text-xs text-gray-500 mt-2">Processed by you</p>
                </div>

                <!-- Total Verified -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-blue-400 to-blue-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1 rounded-full">TOTAL</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Total Verified</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.edo_total_verified }}</p>
                    <p class="text-xs text-gray-500 mt-2">All time records</p>
                </div>

                <!-- Rejected -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-red-400 to-red-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-red-600 bg-red-50 px-3 py-1 rounded-full">REJECTED</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Total Rejected</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.edo_rejected_count }}</p>
                    <p class="text-xs text-gray-500 mt-2">All time records</p>
                </div>
            </div>

            <!-- Payment Lists -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Pending -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-orange-50 to-orange-100 px-6 py-4 border-b border-orange-200">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">Pending Validation</h3>
                                <p class="text-sm text-gray-600 mt-1">{{ pendingEdoPayments|length }} payments awaiting review</p>
                            </div>
                            <a href="{{ path('admin_edo_payments_index') }}" class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">
                                View All →
                            </a>
                        </div>
                    </div>
                    <div class="p-6">
                        {% if pendingEdoPayments|length > 0 %}
                            <div class="space-y-3 max-h-96 overflow-y-auto">
                                {% for edoPayment in pendingEdoPayments %}
                                    <div class="bg-gray-50 rounded-lg p-4 hover:bg-gray-100 transition-colors border border-gray-200">
                                        <div class="flex items-start justify-between mb-3">
                                            <div class="flex-1">
                                                <div class="flex items-center mb-2">
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-orange-100 text-orange-800 mr-2">
                                                        PENDING
                                                    </span>
                                                    <h4 class="text-sm font-semibold text-gray-900">{{ edoPayment.manifest.manifestNumber }}</h4>
                                                </div>
                                                <p class="text-sm text-gray-600">{{ edoPayment.manifest.broker.fullName }}</p>
                                            </div>
                                        </div>
                                        
                                        <div class="grid grid-cols-2 gap-3 text-xs text-gray-600 mb-3">
                                            <div>
                                                <span class="font-medium">Amount:</span>
                                                <span class="text-gray-900 font-semibold">₱{{ edoPayment.amount|number_format(2) }}</span>
                                            </div>
                                            <div>
                                                <span class="font-medium">Submitted:</span>
                                                <span class="text-gray-900">{{ edoPayment.createdAt|date('M j, H:i') }}</span>
                                            </div>
                                        </div>
                                        
                                        <a href="{{ path('admin_edo_payments_index') }}" 
                                           class="block w-full text-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium shadow-sm">
                                            Review Payment
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-center py-12">
                                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-sm font-medium text-gray-900 mb-1">All Clear!</h3>
                                <p class="text-sm text-gray-500">No pending billing payments</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Recently Validated -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-green-50 to-green-100 px-6 py-4 border-b border-green-200">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Recently Validated</h3>
                            <p class="text-sm text-gray-600 mt-1">Your recent validations</p>
                        </div>
                    </div>
                    <div class="p-6">
                        {% if recentlyValidatedEdoPayments|length > 0 %}
                            <div class="space-y-3 max-h-96 overflow-y-auto">
                                {% for edoPayment in recentlyValidatedEdoPayments %}
                                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                        <div class="flex items-start justify-between mb-3">
                                            <div class="flex-1">
                                                <div class="flex items-center mb-2">
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-green-100 text-green-800 mr-2">
                                                        VERIFIED
                                                    </span>
                                                    <h4 class="text-sm font-semibold text-gray-900">{{ edoPayment.manifest.manifestNumber }}</h4>
                                                </div>
                                                <p class="text-sm text-gray-600">{{ edoPayment.manifest.broker.fullName }}</p>
                                            </div>
                                        </div>
                                        
                                        <div class="grid grid-cols-2 gap-3 text-xs text-gray-600">
                                            <div>
                                                <span class="font-medium">Amount:</span>
                                                <span class="text-gray-900 font-semibold">₱{{ edoPayment.amount|number_format(2) }}</span>
                                            </div>
                                            <div>
                                                <span class="font-medium">Validated:</span>
                                                <span class="text-gray-900">{{ edoPayment.validatedAt|date('M j, H:i') }}</span>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-center py-12">
                                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-sm font-medium text-gray-900 mb-1">No Recent Activity</h3>
                                <p class="text-sm text-gray-500">Your validated payments will appear here</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- eDO Access Payments Section -->
        <div id="section-edo" class="payment-section hidden">
            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <!-- Pending -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-orange-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-orange-600 bg-orange-50 px-3 py-1 rounded-full">PENDING</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Pending Validation</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.pending_count }}</p>
                    <p class="text-xs text-gray-500 mt-2">Requires immediate attention</p>
                </div>

                <!-- Verified Today -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-green-400 to-green-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-green-600 bg-green-50 px-3 py-1 rounded-full">TODAY</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Verified Today</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.verified_today }}</p>
                    <p class="text-xs text-gray-500 mt-2">Processed by you</p>
                </div>

                <!-- Total Verified -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-blue-400 to-blue-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1 rounded-full">TOTAL</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Total Verified</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.total_verified }}</p>
                    <p class="text-xs text-gray-500 mt-2">All time records</p>
                </div>

                <!-- Rejected -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-all duration-200">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-red-400 to-red-600 rounded-lg flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-red-600 bg-red-50 px-3 py-1 rounded-full">REJECTED</span>
                    </div>
                    <h3 class="text-gray-600 text-sm font-medium mb-1">Total Rejected</h3>
                    <p class="text-3xl font-bold text-gray-900">{{ stats.rejected_count }}</p>
                    <p class="text-xs text-gray-500 mt-2">All time records</p>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <div>
                        <h3 class="text-lg font-medium text-gray-900">Pending Billing Payments</h3>
                        <p class="text-sm text-gray-500">Shipping line billing payments awaiting validation</p>
                    </div>
                    <a href="{{ path('admin_edo_payments_index') }}" class="text-sm text-blue-600 hover:text-blue-800 font-medium">View All</a>
                </div>
                <div class="p-6">
                    {% if pendingEdoPayments|length > 0 %}
                        <div class="space-y-4 max-h-96 overflow-y-auto">
                            {% for edoPayment in pendingEdoPayments %}
                                <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                                    <div class="flex items-center justify-between mb-3">
                                        <div>
                                            <h4 class="text-sm font-medium text-gray-900">{{ edoPayment.manifest.manifestNumber }}</h4>
                                            <p class="text-sm text-gray-500">{{ edoPayment.manifest.broker.fullName }}</p>
                                        </div>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                            Pending
                                        </span>
                                    </div>
                                    
                                    <div class="text-sm text-gray-600 space-y-1 mb-3">
                                        <div>Amount: ₱{{ edoPayment.amount|number_format(2) }}</div>
                                        <div>Manifest: {{ edoPayment.manifest.manifestNumber }}</div>
                                        <div>Submitted: {{ edoPayment.createdAt|date('M j, Y H:i') }}</div>
                                    </div>
                                    
                                    <a href="{{ path('admin_edo_payments_index') }}" 
                                       class="block w-full text-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors text-sm font-medium">
                                        View & Validate
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No pending billing payments</h3>
                            <p class="mt-1 text-sm text-gray-500">All billing payments have been processed.</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Recently Validated Billing Payments -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Recently Validated Billing Payments</h3>
                    <p class="text-sm text-gray-500">Billing payments validated by you</p>
                </div>
                <div class="p-6">
                    {% if recentlyValidatedEdoPayments|length > 0 %}
                        <div class="space-y-4 max-h-96 overflow-y-auto">
                            {% for edoPayment in recentlyValidatedEdoPayments %}
                                <div class="border border-gray-200 rounded-lg p-4">
                                    <div class="flex items-center justify-between mb-3">
                                        <div>
                                            <h4 class="text-sm font-medium text-gray-900">{{ edoPayment.manifest.manifestNumber }}</h4>
                                            <p class="text-sm text-gray-500">{{ edoPayment.manifest.broker.fullName }}</p>
                                        </div>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Verified
                                        </span>
                                    </div>
                                    
                                    <div class="text-sm text-gray-600 space-y-1">
                                        <div>Amount: ₱{{ edoPayment.amount|number_format(2) }}</div>
                                        <div>Manifest: {{ edoPayment.manifest.manifestNumber }}</div>
                                        <div>Validated: {{ edoPayment.validatedAt|date('M j, Y H:i') }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No validated billing payments</h3>
                            <p class="mt-1 text-sm text-gray-500">Your validated billing payments will appear here.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Section Header: eDO Access Payments -->
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900">eDO Access Payments</h2>
            <p class="text-gray-600">Broker payments for Electronic Delivery Order access and download</p>
        </div>

        <!-- eDO Payment Statistics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <!-- Pending eDO Payments -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Pending Verifications</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.pending_count }}</p>
                        <p class="text-xs text-orange-600 font-medium">Requires attention</p>
                    </div>
                </div>
            </div>

            <!-- Verified Today -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Verified Today</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.verified_today }}</p>
                        <p class="text-xs text-green-600 font-medium">By you</p>
                    </div>
                </div>
            </div>

            <!-- Total Verified -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total Verified</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.total_verified }}</p>
                        <p class="text-xs text-blue-600 font-medium">All time</p>
                    </div>
                </div>
            </div>

            <!-- Rejected Payments -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total Rejected</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.rejected_count }}</p>
                        <p class="text-xs text-red-600 font-medium">All time</p>
                    </div>
                </div>
            </div>
        </div>

            <!-- Pending eDO Payments -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Pending eDO Access</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.pending_count }}</p>
                        <p class="text-xs text-orange-600 font-medium">Requires validation</p>
                    </div>
                </div>
            </div>

            <!-- Verified eDO Today -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">eDO Verified Today</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.verified_today }}</p>
                        <p class="text-xs text-green-600 font-medium">By you</p>
                    </div>
                </div>
            </div>

            <!-- Total eDO Verified -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">Total eDO Verified</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.total_verified }}</p>
                        <p class="text-xs text-blue-600 font-medium">All time</p>
                    </div>
                </div>
            </div>

            <!-- Rejected eDO Payments -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600">eDO Rejected</p>
                        <p class="text-3xl font-bold text-gray-900">{{ stats.rejected_count }}</p>
                        <p class="text-xs text-red-600 font-medium">All time</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- eDO Access Payment Lists -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Pending eDO Access Payments -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <div>
                        <h3 class="text-lg font-medium text-gray-900">Pending eDO Access Payments</h3>
                        <p class="text-sm text-gray-500">Payments for eDO download access awaiting validation</p>
                    </div>
                    <a href="{{ path('payment_list') }}" class="text-sm text-blue-600 hover:text-blue-800 font-medium">View All</a>
                </div>
                <div class="p-6">
                    {% if pendingPayments|length > 0 %}
                        <div class="space-y-4 max-h-96 overflow-y-auto">
                            {% for payment in pendingPayments %}
                                <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                                    <div class="flex items-center justify-between mb-3">
                                        <div>
                                            <h4 class="text-sm font-medium text-gray-900">{{ payment.shipment.manifestNumber }}</h4>
                                            <p class="text-sm text-gray-500">{{ payment.broker.fullName }}</p>
                                        </div>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                            Pending
                                        </span>
                                    </div>
                                    
                                    <div class="text-sm text-gray-600 space-y-1 mb-3">
                                        <div>Broker: {{ payment.broker.email }}</div>
                                        <div>Submitted: {{ payment.createdAt|date('M j, Y H:i') }}</div>
                                        <div>Notice of Arrival: {{ payment.shipment.noticeOfArrivalDate|date('M j, Y') }}</div>
                                    </div>
                                    
                                    <a href="{{ path('payment_verify', {paymentId: payment.id}) }}" 
                                       class="block w-full text-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors text-sm font-medium">
                                        Review Payment
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No pending eDO access payments</h3>
                            <p class="mt-1 text-sm text-gray-500">All eDO access payments have been processed.</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Recently Validated eDO Access Payments -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Recently Validated eDO Access Payments</h3>
                    <p class="text-sm text-gray-500">eDO access payments validated by you</p>
                </div>
                <div class="p-6">
                    {% if recentlyVerified|length > 0 %}
                        <div class="space-y-4 max-h-96 overflow-y-auto">
                            {% for payment in recentlyVerified %}
                                <div class="border border-gray-200 rounded-lg p-4">
                                    <div class="flex items-center justify-between mb-3">
                                        <div>
                                            <h4 class="text-sm font-medium text-gray-900">{{ payment.shipment.manifestNumber }}</h4>
                                            <p class="text-sm text-gray-500">{{ payment.broker.fullName }}</p>
                                        </div>
                                        <div class="text-right">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                Verified
                                            </span>
                                            {% if payment.edo %}
                                                <div class="mt-1">
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                                                        EDO Generated
                                                    </span>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    
                                    <div class="text-sm text-gray-600 space-y-1">
                                        <div>Broker: {{ payment.broker.email }}</div>
                                        <div>Verified: {{ payment.verifiedAt|date('M j, Y H:i') }}</div>
                                        {% if payment.edo %}
                                            <div>EDO: {{ payment.edo.edoNumber }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No validated eDO access payments</h3>
                            <p class="mt-1 text-sm text-gray-500">Your validated eDO access payments will appear here.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Payment Trends Chart -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Payment Submissions (Last 30 Days)</h3>
                    <p class="text-sm text-gray-500">Daily payment submission trends</p>
                </div>
                <div class="p-6">
                    <div id="paymentTrendsChart" style="height: 300px;"></div>
                </div>
            </div>

            <!-- Verification Trends Chart -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Verification Activity (Last 30 Days)</h3>
                    <p class="text-sm text-gray-500">Daily verification processing trends</p>
                </div>
                <div class="p-6">
                    <div id="verificationTrendsChart" style="height: 300px;"></div>
                </div>
            </div>
        </div>

        <!-- Additional Charts Row -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <!-- Payment Status Distribution -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Payment Status Distribution</h3>
                    <p class="text-sm text-gray-500">Overall payment status breakdown</p>
                </div>
                <div class="p-6">
                    <div id="statusDistributionChart" style="height: 300px;"></div>
                </div>
            </div>

            <!-- Top Brokers -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Top Brokers (Last 30 Days)</h3>
                    <p class="text-sm text-gray-500">Most active brokers by payment volume</p>
                </div>
                <div class="p-6">
                    <div id="topBrokersChart" style="height: 300px;"></div>
                </div>
            </div>

            <!-- Monthly Performance -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-medium text-gray-900">Monthly Performance</h3>
                    <p class="text-sm text-gray-500">6-month verification performance</p>
                </div>
                <div class="p-6">
                    <div id="monthlyPerformanceChart" style="height: 300px;"></div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="mt-8 bg-white rounded-lg shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Quick Actions</h3>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% if pendingEdoPayments|length > 0 %}
                        <a href="{{ path('admin_edo_payments_index') }}" 
                           class="flex-1 inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Review Billing Payments
                        </a>
                    {% endif %}
                    
                    {% if pendingPayments|length > 0 %}
                        <a href="{{ path('payment_verify', {paymentId: pendingPayments[0].id}) }}" 
                           class="flex-1 inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Review Next eDO Payment
                        </a>
                    {% endif %}
                    
                    <a href="{{ path('payment_list') }}" 
                       class="flex-1 inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                        View All eDO Payments
                    </a>
                    
                    <a href="{{ path('admin_edo_payments_index') }}" 
                       class="flex-1 inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                        View All Billing Payments
                    </a>
                    
                    <a href="{{ path('app_accounting_dashboard_new') }}" 
                       class="flex-1 inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        Refresh Dashboard
                    </a>

                    <button onclick="exportDashboardData()" 
                            class="flex-1 inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Export Data
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Chart data from backend
    const chartData = {{ chartData|json_encode|raw }};
    
    // Debug: Log the chart data to see what we're working with
    console.log('Chart Data:', chartData);
    
    // Check if chartData exists and has required properties
    if (!chartData) {
        console.error('Chart data is not available');
        return;
    }
    
    // Payment Trends Chart
    try {
        const paymentData = chartData.paymentTrends || [];
        console.log('Payment Trends Data:', paymentData);
        
        const paymentTrendsOptions = {
            series: [{
                name: 'Payment Submissions',
                data: paymentData.length > 0 ? paymentData : []
            }],
            chart: {
                type: 'area',
                height: 300,
                toolbar: {
                    show: false
                }
            },
            colors: ['#3B82F6'],
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.7,
                    opacityTo: 0.3,
                }
            },
            stroke: {
                curve: 'smooth',
                width: 2
            },
            xaxis: {
                type: paymentData.length > 0 ? 'datetime' : 'category',
                labels: {
                    format: 'MMM dd'
                }
            },
            yaxis: {
                title: {
                    text: 'Number of Payments'
                }
            },
            tooltip: {
                x: {
                    format: 'MMM dd, yyyy'
                }
            },
            noData: {
                text: 'No payment data available'
            }
        };
        new ApexCharts(document.querySelector("#paymentTrendsChart"), paymentTrendsOptions).render();
    } catch (error) {
        console.error('Error rendering payment trends chart:', error);
    }

    // Verification Trends Chart
    try {
        const verificationData = chartData.verificationTrends || [];
        console.log('Verification Trends Data:', verificationData);
        
        const verificationTrendsOptions = {
            series: [{
                name: 'Verifications',
                data: verificationData.length > 0 ? verificationData : []
            }],
            chart: {
                type: 'line',
                height: 300,
                toolbar: {
                    show: false
                }
            },
            colors: ['#10B981'],
            stroke: {
                curve: 'smooth',
                width: 3
            },
            xaxis: {
                type: verificationData.length > 0 ? 'datetime' : 'category',
                labels: {
                    format: 'MMM dd'
                }
            },
            yaxis: {
                title: {
                    text: 'Number of Verifications'
                }
            },
            tooltip: {
                x: {
                    format: 'MMM dd, yyyy'
                }
            },
            noData: {
                text: 'No verification data available'
            }
        };
        new ApexCharts(document.querySelector("#verificationTrendsChart"), verificationTrendsOptions).render();
    } catch (error) {
        console.error('Error rendering verification trends chart:', error);
    }

    // Status Distribution Chart
    try {
        const statusData = chartData.statusDistribution || { labels: [], series: [] };
        console.log('Status Distribution Data:', statusData);
        
        const statusDistributionOptions = {
            series: statusData.series && statusData.series.length > 0 ? statusData.series : [1],
            chart: {
                type: 'donut',
                height: 300
            },
            labels: statusData.labels && statusData.labels.length > 0 ? statusData.labels : ['No Data'],
            colors: ['#F59E0B', '#10B981', '#EF4444'],
            legend: {
                position: 'bottom'
            },
            plotOptions: {
                pie: {
                    donut: {
                        size: '70%'
                    }
                }
            },
            noData: {
                text: 'No status data available'
            }
        };
        new ApexCharts(document.querySelector("#statusDistributionChart"), statusDistributionOptions).render();
    } catch (error) {
        console.error('Error rendering status distribution chart:', error);
    }

    // Top Brokers Chart
    try {
        const brokersData = chartData.topBrokers || { categories: [], series: [] };
        console.log('Top Brokers Data:', brokersData);
        
        const topBrokersOptions = {
            series: [{
                name: 'Payments',
                data: brokersData.series && brokersData.series.length > 0 ? brokersData.series : [0]
            }],
            chart: {
                type: 'bar',
                height: 300,
                toolbar: {
                    show: false
                }
            },
            colors: ['#8B5CF6'],
            plotOptions: {
                bar: {
                    horizontal: true,
                    borderRadius: 4
                }
            },
            xaxis: {
                categories: brokersData.categories && brokersData.categories.length > 0 ? brokersData.categories : ['No Data'],
                title: {
                    text: 'Number of Payments'
                }
            },
            yaxis: {
                title: {
                    text: 'Brokers'
                }
            },
            noData: {
                text: 'No broker data available'
            }
        };
        new ApexCharts(document.querySelector("#topBrokersChart"), topBrokersOptions).render();
    } catch (error) {
        console.error('Error rendering top brokers chart:', error);
    }

    // Monthly Performance Chart
    try {
        const monthlyData = chartData.monthlyPerformance || [];
        console.log('Monthly Performance Data:', monthlyData);
        
        const monthlyPerformanceOptions = {
            series: [{
                name: 'Verifications',
                data: monthlyData.length > 0 ? monthlyData : []
            }],
            chart: {
                type: 'column',
                height: 300,
                toolbar: {
                    show: false
                }
            },
            colors: ['#06B6D4'],
            plotOptions: {
                bar: {
                    borderRadius: 4,
                    columnWidth: '60%'
                }
            },
            xaxis: {
                type: monthlyData.length > 0 ? 'category' : 'category',
                title: {
                    text: 'Month'
                }
            },
            yaxis: {
                title: {
                    text: 'Number of Verifications'
                }
            },
            noData: {
                text: 'No monthly data available'
            }
        };
        new ApexCharts(document.querySelector("#monthlyPerformanceChart"), monthlyPerformanceOptions).render();
    } catch (error) {
        console.error('Error rendering monthly performance chart:', error);
    }
});

function exportDashboardData() {
    // Simple CSV export functionality
    const csvData = [
        ['Metric', 'Value'],
        ['Billing - Pending', '{{ stats.edo_pending_count }}'],
        ['Billing - Verified Today', '{{ stats.edo_verified_today }}'],
        ['Billing - Total Verified', '{{ stats.edo_total_verified }}'],
        ['Billing - Rejected', '{{ stats.edo_rejected_count }}'],
        ['eDO Access - Pending', '{{ stats.pending_count }}'],
        ['eDO Access - Verified Today', '{{ stats.verified_today }}'],
        ['eDO Access - Total Verified', '{{ stats.total_verified }}'],
        ['eDO Access - Rejected', '{{ stats.rejected_count }}']
    ];
    
    const csvContent = csvData.map(row => row.join(',')).join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'accounting-dashboard-' + new Date().toISOString().split('T')[0] + '.csv';
    a.click();
    window.URL.revokeObjectURL(url);
}
</script>
{% endblock %}