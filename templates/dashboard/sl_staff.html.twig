{% extends 'base.html.twig' %}

{% block title %}SL-Staff Dashboard - OPTIMUS{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="{{ asset('js/edo-generation-progress.js') }}"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen">
    <div class="bg-base-200/50 border-b border-base-content/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="rounded-3xl border border-primary/20 bg-gradient-to-br from-primary/15 via-base-100 to-base-100 shadow-sm p-5 sm:p-7">
                <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
                    <div class="space-y-3">
                        <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
                            <span class="icon-[tabler--layout-dashboard] size-3.5"></span>
                            SL Staff Operations
                        </span>
                        <div>
                            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-base-content leading-tight">SL Staff Dashboard</h1>
                            <p class="mt-2 text-sm sm:text-base text-base-content/70 max-w-2xl">
                                Manage daily shipping-line operations from one place: NOA activity, terminal/CY visibility, and utilization trends.
                            </p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="badge badge-primary badge-lg gap-2">
                                <span class="icon-[tabler--activity] size-4"></span>
                                {{ stats.pending_edo_count }} ready
                            </span>
                            <span class="badge badge-success badge-soft badge-lg gap-2">
                                <span class="icon-[tabler--calendar-check] size-4"></span>
                                {{ stats.my_shipments_today }} created today
                            </span>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 xl:justify-end">
                        <a href="{{ path('manifest_workflow_create') }}" class="btn btn-success btn-sm sm:btn-md gap-2">
                            <span class="icon-[tabler--plus] size-4"></span>
                            New NOA
                        </a>
                        <a href="{{ path('manifest_workflow_list') }}" class="btn btn-outline btn-primary btn-sm sm:btn-md gap-2">
                            <span class="icon-[tabler--file-text] size-4"></span>
                            NOA List
                        </a>
                        <a href="{{ path('app_sl_staff_dashboard') }}" class="btn btn-ghost btn-sm sm:btn-md gap-2">
                            <span class="icon-[tabler--refresh] size-4"></span>
                            Refresh
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="card bg-base-100 shadow-sm border border-primary/15">
                <div class="card-body p-5">
                    <p class="text-xs uppercase tracking-wide text-base-content/60">Total NOAs</p>
                    <div class="mt-2 flex items-end justify-between">
                        <p class="text-4xl font-bold">{{ stats.my_shipments_total }}</p>
                        <span class="icon-[tabler--ship] size-8 text-primary/70"></span>
                    </div>
                    <p class="text-xs text-base-content/50 mt-2">All time</p>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm border border-success/15">
                <div class="card-body p-5">
                    <p class="text-xs uppercase tracking-wide text-base-content/60">Created Today</p>
                    <div class="mt-2 flex items-end justify-between">
                        <p class="text-4xl font-bold">{{ stats.my_shipments_today }}</p>
                        <span class="icon-[tabler--clock] size-8 text-success/70"></span>
                    </div>
                    <p class="text-xs text-success mt-2">Today</p>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm border border-info/15">
                <div class="card-body p-5">
                    <p class="text-xs uppercase tracking-wide text-base-content/60">This Week</p>
                    <div class="mt-2 flex items-end justify-between">
                        <p class="text-4xl font-bold">{{ stats.my_shipments_this_week }}</p>
                        <span class="icon-[tabler--calendar] size-8 text-info/70"></span>
                    </div>
                    <p class="text-xs text-info mt-2">Last 7 days</p>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm border border-secondary/15">
                <div class="card-body p-5">
                    <p class="text-xs uppercase tracking-wide text-base-content/60">This Month</p>
                    <div class="mt-2 flex items-end justify-between">
                        <p class="text-4xl font-bold">{{ stats.my_shipments_this_month }}</p>
                        <span class="icon-[tabler--chart-bar] size-8 text-secondary/70"></span>
                    </div>
                    <p class="text-xs text-secondary mt-2">Last 30 days</p>
                </div>
            </div>
        </div>

        {% include 'dashboard/_location_summary_cards.html.twig' with {
            repositioningRoute: 'app_sl_staff_repositioning_index'
        } %}

        {% include 'dashboard/_port_cy_location_cards.html.twig' with {
            repositioningRoute: 'app_sl_staff_repositioning_index',
            repositioningNewRoute: 'app_sl_staff_repositioning_new'
        } %}

        <div class="card bg-base-100 shadow-sm">
            <div class="px-5 py-4 border-b border-base-content/10 flex items-center justify-between">
                <div>
                    <h2 class="font-semibold text-lg">NOA Creation Trend</h2>
                    <p class="text-xs text-base-content/60">Daily NOA creation for the last 30 days</p>
                </div>
                <a href="{{ path('manifest_workflow_list') }}" class="btn btn-ghost btn-sm gap-2">
                    <span class="icon-[tabler--file-text] size-4"></span>
                    View NOAs
                </a>
            </div>
            <div class="p-5">
                <div id="myShipmentTrendsChart" style="height: 300px;"></div>
            </div>
        </div>

    </div>
</div>

<script>
// Define global functions first to ensure they're available for onclick handlers
let currentManifestId = null;
let currentManifestNumber = null;

function openEDOGenerationModal(triggerButton, manifestId, manifestNumber) {
    // console.log('openEDOGenerationModal called with:', manifestId, manifestNumber);
    currentManifestId = manifestId;
    currentManifestNumber = manifestNumber;
    
    // Read container data from the clicked button
    const clickedButton = triggerButton;
    let containers = [];
    
    if (clickedButton && clickedButton.dataset.containers) {
        try {
            containers = JSON.parse(clickedButton.dataset.containers);
            // console.log('Parsed containers:', containers);
        } catch (error) {
            console.error('Error parsing container data:', error);
            // console.log('Raw container data:', clickedButton.dataset.containers);
            containers = [];
        }
    } else {
        console.warn('No container data found for manifest', manifestId);
    }
    
    document.getElementById('manifestNumberDisplay').textContent = manifestNumber;
    document.getElementById('edoGenerationModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Update container info with debug logging
    updateContainerInfo(containers);
    
    // Hide navigation
    const topNav = document.querySelector('nav');
    const sidebar = document.querySelector('aside');
    if (topNav) topNav.style.display = 'none';
    if (sidebar) sidebar.style.display = 'none';
    
    // Set minimum date to today
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('expirationDate').setAttribute('min', today);
}

function updateContainerInfo(containers) {
    const containerListElement = document.getElementById('containerList');
    const containerCountElement = document.getElementById('containerCount');
    
    // console.log('updateContainerInfo called with:', containers);
    
    if (containers && Array.isArray(containers) && containers.length > 0) {
        containerCountElement.textContent = containers.length;
        
        // Create container list HTML
        const containerItems = containers.map(container => {
            const containerNumber = container.containerNumber || 'Unknown';
            const size = container.size || 'N/A';
            const type = container.type || 'N/A';
            
            return `
                <div class="flex items-center justify-between py-2 px-3 bg-base-200 rounded-box">
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 bg-info/10 rounded-full flex items-center justify-center">
                            <span class="icon-[tabler--box] size-5 text-info"></span>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-base-content">${containerNumber}</p>
                            <p class="text-xs text-base-content/50">${size} • ${type}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="badge badge-soft badge-success badge-sm">
                            Will get eDO
                        </span>
                    </div>
                </div>
            `;
        }).join('');
        
        containerListElement.innerHTML = containerItems;
        // console.log('Container list updated with', containers.length, 'containers');
    } else {
        containerCountElement.textContent = '0';
        containerListElement.innerHTML = '<p class="text-sm text-base-content/50 text-center py-4">No containers found</p>';
        console.warn('No valid container data provided:', containers);
    }
}

function closeEDOGenerationModal() {
    document.getElementById('edoGenerationModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
    document.getElementById('expirationDate').value = '';
    document.getElementById('expirationDays').value = '';
    currentManifestId = null;
    currentManifestNumber = null;
    
    // Restore navigation
    const topNav = document.querySelector('nav');
    const sidebar = document.querySelector('aside');
    if (topNav) topNav.style.display = '';
    if (sidebar) sidebar.style.display = '';
}

function calculateExpirationDays() {
    const expirationDate = document.getElementById('expirationDate').value;
    if (expirationDate) {
        const today = new Date();
        const expDate = new Date(expirationDate);
        const diffTime = expDate - today;
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        document.getElementById('expirationDays').value = diffDays > 0 ? diffDays : 0;
    }
}

function generateEDO() {
    const expirationDate = document.getElementById('expirationDate').value;
    const manifestId = currentManifestId;
    
    if (!expirationDate) {
        alert('Please select an expiration date');
        return;
    }
    
    const today = new Date().toISOString().split('T')[0];
    if (expirationDate <= today) {
        alert('Expiration date must be in the future');
        return;
    }
    
    const submitBtn = document.getElementById('edoGenerateBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg class="animate-spin h-5 w-5 inline-block mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Generating...';
    
    closeEDOGenerationModal();
    
    // Use the professional progress controller
    if (window.edoProgressController) {
        window.edoProgressController.startGeneration(manifestId, expirationDate, 'manifest');
    } else {
        console.error('EDO Progress Controller not initialized');
        alert('Error: Progress controller not available');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="icon-[tabler--plus] size-5 inline-block mr-2"></span>Generate eDO';
    }
}


// Close modal on escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeEDOGenerationModal();
    }
});

// console.log('Global functions defined. openEDOGenerationModal type:', typeof openEDOGenerationModal);

document.addEventListener('DOMContentLoaded', function() {
    // Chart data from backend
    const chartData = {{ chartData|json_encode|raw }};
    
    // Debug: Log the chart data (uncomment for debugging)
    // console.log('SL-Staff Chart Data:', chartData);
    
    // My Shipment Trends Chart
    try {
        const myShipmentData = chartData.myShipmentTrends || [];
        
        const myShipmentTrendsOptions = {
            series: [{
                name: 'NOAs Created',
                data: myShipmentData.length > 0 ? myShipmentData : []
            }],
            chart: {
                type: 'area',
                height: 300,
                toolbar: {
                    show: false
                },
                // Disable all touch interactions to prevent passive event listener warnings
                selection: {
                    enabled: false
                },
                zoom: {
                    enabled: false
                },
                pan: {
                    enabled: false
                }
            },
            colors: ['#3B82F6'],
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.7,
                    opacityTo: 0.3,
                }
            },
            stroke: {
                curve: 'smooth',
                width: 2
            },
            xaxis: {
                type: myShipmentData.length > 0 ? 'datetime' : 'category',
                labels: {
                    format: 'MMM dd'
                }
            },
            yaxis: {
                title: {
                    text: 'Number of NOAs'
                }
            },
            tooltip: {
                x: {
                    format: 'MMM dd, yyyy'
                }
            },
            noData: {
                text: 'No NOA data available'
            },
            // Disable animations and interactions to reduce event listeners
            animations: {
                enabled: false
            },
            // Disable all interactive features that might use touch events
            dataLabels: {
                enabled: false
            },
            markers: {
                hover: {
                    size: undefined
                }
            }
        };
        new ApexCharts(document.querySelector("#myShipmentTrendsChart"), myShipmentTrendsOptions).render();
    } catch (error) {
        console.error('Error rendering NOA trends chart:', error);
    }
});

</script>

<!-- eDO Generation Modal -->
<div id="edoGenerationModal" class="hidden fixed inset-0 z-[9999] overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-black/75 transition-opacity" aria-hidden="true" onclick="closeEDOGenerationModal()"></div>

        <!-- Center modal -->
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div class="inline-block align-middle bg-base-100 rounded-box text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:max-w-4xl sm:w-full">
            <div class="bg-base-100 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-success/10 sm:mx-0 sm:h-10 sm:w-10">
                        <span class="icon-[tabler--file-text] size-5 text-success"></span>
                    </div>
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left flex-1">
                        <h3 class="text-lg leading-6 font-medium text-base-content" id="modal-title">
                            Generate eDOs per Container
                        </h3>
                        <div class="mt-4">
                            <p class="text-sm text-base-content/50 mb-4">
                                Generate Electronic Delivery Orders for each container in manifest: <span class="font-semibold text-base-content" id="manifestNumberDisplay"></span>
                            </p>

                            <!-- Container List Section -->
                            <div class="mb-6 p-4 bg-info/10 rounded-box">
                                <div class="flex items-center justify-between mb-3">
                                    <h4 class="text-sm font-medium text-info">Containers to Generate eDOs</h4>
                                    <span class="badge badge-soft badge-info">
                                        <span id="containerCount">0</span> containers
                                    </span>
                                </div>
                                <div id="containerList" class="space-y-2 max-h-32 overflow-y-auto">
                                    <!-- Container items will be populated by JavaScript -->
                                </div>
                            </div>

                            <div class="space-y-4">
                                <div>
                                    <label for="expirationDate" class="label-text font-medium mb-2 block">
                                        eDO Expiration Date
                                        <span class="text-error">*</span>
                                    </label>
                                    <input type="date" id="expirationDate" onchange="calculateExpirationDays()" required
                                           class="input input-bordered w-full">
                                    <p class="mt-1 text-xs text-base-content/50">Select when these eDOs should expire</p>
                                </div>

                                <div>
                                    <label for="expirationDays" class="label-text font-medium mb-2 block">
                                        Days Until Expiration
                                    </label>
                                    <input type="number" id="expirationDays" readonly
                                           class="input input-bordered w-full">
                                    <p class="mt-1 text-xs text-base-content/50">Automatically calculated from expiration date</p>
                                </div>
                            </div>

                            <div class="mt-4 p-3 bg-info/10 rounded-box">
                                <div class="flex">
                                    <span class="icon-[tabler--info-circle] size-5 text-info flex-shrink-0"></span>
                                    <div class="ml-2">
                                        <p class="text-sm font-medium text-info">What happens next?</p>
                                        <ul class="mt-1 text-xs text-info list-disc list-inside space-y-1">
                                            <li>One eDO will be generated per container</li>
                                            <li>Each eDO will have a unique number</li>
                                            <li>PDF documents will be created for each eDO</li>
                                            <li>Broker and consignee will be notified</li>
                                            <li>Each eDO status will be PENDING_RELEASE</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-base-200 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse gap-3">
                <button type="button" id="edoGenerateBtn" onclick="generateEDO()"
                        class="btn btn-success">
                    <span class="icon-[tabler--plus] size-5"></span>
                    Generate eDOs
                </button>
                <button type="button" onclick="closeEDOGenerationModal()"
                        class="btn btn-ghost">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Include the professional eDO Generation Progress Modal -->
{% include 'edo/modals/generation_progress.html.twig' %}

{% endblock %}
