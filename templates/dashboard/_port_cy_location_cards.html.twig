{# Shared Port/Terminal and CY location cards for SL Staff & Shipping Admin dashboards #}
{% if portLocations is defined and portLocations|length > 0 %}
<div class="card bg-base-100 shadow-sm mb-8">
    <div class="px-6 py-4 flex flex-wrap justify-between items-center gap-3 border-b border-primary/10 bg-primary/5 rounded-t-box">
        <div>
            <h3 class="text-lg font-medium text-base-content flex items-center gap-2">
                <span class="icon-[tabler--anchor] size-5 text-primary"></span>
                Port / Terminal Locations
            </h3>
            <p class="text-sm text-base-content/60">Laden inbound, at-port, and CY-to-port transfer volume by discharge terminal</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="badge badge-primary badge-lg">{{ portLocations|length }} Ports</span>
            {% if repositioningRoute is defined %}
            <a href="{{ path(repositioningRoute) }}" class="btn btn-primary btn-sm gap-1">
                <span class="icon-[tabler--truck-delivery] size-4"></span>
                Repositioning Requests
            </a>
            {% endif %}
        </div>
    </div>
    <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for location in portLocations %}
            <div class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 border border-primary/20">
                <div class="card-body p-5">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3 flex-1 min-w-0">
                            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                <span class="icon-[tabler--anchor] size-6 text-primary"></span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h4 class="font-bold text-base text-base-content truncate">{{ location.terminal.name }}</h4>
                                <p class="text-xs text-base-content/60 truncate">
                                    <span class="badge badge-primary badge-xs mr-1">TERMINAL</span>
                                    {{ location.terminal.code }}
                                    {% if location.terminal.region %} · {{ location.terminal.region.name }}{% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                    {% for size, label in {'20ft': '20ft', '40ft': '40ft'} %}
                    <div class="{{ not loop.last ? 'mb-4' : '' }}">
                        <div class="flex items-center justify-between mb-3">
                            <h5 class="text-sm font-bold text-base-content">{{ label }} Containers</h5>
                            <span class="badge badge-neutral badge-sm">{{ label }}</span>
                        </div>
                        <div class="grid grid-cols-4 gap-2 mb-3">
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">Inbound</p>
                                <p class="text-lg font-bold text-info">{{ attribute(location, 'inbound_' ~ size) }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">At Port</p>
                                <p class="text-lg font-bold text-success">{{ attribute(location, 'at_port_' ~ size) }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">From CY</p>
                                <p class="text-lg font-bold text-warning">{{ attribute(location, 'transfer_from_cy_' ~ size) }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">Avail.</p>
                                <p class="text-lg font-bold text-base-content">{{ attribute(location, 'available_' ~ size) }}</p>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs text-base-content/60">Utilization</span>
                                <span class="text-sm font-bold">{{ attribute(location, 'utilization_' ~ size) }}%</span>
                            </div>
                            <div class="w-full bg-base-300 rounded-full h-2.5">
                                {% set util = attribute(location, 'utilization_' ~ size) %}
                                <div class="h-2.5 rounded-full {{ util >= 90 ? 'bg-error' : (util >= 70 ? 'bg-warning' : 'bg-primary') }}"
                                     style="width: {{ util > 100 ? 100 : util }}%"></div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

{% if cyLocations is defined and cyLocations|length > 0 %}
<div class="card bg-base-100 shadow-sm mb-8">
    <div class="px-6 py-4 flex flex-wrap justify-between items-center gap-3 border-b border-base-300">
        <div>
            <h3 class="text-lg font-medium text-base-content flex items-center gap-2">
                <span class="icon-[tabler--building-warehouse] size-5"></span>
                CY Empty Return Locations
            </h3>
            <p class="text-sm text-base-content/60">Container yard capacity for empty returns — request export/repositioning by highest dwell time (CAO 8-2019)</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="badge badge-neutral badge-lg">{{ cyLocations|length }} CY</span>
            {% if repositioningNewRoute is defined %}
            <a href="{{ path(repositioningNewRoute) }}" class="btn btn-neutral btn-sm gap-1">
                <span class="icon-[tabler--file-text] size-4"></span>
                New Request
            </a>
            {% endif %}
        </div>
    </div>
    <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for location in cyLocations %}
            <div class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300">
                <div class="card-body p-5">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3 flex-1 min-w-0">
                            <div class="w-12 h-12 bg-base-content/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                <span class="icon-[tabler--building-warehouse] size-6 text-base-content"></span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h4 class="font-bold text-base text-base-content truncate">{{ location.terminal.name }}</h4>
                                <span class="badge badge-neutral badge-xs mt-0.5">CONTAINER YARD</span>
                            </div>
                        </div>
                    </div>
                    {% for size, label in {'20ft': '20ft', '40ft': '40ft'} %}
                    <div class="{{ not loop.last ? 'mb-4' : '' }}">
                        <div class="flex items-center justify-between mb-2">
                            <h5 class="text-sm font-bold">{{ label }}</h5>
                            <span class="badge badge-neutral badge-sm">{{ label }}</span>
                        </div>
                        <div class="grid grid-cols-4 gap-2 text-center mb-2">
                            <div><p class="text-xs text-base-content/60">Cap.</p><p class="font-bold">{{ attribute(location, 'capacity_' ~ size) }}</p></div>
                            <div><p class="text-xs text-base-content/60">Alloc.</p><p class="font-bold text-info">{{ attribute(location, 'allocated_' ~ size) }}</p></div>
                            <div><p class="text-xs text-base-content/60">Pre-Fc.</p><p class="font-bold text-warning">{{ attribute(location, 'pre_forecast_' ~ size) }}</p></div>
                            <div><p class="text-xs text-base-content/60">Avail.</p><p class="font-bold text-success">{{ attribute(location, 'available_' ~ size) }}</p></div>
                        </div>
                    </div>
                    {% endfor %}
                    {% if repositioningNewRoute is defined %}
                    <a href="{{ path(repositioningNewRoute, {cy: location.terminal.id}) }}" class="btn btn-sm btn-outline w-full gap-1 mt-2">
                        <span class="icon-[tabler--truck-delivery] size-4"></span>
                        Request Export / Repo
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}
