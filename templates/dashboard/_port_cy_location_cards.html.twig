{# Shared Port/Terminal and CY utilization cards — SL Staff & Shipping Admin dashboards #}
{% if portLocations is defined %}
<div class="card bg-base-100 shadow-sm mb-8">
    <div class="px-6 py-4 flex flex-wrap justify-between items-center gap-3 border-b border-primary/10 bg-primary/5 rounded-t-box">
        <div>
            <h3 class="text-lg font-medium text-base-content flex items-center gap-2">
                <span class="icon-[tabler--anchor] size-5 text-primary"></span>
                Port / Terminal Locations
            </h3>
            <p class="text-sm text-base-content/60">Laden inbound, at-port, and CY-to-port outbound volume by discharge terminal</p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
            <span class="badge badge-primary badge-lg">{{ portLocations|length }} Ports</span>
            {% if repositioningRoute is defined %}
            <a href="{{ path(repositioningRoute) }}" class="btn btn-primary btn-sm gap-1">
                <span class="icon-[tabler--truck-delivery] size-4"></span>
                {{ repositioningLinkLabel|default('Repositioning') }}
            </a>
            {% endif %}
        </div>
    </div>
    <div class="p-6">
        {% if portLocations|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for location in portLocations %}
            <div class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 border border-primary/20 h-full">
                <div class="card-body p-5 h-full flex flex-col">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3 flex-1 min-w-0">
                            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                <span class="icon-[tabler--anchor] size-6 text-primary"></span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h4 class="font-bold text-base text-base-content truncate">{{ location.terminal.name }}</h4>
                                <p class="text-xs text-base-content/60 truncate">
                                    <span class="badge badge-primary badge-xs mr-1">TERMINAL</span>
                                    {{ location.terminal.code }}
                                    {% if location.terminal.region %} · {{ location.terminal.region.name }}{% endif %}
                                </p>
                            </div>
                        </div>
                    </div>

                    {% for size, label in {'20ft': '20ft', '40ft': '40ft'} %}
                    <div class="{{ not loop.last ? 'mb-4' : '' }} flex-1">
                        <div class="flex items-center justify-between mb-3">
                            <h5 class="text-sm font-bold text-base-content">{{ label }} Containers</h5>
                            <span class="badge badge-neutral badge-sm">{{ label }}</span>
                        </div>
                        <div class="grid grid-cols-4 gap-2 mb-3">
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">Inbound</p>
                                <p class="text-lg font-bold text-info">{{ attribute(location, 'inbound_' ~ size) }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">At Port</p>
                                <p class="text-lg font-bold text-success" title="Import discharge + export/reposition arrivals">{{ attribute(location, 'at_port_' ~ size) }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">Outbound</p>
                                <p class="text-lg font-bold text-warning" title="CY to port in transit for export/repositioning">{{ attribute(location, 'transfer_from_cy_' ~ size) }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-base-content/60 mb-1">Avail.</p>
                                <p class="text-lg font-bold text-base-content">{{ attribute(location, 'available_' ~ size) }}</p>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs text-base-content/60">Utilization</span>
                                <span class="text-sm font-bold">{{ attribute(location, 'utilization_' ~ size) }}%</span>
                            </div>
                            <div class="w-full bg-base-300 rounded-full h-2.5">
                                {% set util = attribute(location, 'utilization_' ~ size) %}
                                <div class="h-2.5 rounded-full {{ util >= 90 ? 'bg-error' : (util >= 70 ? 'bg-warning' : 'bg-primary') }}"
                                     style="width: {{ util > 100 ? 100 : util }}%"></div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="mt-6 alert alert-info">
            <span class="icon-[tabler--info-circle] size-5"></span>
            <div>
                <p class="font-semibold">Port / Terminal vs Container Yard</p>
                <p class="text-sm">
                    <strong>Inbound</strong> — laden containers expected at this discharge port (from NOA <code>port_location</code>).
                    <strong>At Port</strong> — containers physically discharged or arrived via repositioning.
                    <strong>Outbound</strong> — containers repositioning from a container yard for export via this terminal.
                </p>
            </div>
        </div>
        {% else %}
        <div class="text-center py-12">
            <div class="w-16 h-16 mx-auto bg-base-200 rounded-full flex items-center justify-center mb-4">
                <span class="icon-[tabler--anchor] size-8 text-base-content/30"></span>
            </div>
            <h4 class="font-semibold text-base-content mb-2">No port terminals configured</h4>
            <p class="text-sm text-base-content/60 max-w-md mx-auto">
                Assign port/terminal locations to your shipping line to track inbound, at-port, and outbound container volume here.
            </p>
        </div>
        {% endif %}
    </div>
</div>
{% endif %}

{% if cyLocations is defined %}
<div class="card bg-base-100 shadow-sm mb-8">
    <div class="px-6 py-4 flex flex-wrap justify-between items-center gap-3 border-b border-base-200 bg-base-200/30 rounded-t-box">
        <div>
            <h3 class="text-lg font-medium text-base-content flex items-center gap-2">
                <span class="icon-[tabler--building-warehouse] size-5 text-base-content"></span>
                CY Empty Return Locations
            </h3>
            <p class="text-sm text-base-content/60">Container yard capacity for empty returns — CY type only, excludes port/terminals</p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
            <span class="badge badge-neutral badge-lg">{{ cyLocations|length }} CY</span>
            {% if repositioningNewRoute is defined %}
            <a href="{{ path(repositioningNewRoute) }}" class="btn btn-neutral btn-sm gap-1">
                <span class="icon-[tabler--file-text] size-4"></span>
                {{ repositioningNewLabel|default('New Request') }}
            </a>
            {% endif %}
        </div>
    </div>
    <div class="p-6">
        {% if cyLocations|length > 0 %}
        {% include 'dashboard/_cy_location_cards.html.twig' with {
            cyLocations: cyLocations,
            showSectionHeader: false,
            showFooterAlert: true,
            repositioningNewRoute: repositioningNewRoute|default(null),
            showDetailedStackLink: showDetailedStackLink|default(false)
        } %}
        {% else %}
        <div class="text-center py-12">
            <div class="w-16 h-16 mx-auto bg-base-200 rounded-full flex items-center justify-center mb-4">
                <span class="icon-[tabler--building-warehouse] size-8 text-base-content/30"></span>
            </div>
            <h4 class="font-semibold text-base-content mb-2">No container yards configured</h4>
            <p class="text-sm text-base-content/60 max-w-md mx-auto">
                Add CY-type terminal allocations for your shipping line to monitor yard capacity and empty returns.
            </p>
            {% if repositioningNewRoute is defined %}
            <a href="{{ path(repositioningNewRoute) }}" class="btn btn-neutral btn-sm gap-2 mt-4">
                <span class="icon-[tabler--plus] size-4"></span>
                New Repositioning Request
            </a>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endif %}
