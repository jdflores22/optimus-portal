{% extends 'base.html.twig' %}

{% block title %}eDO Generation - SL Staff{% endblock %}
{% block page_title %}eDO Generation{% endblock %}

{% block body %}
{% set pendingCount = containersNeedingEdo|length %}
{% set generatedCount = containersWithEdo|length %}

<div class="space-y-5 sm:space-y-6">

    {# Header #}
    <div class="bg-base-100 shadow-sm rounded-xl">
        <div class="p-4 sm:p-6">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="min-w-0">
                    <div class="breadcrumbs text-xs mb-2">
                        <ul>
                            <li><a href="{{ path('app_sl_staff_dashboard') }}">SL Staff</a></li>
                            <li>eDO Generation</li>
                        </ul>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="size-12 rounded-xl bg-success/10 flex items-center justify-center shrink-0">
                            <span class="icon-[tabler--file-certificate] size-6 text-success"></span>
                        </div>
                        <div class="min-w-0">
                            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-base-content">eDO Generation</h1>
                            <p class="text-sm text-base-content/60 mt-1">
                                Generate electronic delivery orders for containers with verified final payments.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('sl_staff_renewal_requests_ready') }}" class="btn btn-ghost btn-sm gap-2">
                        <span class="icon-[tabler--refresh] size-4"></span>
                        Renewal Requests
                    </a>
                    {% if pendingCount > 0 %}
                        <button type="button" class="btn btn-primary btn-sm gap-2" onclick="switchTab('pending')">
                            <span class="icon-[tabler--player-play] size-4"></span>
                            Process Pending ({{ pendingCount }})
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Summary stats #}
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <button type="button" data-tab-trigger="pending"
                class="card shadow-sm text-left transition-colors tab-stat-card bg-warning/10 ring-2 ring-warning/30">
            <div class="card-body p-4 sm:p-5">
                <div class="flex items-center gap-3">
                    <div class="size-10 bg-warning/20 text-warning rounded-xl flex items-center justify-center shrink-0">
                        <span class="icon-[tabler--clock] size-5"></span>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs text-base-content/70">Pending</p>
                        <p class="text-2xl font-bold text-base-content">{{ pendingCount }}</p>
                        <p class="text-xs text-warning/80">Awaiting eDO</p>
                    </div>
                </div>
            </div>
        </button>
        <button type="button" data-tab-trigger="generated"
                class="card shadow-sm text-left transition-colors tab-stat-card bg-base-100 hover:bg-success/5">
            <div class="card-body p-4 sm:p-5">
                <div class="flex items-center gap-3">
                    <div class="size-10 bg-success/10 text-success rounded-xl flex items-center justify-center shrink-0">
                        <span class="icon-[tabler--circle-check] size-5"></span>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs text-base-content/70">Generated</p>
                        <p class="text-2xl font-bold text-base-content">{{ generatedCount }}</p>
                        <p class="text-xs text-success/80">eDOs issued</p>
                    </div>
                </div>
            </div>
        </button>
        <div class="card bg-base-100 shadow-sm col-span-2 lg:col-span-1">
            <div class="card-body p-4 sm:p-5">
                <div class="flex items-center gap-3">
                    <div class="size-10 bg-info/10 text-info rounded-xl flex items-center justify-center shrink-0">
                        <span class="icon-[tabler--container] size-5"></span>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs text-base-content/70">Total Eligible</p>
                        <p class="text-2xl font-bold text-base-content">{{ totalContainers }}</p>
                        <p class="text-xs text-info/80">Verified payment</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if totalContainers == 0 %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body text-center py-16 px-4">
                <div class="inline-flex items-center justify-center size-16 bg-base-200 rounded-2xl mb-4">
                    <span class="icon-[tabler--file-off] size-8 text-base-content/40"></span>
                </div>
                <h3 class="text-lg font-semibold text-base-content">No containers ready</h3>
                <p class="text-sm text-base-content/60 mt-2 max-w-md mx-auto">
                    Containers appear here after final payment is verified on the manifest.
                </p>
            </div>
        </div>
    {% else %}
        {# Search #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-5">
                <label class="input input-bordered flex items-center gap-2 w-full max-w-xl">
                    <span class="icon-[tabler--search] size-4 text-base-content/40"></span>
                    <input type="search" id="searchInput" class="grow" placeholder="Search container, manifest, broker, or consignee…" autocomplete="off">
                </label>
            </div>
        </div>

        {# Pending tab #}
        <div id="pending-tab" class="tab-panel space-y-4">
            {% if pendingCount == 0 %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body text-center py-14 px-4">
                        <div class="inline-flex items-center justify-center size-14 bg-success/10 rounded-2xl mb-3">
                            <span class="icon-[tabler--circle-check] size-7 text-success"></span>
                        </div>
                        <h3 class="text-lg font-semibold text-base-content">All caught up</h3>
                        <p class="text-sm text-base-content/60 mt-1">Every eligible container already has an eDO.</p>
                        <button type="button" class="btn btn-ghost btn-sm mt-4 gap-1" onclick="switchTab('generated')">
                            View generated eDOs
                            <span class="icon-[tabler--arrow-right] size-4"></span>
                        </button>
                    </div>
                </div>
            {% else %}
                {% for group in pendingGroups %}
                    {% set manifest = group.manifest %}

                    <div class="card bg-base-100 shadow-sm edo-group-card" data-search="{{ group.search_text }}">
                        <div class="px-4 sm:px-6 py-4 border-b border-base-200/80 bg-warning/5 rounded-t-xl">
                            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                                <div class="flex items-start gap-3 min-w-0">
                                    <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0 group-toggle" onclick="toggleGroup({{ group.id }})" aria-expanded="true" aria-controls="group-{{ group.id }}">
                                        <span class="icon-[tabler--chevron-down] size-5 transition-transform group-icon-{{ group.id }}"></span>
                                    </button>
                                    <div class="min-w-0">
                                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                            {% if manifest.noa %}
                                                <a href="{{ path('manifest_workflow_noa_detail', {id: manifest.noa.id}) }}" class="font-semibold text-base-content hover:text-primary">
                                                    {{ manifest.manifestNumber }}
                                                </a>
                                            {% else %}
                                                <span class="font-semibold text-base-content">{{ manifest.manifestNumber }}</span>
                                            {% endif %}
                                            <span class="badge badge-warning badge-sm">{{ group.containers|length }} pending</span>
                                            <span class="badge badge-ghost badge-sm">{{ group.edo_count_in_manifest }}/{{ group.total_in_manifest }} eDOs</span>
                                        </div>
                                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1.5 text-sm text-base-content/60">
                                            <span class="inline-flex items-center gap-1">
                                                <span class="icon-[tabler--briefcase] size-3.5"></span>
                                                {{ group.broker }}
                                            </span>
                                            <span class="hidden sm:inline text-base-content/30">·</span>
                                            <span class="inline-flex items-center gap-1">
                                                <span class="icon-[tabler--building-store] size-3.5"></span>
                                                {{ group.consignee }}
                                            </span>
                                            <span class="hidden sm:inline text-base-content/30">·</span>
                                            <span>{{ manifest.shippingLine.brandName }}</span>
                                        </div>
                                    </div>
                                </div>
                                <button type="button"
                                        class="btn btn-success btn-sm gap-2 shrink-0 js-open-generate-modal"
                                        data-container-ids="{{ group.container_ids_csv }}"
                                        data-manifest-id="{{ manifest.id }}"
                                        data-label="{{ manifest.manifestNumber }} ({{ group.containers|length }} container{{ group.containers|length != 1 ? 's' : '' }})">
                                    <span class="icon-[tabler--files] size-4"></span>
                                    Generate All ({{ group.containers|length }})
                                </button>
                            </div>
                        </div>

                        <div id="group-{{ group.id }}" class="group-content">
                            <div class="overflow-x-auto">
                                <table class="table">
                                    <thead>
                                        <tr class="text-base-content/60">
                                            <th>Container</th>
                                            <th>Size / Type</th>
                                            <th>Payment Verified</th>
                                            <th class="text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for data in group.containers %}
                                            {% set container = data.container %}
                                            {% set payment = manifest.payments|filter(p => p.paymentType.value == 'final_payment' and p.status.value == 'verified')|first %}
                                            <tr class="hover:bg-base-200/30">
                                                <td>
                                                    <div class="font-medium font-mono">{{ container.containerNumber }}</div>
                                                </td>
                                                <td>
                                                    <div class="text-sm font-medium">{{ container.containerSize.name }}</div>
                                                    <div class="text-xs text-base-content/50">{{ container.containerType.name }}</div>
                                                </td>
                                                <td>
                                                    {% if payment and payment.validatedAt %}
                                                        <span class="text-sm">{{ payment.validatedAt|date('M j, Y') }}</span>
                                                    {% else %}
                                                        <span class="text-sm text-base-content/40">—</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-right">
                                                    <button type="button"
                                                            class="btn btn-success btn-sm gap-1 js-open-generate-modal"
                                                            data-container-ids="{{ container.id }}"
                                                            data-manifest-id="{{ manifest.id }}"
                                                            data-label="{{ container.containerNumber }}">
                                                        <span class="icon-[tabler--file-plus] size-4"></span>
                                                        Generate
                                                    </button>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                <p id="pending-no-results" class="hidden text-center text-sm text-base-content/60 py-8">
                    No pending containers match your search.
                </p>
            {% endif %}
        </div>

        {# Generated tab #}
        <div id="generated-tab" class="tab-panel hidden space-y-4">
            {% if generatedCount == 0 %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body text-center py-14 px-4">
                        <div class="inline-flex items-center justify-center size-14 bg-base-200 rounded-2xl mb-3">
                            <span class="icon-[tabler--file-off] size-7 text-base-content/40"></span>
                        </div>
                        <h3 class="text-lg font-semibold text-base-content">No eDOs generated yet</h3>
                        <p class="text-sm text-base-content/60 mt-1">Generated eDOs will appear here after you process pending containers.</p>
                    </div>
                </div>
            {% else %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="px-4 sm:px-6 py-4 border-b border-base-200/80 bg-success/5 rounded-t-xl">
                        <h2 class="font-semibold text-base-content">Generated eDOs</h2>
                        <p class="text-xs text-base-content/60 mt-0.5">{{ generatedCount }} container{{ generatedCount != 1 ? 's' : '' }} with active eDOs</p>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="table">
                            <thead>
                                <tr class="text-base-content/60">
                                    <th>Container</th>
                                    <th>Manifest</th>
                                    <th>Broker / Consignee</th>
                                    <th>eDO Number</th>
                                    <th>Status</th>
                                    <th>Generated</th>
                                    <th>Expires</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for data in containersWithEdo %}
                                    {% set container = data.container %}
                                    {% set manifest = data.manifest %}
                                    {% set edo = data.edo %}
                                    {% set searchText = (container.containerNumber ~ ' ' ~ manifest.manifestNumber ~ ' ' ~ (manifest.broker ? manifest.broker.fullName : '') ~ ' ' ~ (manifest.consignee ? manifest.consignee.businessName : '') ~ ' ' ~ edo.edoNumber)|lower %}
                                    <tr class="hover:bg-base-200/30 edo-generated-row" data-search="{{ searchText }}">
                                        <td>
                                            <div class="font-medium font-mono">{{ container.containerNumber }}</div>
                                            <div class="text-xs text-base-content/50">{{ container.containerSize.name }} · {{ container.containerType.name }}</div>
                                        </td>
                                        <td>
                                            {% if manifest.noa %}
                                                <a href="{{ path('manifest_workflow_noa_detail', {id: manifest.noa.id}) }}" class="link link-primary text-sm font-medium">
                                                    {{ manifest.manifestNumber }}
                                                </a>
                                            {% else %}
                                                <span class="text-sm font-medium">{{ manifest.manifestNumber }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="text-sm">{{ manifest.broker ? manifest.broker.fullName : 'N/A' }}</div>
                                            <div class="text-xs text-base-content/50">{{ manifest.consignee ? manifest.consignee.businessName : 'N/A' }}</div>
                                        </td>
                                        <td>
                                            <span class="font-mono text-sm">{{ edo.edoNumber }}</span>
                                        </td>
                                        <td>
                                            {% if edo.status.value == 'released' %}
                                                <span class="badge badge-success badge-sm">Released</span>
                                            {% else %}
                                                <span class="badge badge-warning badge-sm">Pending Release</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-sm text-base-content/70 whitespace-nowrap">{{ edo.generatedAt|date('M j, Y') }}</td>
                                        <td class="text-sm text-base-content/70 whitespace-nowrap">{{ edo.expiresAt|date('M j, Y') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <p id="generated-no-results" class="hidden text-center text-sm text-base-content/60 py-4">
                    No generated eDOs match your search.
                </p>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}

{% block page_modals %}
<div id="generateModal" class="hidden fixed inset-0 z-[10001] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="generateModalTitle">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px]" data-close-generate-modal></div>
    <div class="relative bg-base-100 rounded-2xl shadow-2xl w-full max-w-lg z-10 border border-base-300">
        <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-5">
                <div>
                    <h3 id="generateModalTitle" class="text-xl font-bold flex items-center gap-2">
                        <span class="icon-[tabler--file-certificate] size-5 text-success"></span>
                        Generate eDO
                    </h3>
                    <p class="text-sm text-base-content/60 mt-1">Set the expiration date for the new eDO document.</p>
                </div>
                <button type="button" class="btn btn-text btn-circle btn-sm shrink-0" data-close-generate-modal aria-label="Close">
                    <span class="icon-[tabler--x] size-5"></span>
                </button>
            </div>

            <div class="space-y-4">
                <div class="rounded-xl bg-info/10 border border-info/20 p-4">
                    <p class="text-xs font-medium text-info uppercase tracking-wide">Target</p>
                    <p class="text-sm font-medium mt-1" id="modalContainerInfo">—</p>
                </div>

                <div class="form-control">
                    <label class="label py-1" for="expirationDate">
                        <span class="label-text font-medium">Expiration date <span class="text-error">*</span></span>
                    </label>
                    <div class="flex gap-2">
                        <input type="date"
                               id="expirationDate"
                               class="input input-bordered w-full flex-1 min-w-0"
                               min="{{ 'now'|date('Y-m-d') }}"
                               required>
                        <button type="button"
                                id="openExpirationDatePicker"
                                class="btn btn-outline btn-square shrink-0"
                                aria-label="Open calendar">
                            <span class="icon-[tabler--calendar] size-5"></span>
                        </button>
                    </div>
                    <label class="label py-1">
                        <span class="label-text-alt text-base-content/50">Click the field or calendar icon — yesterday and earlier cannot be selected</span>
                    </label>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button type="button" class="btn btn-ghost flex-1" data-close-generate-modal id="cancelBtn">Cancel</button>
                <button type="button" class="btn btn-success flex-1 gap-2" id="generateBtn">
                    <span class="icon-[tabler--file-plus] size-4" id="generateIcon"></span>
                    <span class="loading loading-spinner loading-sm hidden" id="loadingSpinner"></span>
                    <span id="generateBtnText">Generate eDO</span>
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
let currentContainerIds = [];
let currentManifestId = null;
let activeTab = 'pending';
const groupStates = {};

function getExpirationDateInput() {
    return document.getElementById('expirationDate');
}

function getLocalDateString(date = new Date()) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
}

function openExpirationDatePicker() {
    const input = getExpirationDateInput();
    if (!input) return;

    if (typeof input.showPicker === 'function') {
        try {
            input.showPicker();
            return;
        } catch (error) {
            // showPicker can throw if not triggered by user gesture in some browsers
        }
    }

    input.focus();
    input.click();
}

function setExpirationDateConstraints(forceToday = false) {
    const input = getExpirationDateInput();
    if (!input) return;

    const today = getLocalDateString();
    input.min = today;

    if (forceToday || !input.value || input.value < today) {
        input.value = today;
    }
}

function switchTab(tabName) {
    activeTab = tabName;
    document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.add('hidden'));
    document.getElementById(tabName + '-tab').classList.remove('hidden');

    document.querySelectorAll('[data-tab-trigger]').forEach(card => {
        card.classList.remove('bg-warning/10', 'ring-2', 'ring-warning/30', 'bg-success/10', 'ring-success/30');
        card.classList.add('bg-base-100', 'hover:bg-base-200/40');
    });

    const activeCard = document.querySelector(`[data-tab-trigger="${tabName}"]`);
    if (activeCard) {
        activeCard.classList.remove('bg-base-100', 'hover:bg-base-200/40');
        if (tabName === 'pending') {
            activeCard.classList.add('bg-warning/10', 'ring-2', 'ring-warning/30');
        } else {
            activeCard.classList.add('bg-success/10', 'ring-2', 'ring-success/30');
        }
    }

    applySearch();
}

document.querySelectorAll('[data-tab-trigger]').forEach(trigger => {
    trigger.addEventListener('click', () => switchTab(trigger.dataset.tabTrigger));
});

function toggleGroup(groupId) {
    const content = document.getElementById('group-' + groupId);
    const icon = document.querySelector('.group-icon-' + groupId);
    const button = content?.closest('.edo-group-card')?.querySelector('.group-toggle');

    if (!content) return;

    const expanded = groupStates[groupId] !== false;
    groupStates[groupId] = !expanded;
    content.classList.toggle('hidden', expanded);
    if (icon) icon.style.transform = expanded ? 'rotate(0deg)' : 'rotate(180deg)';
    if (button) button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
}

document.addEventListener('DOMContentLoaded', () => {
    const dateInput = getExpirationDateInput();
    const datePickerBtn = document.getElementById('openExpirationDatePicker');

    if (datePickerBtn) {
        datePickerBtn.addEventListener('click', openExpirationDatePicker);
    }

    if (dateInput) {
        dateInput.addEventListener('click', openExpirationDatePicker);
        dateInput.addEventListener('focus', () => {
            dateInput.min = getLocalDateString();
        });
    }

    document.querySelectorAll('.group-content').forEach(content => {
        const groupId = content.id.replace('group-', '');
        groupStates[groupId] = true;
    });

    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', applySearch);
    }

    document.querySelectorAll('.js-open-generate-modal').forEach(button => {
        button.addEventListener('click', () => {
            const ids = (button.dataset.containerIds || '')
                .split(',')
                .map(id => parseInt(id.trim(), 10))
                .filter(id => !Number.isNaN(id));

            openGenerateModal(
                ids,
                parseInt(button.dataset.manifestId, 10),
                button.dataset.label || 'Selected container(s)'
            );
        });
    });

    document.querySelectorAll('[data-close-generate-modal]').forEach(el => {
        el.addEventListener('click', closeGenerateModal);
    });

    document.getElementById('generateBtn')?.addEventListener('click', generateEdos);

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeGenerateModal();
        }
    });
});

function applySearch() {
    const query = (document.getElementById('searchInput')?.value || '').trim().toLowerCase();

    if (activeTab === 'pending') {
        let visibleGroups = 0;
        document.querySelectorAll('.edo-group-card').forEach(card => {
            const match = !query || (card.dataset.search || '').includes(query);
            card.classList.toggle('hidden', !match);
            if (match) visibleGroups++;
        });
        const noResults = document.getElementById('pending-no-results');
        if (noResults) noResults.classList.toggle('hidden', visibleGroups > 0 || !query);
    } else {
        let visibleRows = 0;
        document.querySelectorAll('.edo-generated-row').forEach(row => {
            const match = !query || (row.dataset.search || '').includes(query);
            row.classList.toggle('hidden', !match);
            if (match) visibleRows++;
        });
        const noResults = document.getElementById('generated-no-results');
        if (noResults) noResults.classList.toggle('hidden', visibleRows > 0 || !query);
    }
}

function openGenerateModal(containerIds, manifestId, containerInfo) {
    if (!containerIds.length || !manifestId) {
        console.error('Missing container or manifest data for eDO generation');
        return;
    }

    currentContainerIds = containerIds;
    currentManifestId = manifestId;

    const modal = document.getElementById('generateModal');
    const modalInfoElement = document.getElementById('modalContainerInfo');

    if (!modal) return;

    if (modalInfoElement) modalInfoElement.textContent = containerInfo;

    resetGenerateButton();
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    setExpirationDateConstraints(true);
}

function closeGenerateModal() {
    const modal = document.getElementById('generateModal');
    if (!modal || modal.classList.contains('hidden')) return;

    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    resetGenerateButton();
    currentContainerIds = [];
    currentManifestId = null;
}

function resetGenerateButton() {
    const generateBtn = document.getElementById('generateBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    const generateIcon = document.getElementById('generateIcon');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const generateBtnText = document.getElementById('generateBtnText');

    if (generateBtn) generateBtn.disabled = false;
    if (cancelBtn) cancelBtn.disabled = false;
    if (generateIcon) generateIcon.classList.remove('hidden');
    if (loadingSpinner) loadingSpinner.classList.add('hidden');
    if (generateBtnText) generateBtnText.textContent = 'Generate eDO';
}

async function generateEdos() {
    if (!currentManifestId || currentContainerIds.length === 0) return;

    const expirationDate = getExpirationDateInput()?.value || '';
    const today = getLocalDateString();

    if (!expirationDate) {
        alert('Please select an expiration date');
        return;
    }

    if (expirationDate < today) {
        alert('Expiration date cannot be in the past. Please choose today or a future date.');
        setExpirationDateConstraints(true);
        return;
    }

    const generateBtn = document.getElementById('generateBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    const generateIcon = document.getElementById('generateIcon');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const generateBtnText = document.getElementById('generateBtnText');

    generateBtn.disabled = true;
    cancelBtn.disabled = true;
    generateIcon.classList.add('hidden');
    loadingSpinner.classList.remove('hidden');
    generateBtnText.textContent = 'Generating…';

    try {
        const response = await fetch(`/sl-staff/edo-generation/generate/${currentManifestId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                expirationDate: expirationDate,
                containerIds: currentContainerIds
            })
        });

        const data = await response.json();

        if (data.success) {
            closeGenerateModal();

            const successDiv = document.createElement('div');
            successDiv.className = 'alert alert-success fixed top-20 right-4 w-auto max-w-md z-30 shadow-lg';
            successDiv.innerHTML = `
                <span class="icon-[tabler--check] size-5"></span>
                <span>${data.message || 'eDO generated successfully!'}</span>
            `;
            document.body.appendChild(successDiv);

            setTimeout(() => {
                successDiv.remove();
                window.location.reload();
            }, 1500);
        } else {
            alert(data.message || 'Failed to generate eDO');
            resetGenerateButton();
        }
    } catch (error) {
        console.error('Error generating eDO:', error);
        alert('An error occurred while generating eDO');
        resetGenerateButton();
    }
}
</script>
{% endblock %}
