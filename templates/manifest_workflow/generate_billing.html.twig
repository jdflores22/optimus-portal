{% extends 'base.html.twig' %}

{% block title %}Generate Billing - {{ manifest.manifestNumber }} - OPTIMUS{% endblock %}
{% block page_title %}Generate Billing{% endblock %}

{% set state = manifest.workflowState %}
{% set currentStep = manifest_workflow_current_step(manifest) %}

{% block body %}
<div class="max-w-7xl mx-auto w-full space-y-5 sm:space-y-6">

    {# Hero header — accounting dashboard pattern #}
    <div class="rounded-3xl border border-secondary/20 bg-gradient-to-br from-secondary/15 via-base-100 to-base-100 shadow-sm p-5 sm:p-7">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
            <div class="space-y-3 min-w-0">
                <div class="breadcrumbs text-xs">
                    <ul>
                        <li><a href="{{ path('app_accounting_dashboard_new') }}">Accounting Dashboard</a></li>
                        <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right] size-3.5"></span></li>
                        <li><a href="{{ manifest_workflow_detail_path(manifest) }}">{{ manifest.manifestNumber }}</a></li>
                        <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right] size-3.5"></span></li>
                        <li aria-current="page">Generate Billing</li>
                    </ul>
                </div>

                <span class="inline-flex items-center gap-2 rounded-full bg-secondary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-secondary">
                    <span class="icon-[tabler--receipt] size-3.5"></span>
                    Billing Generation
                </span>

                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-base-content leading-tight">
                            Generate Billing
                        </h1>
                        <span class="badge badge-secondary badge-sm font-mono">{{ manifest.manifestNumber }}</span>
                        <span class="badge badge-ghost badge-sm">{{ state.getDisplayName() }}</span>
                    </div>
                    <p class="mt-2 text-sm sm:text-base text-base-content/70 max-w-2xl">
                        Enter freight, THC, and additional charges to issue the billing document for this manifest after BL upload.
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="badge badge-secondary badge-soft badge-sm gap-1.5">
                        <span class="icon-[tabler--list-numbers] size-3"></span>
                        Step {{ currentStep }} of {{ manifest_workflow_total_steps() }}
                    </span>
                    {% if manifest.blNumber %}
                        <span class="badge badge-ghost badge-sm gap-1.5 font-mono">
                            <span class="icon-[tabler--file-invoice] size-3"></span>
                            BL {{ manifest.blNumber }}
                        </span>
                    {% endif %}
                    {% if manifest.broker %}
                        <span class="badge badge-ghost badge-sm gap-1.5">
                            <span class="icon-[tabler--user] size-3"></span>
                            {{ manifest.broker.fullName }}
                        </span>
                    {% endif %}
                    {% if manifest.vesselName %}
                        <span class="badge badge-ghost badge-sm gap-1.5">
                            <span class="icon-[tabler--ship] size-3"></span>
                            {{ manifest.vesselName }}
                        </span>
                    {% endif %}
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 xl:justify-end shrink-0">
                <a href="{{ manifest_workflow_detail_path(manifest) }}"
                   class="btn btn-outline btn-secondary btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--file-text] size-4"></span>
                    View Manifest
                </a>
                <a href="{{ path('app_accounting_dashboard_new') }}"
                   class="btn btn-ghost btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--arrow-left] size-4"></span>
                    Dashboard
                </a>
                <a href="{{ path('manifest_workflow_generate_billing', {id: manifest.id}) }}"
                   class="btn btn-ghost btn-sm sm:btn-md gap-2">
                    <span class="icon-[tabler--refresh] size-4"></span>
                    Refresh
                </a>
            </div>
        </div>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm">
            <span class="icon-[tabler--circle-check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error shadow-sm">
            <span class="icon-[tabler--circle-x] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning shadow-sm">
            <span class="icon-[tabler--alert-triangle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="alert alert-info shadow-sm">
            <span class="icon-[tabler--info-circle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    {% if manifest.workflowState.value != 'bl_uploaded' %}
        <div class="alert alert-error shadow-sm">
            <span class="icon-[tabler--alert-circle] size-5"></span>
            <div>
                <p class="font-medium">Invalid workflow state</p>
                <p class="text-sm mt-0.5">Billing can only be generated when the manifest is in <strong>BL Uploaded</strong> state. Current state: {{ manifest.workflowState.getDisplayName() }}.</p>
            </div>
        </div>
    {% else %}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 items-start">
            {# Billing form #}
            <div class="card card-border bg-base-100 shadow-sm relative">
                <div id="generateOverlay"
                     class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center gap-4 rounded-[inherit] bg-base-100/80 backdrop-blur-[2px]">
                    <span class="loading loading-spinner loading-lg text-secondary"></span>
                    <div class="text-center px-6">
                        <p class="text-sm font-semibold text-base-content">Generating billing document…</p>
                        <p class="text-xs text-base-content/60 mt-1">Please wait while charges are calculated and saved.</p>
                    </div>
                </div>
                <div class="card-body p-4 sm:p-6">
                    <h2 class="card-title text-base sm:text-lg mb-4">Billing Details</h2>
                    <form id="billingGenerationForm"
                          method="post"
                          action="{{ path('manifest_workflow_generate_billing_submit', {id: manifest.id}) }}"
                          class="space-y-5">
                        <input type="hidden" name="_token" value="{{ csrf_token('generate_billing_' ~ manifest.id) }}">
                        <input type="hidden" name="additional_charges" id="additionalChargesJson" value="[]">
                        <input type="hidden" name="exchange_rate" id="exchangeRateInput" value="">
                        <div class="form-control w-full">
                            <label class="label pb-1" for="currency">
                                <span class="label-text font-medium">Currency <span class="text-error">*</span></span>
                            </label>
                            <select id="currency" name="currency" class="select select-bordered w-full">
                                <option value="PHP">Philippine Peso (₱)</option>
                                <option value="USD" selected>US Dollar ($)</option>
                            </select>
                            <label class="label pt-1">
                                <span id="exchangeRateDisplay" class="label-text-alt text-base-content/60">Loading exchange rate…</span>
                            </label>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1" for="freightCharges">
                                <span class="label-text font-medium">
                                    Freight Charges (<span id="currencySymbol1">$</span>) <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="number"
                                   id="freightCharges"
                                   name="freight_charges"
                                   required
                                   min="0"
                                   step="0.01"
                                   class="input input-bordered w-full"
                                   placeholder="0.00">
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1" for="thcCharges">
                                <span class="label-text font-medium">
                                    Terminal Handling Charges (<span id="currencySymbol2">$</span>) <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="number"
                                   id="thcCharges"
                                   name="thc_charges"
                                   required
                                   min="0"
                                   step="0.01"
                                   class="input input-bordered w-full"
                                   placeholder="0.00">
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-sm font-medium text-base-content">Additional Charges</span>
                                <button type="button"
                                        id="addChargeBtn"
                                        class="btn btn-ghost btn-sm gap-2">
                                    <span class="icon-[tabler--plus] size-4"></span>
                                    Add Charge
                                </button>
                            </div>
                            <div id="additionalChargesContainer" class="space-y-3"></div>
                        </div>

                        <div id="messageContainer" class="hidden"></div>

                        <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
                            <a href="{{ manifest_workflow_detail_path(manifest) }}"
                               id="cancelBtn"
                               class="btn btn-ghost">
                                Cancel
                            </a>
                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-secondary gap-2 min-w-[10.5rem]">
                                <span id="submitBtnText" class="flex items-center gap-2">
                                    <span class="icon-[tabler--file-invoice] size-4"></span>
                                    Generate Billing
                                </span>
                                <span id="submitBtnLoading" class="hidden flex items-center gap-2">
                                    <span class="loading loading-spinner loading-sm text-secondary-content"></span>
                                    Generating…
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            {# Live preview #}
            <div class="card card-border bg-base-100 shadow-sm lg:sticky lg:top-24 h-fit">
                <div class="card-body p-4 sm:p-6">
                    <h2 class="card-title text-base sm:text-lg mb-4">Billing Preview</h2>

                    <div class="mb-6 p-4 bg-base-200/80 rounded-xl space-y-2 text-sm">
                        <div class="flex justify-between gap-3">
                            <span class="text-base-content/60">Manifest #</span>
                            <span class="font-medium font-mono">{{ manifest.manifestNumber }}</span>
                        </div>
                        <div class="flex justify-between gap-3">
                            <span class="text-base-content/60">BL Number</span>
                            <span class="font-medium font-mono">{{ manifest.blNumber }}</span>
                        </div>
                        {% if manifest.broker %}
                            <div class="flex justify-between gap-3">
                                <span class="text-base-content/60">Broker</span>
                                <span class="font-medium text-end">{{ manifest.broker.fullName }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="space-y-3">
                        <div class="flex justify-between items-center py-2 border-b border-base-300">
                            <span class="text-base-content/70">Freight Charges</span>
                            <div class="text-right">
                                <div id="previewFreight" class="font-medium">$0.00</div>
                                <div id="previewFreightPHP" class="text-xs text-base-content/60">₱0.00</div>
                            </div>
                        </div>

                        <div class="flex justify-between items-center py-2 border-b border-base-300">
                            <span class="text-base-content/70">THC Charges</span>
                            <div class="text-right">
                                <div id="previewTHC" class="font-medium">$0.00</div>
                                <div id="previewTHCPHP" class="text-xs text-base-content/60">₱0.00</div>
                            </div>
                        </div>

                        <div id="previewAdditionalCharges" class="space-y-3"></div>

                        <div class="pt-4 mt-4 border-t-2 border-base-300">
                            <div class="flex justify-between items-center">
                                <span class="text-lg font-semibold text-base-content">Total Amount</span>
                                <div class="text-right">
                                    <div id="previewTotal" class="text-2xl font-bold text-secondary">$0.00</div>
                                    <div id="previewTotalPHP" class="text-sm text-base-content/60">₱0.00</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 p-3 bg-info/10 rounded-xl">
                        <div class="flex items-start gap-2">
                            <span class="icon-[tabler--info-circle] size-5 text-info shrink-0 mt-0.5"></span>
                            <div class="text-xs text-base-content/70">
                                <p class="font-medium mb-1">Exchange Rate Information</p>
                                <p id="exchangeRateInfo">Loading current rates…</p>
                                <p class="mt-1 text-base-content/50">Rates are updated in real time</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block page_scripts %}
    {{ parent() }}
    {% if manifest.workflowState.value == 'bl_uploaded' %}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        let chargeCounter = 0;
        let exchangeRate = 1;
        let currentCurrency = 'USD';

        const submitBtn = document.getElementById('submitBtn');
        const submitBtnText = document.getElementById('submitBtnText');
        const submitBtnLoading = document.getElementById('submitBtnLoading');
        const messageContainer = document.getElementById('messageContainer');
        const cancelBtn = document.getElementById('cancelBtn');
        const addChargeBtn = document.getElementById('addChargeBtn');
        const generateOverlay = document.getElementById('generateOverlay');
        const billingForm = document.getElementById('billingGenerationForm');

        function setGeneratingState(isGenerating) {
            if (isGenerating) {
                generateOverlay.classList.remove('hidden');
                generateOverlay.classList.add('flex');
                submitBtn.disabled = true;
                cancelBtn.classList.add('btn-disabled', 'pointer-events-none');
                addChargeBtn.disabled = true;
                submitBtnText.classList.add('hidden');
                submitBtnLoading.classList.remove('hidden');
                return;
            }

            generateOverlay.classList.add('hidden');
            generateOverlay.classList.remove('flex');
            submitBtn.disabled = false;
            cancelBtn.classList.remove('btn-disabled', 'pointer-events-none');
            addChargeBtn.disabled = false;
            submitBtnText.classList.remove('hidden');
            submitBtnLoading.classList.add('hidden');
        }

        async function fetchExchangeRate() {
            try {
                const response = await fetch('/api/exchange-rate/usd-php');
                const data = await response.json();

                if (data.success && data.rate) {
                    exchangeRate = data.rate;
                    const dateStr = new Date(data.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    });

                    document.getElementById('exchangeRateDisplay').textContent = `1 USD = ₱${exchangeRate.toFixed(4)}`;
                    document.getElementById('exchangeRateInfo').textContent = `Current rate: 1 USD = ₱${exchangeRate.toFixed(4)} (Updated: ${dateStr}, Source: ${data.source})`;
                } else {
                    exchangeRate = data.rate || 57.50;
                    document.getElementById('exchangeRateDisplay').textContent = `1 USD = ₱${exchangeRate.toFixed(4)} (Fallback)`;
                    document.getElementById('exchangeRateInfo').textContent = `${data.message || 'Using fallback rate'}. Please verify current rates.`;
                    messageContainer.innerHTML = `
                        <div class="alert alert-warning shadow-sm">
                            <span class="icon-[tabler--alert-triangle] size-5"></span>
                            <div>
                                <p class="font-medium">Exchange rate warning</p>
                                <p class="text-sm">Unable to fetch real-time exchange rates. Using fallback rate of ₱${exchangeRate.toFixed(2)}.</p>
                            </div>
                        </div>
                    `;
                    messageContainer.classList.remove('hidden');
                }

                updatePreview();
            } catch (error) {
                console.error('Failed to fetch exchange rate:', error);
                exchangeRate = 57.50;
                document.getElementById('exchangeRateDisplay').textContent = `1 USD = ₱${exchangeRate.toFixed(4)} (Fallback)`;
                document.getElementById('exchangeRateInfo').textContent = `Connection error. Using fallback rate: 1 USD = ₱${exchangeRate.toFixed(4)}`;
                messageContainer.innerHTML = `
                    <div class="alert alert-error shadow-sm">
                        <span class="icon-[tabler--alert-circle] size-5"></span>
                        <div>
                            <p class="font-medium">Connection error</p>
                            <p class="text-sm">Unable to connect to the exchange rate service. Using fallback rate of ₱${exchangeRate.toFixed(2)}.</p>
                        </div>
                    </div>
                `;
                messageContainer.classList.remove('hidden');
                updatePreview();
            }
        }

        function updateCurrencySymbols() {
            const symbol = currentCurrency === 'USD' ? '$' : '₱';
            document.getElementById('currencySymbol1').textContent = symbol;
            document.getElementById('currencySymbol2').textContent = symbol;
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(amount);
        }

        function convertToPHP(amount) {
            return currentCurrency === 'USD' ? amount * exchangeRate : amount;
        }

        function updatePreview() {
            const freight = parseFloat(document.getElementById('freightCharges').value) || 0;
            const thc = parseFloat(document.getElementById('thcCharges').value) || 0;
            const currencySymbol = currentCurrency === 'USD' ? '$' : '₱';

            document.getElementById('previewFreight').textContent = `${currencySymbol}${formatCurrency(freight)}`;
            if (currentCurrency === 'USD') {
                document.getElementById('previewFreightPHP').textContent = `₱${formatCurrency(convertToPHP(freight))}`;
                document.getElementById('previewFreightPHP').classList.remove('hidden');
            } else {
                document.getElementById('previewFreightPHP').classList.add('hidden');
            }

            document.getElementById('previewTHC').textContent = `${currencySymbol}${formatCurrency(thc)}`;
            if (currentCurrency === 'USD') {
                document.getElementById('previewTHCPHP').textContent = `₱${formatCurrency(convertToPHP(thc))}`;
                document.getElementById('previewTHCPHP').classList.remove('hidden');
            } else {
                document.getElementById('previewTHCPHP').classList.add('hidden');
            }

            let additionalTotal = 0;
            const additionalPreviewContainer = document.getElementById('previewAdditionalCharges');
            additionalPreviewContainer.innerHTML = '';

            document.querySelectorAll('.additional-charge-amount').forEach((input, index) => {
                const amount = parseFloat(input.value) || 0;
                const descInput = input.parentElement.querySelector('input[type="text"]');
                const description = descInput ? descInput.value : `Charge ${index + 1}`;

                if (amount > 0) {
                    additionalTotal += amount;
                    const chargeDiv = document.createElement('div');
                    chargeDiv.className = 'flex justify-between items-center py-2 border-b border-base-300';
                    chargeDiv.innerHTML = `
                        <span class="text-base-content/70">${description || 'Additional Charge'}</span>
                        <div class="text-right">
                            <div class="font-medium">${currencySymbol}${formatCurrency(amount)}</div>
                            ${currentCurrency === 'USD' ? `<div class="text-xs text-base-content/60">₱${formatCurrency(convertToPHP(amount))}</div>` : ''}
                        </div>
                    `;
                    additionalPreviewContainer.appendChild(chargeDiv);
                }
            });

            const total = freight + thc + additionalTotal;
            document.getElementById('previewTotal').textContent = `${currencySymbol}${formatCurrency(total)}`;
            if (currentCurrency === 'USD') {
                document.getElementById('previewTotalPHP').textContent = `₱${formatCurrency(convertToPHP(total))}`;
                document.getElementById('previewTotalPHP').classList.remove('hidden');
            } else {
                document.getElementById('previewTotalPHP').classList.add('hidden');
            }
        }

        window.removeCharge = function(id) {
            const row = document.getElementById(`charge-${id}`);
            if (row) {
                row.remove();
                updatePreview();
            }
        };

        document.getElementById('currency').addEventListener('change', function() {
            currentCurrency = this.value;
            updateCurrencySymbols();
            updatePreview();
        });

        document.getElementById('addChargeBtn').addEventListener('click', function() {
            chargeCounter++;
            const container = document.getElementById('additionalChargesContainer');
            const chargeDiv = document.createElement('div');
            chargeDiv.className = 'flex items-center gap-3';
            chargeDiv.id = `charge-${chargeCounter}`;
            chargeDiv.innerHTML = `
                <input type="text"
                       name="charge_desc_${chargeCounter}"
                       placeholder="Description"
                       class="input input-bordered flex-1 charge-description">
                <input type="number"
                       name="charge_amount_${chargeCounter}"
                       placeholder="Amount"
                       min="0"
                       step="0.01"
                       class="input input-bordered w-32 additional-charge-amount">
                <button type="button"
                        onclick="removeCharge(${chargeCounter})"
                        class="btn btn-ghost btn-sm btn-circle text-error">
                    <span class="icon-[tabler--x] size-5"></span>
                </button>
            `;
            container.appendChild(chargeDiv);
            chargeDiv.querySelector('.additional-charge-amount').addEventListener('input', updatePreview);
            chargeDiv.querySelector('.charge-description').addEventListener('input', updatePreview);
        });

        document.getElementById('freightCharges').addEventListener('input', updatePreview);
        document.getElementById('thcCharges').addEventListener('input', updatePreview);

        billingForm.addEventListener('submit', function(e) {
            const additionalCharges = [];
            for (let i = 1; i <= chargeCounter; i++) {
                const descInput = document.querySelector(`input[name="charge_desc_${i}"]`);
                const amountInput = document.querySelector(`input[name="charge_amount_${i}"]`);

                if (descInput && amountInput && descInput.value.trim() && amountInput.value) {
                    additionalCharges.push({
                        description: descInput.value.trim(),
                        amount: parseFloat(amountInput.value)
                    });
                }
            }

            document.getElementById('additionalChargesJson').value = JSON.stringify(additionalCharges);
            document.getElementById('exchangeRateInput').value =
                currentCurrency === 'USD' ? String(exchangeRate) : '';

            setGeneratingState(true);
            messageContainer.classList.add('hidden');
        });

        fetchExchangeRate();
    });
    </script>
    {% endif %}
{% endblock %}
