{% extends 'base.html.twig' %}

{% block title %}Declare Consignee - OPTIMUS{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Declare Consignee</h1>
                <p class="mt-2 text-gray-600">Manifest: {{ manifest.manifestNumber }}</p>
            </div>
            <a href="{{ path('manifest_workflow_detail', {id: manifest.id}) }}" 
               class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Manifest
            </a>
        </div>
    </div>

    <!-- Legacy manifest notice -->
    <div class="alert alert-warning mb-6">
        <span class="icon-[tabler--info-circle] size-5 shrink-0"></span>
        <div>
            <p class="font-semibold">Legacy manifest workflow</p>
            <p class="text-sm">This action applies only to older manifests created before consignees were assigned at NOA creation. New workflows select the consignee when creating the NOA.</p>
        </div>
    </div>

    <!-- Consignee Declaration Form -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <form id="consigneeDeclarationForm">
            <!-- Consignee Search -->
            <div class="mb-6">
                <label for="consigneeSearch" class="block text-sm font-medium text-gray-700 mb-2">
                    Search Consignee <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <input type="text" 
                           id="consigneeSearch" 
                           autocomplete="off"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="Type to search approved consignees...">
                    <div id="searchResults" class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-60 overflow-y-auto"></div>
                </div>
                <p class="mt-1 text-sm text-gray-500">Only approved consignees will appear in search results</p>
            </div>

            <!-- Selected Consignee -->
            <div id="selectedConsigneeContainer" class="mb-6 hidden">
                <label class="block text-sm font-medium text-gray-700 mb-2">Selected Consignee</label>
                <div id="selectedConsigneeCard" class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <!-- Will be populated by JavaScript -->
                </div>
                <p class="mt-1 text-sm text-gray-600">Note: The consignee will need to manually assign a broker from their approved list.</p>
            </div>

            <!-- Messages -->
            <div id="messageContainer" class="mb-6 hidden"></div>

            <!-- Submit Button -->
            <div class="flex items-center justify-end space-x-4">
                <a href="{{ path('manifest_workflow_detail', {id: manifest.id}) }}" 
                   class="px-6 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit" 
                        id="submitBtn"
                        disabled
                        class="px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
                    <span id="submitBtnText">Declare Consignee</span>
                    <span id="submitBtnLoading" class="hidden">
                        <svg class="animate-spin h-5 w-5 inline" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Processing...
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
const consignees = {{ consignees|json_encode|raw }};
let selectedConsignee = null;

// Consignee search functionality
const searchInput = document.getElementById('consigneeSearch');
const searchResults = document.getElementById('searchResults');
const selectedContainer = document.getElementById('selectedConsigneeContainer');
const selectedCard = document.getElementById('selectedConsigneeCard');
const submitBtn = document.getElementById('submitBtn');

searchInput.addEventListener('input', function() {
    const query = this.value.toLowerCase().trim();
    
    if (query.length < 2) {
        searchResults.classList.add('hidden');
        return;
    }
    
    const filtered = consignees.filter(c => 
        c.businessName.toLowerCase().includes(query) ||
        (c.fullName && c.fullName.toLowerCase().includes(query))
    );
    
    if (filtered.length === 0) {
        searchResults.innerHTML = '<div class="p-4 text-sm text-gray-500">No approved consignees found</div>';
        searchResults.classList.remove('hidden');
        return;
    }
    
    searchResults.innerHTML = filtered.map(c => `
        <div class="p-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0" 
             onclick="selectConsignee(${c.id})">
            <div class="font-medium text-gray-900">${c.businessName}</div>
        </div>
    `).join('');
    
    searchResults.classList.remove('hidden');
});

// Close search results when clicking outside
document.addEventListener('click', function(e) {
    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
        searchResults.classList.add('hidden');
    }
});

function selectConsignee(consigneeId) {
    selectedConsignee = consignees.find(c => c.id === consigneeId);
    
    if (!selectedConsignee) return;
    
    // Hide search results
    searchResults.classList.add('hidden');
    
    // Update search input
    searchInput.value = selectedConsignee.businessName;
    
    // Show selected consignee
    selectedCard.innerHTML = `
        <div class="flex items-start justify-between">
            <div>
                <div class="font-medium text-gray-900">${selectedConsignee.businessName}</div>
            </div>
            <button type="button" onclick="clearSelection()" class="text-red-600 hover:text-red-800">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    `;
    selectedContainer.classList.remove('hidden');
    
    // Enable submit button
    submitBtn.disabled = false;
}

function clearSelection() {
    selectedConsignee = null;
    searchInput.value = '';
    selectedContainer.classList.add('hidden');
    submitBtn.disabled = true;
}

// Form submission
document.getElementById('consigneeDeclarationForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    if (!selectedConsignee) return;
    
    const submitBtnText = document.getElementById('submitBtnText');
    const submitBtnLoading = document.getElementById('submitBtnLoading');
    const messageContainer = document.getElementById('messageContainer');
    
    // Disable submit button
    submitBtn.disabled = true;
    submitBtnText.classList.add('hidden');
    submitBtnLoading.classList.remove('hidden');
    
    try {
        const response = await fetch('/api/manifests/{{ manifest.id }}/declare-consignee', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                consigneeId: selectedConsignee.id
            })
        });
        
        const data = await response.json();
        
        if (response.ok) {
            // Success
            messageContainer.innerHTML = `
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-green-800">Consignee declared successfully!</h3>
                            <p class="mt-1 text-sm text-green-700">${data.consignee.businessName} has been associated with this manifest.</p>
                        </div>
                    </div>
                </div>
            `;
            messageContainer.classList.remove('hidden');
            
            // Redirect after 2 seconds
            setTimeout(() => {
                window.location.href = '/manifest-workflow/{{ manifest.id }}';
            }, 2000);
        } else {
            // Error
            messageContainer.innerHTML = `
                <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">Declaration failed</h3>
                            <p class="mt-1 text-sm text-red-700">${data.error || 'An error occurred'}</p>
                        </div>
                    </div>
                </div>
            `;
            messageContainer.classList.remove('hidden');
            
            // Re-enable submit button
            submitBtn.disabled = false;
            submitBtnText.classList.remove('hidden');
            submitBtnLoading.classList.add('hidden');
        }
    } catch (error) {
        messageContainer.innerHTML = `
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <div class="flex">
                    <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-red-800">Network error</h3>
                        <p class="mt-1 text-sm text-red-700">Failed to connect to server. Please try again.</p>
                    </div>
                </div>
            </div>
        `;
        messageContainer.classList.remove('hidden');
        
        // Re-enable submit button
        submitBtn.disabled = false;
        submitBtnText.classList.remove('hidden');
        submitBtnLoading.classList.add('hidden');
    }
});
</script>
{% endblock %}
