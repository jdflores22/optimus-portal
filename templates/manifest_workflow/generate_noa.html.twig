{% extends 'base.html.twig' %}

{% block title %}Generate NOA - OPTIMUS{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Generate Notice of Arrival</h1>
                <p class="mt-2 text-gray-600">Manifest: {{ manifest.manifestNumber }}</p>
            </div>
            <a href="{{ path('manifest_workflow_detail', {id: manifest.id}) }}" 
               class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Manifest
            </a>
        </div>
    </div>

    <!-- Workflow State Validation -->
    {% if manifest.workflowState.value != 'manifest_uploaded' %}
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <div class="flex">
                <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Invalid Workflow State</h3>
                    <p class="mt-1 text-sm text-red-700">NOA can only be generated when manifest is in "Manifest Uploaded" state. Current state: {{ manifest.workflowState.getDisplayName() }}</p>
                </div>
            </div>
        </div>
    {% else %}
        <!-- Two Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Column: Manifest and Consignee Information -->
            <div class="space-y-6">
                <!-- Manifest Information (Read-only) -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Manifest Information</h3>
                    <dl class="space-y-3">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Manifest Number</dt>
                            <dd class="mt-1 text-sm text-gray-900 font-mono">{{ manifest.manifestNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Vessel Name</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ manifest.vesselName }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Voyage Number</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ manifest.voyageNumber ?: 'N/A' }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Arrival Date</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ manifest.arrivalDate ? manifest.arrivalDate|date('M j, Y g:i A') : 'N/A' }}</dd>
                        </div>
                        {% if manifest.blNumber %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">BL Number</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ manifest.blNumber }}</dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>

                <!-- Consignee Information (Read-only) -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Consignee Information</h3>
                    <dl class="space-y-3">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Business Name</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ manifest.consignee ? manifest.consignee.businessName : 'Not declared' }}</dd>
                        </div>
                        {% if manifest.broker %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Broker</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ manifest.broker.fullName }}</dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>
            </div>

            <!-- Right Column: NOA Generation Form -->
            <div>
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Generate Notice of Arrival</h3>
                    <form id="noaGenerationForm">
                        <!-- Arrival Date -->
                        <div class="mb-6">
                            <label for="arrivalDate" class="block text-sm font-medium text-gray-700 mb-2">
                                Confirm Arrival Date <span class="text-red-500">*</span>
                            </label>
                            <input type="datetime-local" 
                                   id="arrivalDate" 
                                   name="arrivalDate" 
                                   required
                                   value="{{ manifest.arrivalDate ? manifest.arrivalDate|date('Y-m-d\\TH:i') : '' }}"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <p class="mt-1 text-xs text-gray-500">Verify or update the arrival date if needed</p>
                        </div>

                        <!-- Additional Vessel Information -->
                        <div class="mb-6">
                            <h4 class="text-md font-medium text-gray-900 mb-3">Additional Information (Optional)</h4>
                            
                            <!-- Lloyd's Number -->
                            <div class="mb-4">
                                <label for="lloydsNumber" class="block text-sm font-medium text-gray-700 mb-2">
                                    Lloyd's Number (IMO)
                                </label>
                                <input type="text" 
                                       id="lloydsNumber" 
                                       name="lloydsNumber"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       placeholder="e.g., IMO1234567">
                            </div>
                        </div>

                        <!-- Messages -->
                        <div id="messageContainer" class="mb-6 hidden"></div>

                        <!-- Submit Button -->
                        <div class="flex items-center justify-end space-x-4">
                            <a href="{{ path('manifest_workflow_detail', {id: manifest.id}) }}" 
                               class="px-6 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                                Cancel
                            </a>
                            <button type="submit" 
                                    id="submitBtn"
                                    class="px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                                <span id="submitBtnText">Generate NOA</span>
                                <span id="submitBtnLoading" class="hidden">
                                    <svg class="animate-spin h-5 w-5 inline" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    Generating...
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<script>
{% if manifest.workflowState.value == 'manifest_uploaded' %}
document.getElementById('noaGenerationForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const submitBtn = document.getElementById('submitBtn');
    const submitBtnText = document.getElementById('submitBtnText');
    const submitBtnLoading = document.getElementById('submitBtnLoading');
    const messageContainer = document.getElementById('messageContainer');
    
    // Disable submit button
    submitBtn.disabled = true;
    submitBtnText.classList.add('hidden');
    submitBtnLoading.classList.remove('hidden');
    
    // Get form data
    const formData = {
        arrivalDate: new Date(document.getElementById('arrivalDate').value).toISOString(),
        vesselInfo: {
            name: '{{ manifest.vesselName }}',
            voyage: '{{ manifest.voyageNumber }}' || null,
            lloydsNumber: document.getElementById('lloydsNumber').value.trim() || null
        }
    };
    
    try {
        const response = await fetch('/api/manifests/{{ manifest.id }}/noa', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (response.ok) {
            // Success
            messageContainer.innerHTML = `
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-green-800">NOA generated successfully!</h3>
                            <p class="mt-1 text-sm text-green-700">NOA ${data.noaNumber} has been created and notifications sent.</p>
                        </div>
                    </div>
                </div>
            `;
            messageContainer.classList.remove('hidden');
            
            // Redirect after 2 seconds
            setTimeout(() => {
                window.location.href = '/manifest-workflow/{{ manifest.id }}';
            }, 2000);
        } else {
            // Error
            messageContainer.innerHTML = `
                <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                    <div class="flex">
                        <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">Generation failed</h3>
                            <p class="mt-1 text-sm text-red-700">${data.error || 'An error occurred'}</p>
                        </div>
                    </div>
                </div>
            `;
            messageContainer.classList.remove('hidden');
            
            // Re-enable submit button
            submitBtn.disabled = false;
            submitBtnText.classList.remove('hidden');
            submitBtnLoading.classList.add('hidden');
        }
    } catch (error) {
        messageContainer.innerHTML = `
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <div class="flex">
                    <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-red-800">Network error</h3>
                        <p class="mt-1 text-sm text-red-700">Failed to connect to server. Please try again.</p>
                    </div>
                </div>
            </div>
        `;
        messageContainer.classList.remove('hidden');
        
        // Re-enable submit button
        submitBtn.disabled = false;
        submitBtnText.classList.remove('hidden');
        submitBtnLoading.classList.add('hidden');
    }
});
{% endif %}
</script>
{% endblock %}
