{% extends 'base.html.twig' %}

{% block title %}NOA {{ noa.noaNumber }} - OPTIMUS{% endblock %}
{% block page_title %}{{ noa.noaNumber }}{% endblock %}

{% set state = manifest ? manifest.workflowState : null %}
{% set workflowComplete = manifest ? manifest_workflow_is_complete(manifest) : false %}
{% set currentStep = manifest ? manifest_workflow_current_step(manifest) : 1 %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/edo-generation-progress.css') }}">
{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto w-full space-y-5 sm:space-y-6">

    {# Hero header — centralized workflow hub for shipping lines hierarchy #}
    <div class="rounded-3xl border border-primary/20 bg-gradient-to-br from-primary/15 via-base-100 to-base-100 shadow-sm p-5 sm:p-7">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
            <div class="space-y-3 min-w-0">
                <div class="breadcrumbs text-xs">
                    <ul>
                        {% if is_granted('ROLE_ACCOUNTING') and not is_granted('ROLE_SL_STAFF') %}
                            <li><a href="{{ path('app_accounting_dashboard_new') }}">Accounting Dashboard</a></li>
                        {% else %}
                            <li><a href="{{ path('manifest_workflow_list') }}">NOA &amp; BL Workflow</a></li>
                        {% endif %}
                        <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right] size-3.5"></span></li>
                        <li aria-current="page">{{ noa.noaNumber }}</li>
                    </ul>
                </div>

                <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
                    <span class="icon-[tabler--route] size-3.5"></span>
                    {% if isWorkflowHub|default(false) %}
                        Workflow Hub
                    {% else %}
                        NOA Workflow
                    {% endif %}
                </span>

                <div>
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-base-content leading-tight font-mono">
                            {{ noa.noaNumber }}
                        </h1>
                        {% if manifest %}
                            {% if state.value == 'edo_released' %}
                                <span class="badge badge-success badge-lg gap-2">
                                    <span class="icon-[tabler--circle-check] size-4"></span>
                                    {{ state.getDisplayName() }}
                                </span>
                            {% elseif state.value == 'edo_generated' %}
                                <span class="badge badge-info badge-lg gap-2">{{ state.getDisplayName() }}</span>
                            {% elseif state.value in ['billing_generated', 'payment_submitted'] %}
                                <span class="badge badge-warning badge-lg">{{ state.getDisplayName() }}</span>
                            {% elseif state.value in ['bl_generated', 'bl_uploaded'] %}
                                <span class="badge badge-info badge-lg">{{ state.getDisplayName() }}</span>
                            {% elseif state.value == 'noa_generated' %}
                                <span class="badge badge-primary badge-lg">{{ state.getDisplayName() }}</span>
                            {% else %}
                                <span class="badge badge-ghost badge-lg">{{ state.getDisplayName() }}</span>
                            {% endif %}
                        {% else %}
                            <span class="badge badge-primary badge-lg">NOA Created</span>
                        {% endif %}
                    </div>
                    <p class="mt-2 text-sm sm:text-base text-base-content/70 max-w-2xl">
                        {% if isWorkflowHub|default(false) %}
                            Centralized manifest workflow view for this shipment — NOA details, documents, containers, and eDO actions.
                        {% else %}
                            Notice of Arrival details, documents, and workflow status for this shipment.
                        {% endif %}
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    {% if manifest %}
                        {% if workflowComplete %}
                            <span class="badge badge-success badge-soft badge-lg gap-2">
                                <span class="icon-[tabler--circle-check] size-4"></span>
                                Workflow complete
                            </span>
                        {% else %}
                            <span class="badge badge-primary badge-soft badge-lg gap-2">
                                <span class="icon-[tabler--list-numbers] size-4"></span>
                                Step {{ currentStep }} of {{ manifest_workflow_total_steps() }}
                            </span>
                        {% endif %}
                    {% endif %}
                    {% if noa.vesselNumber %}
                        <span class="badge badge-ghost badge-lg gap-2">
                            <span class="icon-[tabler--ship] size-4"></span>
                            {{ noa.vesselNumber }}
                        </span>
                    {% endif %}
                    {% if noa.consignee %}
                        <span class="badge badge-ghost badge-lg gap-2">
                            <span class="icon-[tabler--building-store] size-4"></span>
                            {{ noa.consignee.businessName }}
                        </span>
                    {% endif %}
                    {% if manifest %}
                        <span class="badge badge-ghost badge-lg gap-2 font-mono">
                            <span class="icon-[tabler--file-description] size-4"></span>
                            {{ manifest.manifestNumber }}
                        </span>
                    {% endif %}
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 xl:justify-end shrink-0">
                {% if canEditNoa %}
                    <a href="{{ path('manifest_workflow_noa_edit_page', {id: noa.id}) }}"
                       class="btn btn-primary btn-sm sm:btn-md gap-2">
                        <span class="icon-[tabler--edit] size-4"></span>
                        Edit NOA
                    </a>
                {% endif %}
                {% if manifest %}
                    <a href="{{ path('audit_trail_manifest', {id: manifest.id}) }}"
                       class="btn btn-outline btn-primary btn-sm sm:btn-md gap-2">
                        <span class="icon-[tabler--history] size-4"></span>
                        Audit Trail
                    </a>
                {% endif %}
                {% if is_granted('ROLE_ACCOUNTING') and not is_granted('ROLE_SL_STAFF') %}
                    <a href="{{ path('app_accounting_dashboard_new') }}"
                       class="btn btn-ghost btn-sm sm:btn-md gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to Dashboard
                    </a>
                {% else %}
                    <a href="{{ path('manifest_workflow_list') }}"
                       class="btn btn-ghost btn-sm sm:btn-md gap-2">
                        <span class="icon-[tabler--arrow-left] size-4"></span>
                        Back to List
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm">
            <span class="icon-[tabler--circle-check] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error shadow-sm">
            <span class="icon-[tabler--circle-x] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning shadow-sm">
            <span class="icon-[tabler--alert-triangle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="alert alert-info shadow-sm">
            <span class="icon-[tabler--info-circle] size-5"></span>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    {% if manifest %}
    {# Workflow stepper #}
    <div class="card card-border bg-base-100 shadow-sm">
        <div class="card-body p-4 sm:p-6">
            <div class="flex items-center justify-between gap-3 mb-5">
                <h2 class="card-title text-base sm:text-lg">Workflow Progress</h2>
                {% if workflowComplete %}
                    <span class="badge badge-success badge-sm gap-1">
                        <span class="icon-[tabler--circle-check] size-3"></span>
                        Complete
                    </span>
                {% else %}
                    <span class="badge badge-soft badge-primary badge-sm">Step {{ currentStep }} of {{ manifest_workflow_total_steps() }}</span>
                {% endif %}
            </div>
            <div class="overflow-x-auto pb-1">
                {% include 'components/flyonui_stepper.html.twig' with {
                    steps: [
                        { label: 'NOA' },
                        { label: 'BL Gen' },
                        { label: 'BL Upload' },
                        { label: 'Billing' },
                        { label: 'Payment' },
                        { label: 'Validate' },
                        { label: 'eDO' },
                        { label: 'Release' }
                    ],
                    current: workflowComplete ? manifest_workflow_total_steps() + 1 : currentStep
                } %}
            </div>
        </div>
    </div>
    {% endif %}

    <div class="flex flex-col lg:flex-row gap-4 sm:gap-6 items-start">
            <!-- Main Content (Left Column) -->
            <div class="flex-1 min-w-0 space-y-4 sm:space-y-6">
                
                <!-- Tabs Navigation -->
                <nav class="tabs tabs-bordered" aria-label="NOA Tabs" role="tablist" aria-orientation="horizontal">
                <button type="button" 
                        class="tab active-tab:tab-active active w-full sm:w-auto" 
                        id="tab-details" 
                        data-tab="#content-details" 
                        aria-controls="content-details" 
                        role="tab" 
                        aria-selected="true">
                    <span class="icon-[tabler--file-text] size-4 mr-1.5"></span>
                    Details
                </button>
                <button type="button" 
                        class="tab active-tab:tab-active w-full sm:w-auto" 
                        id="tab-history" 
                        data-tab="#content-history" 
                        aria-controls="content-history" 
                        role="tab" 
                        aria-selected="false">
                    <span class="icon-[tabler--history] size-4 mr-1.5"></span>
                    Audit Trail
                </button>
            </nav>

            <!-- Tab Content -->
            <div class="mt-4">
                <!-- Details Tab -->
                <div id="content-details" role="tabpanel" aria-labelledby="tab-details">
                    <!-- 2 Column Grid Layout -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
                        <!-- Left Column (2/3 width) - Main Content -->
                        <div class="lg:col-span-2 space-y-4 sm:space-y-6">
            
            <!-- NOA Information -->
            <div class="card bg-base-100 shadow-md w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">NOA Information</h3>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">NOA Number</dt>
                            <dd class="mt-1 text-sm text-base-content font-mono">{{ noa.noaNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Created Date</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ noa.createdAt|date('M j, Y g:i A') }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">BL Number</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ noa.blNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Vessel Number</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ noa.vesselNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">ETA</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ noa.eta|date('M j, Y g:i A') }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Port Location</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ noa.dischargeLocation }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Manifest Information -->
            {% if manifest %}
            <div class="card bg-base-100 shadow-md w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Manifest Information</h3>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Manifest Number</dt>
                            <dd class="mt-1 text-sm text-base-content font-mono">{{ manifest.manifestNumber }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Created Date</dt>
                            <dd class="mt-1 text-sm text-base-content">{{ manifest.createdAt|date('M j, Y g:i A') }}</dd>
                        </div>
                        {% if manifest.vesselName %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Vessel Name</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.vesselName }}</dd>
                            </div>
                        {% endif %}
                        {% if manifest.voyageNumber %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Voyage Number</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.voyageNumber }}</dd>
                            </div>
                        {% endif %}
                        {% if manifest.arrivalDate %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">Arrival Date</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.arrivalDate|date('M j, Y g:i A') }}</dd>
                            </div>
                        {% endif %}
                        {% if manifest.blNumber %}
                            <div>
                                <dt class="text-sm font-medium text-base-content/60">BL Number</dt>
                                <dd class="mt-1 text-sm text-base-content">{{ manifest.blNumber }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </div>
            {% endif %}

            <!-- Consignee Information -->
            <div class="card bg-base-100 shadow-md w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Parties</h3>
                    <dl class="space-y-3 sm:space-y-4">
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Consignee</dt>
                            <dd class="mt-1">
                                <div class="text-sm text-base-content">{{ noa.consignee.businessName }}</div>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-base-content/60">Broker</dt>
                            <dd class="mt-1">
                                {% if manifest and manifest.broker %}
                                    <div class="text-sm text-base-content">{{ manifest.broker.fullName }}</div>
                                {% else %}
                                    <span class="text-sm text-base-content/40">None</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Containers & eDO Payment Status -->
            <div class="card bg-base-100 shadow-md w-full">
                <div class="card-body p-4 sm:p-6">

                    {# Calculate eDO generation progress #}
                    {% set totalContainers = noa.containers|length %}
                    {% set containersWithEdo = 0 %}
                    {% for container in noa.containers %}
                        {% set paymentStatus = containerPaymentStatus[container.id] ?? null %}
                        {% if paymentStatus and paymentStatus.has_edo %}
                            {% set containersWithEdo = containersWithEdo + 1 %}
                        {% endif %}
                    {% endfor %}
                    {% set allEdosGenerated = containersWithEdo == totalContainers and totalContainers > 0 %}
                    {% set edoProgress = totalContainers > 0 ? (containersWithEdo / totalContainers * 100)|round : 0 %}

                    {# Header #}
                    <div class="flex items-center justify-between mb-5">
                        <div class="flex items-center gap-3">
                            <span class="icon-[tabler--container] size-5 text-primary"></span>
                            <h3 class="card-title text-base sm:text-lg text-base-content">Containers & eDO Payment Status</h3>
                        </div>
                        <div class="flex items-center gap-3">
                            {# Select All Checkbox - Only show if payment is verified #}
                            {% set finalPaymentVerified = false %}
                            {% if manifest %}
                                {% for payment in manifest.payments %}
                                    {% if payment.paymentType.value == 'final_payment' and payment.status.value == 'verified' %}
                                        {% set finalPaymentVerified = true %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                            
                            {% if finalPaymentVerified and not allEdosGenerated %}
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="checkbox" 
                                           id="selectAllContainers" 
                                           class="checkbox checkbox-primary checkbox-sm">
                                    <span class="text-sm text-base-content/70">Select All</span>
                                </label>
                            {% endif %}
                            
                            {# eDO Generation Progress Badge #}
                            {% if allEdosGenerated %}
                                <div class="badge badge-success gap-1.5 font-semibold">
                                    <span class="icon-[tabler--circle-check] size-4"></span>
                                    All eDOs Generated
                                </div>
                            {% else %}
                                <div class="badge badge-primary badge-outline font-semibold">
                                    {{ containersWithEdo }}/{{ totalContainers }} eDOs
                                </div>
                            {% endif %}
                            
                            <div class="badge badge-ghost font-semibold">
                                {{ totalContainers }} container{{ totalContainers != 1 ? 's' : '' }}
                            </div>
                        </div>
                    </div>

                    {# Progress Bar - Only show if not all eDOs generated #}
                    {% if not allEdosGenerated and totalContainers > 0 %}
                        <div class="mb-4">
                            <div class="flex items-center justify-between text-xs text-base-content/60 mb-1">
                                <span>eDO Generation Progress</span>
                                <span class="font-semibold">{{ edoProgress }}%</span>
                            </div>
                            <div class="w-full bg-base-300 rounded-full h-2">
                                <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{ edoProgress }}%"></div>
                            </div>
                        </div>
                    {% endif %}

                    {% if noa.containers|length > 0 %}
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {% for container in noa.containers %}
                        {% set paymentStatus = containerPaymentStatus[container.id] ?? null %}

                        {# Determine accent color by allocation status #}
                        {% if container.allocationStatus.value == 'released' %}
                            {% set accentColor = 'border-success' %}
                        {% elseif container.allocationStatus.value == 'allocated' %}
                            {% set accentColor = 'border-info' %}
                        {% else %}
                            {% set accentColor = 'border-warning' %}
                        {% endif %}

                        <div class="rounded-xl border border-base-300 border-l-4 {{ accentColor }} bg-base-50 hover:bg-base-200/50 transition-colors">
                            <div class="p-4">
                                {# Checkbox for container selection - Only show if payment verified and no eDO yet #}
                                {% set hasEdo = paymentStatus and paymentStatus.has_edo %}
                                {% if finalPaymentVerified and not hasEdo %}
                                <div class="flex items-start gap-3">
                                    <input type="checkbox" 
                                           class="checkbox checkbox-primary checkbox-sm mt-1 container-checkbox" 
                                           value="{{ container.id }}"
                                           data-container-number="{{ container.containerNumber }}">
                                    <div class="flex-1">
                                {% endif %}

                                {# Top row: container number + badges #}
                                <div class="mb-3">
                                    <div class="flex items-center gap-2 min-w-0 mb-1.5">
                                        <span class="icon-[tabler--container] size-4 text-base-content/50 flex-shrink-0"></span>
                                        <span class="font-mono font-semibold text-sm text-base-content truncate">{{ container.containerNumber }}</span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-1.5">
                                        {% if container.manifest %}
                                            <span class="badge badge-success badge-sm gap-1">
                                                <span class="icon-[tabler--link] size-3"></span>
                                                Linked
                                            </span>
                                        {% endif %}
                                        {# eDO payment badge #}
                                        {% if paymentStatus and paymentStatus.has_edo %}
                                            {% if paymentStatus.has_payment %}
                                                {% if paymentStatus.payment_status == 'verified' %}
                                                    <span class="badge badge-success badge-sm gap-1">
                                                        <span class="icon-[tabler--circle-check] size-3"></span>
                                                        PAID {{ paymentStatus.payment_amount|format_money('PHP') }}
                                                    </span>
                                                {% elseif paymentStatus.payment_status == 'pending_validation' %}
                                                    <span class="badge badge-warning badge-sm gap-1">
                                                        <span class="icon-[tabler--clock] size-3"></span>
                                                        Pending Validation
                                                    </span>
                                                {% elseif paymentStatus.payment_status == 'rejected' %}
                                                    <span class="badge badge-error badge-sm gap-1">
                                                        <span class="icon-[tabler--x] size-3"></span>
                                                        Payment Rejected
                                                    </span>
                                                {% endif %}
                                            {% else %}
                                                <span class="badge badge-ghost badge-sm gap-1">
                                                    <span class="icon-[tabler--clock] size-3"></span>
                                                    Awaiting Payment
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge badge-ghost badge-sm gap-1">
                                                <span class="icon-[tabler--file-off] size-3"></span>
                                                No eDO Yet
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Info grid #}
                                <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs mb-3">
                                    <div>
                                        <span class="text-base-content/50 uppercase tracking-wide text-[10px]">Size</span>
                                        <div class="text-base-content font-medium">{{ container.containerSize ? container.containerSize.name : '—' }}</div>
                                    </div>
                                    <div>
                                        <span class="text-base-content/50 uppercase tracking-wide text-[10px]">Type</span>
                                        <div class="text-base-content font-medium">{{ container.containerType ? container.containerType.name : '—' }}</div>
                                    </div>
                                    <div>
                                        <span class="text-base-content/50 uppercase tracking-wide text-[10px]">TEU</span>
                                        <div class="text-base-content font-medium">{{ container.containerSize ? container.containerSize.teuValue : '—' }}</div>
                                    </div>
                                    <div>
                                        <span class="text-base-content/50 uppercase tracking-wide text-[10px]">CY Location</span>
                                        <div class="text-base-content font-medium">
                                            {{ container.cyAllocation ? container.cyAllocation.containerYard.name : '—' }}
                                            {% if container.cyAllocation %}
                                                <span class="text-base-content/40">({{ container.cyAllocation.terminal.name }})</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {# Bottom row: allocation status + actions #}
                                <div class="flex flex-wrap items-center gap-2 pt-2.5 border-t border-base-300/60">
                                    <span class="text-xs text-base-content/50">Allocation:</span>
                                    {% if container.allocationStatus.value == 'pre_forecast' %}
                                        <span class="badge badge-warning badge-sm gap-1">
                                            <span class="icon-[tabler--clock] size-3"></span>
                                            Pre-Forecast
                                        </span>
                                        <button type="button"
                                                onclick="openCYReassignmentModal({{ container.id }}, '{{ container.containerNumber }}', {{ container.cyAllocation ? container.cyAllocation.id : 'null' }}, {{ container.containerSize.teuValue }}, {{ container.shippingLine ? container.shippingLine.id : 'null' }}, '{{ container.containerSize.name }}', '{{ container.containerType.name }}')"
                                                class="btn btn-xs btn-outline btn-info gap-1">
                                            <span class="icon-[tabler--arrows-exchange] size-3"></span>
                                            Change CY
                                        </button>
                                    {% elseif container.allocationStatus.value == 'allocated' %}
                                        <div class="tooltip" data-tip="CY allocation is locked after eDO generation. Contact administrator if changes are needed.">
                                            <span class="badge badge-info badge-sm gap-1 cursor-help">
                                                <span class="icon-[tabler--lock] size-3"></span>
                                                Allocated (Locked)
                                            </span>
                                        </div>
                                    {% elseif container.allocationStatus.value == 'released' %}
                                        <span class="badge badge-success badge-sm gap-1">
                                            <span class="icon-[tabler--circle-check] size-3"></span>
                                            Released
                                        </span>
                                    {% endif %}

                                    {# eDO number + receipt link if applicable #}
                                    {% if paymentStatus and paymentStatus.has_edo %}
                                        <span class="text-xs text-base-content/50 ml-auto">eDO: <span class="font-mono text-base-content">{{ paymentStatus.edo_number }}</span></span>
                                        {% if paymentStatus.official_receipt_path %}
                                            <a href="{{ asset('uploads/receipts/' ~ paymentStatus.official_receipt_path) }}"
                                               target="_blank"
                                               class="btn btn-xs btn-ghost text-info gap-1">
                                                <span class="icon-[tabler--file-text] size-3"></span>
                                                Receipt
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </div>

                                {% if finalPaymentVerified and not hasEdo %}
                                    </div> {# Close flex-1 wrapper #}
                                </div> {# Close flex items-start gap-3 #}
                                {% endif %}
                            </div> {# Close p-4 #}
                        </div> {# Close rounded-xl card #}
                        {% endfor %}
                        </div>

                        {# Info note - Dynamic based on completion status #}
                        {% if allEdosGenerated %}
                            <div class="flex items-start gap-3 mt-4 p-3 rounded-lg bg-success/10 border border-success/20 text-xs text-success">
                                <span class="icon-[tabler--circle-check] size-4 flex-shrink-0 mt-0.5"></span>
                                <div>
                                    <span class="font-semibold">All eDOs Generated!</span> —
                                    All {{ totalContainers }} container{{ totalContainers != 1 ? 's have' : ' has' }} eDOs generated. Brokers can now proceed with payment and release.
                                </div>
                            </div>
                        {% elseif containersWithEdo > 0 %}
                            <div class="flex items-start gap-3 mt-4 p-3 rounded-lg bg-warning/10 border border-warning/20 text-xs text-warning">
                                <span class="icon-[tabler--clock] size-4 flex-shrink-0 mt-0.5"></span>
                                <div>
                                    <span class="font-semibold">Partial eDO Generation</span> —
                                    {{ containersWithEdo }} of {{ totalContainers }} container{{ totalContainers != 1 ? 's have' : ' has' }} eDOs generated. 
                                    {{ totalContainers - containersWithEdo }} container{{ (totalContainers - containersWithEdo) != 1 ? 's' : '' }} remaining.
                                </div>
                            </div>
                        {% else %}
                            <div class="flex items-start gap-3 mt-4 p-3 rounded-lg bg-info/10 border border-info/20 text-xs text-info">
                                <span class="icon-[tabler--info-circle] size-4 flex-shrink-0 mt-0.5"></span>
                                <div>
                                    <span class="font-semibold">eDO Generation Status</span> —
                                    After payment verification, you can generate individual eDOs for each container with verified payment.
                                </div>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="flex flex-col items-center justify-center py-10 text-base-content/40 gap-2">
                            <span class="icon-[tabler--container-off] size-10"></span>
                            <p class="text-sm">No containers found</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Available Documents -->
            <div class="card bg-base-100 shadow-md w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Available Documents</h3>
                    {% if noaPdfRegenerateEnabled and canEditNoa %}
                        <form method="POST" action="{{ path('manifest_workflow_noa_regenerate_pdf', {id: noa.id}) }}" class="mb-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('regenerate_noa_pdf_' ~ noa.id) }}">
                            <button type="submit" class="btn btn-sm btn-warning btn-soft gap-2 w-full sm:w-auto">
                                <span class="icon-[tabler--refresh] size-4"></span>
                                Regenerate NOA PDF
                            </button>
                        </form>
                    {% endif %}
                    {% if manifestBlPdfRegenerateEnabled and canEditNoa and manifest %}
                        <form method="POST" action="{{ path('manifest_workflow_manifest_regenerate_pdf', {id: noa.id}) }}" class="mb-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('regenerate_manifest_pdf_' ~ noa.id) }}">
                            <button type="submit" class="btn btn-sm btn-warning btn-soft gap-2 w-full sm:w-auto">
                                <span class="icon-[tabler--refresh] size-4"></span>
                                Regenerate Manifest/BL PDF
                            </button>
                        </form>
                    {% endif %}
                    {% if billingPdfRegenerateEnabled and (canEditNoa or is_granted('ROLE_ACCOUNTING')) and manifest and manifest.billing %}
                        <form method="POST" action="{{ path('manifest_workflow_billing_regenerate_pdf', {id: noa.id}) }}" class="mb-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('regenerate_billing_pdf_' ~ noa.id) }}">
                            <button type="submit" class="btn btn-sm btn-warning btn-soft gap-2 w-full sm:w-auto">
                                <span class="icon-[tabler--refresh] size-4"></span>
                                Regenerate Billing PDF
                            </button>
                        </form>
                    {% endif %}
                    {% set regeneratableEdos = manifest ? manifest.edos|filter(edo => edo.pdfPath and edo.pdfPath not in ['pending', 'failed']) : [] %}
                    {% if edoPdfRegenerateEnabled|default(false) and canEditNoa and regeneratableEdos|length > 0 %}
                        <form method="POST" action="{{ path('manifest_workflow_edo_regenerate_pdf', {id: noa.id}) }}" class="mb-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('regenerate_edo_pdf_' ~ noa.id) }}">
                            <button type="submit" class="btn btn-sm btn-warning btn-soft gap-2 w-full sm:w-auto">
                                <span class="icon-[tabler--refresh] size-4"></span>
                                Regenerate eDO PDF
                            </button>
                        </form>
                    {% endif %}
                    <div class="space-y-2 sm:space-y-3">
                        {# Notice of Arrival (NOA) PDF #}
                        {% if noa.pdfPath or noaPdfRegenerateEnabled %}
                            <div class="flex items-center justify-between p-3 bg-primary/10 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 bg-primary rounded-lg flex items-center justify-center mr-2 sm:mr-3">
                                        <span class="icon-[tabler--file-text] size-5 sm:size-6 text-primary-content"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Notice of Arrival (NOA)</div>
                                            <span class="icon-[tabler--circle-check] size-4 text-success ml-1 flex-shrink-0"></span>
                                        </div>
                                        <div class="text-xs text-base-content/60 truncate">{{ noa.noaNumber }}</div>
                                    </div>
                                </div>
                                <a href="{{ path('manifest_workflow_noa_download_pdf', {id: noa.id}) }}" 
                                   class="btn btn-sm btn-primary btn-soft ml-2 flex-shrink-0 gap-1{% if not noa.pdfPath %} btn-disabled{% endif %}"
                                   {% if not noa.pdfPath %}aria-disabled="true" tabindex="-1"{% endif %}>
                                    <span class="icon-[tabler--download] size-4 mr-1"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Manifest/BL Document #}
                        {% if manifest and (noa.manifestPdfPath or manifest.manifestFilePath or manifestBlPdfRegenerateEnabled) %}
                            <div class="flex items-center justify-between p-3 bg-info/10 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 bg-info rounded-lg flex items-center justify-center mr-2 sm:mr-3">
                                        <span class="icon-[tabler--file-text] size-5 sm:size-6 text-info-content"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Manifest/BL Document</div>
                                            {% if noa.manifestPdfPath or manifest.manifestFilePath %}
                                                <span class="icon-[tabler--circle-check] size-4 text-success ml-1 flex-shrink-0"></span>
                                            {% endif %}
                                        </div>
                                        <div class="text-xs text-base-content/60 truncate">{{ manifest.manifestNumber }}</div>
                                    </div>
                                </div>
                                {% if noa.manifestPdfPath or manifest.manifestFilePath %}
                                    <a href="{{ path('api_manifest_download_by_id', {manifestId: manifest.id}) }}"
                                       target="_blank"
                                       class="btn btn-sm btn-info btn-soft ml-2 flex-shrink-0 gap-1">
                                        <span class="icon-[tabler--download] size-4 mr-1"></span>
                                        Download
                                    </a>
                                {% endif %}
                            </div>
                        {% endif %}

                        {# Bill of Lading - Show if BL exists #}
                        {% if manifest and manifest.blNumber and manifest.blFilePath %}
                            <div class="flex items-center justify-between p-3 bg-base-200 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <span class="icon-[tabler--file-description] size-6 sm:size-8 text-info mr-2 sm:mr-3 flex-shrink-0"></span>
                                    <div class="min-w-0">
                                        <div class="text-xs sm:text-sm font-medium text-base-content truncate">Bill of Lading</div>
                                        <div class="text-xs text-base-content/60 truncate">{{ manifest.blNumber }}</div>
                                    </div>
                                </div>
                                <a href="/api/bl/{{ manifest.blNumber }}/download" 
                                   target="_blank"
                                   class="btn btn-sm btn-info btn-soft ml-2 flex-shrink-0 gap-1">
                                    <span class="icon-[tabler--download] size-4"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Billing Document - Show if billing exists #}
                        {% if manifest and manifest.billing %}
                            <div class="flex items-center justify-between p-3 bg-warning/10 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 bg-warning rounded-lg flex items-center justify-center mr-2 sm:mr-3">
                                        <span class="icon-[tabler--receipt] size-5 sm:size-6 text-warning-content"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Billing Document</div>
                                            {% if manifest.billing.pdfPath %}
                                                <span class="icon-[tabler--circle-check] size-4 text-success ml-1 flex-shrink-0"></span>
                                            {% endif %}
                                        </div>
                                        <div class="text-xs text-base-content/60 truncate">Total: {{ manifest.billing|format_billing }}</div>
                                    </div>
                                </div>
                                <a href="{{ path('manifest_workflow_billing_download_pdf', {id: noa.id}) }}"
                                   class="btn btn-sm btn-warning btn-soft ml-2 flex-shrink-0 gap-1{% if not manifest.billing.pdfPath %} btn-disabled{% endif %}"
                                   {% if not manifest.billing.pdfPath %}aria-disabled="true" tabindex="-1"{% endif %}>
                                    <span class="icon-[tabler--download] size-4 mr-1"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# eDO Document - Show when eDOs with PDF exist #}
                        {% if regeneratableEdos|length > 0 %}
                            {% set firstRegeneratableEdo = regeneratableEdos|first %}
                            <div class="flex items-center justify-between p-3 bg-success/10 rounded-lg">
                                <div class="flex items-center min-w-0 flex-1">
                                    <div class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 bg-success rounded-lg flex items-center justify-center mr-2 sm:mr-3">
                                        <span class="icon-[tabler--file-certificate] size-5 sm:size-6 text-success-content"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Electronic Delivery Order (eDO)</div>
                                            <span class="icon-[tabler--circle-check] size-4 text-success ml-1 flex-shrink-0"></span>
                                        </div>
                                        <div class="text-xs text-base-content/60 truncate">
                                            {{ regeneratableEdos|length }} container{{ regeneratableEdos|length != 1 ? 's' : '' }}
                                            {% if firstRegeneratableEdo.edoNumber %}· {{ firstRegeneratableEdo.edoNumber }}{% if regeneratableEdos|length > 1 %} + others{% endif %}{% endif %}
                                        </div>
                                    </div>
                                </div>
                                <a href="/api/edos/{{ firstRegeneratableEdo.edoNumber }}/download"
                                   target="_blank"
                                   class="btn btn-sm btn-success btn-soft ml-2 flex-shrink-0 gap-1">
                                    <span class="icon-[tabler--download] size-4 mr-1"></span>
                                    Download
                                </a>
                            </div>
                        {% endif %}

                        {# Official Receipt - Show if payment is verified #}
                        {% if manifest %}
                            {% set finalPayment = null %}
                            {% for payment in manifest.payments %}
                                {% if payment.paymentType.value == 'final_payment' and payment.status.value == 'verified' %}
                                    {% set finalPayment = payment %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if finalPayment and finalPayment.officialReceiptPath %}
                                <div class="flex items-center justify-between p-3 bg-base-200 rounded-lg">
                                    <div class="flex items-center min-w-0 flex-1">
                                        <span class="icon-[tabler--circle-check] size-6 sm:size-8 text-success mr-2 sm:mr-3 flex-shrink-0"></span>
                                        <div class="min-w-0">
                                            <div class="text-xs sm:text-sm font-medium text-base-content truncate">Official Receipt</div>
                                            <div class="text-xs text-base-content/60 truncate">Payment verified - OR issued</div>
                                        </div>
                                    </div>
                                    <a href="{{ finalPayment.officialReceiptPath }}" 
                                       target="_blank"
                                       class="btn btn-sm btn-success btn-soft ml-2 flex-shrink-0 gap-1">
                                        <span class="icon-[tabler--download] size-4"></span>
                                        Download
                                    </a>
                                </div>
                            {% endif %}
                        {% endif %}

                        {% if not noa.pdfPath and (not manifest or (not noa.manifestPdfPath and not manifest.manifestFilePath)) %}
                            <p class="text-sm text-base-content/60">No documents available yet</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Payment History -->
            {% if manifest %}
            <div class="card bg-base-100 shadow-md w-full">
                <div class="card-body p-4 sm:p-6">
                    <h3 class="card-title text-base sm:text-lg text-base-content">Payment History</h3>
                    {% set hasFinalPayment = false %}
                    {% for payment in manifest.payments %}
                        {% if payment.paymentType.value == 'final_payment' %}
                            {% set hasFinalPayment = true %}
                        {% endif %}
                    {% endfor %}
                    
                    {% if hasFinalPayment %}
                        <div class="space-y-3">
                            {# Final Payment #}
                            {% for payment in manifest.payments %}
                                {% if payment.paymentType.value == 'final_payment' %}
                                    <div class="card bg-base-200 shadow-sm">
                                        <div class="card-body p-4">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-sm font-medium text-base-content">Final Payment</span>
                                                {% if payment.status.value == 'verified' %}
                                                    <span class="badge badge-success">Verified</span>
                                                {% elseif payment.status.value == 'rejected' %}
                                                    <span class="badge badge-error">Rejected</span>
                                                {% else %}
                                                    <span class="badge badge-warning">Pending</span>
                                                {% endif %}
                                            </div>
                                            <div class="text-sm text-base-content/80">
                                                Amount: {{ payment|format_payment }}
                                            </div>
                                            <div class="text-xs text-base-content/60 mt-1">
                                                Submitted: {{ payment.createdAt|date('M j, Y g:i A') }}
                                            </div>
                                            {% if payment.status.value == 'rejected' and payment.rejectionReason %}
                                                <div class="alert alert-error mt-2">
                                                    <span class="icon-[tabler--alert-circle] size-4"></span>
                                                    <span class="text-xs">Reason: {{ payment.rejectionReason }}</span>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                            
                            {# eDO Access Payment - Check container payment status #}
                            {% set hasEdoPayment = false %}
                            {% set edoPaymentData = null %}
                            {% for containerId, paymentStatus in containerPaymentStatus %}
                                {% if paymentStatus.has_payment %}
                                    {% set hasEdoPayment = true %}
                                    {% set edoPaymentData = paymentStatus %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if hasEdoPayment and edoPaymentData %}
                                <div class="card bg-base-200 shadow-sm">
                                    <div class="card-body p-4">
                                        <div class="flex items-center justify-between mb-2">
                                            <span class="text-sm font-medium text-base-content">eDO Access Payment</span>
                                            {% if edoPaymentData.payment_status == 'verified' %}
                                                <span class="badge badge-success">Paid</span>
                                            {% elseif edoPaymentData.payment_status == 'rejected' %}
                                                <span class="badge badge-error">Rejected</span>
                                            {% else %}
                                                <span class="badge badge-warning">Pending Validation</span>
                                            {% endif %}
                                        </div>
                                        <div class="text-sm text-base-content/80">
                                            Amount: {{ edoPaymentData.payment_amount|format_money('PHP') }}
                                        </div>
                                        <div class="text-xs text-base-content/60 mt-1">
                                            Submitted: {{ edoPaymentData.payment_verified_at ? edoPaymentData.payment_verified_at|date('M j, Y g:i A') : 'N/A' }}
                                        </div>
                                        {% if edoPaymentData.payment_status == 'verified' and edoPaymentData.payment_verified_at %}
                                            <div class="text-xs text-base-content/60 mt-1">
                                                Validated: {{ edoPaymentData.payment_verified_at|date('M j, Y g:i A') }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="text-sm text-base-content/60">No payments submitted yet</p>
                    {% endif %}
                </div>
            </div>
            {% endif %}
                        </div>
                        <!-- End Left Column -->

                        <!-- Right Column (1/3 width) - Quick Actions -->
                        <div class="lg:col-span-1">
                            <div class="card bg-base-100 shadow-md sticky top-6 w-full">
                                <div class="card-body p-4 sm:p-6">
                                    <h3 class="card-title text-base sm:text-lg mb-3 sm:mb-4 text-base-content">Quick Actions</h3>
                                    <div class="space-y-2 sm:space-y-3 w-full">
                                        {% if manifest %}
                                            {% if manifest.workflowState.value == 'noa_generated' %}
                                                <a href="{{ path('manifest_workflow_generate_manifest_form', {id: noa.id}) }}" 
                                                   class="btn btn-success w-full text-sm sm:text-base">
                                                    Generate Manifest/BL
                                                </a>
                                            {% endif %}
                                            
                                            {# eDO Generation Button - Show when payment is verified #}
                                            {% set finalPaymentVerified = false %}
                                            {% for payment in manifest.payments %}
                                                {% if payment.paymentType.value == 'final_payment' and payment.status.value == 'verified' %}
                                                    {% set finalPaymentVerified = true %}
                                                {% endif %}
                                            {% endfor %}
                                            
                                            {% if finalPaymentVerified and not allEdosGenerated and manifest.workflowState.value in ['payment_verified', 'edo_generated', 'edo_released'] %}
                                                <button type="button" 
                                                        onclick="openEDOGenerationModal()"
                                                        class="btn btn-info w-full text-sm sm:text-base">
                                                    <span class="icon-[tabler--file-certificate] size-4 mr-2"></span>
                                                    Generate eDOs
                                                </button>
                                            {% endif %}
                                        {% else %}
                                            <a href="{{ path('manifest_workflow_generate_manifest_form', {id: noa.id}) }}" 
                                               class="btn btn-success w-full text-sm sm:text-base">
                                                Generate Manifest/BL
                                            </a>
                                        {% endif %}
                                        
                                        <a href="{{ path('manifest_workflow_list') }}" 
                                           class="btn btn-outline w-full text-sm sm:text-base">
                                            <span class="icon-[tabler--clipboard-list] size-4 mr-2"></span>
                                            Back to NOA List
                                        </a>
                                    </div>

                                    <!-- Workflow Timeline -->
                                    <div class="mt-6 pt-6 border-t border-base-content/10">
                                        {% set currentStep = manifest_workflow_current_step(manifest) %}
                                        {% set totalSteps = manifest_workflow_total_steps() %}

                                        <div class="flex items-center justify-between mb-4">
                                            <h4 class="text-sm font-medium text-base-content">Workflow Timeline</h4>
                                            {% if manifest_workflow_is_complete(manifest) %}
                                                <span class="badge badge-success badge-sm gap-1">
                                                    <span class="icon-[tabler--circle-check] size-3"></span>
                                                    Complete
                                                </span>
                                            {% else %}
                                                <span class="text-xs text-base-content/40">Step {{ currentStep }} of {{ totalSteps }}</span>
                                            {% endif %}
                                        </div>
                                        
                                        <ul class="timeline timeline-vertical timeline-compact">
                                            <!-- Step 1: NOA Created -->
                                            <li>
                                                <hr class="{% if currentStep >= 1 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 1 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 1 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">NOA Created</div>
                                                    <div class="text-xs text-base-content/60">{{ noa.createdAt|date('M j, Y') }}</div>
                                                </div>
                                                <hr class="{% if currentStep > 1 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 2: BL Generated -->
                                            <li>
                                                <hr class="{% if currentStep > 1 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 2 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 2 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">BL Generated</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 2 and manifest %}{{ manifest.createdAt|date('M j, Y') }}{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 2 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 3: BL Uploaded -->
                                            <li>
                                                <hr class="{% if currentStep > 2 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 3 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 3 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">BL Uploaded</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 3 and manifest and manifest.blNumber %}{{ manifest.updatedAt|date('M j, Y') }}{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 3 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 4: Billing Generated -->
                                            <li>
                                                <hr class="{% if currentStep > 3 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 4 %}bg-warning/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 4 %}badge-warning{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">Billing Generated</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 4 and manifest and manifest.billing %}{{ manifest.billing.createdAt|date('M j, Y') }}{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 4 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 5: Submit Payment -->
                                            <li>
                                                <hr class="{% if currentStep > 4 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 5 %}bg-secondary/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 5 %}badge-secondary{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">Submit Payment</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if manifest and manifest.workflowState.value == 'payment_submitted' %}
                                                            Submitted · awaiting validation
                                                        {% elseif currentStep >= 6 %}
                                                            Submitted
                                                        {% else %}
                                                            Pending
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 5 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 6: Validate Payment -->
                                            <li>
                                                <hr class="{% if currentStep > 5 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 6 %}bg-accent/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 6 %}badge-accent{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">Validate Payment</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 6 and manifest %}
                                                            {% set verifiedPayment = null %}
                                                            {% for p in manifest.payments %}
                                                                {% if p.paymentType.value == 'final_payment' and p.status.value == 'verified' %}
                                                                    {% set verifiedPayment = p %}
                                                                {% endif %}
                                                            {% endfor %}
                                                            Verified{% if verifiedPayment and verifiedPayment.validatedAt %} · {{ verifiedPayment.validatedAt|date('M j, Y') }}{% endif %}
                                                        {% else %}
                                                            Pending
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 6 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 7: eDO Generated -->
                                            <li>
                                                <hr class="{% if currentStep > 6 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 7 %}bg-info/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 7 %}badge-info{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">eDO Generated</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% set firstEdo = (manifest and manifest.edos is not empty) ? (manifest.edos|first) : null %}
                                                        {% if currentStep >= 7 and firstEdo and firstEdo.createdAt %}
                                                            {{ firstEdo.createdAt|date('M j, Y') }}
                                                        {% elseif currentStep >= 7 %}
                                                            Completed
                                                        {% else %}
                                                            Pending
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <hr class="{% if currentStep > 7 %}bg-success{% endif %}" />
                                            </li>

                                            <!-- Step 8: eDO Released -->
                                            <li>
                                                <hr class="{% if currentStep > 7 %}bg-success{% endif %}" />
                                                <div class="timeline-middle">
                                                    <span class="{% if currentStep >= 8 %}bg-success/20{% else %}bg-base-content/20{% endif %} flex size-3 items-center justify-center rounded-full">
                                                        <span class="badge {% if currentStep >= 8 %}badge-success{% else %}badge-ghost{% endif %} size-2 rounded-full p-0"></span>
                                                    </span>
                                                </div>
                                                <div class="timeline-end">
                                                    <div class="text-xs font-medium text-base-content">eDO Released</div>
                                                    <div class="text-xs text-base-content/60">
                                                        {% if currentStep >= 8 and manifest and manifest.completedAt %}{{ manifest.completedAt|date('M j, Y') }}{% elseif currentStep >= 8 %}Completed{% else %}Pending{% endif %}
                                                    </div>
                                                </div>
                                                <hr />
                                            </li>
                                        </ul>

                                        {% if manifest_workflow_is_complete(manifest) %}
                                            <div class="mt-4 flex items-center gap-2 p-3 rounded-lg bg-success/10 border border-success/20">
                                                <span class="icon-[tabler--rosette-discount-check] size-5 text-success flex-shrink-0"></span>
                                                <div>
                                                    <div class="text-xs font-semibold text-success">Workflow Complete</div>
                                                    <div class="text-xs text-base-content/50">All steps have been successfully completed.</div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <!-- Summary Stats -->
                                    <div class="mt-6 pt-6 border-t border-base-content/10">
                                        <h4 class="text-sm font-medium text-base-content mb-3">Summary</h4>
                                        <dl class="space-y-2">
                                            <div class="flex justify-between">
                                                <dt class="text-sm text-base-content/60">Total Containers</dt>
                                                <dd class="text-sm font-medium text-base-content">{{ noa.containers|length }}</dd>
                                            </div>
                                            <div class="flex justify-between">
                                                <dt class="text-sm text-base-content/60">Total TEU</dt>
                                                <dd class="text-sm font-medium text-base-content">
                                                    {% set totalTeu = 0 %}
                                                    {% for container in noa.containers %}
                                                        {% set totalTeu = totalTeu + container.containerSize.teuValue %}
                                                    {% endfor %}
                                                    {{ totalTeu }}
                                                </dd>
                                            </div>
                                        </dl>
                                    </div>

                                    <!-- Status Info -->
                                    <div class="mt-6 pt-6 border-t border-base-content/10">
                                        <div class="alert alert-info">
                                            <span class="icon-[tabler--info-circle] size-5"></span>
                                            <div>
                                                <h3 class="text-sm font-medium text-base-content">NOA Created</h3>
                                                <p class="mt-1 text-xs">This NOA has been successfully created. Next step: Generate Manifest/BL.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- End Right Column -->
                    </div>
                    <!-- End 2 Column Grid -->
                    </div>
                    <!-- End Details Tab -->

                <!-- History/Audit Trail Tab -->
                <div id="content-history" class="hidden" role="tabpanel" aria-labelledby="tab-history">
                    <div class="card bg-base-100 shadow-md">
                        <div class="card-body p-4 sm:p-6">
                            <h3 class="card-title text-base sm:text-lg text-base-content mb-4">
                                <span class="icon-[tabler--history] size-5"></span>
                                Audit Trail
                            </h3>
                            
                            {% if auditLogs|length > 0 %}
                                <ul class="timeline timeline-snap-icon timeline-compact timeline-vertical w-full">
                                    {% set currentDate = null %}
                                    {% for log in auditLogs %}
                                        {% set logDate = log.timestamp|date('F j, Y') %}
                                        
                                        {# Show date separator if date changed #}
                                        {% if logDate != currentDate %}
                                            <span class="text-sm {% if not loop.first %}mt-2{% endif %}">{{ logDate }}</span>
                                            {% set currentDate = logDate %}
                                        {% endif %}
                                        
                                        <!-- Timeline Item -->
                                        <li>
                                            <div class="timeline-middle">
                                                <span class="flex items-center justify-center bg-primary size-4.5 rounded-full p-0">
                                                    {% if log.action == 'NOA_CREATED' %}
                                                        <span class="icon-[tabler--plus] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'NOA_UPDATED' %}
                                                        <span class="icon-[tabler--edit] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'NOA_DELETED' %}
                                                        <span class="icon-[tabler--trash] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'MANIFEST_CREATED' or log.action == 'MANIFEST_GENERATED' %}
                                                        <span class="icon-[tabler--file-plus] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'MANIFEST_UPDATED' %}
                                                        <span class="icon-[tabler--edit] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'PAYMENT_SUBMITTED' or log.action == 'PAYMENT_CREATED' %}
                                                        <span class="icon-[tabler--cash] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'PAYMENT_VERIFIED' or log.action == 'PAYMENT_APPROVED' %}
                                                        <span class="icon-[tabler--circle-check] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'PAYMENT_REJECTED' %}
                                                        <span class="icon-[tabler--x] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'EDO_GENERATED' or log.action == 'EDO_CREATED' %}
                                                        <span class="icon-[tabler--file-certificate] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'EDO_RELEASED' %}
                                                        <span class="icon-[tabler--send] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'EDO_ACCESSED' or log.action == 'EDO_DOWNLOADED' %}
                                                        <span class="icon-[tabler--download] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'CONTAINER_ALLOCATED' or log.action == 'CONTAINER_ASSIGNED' %}
                                                        <span class="icon-[tabler--container] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'CONTAINER_RELEASED' %}
                                                        <span class="icon-[tabler--truck-delivery] text-primary-content size-3"></span>
                                                    {% elseif log.action == 'CONTAINER_UPDATED' %}
                                                        <span class="icon-[tabler--edit] text-primary-content size-3"></span>
                                                    {% else %}
                                                        <span class="icon-[tabler--check] text-primary-content size-3"></span>
                                                    {% endif %}
                                                </span>
                                            </div>
                                            <div class="timeline-end ms-2 m-3 w-full rounded-lg">
                                                <div class="text-base-content pt-0.5 mb-3 font-medium">
                                                    {{ log.action|replace({'_': ' '})|title }}
                                                    <span class="badge badge-ghost badge-xs ml-2">{{ log.entityType }}</span>
                                                </div>
                                                
                                                {% if log.changes.changes is defined and log.changes.changes|length > 0 %}
                                                    <div class="mb-2">
                                                        {% for change in log.changes.changes %}
                                                            <p class="mb-1">{{ change }}</p>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                                
                                                {# Display broker information for broker assignment #}
                                                {% if log.action == 'broker_assigned' and log.changes.broker_email is defined %}
                                                    <div class="mb-3 p-3 rounded-lg bg-base-200/50 border border-base-300">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <span class="icon-[tabler--user-check] size-4 text-primary"></span>
                                                            <span class="text-sm font-semibold text-base-content">Broker Assigned</span>
                                                        </div>
                                                        <div class="text-sm text-base-content/80">
                                                            <span class="font-medium">{{ log.changes.broker_email }}</span>
                                                        </div>
                                                        {% if log.changes.reason is defined and log.changes.reason %}
                                                            <div class="text-xs text-base-content/60 mt-1">
                                                                <span class="font-medium">Reason:</span> {{ log.changes.reason }}
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                                
                                                <div class="flex gap-2">
                                                    <div class="avatar">
                                                        <div class="size-8 rounded-full bg-primary text-primary-content flex items-center justify-center">
                                                            <span class="text-xs font-semibold">{{ log.user.email|slice(0, 2)|upper }}</span>
                                                        </div>
                                                    </div>
                                                    <div class="text-sm">
                                                        <p class="font-medium">{{ log.user.email }}</p>
                                                        <p class="text-base-content/60">{{ log.timestamp|date('g:i A') }} • {{ log.ipAddress }}</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <hr class="bg-primary" />
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <div class="flex flex-col items-center justify-center py-12 text-base-content/40">
                                    <span class="icon-[tabler--history-off] size-12 mb-3"></span>
                                    <p class="text-sm">No audit trail records found</p>
                                    <p class="text-xs mt-1">Changes to this NOA will appear here</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <!-- End History Tab -->
            </div>
            <!-- End Tab Content -->

        </div>
        <!-- End Main Content with Tabs -->

    </div>
</div>

{% endblock %}

