{% extends 'base.html.twig' %}

{% block title %}Bulk Import Results - OPTIMUS{% endblock %}

{% block body %}
<div class="w-full px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    {# Breadcrumb #}
    <div class="breadcrumbs text-sm">
        <ul>
            <li>
                <a href="{{ path('manifest_workflow_list') }}" class="inline-flex items-center gap-2">
                    <span class="icon-[tabler--file-text] size-4"></span>
                    NOA Workflow
                </a>
            </li>
            <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right]"></span></li>
            <li>
                <a href="{{ path('manifest_workflow_bulk_import') }}">Bulk Import</a>
            </li>
            <li class="breadcrumbs-separator rtl:rotate-180"><span class="icon-[tabler--chevron-right]"></span></li>
            <li aria-current="page">Results</li>
        </ul>
    </div>

    {# Header #}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="size-12 rounded-xl {% if result.valid or result.success_count > 0 %}bg-success/10{% else %}bg-error/10{% endif %} flex items-center justify-center flex-shrink-0">
                <span class="icon-[tabler--{% if result.valid or result.success_count > 0 %}circle-check{% else %}alert-circle{% endif %}] size-7 {% if result.valid or result.success_count > 0 %}text-success{% else %}text-error{% endif %}"></span>
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-base-content">
                    {% if validateOnly %}Validation Results{% else %}Import Results{% endif %}
                </h1>
                <p class="text-sm text-base-content/60 mt-1">
                    {% if validateOnly %}
                        Review validation results before importing
                    {% else %}
                        Import completed - review the results below
                    {% endif %}
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('manifest_workflow_bulk_import') }}" class="btn btn-ghost btn-sm gap-2 rounded-full">
                <span class="icon-[tabler--arrow-left] size-4"></span>
                Back
            </a>
            {% if result.success_count > 0 %}
                <a href="{{ path('manifest_workflow_list') }}" class="btn btn-primary btn-sm gap-2 rounded-full">
                    <span class="icon-[tabler--list] size-4"></span>
                    View NOAs
                </a>
            {% endif %}
        </div>
    </div>

    {# Summary Cards #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {% if validateOnly %}
            <div class="card bg-base-100 shadow-sm border-t-4 border-t-info">
                <div class="card-body p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="icon-[tabler--file-text] size-8 text-info"></span>
                        <span class="text-3xl font-bold text-base-content">{{ result.total_count }}</span>
                    </div>
                    <p class="text-sm font-medium text-base-content">Total Rows</p>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm border-t-4 border-t-success">
                <div class="card-body p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="icon-[tabler--circle-check] size-8 text-success"></span>
                        <span class="text-3xl font-bold text-base-content">{{ result.valid_count }}</span>
                    </div>
                    <p class="text-sm font-medium text-base-content">Valid</p>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm border-t-4 border-t-error">
                <div class="card-body p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="icon-[tabler--alert-circle] size-8 text-error"></span>
                        <span class="text-3xl font-bold text-base-content">{{ result.errors|length }}</span>
                    </div>
                    <p class="text-sm font-medium text-base-content">Errors</p>
                </div>
            </div>
        {% else %}
            <div class="card bg-base-100 shadow-sm border-t-4 border-t-success">
                <div class="card-body p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="icon-[tabler--circle-check] size-8 text-success"></span>
                        <span class="text-3xl font-bold text-base-content">{{ result.success_count }}</span>
                    </div>
                    <p class="text-sm font-medium text-base-content">Imported</p>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm border-t-4 border-t-warning">
                <div class="card-body p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="icon-[tabler--alert-triangle] size-8 text-warning"></span>
                        <span class="text-3xl font-bold text-base-content">{{ result.skipped_count }}</span>
                    </div>
                    <p class="text-sm font-medium text-base-content">Skipped</p>
                </div>
            </div>
            <div class="card bg-base-100 shadow-sm border-t-4 border-t-error">
                <div class="card-body p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="icon-[tabler--x] size-8 text-error"></span>
                        <span class="text-3xl font-bold text-base-content">{{ result.error_count }}</span>
                    </div>
                    <p class="text-sm font-medium text-base-content">Failed</p>
                </div>
            </div>
        {% endif %}
    </div>

    {# Errors #}
    {% if result.errors|length > 0 %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-0">
                <div class="px-6 py-4 border-b border-base-300">
                    <h3 class="text-lg font-semibold text-base-content flex items-center gap-2">
                        <span class="icon-[tabler--alert-circle] size-5 text-error"></span>
                        Errors ({{ result.errors|length }})
                    </h3>
                    <p class="text-sm text-base-content/60 mt-1">Fix these errors and try importing again</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Row</th>
                                <th>NOA Number</th>
                                <th>Error</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for error in result.errors %}
                                <tr class="hover">
                                    <td><span class="badge badge-soft badge-error">{{ error.row }}</span></td>
                                    <td><code class="text-sm">{{ error.noa_number|default('N/A') }}</code></td>
                                    <td class="text-error text-sm">{{ error.message }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    {# Successful Imports #}
    {% if result.success_count > 0 and result.imported_noas is defined %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-0">
                <div class="px-6 py-4 border-b border-base-300">
                    <h3 class="text-lg font-semibold text-base-content flex items-center gap-2">
                        <span class="icon-[tabler--circle-check] size-5 text-success"></span>
                        Successfully Imported ({{ result.success_count }})
                    </h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>NOA Number</th>
                                <th>BL Number</th>
                                <th>Vessel</th>
                                <th>Consignee</th>
                                <th>Containers</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for noa in result.imported_noas %}
                                <tr class="hover">
                                    <td><span class="badge badge-soft badge-success">{{ noa.noaNumber }}</span></td>
                                    <td>{{ noa.blNumber }}</td>
                                    <td>{{ noa.vesselNumber }}</td>
                                    <td>{{ noa.consignee.businessName|default(noa.consignee.email) }}</td>
                                    <td><span class="badge badge-soft badge-primary">{{ noa.containers|length }}</span></td>
                                    <td>
                                        <a href="{{ path('manifest_workflow_noa_detail', {id: noa.id}) }}" 
                                           class="btn btn-soft btn-primary btn-xs rounded-full">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    {# Skipped #}
    {% if result.skipped_count > 0 and result.skipped is defined %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-0">
                <div class="px-6 py-4 border-b border-base-300">
                    <h3 class="text-lg font-semibold text-base-content flex items-center gap-2">
                        <span class="icon-[tabler--alert-triangle] size-5 text-warning"></span>
                        Skipped ({{ result.skipped_count }})
                    </h3>
                    <p class="text-sm text-base-content/60 mt-1">These NOAs already exist in the system</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Row</th>
                                <th>NOA Number</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for skip in result.skipped %}
                                <tr class="hover">
                                    <td><span class="badge badge-soft badge-warning">{{ skip.row }}</span></td>
                                    <td><code class="text-sm">{{ skip.noa_number }}</code></td>
                                    <td class="text-warning text-sm">{{ skip.reason }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}
