{% extends 'base.html.twig' %}

{% block title %}{{ title }} - OPTIMUS{% endblock %}

{% block body %}
<div class="bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="flex justify-center mb-6">
            {% include 'components/optimus_logo.html.twig' with { size: 'md' } %}
        </div>
        <div class="text-center">
            <h1 class="text-6xl font-bold text-gray-900">{{ status_code }}</h1>
            <h2 class="mt-4 text-3xl font-bold text-gray-900">{{ title }}</h2>
            <p class="mt-2 text-lg text-gray-600">{{ message }}</p>
        </div>
        
        <div class="mt-8 text-center">
            <a href="{{ path('app_login') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Go to login
            </a>
        </div>
        
        {% if status_code == 401 %}
        <div class="mt-4 text-center">
            <a href="{{ path('app_login') }}" class="text-blue-600 hover:text-blue-500">
                Click here to log in
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}