# OPTIMUS Shipping Management Platform - Environment Configuration
# Copy this file to .env and configure for your environment

###> symfony/framework-bundle ###
# Environment: dev, prod, test
APP_ENV=dev

# Application secret key - CHANGE THIS IN PRODUCTION
# Generate with: php bin/console secrets:generate-keys
APP_SECRET=change-this-to-a-random-secret-key-in-production

# Shared directory for file uploads
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL for generating URLs in CLI commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
# Email configuration
# Examples:
# - SMTP: smtp://user:pass@smtp.example.com:587
# - Gmail: gmail+smtp://username:password@default
# - Null (dev): null://null
MAILER_DSN=smtp://user:password@smtp.example.com:587
MAILER_FROM_EMAIL=noreply@example.com
MAILER_FROM_NAME="OPTIMUS Platform"
MAILER_SUPPORT_EMAIL=support@example.com
MAILER_ADMIN_EMAIL=admin@example.com
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# Database connection
# Format: DATABASE_URL="mysql://user:password@host:port/database?serverVersion=version&charset=utf8mb4"
# Examples:
# - MySQL: mysql://root:password@127.0.0.1:3306/optimus_portal?serverVersion=8.0&charset=utf8mb4
# - PostgreSQL: postgresql://user:password@127.0.0.1:5432/optimus_portal?serverVersion=14&charset=utf8
DATABASE_URL="mysql://root:password@127.0.0.1:3306/optimus_portal?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app/file-encryption ###
# File encryption key - MUST be exactly 32 characters
# Generate with: openssl rand -hex 16
FILE_ENCRYPTION_KEY=change-this-key-in-production-32-chars-long
###< app/file-encryption ###

###> app/file-storage ###
# Storage adapter: 'local' or 's3'
STORAGE_ADAPTER=local

# Local storage paths (when STORAGE_ADAPTER=local)
# Relative to project root or absolute paths
LOCAL_STORAGE_PATH=var/uploads
LOCAL_MANIFEST_PATH=var/uploads/manifests
LOCAL_RECEIPT_PATH=var/uploads/receipts
LOCAL_BL_PATH=var/uploads/bl
LOCAL_NOA_PATH=var/uploads/noa
LOCAL_BILLING_PATH=var/uploads/billing
LOCAL_EDO_PATH=var/uploads/edo

# S3/MinIO configuration (only required when STORAGE_ADAPTER=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=optimus-uploads
S3_REGION=us-east-1
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key
S3_USE_PATH_STYLE=false
###< app/file-storage ###

###> symfony/cache ###
# Redis configuration for caching
# Format: redis://host:port
# For Redis with password: redis://password@host:port
REDIS_URL=redis://localhost:6379
###< symfony/cache ###

###> symfony/session ###
# Session configuration
# For production, use Redis: redis://localhost:6379
# For development, use default file handler (leave empty)
SESSION_HANDLER=
###< symfony/session ###

###> symfony/messenger ###
# Message queue configuration
# Options:
# - Doctrine: doctrine://default?auto_setup=0
# - Redis: redis://localhost:6379/messages
# - AMQP: amqp://guest:guest@localhost:5672/%2f/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> manifest-payment-noa-workflow ###
# Manifest workflow configuration
MANIFEST_ACCESS_PAYMENT_AMOUNT=500.00
MANIFEST_FILE_MAX_SIZE=10485760
RECEIPT_FILE_MAX_SIZE=5242880
BL_FILE_MAX_SIZE=10485760
ALLOWED_RECEIPT_FORMATS=pdf,jpg,jpeg,png
ALLOWED_BL_FORMATS=pdf
ALLOWED_MANIFEST_FORMATS=pdf,xlsx,xls

# Document generation
PDF_GENERATOR=dompdf
PDF_PAPER_SIZE=A4
PDF_ORIENTATION=portrait

# Workflow notifications
ENABLE_WORKFLOW_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_IN_APP_NOTIFICATIONS=true
###< manifest-payment-noa-workflow ###

###> security ###
# Rate limiting
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=60
PAYMENT_SUBMISSION_RATE_LIMIT=5
ROLE_ACCEPTANCE_RATE_LIMIT=3

# Session timeout (in seconds)
SESSION_TIMEOUT=3600
SESSION_IDLE_TIMEOUT=1800
###< security ###

###> logging ###
# Log levels: DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY
LOG_LEVEL=INFO
LOG_PATH=var/log

# Audit log retention (in days)
AUDIT_LOG_RETENTION_DAYS=2555
###< logging ###

###> mobile-push-notifications ###
# Web Push notification configuration
# VAPID keys for Web Push authentication
# Generate with one of these methods:
#   1. Node.js (recommended): npx web-push generate-vapid-keys
#   2. Online: https://vapidkeys.com/ or https://web-push-codelab.glitch.me/
#   3. Symfony command: php bin/console app:generate-vapid-keys (may have OpenSSL issues on Windows)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@optimus-shipping.com

# Push notification settings
ENABLE_PUSH_NOTIFICATIONS=true
###< mobile-push-notifications ###
